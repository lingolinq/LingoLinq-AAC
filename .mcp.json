{
  "mcpServers": {
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp",
      "metadata": {
        "repository": "lingolinq/LingoLinq-AAC",
        "description": "Semantic code search and architecture understanding for LingoLinq-AAC"
      }
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem"],
      "env": {
        "ALLOWED_DIRECTORIES": "/workspaces/LingoLinq-AAC"
      }
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "forgecrm": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@horizon-tech-solutions/forgecrm-mcp"],
      "env": {
        "CRM_API_URL": "https://msipkjgfkcmjebgwtcni.supabase.co/functions/v1/mcp-api",
        "CRM_API_TOKEN": "${CRM_API_TOKEN}"
      }
    }
  }
}
