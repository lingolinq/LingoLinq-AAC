{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ObjectReadWriteOnProdBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:PutObjectAcl",
        "s3:GetObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::lingolinq-prod-uploads/*",
        "arn:aws:s3:::lingolinq-prod-static/*"
      ]
    },
    {
      "Sid": "S3BucketListOnProdBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::lingolinq-prod-uploads",
        "arn:aws:s3:::lingolinq-prod-static"
      ]
    },
    {
      "Sid": "SESSendFromUsWest2",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}
