{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObjectsProdUploads",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::lingolinq-prod-uploads/*"
    },
    {
      "Sid": "ListProdUploads",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::lingolinq-prod-uploads"
    },
    {
      "Sid": "KmsUploadsCmk",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:us-west-2:239044785114:key/d5a1a377-8f55-469d-a0ab-4a86481dba67"
    }
  ]
}
