{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObjectsDevUploads",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::lingolinq-dev-uploads/*"
    },
    {
      "Sid": "ListDevUploads",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::lingolinq-dev-uploads"
    }
  ]
}
