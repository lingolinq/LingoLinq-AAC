  "data_url": "https://app.mycoughdrop.com/api/v1/boards/wahlquist/projectcore-36universalcore",
  "default_layout": "landscape",
  "default_locale": "en",
  "demo_source_path": "pc36.obf",
  "description_html": "The Universal Core vocabulary is a set of 36 highly useful single words that can be used alone or in combination to communicate for a range of purposes on countless topics with a wide variety of communication partners. Several formats are available to support student access through direct pointing or touch, eye gaze selection, and partner-assisted scanning. High contrast versions are available to address the needs of some students with visual impairments and 3D symbols are available for students who are blind. Additionally, the Universal Core vocabulary is available on many communication apps and speech generating devices.\n\nUniversal Core \u00a9 2017 by the University of North Carolina at Chapel Hill, The Center for Literacy and Disability Studies, visit project-core.com.",
  "ext_coughdrop_image_url": "https://s3.amazonaws.com/opensymbols/libraries/mulberry/world.svg",
