<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>&times;</button>
    <h3 class="md-modal-title">{{t "This board is not filled in yet" key="confirm_partial_board_title"}}</h3>
  </div>
  <div class="modal-body md-modal-body">
    <div class="md-modal-icon-row">
      <div class="md-modal-icon-circle">
        {{!-- A grid with its top-left cells filled: the shape of a part-finished board. --}}
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2.5"/>
          <line x1="3" y1="9" x2="21" y2="9"/>
          <line x1="3" y1="15" x2="21" y2="15"/>
          <line x1="9" y1="3" x2="9" y2="21"/>
          <line x1="15" y1="3" x2="15" y2="21"/>
          <rect x="3" y="3" width="6" height="6" fill="currentColor" stroke="none" opacity="0.55"/>
          <rect x="9" y="3" width="6" height="6" fill="currentColor" stroke="none" opacity="0.55"/>
          <rect x="3" y="9" width="6" height="6" fill="currentColor" stroke="none" opacity="0.55"/>
        </svg>
      </div>
    </div>
    <p class="md-modal-message md-modal-message--warn">
      {{t "You have filled %{f} of the %{t} buttons on your %{g} grid. The rest will be saved as blank buttons you can fill in later." f=this.model.filled t=this.model.total g=this.grid_label key="confirm_partial_board_message"}}
    </p>
    {{#if this.model.can_trim}}
      <p class="md-modal-hint">
        {{t "Your board also has %{e} with nothing on them at all. You can drop them and save a %{s} board instead, which keeps every word exactly where it is." e=this.empty_summary s=this.trim_label key="confirm_partial_board_trim_hint"}}
      </p>
    {{else}}
      <p class="md-modal-hint">
        {{t "If you meant to add more words, cancel and press Enter after typing each one so it lands on the grid." key="confirm_partial_board_hint"}}
      </p>
    {{/if}}
  </div>
  <div class="modal-footer md-modal-footer">
    {{#if this.model.can_trim}}
      <button type="button" class="btn md-modal-btn md-modal-btn--primary" {{on "click" (this.ctrlAction "save_trimmed")}}>
        {{t "Save as %{s}" s=this.trim_label key="confirm_partial_board_trim_confirm"}}
      </button>
      <button type="button" class="btn md-modal-btn md-modal-btn--cancel" {{on "click" (this.ctrlAction "save_as_is")}}>
        {{t "Keep %{g} and save" g=this.grid_label key="confirm_partial_board_keep_confirm"}}
      </button>
    {{else}}
      <button type="button" class="btn md-modal-btn md-modal-btn--primary" {{on "click" (this.ctrlAction "save_as_is")}}>
        {{t "Save board" key="save_board"}}
      </button>
    {{/if}}
    <button type="button" class="btn md-modal-btn md-modal-btn--cancel" {{on "click" (this.ctrlAction "close")}}>{{t "Go back and edit" key="confirm_partial_board_cancel"}}</button>
  </div>
</ModalDialog>
