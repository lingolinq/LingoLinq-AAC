<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Link Settings" key="link_settings"}}</h3>
  </div>
  <div class="modal-body md-modal-body">
    <form class="form-horizontal" {{on "submit" (this.ctrlAction "nothing")}}>
      <div class="form-group">
        <label for="name" class="col-sm-2 control-label">{{t "Action" key="action"}}</label>
        <div class="col-sm-10">
          <p class='form-control-static'>
            {{#if this.model.button.key}}
              <LinkTo @route="board" @model={{this.model.button.key}}>{{t "Open board %{board}" key="open_board_key" board=this.model.button.key}}</LinkTo>
            {{else if this.model.button.alert}}
              <a href="#" {{on "click" (this.ctrlAction "alert")}}>
                <span class="glyphicon glyphicon-bullhorn"></span>
                {{t "Play Alert Sound" key="play_alert_sound"}}
              </a>
            {{else if this.model.button.special}}
              {{t "Special Action:" key="special_action"}}
              {{this.model.button.action}}
              {{#if this.model.button.arg}}({{this.model.button.arg}}){{/if}}
            {{else}}
              {{t "Unrecognized Button Type" key="unrecognized_button_type"}}
            {{/if}}
          </p>
        </div>
      </div>
      <div class="form-group">
        <label for="name" class="col-sm-2 control-label">{{t "Name" key="name"}}</label>
        <div class="col-sm-10">
          <div style="width: 100px;">
            <input value={{this.model.button.name}} class="form-control" id="name" placeholder="Board" {{on "input" (set-field this "model.button.name")}} />
          </div>
        </div>
      </div>
      <div class="form-group">
        <label for="icon" class="col-sm-2 control-label">{{t "Icon" key="icon"}}</label>
        <div class="col-sm-10">
          <IconSelect @selection={{this.model.button.image}} @action={{this.ctrlAction "updateModelButtonImage"}} />
        </div>
      </div>
      {{#unless this.model.button.alert}}
        <div class="form-group">
          <div class="col-sm-10 col-sm-offset-2">
            <div class="checkbox big_checkbox">
              <label>
                <input type="checkbox" checked={{this.model.button.home_lock}} {{on "change" (set-field this "model.button.home_lock" "checkbox")}} />
                {{t "Set as temporary Home when loaded from the sidebar" key="set_home_lock_sidebar"}}
              </label>
            </div>
          </div>
        </div>
      {{/unless}}
      {{#if this.appState.feature_flags.geo_sidebar}}
        <div class="form-group">
          <label for="highlighting" class="col-sm-2 control-label">{{t "Highlighting" key="highlightin"}}</label>
          <div class="col-sm-10">
            <div class="checkbox big_checkbox">
              <label>
                <input type="checkbox" checked={{this.model.button.fenced}} {{on "change" (set-field this "model.button.fenced" "checkbox")}} />
                {{t "Highlight this board at certain locations/times" key="geo_fence_button"}}
              </label>
            </div>
          </div>
        </div>
        {{#if this.model.button.fenced}}
          <div class="form-group">
            <label for="highlight_type" class="col-sm-2 control-label">{{t "Type" key="type"}}</label>
            <div class="col-sm-10">
              <BoundSelect @select_class="form-control" @select_id="highlight_type" @content={{this.highlight_types}} @selection={{this.model.button.highlight_type}} @action={{this.ctrlAction "updateModelButtonHighlightType"}} />
            </div>
          </div>
          {{#if this.location_setting}}
            <div class="form-group">
              <label for="geos" class="col-sm-2 control-label">{{t "GPS" key="gps"}}</label>
              <div class="col-sm-10">
                <MapWithGeos @geos={{this.model.button.geos}} @action={{this.ctrlAction "updateModelButtonGeos"}} />
              </div>
            </div>
            <div class="form-group">
              <label for="ssids" class="col-sm-2 control-label">{{t "Network" key="network"}}</label>
              <div class="col-sm-5">
                <input value={{this.model.button.ssids}} class="form-control" id="ssids" placeholder="comma-separated wi-fi network names" {{on "input" (set-field this "model.button.ssids")}} />
              </div>
              <div class="col-sm-5">
                {{#if this.appState.current_ssid}}
                  <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "add_ssid")}}>{{t "Add %{ssid}" ssid=this.appState.current_ssid key="add_current_network"}}</button>
                {{/if}}
              </div>
            </div>
          {{/if}}
          {{#if this.time_setting}}
            <div class="form-group">
              <label for="times" class="col-sm-2 control-label">{{t "Time" key="time"}}</label>
              <div class="col-sm-10" style='margin-bottom: 5px;'>
                <div>
                  <span style='display: inline-block; width: 30%;'>
                    <input type="time" value={{this.start}} class="form-control" placeholder="HH:MMam/pm" {{on "input" (set-field this "start")}} />
                  </span>
                  to
                  <span style='display: inline-block; width: 30%;'>
                    <input type="time" value={{this.end}} class="form-control" placeholder="HH:MMam/pm" {{on "input" (set-field this "end")}} />
                  </span>
                  <span style='display: inline-block; width: 10%;'>
                    <button type="button" {{on "click" (this.ctrlAction "add_time")}} class='btn btn-default'>{{t "Add" key="add"}}</button>
                  </span>
                </div>
              </div>
              <div class="col-sm-7 col-sm-offset-2">
                <input value={{this.model.button.times}} class="form-control" id="times" placeholder="comma-separated time-blocks" {{on "input" (set-field this "model.button.times")}} />
              </div>
            </div>
          {{/if}}
          {{#if this.place_setting}}
            <div class="form_group">
              <div class='col-sm-10 col-sm-offset-2'>
                {{#if this.model.button.fenced}}
                  <em>{{t "NOTE: Place-based highlighting will send anonymous GPS data to Google APIs for place identification" key="gps_uses_google"}}</em>
                {{/if}}
              </div>
            </div>
            <div class="form-group">
              <label for="place" class="col-sm-2 control-label">
                {{t "Places" key="places"}}
              </label>
              <div class='col-sm-7'>
                <BoundSelect @select_class="form-control" @select_id="place" @content={{this.places_list}} @selection={{this.place}} @action={{this.ctrlAction "updatePlace"}} />
              </div>
              <div class='col-sm-2' style='margin-bottom: 5px;'>
                <button type="button" {{on "click" (this.ctrlAction "add_place")}} class='btn btn-default'>{{t "Add" key="add"}}</button>
              </div>
              <div class="col-sm-7 col-sm-offset-2">
                <input value={{this.model.button.places}} class="form-control" id="places" placeholder="comma-separated location names" {{on "input" (set-field this "model.button.places")}} />
              </div>
              <div class='col-sm-2' style='font-weight: normal; font-size: 14px;'>
                <p class='form-control-static'>{{t "(needs wifi)" key="requires_wifi"}}</p>
              </div>
            </div>
          {{/if}}
        {{/if}}
      {{/if}}
    </form>
  </div>
  <div class="modal-footer md-modal-footer">
    <button class='btn btn-default' {{on "click" (this.ctrlAction "close")}}>{{t "Close" key="close"}}</button>
  </div>
</ModalDialog>
