{{!-- Targeted Eval runner — Phase 2 scaffold. Renders the active
     targeted subtest. Adaptive grid sweep is fully implemented;
     the other subtests render a "coming soon" card with a Skip
     button so SLPs can run-through and finish until they're built. --}}
<section class="evq-targeted__shell">
  <header class="evq-targeted__header">
    <span class="evq-targeted__eyebrow">{{t "Targeted Eval" key="targeted_eyebrow"}}</span>
    <h2 class="evq-targeted__title">{{this.subtestTitle}}</h2>
  </header>

  <div class="evq-targeted__body">
    {{#if this.isAdaptiveGrid}}
      <div class="evq-targeted__grid-sweep">
        <p class="evq-targeted__instructions">
          {{t "Show the communicator a grid of %{n} buttons and ask them to find the target. Record whether they hit it." key="adaptive_grid_instructions" n=this.currentGrid.rows}}
        </p>
        <div class="evq-targeted__grid-preview" aria-hidden="true" data-band={{this.currentGrid.band}}>
          <strong class="evq-targeted__grid-label">
            {{this.currentGrid.rows}} × {{this.currentGrid.cols}}
          </strong>
          <span class="evq-targeted__grid-capacity">
            {{t "%{n} buttons" key="grid_buttons_label" n=this.currentGrid.label}}
          </span>
        </div>
        <div class="evq-targeted__sweep-actions">
          <button type="button" class="evq-btn evq-btn--ghost" {{on "click" (this.ctrlAction "sweepIncorrect")}}>
            {{t "Missed it" key="adaptive_grid_incorrect"}}
          </button>
          <button type="button" class="evq-btn evq-btn--primary" {{on "click" (this.ctrlAction "sweepCorrect")}}>
            {{t "Hit the target" key="adaptive_grid_correct"}}
          </button>
        </div>
        {{#if this.sweepHistory}}
          <ul class="evq-targeted__sweep-history">
            {{#each this.sweepHistory as |entry|}}
              <li class="evq-targeted__sweep-history-item {{if entry.correct "is-correct" "is-incorrect"}}">
                <span>{{entry.grid}}</span>
                <span>
                  {{#if entry.correct}}
                    {{t "✓" key="sweep_history_correct_glyph"}}
                  {{else}}
                    {{t "✗" key="sweep_history_incorrect_glyph"}}
                  {{/if}}
                </span>
              </li>
            {{/each}}
          </ul>
        {{/if}}
      </div>
    {{/if}}

    {{#if this.isLibrary3Way}}
      <div class="evq-targeted__library-3way">
        <p class="evq-targeted__instructions">
          {{t "Show the communicator the symbol for \"%{w}\" in each library. Tap whichever library they preferred." key="library_3way_instructions" w=this.currentLibraryTrial.word}}
        </p>
        <span class="evq-targeted__trial-counter" aria-live="polite">
          {{t "Trial %{n} of %{total}" key="trial_counter" n=this.libraryTrialNumber total=this.libraryTrialTotal}}
        </span>
        <div class="evq-targeted__library-tiles" role="group" aria-label={{t "Library options" key="library_3way_options"}}>
          {{#each this.libraryOptions as |opt|}}
            <button type="button" class="evq-targeted__library-tile" {{on "click" (this.ctrlAction "pickLibrary" opt.id)}}>
              <span class="evq-targeted__library-tile-name">{{opt.label}}</span>
              <span class="evq-targeted__library-tile-word">{{this.currentLibraryTrial.word}}</span>
            </button>
          {{/each}}
        </div>
        <button type="button" class="evq-btn evq-btn--ghost evq-targeted__skip-link" {{on "click" (this.ctrlAction "skipSubtest")}}>
          {{t "Skip this subtest" key="skip_subtest"}}
        </button>
      </div>
    {{/if}}

    {{#if this.isAccessCoTrial}}
      <div class="evq-targeted__access-cotrial">
        <p class="evq-targeted__instructions">
          {{#if this.accessAwaitingOutcome}}
            {{t "Run the trial via %{m}. Tap Hit or Miss based on the communicator's response." key="access_cotrial_outcome_instructions" m=this.activeAccessLabel}}
          {{else}}
            {{t "Target: \"%{w}\". Pick which access method to test on this trial." key="access_cotrial_method_instructions" w=this.currentAccessTrial.target}}
          {{/if}}
        </p>
        <span class="evq-targeted__trial-counter" aria-live="polite">
          {{t "Trial %{n} of %{total}" key="trial_counter" n=this.accessTrialNumber total=this.accessTrialTotal}}
        </span>
        {{#if this.accessAwaitingOutcome}}
          {{#if this.isTouchTrial}}
            {{!-- Touch-trial fast path: the target IS the button.
                 Communicator taps it = auto-Hit + advance. "Couldn't
                 reach" stays as an explicit Miss for cases where the
                 student visibly tried but didn't make contact. --}}
            <button type="button" class="evq-targeted__access-target evq-targeted__access-target--tappable" {{on "click" (this.ctrlAction "accessHit")}}>
              <strong class="evq-targeted__access-word">{{this.currentAccessTrial.target}}</strong>
              <span class="evq-targeted__access-method-chip">{{this.activeAccessLabel}}</span>
              <span class="evq-targeted__access-tappable-hint">{{t "Tap to record a hit" key="access_cotrial_tap_hint"}}</span>
            </button>
            <div class="evq-targeted__sweep-actions">
              <button type="button" class="evq-btn evq-btn--ghost" {{on "click" (this.ctrlAction "accessMiss")}}>
                {{t "Couldn't reach" key="access_cotrial_could_not_reach"}}
              </button>
            </div>
          {{else}}
            {{!-- Scan / Gaze trials: SLP observes externally and marks
                 Hit/Miss manually since the platform can't reliably
                 auto-detect the communicator's intent in those modes. --}}
            <div class="evq-targeted__access-target">
              <strong class="evq-targeted__access-word">{{this.currentAccessTrial.target}}</strong>
              <span class="evq-targeted__access-method-chip">{{this.activeAccessLabel}}</span>
            </div>
            <div class="evq-targeted__sweep-actions">
              <button type="button" class="evq-btn evq-btn--ghost" {{on "click" (this.ctrlAction "accessMiss")}}>
                {{t "Miss" key="access_cotrial_miss"}}
              </button>
              <button type="button" class="evq-btn evq-btn--primary" {{on "click" (this.ctrlAction "accessHit")}}>
                {{t "Hit" key="access_cotrial_hit"}}
              </button>
            </div>
          {{/if}}
        {{else}}
          <div class="evq-targeted__library-tiles" role="group" aria-label={{t "Access method options" key="access_method_options_aria"}}>
            {{#each this.accessMethodOptions as |opt|}}
              <button type="button" class="evq-targeted__library-tile evq-targeted__access-tile" {{on "click" (this.ctrlAction "pickAccessMethod" opt.id)}}>
                <span class="evq-targeted__library-tile-name">{{t "Method" key="access_method_label"}}</span>
                <span class="evq-targeted__library-tile-word">{{opt.label}}</span>
              </button>
            {{/each}}
          </div>
        {{/if}}
        <button type="button" class="evq-btn evq-btn--ghost evq-targeted__skip-link" {{on "click" (this.ctrlAction "skipSubtest")}}>
          {{t "Skip this subtest" key="skip_subtest"}}
        </button>
      </div>
    {{/if}}

    {{#if this.isSyntaxProbe}}
      <div class="evq-targeted__syntax-probe">
        <div class="evq-targeted__syntax-meta">
          <span class="evq-targeted__trial-counter" aria-live="polite">
            {{t "Trial %{n} of %{total}" key="trial_counter" n=this.syntaxTrialNumber total=this.syntaxTrialTotal}}
          </span>
          <span class="evq-targeted__syntax-phase-chip" data-phase={{this.syntaxPhase}}>
            {{this.syntaxPhaseLabel}}
          </span>
        </div>
        <div class="evq-targeted__syntax-card">
          <span class="evq-targeted__syntax-phrase">{{this.currentSyntaxTrial.phrase}}</span>
          <p class="evq-targeted__syntax-prompt">{{this.syntaxPrompt}}</p>
        </div>
        <div class="evq-targeted__sweep-actions">
          <button type="button" class="evq-btn evq-btn--ghost" {{on "click" (this.ctrlAction "syntaxIncorrect")}}>
            {{t "Did not show" key="syntax_incorrect"}}
          </button>
          <button type="button" class="evq-btn evq-btn--primary" {{on "click" (this.ctrlAction "syntaxCorrect")}}>
            {{t "Showed correctly" key="syntax_correct"}}
          </button>
        </div>
        <button type="button" class="evq-btn evq-btn--ghost evq-targeted__skip-link" {{on "click" (this.ctrlAction "skipSubtest")}}>
          {{t "Skip this subtest" key="skip_subtest"}}
        </button>
      </div>
    {{/if}}

    {{#if this.isMotorMap}}
      <div class="evq-targeted__motor-map">
        <span class="evq-targeted__trial-counter" aria-live="polite">
          {{t "Trial %{n} of %{total}" key="motor_map_trial_counter" n=this.motorTrialNumber total=this.motorTrialTotal}}
        </span>
        <p class="evq-targeted__motor-map-prompt">
          {{t "Watch the highlighted cell. Tap where the student actually pressed." key="motor_map_prompt"}}
        </p>
        <div class="evq-targeted__motor-map-grid"
             style={{safe-style (concat "grid-template-columns: repeat(" this.motorGridCols ", 1fr);")}}
             role="grid"
             aria-label={{t "Motor map grid" key="motor_map_grid_aria"}}>
          {{#each this.motorGridCells as |cell|}}
            <button type="button"
                    class={{if cell.isTarget "evq-targeted__motor-map-cell evq-targeted__motor-map-cell--target" "evq-targeted__motor-map-cell"}}
                    {{on "click" (this.ctrlAction "motorTap" cell.row cell.col)}}
                    aria-label={{if cell.isTarget (t "Target cell" key="motor_map_cell_target") (t "Cell" key="motor_map_cell")}}>
              {{#if cell.isTarget}}<span class="evq-targeted__motor-map-target-glyph" aria-hidden="true">●</span>{{/if}}
            </button>
          {{/each}}
        </div>
        <button type="button" class="evq-btn evq-btn--ghost evq-targeted__skip-link" {{on "click" (this.ctrlAction "skipSubtest")}}>
          {{t "Skip this subtest" key="skip_subtest"}}
        </button>
      </div>
    {{/if}}

    {{#if this.isWrap}}
      <div class="evq-targeted__wrap">
        <p>{{t "Targeted evaluation complete. Open the updated report to see the feature-match recommendation." key="targeted_wrap_body"}}</p>
        <button type="button" class="evq-btn evq-btn--primary" {{on "click" (this.ctrlAction "finishTargeted")}}>
          {{t "Open report" key="targeted_wrap_open_report"}}
        </button>
      </div>
    {{/if}}
  </div>
</section>
