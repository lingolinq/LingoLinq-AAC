<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="la-edit-board-details-wrap">
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Edit Board Details" key="edit_board_details"}}</h3>
  </div>
  <div class="modal-body md-modal-body">

    {{!-- Basic Info --}}
    <div class="la-edit-board-section">
      <h4 class="la-edit-board-section__heading">{{t "Basic Info" key="board_detail_basic_info"}}</h4>
      <div class="la-edit-board-field">
        <label class="la-edit-board-label" for="name">{{t "Name" key="name"}}</label>
        <input value={{this.model.name}} class="la-edit-board-input" id="name" placeholder="Board Name" {{on "input" (set-field this "model.name")}} />
      </div>
      <div class="la-edit-board-field">
        <label class="la-edit-board-label" for="decription">{{t "Description" key="description"}}</label>
        <textarea class="la-edit-board-input la-edit-board-textarea" id="decription" placeholder="Details about this board" {{on "input" (set-field this "model.description")}}>{{this.model.description}}</textarea>
      </div>
      <div class="la-edit-board-field">
        <label class="la-edit-board-label" for="image_url">{{t "Icon" key="icon"}}</label>
        <input value={{this.model.image_url}} class="la-edit-board-input" id="image_url" placeholder="URL or pick from the list" {{on "input" (set-field this "model.image_url")}} />
        <div class="la-edit-board-icon-row">
          {{#if this.model.image_url}}
            <div class="la-edit-board-icon-preview">
              <img src={{this.model.image_url}} {{on "click" (this.ctrlAction "pickImageUrl" this.model.image_url)}} alt="current image">
            </div>
          {{/if}}
          <div class="la-edit-board-icon-options">
            {{#each this.iconUrls as |icon|}}
              <img src={{icon.url}} {{on "click" (this.ctrlAction "pickImageUrl" icon.url)}} alt={{icon.alt}} class="la-edit-board-icon-option">
            {{/each}}
          </div>
        </div>
      </div>
    </div>

    {{!-- License --}}
    <div class="la-edit-board-section">
      <h4 class="la-edit-board-section__heading">{{t "License" key="license"}}</h4>
      <div class="la-edit-board-field">
        <label class="la-edit-board-label" for="license">{{t "License Type" key="license_type"}}</label>
        <BoundSelect @select_class="la-edit-board-select" @select_id="license" @content={{this.licenseOptions}} @selection={{this.model.license.type}} @action={{this.ctrlAction "update_license_type"}} />
      </div>
      {{#if this.attributable_license_type}}
        <div class="la-edit-board-field-row">
          <div class="la-edit-board-field la-edit-board-field--half">
            <label class="la-edit-board-label" for="author">{{t "Author" key="author"}}</label>
            <input value={{this.model.license.author_name}} class="la-edit-board-input" id="author" placeholder="Name" {{on "input" (set-field this "model.license.author_name")}} />
          </div>
          <div class="la-edit-board-field la-edit-board-field--half">
            {{#let (unique-id) as |authorUrlId|}}
              <label for={{authorUrlId}} class="la-edit-board-label">{{t "Author URL" key="author_url"}}</label>
              <input id={{authorUrlId}} value={{this.model.license.author_url}} class="la-edit-board-input" placeholder="Author URL" {{on "input" (set-field this "model.license.author_url")}} />
            {{/let}}
          </div>
        </div>
      {{/if}}
    </div>

    {{!-- Language --}}
    <div class="la-edit-board-section">
      <h4 class="la-edit-board-section__heading">{{t "Language" key="language"}}</h4>
      <div class="la-edit-board-field">
        <label class="la-edit-board-label" for="locale">{{t "Default Language" key="default_language"}}</label>
        <BoundSelect @select_class="la-edit-board-select" @select_id="locale" @content={{this.locales}} @selection={{this.model.locale}} @action={{this.ctrlAction "update_locale"}} />
      </div>
      <div class="la-edit-board-field">
        <label class="la-edit-board-label">{{t "Current Language" key="button_locale"}}</label>
        <BoundSelect @select_class="la-edit-board-select" @content={{this.locales}} @selection={{this.model.button_locale}} @action={{this.ctrlAction "update_button_locale"}} />
      </div>
    </div>

    {{!-- Visibility --}}
    <div class="la-edit-board-section">
      <h4 class="la-edit-board-section__heading">{{t "Visibility" key="visibility"}}</h4>
      <div class="la-edit-board-field">
        <label class="la-edit-board-checkbox">
          <input type="checkbox" checked={{this.model.home_board}} class="la-edit-board-check" {{on "change" (set-field this "model.home_board" "checkbox")}} />
          <span>{{t "This board can be used as a home board" key="is_home_board"}}</span>
        </label>
      </div>
      {{#if this.model.home_board}}
        <div class="la-edit-board-field">
          <p class="la-edit-board-hint">{{t "Select any categories that this home board may fit well into." key="select_categories"}}</p>
          {{#each this.board_categories as |category|}}
            <label class="la-edit-board-checkbox">
              <input type="checkbox" checked={{category.selected}} class="la-edit-board-check" {{on "change" (set-field category "selected" "checkbox")}} />
              <span>{{category.name}}</span>
            </label>
          {{/each}}
        </div>
      {{/if}}
      <div class="la-edit-board-field">
        <label class="la-edit-board-label">{{t "Visibility" key="visibility"}}</label>
        {{#if this.model.copying_state}}
          <p class="la-edit-board-hint"><em>{{t "Boards with protected content can't be made public" key="protected_boards_no_public"}}</em></p>
        {{else}}
          <BoundSelect @select_class="la-edit-board-select" @content={{this.public_options}} @selection={{this.model.visibility}} @action={{this.ctrlAction "update_visibility"}} />
          {{#unless this.model.visibility_setting.private}}
            {{#if this.model.protected_material}}
              <p class="la-edit-board-hint"><em>{{t "NOTE: Users who do not have access to premium content on this board will see free alternatives instead, which may not exactly match the author's intent." key="premium_public_fallbacks_warning"}}</em></p>
            {{/if}}
          {{/unless}}
        {{/if}}
        {{#if this.model.downstream_boards}}
          {{#if this.visibility_changed}}
            <label class="la-edit-board-checkbox">
              <input type="checkbox" checked={{this.model.update_visibility_downstream}} class="la-edit-board-check" {{on "change" (set-field this "model.update_visibility_downstream" "checkbox")}} />
              <span>{{t "Update all linked boards to the same visibility" key="update_downstream_visibility"}}</span>
            </label>
          {{/if}}
        {{/if}}
      </div>
    </div>

    {{!-- Advanced --}}
    {{#if this.advanced}}
      <div class="la-edit-board-section">
        <h4 class="la-edit-board-section__heading">{{t "Advanced" key="advanced_options"}}</h4>
        {{#if this.model.visibility_setting.private}}
          <div class="la-edit-board-field">
            <label class="la-edit-board-checkbox">
              <input type="checkbox" checked={{this.protected_vocabulary}} disabled={{this.model.copying_state.none}} class="la-edit-board-check" {{on "change" (set-field this "protected_vocabulary" "checkbox")}} />
              <span>{{t "Only the author can make copies of this board, and any copies cannot be re-copied by others" key="protected_vocabulary"}}</span>
            </label>
          </div>
        {{/if}}
        <div class="la-edit-board-field">
          <label class="la-edit-board-checkbox">
            <input type="checkbox" checked={{this.model.word_suggestions}} class="la-edit-board-check" {{on "change" (set-field this "model.word_suggestions" "checkbox")}} />
            <span>{{t "Show word completion suggestions" key="show_word_suggestions"}}</span>
          </label>
          <p class="la-edit-board-hint">{{t "(helpful for keyboard-style boards)" key="helpful_for_keyboard_boards"}}</p>
        </div>
        <div class="la-edit-board-field">
          <label class="la-edit-board-checkbox">
            <input type="checkbox" checked={{this.model.dim_header}} class="la-edit-board-check" {{on "change" (set-field this "model.dim_header" "checkbox")}} />
            <span>{{t "Dim the header and vocalization box while on this board" key="dim_header_on_this_board"}}</span>
          </label>
          <label class="la-edit-board-checkbox">
            <input type="checkbox" checked={{this.model.small_header}} class="la-edit-board-check" {{on "change" (set-field this "model.small_header" "checkbox")}} />
            <span>{{t "Shrink the header and vocalization box while on this board" key="small_header_on_this_board"}}</span>
          </label>
        </div>
        <div class="la-edit-board-field">
          <label class="la-edit-board-label">{{t "Background" key="background"}}</label>
          <label class="la-edit-board-checkbox">
            <input type="checkbox" checked={{this.background_enabled}} class="la-edit-board-check" {{on "change" (set-field this "background_enabled" "checkbox")}} />
            <span>{{t "Use a custom background for this board" key="add_custom_background"}}</span>
          </label>
          {{#if this.model.background}}
            <input value={{this.model.background.image}} class="la-edit-board-input" id="background_image_url" placeholder="URL for background" aria-label={{t "Background image URL" key="background_image_url"}} {{on "input" (set-field this "model.background.image")}} />
            {{#if this.model.background.image}}
              <div class="la-edit-board-bg-preview">
                <img src={{this.model.background.image}} alt="background preview">
              </div>
            {{/if}}
            <div class="la-edit-board-field-row">
              <input value={{this.model.background.position}} class="la-edit-board-input" placeholder="image positioning" aria-label={{t "Image positioning" key="image_positioning"}} {{on "input" (set-field this "model.background.position")}} />
              <div class="la-edit-board-dropdown">
                <button class="la-edit-board-dropdown-btn" data-toggle="dropdown">{{t "choose" key="choose"}} <svg width="10" height="6" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1.5 6 6.5 11 1.5"/></svg></button>
                <ul class="dropdown-menu">
                  <li><a href="#" {{on "click" (this.ctrlAction "set_position" "center")}}>{{t "center" key="center"}}</a></li>
                  <li><a href="#" {{on "click" (this.ctrlAction "set_position" "stretch")}}>{{t "stretch" key="stretch"}}</a></li>
                  <li><a href="#" {{on "click" (this.ctrlAction "set_position" "cover")}}>{{t "cover" key="cover"}}</a></li>
                </ul>
              </div>
            </div>
            <div class="la-edit-board-field-row">
              <span {{on "click" (this.ctrlAction "toggle_color" "fill")}} style={{this.bg_style}} class="la-edit-board-color-swatch"></span>
              <input value={{this.model.background.color}} class="la-edit-board-input" id="background" aria-label={{t "Background color" key="background_color"}} {{on "input" (set-field this "model.background.color")}} />
            </div>
          {{/if}}
        </div>
        <div class="la-edit-board-field">
          <label class="la-edit-board-label" for="copy_key">{{t "Root Key" key="root_key"}}</label>
          <input value={{this.model.copy_key}} class="la-edit-board-input" id="copy_key" placeholder="Root board key" {{on "input" (set-field this "model.copy_key")}} />
        </div>
        {{#if this.model.home_board}}
          {{#if this.appState.feature_flags.find_multiple_buttons}}
            <div class="la-edit-board-field">
              <label class="la-edit-board-label">{{t "Board Intro" key="board_intro"}}</label>
              {{#unless this.model.intro.sections}}
                <p class="la-edit-board-hint">{{t "You can build a short lesson that people will walk through when they choose this board set, including explanations and practice phrases for them to find using the board set." key="board_intro_explainer"}}</p>
              {{/unless}}
              {{#each this.model.intro.sections as |section|}}
                <div class="la-edit-board-intro-section">
                  <textarea class="la-edit-board-input la-edit-board-textarea" placeholder="Explanation, notes, etc." aria-label={{t "Board intro explanation" key="board_intro_explanation"}} {{on "input" (set-field section "description")}}>{{section.description}}</textarea>
                  <input type="text" value={{section.prompt}} class="la-edit-board-input" placeholder="optional button sequence to find" aria-label={{t "Button sequence to find" key="button_sequence_to_find"}} {{on "input" (set-field section "prompt")}}/>
                  <button class='la-edit-board-remove-btn' {{on "click" (this.ctrlAction "delete_board_intro_section" section)}}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  </button>
                </div>
              {{/each}}
              <button class='la-edit-board-add-btn' {{on "click" (this.ctrlAction "add_board_intro_section")}}>{{t "Add Intro Section" key="add_intro_section"}}</button>
            </div>
          {{/if}}
        {{/if}}
      </div>
    {{else}}
      <div class="la-edit-board-section">
        <a href='#' class="la-edit-board-advanced-link" {{on "click" (this.ctrlAction "show_advanced")}}>{{t "advanced options" key="advanced_options"}}</a>
      </div>
    {{/if}}

  </div>
  <div class="modal-footer md-modal-footer">
    <a href="#" class="la-edit-board-close" {{on "click" (this.ctrlAction "close")}}>{{t "Close" key="close"}}</a>
  </div>
  </div>
</ModalDialog>
