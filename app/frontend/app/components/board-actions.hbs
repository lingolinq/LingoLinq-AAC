<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="la-board-actions-wrap">
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Board Actions" key="board_actions"}}</h3>
  </div>
  <div class="modal-body md-modal-body">
    {{#unless this.model.board.permissions.edit}}
      <div class="la-board-actions-notice">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" stroke="#7693B9"/><line x1="12" y1="16" x2="12" y2="12" stroke="#46505F"/><line x1="12" y1="8" x2="12.01" y2="8" stroke="#46505F"/>
        </svg>
        <span>{{t "Some of these actions are not available because you don't have editing permission for this board. If you make a copy of the board set then you can make more of these changes." key="edit_permission_required_for_board_actions"}}</span>
      </div>
    {{/unless}}

    <div class="la-board-actions-list">
      <button type="button" class="la-board-actions-item" {{on "click" (this.ctrlAction "categorize")}} disabled={{this.cannot_categorize}}>
        <div class="la-board-actions-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" stroke="#4C86D8"/><rect x="14" y="3" width="7" height="7" stroke="#46505F"/><rect x="3" y="14" width="7" height="7" stroke="#46505F"/><rect x="14" y="14" width="7" height="7" stroke="#4C86D8"/>
          </svg>
        </div>
        <div class="la-board-actions-item__content">
          <span class="la-board-actions-item__label">{{t "Categorize Board" key="categorize_board"}}</span>
          <span class="la-board-actions-item__desc">{{t "Organize boards in your personal account based on personalized tags or categories" key="categorize_explainer"}}</span>
        </div>
        <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <button type="button" class="la-board-actions-item" {{on "click" (this.ctrlAction "langs")}} disabled={{this.cannot_edit}}>
        <div class="la-board-actions-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="#2A9D8F"/><line x1="2" y1="12" x2="22" y2="12" stroke="#46505F"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" stroke="#46505F"/>
          </svg>
        </div>
        <div class="la-board-actions-item__content">
          <span class="la-board-actions-item__label">{{t "Manage Languages" key="manage_languages"}}</span>
          <span class="la-board-actions-item__desc">{{t "Select which languages are available during Speak Mode for this board set" key="manage_languages_explainer"}}</span>
        </div>
        <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <button type="button" class="la-board-actions-item" {{on "click" (this.ctrlAction "privacy")}} disabled={{this.cannot_edit}}>
        <div class="la-board-actions-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="#46505F"/><path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="#7693B9"/>
          </svg>
        </div>
        <div class="la-board-actions-item__content">
          <span class="la-board-actions-item__label">{{t "Change Privacy" key="change_privacy"}}</span>
          <span class="la-board-actions-item__desc">{{t "Change a board (or set of boards) to public, private, or unlisted, all in a single action" key="change_privacy_explainer"}}</span>
        </div>
        <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <button type="button" class="la-board-actions-item" {{on "click" (this.ctrlAction "translate")}}>
        <div class="la-board-actions-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 8l6 6" stroke="#46505F"/><path d="M4 14l6-6 2-3" stroke="#46505F"/><path d="M2 5h12" stroke="#46505F"/><path d="M7 2h1" stroke="#46505F"/><path d="M22 22l-5-10-5 10" stroke="#2A9D8F"/><path d="M14 18h6" stroke="#2A9D8F"/>
          </svg>
        </div>
        <div class="la-board-actions-item__content">
          <span class="la-board-actions-item__label">{{t "Translate Board" key="translate_board"}}</span>
          <span class="la-board-actions-item__desc">{{t "Change or add an additional language to the buttons on a set of boards" key="translate_explainer"}}</span>
        </div>
        <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <button type="button" class="la-board-actions-item" {{on "click" (this.ctrlAction "swap_images")}} disabled={{this.cannot_edit}}>
        <div class="la-board-actions-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="17 1 21 5 17 9" stroke="#4C86D8"/><path d="M3 11V9a4 4 0 0 1 4-4h14" stroke="#4C86D8"/><polyline points="7 23 3 19 7 15" stroke="#46505F"/><path d="M21 13v2a4 4 0 0 1-4 4H3" stroke="#46505F"/>
          </svg>
        </div>
        <div class="la-board-actions-item__content">
          <span class="la-board-actions-item__label">{{t "Swap Images" key="swap_images"}}</span>
          <span class="la-board-actions-item__desc">{{t "Change the image library displayed for a board or set of boards" key="swap_images_explainer"}}</span>
        </div>
        <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <button type="button" class="la-board-actions-item" {{on "click" (this.ctrlAction "batch_recording")}} disabled={{this.cannot_edit}}>
        <div class="la-board-actions-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" stroke="#4C86D8"/><path d="M19 10v2a7 7 0 0 1-14 0v-2" stroke="#46505F"/><line x1="12" y1="19" x2="12" y2="23" stroke="#46505F"/><line x1="8" y1="23" x2="16" y2="23" stroke="#46505F"/>
          </svg>
        </div>
        <div class="la-board-actions-item__content">
          <span class="la-board-actions-item__label">{{t "Record Messages" key="record_messages"}}</span>
          <span class="la-board-actions-item__desc">{{t "Batch-record audio files for buttons on this board" key="record_messages_explainer"}}</span>
        </div>
        <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      {{!-- Board Ideas · Button Stash · Set as Home Board — relocated here from
           the board-detail edit left panel's "Board Actions" group, which had
           grown to seven rows. Placed last, immediately before View Style, which
           is also a relocated panel row.

           These three had NO other render site between them: `suggestions` and
           `open_button_stash` appeared only in that panel, so deleting the rows
           without rehoming them would have left `open_button_stash` unreachable
           from anywhere in the app. That is the same failure this modal exists to
           undo — the board-detail redesign migrated nine actions onto an
           edit-mode-only surface and four ended up with no route at all.

           Reachability is preserved on both counts: this modal opens from the
           edit panel (board-detail.hbs, `other_board_actions`) AND from the
           view-mode options menu, so the edit-mode path these rows have always
           had still works, and they gain a view-mode one. --}}
      <button type="button" class="la-board-actions-item" {{on "click" (this.ctrlAction "suggestions")}} disabled={{this.cannot_edit}}>
        <div class="la-board-actions-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="#46505F"/><line x1="12" y1="16" x2="12" y2="12" stroke="#4C86D8"/><line x1="12" y1="8" x2="12.01" y2="8" stroke="#4C86D8"/>
          </svg>
        </div>
        <div class="la-board-actions-item__content">
          <span class="la-board-actions-item__label">{{t "Board Ideas" key="board_ideas"}}</span>
          <span class="la-board-actions-item__desc">{{t "Suggested buttons and vocabulary to consider adding to this board" key="board_ideas_explainer"}}</span>
        </div>
        <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <button type="button" class="la-board-actions-item" {{on "click" (this.ctrlAction "open_button_stash")}} disabled={{this.cannot_edit}}>
        <div class="la-board-actions-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="8" width="18" height="13" rx="2" ry="2" stroke="#46505F"/><path d="M7 8V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3" stroke="#4C86D8"/>
          </svg>
        </div>
        <div class="la-board-actions-item__content">
          <span class="la-board-actions-item__label">{{t "Button Stash" key="button_stash"}}</span>
          <span class="la-board-actions-item__desc">{{t "Buttons you have copied and set aside, ready to place on a board" key="button_stash_explainer"}}</span>
        </div>
        <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      {{!-- Not disabled on cannot_edit: setting a board as YOUR home board needs
           no edit permission on that board (User#process_home_board authorizes on
           `view`), which is the whole point of picking a public vocabulary. Hidden
           outright when it is already the subject's home board — the same rule as
           the view-mode options-menu row, so "already home" cannot mean two
           different things on two surfaces. --}}
      {{#if this.can_set_as_home}}
        <button type="button" class="la-board-actions-item" {{on "click" (this.ctrlAction "set_as_home")}}>
          <div class="la-board-actions-item__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="#46505F"/><polyline points="9 22 9 12 15 12 15 22" stroke="#4C86D8"/>
            </svg>
          </div>
          <div class="la-board-actions-item__content">
            <span class="la-board-actions-item__label">{{t "Set as Home Board" key="set_as_home_board"}}</span>
            <span class="la-board-actions-item__desc">{{t "Make this the board you start on, and available offline" key="board_detail_set_as_home_tooltip"}}</span>
          </div>
          <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      {{/if}}

      {{!-- View Style — switch this board between the Modern and Classic layouts.
           A static panel (icon + header/subheader + the segmented toggle), not a
           navigation row. Relocated here from the board-detail edit left panel. --}}
      <div class="la-board-actions-item la-board-actions-item--static la-board-actions-view-style">
        <div class="la-board-actions-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke="#46505F"/><line x1="3" y1="9" x2="21" y2="9" stroke="#4C86D8"/><line x1="9" y1="21" x2="9" y2="9" stroke="#4C86D8"/>
          </svg>
        </div>
        <div class="la-board-actions-item__content">
          <span class="la-board-actions-item__label">{{t "View Style" key="board_view_style_label"}}</span>
          <span class="la-board-actions-item__desc">{{t "Modern shows panelled tools with a focused button grid; Classic is the full-device grid. Switching reloads the board." key="board_view_style_explainer"}}</span>
          <div class="md-board-edit-view-style__toggle md-board-edit-view-style__toggle--viewstyle {{if this.is_modern 'md-board-edit-view-style__toggle--viewstyle-modern'}} la-board-actions-view-style__toggle" role="group" aria-label={{t "View Style" key="board_view_style_label"}}>
            <button type="button"
              class="md-board-edit-view-style__opt {{unless this.is_modern 'md-board-edit-view-style__opt--active'}}"
              aria-pressed={{if this.is_modern "false" "true"}}
              {{on "click" (this.ctrlAction "set_view_style" "classic")}}>
              {{t "Classic" key="board_view_classic_short"}}
            </button>
            <button type="button"
              class="md-board-edit-view-style__opt {{if this.is_modern 'md-board-edit-view-style__opt--active'}}"
              aria-pressed={{if this.is_modern "true" "false"}}
              {{on "click" (this.ctrlAction "set_view_style" "modern")}}>
              {{t "Modern" key="board_view_modern_short"}}
            </button>
          </div>
        </div>
      </div>

      {{#if this.model.board.permissions.delete}}
        <button type="button" class="la-board-actions-item la-board-actions-item--danger" {{on "click" (this.ctrlAction "delete")}}>
          <div class="la-board-actions-item__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="3 6 5 6 21 6" stroke="#c0392b"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="#e74c3c"/>
            </svg>
          </div>
          <div class="la-board-actions-item__content">
            <span class="la-board-actions-item__label">{{t "Delete Board" key="delete_board"}}</span>
          </div>
          <svg class="la-board-actions-item__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7693B9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      {{/if}}
    </div>

  </div>
  <div class="modal-footer md-modal-footer">
    <button type="button" class="btn btn-lg" {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
  </div>
  </div>
</ModalDialog>
