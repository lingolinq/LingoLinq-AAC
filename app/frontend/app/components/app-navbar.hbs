<div class="app-navbar__inner">
  {{#if (has-block)}}
    {{yield}}
  {{else if (or this.isAuthenticated this.isDevicePage)}}
    {{!-- Single baseline: reusable authenticated inner (index + modern-dashboard + device page). --}}
    <AppNavbarAuthenticatedInner @onSupport={{this.onSupport}} @showModernDashboardLink={{this.showModernDashboardLink}} @isDevicePage={{this.isDevicePage}} />
  {{else}}
    {{!-- Unauthenticated: brand (logo + app name) + landing-alt style (Features, Pricing, About, Try Free). Reuses LaMobileDrawer for collapse. --}}
    {{#unless this.appState.installed_app}}
      {{#unless this.appState.embedded}}
        {{#unless this.appState.no_linky}}
          <span class="app-navbar__nav-header">
            <h1 class="app-navbar__brand">
              <span class="nav-header__brand">
                <LinkTo @route="index" class="nav-header__logo-link">
                  <img src={{if this.appState.domain_settings.logo_url this.appState.domain_settings.logo_url (path "images/LL_Logo_Line_Bright.png")}} alt="LingoLinq" class="nav-header__logo-svg">
                </LinkTo>
              </span>
            </h1>
          </span>
          <div class="la-topbar-nav header-unauth-nav" role="menubar" aria-label={{t "Page sections" key="fsa_page_sections"}}>
            <LinkTo @route="demo.speak" @query={{hash board=null source=null}} class="la-topbar-link" role="menuitem">{{t "Try a Demo" key="demo_try_speak_mode"}}</LinkTo>
            <LinkTo @route="features" class="la-topbar-link" role="menuitem">{{t "Features" key="fsa_nav_features"}}</LinkTo>
            {{!-- <LinkTo @route="pricing" class="la-topbar-link" role="menuitem">{{t "Pricing" key="fsa_nav_pricing"}}</LinkTo> --}}
            <LinkTo @route="about" class="la-topbar-link" role="menuitem">{{t "About" key="fsa_nav_about"}}</LinkTo>
            <LinkTo @route="beta-feedback" class="la-topbar-link" role="menuitem">{{t "Beta feedback" key="beta_feedback_nav"}}</LinkTo>
            {{#if this.appState.feature_flags.emergency_boards}}
              <LinkTo @route="offline_boards" class="la-topbar-link critical_access" role="menuitem">{{t "Basic Access" key="critical_access"}}</LinkTo>
            {{/if}}
          </div>
          <div class="la-topbar-right header-unauth-right">
            <LinkTo @route="register" class="la-topbar-cta">{{t "Try Free" key="fsa_try_free"}}</LinkTo>
            {{!-- SIGN IN GOES STRAIGHT TO THE LOGIN PAGE (2026-10-02, requested). It opened a menu
                 (Sign In / Register / Basic Access), so reaching /login took two clicks. Register is
                 already on screen as "Try Free"; Basic Access is a top link above and in the drawer
                 below, behind the same `emergency_boards` flag. Keeps `#identity_button` and its
                 classes, so it looks as before. --}}
            <span id="identity" class="advanced_selection app-navbar-auth-nav--desktop identity-with-dark-toggle">
              <LinkTo @route="login" class={{if (persistence-online) "btn btn-default online" "btn btn-default offline"}} id="identity_button">{{t "Sign In" key="login"}}</LinkTo>
            </span>
            <button class="la-topbar-hamburger" type="button" aria-label={{t "Open menu" key="fsa_open_menu"}} aria-expanded={{this.isLandingDrawerOpen}} {{on "click" this.toggleLandingDrawer}}>
              <span class="la-topbar-hamburger__bar"></span>
              <span class="la-topbar-hamburger__bar"></span>
              <span class="la-topbar-hamburger__bar"></span>
            </button>
          </div>
          <LaMobileDrawer @isOpen={{this.isLandingDrawerOpen}} @onClose={{this.closeLandingDrawer}}>
            <LinkTo @route="demo.speak" @query={{hash board=null source=null}} class="la-mobile-drawer__link" {{on "click" this.closeLandingDrawer}}>{{t "Try a Demo" key="demo_try_speak_mode"}}</LinkTo>
            <LinkTo @route="features" class="la-mobile-drawer__link" {{on "click" this.closeLandingDrawer}}>{{t "Features" key="fsa_nav_features"}}</LinkTo>
            {{!-- <LinkTo @route="pricing" class="la-mobile-drawer__link" {{on "click" this.closeLandingDrawer}}>{{t "Pricing" key="fsa_nav_pricing"}}</LinkTo> --}}
            <LinkTo @route="about" class="la-mobile-drawer__link" {{on "click" this.closeLandingDrawer}}>{{t "About" key="fsa_nav_about"}}</LinkTo>
            <LinkTo @route="beta-feedback" class="la-mobile-drawer__link" {{on "click" this.closeLandingDrawer}}>{{t "Beta feedback" key="beta_feedback_nav"}}</LinkTo>
            {{#if this.appState.feature_flags.emergency_boards}}
              <LinkTo @route="offline_boards" class="la-mobile-drawer__link critical_access" {{on "click" this.closeLandingDrawer}}>{{t "Basic Access" key="critical_access"}}</LinkTo>
            {{/if}}
            <div class="la-mobile-drawer__divider"></div>
            <LinkTo @route="login" class="la-mobile-drawer__link" {{on "click" this.closeLandingDrawer}}>{{t "Sign In" key="login"}}</LinkTo>
            <LinkTo @route="register" class="la-mobile-drawer__link" {{on "click" this.closeLandingDrawer}}>{{t "Register" key="register"}}</LinkTo>
            <LinkTo @route="register" class="la-mobile-drawer__cta" {{on "click" this.closeLandingDrawer}}>{{t "Try Free" key="fsa_try_free"}} →</LinkTo>
          </LaMobileDrawer>
        {{/unless}}
      {{/unless}}
    {{/unless}}
  {{/if}}
  {{!-- Beta-feedback tab. CLASSIC takes `--classic-top`: horizontally centred (from
       the base rule) and pinned to `top: 0` so it sits at the TOP of the navbar
       rather than hanging below it. Card View keeps D10's `--navbar` corner anchor.
       See the two variants in app.scss, next to each other. --}}
  {{#if this.showBetaFeedbackDrawerTab}}
    <button type="button" class="beta-feedback-drawer-tab {{if this.isClassic "beta-feedback-drawer-tab--classic-top" "beta-feedback-drawer-tab--navbar"}} {{if this.application.betaFeedbackDrawerOpen "beta-feedback-drawer-tab--open"}}" {{on "click" this.toggleBetaFeedbackDrawer}} aria-expanded={{if this.application.betaFeedbackDrawerOpen "true" "false"}} aria-controls="beta-feedback-top-drawer">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span>{{t "Beta feedback" key="beta_feedback_nav"}}</span>
      <svg class="beta-feedback-drawer-tab__caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
  {{/if}}
</div>
