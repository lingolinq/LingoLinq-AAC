{{!-- Live, interactive board-picker presented as the final step of the
     board-picker guided tour — an almost full-screen modal so the user can
     actually assign, create, or browse/pick a board right there. Reuses the
     standalone board-picker page's markup + classes (board-picker-page__*) so it
     looks and behaves identically; the assign/create actions live on this
     component (the create one sets the from-tour flag — see the .js). --}}
<ModalDialog @dialogClass="md-dialog--tour-picker" @contentClass="md-modal-content--tour-picker" @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header md-modal-header--tour-picker">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="modal-body md-modal-body md-modal-body--tour-picker">
    <div class="board-picker-page board-picker-page--in-tour">
      <h2 class="board-picker-page__header">{{t "Pick Your Home Board" key="board_picker_header"}}</h2>
      <p class="board-picker-page__intro">{{t "Choose a communication system that fits your communicator today" key="board_picker_intro"}}<br>{{t "and grows with them" key="board_picker_intro_2"}} <span class="hero-gradient">{{t "over time" key="board_picker_intro_over_time"}}</span>.</p>
      <div class="board-picker-page__assign">
        <button type="button" class="board-picker-page__assign-btn" disabled={{this.assigning_home_board}} {{on "click" (this.ctrlAction "assign_default_home_board")}}><svg class="board-picker-page__cta-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          {{if this.assigning_home_board (t "Assigning…" key="assigning_home_board_ellipsis") (t "Assign a Home Board For Me" key="assign_home_board_for_me")}}
        </button>
        <button type="button" class="board-picker-page__new-btn" {{on "click" (this.ctrlAction "create_new_board")}}><svg class="board-picker-page__cta-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>{{t "Create My Own Board" key="board_picker_create_own"}}</button>
      </div>
      <div class="board-picker-page__divider" role="separator">
        <span class="board-picker-page__divider-line" aria-hidden="true"></span>
        <span class="board-picker-page__divider-label">{{t "or preview other board options" key="board_picker_divider"}}</span>
        <span class="board-picker-page__divider-line board-picker-page__divider-line--right" aria-hidden="true"></span>
      </div>
      <BoardPicker @tabbed={{true}} />
    </div>
  </div>
</ModalDialog>
