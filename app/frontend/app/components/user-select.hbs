{{#if this.buttons}}
  {{!-- `compact` keeps this exact markup (so the "Other User" picker and every
       action below still work) and only swaps the layout via CSS: the cards
       become full-width rows stacked vertically, reading like a dropdown list.
       Opt-in per call site — switch-communicators passes it; copy-board,
       batch-recording and add-to-sidebar keep the original card grid. --}}
  <div class="row user-select-grid {{if this.compact "user-select-grid--compact"}}">
    {{#each this.users as |supervisee|}}
      <div class="col-md-3 col-sm-4 col-xs-6">
        <button disabled={{supervisee.disabled}} class={{if supervisee.currently_selected "user_select btn btn-info" "user_select btn btn-default"}} {{on "click" (this.ctrlAction "select" supervisee.id)}} style="width: 100%; padding-top: 10px; padding-bottom: 10px; margin-bottom: 20px;">
          <img src={{supervisee.image}} style="height: 60px; max-width: 100px;"><br>
          {{!-- break-on-separators marks the underscore/dot as the preferred wrap
               point, so `aiden_parker` splits as "aiden_ / parker" instead of
               mid-word. See helpers/break-on-separators.js. --}}
          {{break-on-separators supervisee.name}}<br>
          {{#if supervisee.disabled}}
            <em class='text-muted'>{{t "not available" key="not_available_lower"}}</em>
          {{else}}
            &nbsp;
          {{/if}}
        </button>
      </div>
    {{/each}}
    {{!-- "Other User" picker — only render when there is real
         data to show (loading state, error state, or at least one
         extra user). Previously rendered solely on
         `has_extra_users` (managed_orgs.length > 0), which left an
         empty drop-up on screens where the org has no users. The
         `dropup` class was also removed so the menu opens downward
         like every other dropdown in the app. --}}
    {{#if this.should_show_extras}}
      <div class="col-md-3 col-sm-4 col-xs-6">
        <div class="btn-group" style='width: 100%;'>
          <button type="button" class={{if this.extra_user "btn btn-info dropdown-toggle" "btn btn-default dropdown-toggle"}} data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="width: 100%; padding-top: 10px; padding-bottom: 10px; margin-bottom: 20px;">
            {{#if this.extra_user}}
              {{this.extra_user.user_name}}<br>
              <img src={{this.extra_user.avatar_url}} style='width: 60px; height: 60px; object-fit: contain;'>
            {{else}}
              {{t "Other User" key="other_user"}}
            {{/if}}
            <span class="caret"></span>
          </button>
          <ul class="dropdown-menu" style='max-height: 190px; overflow: auto;'>
            {{#if this.extra_users.loading}}
              <li><a href="#">{{t "Loading Users..." key="loading_users"}}</a></li>
            {{else if this.exta_users.errors}}
              <li><a href="#">{{t "Error Loading Users" key="error_loading_users"}}</a></li>
            {{else}}
              {{#each this.extra_users as |user|}}
                <li class={{if user.edit_permission "" "disabled"}}><a href='#' {{on "click" (this.ctrlAction "set_extra_user" user)}}><img src={{user.avatar_url}} style='width: 20px; height: 20px; object-fit: contain;'> {{user.user_name}}</a></li>
              {{else}}
                <li class="dropdown-empty" role="presentation">
                  <span class="dropdown-empty__inner">
                    <svg class="dropdown-empty__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span class="dropdown-empty__text">{{t "No users available" key="dropdown_no_users_available"}}</span>
                  </span>
                </li>
              {{/each}}
            {{/if}}
          </ul>
        </div>
      </div>
    {{/if}}
  </div>
{{else}}
  {{#if this.for_user_image}}
    <span style="display: inline-block; width: 35px;">
      <img src={{this.for_user_image}} style="height: 35px; max-width: 35px;">
    </span>
  {{/if}}
  <span style="display: inline-block; width: calc(100% - 40px);">
    <BoundSelect @select_class="form-control" @select_id={{this.select_id}} @content={{this.users_with_extras}} @selection={{this.selection}} @action={{this.action}} />
  </span>
{{/if}}
