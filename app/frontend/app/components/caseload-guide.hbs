{{#modal-dialog action=this.onClose opening=this.onOpening closing=this.onClosing}}
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" this.onClose}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Managing Your Caseload" key="caseload_guide_title"}}</h3>
  </div>
  <div class="modal-body md-modal-body md-caseload-guide">
    <p class="md-caseload-guide__lead">{{t "Every row has quick actions — and opens a full card. Here's the map." key="caseload_guide_lead"}}</p>

    <h4 class="md-caseload-guide__heading">{{t "Quick actions" key="caseload_guide_actions_heading"}}</h4>
    <ul class="md-caseload-guide__list">
      <li class="md-caseload-guide__item md-caseload-guide__item--model">
        <span class="md-caseload-guide__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" stroke="#46505F"/><line x1="3" y1="9" x2="21" y2="9" stroke="#46505F"/><line x1="9" y1="9" x2="9" y2="20" stroke="#46505F"/><line x1="15" y1="9" x2="15" y2="20" stroke="#46505F"/><line x1="3" y1="14.5" x2="21" y2="14.5" stroke="#46505F"/><rect x="10" y="10.5" width="4" height="2.5" rx="0.5" fill="#2A9D8F" stroke="none"/></svg></span>
        <span class="md-caseload-guide__text"><strong class="md-caseload-guide__name">{{t "Model" key="caseload_qa_model"}}</strong><span class="md-caseload-guide__desc">{{t "Model language in their Speak Mode." key="caseload_guide_model_desc"}}</span></span>
      </li>
      <li class="md-caseload-guide__item md-caseload-guide__item--note">
        <span class="md-caseload-guide__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" stroke="#46505F"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4z" stroke="#46505F"/><path d="M15 5l3 3" stroke="#2A9D8F"/></svg></span>
        <span class="md-caseload-guide__text"><strong class="md-caseload-guide__name">{{t "Note" key="caseload_qa_note"}}</strong><span class="md-caseload-guide__desc">{{t "Log a quick progress note." key="caseload_guide_note_desc"}}</span></span>
      </li>
      <li class="md-caseload-guide__item md-caseload-guide__item--assess">
        <span class="md-caseload-guide__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4.5h6a1 1 0 0 1 1 1V6h2.5a1.5 1.5 0 0 1 1.5 1.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5v-12A1.5 1.5 0 0 1 5.5 6H8v-.5a1 1 0 0 1 1-1z" stroke="#46505F"/><path d="M9 12.5l2.4 2.4L15.5 10" stroke="#2A9D8F" stroke-width="1.8"/></svg></span>
        <span class="md-caseload-guide__text"><strong class="md-caseload-guide__name">{{t "Assess" key="caseload_qa_assess"}}</strong><span class="md-caseload-guide__desc">{{t "Run a quick skills check." key="caseload_guide_assess_desc"}}</span></span>
      </li>
      <li class="md-caseload-guide__item md-caseload-guide__item--reports">
        <span class="md-caseload-guide__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="20" x2="6" y2="14" stroke="#46505F"/><line x1="12" y1="20" x2="12" y2="4" stroke="#E87A6F"/><line x1="18" y1="20" x2="18" y2="10" stroke="#46505F"/></svg></span>
        <span class="md-caseload-guide__text"><strong class="md-caseload-guide__name">{{t "Reports" key="caseload_qa_reports"}}</strong><span class="md-caseload-guide__desc">{{t "See usage reports & stats." key="caseload_guide_reports_desc"}}</span></span>
      </li>
      <li class="md-caseload-guide__item md-caseload-guide__item--eval">
        <span class="md-caseload-guide__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="14" r="8" stroke="#46505F"/><path d="M12 10v4l2 2" stroke="#2A9D8F"/><path d="M9 2h6" stroke="#46505F"/><path d="M19 5l1-1" stroke="#46505F"/></svg></span>
        <span class="md-caseload-guide__text"><strong class="md-caseload-guide__name">{{t "Eval" key="caseload_qa_eval"}}</strong><span class="md-caseload-guide__desc">{{t "Start a 5-min Quick Screen Eval." key="caseload_guide_eval_desc"}}</span></span>
      </li>
      <li class="md-caseload-guide__item md-caseload-guide__item--history">
        <span class="md-caseload-guide__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7" stroke="#46505F"/><polyline points="3 3.5 3 9 8.5 9" stroke="#46505F"/><path d="M12 8v4l3 2" stroke="#2A9D8F"/></svg></span>
        <span class="md-caseload-guide__text"><strong class="md-caseload-guide__name">{{t "History" key="caseload_qa_history"}}</strong><span class="md-caseload-guide__desc">{{t "View past evaluations." key="caseload_guide_history_desc"}}</span></span>
      </li>
    </ul>

    <div class="md-caseload-guide__callout">
      <span class="md-caseload-guide__callout-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51z"/><path d="M13 13l6 6"/></svg>
      </span>
      <div>
        <div class="md-caseload-guide__callout-title">{{t "Open a communicator" key="caseload_guide_card_heading"}}</div>
        <p class="md-caseload-guide__callout-desc">{{t "Click any row to review goals, jump into their boards, manage access, and set status." key="caseload_guide_card_desc"}}</p>
      </div>
    </div>
  </div>
{{/modal-dialog}}
