<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="la-phrases-modal-wrap">
    <div class="la-modal-header">
      <div class="la-modal-header-icon la-modal-header-icon--phrases" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="#2A9D8F"/><line x1="8" y1="9" x2="16" y2="9" stroke="#46505F"/><line x1="8" y1="13" x2="13" y2="13" stroke="#46505F"/></svg>
      </div>
      <h3 class="la-modal-header-label">{{t "Saved Phrases" key="saved_phrases"}}</h3>
      <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>&times;</button>
    </div>
    <div class="la-phrases-modal-body">
      {{#if this.categories}}
        <div class="la-phrases-categories">
          {{#each this.categories as |cat|}}
            <button {{on "click" (this.ctrlAction "set_category" cat)}} class="la-phrases-cat-btn {{if cat.active 'la-phrases-cat-btn--active'}}">
              {{cat.name}}
            </button>
          {{/each}}
          {{#if this.user.preferences.recent_cleared_phrases}}
            <button {{on "click" (this.ctrlAction "set_recent")}} class="la-phrases-cat-btn {{if this.recent_category 'la-phrases-cat-btn--active'}}">
              <em>{{t "Recent" key="recent"}}</em>
            </button>
          {{/if}}
        </div>
      {{/if}}
      {{#if this.category_phrases}}
        <ul class="la-phrases-list">
          {{#each this.category_phrases as |phrase|}}
            <li class="la-phrases-item">
              <button class="la-phrases-item__text" {{on "click" (this.ctrlAction "select" phrase)}}>
                {{#if this.journaling}}
                  <span class="la-phrases-item__date">{{date phrase.date}}</span>
                {{/if}}
                {{#if phrase.stash}}
                  {{#unless this.recent_category}}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#46505F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;"><line x1="12" y1="17" x2="12" y2="3"/><path d="M5 10l7-7 7 7"/><line x1="5" y1="21" x2="19" y2="21"/></svg>
                  {{/unless}}
                {{/if}}
                "{{phrase.sentence}}"
                {{#if this.recent_category}}
                  <span class="la-phrases-item__date">{{date_ago phrase.date}}</span>
                {{/if}}
              </button>
              <div class="la-phrases-item__actions">
                {{#unless phrase.stash}}
                  {{#if this.recent_category}}
                  {{else}}
                    <button class="la-phrases-action-btn" {{on "click" (this.ctrlAction "shift" phrase "up")}} aria-label="Move up">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                    </button>
                    <button class="la-phrases-action-btn" {{on "click" (this.ctrlAction "shift" phrase "down")}} aria-label="Move down">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                  {{/if}}
                {{/unless}}
                <button class="la-phrases-action-btn la-phrases-action-btn--remove" {{on "click" (this.ctrlAction "remove" phrase)}} aria-label="Remove">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </button>
              </div>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <div class="la-phrases-empty">
          {{#if this.journaling}}
            {{#if this.user.permissions.delete}}
              <p>{{t "No recent journal entries available. Journal entries are private for the user. The most recent are shown here, and more are available in the user's Logs view." key="journal_empty"}}</p>
            {{else}}
              <p>{{t "Journal entries remain private for the user and are not accessible to supervisors" key="journal_for_students_only"}}</p>
            {{/if}}
          {{else if this.recent_category}}
            {{!-- The Recent tab lists `stashes.prior_utterances` from the last 24 hours
                  (phrases.js#category_phrases), not saved phrases, and its `{{#unless
                  this.recent_category}}` hides the Add Phrase row below — so the
                  saved-phrases copy was wrong on both counts here. --}}
            <p>{{t "No messages from the last 24 hours." key="no_recent_messages"}}</p>
          {{else}}
            {{!-- NEW KEY, not an edit to `no_phrases`. That string told the user to hit
                  "Remember This" in the sentence box DROPDOWN, which no longer exists --
                  the control is a bottom-bar button in the Speak Options modal now -- and
                  it sent them out of this modal to do something the row directly below
                  already does (opening() pre-fills that input from the current message,
                  phrases.js:141). Changing the English under the old key would have left
                  all twelve other locales confidently describing the dropdown, since a
                  translated value wins over the default. --}}
            <p>{{t "No phrases have been saved yet. Add one using the box below." key="no_phrases_add_below"}}</p>
          {{/if}}
        </div>
      {{/if}}
      {{#unless this.recent_category}}
        <div class="la-phrases-add-row">
          <input value={{this.sentence}} type="text" class="la-phrases-input" placeholder="Enter a new phrase to add to the list" aria-label={{t "New phrase" key="new_phrase"}} {{on "input" (set-field this "sentence")}} />
          <button class="la-phrases-add-btn" {{on "click" (this.ctrlAction "add")}}>
            {{#if this.journaling}}
              {{t "Save Entry" key="save_entry"}}
            {{else}}
              {{t "Add Phrase" key="add_phrase"}}
            {{/if}}
          </button>
        </div>
      {{/unless}}
    </div>
    {{!-- Clear all phrases. Hidden on Recent (that list is prior utterances, not saved
          phrases, and has its own per-row remove) and on Journal (journal entries are not
          phrases and app_state#clear_phrases deliberately spares them), and hidden when
          there is nothing to clear.

          A two-step confirm IN PLACE rather than a confirm modal: utils/modal holds one
          modal at a time, so opening one from here would replace the Phrases modal and
          the user would confirm into an empty screen. The count is named in the prompt so
          "all" is never a guess, and the destructive button is the second tap, never the
          first — this deletes an AAC user's saved phrases and there is no undo. --}}
    {{#unless this.recent_category}}
      {{#unless this.journaling}}
        {{#if this.clearable_phrase_count}}
          <div class="la-phrases-clear-row">
            {{#if this.confirming_clear}}
              <span class="la-phrases-clear-prompt">{{t "Delete all %{n} saved phrases? This cannot be undone." n=this.clearable_phrase_count key="confirm_clear_phrases"}}</span>
              <button type="button" class="la-phrases-clear-btn la-phrases-clear-btn--cancel" {{on "click" (this.ctrlAction "cancel_clear")}}>{{t "Cancel" key="cancel"}}</button>
              <button type="button" class="la-phrases-clear-btn la-phrases-clear-btn--confirm" {{on "click" (this.ctrlAction "confirm_clear")}}>{{t "Yes, delete them" key="yes_delete"}}</button>
            {{else}}
              <button type="button" class="la-phrases-clear-btn" {{on "click" (this.ctrlAction "start_clear")}}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                {{t "Clear all phrases" key="clear_all_phrases"}}
              </button>
            {{/if}}
          </div>
        {{/if}}
      {{/unless}}
    {{/unless}}
    <div class="la-phrases-modal-footer">
      <button type="button" class="la-phrases-close-btn" {{on "click" (this.ctrlAction "close")}}>{{t "Close" key="close"}}</button>
    </div>
  </div>
</ModalDialog>
