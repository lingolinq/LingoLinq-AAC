<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header md-record-note-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="md-record-note-header__row">
      <span class="md-modal-icon-circle md-record-note-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" stroke="#46505F"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke="#2A9D8F"/></svg>
      </span>
      <h3 class="md-modal-title">{{t "New Note for %{user_name}" key="new_note_for" user_name=this.model.user_name}}</h3>
    </div>
  </div>
  <div class="modal-body md-modal-body md-record-note-body">
    <form class="md-modal-form">
      {{#if this.goal_options}}
        <div class="md-modal-field">
          <label for="goal_options" class="md-modal-label">{{t "Topic" key="topic"}}</label>
          <BoundSelect @select_class="form-control md-record-note-select" @select_id="goal_options" @content={{this.goal_options}} @selection={{this.goal_id}} @action={{this.ctrlAction "updateGoalId"}} />
        </div>
        {{#if this.goal_id}}
          <div class="md-modal-field">
            <span class="md-modal-label">{{t "How did it go?" key="goal_status_prompt"}}</span>
            <div class="md-record-note-statuses" role="group" aria-label={{t "Goal status" key="goal_status"}}>
              {{#each this.goal_statuses as |status|}}
                <button type="button" class="md-record-note-status {{status.button_display_class}}" {{on "click" (this.ctrlAction "set_status" status.id)}}>
                  <span class="md-record-note-status__face {{status.display_class}}" aria-hidden="true"></span>
                  <span class="md-record-note-status__text">{{status.text}}</span>
                </button>
              {{/each}}
            </div>
          </div>
        {{/if}}
      {{/if}}

      <div class="md-modal-field">
        <span id="note_type" class="md-modal-label">{{t "Type" key="type"}}</span>
        <div class="md-record-note-type-row">
          <div class="md-record-note-segmented" role="group" aria-labelledby="note_type">
            <button type="button" class="md-record-note-seg {{if this.text_note "md-record-note-seg--active"}}" {{on "click" (this.ctrlAction "set_type" "text")}}>
              <svg class="md-record-note-seg__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h10"/></svg>
              {{t "Text" key="text"}}
            </button>
            <button type="button" class="md-record-note-seg {{unless this.text_note "md-record-note-seg--active"}}" {{on "click" (this.ctrlAction "set_type" "video")}}>
              <svg class="md-record-note-seg__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10 5-3v10l-5-3z"/></svg>
              {{t "Video" key="video"}}
            </button>
          </div>
          {{#if (and this.text_note this.all_note_templates)}}
            <div class="btn-group md-record-note-template-menu">
              <button type="button" class="md-modal-btn md-modal-btn--secondary md-record-note-template-btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                {{t "From Template" key="from_template"}} <span class="caret"></span>
              </button>
              <ul class="dropdown-menu md-record-note-template-list" role="menu">
                {{#each this.all_note_templates as |template|}}
                  <li><a href="#" {{on "click" (this.ctrlAction "pick_template" template)}}>{{template.title}}</a></li>
                {{/each}}
              </ul>
            </div>
          {{/if}}
        </div>
      </div>

      {{#if this.text_note}}
        <div class="md-modal-field">
          <label for="note" class="md-modal-label">{{t "Note" key="note"}}</label>
          <Textarea @value={{this.note}} class="form-control md-record-note-textarea" id="note" rows={{this.note_rows}} />
        </div>
        {{#if this.model.external_device}}
          <div class="md-modal-field">
            <label for="log" class="md-modal-label">{{t "Log Events" key="log_events"}}</label>
            <Textarea @value={{this.log}} class="form-control md-record-note-textarea" id="log" rows="4" placeholder="(optional) one word/button per line, record the sequence of words/buttons selected by this user with respect to the target objective" />
          </div>
        {{/if}}
      {{else}}
        <div class="md-modal-field">
          <span class="md-modal-label">{{t "Video" key="video"}}</span>
          {{video-recorder user=this.model video_ready=(this.ctrlAction "video_ready") video_pending=(this.ctrlAction "video_pending") video_not_ready=(this.ctrlAction "video_not_ready")}}
        </div>
        <div class="md-modal-field">
          <label for="note" class="md-modal-label">{{t "Note" key="note"}}</label>
          <Textarea @value={{this.note}} class="form-control md-record-note-textarea" id="note" rows="1" />
        </div>
      {{/if}}

      {{#if this.prior.note.text}}
        <div class="md-modal-field">
          <span class="md-modal-label">{{t "Previous" key="previous"}}</span>
          <div class="md-record-note-prior">
            <span class="md-record-note-prior__mark" aria-hidden="true">&ldquo;</span>
            <span class="md-record-note-prior__text">{{this.prior.note.text}}</span>
          </div>
        </div>
      {{/if}}

      <div class="md-modal-field">
        <label class="md-modal-check {{if this.notify "is-selected"}}" for="notify_others">
          <input type="checkbox" checked={{this.notify}} id="notify_others" class="md-modal-check__input" {{on "change" (set-field this "notify" "checkbox")}} />
          <span class="md-modal-check__label">{{t "Notify others of this message" key="notify_others"}}</span>
        </label>
      </div>
      <div class="md-modal-field">
        <label class="md-modal-check {{if this.notify_user "is-selected"}}" for="alert_user">
          <input type="checkbox" checked={{this.notify_user}} id="alert_user" class="md-modal-check__input" {{on "change" (set-field this "notify_user" "checkbox")}} />
          <span class="md-modal-check__label">{{t "Send an alert to the communicator about this message" key="alert_user"}}</span>
        </label>
      </div>
    </form>
  </div>
  <div class="modal-footer md-modal-footer">
    <button type="button" {{on "click" (this.ctrlAction "close")}} class="md-modal-btn md-modal-btn--cancel">{{t "Cancel" key="cancel"}}</button>
    {{#if this.text_note}}
      <button type="button" {{on "click" (this.ctrlAction "saveNote")}} class="md-modal-btn md-modal-btn--primary">{{t "Save Note" key="save_note"}}</button>
    {{else}}
      <button type="button" disabled={{this.no_video_ready}} {{on "click" (this.ctrlAction "saveNote" "video")}} class="md-modal-btn md-modal-btn--primary">{{t "Save Note" key="save_note"}}</button>
    {{/if}}
  </div>
</ModalDialog>
