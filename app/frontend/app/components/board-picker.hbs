<div class="md-home-boards-picker__layout {{if this.tabbed "md-home-boards-picker__layout--tabbed"}}{{if this.searchAtTop " md-home-boards-picker__layout--search-top"}}">
  {{!-- No section heading here on purpose. "Browse boards" + "Choose a category,
       then select a board" restated the page title and its subtitle one band
       lower, and the two columns immediately below say the same thing by
       showing it. The page h1 carries the heading role for this content. --}}
  {{#if this.tabbed}}
    {{!-- Tabbed variant (setup board_category) — categories render as the
         boards-page file-folder tabs. Reuses the `ub-boards-page__tabs--boards`
         pill classes for an exact visual match, inside a setup-scoped tabs-row
         wrapper (NOT `.ub-boards-page__tabs-row`, whose ≤640px rule swaps the
         pills for a mobile <select> we don't render here). --}}
    <div class="md-home-boards-picker__tabs-row" role="navigation" aria-label={{t "Browse by category" key="browse_by_category"}}>
      <ul class="ub-boards-page__tabs ub-boards-page__tabs--boards md-home-boards-picker__tabs" role="tablist">
        {{#each this.categories as |category|}}
          <li role="presentation" class={{if category.selected "is-active"}}>
            <a href="#" role="tab" aria-selected={{if category.selected "true" "false"}} {{on "click" (this.ctrlAction "set_category" category.id)}}>{{category.name}}</a>
          </li>
        {{/each}}
      </ul>
    </div>
  {{else}}
    <aside class="md-home-boards-picker__nav" aria-label={{t "Browse by category" key="browse_by_category"}}>
      <div class="md-home-boards-picker__nav-inner setup_setting">
        {{#unless this.searchAtTop}}
          <label class="md-home-boards-picker__nav-label">{{t "Select Category to Preview Boards" key="select_category_to_preview_boards"}}</label>
        {{/unless}}
        <nav class="md-home-boards-picker__categories" role="navigation">
          {{#each this.categories as |category|}}
            <button
              type="button"
              class="md-home-boards-picker__category {{if category.selected "is-active"}}{{if this.searchAtTop " md-home-boards-picker__category--iconic"}}"
              {{on "click" (this.ctrlAction "set_category" category.id)}}
            >
              {{#if this.searchAtTop}}
                <span class="md-home-boards-picker__category-icon" aria-hidden="true">
                  {{#if (is-equal category.id "robust")}}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" stroke="#46505F" stroke-width="1.5"/><rect x="5" y="6" width="14" height="8" rx="1" fill="#2A9D8F" fill-opacity="0.16" stroke="#2A9D8F" stroke-width="1.5"/><path d="M9 9h2v2H9zM13 9h2v2h-2zM9 12h6" stroke="#2A9D8F" stroke-width="1.5"/><line x1="8" y1="21" x2="16" y2="21" stroke="#46505F" stroke-width="1.5"/><line x1="12" y1="17" x2="12" y2="21" stroke="#46505F" stroke-width="1.5"/></svg>
                  {{else if (is-equal category.id "mine")}}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="7.5" r="2.25" fill="#2A9D8F" fill-opacity="0.2" stroke="#46505F" stroke-width="1.5"/><path d="M4 14.5c0-1.9 1.6-3.5 3.5-3.5s3.5 1.6 3.5 3.5" stroke="#46505F" stroke-width="1.5" fill="none"/><rect x="13" y="6.5" width="8" height="5.5" rx="1.5" fill="#2A9D8F" fill-opacity="0.22" stroke="#46505F" stroke-width="1.5"/><rect x="15" y="8.25" width="1.6" height="1.6" rx="0.35" fill="#2A9D8F" stroke="none"/><rect x="17.8" y="8.25" width="1.6" height="1.6" rx="0.35" fill="#2A9D8F" stroke="none"/><rect x="14" y="13.5" width="7" height="4.5" rx="1.5" fill="#2A9D8F" fill-opacity="0.14" stroke="#46505F" stroke-width="1.5"/><rect x="15.5" y="15" width="1.4" height="1.4" rx="0.3" fill="#46505F" fill-opacity="0.35" stroke="none"/><rect x="17.8" y="15" width="1.4" height="1.4" rx="0.3" fill="#46505F" fill-opacity="0.35" stroke="none"/></svg>
                  {{else if (is-equal category.id "cause_effect")}}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8.5" width="6.5" height="7" rx="2" fill="#2A9D8F" fill-opacity="0.22" stroke="#46505F" stroke-width="1.5"/><circle cx="5.25" cy="12" r="1.1" fill="#2A9D8F" stroke="none"/><circle cx="5.25" cy="12" r="2.2" stroke="#2A9D8F" stroke-width="1" opacity="0.35" fill="none"/><line x1="9.5" y1="12" x2="11.5" y2="12" stroke="#46505F" stroke-width="1.5"/><polyline points="10.25 10.75 12 12 10.25 13.25" stroke="#46505F" stroke-width="1.5" fill="none"/><circle cx="16" cy="12" r="3.25" fill="#2A9D8F" fill-opacity="0.14" stroke="#2A9D8F" stroke-width="1.5"/><polygon points="15,10.85 15,13.15 17.6,12" fill="#2A9D8F" stroke="none"/><path d="M20 10v4" stroke="#46505F" stroke-width="1.5" opacity="0.45"/><path d="M21.2 9v6" stroke="#46505F" stroke-width="1.5" opacity="0.3"/></svg>
                  {{else if (is-equal category.id "simple_starts")}}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="7" height="7" rx="2" fill="#2A9D8F" fill-opacity="0.22" stroke="#46505F" stroke-width="1.5"/><rect x="13" y="4" width="7" height="7" rx="2" fill="#2A9D8F" fill-opacity="0.14" stroke="#46505F" stroke-width="1.5"/><rect x="4" y="13" width="7" height="7" rx="2" fill="#2A9D8F" fill-opacity="0.14" stroke="#46505F" stroke-width="1.5"/><rect x="13" y="13" width="7" height="7" rx="2" fill="#2A9D8F" fill-opacity="0.22" stroke="#46505F" stroke-width="1.5"/></svg>
                  {{else if (is-equal category.id "functional")}}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5c-1.2 0-2.3-.3-3.3-.8L4 20l1.8-5.2A7.43 7.43 0 0 1 4.5 11.5 7.5 7.5 0 0 1 12 4h.5A7.48 7.48 0 0 1 20 11.5z" fill="#2A9D8F" fill-opacity="0.12" stroke="#46505F" stroke-width="1.5"/><circle cx="9" cy="11.5" r="0.9" fill="#2A9D8F" stroke="none"/><circle cx="12" cy="11.5" r="0.9" fill="#2A9D8F" stroke="none"/><circle cx="15" cy="11.5" r="0.9" fill="#2A9D8F" stroke="none"/></svg>
                  {{else if (is-equal category.id "phrases")}}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 6.5h11a2 2 0 0 1 2 2v4.5a2 2 0 0 1-2 2H11l-3 2.5V15H5.5a2 2 0 0 1-2-2v-4.5a2 2 0 0 1 2-2z" fill="#2A9D8F" fill-opacity="0.12" stroke="#46505F" stroke-width="1.5"/><line x1="7.5" y1="10" x2="14.5" y2="10" stroke="#46505F" stroke-width="1.5"/><line x1="7.5" y1="12.25" x2="12.5" y2="12.25" stroke="#2A9D8F" stroke-width="1.5"/><line x1="7.5" y1="14.5" x2="10.5" y2="14.5" stroke="#46505F" stroke-width="1.5" opacity="0.55"/><rect x="14.5" y="14" width="6" height="5" rx="1.5" fill="#2A9D8F" fill-opacity="0.18" stroke="#46505F" stroke-width="1.5"/><rect x="16" y="16" width="1.2" height="3" rx="0.4" fill="#2A9D8F" stroke="none"/><rect x="18.2" y="15.2" width="1.2" height="4.6" rx="0.4" fill="#2A9D8F" stroke="none"/><rect x="20.4" y="16.4" width="1.2" height="2.2" rx="0.4" fill="#46505F" fill-opacity="0.45" stroke="none"/></svg>
                  {{else if (is-equal category.id "keyboards")}}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2" fill="#2A9D8F" fill-opacity="0.1" stroke="#46505F" stroke-width="1.5"/><rect x="5" y="9" width="2.5" height="2.5" rx="0.5" fill="#2A9D8F" stroke="none"/><rect x="9" y="9" width="2.5" height="2.5" rx="0.5" fill="#2A9D8F" stroke="none"/><rect x="13" y="9" width="2.5" height="2.5" rx="0.5" fill="#2A9D8F" stroke="none"/><rect x="17" y="9" width="2.5" height="2.5" rx="0.5" fill="#2A9D8F" stroke="none"/><rect x="7" y="13" width="10" height="2.5" rx="0.5" fill="#46505F" fill-opacity="0.35" stroke="none"/></svg>
                  {{else if (is-equal category.id "available_boards")}}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="7.5" r="2.25" fill="#2A9D8F" fill-opacity="0.2" stroke="#46505F" stroke-width="1.5"/><path d="M4 14.5c0-1.9 1.6-3.5 3.5-3.5s3.5 1.6 3.5 3.5" stroke="#46505F" stroke-width="1.5" fill="none"/><rect x="13" y="6.5" width="8" height="5.5" rx="1.5" fill="#2A9D8F" fill-opacity="0.22" stroke="#46505F" stroke-width="1.5"/><rect x="15" y="8.25" width="1.6" height="1.6" rx="0.35" fill="#2A9D8F" stroke="none"/><rect x="17.8" y="8.25" width="1.6" height="1.6" rx="0.35" fill="#2A9D8F" stroke="none"/><rect x="14" y="13.5" width="7" height="4.5" rx="1.5" fill="#2A9D8F" fill-opacity="0.14" stroke="#46505F" stroke-width="1.5"/><rect x="15.5" y="15" width="1.4" height="1.4" rx="0.3" fill="#46505F" fill-opacity="0.35" stroke="none"/><rect x="17.8" y="15" width="1.4" height="1.4" rx="0.3" fill="#46505F" fill-opacity="0.35" stroke="none"/></svg>
                  {{/if}}
                </span>
                <span class="md-home-boards-picker__category-label">{{category.name}}</span>
              {{else}}
                {{category.name}}
              {{/if}}
            </button>
          {{/each}}
        </nav>
      </div>
    </aside>
  {{/if}}
  <div class="md-home-boards-picker__content{{if this.searchAtTop " md-home-boards-picker__category-panel"}}">
    {{!-- Panel head: WHICH boards, and how many. It sits above the category
         description on purpose — name the thing first, explain it second, then
         its controls. (It used to share a row with the search field below the
         description, which gave the panel a second introduction.) --}}
    {{#if this.showInlineCategoryFilter}}
      <div class="bp-results-head">
        {{!-- h2, not h3: the page's only other heading is its <h1>, and the
              <h2 class="md-home-boards-picker__section-header"> that used to sit
              between them was removed in this same redesign, leaving h1 -> h3
              (WCAG 1.3.1 structure). --}}
        <h2 class="bp-results-head__title">{{this.resultsTitle}}</h2>
        {{#if this.resultsCountLabel}}
          {{!-- Decorative separator only: aria-hidden so the count is still
               announced as its own phrase after the heading, without a stray
               "middle dot". Not routed through i18n because it is punctuation,
               not translatable copy. The count stays OUTSIDE the h3 so it does
               not become part of the heading's accessible name. --}}
          <span class="bp-results-head__sep" aria-hidden="true">&middot;</span>
          <span class="bp-results-head__count">{{this.resultsCountLabel}}</span>
        {{/if}}
      </div>
    {{/if}}
    <div class={{if this.show_category_explainer "category_explainer full" "category_explainer"}}>
    {{#if this.category.robust}}
      <p>{{t "Rich vocabularies can feel like a lot at first—many communicators grow into them. Focus on what they can access; you can hide buttons and bring them back later. These sets offer core words, motor planning, or conversation, with room for personalization." key="robust_1"}}</p>
    {{else if this.category.cause_effect}}
      <p>{{t "New to AAC? Cause-and-effect boards teach that tapping buttons makes things happen. A fun way to build the access skills that lead to communication." key="cause_effect_1"}}</p>
    {{else if this.category.simple_starts}}
      <p>{{t "A small set of simple buttons can help some people get comfortable first. You can move to larger sets when it fits—everyone's path is different." key="simple_starts_1"}}</p>
    {{else if this.category.functional}}
      <p>{{t "Functional boards focus on everyday messages and can feel more intuitive, especially when just starting out." key="functional_1"}}</p>
    {{else if this.category.phrases}}
      <p>{{t "Phrase-based boards and your own recorded voice work well for high-stress moments or conditions like ALS. Use %app_name%'s recording tools to build a message bank." key="phrases_1"}}</p>
    {{else if this.category.keyboards}}
      <p>{{t "If spelling works well for them, keyboard boards with word prediction can speed things up. Many include quick phrases too." key="keyboards_1"}}</p>
    {{else if this.category.mine}}
      <p>{{t "Boards you've created, copied, or had shared with you." key="browse_mine"}}</p>
    {{else if this.category.available_boards}}
      {{!-- One line of context. The "load more to see additional public boards"
           half of the old sentence moved down to the Load More control, where it
           is actually actionable — see md-home-boards-picker__load-more-hint.
           NEW key rather than re-using board_picker_available_boards_1: the old
           key still carries the long sentence in the other 12 locales. --}}
      <p>{{t "Boards you own, boards shared with you, and popular public boards." key="board_picker_available_boards_short"}}</p>
    {{/if}}
    {{#if this.category}}
      {{#if this.category_explainer_overflows}}
        <div class='more_link'>
          <a href="#" {{on "click" (this.ctrlAction "show_explainer")}}>{{t "more" key="more_lower"}}</a>
        </div>
      {{/if}}
    {{/if}}
    </div>
    {{!-- Search + density switcher. The category title and count used to share
         this row; they now head the panel ABOVE the description (see
         .bp-results-head at the top of this block) so the panel reads
         name -> explanation -> controls -> results. --}}
    {{#if this.showInlineCategoryFilter}}
      <div class="bp-toolbar">
        <div class="bp-toolbar__controls">
          <form class="bp-search" {{on "submit" (this.ctrlAction "go_search_boards")}} role="search">
            <label for="board-picker-search-q" class="sr-only">{{t "Search boards" key="board_picker_search_label"}}</label>
            <span class="bp-search__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
            </span>
            <input
              id="board-picker-search-q"
              type="search"
              value={{this.boardSearchQuery}}
              {{on "input" (set-field this "boardSearchQuery")}}
              class="bp-search__input"
              placeholder={{t "Search boards" key="board_picker_toolbar_search_placeholder"}}
              autocomplete="off"
            />
            {{#if this.boardSearchActive}}
              <button type="button" class="bp-search__clear" {{on "click" (this.ctrlActionNoBubble "clear_board_search")}} aria-label={{t "Clear search" key="board_picker_clear_search"}} title={{t "Clear search" key="board_picker_clear_search"}}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            {{/if}}
          </form>
          {{!-- Board display style: a real segmented control, not a text link —
               switching density is a page-level control. Native <button>s in a
               labelled group; aria-pressed carries the state programmatically
               so it is not conveyed by colour alone. --}}
          <div class="bp-segmented" role="group" aria-label={{t "Board display style" key="board_picker_display_style"}}>
            <button type="button" class="bp-segmented__option {{unless this.compact_boards "bp-segmented__option--active"}}" aria-pressed={{unless this.compact_boards "true" "false"}} {{on "click" (this.ctrlAction "set_compact_boards" false)}}>
              {{t "Detailed" key="board_picker_detailed"}}
            </button>
            <button type="button" class="bp-segmented__option {{if this.compact_boards "bp-segmented__option--active"}}" aria-pressed={{if this.compact_boards "true" "false"}} {{on "click" (this.ctrlAction "set_compact_boards" true)}}>
              {{t "Compact" key="board_picker_compact"}}
            </button>
          </div>
        </div>
      </div>
    {{/if}}
    {{#if this.category}}
      {{#if this.robust_tabbed}}
        {{!-- Setup Robust Vocabularies: the Quick Core and Vocal Flair
             MAIN boards (sub-boards excluded), each on its own boards-page
             glass card. `tabbed` gates this so /search/home is unaffected. --}}
        {{#each this.brand_groups as |group|}}
          <section class="setup-board-category__brand-card">
            <h3 class="setup-board-category__brand-title">{{group.title}}</h3>
            {{#if (is-equal group.result.state "loaded")}}
              {{#if group.result.boards.length}}
                <div class="md-home-boards-picker__grid {{if this.compact_boards "md-home-boards-picker__grid--compact"}}">
                  {{#each group.result.boards as |board|}}
                    {{#if board.key}}
                      <div class="md-home-boards-picker__board simple_board_holder">
                        <BoardIcon @board={{board}} @prefetchPreview={{true}} @compactRow={{this.compact_boards}} />
                      </div>
                    {{/if}}
                  {{/each}}
                </div>
              {{else}}
                <div class="md-home-boards-picker__grid-message">{{t "None found" key="none_found"}}</div>
              {{/if}}
            {{else if (is-equal group.result.state "error")}}
              <div class="md-home-boards-picker__grid-message md-home-boards-picker__grid-message--error">{{t "Error loading boards" key="error_loading_boards"}}</div>
            {{else}}
              <div class="md-home-boards-picker__grid-message">{{t "Loading boards..." key="loading_boards"}}</div>
            {{/if}}
          </section>
        {{/each}}
      {{else}}
      {{!-- Browse tabs including Keyboards: public home boards tagged with
           that category id (settings.categories). --}}
      <div class="md-home-boards-picker__grid {{if this.compact_boards "md-home-boards-picker__grid--compact"}}">
        {{#if this.display_category_boards.loading}}
          <div class="md-home-boards-picker__grid-message">
            {{t "Loading boards..." key="loading_boards"}}
          </div>
        {{else if this.display_category_boards.error}}
          <div class="md-home-boards-picker__grid-message md-home-boards-picker__grid-message--error">
            {{t "Error loading boards" key="error_loading_boards"}}
          </div>
        {{else if this.display_category_boards.length}}
          {{#each this.display_category_boards as |board|}}
            {{#if board.key}}
              <div class="md-home-boards-picker__board simple_board_holder">
                <BoardIcon @board={{board}} @prefetchPreview={{true}} @compactRow={{this.compact_boards}} />
              </div>
            {{/if}}
          {{/each}}
        {{else}}
          <div class="md-home-boards-picker__grid-message">
            {{t "None found" key="none_found"}}
          </div>
        {{/if}}
      </div>
      {{#if this.category.available_boards}}
        {{#if this.public_boards_has_more}}
          <div class="md-home-boards-picker__load-more">
            <button type="button" class="md-btn md-btn--secondary md-home-boards-picker__load-more-btn" disabled={{this.public_boards_loading_more}} {{on "click" (this.ctrlAction "load_more_public_boards")}}>
              {{#if this.public_boards_loading_more}}
                {{t "Loading boards..." key="loading_boards"}}
              {{else}}
                {{t "Load more" key="load_more"}}
              {{/if}}
            </button>
            {{!-- Was part of the panel's intro paragraph, three lines above the
                 grid it describes. It belongs next to the control it explains. --}}
            <p class="md-home-boards-picker__load-more-hint">{{t "Browse additional public boards from the community catalog." key="board_picker_load_more_hint"}}</p>
          </div>
        {{/if}}
      {{/if}}
      {{/if}}
    {{/if}}
  </div>
  {{#if (and (not this.searchAtTop) this.category (not this.category.mine) (not this.category.available_boards) (not this.robust_tabbed))}}
          <div class="md-home-boards-picker__search">
            <form class="md-home-boards-picker__search-form" {{on "submit" (this.ctrlAction "go_search_boards")}} role="search">
              <label for="board-picker-public-search-q" class="sr-only">{{t "Search Boards" key="search_boards"}}</label>
              <input
                id="board-picker-public-search-q"
                type="search"
                value={{this.boardSearchQuery}}
                {{on "input" (set-field this "boardSearchQuery")}}
                class="form-control md-home-boards-picker__search-input"
                placeholder={{t "Search public boards by name" key="board_picker_search_placeholder"}}
                autocomplete="off"
              />
              <button type="submit" class="md-btn md-btn--secondary md-home-boards-picker__search-submit">{{t "Search" key="search"}}</button>
            </form>
          </div>
  {{/if}}
</div>
