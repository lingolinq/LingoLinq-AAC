<div class="md-home-boards-picker__layout {{if this.tabbed "md-home-boards-picker__layout--tabbed"}}">
  {{#if this.tabbed}}
    {{!-- Tabbed variant (setup board_category) — categories render as the
         boards-page file-folder tabs. Reuses the `ub-boards-page__tabs--boards`
         pill classes for an exact visual match, inside a setup-scoped tabs-row
         wrapper (NOT `.ub-boards-page__tabs-row`, whose ≤640px rule swaps the
         pills for a mobile <select> we don't render here). --}}
    <div class="md-home-boards-picker__tabs-row" role="navigation" aria-label={{t "Browse by category" key="browse_by_category"}}>
      <ul class="ub-boards-page__tabs ub-boards-page__tabs--boards md-home-boards-picker__tabs" role="tablist">
        {{#each this.categories as |category|}}
          <li role="presentation" class={{if category.selected "is-active"}}>
            <a href="#" role="tab" aria-selected={{if category.selected "true" "false"}} {{on "click" (this.ctrlAction "set_category" category.id)}}>{{category.name}}</a>
          </li>
        {{/each}}
      </ul>
    </div>
  {{else}}
    <aside class="md-home-boards-picker__nav" aria-label={{t "Browse by category" key="browse_by_category"}}>
      <div class="md-home-boards-picker__nav-inner setup_setting">
        <label class="md-home-boards-picker__nav-label">{{t "Select a Category to Browse" key="browse_categories"}}</label>
        <nav class="md-home-boards-picker__categories" role="navigation">
          {{#each this.categories as |category|}}
            <button
              type="button"
              class="md-home-boards-picker__category {{if category.selected "is-active"}}"
              {{on "click" (this.ctrlAction "set_category" category.id)}}
            >
              {{category.name}}
            </button>
          {{/each}}
        </nav>
      </div>
    </aside>
  {{/if}}
  <div class="md-home-boards-picker__content">
    <div class={{if this.show_category_explainer "category_explainer full" "category_explainer"}}>
    {{#if this.category.robust}}
      <p>{{t "Rich vocabularies can feel like a lot at first—many communicators grow into them. Focus on what they can access; you can hide buttons and bring them back later. These sets offer core words, motor planning, or conversation, with room for personalization." key="robust_1"}}</p>
    {{else if this.category.cause_effect}}
      <p>{{t "New to AAC? Cause-and-effect boards teach that tapping buttons makes things happen. A fun way to build the access skills that lead to communication." key="cause_effect_1"}}</p>
    {{else if this.category.simple_starts}}
      <p>{{t "A small set of simple buttons can help some people get comfortable first. You can move to larger sets when it fits—everyone's path is different." key="simple_starts_1"}}</p>
    {{else if this.category.functional}}
      <p>{{t "Functional boards focus on everyday messages and can feel more intuitive, especially when just starting out." key="functional_1"}}</p>
    {{else if this.category.phrases}}
      <p>{{t "Phrase-based boards and your own recorded voice work well for high-stress moments or conditions like ALS. Use %app_name%'s recording tools to build a message bank." key="phrases_1"}}</p>
    {{else if this.category.keyboards}}
      <p>{{t "If spelling works well for them, keyboard boards with word prediction can speed things up. Many include quick phrases too." key="keyboards_1"}}</p>
      {{!-- Hardcoded keyboard placeholders (alphabetic + QWERTY) — styled to
           match the real board cards, with a mini keyboard preview. --}}
      <div class="md-home-boards-picker__grid">
        {{#each this.keyboard_placeholders as |kb|}}
          <div class="md-home-boards-picker__board simple_board_holder">
            <div class="btn simple_board_icon md-home-boards-picker__keyboard-placeholder" aria-label={{kb.name}}>
              <span class="md-home-boards-picker__keyboard-tag">{{t "Coming soon" key="coming_soon"}}</span>
              <div class="md-home-boards-picker__keyboard-preview md-home-boards-picker__keyboard-preview--{{kb.id}}" aria-hidden="true">
                {{#each kb.rows as |row|}}
                  <div class="md-home-boards-picker__keyboard-row">
                    {{#each row as |key|}}
                      <span class="md-home-boards-picker__keyboard-key">{{key}}</span>
                    {{/each}}
                  </div>
                {{/each}}
              </div>
              <div class="name">{{kb.name}}</div>
            </div>
          </div>
        {{/each}}
      </div>
    {{else if this.category.mine}}
      <p>{{t "Boards you've created, copied, or had shared with you." key="browse_mine"}}</p>
    {{/if}}
    {{#if this.category}}
      {{#if this.category_explainer_overflows}}
        <div class='more_link'>
          <a href="#" {{on "click" (this.ctrlAction "show_explainer")}}>{{t "more" key="more_lower"}}</a>
        </div>
      {{/if}}
    {{/if}}
    </div>
    {{#if this.category}}
      {{#if this.robust_tabbed}}
        {{!-- Setup Robust Vocabularies: the Quick Core and Vocal Flair
             MAIN boards (sub-boards excluded), each on its own boards-page
             glass card. `tabbed` gates this so /search/home is unaffected. --}}
        {{#each this.brand_groups as |group|}}
          <section class="setup-board-category__brand-card">
            <h3 class="setup-board-category__brand-title">{{group.title}}</h3>
            {{#if (is-equal group.result.state "loaded")}}
              {{#if group.result.boards.length}}
                <div class="md-home-boards-picker__grid">
                  {{#each group.result.boards as |board|}}
                    {{#if board.key}}
                      <div class="md-home-boards-picker__board simple_board_holder">
                        <BoardIcon @board={{board}} @prefetchPreview={{true}} />
                      </div>
                    {{/if}}
                  {{/each}}
                </div>
              {{else}}
                <div class="md-home-boards-picker__grid-message">{{t "None found" key="none_found"}}</div>
              {{/if}}
            {{else if (is-equal group.result.state "error")}}
              <div class="md-home-boards-picker__grid-message md-home-boards-picker__grid-message--error">{{t "Error loading boards" key="error_loading_boards"}}</div>
            {{else}}
              <div class="md-home-boards-picker__grid-message">{{t "Loading boards..." key="loading_boards"}}</div>
            {{/if}}
          </section>
        {{/each}}
      {{else if (and this.tabbed this.category.cause_effect)}}
        {{!-- Board-picker page: Cause and Effect is in development — show a single
             "coming soon" button as the category's content instead of a grid. The
             non-tabbed picker keeps its board grid (falls to the {{else}} below). --}}
        <div class="md-home-boards-picker__coming-soon">
          <button type="button" class="md-btn md-home-boards-picker__coming-soon-btn" disabled>{{t "Coming soon" key="coming_soon"}}</button>
        </div>
      {{else}}
      {{!-- Keyboards shows only the hardcoded placeholders above — suppress the
           category_boards grid + fallback search (nothing is tagged "keyboards",
           so it was falling back to unrelated popular boards). --}}
      {{#unless this.category.keyboards}}
      <div class="md-home-boards-picker__grid">
        {{#if this.category_boards.loading}}
          <div class="md-home-boards-picker__grid-message">
            {{t "Loading boards..." key="loading_boards"}}
          </div>
        {{else if this.category_boards.error}}
          <div class="md-home-boards-picker__grid-message md-home-boards-picker__grid-message--error">
            {{t "Error loading boards" key="error_loading_boards"}}
          </div>
        {{else if this.category_boards.length}}
          {{#each this.category_boards as |board|}}
            {{#if board.key}}
              <div class="md-home-boards-picker__board simple_board_holder">
                <BoardIcon @board={{board}} @prefetchPreview={{true}} />
              </div>
            {{/if}}
          {{/each}}
        {{else}}
          <div class="md-home-boards-picker__grid-message">
            {{t "None found" key="none_found"}}
          </div>
        {{/if}}
      </div>
      {{#unless this.category.mine}}
        <div class="md-home-boards-picker__search">
          {{#if this.used_category_fallback}}
            <p class="md-home-boards-picker__fallback-note" role="status">
              {{t "No boards are tagged for this category in the catalog yet. Here are popular public boards you can start from—pick any home board you like, or search below." key="home_board_category_fallback_note"}}
            </p>
          {{/if}}
          <form class="md-home-boards-picker__search-form" {{on "submit" (this.ctrlAction "go_search_boards")}}>
            <label for="board-picker-search-q" class="sr-only">{{t "Search Boards" key="search_boards"}}</label>
            <input
              id="board-picker-search-q"
              type="search"
              value={{this.boardSearchQuery}}
              {{on "input" (set-field this "boardSearchQuery")}}
              class="form-control md-home-boards-picker__search-input"
              placeholder={{t "Search public boards by name" key="board_picker_search_placeholder"}}
            />
            <button type="submit" class="md-btn md-btn--secondary md-home-boards-picker__search-submit">{{t "Search" key="search"}}</button>
          </form>
        </div>
      {{/unless}}
      {{/unless}}
      {{/if}}
    {{/if}}
  </div>
</div>
