{{!-- The app-wide View switch. One trigger, one item: whichever style you are
     NOT currently on. Same disclosure contract as the modern pill-nav dropdown
     (button + aria-expanded + aria-haspopup over a role="menu" list, driven by
     component state) so it needs no Bootstrap JS and works in both the modern
     navbar and the legacy classic header. --}}
{{#if this.available}}
<div class="ll-viewswitch {{if this.menu_open "is-open"}}">
  <button type="button" class="ll-viewswitch__trigger"
          aria-expanded={{if this.menu_open "true" "false"}}
          aria-haspopup="true"
          aria-label={{t "View style" key="view_style_menu"}}
          {{on "click" (this.ctrlAction "toggleMenu")}}>
    <svg class="ll-viewswitch__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="3"/>
      <line x1="3" y1="9" x2="21" y2="9"/>
      <line x1="9" y1="21" x2="9" y2="9"/>
    </svg>
    <span class="ll-viewswitch__label">{{t "View" key="view_menu_label"}}</span>
    <span class="ll-viewswitch__caret" aria-hidden="true"></span>
  </button>
  <ul class="ll-viewswitch__menu" role="menu">
    <li role="none">
      <button type="button" role="menuitem" class="ll-viewswitch__item" {{on "click" (this.ctrlAction "switch_view")}}>
        {{#if this.isClassic}}
          {{t "Card View" key="card_view"}}
        {{else}}
          {{t "Classic View" key="classic_view"}}
        {{/if}}
      </button>
    </li>
  </ul>
</div>
{{/if}}
