<ModalDialog @desired_width={{850}} @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="la-repairs-wrap">
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Modify and Repair Message" key="modify_and_repair_message"}}</h3>
    {{!-- "Oops" is a CONTROL, not an error state. It plays the correction sound
          (speecher.oops) so the listener knows a repair is coming. It used to be a
          bootstrap button carrying `float: right`, a 2px maroon border and
          `margin-top: -10px` inline, which put a red-bordered exclamation badge hard
          against the close X — every reviewer read it as the modal reporting a failure.
          Same action, now a normal member of the header row. --}}
    <button type="button" class="la-repairs-oops" {{on "click" (this.ctrlAction "oops")}}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><polyline points="3 3 3 8 8 8"/></svg>
      {{t "Oops" key="oops"}}
    </button>
  </div>
  <div class="modal-body md-modal-body">
    {{#if this.buttons}}
      <div class='cursor_holder'>
        <div class='cursor_navigation repair_buttons'>
          <button class='btn btn-default btn-lg la-repairs-btn up' {{on "click" (this.ctrlAction "move" "up")}} disabled={{this.not_scrollable}}>
            <span class='glyphicon glyphicon-chevron-up'></span>
            {{t "Up" key="up"}}
          </button>
          <button class='btn btn-default btn-lg la-repairs-btn down' {{on "click" (this.ctrlAction "move" "down")}} disabled={{this.not_scrollable}}>
            <span class='glyphicon glyphicon-chevron-down'></span>
            {{t "Down" key="down"}}
          </button>
        </div>
        <div class='row cursor_area'>
          {{#each this.buttons as |button|}}
            <div {{on "click" (this.ctrlAction "select" button)}} class={{button.cursor_class}}>
              <div class='cursor_blink prior'>
                <div class='left'>
                </div><div class='right'>
                </div>
                <span class='glyphicon glyphicon-move'></span>
              </div>
              <div class='cursor_btn'>
                <ButtonPreview @button={{button}} @width={{100}} @height={{100}} />
              </div>
              <div class='cursor_blink posterior'>
                <div class='left'>
                </div><div class='right'>
                </div>
                <span class='glyphicon glyphicon-move'></span>
              </div>
            </div>
          {{/each}}
        </div>
      </div>
      <div class='row repair_buttons'>
        <div class='col-sm-12'>
          <button class='btn btn-lg btn-default la-repairs-btn' {{on "click" (this.ctrlAction "move" "back")}}>
            {{#if this.has_selection}}
              {{#if this.moving}}
                <span class='glyphicon glyphicon-arrow-left'></span>
                {{t "Move Left" key="move_left"}}
              {{else}}
                <span class='glyphicon glyphicon-arrow-left'></span>
                {{t "Select Left" key="select_left"}}
              {{/if}}
            {{else}}
              <span class='glyphicon glyphicon-chevron-left'></span>
              {{t "Previous" key="previous"}}
            {{/if}}
          </button>
          <button class='btn btn-lg btn-default la-repairs-btn' {{on "click" (this.ctrlAction "move" "forward")}}>
            {{#if this.has_selection}}
              {{#if this.moving}}
                <span class='glyphicon glyphicon-arrow-right'></span>
                {{t "Move Right" key="move_right"}}
              {{else}}
                <span class='glyphicon glyphicon-arrow-right'></span>
                {{t "Select Right" key="select_right"}}
              {{/if}}
            {{else}}
              <span class='glyphicon glyphicon-chevron-right'></span>
              {{t "Next" key="next"}}
            {{/if}}
          </button>
          <button class='btn btn-lg btn-default la-repairs-btn' {{on "click" (this.ctrlAction "select")}}>
            {{#if this.has_selection}}
              <span class='glyphicon glyphicon-unchecked'></span>
              {{t "Unselect" key="unselect"}}
            {{else}}
              <span class='glyphicon glyphicon-screenshot'></span>
              {{t "Select" key="select"}}
            {{/if}}
          </button>
          {{#if this.has_selection}}
            {{#if this.moving}}
              <button class='btn btn-lg btn-default la-repairs-btn' {{on "click" (this.ctrlAction "enable_move")}}>
                <span class='glyphicon glyphicon-ok'></span>
                {{t "Done" key="done"}}
              </button>
            {{else}}
              <button class='btn btn-lg btn-default la-repairs-btn' {{on "click" (this.ctrlAction "enable_move")}}>
                <span class='glyphicon glyphicon-move'></span>
                {{t "Move" key="move"}}
              </button>
            {{/if}}
          {{else}}
            <button class='btn btn-lg btn-default la-repairs-btn' {{on "click" (this.ctrlAction "begin_insertion")}}>
              <span class='glyphicon glyphicon-comment'></span>
              {{t "Insert Here" key="insert_here"}}
            </button>
          {{/if}}
          <button class='btn btn-lg btn-default la-repairs-btn' {{on "click" (this.ctrlAction "remove")}}>
            <img src={{path "images/delete.svg"}} >
            {{t "Remove" key="remove"}}
          </button>
          <button class='btn btn-lg btn-default la-repairs-btn' style='display: none;'>
            <span class='glyphicon glyphicon-bell'></span>
            {{t "Suggestions" key="suggestions"}}
          </button>
        </div>
      </div>
    {{else}}
      <p>{{t "There is no text in the sentence box to modify. The repairs tool lets you quickly add, delete, move or modify words to make changes within the user's current speech window." key="no_words_to_repair"}}</p>
    {{/if}}
    <div class='row la-repairs-insert-row'>
      <div class='col-sm-12'>
        <div class="la-repairs-insert-field">
          {{#if this.has_selection}}
            <input value={{this.insertion}} class="form-control input-lg" type="text" placeholder="Replacement text for this word or phrase" aria-label={{t "Replacement text for this word or phrase" key="replacement_text"}} {{on "input" (set-field this "insertion")}} />
          {{else}}
            <input value={{this.insertion}} class="form-control input-lg" type="text" placeholder="Text to insert at cursor" aria-label={{t "Text to insert at cursor" key="text_to_insert_at_cursor"}} {{on "input" (set-field this "insertion")}} />
          {{/if}}
        </div>
        <div class="la-repairs-insert-action">
          <button class='btn btn-lg btn-default la-repairs-btn' {{on "click" (this.ctrlAction "insert")}}>
            {{#if this.has_selection}}
              {{t "Replace Text" key="replace_text"}}
            {{else}}
              {{t "Insert Text" key="insert_text"}}
            {{/if}}
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-footer md-modal-footer">
    <button class='btn btn-default btn-lg la-repairs-btn' {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
    {{#if this.model.speak_on_done}}
      <button class='btn btn-primary btn-lg' {{on "click" (this.ctrlAction "done" true)}}>
        {{t "Speak and Update" key="speak_and_update"}}
      </button>
    {{/if}}
    <button class='btn btn-primary btn-lg' {{on "click" (this.ctrlAction "done")}}>
      {{t "Update" key="update"}}
    </button>
  </div>
  </div>
</ModalDialog>
