<section class="ub-boards-page__boards-section" aria-labelledby="{{this.headingId}}">
  <div class="ub-boards-page__boards-header">
    <div class="ub-boards-page__boards-header-left">
      {{!-- Synonymous-term treatment: AAC users come from different
           systems where the same concept is called "Boards" (LingoLinq
           / TouchChat), "Vocabularies" (PRC/Tobii), or "Page-Sets"
           (NovaChat). Primary heading stays "Boards"; the equivalent
           terms ride in a parenthetical aside — lighter weight, muted
           color — so users coming from other systems recognize the
           section without the aliases competing with the heading. --}}
      <h2 id="{{this.headingId}}" class="ub-boards-page__boards-title">
        <span class="ub-boards-page__boards-title-primary">{{t "Boards" key="boards"}}</span>
        <span class="ub-boards-page__boards-title-aliases" aria-label={{t "also called Vocabularies or Page-Sets" key="boards_aliases_aria"}}>{{t "(Vocabularies & Page-Sets)" key="boards_aliases_parenthetical"}}</span>
      </h2>
    </div>
    {{#if this.showNewBoard}}
      <button class="ub-boards-page__new-board-btn" {{on "click" this.onNewBoard}}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        {{#if this.boardsCtrl.is_boards_empty}}
          {{t "Create Your First Board" key="create_first_board"}}
        {{else}}
          {{t "New Board" key="create_a_new_board"}}
        {{/if}}
      </button>
    {{/if}}
  </div>

  {{!-- Tab strip was moved into available-boards-section.hbs (placed
       directly above the Boards Filter) so the user picks a tab and
       then refines with the filter input. See that template for the
       rendered <ul class="ub-boards-page__tabs"> markup. --}}

  {{!-- Board grid (Mine folders, filter, DnD) --}}
  <div class="ub-boards-page__boards-body">
    <AvailableBoardsSection @boardsCtrl={{this.boardsCtrl}} @filterInputId={{this.filterInputId}} />
  </div>
</section>
