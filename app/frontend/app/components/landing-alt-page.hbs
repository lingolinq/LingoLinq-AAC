{{!-- =============================================================================
  LingoLinq Landing Page (landing-alt-page component)
  Modern layout in the speech-page app-shell style.
============================================================================= --}}

{{!-- la-wrapper--landing scopes landing-alt-only styling. Every other .la-wrapper page
     carries its own modifier (--about, --pricing, ...); this one had none, so shared
     classes like .la-plan-subtitle (also used by about.hbs) had no way to be tuned here
     without leaking onto those pages. --}}
<div class="la-wrapper la-wrapper--landing {{if (is-equal this.activeFont "atkinson") "la-font--atkinson"}} {{if (is-equal this.activeFont "lexend") "la-font--lexend"}}">
  <div class="app-shell">
    {{!-- ======== MAIN CONTENT ======== --}}
    <main class="la-main" id="la-main">

      {{!-- ── Hero ── --}}
      <section id="la-hero" class="la-hero-card hero-background">
        <div class="hero-container">
        <div class="la-hero-card-inner">
        <div class="la-hero-text">
          <div class="la-hero-headline-and-badges">
          <div class="la-hero-section la-hero-headline">
            <div class="la-hero-title-wrap">
              <h1 class="la-hero-title">
                <span class="la-hero-title-line1 la-hero-title--from-left">{{t "Communication" key='communication'}}</span><br>
                <span class="la-hero-title-line2 la-hero-title--from-right"><span class="la-hero-title-line1">{{t "access" key='access'}} {{t "for" key='for_lower'}}</span> <span class="hero-gradient">{{t "everyone" key='landing_hero_highlight'}}</span></span>
              </h1>
            </div>
          </div>
          <div class="la-hero-subtitle-badges-wrap">
            <p class="la-hero-subtitle">
              {{t "LingoLinq is an AI-powered AAC platform that ensures every voice is heard." key='landing_hero_subtitle_line1'}} {{t "It combines personalized symbol boards with adaptive AI that learns each communicator's unique needs, making the right words instantly accessible on any device—online or offline." key='landing_hero_subtitle_how'}}
            </p>
            <p class="la-hero-trust-line">{{t "Thoughtfully designed with continuous user feedback" key='landing_hero_trust_line'}}</p>
            <div class="la-hero-section la-hero-badges-section">
              <div class="la-hero-badges">
                <div class="la-hero-badge">
                  <span class="la-hero-badge-icon la-hero-badge-icon--cloud" aria-hidden="true">☁</span>
                  <span class="la-hero-badge-label">{{t "Cloud-based" key='landing_hero_cloud'}}</span>
                </div>
                <div class="la-hero-badge">
                  <span class="la-hero-badge-icon la-hero-badge-icon--cost" aria-hidden="true">$</span>
                  <span class="la-hero-badge-label">{{t "Lower Cost" key='landing_hero_lower_cost'}}</span>
                </div>
                <div class="la-hero-badge">
                  <span class="la-hero-badge-icon la-hero-badge-icon--school" aria-hidden="true">
                    <svg class="la-hero-badge-icon__svg" viewBox="0 0 24 24" fill="currentColor" role="img" aria-hidden="true">
                      <path d="M10 3l1.5 4.6a2 2 0 0 0 1.3 1.3L17.4 10.4l-4.6 1.5a2 2 0 0 0-1.3 1.3L10 17.8l-1.5-4.6a2 2 0 0 0-1.3-1.3L2.6 10.4l4.6-1.5a2 2 0 0 0 1.3-1.3L10 3z"/>
                      <path d="M18.4 13l.7 2.1a1 1 0 0 0 .6.6l2.1.7-2.1.7a1 1 0 0 0-.6.6l-.7 2.1-.7-2.1a1 1 0 0 0-.6-.6L15 16.5l2.1-.7a1 1 0 0 0 .6-.6l.7-2.1z"/>
                    </svg>
                  </span>
                  <span class="la-hero-badge-label">{{t "AI-driven" key='landing_hero_classrooms'}}</span>
                </div>
              </div>
            </div>
          </div>
          </div>
          <div class="la-hero-section la-hero-actions-section">
          <div class="la-hero-actions">
            <LinkTo @route="register" class="la-btn la-btn--primary">{{t "Try LingoLinq Free" key='landing_try_free'}} →</LinkTo>
            {{!-- Routes to the live demo, same destination as the navbar's "Try a Demo"
                 (app-navbar.hbs) — demo.speak with board/source cleared so it always
                 opens the manifest root (Project Core 36) rather than inheriting a
                 board from the current query params. Was an <a href="#la-demo">, which
                 was dead: no element with that id exists on the page. --}}
            <LinkTo @route="demo.speak" @query={{hash board=null source=null}} class="la-btn la-btn--ghost">{{t "Try a Demo" key="demo_try_speak_mode"}}</LinkTo>
          </div>
          </div>
        </div>

        <div class="la-hero-mockup-wrap">
          <div class="la-floating-chip la-floating-chip--tl">
            <div class="la-chip-icon la-chip-icon--teal">🌐</div>
            <div>
              <div class="la-chip-title">{{t "AI Language Support" key='landing_ai_language_support'}}</div>
              <div class="la-chip-sub">{{t "Multiple languages" key='landing_10_plus_languages'}}</div>
            </div>
          </div>

          <div class="la-floating-chip la-floating-chip--br">
            <div class="la-chip-icon la-chip-icon--coral">⚡</div>
            <div>
              <div class="la-chip-title">{{t "Setup in Minutes" key='landing_setup_minutes'}}</div>
              <div class="la-chip-sub">{{t "No hardware needed" key='landing_no_hardware'}}</div>
            </div>
          </div>

          <div class="la-mockup" role="img" aria-label={{t "An illustrative LingoLinq communication board with symbol buttons — feel, eat, go, hi, want, play, read, more — and a sentence bar reading 'I want to play'." key='landing_hero_mockup_alt'}}>
            <div class="la-mockup-bar">
              <div class="la-mockup-dot la-mockup-dot--r"></div>
              <div class="la-mockup-dot la-mockup-dot--y"></div>
              <div class="la-mockup-dot la-mockup-dot--g"></div>
              <span class="la-mockup-url">lingolinq.com</span>
            </div>
            <div class="la-mockup-screen">
              <div class="la-mockup-grid">
                <div class="la-aac-btn la-aac-btn--c1"><span class="la-aac-icon">😊</span>feel</div>
                <div class="la-aac-btn la-aac-btn--c2"><span class="la-aac-icon">🍎</span>eat</div>
                <div class="la-aac-btn la-aac-btn--c3"><span class="la-aac-icon">🏠</span>go</div>
                <div class="la-aac-btn la-aac-btn--c4"><span class="la-aac-icon">👋</span>hi</div>
                <div class="la-aac-btn la-aac-btn--c5"><span class="la-aac-icon">❓</span>want</div>
                <div class="la-aac-btn la-aac-btn--c6"><span class="la-aac-icon">🎮</span>play</div>
                <div class="la-aac-btn la-aac-btn--c7"><span class="la-aac-icon">📚</span>read</div>
                <div class="la-aac-btn la-aac-btn--c8"><span class="la-aac-icon">💬</span>more</div>
              </div>
              <div class="la-mockup-sentence">
                <span class="la-mockup-sentence-text">{{t "I want to play" key='landing_mockup_sentence'}}</span>
                <span class="la-mockup-speak">{{t "Speak" key='landing_mockup_speak'}}</span>
              </div>
            </div>
          </div>
        </div>
        </div>
        </div>
      </section>

      {{!-- ── Speech-Therapist Spotlight ── Sits ABOVE Features. Rendered ONCE and shown at
           every width: it lives outside the parallax zone now, so the old desktop/mobile
           duplicate (which existed only to place a copy inside vs. outside that zone) is gone.
           The card frame it used to inherit from .la-parallax-zone is re-applied by the
           .la-slp-spotlight .la-parallax-card-outer rule in app.scss. --}}
      <section id="la-slp-spotlight" class="la-slp-spotlight" aria-labelledby="la-slp-spotlight-title">
        <div class="la-parallax-card-outer la-slp-spotlight__card">
          <div class="la-parallax-card-inner la-slp-spotlight__inner">
            {{!-- Reuse .la-plan-text + .la-plan-title so the eyebrow pill and
                 title inherit the exact same styling as "Included in every plan" --}}
            <div class="la-plan-text la-slp-spotlight__header">
              <span class="la-section-eyebrow-badge">{{t "Why LingoLinq" key='landing_why_label'}}</span>
              <h2 id="la-slp-spotlight-title" class="la-plan-title la-slp-spotlight__title">{{t "We focus on" key='fsa_slp_spotlight_title_1'}} <em>{{t "everyone's needs" key='fsa_slp_spotlight_title_2'}}</em></h2>
            </div>
            <p class="la-plan-subtitle la-slp-spotlight__body">{{t "From first words to lifelong communication, everyone has a place here. We support communicators, families, clinicians, and educators alike." key='fsa_slp_spotlight_body'}}</p>
            {{!-- One label, but the CSS swaps the image by breakpoint: aac-user.jpg
                 (a child using an AAC board at home) above 1024px, landing-classroom.jpg
                 (a child and an educator using one in a classroom) below. The wording is
                 deliberately true of BOTH; it can only get more specific if the two
                 breakpoints stop showing different photos. --}}
            <div class="la-slp-spotlight__image" role="img" aria-label={{t "A smiling child points to a symbol on an AAC communication board displayed on a tablet" key='fsa_slp_spotlight_image_alt'}}></div>
          </div>
        </div>
      </section>

      {{!-- ── Our Mission ── --}}
      <section id="la-mission" class="la-section">
        <div class="la-section-header">
          <span class="la-section-eyebrow-badge">{{t "Our Mission" key='landing_mission_eyebrow'}}</span>
          <h2 class="la-section-title">{{t "Your Voice, Safe and" key='landing_mission_title_1'}} <em>{{t "Supported" key='landing_mission_title_2'}}</em></h2>
          <p class="la-section-subtitle">{{t "Removing barriers to communication means more than making AAC accessible. It means making communication easier and faster, while preserving each person's voice, personality, and intent. We build for safety, trust, and privacy, so communicators and the people who support them can focus on what matters most: connecting with each other." key='landing_mission_statement'}}</p>
        </div>
      </section>

      {{!-- ── Features ── --}}
      <section id="la-features" class="la-section">
        <div class="la-section-header">
          <span class="la-section-eyebrow-badge">{{t "Built for schools & therapists" key='fsa_slp_spotlight_eyebrow'}}</span>
          {{!-- Distinct keys from the /features page, which still renders
                "Built for how schools actually work" from landing_features_title_*. --}}
          {{!-- <em> picks up the .la-wrapper .la-section-title em highlight gradient. --}}
          <h2 class="la-section-title">{{t "Real collaboration." key='landing_alt_features_title_1'}} <em>{{t "Better communication." key='landing_alt_features_title_em'}}</em></h2>
          {{!-- Distinct key from the /features page, which still renders the original
                sentence (ending at "the cloud era.") from landing_features_subtitle. --}}
          <p class="la-section-subtitle">{{t "Every feature is shaped by feedback from the educators, therapists, caregivers, and communicators who rely on it every day." key='landing_alt_features_subtitle'}}</p>
        </div>
        <div class="la-feature-grid">
          <div class="la-feature-card">
            <div class="la-feature-icon la-feature-icon--coral" aria-hidden="true">🤖</div>
            <h3>{{t "AI-Powered Board Generation" key='landing_feature_ai_title'}}</h3>
            <p>{{t "Describe a topic and LingoLinq's opt-in AI builds communication boards automatically — what used to take hours now takes minutes. Your content is never used to train AI models." key='landing_feature_ai_desc'}}</p>
          </div>
          <div class="la-feature-card">
            <div class="la-feature-icon la-feature-icon--teal" aria-hidden="true">🌍</div>
            <h3>{{t "Multilingual from Day One" key='landing_feature_multilingual_title'}}</h3>
            <p>{{t "AI-driven language expansion supports multiple languages with proper grammar — not word-for-word translation." key='landing_feature_multilingual_desc'}}</p>
          </div>
          <div class="la-feature-card">
            <div class="la-feature-icon la-feature-icon--navy" aria-hidden="true">🏫</div>
            <h3>{{t "District-Wide Management" key='landing_feature_district_title'}}</h3>
            <p>{{t "Google Classroom-style dashboard: manage students, therapists, and devices from one screen." key='landing_feature_district_desc'}}</p>
          </div>
          <div class="la-feature-card">
            <div class="la-feature-icon la-feature-icon--teal" aria-hidden="true">☁️</div>
            <h3>{{t "Cloud-Native, Any Device" key='landing_feature_cloud_title'}}</h3>
            <p>{{t "Works on tablets, phones, laptops, and smartboards. Edit from your desk; students access from anywhere." key='landing_feature_cloud_desc'}}</p>
          </div>
          <div class="la-feature-card">
            <div class="la-feature-icon la-feature-icon--coral" aria-hidden="true">📊</div>
            <h3>{{t "Real Analytics for IEPs" key='landing_feature_analytics_title'}}</h3>
            <p>{{t "Opt in to track vocabulary growth, usage, and communication attempts. When you enable it, reports map directly to IEP goals — and you can turn analytics off at any time." key='landing_feature_analytics_desc'}}</p>
          </div>
          <div class="la-feature-card">
            <div class="la-feature-icon la-feature-icon--navy" aria-hidden="true">👨‍👩‍👧</div>
            <h3>{{t "Family Access Built In" key='landing_feature_family_title'}}</h3>
            <p>{{t "Parents and caregivers get free companion access. Same boards, school to home — no extra cost." key='landing_feature_family_desc'}}</p>
          </div>
        </div>
      </section>

      {{!-- Parallax zone: from "Included in every plan" through footer --}}
      <div class="la-parallax-zone">
      {{!-- ── Included in Every Plan ── --}}
      <section id="la-plan" class="la-plan-section">
        <div class="la-parallax-card-outer">
        <div class="la-parallax-card-inner">
        <div class="la-plan-layout">
          <div class="la-plan-text">
            <span class="la-section-eyebrow-badge">{{t "Included in every plan" key='fsa_included_plan'}}</span>
            <h2 class="la-plan-title">{{t "Everything you need," key='fsa_plan_title_1'}} <em>{{t "nothing you don't" key='fsa_plan_title_2'}}</em></h2>
            {{!-- `--compact` sets this paragraph to 16px. It needs its own modifier because
                 .la-plan-subtitle is SHARED with the SLP and devices spotlight bodies on
                 this page AND with about.hbs, none of which change size. --}}
            <p class="la-plan-subtitle la-plan-subtitle--compact">{{t "Every LingoLinq plan includes robust features with options to upgrade at any time." key='fsa_plan_subtitle'}}</p>
          </div>
          <ul class="la-plan-grid">
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "AI board generation" key='fsa_check_ai'}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "multiple language support" key='fsa_check_langs'}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "Family companion access" key='fsa_check_family'}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "IEP-ready analytics" key='fsa_check_iep'}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "Works offline" key='fsa_check_offline'}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "Working toward WCAG 2.1 AA" key='fsa_check_wcag'}}</span>
            </li>
          </ul>
        </div>
        </div>
        </div>
      </section>

      {{!-- ── Devices Spotlight (≤1024px only — mirrors the SLP spotlight pattern, swapping image + copy) ── --}}
      <section id="la-devices-spotlight" class="la-devices-spotlight" aria-labelledby="la-devices-spotlight-title">
        <div class="la-parallax-card-outer la-devices-spotlight__card">
          <div class="la-parallax-card-inner la-devices-spotlight__inner">
            <div class="la-plan-text la-devices-spotlight__header">
              <span class="la-section-eyebrow-badge">{{t "Available on all devices" key='fsa_devices_spotlight_eyebrow'}}</span>
              <h2 id="la-devices-spotlight-title" class="la-plan-title la-devices-spotlight__title">{{t "Use LingoLinq anywhere," key='fsa_devices_spotlight_title_1'}} <em>{{t "anytime" key='fsa_devices_spotlight_title_2'}}</em></h2>
            </div>
            <p class="la-plan-subtitle la-devices-spotlight__body">{{t "Use LingoLinq on the devices you already have. Once your boards are loaded, they're available online or offline, wherever you go." key='fsa_devices_spotlight_body'}}</p>
            <div class="la-devices-spotlight__image" role="img" aria-label={{t "LingoLinq running the same AAC communication board on a laptop, a tablet, and a phone" key='fsa_devices_spotlight_image_alt'}}></div>
          </div>
        </div>
      </section>

      {{!-- ── Privacy Commitment ── --}}
      <section id="la-testimonial" class="la-testimonial-section">
        <div class="la-parallax-card-outer">
        <div class="la-parallax-card-inner">
        <div class="la-plan-text">
          <span class="la-section-eyebrow-badge">{{t "Your privacy" key='landing_privacy_eyebrow'}}</span>
          <h2 class="la-plan-title">{{t "Your data stays" key='landing_privacy_title_1'}} <em>{{t "yours" key='landing_privacy_title_2'}}</em></h2>
          {{!-- `--compact` sets this paragraph to 16px. It needs its own modifier because
               .la-a11y-display-text is SHARED with the Accessibility Statement paragraph
               below, which keeps its larger display size. --}}
          <p class="la-a11y-display-text la-a11y-display-text--compact">{{t "We never sell or share your information, and we never use it to train AI models. Our AI tools and analytics — including Real Analytics for IEPs — are strictly opt-in, and you can turn any of them off at any time." key='landing_privacy_statement'}}</p>
        </div>
        </div>
        </div>
      </section>

      {{!-- ── Accessibility Statement ── --}}
      <section id="la-a11y" class="la-a11y-statement">
        <div class="la-parallax-card-outer">
        <div class="la-parallax-card-inner">
        <span class="la-section-eyebrow-badge">{{t "Accessibility First" key='accessibility_first'}}</span>
        <div class="la-a11y-display">
          <p class="la-a11y-display-text">{{t "We are continually working to meet" key='landing_a11y_meets'}} <strong>{{t "WCAG 2.1 AA" key='landing_a11y_wcag'}}</strong> {{t "standards. We use Atkinson Hyperlegible (designed by the Braille Institute) and Lexend (optimized for reading fluency) because we believe our tools should be accessible to everyone, including our website." key='landing_a11y_standards'}}</p>
        </div>
        <ul class="la-a11y-trust-badges" aria-label="{{t "Accessibility highlights" key='landing_a11y_highlights_label'}}">
          <li class="la-a11y-trust-item"><span class="la-a11y-trust-check" aria-hidden="true"></span><span>{{t "Working toward WCAG 2.1 AA" key='fsa_check_wcag'}}</span></li>
          <li class="la-a11y-trust-item"><span class="la-a11y-trust-check" aria-hidden="true"></span><span>{{t "Accessible typography" key='landing_a11y_typography'}}</span></li>
          <li class="la-a11y-trust-item"><span class="la-a11y-trust-check" aria-hidden="true"></span><span>{{t "Designed for neurodivergent users" key='landing_a11y_neurodivergent'}}</span></li>
        </ul>
        <div class="la-a11y-attribution">
          <span class="la-a11y-accommodations">{{t "Need accommodations?" key='landing_a11y_need'}} <LinkTo @route="contact" class="la-a11y-statement-link">{{t "Let us know." key='landing_a11y_let_us_know'}}</LinkTo></span>
        </div>
        </div>
        </div>
      </section>

      </div>{{!-- /.la-parallax-zone --}}

      {{!-- ── Devices Spotlight (DESKTOP version, >1024px only — sits below the parallax zone; the mobile mirror inside the parallax zone is hidden at this width) ── --}}
      <section id="la-devices-spotlight-desktop" class="la-devices-spotlight la-spotlight-desktop" aria-labelledby="la-devices-spotlight-desktop-title">
        <div class="la-parallax-card-outer la-devices-spotlight__card">
          <div class="la-parallax-card-inner la-devices-spotlight__inner">
            <div class="la-plan-text la-devices-spotlight__header">
              <span class="la-section-eyebrow-badge">{{t "Available on all devices" key='fsa_devices_spotlight_eyebrow'}}</span>
              <h2 id="la-devices-spotlight-desktop-title" class="la-plan-title la-devices-spotlight__title">{{t "Use LingoLinq anywhere," key='fsa_devices_spotlight_title_1'}} <em>{{t "anytime" key='fsa_devices_spotlight_title_2'}}</em></h2>
            </div>
            <p class="la-plan-subtitle la-devices-spotlight__body">{{t "Use LingoLinq on the devices you already have. Once your boards are loaded, they're available online or offline, wherever you go." key='fsa_devices_spotlight_body'}}</p>
            <div class="la-devices-spotlight__image" role="img" aria-label={{t "LingoLinq running the same AAC communication board on a laptop, a tablet, and a phone" key='fsa_devices_spotlight_image_alt'}}></div>
          </div>
        </div>
      </section>

      {{!-- ── Ready to Start ── --}}
      <section id="la-cta" class="la-cta-section">
        <div class="la-cta-inner">
          <span class="la-cta-eyebrow">{{t "Ready to start?" key='fsa_ready_to_start'}}</span>
          <h2 class="la-cta-headline">{{t "Give every person" key='landing_cta_title_1'}} <em>{{t "a voice" key='landing_cta_title_2'}}</em></h2>
          <p class="la-cta-description">{{t "Start with our free tier. No credit card, no hardware, no commitment. Just communication tools that work." key='landing_cta_subtitle'}}</p>
          <div id="la-cta-buttons" class="la-cta-buttons">
            <LinkTo @route="register" class="la-btn la-btn--primary la-btn--lg">{{t "Start Free Today" key='landing_cta_start'}} &rarr;</LinkTo>
            <LinkTo @route="contact" class="la-btn la-btn--ghost">{{t "Schedule a District Demo" key='landing_cta_demo'}}</LinkTo>
          </div>
        </div>
      </section>

      {{!-- ── Footer (reusable collapse: brand + hamburger at 1024px, drawer with links) ── --}}
      <footer id="la-footer" class="la-footer la-footer--collapsible">
        <div class="la-footer-inner">
          <div class="la-footer-brand">
            <p>{{t "Open-source, AI-powered communication tools for everyone. Built by people who live this work every day." key='landing_footer_tagline'}}</p>
          </div>
          <div class="la-footer__main--desktop">
            <div class="la-footer-col">
              <h4>{{t "Product" key='landing_footer_product'}}</h4>
              <nav aria-label={{t "Product" key="fsa_nav_product"}}>
              <LinkTo @route="features">{{t "Features" key='landing_footer_features'}}</LinkTo>
              {{!-- <LinkTo @route="pricing">{{t "Pricing" key='landing_footer_pricing'}}</LinkTo> --}}
              </nav>
            </div>
            <div class="la-footer-col">
              <h4>{{t "Resources" key='landing_footer_resources'}}</h4>
              <nav aria-label={{t "Resources" key="fsa_nav_resources"}}>
              <LinkTo @route="register">{{t "Getting Started" key='landing_footer_getting_started'}}</LinkTo>
              <LinkTo @route="support" class="la-footer-link-btn">{{t "Help Center" key='landing_footer_help'}}</LinkTo>
              <LinkTo @route="faq" class="la-footer-link-btn">{{t "Guides & FAQs" key='landing_footer_how_tos'}}</LinkTo>
              {{#if this.appState.showFooterGithubLinks}}
