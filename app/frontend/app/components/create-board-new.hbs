<GridListener @gridEvent={{this.ctrlAction "grid_event"}}>
  <div class="board_drop new-board--modern md-workspace md-workspace--create-board-new">
    {{!-- Orientation overlay: at ≤768px the build canvas is cramped, so reuse
         the board-detail landscape-rotate overlay (same .md-board-detail-portrait-
         overlay visual) to invite a rotate. Always in the DOM; shown purely via a
         ≤768px media query (.nb-orientation-overlay in app.scss), mirroring the
         Dashboard Design step's .md-ds-orientation pattern. "Continue Anyway" is
         the accessibility escape for mounted / non-rotatable setups. SVG def ids
         are nb-prefixed so they never collide with the board-detail instance. --}}
    <div class="md-board-detail-portrait-overlay nb-orientation-overlay {{if this.orientation_overlay_hidden 'nb-orientation-overlay--dismissed'}}" role="dialog" aria-modal="true" aria-label={{t "Landscape mode recommended" key="board_detail_landscape_recommended"}}>
      <div class="md-board-detail-portrait-overlay__card">
        <span class="md-board-detail-portrait-overlay__accent" aria-hidden="true"></span>
        <div class="md-board-detail-portrait-overlay__phone" aria-hidden="true">
          <svg class="md-board-detail-portrait-overlay__phone-arc" width="76" height="76" viewBox="0 0 76 76" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="nb-rot-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#5ED0C0"/><stop offset="100%" stop-color="#1C7E72"/></linearGradient>
              <filter id="nb-rot-shadow" x="-60%" y="-60%" width="220%" height="220%"><feDropShadow dx="0" dy="1.5" stdDeviation="2" flood-color="#2A9D8F" flood-opacity="0.5"/></filter>
            </defs>
            <g filter="url(#nb-rot-shadow)" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path class="md-board-detail-portrait-overlay__arc-track" d="M34 14 C62 8 75 34 65 48" stroke="currentColor" stroke-width="3" stroke-opacity="0.20"/>
              <path class="md-board-detail-portrait-overlay__arc-comet" d="M34 14 C62 8 75 34 65 48" pathLength="100" stroke="url(#nb-rot-grad)" stroke-width="3.5"/>
              <polyline class="md-board-detail-portrait-overlay__arc-head" points="59 42 65 48 71 42" stroke="url(#nb-rot-grad)" stroke-width="3.5"/>
            </g>
          </svg>
          <svg class="md-board-detail-portrait-overlay__phone-svg" width="76" height="76" viewBox="0 0 76 76" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="30" y="24" width="16" height="28" rx="4.5"/><line x1="35" y1="47" x2="41" y2="47"/>
          </svg>
        </div>
        <h2 class="md-board-detail-portrait-overlay__title">{{t "Landscape mode recommended" key="board_detail_landscape_recommended"}}</h2>
        <p class="md-board-detail-portrait-overlay__desc">{{t "Rotate your device to landscape for the room to create and customize your board." key="create_board_landscape_explanation"}}</p>
        <div class="md-board-detail-portrait-overlay__actions">
          <button type="button" class="md-board-detail-portrait-overlay__btn md-board-detail-portrait-overlay__btn--secondary" {{on "click" (this.ctrlAction "dismiss_orientation_overlay")}}>{{t "Continue Anyway" key="board_detail_continue_anyway"}}</button>
        </div>
      </div>
    </div>
    {{!-- Create-method chooser: shown on entry (standalone page only). Options
         rise in successively (staggered animation-delay + nb-chooser-rise), each
         routing into its flow: Create My Own → the regular form (dismiss),
         Generate with AI → the in-page AI flow, Import Board(s) → the native file
         picker, Paste HTML / Import from another platform (when enabled) → their
         modals. The first two are promoted to full chooser buttons (OR between
         them, OR after the pair); the rest render as slate-gray links below. --}}
    {{#if (and this.standalone this.show_create_chooser)}}
      <div class="nb-create-chooser" role="dialog" aria-modal="true" aria-label={{t "How would you like to create your board?" key="create_chooser_title"}}>
        <div class="nb-create-chooser__panel">
          {{!-- Close → the component's `close` action, which returns the user to
               whichever page they opened create-board-new from (history back, the
               board-picker tour modal, or an onClose handler). --}}
          <button type="button" class="nb-create-chooser__close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close and return to previous page" key="close_create_board"}} title={{t "Close" key="close"}}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
          <div class="nb-create-chooser__title">{{t "How would you like to create your board?" key="create_chooser_title"}}</div>
          <div class="nb-create-chooser__separator" aria-hidden="true"></div>
          <div class="nb-create-chooser__options">
            <button type="button" class="nb-create-chooser__btn nb-create-chooser__btn--own" style="animation-delay: 0.05s" {{on "click" (this.ctrlAction "choose_create_own")}}>
              <span class="nb-create-chooser__btn-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </span>
              <span class="nb-create-chooser__btn-label">{{t "Create My Own Board" key="create_my_own_board"}}</span>
            </button>
            <span class="nb-create-chooser__or" style="animation-delay: 0.25s" aria-hidden="true"><span class="nb-create-chooser__or-text">{{t "OR" key="or_separator_caps"}}</span></span>
            <button type="button" class="nb-create-chooser__btn nb-create-chooser__btn--ai" style="animation-delay: 0.45s" {{on "click" (this.ctrlAction "choose_ai")}}>
              <span class="nb-ai-sparkle-badge nb-create-chooser__sparkle-badge" aria-hidden="true">
                <span class="nb-ai-sparkle nb-create-chooser__sparkle"></span>
              </span>
              <span class="nb-create-chooser__btn-label">{{t "Generate with AI" key="generate_with_ai"}}</span>
            </button>
            <span class="nb-create-chooser__or" style="animation-delay: 0.65s" aria-hidden="true"><span class="nb-create-chooser__or-text">{{t "OR" key="or_separator_caps"}}</span></span>
            {{!-- Secondary methods: Create My Own / Generate with AI are the two
                 promoted keys above; every remaining method drops to a small
                 slate-gray text link here. Real <button>s (they fire actions —
                 file picker, import modals — they don't navigate), so they reuse
                 the .md-link-btn link-semantics primitive. --}}
            <div class="nb-create-chooser__alt" style="animation-delay: 0.75s">
              <button type="button" class="md-link-btn nb-create-chooser__alt-link" {{on "click" (this.ctrlAction "choose_import")}}>{{t "Import Board(s)" key="import_boards"}}</button>
              {{#if this.paste_html_import_enabled}}
                <button type="button" class="md-link-btn nb-create-chooser__alt-link" {{on "click" (this.ctrlAction "choose_paste_html")}}>{{t "Paste HTML" key="paste_html"}}</button>
                <button type="button" class="md-link-btn nb-create-chooser__alt-link" {{on "click" (this.ctrlAction "choose_json_bundle")}}>{{t "Import Board from Another Platform" key="import_json_bundle"}}</button>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    {{/if}}
    {{#if this.standalone}}
    <button type="button" class="md-workspace__close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close and return to previous page" key="close_create_board"}} title={{t "Close" key="close"}}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="modal-header md-modal-header nb-create-header">
      <div class="nb-create-header__intro">
        <h3>{{#if this.ai_mode}}{{t "Create a New Board with AI" key="create_a_new_board_with_ai"}}{{else if this.via_create_own}}{{t "Create My Own Board" key="create_my_own_board"}}{{else}}{{t "Create a New Board" key="create_a_new_board"}}{{/if}}</h3>
        {{#if this.ai_mode}}
          <ul class="la-checklist">
            <li>
              <span class="la-check" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
              {{t "Generate this board's buttons from your description using AI" key="ai_intro_check_generate"}}
            </li>
            <li>
              <span class="la-check" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
              {{t "You'll be able to review and edit everything before creating the board" key="ai_intro_check_review"}}
            </li>
          </ul>
        {{else}}
          <p class="nb-create-header__subtitle">{{t "Build from scratch, paste labels, import a CSV, or choose from core lists." key="create_board_intro_subtitle"}}</p>
        {{/if}}
      </div>
      <div class="create-board-actions">
        {{#if this.ai_mode}}
          {{!-- AI mode: other creation options are hidden; an
               editing-style status pill plus a way back to the rest.
               The badge title + caption swap based on `ai_labels_generated`:
               BEFORE Generate Labels with AI fires, the badge prompts
               the user to describe the board ("Describe the board
               below, then generate"); AFTER labels come back, the
               badge guides them to the final Save Board step
               ("Click Save Board to complete generation"). The user
               is still mid-flow at that point — labels exist but the
               board hasn't been persisted yet — so "Generating with
               AI" stays current-tense. --}}
          <div class="nb-ai-mode-wrap">
            <span class="nb-ai-mode-badge" role="status">
              <span class="nb-ai-mode-badge__row">
                <span class="nb-ai-sparkle-badge" aria-hidden="true">
                  <span class="nb-ai-sparkle {{if this.status.saving "nb-ai-sparkle--active"}}"></span>
                </span>
                <span class="nb-ai-mode-badge__title">{{t "Generating with AI" key="ai_mode_badge"}}</span>
              </span>
              <span class="nb-ai-mode-badge__caption">
                {{#if this.ai_labels_generated}}
                  {{t "Click Save Board to complete generation" key="ai_mode_badge_caption_after_labels_save"}}
                {{else}}
                  {{t "Describe the board below, then generate" key="ai_mode_badge_caption"}}
                {{/if}}
              </span>
            </span>
            <button type="button" class="nb-ai-mode-other nb-other-methods-btn" {{on "click" (this.ctrlAction "open_create_chooser")}}>
              {{t "Other Create Board Methods" key="other_create_methods"}}
            </button>
          </div>
        {{else}}
          {{!-- The Import / Generate-with-AI options now live in the create-method
               chooser (shown on entry). This single CENTERED button reopens that
               chooser so the user can switch methods. The board-file input stays
               in the DOM (hidden) so the chooser's "Import Board(s)" can still
               trigger it — content-grabbers.js processes #board_upload on change. --}}
          {{!-- Verified non-defect: this input is display:none (kept in the DOM only so the
               chooser's "Import Board(s)" can programmatically trigger #board_upload), so it is
               NEVER in the accessibility tree — axe reports it inapplicable. Labeling a control
               that AT can never reach adds noise, not access. --}}
          {{! template-lint-disable require-input-accessible-name }}
          <input type="file" name="board_upload" id="board_upload" tabindex="-1" style="display: none;">
          {{! template-lint-enable require-input-accessible-name }}
          <button type="button" class="nb-ai-mode-other nb-other-methods-btn" {{on "click" (this.ctrlAction "open_create_chooser")}}>
            {{t "Other Create Board Methods" key="other_create_methods"}}
          </button>
        {{/if}}
        {{!-- Top-right Save Board: same action as the footer button,
             but only rendered once the form is valid (createBoardDisabled
             is false) so it stays hidden until the user has filled out
             the required fields. --}}
        {{#unless this.createBoardDisabled}}
          <button {{on "click" (this.ctrlAction "attemptSave")}}
                  class="btn btn-primary new-board__submit new-board__submit--top">
            {{#if this.status.saving}}
              {{t "Creating Board..." key="creating_board"}}
            {{else if this.status.error}}
              {{t "Error Creating Board" key="error_creating_board"}}
            {{else}}
              {{t "Save Board" key="save_board"}}
            {{/if}}
          </button>
        {{/unless}}
      </div>
    </div>
    {{else}}
    <div class="la-modal-header">
      <span class="la-modal-header-label">{{t "Create a New Board" key="create_a_new_board"}}</span>
      <div class="la-support-modal-header-meta">
        <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
      </div>
    </div>
    {{/if}}
    <div class="{{if this.standalone "modal-body" "la-support-modal-body"}}">
      {{#unless this.standalone}}
      <div class="la-new-board-modal-actions">
        {{#if this.ai_mode}}
          <div class="nb-ai-mode-wrap">
            <span class="nb-ai-mode-badge" role="status">
              <span class="nb-ai-mode-badge__row">
                <span class="nb-ai-sparkle-badge" aria-hidden="true">
                  <span class="nb-ai-sparkle {{if this.status.saving "nb-ai-sparkle--active"}}"></span>
                </span>
                <span class="nb-ai-mode-badge__title">{{t "Generating with AI" key="ai_mode_badge"}}</span>
              </span>
              <span class="nb-ai-mode-badge__caption">
                {{#if this.ai_labels_generated}}
                  {{t "Click Save Board to complete generation" key="ai_mode_badge_caption_after_labels_save"}}
                {{else}}
                  {{t "Describe the board below, then generate" key="ai_mode_badge_caption"}}
                {{/if}}
              </span>
            </span>
            <button type="button" class="nb-ai-mode-other" {{on "click" (this.ctrlAction "set_create_mode" "regular")}}>
              {{t "Other Create Board Methods" key="other_create_methods"}}
            </button>
          </div>
        {{else}}
          <span class="file_select_holder">
            <button type="button" class="la-btn la-btn--ghost">
              {{t "Import Board(s)" key="import_boards"}}
            </button>
            {{!-- Verified false positive: this #board_upload and the chooser-branch one
                 are mutually-exclusive template branches, so only one renders (live DOM
                 count=1, zero duplicate ids on the page). #board_upload is JS-targeted
                 (getElementById + content-grabbers event.target.id), so renaming breaks
                 board import. --}}
            {{! template-lint-disable no-duplicate-id }}
            <input type="file" name="board_upload" id="board_upload" tabindex="-1" aria-label={{t "Import Board(s)" key="import_boards"}}>
            {{! template-lint-enable no-duplicate-id }}
          </span>
          {{#if this.paste_html_import_enabled}}
            <button type="button" class="la-btn la-btn--ghost" {{on "click" (this.ctrlAction "importFromHtml")}}>
              {{t "Paste HTML" key="paste_html"}}
            </button>
            <button type="button" class="la-btn la-btn--ghost" {{on "click" (this.ctrlAction "importFromJsonBundle")}}>
              {{t "Import Board from Another Platform" key="import_json_bundle"}}
            </button>
          {{/if}}
          {{#if this.ai_board_generation_enabled}}
            {{!-- Same-row, page-centered Generate with AI button. See
                 .nb-generate-ai-btn positioning rules in app.scss. --}}
            <button type="button" class="la-btn la-btn--ghost nb-generate-ai-btn" {{on "click" (this.ctrlAction "request_ai_mode")}}>
              <span class="nb-ai-sparkle-badge nb-generate-ai-btn__sparkle-badge" aria-hidden="true">
                <span class="nb-ai-sparkle nb-generate-ai-btn__sparkle"></span>
              </span>
              <span class="nb-generate-ai-btn__title ub-communicate" aria-label={{t "Generate with AI" key="generate_with_ai"}}>{{letter-stagger (t "Generate with AI" key="generate_with_ai") start=0 step=0.05}}</span>
            </button>
          {{/if}}
        {{/if}}
      </div>
      {{/unless}}
      <form class="nb-form {{unless this.standalone "la-new-board-form"}}" {{on "submit" (this.ctrlAction "saveBoard")}}>

        <section class="nb-section">
          <div class="nb-section__header-inline">
            <h4 class="nb-section__title">{{t "Basics" key="new_board_section_basics"}}</h4>
            <p class="nb-section__hint">{{t "Give your board a name and brief description." key="new_board_section_basics_hint"}}</p>
            {{!-- Rows / columns live HERE, at the top-right of Basics, rather than in
                 the Size & Labels head below — the grid size is a basic property of
                 the board and is needed before the AI label generator runs.

                 Visible in ALL modes, including AI pre-generation: the generator
                 passes the current rows/columns to the backend (see
                 generate_labels_with_ai), so the user MUST be able to set the target
                 grid size BEFORE clicking Generate.

                 <GridSizePicker> is the fast path and the preview beside them — the
                 steppers stay the primary, always-visible control. --}}
            <div class="new-board-dimensions nb-section__header-dimensions" role="group" aria-label={{t "Grid size" key="grid_size"}}>
              <div class="nb-stepper-mini">
                <span class="nb-stepper-mini__label" id="nb-rows-label">{{t "Rows" key="rows"}}</span>
                <button type="button" class="nb-stepper-mini__btn" {{on "click" (this.ctrlAction "plus_minus" "minus" "model.grid.rows")}} aria-label={{t "Decrease rows" key="decrease_rows"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <input type="number" value={{this.model.grid.rows}} class="nb-stepper-mini__input" id="new_board_rows" aria-labelledby="nb-rows-label" {{on "input" (set-field this "model.grid.rows")}} />
                <button type="button" class="nb-stepper-mini__btn" {{on "click" (this.ctrlAction "plus_minus" "plus" "model.grid.rows")}} aria-label={{t "Increase rows" key="increase_rows"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 2.5 L6 9.5 M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="nb-stepper-mini">
                <span class="nb-stepper-mini__label" id="nb-cols-label">{{t "Cols" key="cols_short"}}</span>
                <button type="button" class="nb-stepper-mini__btn" {{on "click" (this.ctrlAction "plus_minus" "minus" "model.grid.columns")}} aria-label={{t "Decrease columns" key="decrease_columns"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <input type="number" value={{this.model.grid.columns}} class="nb-stepper-mini__input" id="new_board_columns" aria-labelledby="nb-cols-label" {{on "input" (set-field this "model.grid.columns")}} />
                <button type="button" class="nb-stepper-mini__btn" {{on "click" (this.ctrlAction "plus_minus" "plus" "model.grid.columns")}} aria-label={{t "Increase columns" key="increase_columns"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 2.5 L6 9.5 M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
              </div>
              <GridSizePicker
                @pickerId="new_board_grid_picker"
                @rows={{this.model.grid.rows}}
                @columns={{this.model.grid.columns}}
                @onChange={{this.ctrlAction "setGridSize"}} />
            </div>
          </div>
          <div class="nb-section__body">
            <div class="nb-basics-grid">
              <div class="nb-basics-grid__col nb-basics-grid__col--left">
                <div class="nb-field">
                  <label for="new_board_name" class="nb-field__label">{{t "Name" key="name"}}</label>
                  <input value={{this.model.name}} required={{true}} aria-required="true" aria-invalid={{if this.field_errors.name "true" "false"}} aria-describedby={{if this.field_errors.name "new-board-name-error"}} class="form-control nb-field__input {{if this.field_errors.name 'nb-field__input--error'}}" id="new_board_name" placeholder={{t "My Board" key="new_board_name_placeholder"}} {{on "blur" (this.ctrlAction "markFieldTouched" "name")}} {{on "input" (set-field this "model.name")}} />
                  {{#if this.field_errors.name}}
                    <p id="new-board-name-error" class="nb-field__hint nb-field__hint--error" role="alert">{{this.field_errors.name}}</p>
                  {{/if}}
                </div>
                <div class="nb-field new-board-field--description">
                  <label for="new_board_description" class="nb-field__label">{{t "Description" key="description"}}{{#if this.ai_mode}}<span class="nb-field__required-pill">{{t "required" key="required"}}</span>{{else}}<span class="nb-field__optional-pill">{{t "optional" key="optional"}}</span>{{/if}}</label>
                  <textarea class="form-control nb-field__input nb-field__input--fill" id="new_board_description" placeholder={{t "Brief description of the board" key="new_board_description_placeholder"}} rows="1" {{on "input" (set-field this "model.description")}}>{{this.model.description}}</textarea>
                </div>
              </div>
              {{!-- supporter_role gate added per Phase D #19 review:
                   hide the "for someone else?" prompt + supervisee
                   picker from communicator accounts (including
                   unspecified-role users, which fall into the
                   !supporter_role branch by codebase convention —
                   see create-board-new.js:88-94). Multi-role accounts
                   that are both communicator and supervisor still
                   had show_user_options=true under the old gate; this
                   compound (and …) closes that case. --}}
              {{#if (and this.show_user_options this.appState.sessionUser.supporter_role)}}
                <div class="nb-basics-grid__col nb-basics-grid__col--right">
                  <div class="nb-field nb-toggle-row">
                    <span class="nb-toggle-row__question" id="new_board_for_someone_else_label">{{t "Are you creating this board for someone else?" key="creating_for_someone_else"}}</span>
                    <div class="nb-toggle-row__control">
                      <span class="nb-toggle-row__state {{unless this.creating_for_someone_else 'nb-toggle-row__state--active'}}" aria-hidden="true">{{t "No" key="no"}}</span>
                      <button type="button"
                              role="switch"
                              aria-checked={{if this.creating_for_someone_else "true" "false"}}
                              aria-labelledby="new_board_for_someone_else_label"
                              class="nb-toggle__switch {{if this.creating_for_someone_else 'nb-toggle__switch--on'}}"
                              {{on "click" (this.ctrlAction "toggleCreatingForSomeoneElse")}}>
                        <span class="nb-toggle__thumb" aria-hidden="true"></span>
                      </button>
                      <span class="nb-toggle-row__state {{if this.creating_for_someone_else 'nb-toggle-row__state--active'}}" aria-hidden="true">{{t "Yes" key="yes"}}</span>
                    </div>
                  </div>
                  <div class="new-board-for-collapse {{if this.creating_for_someone_else 'new-board-for-collapse--open'}} {{if this.for_user_needs_attention 'new-board-for-collapse--needs-attention'}}" aria-hidden={{unless this.creating_for_someone_else "true" "false"}}>
                    <ModernSelect @class="new-board-select--modern new-board-for-select" @selectId="new_board_for_user" @content={{this.user_options}} @selection={{this.for_user_id}} @action={{this.ctrlAction "setForUserId"}} @ariaLabel={{t "Who is this board for?" key="for_user_aria"}} @placeholder={{t "Select who this board is for" key="select_who_for"}} />
                  </div>
                </div>
              {{/if}}
            </div>
            {{!-- AI mode, PRE-generation only (`unless show_full_size_section`
                 == ai_mode && !ai_labels_generated). Sits at the foot of Basics
                 because everything it needs is here: the description it sends as
                 the prompt, and the Rows/Cols that set the target grid. It used to
                 live at the top of the labels section below, which asked the user
                 to jump back up to Basics, fill it in, then come back down.
                 The over-limit and error banners travel WITH the button — both are
                 about this action, and ai_generate_disabled is what they explain. --}}
            {{#unless this.show_full_size_section}}
            <div class="nb-ai-generate">
              {{!-- Over-limit warning: shows when the user dials the
                   rows/cols steppers past the recommended 112-button
                   ceiling. Also blocks the Generate button (via
                   ai_generate_disabled) until the user dials back
                   below 112. Larger boards become hard to scan, AI
                   label quality drops, and the per-button symbol
                   lookup rate-limits aggressively. --}}
              {{#if this.ai_button_count_over_limit}}
                <div class="nb-alert nb-alert--warning" role="alert">
                  <span class="nb-alert__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                      <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                      <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                    </svg>
                  </span>
                  <div class="nb-alert__body">
                    <p class="nb-alert__text">{{t "Your board size (%{n} buttons) is larger than the recommended 112. Reduce rows or columns to enable AI generation." n=this.ai_button_count key="ai_board_size_over_limit"}}</p>
                  </div>
                </div>
              {{/if}}
              {{#if this.ai_generate_error}}
                <div class="nb-alert nb-alert--warning" role="alert">
                  <span class="nb-alert__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                      <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                      <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                    </svg>
                  </span>
                  <div class="nb-alert__body">
                    <p class="nb-alert__text">{{this.ai_generate_error}}</p>
                  </div>
                </div>
              {{/if}}
              {{!-- CORE WORDS — AI MODE ONLY. This whole `nb-ai-generate` block sits
                   inside `{{#unless this.show_full_size_section}}`, and
                   show_full_size_section is `!ai_mode || ai_labels_generated`, so
                   regular Create Board never renders it and neither does AI mode once
                   labels exist. Sits directly above the Generate button because it
                   changes what that button asks the model for.
                   Uses the same `nb-toggle-row` switch as the "creating this board for
                   someone else?" control above, so this page keeps ONE toggle idiom
                   rather than importing the modal's `checkbox big_checkbox`. --}}
              <div class="nb-field nb-toggle-row nb-ai-generate__core-words">
                <span class="nb-toggle-row__question" id="new_board_core_words_label">{{t "Core Words" key="core_words"}}</span>
                <div class="nb-toggle-row__control">
                  <span class="nb-toggle-row__state {{unless this.include_core_words 'nb-toggle-row__state--active'}}" aria-hidden="true">{{t "No" key="no"}}</span>
                  <button type="button"
                          role="switch"
                          aria-checked={{if this.include_core_words "true" "false"}}
                          aria-labelledby="new_board_core_words_label"
                          aria-describedby="new_board_core_words_hint"
                          class="nb-toggle__switch {{if this.include_core_words 'nb-toggle__switch--on'}}"
                          {{on "click" (this.ctrlAction "toggleIncludeCoreWords")}}>
                    <span class="nb-toggle__thumb" aria-hidden="true"></span>
                  </button>
                  <span class="nb-toggle-row__state {{if this.include_core_words 'nb-toggle-row__state--active'}}" aria-hidden="true">{{t "Yes" key="yes"}}</span>
                </div>
              </div>
              {{!-- The tooltip copy, SHOWN rather than hidden in a `title=`: the modal
                   version is title-only, which no touch user can reach, and this
                   sentence is the only thing that says what the switch actually
                   changes about the generated vocabulary. --}}
              <p class="nb-field__hint nb-ai-generate__core-words-hint" id="new_board_core_words_hint">{{this.core_words_tooltip}}</p>
              <button type="button"
                      class="btn btn-primary nb-ai-generate__btn"
                      disabled={{this.ai_generate_disabled}}
                      aria-disabled={{if this.ai_generate_disabled "true" "false"}}
                      {{on "click" (this.ctrlAction "generate_labels_with_ai")}}>
                {{#if this.ai_generating}}
                  {{t "Generating Labels…" key="ai_generating_labels"}}
                {{else}}
                  {{t "Generate Labels with AI" key="ai_generate_labels_btn"}}
                {{/if}}
              </button>
            </div>
            {{/unless}}
          </div>
        </section>

        {{!-- The whole Board Labels section is AI-post-generation / regular mode only.
             Its body is a single `show_full_size_section` conditional, so in AI
             PRE-generation it would otherwise render as an empty titled shell — the
             Generate button that used to fill it now lives at the foot of Basics. --}}
        {{#if this.show_full_size_section}}
        <section class="nb-section">
          <div class="nb-section__head">
            {{!-- "Board Labels", not "Size & Labels": the Rows/Cols steppers moved to
                 the top-right of the Basics header above (with the grid-size picker
                 beside them), so this section is only about labels now.

                 A NEW KEY, not re-worded `new_board_section_size` — that key is still
                 used by components/new-board.hbs, where the steppers DO still sit in
                 this head and "Size & Labels" is still accurate. Re-wording it in
                 place would have changed the other form's heading too, and left every
                 non-English locale showing the old translation under a new meaning. --}}
            <h4 class="nb-section__title">{{t "Board Labels" key="new_board_section_board_labels"}}</h4>
          </div>
          <div class="nb-section__body">
            {{#if this.show_full_size_section}}
            <div class="nb-words-grid">
              <div class="nb-basics-grid__col nb-words-grid__col--labels">
                <div class="nb-field new-board-field--labels">
                  <div class="nb-field__label-row nb-field__label-row--page-center">
                    <label for="new_board_labels" class="nb-field__label">{{t "Labels" key="labels"}}</label>
                    <div class="nb-field__meta nb-field__meta--center">
                      <span class={{this.labels_class}}>
                        {{this.label_count}} {{t "labels" key="label_count"}}
                      </span>
                      <span class="nb-field__sep" aria-hidden="true">·</span>
                      <button type="button" class="nb-link" data-count={{this.label_count}} {{on "click" (this.ctrlAction "pick_core")}}>{{t "pick from core lists" key="pick_from_core_lists"}}</button>
                      {{#if this.speech}}
                        <span class="nb-field__sep nb-field__sep--before-speech" aria-hidden="true">·</span>
                        <button type="button" class="nb-link nb-link--speech" data-count={{this.label_count}} {{on "click" (this.ctrlAction "record_words")}}>{{t "speech recognition" key="record_words"}}</button>
                      {{/if}}
                      {{#if this.label_count}}
                        <span class="nb-field__sep" aria-hidden="true">·</span>
                        <button type="button"
                                class="nb-link nb-link--danger"
                                {{on "click" (this.ctrlAction "clearGrid")}}
                                aria-label={{t "Clear all labels" key="clear_all_labels"}}>
                          <svg class="nb-link__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                            <path d="M3 4 L3 12 Q3 13 4 13 L10 13 Q11 13 11 12 L11 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2 4 L12 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            <path d="M5.5 4 L5.5 2.5 Q5.5 2 6 2 L8 2 Q8.5 2 8.5 2.5 L8.5 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M5.5 6.5 L5.5 10.5 M8.5 6.5 L8.5 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                          </svg>
                          <span>{{t "clear grid" key="clear_grid"}}</span>
                        </button>
                      {{/if}}
                      <button type="button" class="nb-link" style="display: none;" {{on "click" (this.ctrlAction "import_from_pdf")}}>{{t "import from pdf" key="import_from_pdf"}}</button>
                    </div>
                    <div class="nb-field__label-row__actions">
                      <button type="button"
                              class="nb-link nb-field__import-btn"
                              data-tooltip={{t "Upload a CSV file (max 1MB) — one label per cell or row" key="import_csv_tooltip"}}
                              aria-label={{t "Upload labels from CSV" key="import_csv_aria"}}
                              {{on "click" (this.ctrlAction "importCsv")}}>
                        <svg class="nb-link__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                          <path d="M7 1.5 L7 9.5 M3.5 5 L7 1.5 L10.5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M2 11 L2 12 Q2 12.5 2.5 12.5 L11.5 12.5 Q12 12.5 12 12 L12 11" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>{{t "import csv" key="import_csv"}}</span>
                      </button>
                      <input type="file"
                             id="new_board_csv_input"
                             class="nb-field__file-input"
                             accept=".csv,text/csv"
                             {{on "change" (this.ctrlAction "csvFileChosen")}}
                             tabindex="-1"
                             aria-label={{t "import csv" key="import_csv"}} />
                    </div>
                  </div>
                  {{#if this.has_duplicate_labels}}
                    <span class="nb-pill nb-pill--warn" role="status">
                      <svg class="nb-pill__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                        <circle cx="7" cy="7" r="5.6" fill="none" stroke="currentColor" stroke-width="1.4"/>
                        <path d="M7 4 L7 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                        <circle cx="7" cy="9.7" r="0.7" fill="currentColor"/>
                      </svg>
                      <span class="nb-pill__text">{{t "Duplicate labels detected" key="duplicate_labels_pill"}}</span>
                    </span>
                  {{/if}}
                  {{#if this.speech_error_message}}
                    <div class="nb-alert nb-alert--warning nb-speech__error" role="alert">
                      <span class="nb-alert__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                          <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                          <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                          <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                        </svg>
                      </span>
                      <div class="nb-alert__body">
                        <p class="nb-alert__text">{{this.speech_error_message}}</p>
                      </div>
                      <button type="button" class="nb-speech__error-dismiss" {{on "click" (this.ctrlAction "dismiss_speech_error")}} aria-label={{t "Dismiss" key="dismiss"}}>
                        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                          <path d="M2 2 L10 10 M10 2 L2 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>
                  {{/if}}
                  {{#if this.too_many_total_labels}}
                    <div class="nb-alert nb-alert--warning" role="alert">
                      <span class="nb-alert__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                          <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                          <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                          <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                        </svg>
                      </span>
                      <div class="nb-alert__body">
                        <p class="nb-alert__title">{{t "Too many labels" key="too_many_labels_title"}}</p>
                        <p class="nb-alert__text">{{t "You've entered %{count} labels — %{unused} of them won't be used because the grid maximum is %{max} buttons (20 × 20). Remove the extras or split them into a second board." key="too_many_labels_message" count=this.label_count unused=this.unused_label_count max=this.max_grid_labels}}</p>
                      </div>
                    </div>
                  {{/if}}
                  {{#if this.no_fitzgerald_count}}
                    {{!-- Buttons whose label matched no Fitzgerald part
                         of speech get no key color. They're highlighted
                         in the preview; this banner explains why and what
                         to do about it. --}}
                    <div class="nb-alert nb-alert--warning nb-alert--fitzgerald" role="status">
                      <span class="nb-alert__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                          <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                          <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                          <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                        </svg>
                      </span>
                      <div class="nb-alert__body">
                        <p class="nb-alert__title">{{t "Some buttons have no color category" key="no_fitzgerald_title"}}</p>
                        <p class="nb-alert__text">{{t "These buttons didn't match a Fitzgerald part of speech, so they have no key color and will appear plain on the board: %{words}. You can color them by hand in the preview, or adjust the labels." key="no_fitzgerald_message" words=this.no_fitzgerald_labels_display}}</p>
                      </div>
                    </div>
                  {{/if}}
                  <LabelChips @value={{this.model.grid.labels}} @onChange={{this.ctrlAction "setLabels"}} @inputId="new_board_labels" @showChips={{false}} @colors={{this.chip_label_colors}} @placeholder={{t "Type a word or group of words and press Enter · paste a list · import a csv file" key="labels_chip_placeholder_import"}} />
                  {{#if this.label_count}}
                    <div class="nb-labels-disclosure">
                      <button type="button" class="nb-link nb-labels-disclosure__toggle" aria-expanded={{if this.labels_list_open "true" "false"}} {{on "click" (this.ctrlAction "toggleLabelsList")}}>
                        <svg class="nb-link__icon nb-labels-disclosure__chevron {{if this.labels_list_open 'nb-labels-disclosure__chevron--open'}}" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                        {{#if this.labels_list_open}}
                          <span>{{t "hide labels list" key="hide_labels_list"}}</span>
                        {{else}}
                          <span>{{t "view all labels" key="view_all_labels"}} ({{this.label_count}})</span>
                        {{/if}}
                      </button>
                      {{#if this.labels_list_open}}
                        <div class="nb-labels-disclosure__list">
                          <LabelChips @value={{this.model.grid.labels}} @onChange={{this.ctrlAction "setLabels"}} @showInput={{false}} @colors={{this.chip_label_colors}} />
                        </div>
                      {{/if}}
                    </div>
                  {{/if}}
                </div>
              </div>
            </div>
            {{#if this.core_lists}}
              <div class="nb-field">
                <ul class="nav nav-pills">
                  {{#each this.core_words as |core_word|}}
                    <li class={{if core_word.active "active"}}>
                      <button type="button" class="md-link-btn-pill" {{on "click" (this.ctrlAction "enable_word" core_word.id)}} aria-pressed={{if core_word.active "true" "false"}}>{{ core_word.label }}</button>
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{else}}
              {{#if this.speech.ready}}
                <div class="nb-field nb-speech">
                  <div class="nb-speech__head">
                    <div class="nb-speech__indicator {{if this.speech.recording 'nb-speech__indicator--active'}}" aria-hidden="true">
                      <svg class="nb-speech__mic" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <rect x="7.5" y="2.5" width="5" height="9" rx="2.5"/>
                        <path d="M4.5 9 Q4.5 14 10 14 Q15.5 14 15.5 9"/>
                        <path d="M10 14 L10 17 M7 17 L13 17"/>
                      </svg>
                    </div>
                    <div class="nb-speech__status" role="status" aria-live="polite">
                      {{#if this.speech.recording}}
                        {{t "Listening..." key="listening"}}
                      {{else}}
                        {{t "Starting microphone..." key="speech_starting_mic"}}
                      {{/if}}
                    </div>
                    <div class="nb-speech__meter" aria-hidden="true">
                      <div class="nb-speech__meter-fill" style={{safe-style this.speech_level_style}}></div>
                    </div>
                  </div>

                  <div class="nb-speech__controls">
                    <button type="button" class="btn btn-default nb-speech__btn" title={{t "Click between dictated words to add each as its own label. Otherwise everything you say merges into one label." key="next_word_help"}} {{on "click" (this.ctrlAction "next_word")}}>{{t "Next Word" key="next_word"}}</button>
                    <button type="button" class="btn btn-default nb-speech__btn nb-speech__btn--stop" {{on "click" (this.ctrlAction "stop_recording")}}>{{t "Stop" key="stop_speech"}}</button>
                  </div>

                  <p class="nb-speech__hint">{{t "Click \"Next Word\" between labels to keep them separate." key="speech_hint"}}</p>

                  <SpeechListener @content={{this.ctrlAction "speech_content"}} @error={{this.ctrlAction "speech_error"}} @stop={{this.ctrlAction "speech_stop"}} @speech={{this.speech}} />

                  <ul class="nav nav-pills nb-speech__words">
                    {{#each this.speech.words as |word|}}
                      <li class="active" style="margin-right: 3px; margin-bottom: 3px;">
                        <button type="button" class="md-link-btn-pill" {{on "click" (this.ctrlAction "remove_word" word.id)}} aria-label={{t "Remove %{word}" key="remove_word_named" word=word.label}}>
                          {{word.label}}
                          <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                        </button>
                      </li>
                    {{/each}}
                  </ul>
                </div>
              {{else}}
                {{#if this.speech.almost_recording}}
                  <div class="nb-field">
                    <p>{{t "Waiting for Approval..." key="waiting_for_approval"}}</p>
                  </div>
                {{/if}}
              {{/if}}
            {{/if}}
            {{!-- The old "Show/Hide Preferences" collapsible was
                 removed: every control it held (Paint, Shape, Gap,
                 Border, Skin-Tones, Background, Symbols) has been
                 migrated into the Edit Tools rail's
                 create_rail_sections blocks below. --}}
            {{!-- Preview stage: the board mockup sits flush against an
                 (empty for now) right rail styled exactly like the
                 board-detail edit panel. Functionality comes later. --}}
            <div class="nb-preview-stage {{if (is_equal this.preview_mode "dark") "md-board-detail--dark"}} {{if this.create_rail_open_section "nb-preview-stage--expanded"}}">
            <div class="new-board-mockup-wrap {{if (is_equal this.preview_mode "dark") "md-board-detail--dark new-board-mockup-wrap--dark"}}"
                 role="region"
                 aria-label={{t "Board preview" key="board_preview"}}>
              {{!-- Sentence bar + home mockup, inside the board, above
                   the top row (visual only for now). --}}
              <div class="md-board-detail-sentence-row nb-preview-sentence-row {{this.nb_preview_vocalization_class}} {{if (is-equal this.utterance_text_only_str "true") "nb-preview-sentence-bar--words-only"}}">
                <button type="button" class="md-board-detail-home-btn" title={{t "Home" key="board_detail_home"}} aria-label={{t "Home" key="board_detail_home"}}>
                  <svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 12 12 3l9 9"/>
                    <path d="M5 10v10a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1V10"/>
                  </svg>
                </button>
                <div class="md-board-detail-sentence-bar" role="region" aria-label={{t "Message composition" key="board_detail_message_composition"}}>
                  <div class="md-board-detail-sentence-bar__text {{if (and this._speak_words.length (is-equal this.utterance_text_only_str "false")) "md-board-detail-sentence-bar__text--with-symbols"}}">
                    {{#if this._speak_words.length}}
                      {{#if (is-equal this.utterance_text_only_str "false")}}
                        {{!-- Symbol mode (default): show each tapped button as an
                             image-over-text chip, mirroring board-detail speak
                             mode's sentence box. Falls back to text-only when a
                             button has no symbol. --}}
                        {{#each this._speak_words as |word|}}
                          <span class="md-board-detail-sentence-bar__chip {{if this.utterance_text_on_top "md-board-detail-sentence-bar__chip--text-top"}}">
                            {{#if this.utterance_text_on_top}}
                              <span class="md-board-detail-sentence-bar__chip-label">{{word.label}}</span>
                            {{/if}}
                            {{#if word.image_url}}
                              <img src={{word.image_url}} alt="" class="md-board-detail-sentence-bar__chip-img" decoding="async" loading="eager">
                            {{/if}}
                            {{#unless this.utterance_text_on_top}}
                              <span class="md-board-detail-sentence-bar__chip-label">{{word.label}}</span>
                            {{/unless}}
                          </span>
                        {{/each}}
                      {{else}}
                        {{#each this._speak_words as |word|}}<span class="nb-preview-sentence-bar__word">{{word.label}}</span>{{/each}}
                      {{/if}}
                    {{else}}
                      <span class="nb-preview-sentence-bar__placeholder">{{t "Tapped words will appear here" key="preview_sentence_placeholder"}}</span>
                    {{/if}}
                  </div>
                  <div class="md-board-detail-sentence-bar__actions">
                    <button type="button" class="md-board-detail-sentence-bar__btn md-board-detail-sentence-bar__btn--speak" aria-label={{t "Speak sentence" key="board_detail_speak_sentence"}} {{on "click" (this.ctrlAction "speak_sentence")}}>
                      {{!-- Microphone icon (matches board-detail speak mode's
                           primary speak control), not a volume/speaker glyph. --}}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                        <line x1="12" y1="19" x2="12" y2="23"/>
                        <line x1="8" y1="23" x2="16" y2="23"/>
                      </svg>
                    </button>
                    <button type="button" class="md-board-detail-sentence-bar__tool-btn" title={{t "Backspace" key="backspace"}} aria-label={{t "Backspace" key="backspace"}} {{on "click" (this.ctrlAction "speak_backspace")}}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/><line x1="18" y1="9" x2="12" y2="15"/><line x1="12" y1="9" x2="18" y2="15"/></svg>
                    </button>
                    <button type="button" class="md-board-detail-sentence-bar__tool-btn" title={{t "Clear" key="board_detail_clear"}} aria-label={{t "Clear" key="board_detail_clear"}} {{on "click" (this.ctrlAction "speak_clear")}}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </button>
                  </div>
                </div>
              </div>
              <div class="md-board-detail-grid md-board-detail-grid--preview {{this.button_text_position_class}} {{this.button_text_size_class}} {{this.button_shape_class}} {{this.preview_background_class}} {{if this.paint_mode 'md-board-detail-grid--paint-mode'}}"
                   style={{this.preview_style}}
                   role="grid"
                   {{on "dragover" (this.eventAction "previewDragOver")}}
                   {{on "drop" (this.eventAction "previewDrop")}}>
                {{#each this.preview_grid as |row rowIdx|}}
                  {{!-- grid → row → gridcell: the role="row" wrapper completes the
                       ARIA grid structure require-context-role requires. It carries
                       `display: contents` (.md-board-detail-grid__row) so the cells
                       keep auto-placing into the same CSS grid — layout unchanged. --}}
                  <div class="md-board-detail-grid__row" role="row">
                  {{#each row as |cell colIdx|}}
                    <div class="md-board-detail-grid__cell {{if cell.empty "md-board-detail-grid__cell--empty"}} {{if cell.editing "md-board-detail-grid__cell--editing"}} {{if cell.painted "md-board-detail-grid__cell--painted"}} {{if cell.is_duplicate "md-board-detail-grid__cell--duplicate"}} {{if cell.no_category "md-board-detail-grid__cell--no-category"}}"
                         role="gridcell"
                         draggable={{if cell.draggable "true" "false"}}
                         {{on "click" (this.ctrlAction "cellClicked" cell.idx cell.image_url)}}
                         {{on "dblclick" (this.eventAction "startCellEdit" cell.idx)}}
                         {{on "dragstart" (this.eventAction "cellDragStart" rowIdx colIdx)}}
                         {{on "dragover" (this.eventAction "cellDragOver" rowIdx colIdx)}}
                         {{on "dragleave" (this.eventAction "cellDragLeave")}}
                         {{on "drop" (this.eventAction "cellDrop" rowIdx colIdx)}}
                         {{on "dragend" (this.eventAction "cellDragEnd")}}>
                      <div class="button md-board-detail-symbol-card md-board-detail-symbol-card--default {{unless cell.has_color "md-board-detail-symbol-card--no-color"}} {{if cell.empty "md-board-detail-symbol-card--empty"}} {{if cell.is_duplicate "md-board-detail-symbol-card--duplicate"}} {{if cell.no_category "md-board-detail-symbol-card--no-category"}}"
                           style={{cell.bg_style}}>
                        {{#unless cell.empty}}
                          {{#if cell.is_duplicate}}
                            {{!-- Duplicate-label warning icon. Pinned to the
                                 bottom-left of the symbol card with a small
                                 amber triangle. Pure presentational — the
                                 inline edit / drag / paint affordances on
                                 the rest of the card still work. --}}
                            <span class="md-board-detail-symbol-card__warning"
                                  aria-label={{t "Duplicate label" key="duplicate_label_warning"}}
                                  title={{t "Duplicate label" key="duplicate_label_warning"}}>
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9.5"/>
                                <line x1="12" y1="7.5" x2="12" y2="13"/>
                                <circle cx="12" cy="16.5" r="0.7" fill="currentColor" stroke="none"/>
                              </svg>
                            </span>
                          {{/if}}
                          {{#unless cell.editing}}
                            {{!-- Remove-label X. Pinned to the top-right corner
                                 of the card; mirrors the chip's `__chip-remove`
                                 button so deleting from either surface routes
                                 through the same `parsed_labels`. Hidden during
                                 inline edit so it doesn't crowd the input. --}}
                            <button type="button"
                                    class="md-board-detail-symbol-card__remove"
                                    aria-label={{t "Remove %{word}" key="remove_label_chip" word=cell.label}}
                                    draggable="false"
                                    {{on "click" (this.ctrlActionNoBubble "removeCellAt" cell.idx)}}>
                              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
                                <path d="M1 1 L9 9 M9 1 L1 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                              </svg>
                            </button>
                          {{/unless}}
                          {{#if cell.image_url}}
                            {{!-- Symbol image fetched async via _lookup_label_images
                                 from /api/v1/search/symbols. Same image gets baked
                                 into model.buttons[] at save time so the live board
                                 uses the symbol the user previewed. --}}
                            <div class="md-board-detail-symbol-card__image md-board-detail-symbol-card__image--symbol">
                              <img class="symbol" src={{cell.image_url}} alt="" draggable="false" style="max-width: 70%; max-height: 70%; object-fit: contain;">
                            </div>
                          {{else}}
                            <div class="md-board-detail-symbol-card__image md-board-detail-symbol-card__image--placeholder">
                              <img class="symbol" src="/images/square.svg" alt="" draggable="false" style="max-width: 70%; max-height: 70%;">
                            </div>
                          {{/if}}
                          {{#if cell.editing}}
                            {{!-- Inline edit. The input is focused + selected by `startCellEdit`
                                 via the `new-board-cell-edit-{{idx}}` id. Enter commits, Escape
                                 cancels, blur commits (matches label-chips' edit semantics).
                                 oninput keeps `_editValue` in sync as the user types. --}}
                            <input type="text"
                                   id={{concat "new-board-cell-edit-" cell.idx}}
                                   class="md-board-detail-symbol-card__label-input"
                                   value={{this._editValue}}
                                   aria-label={{t "Edit button label" key="edit_button_label"}}
                                   draggable="false"
                                   {{on "input" (this.ctrlActionEventValue "cellEditChanged" "value")}}
                                   {{on "keydown" (this.eventAction "cellEditKeydown")}}
                                   {{on "blur" (this.ctrlAction "commitCellEdit")}} />
                          {{else}}
                            {{!-- The label button has NO own action: a click on it
                                 (mouse OR keyboard) bubbles to the cell wrapper's
                                 onclick → cellClicked, which speaks (or paints).
                                 Wiring an action here too would double-fire, since
                                 the wrapper's direct onclick already catches the
                                 bubbled click. Kept as a focusable <button> with a
                                 "Speak <word>" label for keyboard + screen-reader
                                 access. --}}
                            <button type="button"
                                    class="md-board-detail-symbol-card__label-btn"
                                    aria-label={{t "Speak %{word}" key="speak_label_named" word=cell.label}}>
                              <span class="md-board-detail-symbol-card__label">{{cell.label}}</span>
                            </button>
                          {{/if}}
                        {{/unless}}
                      </div>
                    </div>
                  {{/each}}
                  </div>
                {{/each}}
              </div>
            </div>
            {{!-- Empty edit rail (shell only) — same chrome/styles as
                 the board-detail edit panel. No functionality wired
                 yet; labels present so the layout can be reviewed. --}}
            <aside class="md-board-edit-right-panel nb-create-rail {{if (is_equal this.preview_mode "dark") "md-board-detail--dark"}}" aria-label={{t "Board edit tools" key="board_edit_panel_label"}}>
              <div class="md-board-edit-right-panel__header">
                <h3 class="md-board-edit-right-panel__title">{{t "Edit Tools" key="board_edit_tools_title"}}</h3>
                {{!-- Light/Dark toggle relocated here from the grid; it
                     themes the whole stage (grid + this panel). --}}
                <button type="button"
                        class="new-board-mockup-toggle nb-create-rail__theme-toggle {{if (is_equal this.preview_mode "dark") "new-board-mockup-toggle--dark"}}"
                        role="switch"
                        aria-checked={{if (is_equal this.preview_mode "dark") "true" "false"}}
                        aria-label={{t "Toggle preview light or dark mode" key="toggle_preview_mode"}}
                        title={{t "Toggle preview light or dark mode" key="toggle_preview_mode"}}
                        {{on "click" (this.ctrlAction "togglePreviewMode")}}>
                  <span class="new-board-mockup-toggle__icon new-board-mockup-toggle__icon--sun" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                  </span>
                  <span class="new-board-mockup-toggle__thumb" aria-hidden="true"></span>
                  <span class="new-board-mockup-toggle__icon new-board-mockup-toggle__icon--moon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                  </span>
                </button>
              </div>
              <div class="md-board-edit-right-panel__body">
                <div class="md-board-edit-right-panel__group {{if this.create_rail_open_section 'md-board-edit-right-panel__group--section-open'}}">
                  {{!-- Narrow rails (<=1024px) collapse to a single open section;
                       this Back button (hidden at wider widths via CSS) returns
                       to the full list. --}}
                  {{#if this.create_rail_open_section}}
                    <button type="button" class="nb-rail-back" {{on "click" (this.ctrlAction "close_create_rail_section")}}>
                      <svg class="nb-rail-back__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="15 18 9 12 15 6"/>
                      </svg>
                      <span>{{t "Back" key="back"}}</span>
                    </button>
                  {{/if}}
                  <div class="md-board-edit-right-panel__subheader">{{t "Appearance" key="board_edit_appearance_group"}}</div>
                  {{#each this.create_rail_sections as |sec|}}
                    <div class="md-board-edit-right-panel__section {{if (is-equal this.create_rail_open_section sec.id) 'md-board-edit-right-panel__section--open'}} {{if (and (is-equal sec.id "paint") this.paint_mode) 'md-board-edit-right-panel__section--paint-armed'}}" data-section-id={{sec.id}}>
                      <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.create_rail_open_section sec.id) "true" "false"}} {{on "click" (this.ctrlAction "toggle_create_rail_section" sec.id)}}>
                        {{!-- Per-category icons taken verbatim from the
                             board-detail edit right panel so the two
                             panels stay visually consistent. --}}
                        <span class="md-board-edit-right-panel__section-icon" data-section={{sec.id}} aria-hidden="true">
                          {{#if (is-equal sec.id "text")}}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="4 7 4 4 20 4 20 7" stroke="#2A9D8F"/>
                              <line x1="9" y1="20" x2="15" y2="20" stroke="#46505F"/>
                              <line x1="12" y1="4" x2="12" y2="20" stroke="#46505F"/>
                            </svg>
                          {{else if (is-equal sec.id "shape")}}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <rect x="3" y="3" width="18" height="18" rx="6" stroke="#2A9D8F"/>
                              <rect x="7" y="7" width="10" height="10" rx="2" stroke-dasharray="3 3" stroke="#46505F"/>
                            </svg>
                          {{else if (is-equal sec.id "background")}}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <rect x="3" y="3" width="18" height="18" rx="2" stroke="#46505F"/>
                              <path d="M3 21 L21 3" stroke="#46505F"/>
                              <path d="M21 3 L21 21 L3 21 Z" fill="#2A9D8F" fill-opacity="0.18" stroke="none"/>
                              <circle cx="16" cy="9" r="2.5" fill="#2A9D8F" stroke="none"/>
                            </svg>
                          {{else if (is-equal sec.id "skin")}}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="9" stroke="#46505F"/>
                              <circle cx="9" cy="10" r="1" stroke="#2A9D8F"/>
                              <circle cx="15" cy="10" r="1" stroke="#2A9D8F"/>
                              <path d="M9 15c1 1 2 1.5 3 1.5s2-.5 3-1.5" stroke="#2A9D8F"/>
                            </svg>
                          {{else if (is-equal sec.id "layout")}}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <rect x="3" y="3" width="18" height="18" rx="1" stroke="#46505F"/>
                              <line x1="3" y1="10" x2="21" y2="10" stroke="#2A9D8F"/>
                              <line x1="10" y1="10" x2="10" y2="21" stroke="#2A9D8F"/>
                            </svg>
                          {{else if (is-equal sec.id "symbols")}}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="6.5" cy="6.5" r="3" stroke="#2A9D8F"/>
                              <rect x="13.5" y="3.5" width="6" height="6" rx="0.8" stroke="#46505F"/>
                              <path d="M6.5 14 L10 20.5 L3 20.5 Z" stroke="#2A9D8F"/>
                              <path d="M16.5 13.5 L20 17 L16.5 20.5 L13 17 Z" stroke="#46505F"/>
                            </svg>
                          {{else if (is-equal sec.id "speakbar")}}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <rect x="2" y="6" width="20" height="12" rx="2" stroke="#46505F"/>
                              <circle cx="6" cy="12" r="1.2" fill="#2A9D8F" stroke="none"/>
                              <circle cx="10" cy="12" r="1.2" fill="#2A9D8F" stroke="none"/>
                              <circle cx="14" cy="12" r="1.2" fill="#2A9D8F" stroke="none"/>
                              <circle cx="18" cy="12" r="1.2" fill="#2A9D8F" stroke="none"/>
                            </svg>
                          {{else if (is-equal sec.id "paint")}}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M14 6 L18 10 L9 19 L4 20 L5 15 Z" stroke="#46505F" stroke-linejoin="round"/>
                              <path d="M14 6 L17 3 L21 7 L18 10" stroke="#2A9D8F"/>
                            </svg>
                          {{else}}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="8" stroke="#46505F"/>
                              <circle cx="12" cy="12" r="3" stroke="#2A9D8F"/>
                            </svg>
                          {{/if}}
                        </span>
                        <span class="md-board-edit-right-panel__section-label">{{#if sec.short_label}}<span class="nb-rail-label__full">{{sec.label}}</span><span class="nb-rail-label__short">{{sec.short_label}}</span>{{else}}{{sec.label}}{{/if}}</span>
                        <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polyline points="6 9 12 15 18 9"/>
                        </svg>
                      </button>
                      {{#if (is-equal this.create_rail_open_section sec.id)}}
                        <div class="md-board-edit-right-panel__section-body">
                          {{#if (is-equal sec.id "text")}}
                            {{!-- Text Settings — moved (not copied) from
                                 the old Preferences toolbar. Same actions
                                 and computed bindings the component
                                 already exposes; this is now the
                                 canonical editor for these prefs. --}}
                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Text Size" key="text_size"}}</span>
                              <div class="md-board-detail-edit-toolbar__stepper md-settings-stepper md-settings-stepper--compact">
                                <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_text_size_at_min}} data-tooltip={{t "Smaller" key="board_detail_settings_smaller"}} aria-label={{t "Smaller" key="board_detail_settings_smaller"}} {{on "click" (this.ctrlAction "step_display_pref" "button_text" -1)}}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                                </button>
                                <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_text_size_at_max}} data-tooltip={{t "Larger" key="board_detail_settings_larger"}} aria-label={{t "Larger" key="board_detail_settings_larger"}} {{on "click" (this.ctrlAction "step_display_pref" "button_text" 1)}}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                                </button>
                              </div>
                            </div>

                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Font Type" key="font_type"}}</span>
                              <div class="md-settings-dropdown-wrap">
                                <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_font_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_font_dropdown_open "true" "false"}} data-tooltip={{t "Font style" key="board_detail_prefs_font_style"}} aria-label={{t "Font style" key="board_detail_prefs_font_style"}} {{on "click" (this.ctrlAction "toggle_display_font_dropdown")}}>
                                  <span class="md-settings-select__value">{{this.display_prefs_current_font_label}}</span>
                                </button>
                                {{#if this.display_prefs_font_dropdown_open}}
                                  <div class="md-settings-dropdown-backdrop" {{on "click" (this.ctrlAction "close_display_font_dropdown")}} aria-hidden="true"></div>
                                  <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Font style" key="board_detail_prefs_font_style"}}>
                                    <li class="md-settings-dropdown-search-row" role="presentation">
                                      <input type="text"
                                             id="nb-font-dropdown-search"
                                             class="md-settings-dropdown-search__input"
                                             placeholder={{t "Search fonts..." key="search_fonts_placeholder"}}
                                             value={{this.display_prefs_font_filter}}
                                             {{on "input" (this.ctrlActionEventValue "filter_display_fonts" "value")}}
                                             {{on "keydown" (this.eventAction "font_dropdown_keydown")}}
                                             autocomplete="off"
                                             aria-label={{t "Search fonts" key="search_fonts_label"}} />
                                    </li>
                                    {{#each this.filtered_button_style_options as |opt|}}
                                      {{#if opt.divider}}
                                        <li class="md-settings-dropdown-divider" role="separator" aria-hidden="true"></li>
                                      {{else}}
                                        <li role="presentation">
                                          <button type="button" role="option" aria-selected={{if (is-equal this.appState.sessionUser.preferences.device.button_style opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.appState.sessionUser.preferences.device.button_style opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_display_font" opt.id)}}>
                                            {{#if (is-equal this.appState.sessionUser.preferences.device.button_style opt.id)}}
                                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                            {{else}}
                                              <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                            {{/if}}
                                            <span>{{opt.label}}</span>
                                          </button>
                                        </li>
                                      {{/if}}
                                    {{/each}}
                                  </ul>
                                {{/if}}
                              </div>
                            </div>

                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Text Position" key="text_position"}}</span>
                              <div class="md-settings-icongroup" role="radiogroup" aria-label={{t "Text position" key="board_detail_prefs_text_position"}}>
                                <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.device.button_text_position "top") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.device.button_text_position 'top') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Text on top" key="board_detail_settings_text_top"}} aria-label={{t "Text on top" key="board_detail_settings_text_top"}} {{on "click" (this.ctrlAction "set_display_pref" "button_text_position" "top")}}>
                                  <span class="md-settings-btnmock"><span class="md-settings-btnmock__text md-settings-btnmock__text--top">Aa</span><span class="md-settings-btnmock__img"></span></span>
                                </button>
                                <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.device.button_text_position "bottom") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.device.button_text_position 'bottom') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Text on bottom" key="board_detail_settings_text_bottom"}} aria-label={{t "Text on bottom" key="board_detail_settings_text_bottom"}} {{on "click" (this.ctrlAction "set_display_pref" "button_text_position" "bottom")}}>
                                  <span class="md-settings-btnmock"><span class="md-settings-btnmock__img"></span><span class="md-settings-btnmock__text md-settings-btnmock__text--bottom">Aa</span></span>
                                </button>
                                <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.device.button_text_position "text_only") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.device.button_text_position 'text_only') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Text only" key="board_detail_settings_text_only"}} aria-label={{t "Text only" key="board_detail_settings_text_only"}} {{on "click" (this.ctrlAction "set_display_pref" "button_text_position" "text_only")}}>
                                  <span class="md-settings-btnmock"><span class="md-settings-btnmock__text md-settings-btnmock__text--only">Aa</span></span>
                                </button>
                              </div>
                            </div>
                          {{else if (is-equal sec.id "shape")}}
                            {{!-- Shape & Border — moved (not copied) from
                                 the old Preferences toolbar. Same actions
                                 and computed bindings the component
                                 already exposes; this is now the
                                 canonical editor for these prefs. --}}
                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Shape" key="board_detail_settings_shape"}}</span>
                              <div class="md-settings-icongroup" role="radiogroup" aria-label={{t "Stretch buttons" key="board_detail_prefs_stretch"}}>
                                <button type="button" role="radio" aria-checked={{if (is-equal (or this.appState.sessionUser.preferences.stretch_buttons "none") "none") "true" "false"}} class="md-settings-icon-btn {{if (is-equal (or this.appState.sessionUser.preferences.stretch_buttons 'none') 'none') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Fit cell" key="board_detail_settings_fit_cell"}} aria-label={{t "Fit cell" key="board_detail_settings_fit_cell"}} {{on "click" (this.ctrlAction "set_display_pref" "stretch_buttons" "none")}}>
                                  <span class="md-settings-stretch-icon md-settings-stretch-icon--square"></span>
                                </button>
                                <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.stretch_buttons "prefer_tall") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.stretch_buttons 'prefer_tall') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Thin" key="board_detail_settings_thin"}} aria-label={{t "Thin" key="board_detail_settings_thin"}} {{on "click" (this.ctrlAction "set_display_pref" "stretch_buttons" "prefer_tall")}}>
                                  <span class="md-settings-stretch-icon md-settings-stretch-icon--tall"></span>
                                </button>
                                <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.stretch_buttons "prefer_wide") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.stretch_buttons 'prefer_wide') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Wide" key="board_detail_settings_wide"}} aria-label={{t "Wide" key="board_detail_settings_wide"}} {{on "click" (this.ctrlAction "set_display_pref" "stretch_buttons" "prefer_wide")}}>
                                  <span class="md-settings-stretch-icon md-settings-stretch-icon--wide"></span>
                                </button>
                              </div>
                            </div>

                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Border" key="board_detail_settings_border_label"}}</span>
                              <div class="md-board-detail-edit-toolbar__stepper md-settings-stepper md-settings-stepper--compact">
                                <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_border_at_min}} data-tooltip={{t "Thinner" key="board_detail_settings_thinner"}} aria-label={{t "Thinner" key="board_detail_settings_thinner"}} {{on "click" (this.ctrlAction "step_display_pref" "button_border" -1)}}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                                </button>
                                <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_border_at_max}} data-tooltip={{t "Thicker" key="board_detail_settings_thicker"}} aria-label={{t "Thicker" key="board_detail_settings_thicker"}} {{on "click" (this.ctrlAction "step_display_pref" "button_border" 1)}}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                                </button>
                              </div>
                            </div>

                          {{else if (is-equal sec.id "skin")}}
                            {{!-- Skin Tones — moved (not copied) from the
                                 old Preferences toolbar. Same actions and
                                 computed bindings the component already
                                 exposes; this is now the canonical editor
                                 for this pref. --}}
                            {{!-- The section toggle already reads "Skin Tones",
                                 so the in-body label was redundant — removed. --}}
                            <div class="md-board-edit-right-panel__row-pair">
                              <div class="md-settings-dropdown-wrap">
                                <button type="button" class="md-settings-select md-settings-select--trigger md-settings-select--with-swatch {{if this.display_prefs_skin_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_skin_dropdown_open "true" "false"}} data-tooltip={{t "Skin tone" key="board_detail_prefs_skin"}} aria-label={{t "Skin tone" key="board_detail_prefs_skin"}} {{on "click" (this.ctrlAction "toggle_display_skin_dropdown")}}>
                                  <span class="md-settings-select__swatch md-settings-skin md-settings-skin--{{this.display_prefs_current_skin_swatch}}" aria-hidden="true"></span>
                                  <span class="md-settings-select__value">{{this.display_prefs_current_skin_label}}</span>
                                </button>
                                {{#if this.display_prefs_skin_dropdown_open}}
                                  <div class="md-settings-dropdown-backdrop" {{on "click" (this.ctrlAction "close_display_skin_dropdown")}} aria-hidden="true"></div>
                                  <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Skin tone" key="board_detail_prefs_skin"}}>
                                    {{#each this.skin_tone_options as |opt|}}
                                      <li role="presentation">
                                        <button type="button" role="option" aria-selected={{if (is-equal this.display_prefs_current_skin_id opt.id) "true" "false"}} class="md-settings-dropdown-item md-settings-dropdown-item--with-swatch {{if (is-equal this.display_prefs_current_skin_id opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_display_skin" opt.id)}}>
                                          {{#if (is-equal this.display_prefs_current_skin_id opt.id)}}
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                          {{else}}
                                            <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                          {{/if}}
                                          <span class="md-settings-dropdown-item__swatch md-settings-skin md-settings-skin--{{opt.swatch}}" aria-hidden="true"></span>
                                          <span>{{opt.label}}</span>
                                        </button>
                                      </li>
                                    {{/each}}
                                  </ul>
                                {{/if}}
                                {{#if this.skin_suboptions}}
                                  <div class="md-settings-skin-suboptions">
                                    {{#each this.skin_suboptions as |option|}}
                                      <label class="md-settings-skin-suboption md-settings-skin-suboption--{{option.id}} {{if option.checked 'md-settings-skin-suboption--checked'}}" data-tooltip={{option.label}} aria-label={{option.label}}>
                                        <input id={{concat "nb-skin-sub-" option.id}} name={{concat "nb-skin-sub-" option.id}} type="checkbox" checked={{option.checked}} {{on "change" (this.ctrlAction "toggle_skin_suboption" option)}} class="md-settings-skin-suboption__input" />
                                        <span class="md-settings-skin-suboption__swatch md-settings-skin--{{option.id}}" aria-hidden="true"></span>
                                      </label>
                                    {{/each}}
                                  </div>
                                {{/if}}
                              </div>
                            </div>
                          {{else if (is-equal sec.id "paint")}}
                            {{!-- Paint — moved (not copied) from the old
                                 Preferences toolbar. Picking a swatch (or
                                 applying a custom hex) arms `paint_mode`;
                                 clicks on preview cells then call
                                 `paint_button(label)`. Same actions and
                                 bindings the component already exposes. --}}
                            <div class="md-board-detail-edit-toolbar__dropdown-wrap--paint">
                              {{!-- Name of the currently-picked paint color shown ABOVE the
                                   swatch so the user can see which preset they chose (the
                                   swatch's POS label, e.g. "Pronoun"/"Verb", or "Custom" for a
                                   hand-picked hex). Only rendered once a color is armed. --}}
                              {{#if this.paint_mode.label}}
                                <div class="md-board-edit-right-panel__paint-selected" aria-live="polite">{{this.paint_mode.label}}</div>
                              {{/if}}
                              <div class="md-board-edit-right-panel__paint-row">
                                <button type="button"
                                  class="md-board-edit-right-panel__palette {{if this.show_paint_dropdown 'md-board-edit-right-panel__palette--open'}}"
                                  data-tooltip={{t "Choose paint color" key="board_detail_choose_paint"}}
                                  aria-label={{t "Choose paint color" key="board_detail_choose_paint"}}
                                  aria-haspopup="menu"
                                  aria-expanded={{if this.show_paint_dropdown "true" "false"}}
                                  {{on "click" (this.ctrlAction "toggle_paint_dropdown")}}>
                                  <span class="md-board-edit-right-panel__palette-preview" style={{safe-style (concat "background-color:" (if this.paint_mode.fill this.paint_mode.fill "#ffffff"))}}></span>
                                  <span class="md-board-edit-right-panel__palette-label">{{t "Select Paint Color" key="select_paint_color_caps"}}</span>
                                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="6 9 12 15 18 9"/>
                                  </svg>
                                </button>
                              </div>
                              {{#if this.show_paint_dropdown}}
                                <div class="md-board-edit-right-panel__paint-grid" role="menu">
                                  {{#each this.paint_swatches as |swatch|}}
                                    <button type="button"
                                      role="menuitem"
                                      class="md-board-edit-right-panel__paint-pill {{if (is-equal this.paint_mode.fill swatch.bg) 'md-board-edit-right-panel__paint-pill--active'}}"
                                      aria-label={{swatch.label}}
                                      {{on "click" (this.ctrlAction "set_paint_mode" swatch.bg swatch.border swatch.pos_class swatch.label)}}>
                                      <span class="md-board-edit-right-panel__paint-pill-dot" style={{safe-style (concat "background-color:" swatch.bg ";border-color:" swatch.border)}}></span>
                                      <span class="md-board-edit-right-panel__paint-pill-label">{{swatch.label}}</span>
                                    </button>
                                  {{/each}}
                                  <button type="button"
                                    role="menuitem"
                                    class="md-board-edit-right-panel__paint-pill md-board-edit-right-panel__paint-pill--custom {{if this.show_paint_color_picker 'md-board-edit-right-panel__paint-pill--open'}}"
                                    aria-label={{t "Custom Color" key="board_detail_custom_paint_color"}}
                                    aria-expanded={{if this.show_paint_color_picker "true" "false"}}
                                    {{on "click" (this.ctrlAction "toggle_paint_color_picker")}}>
                                    <span class="md-board-edit-right-panel__paint-pill-dot md-board-edit-right-panel__paint-pill-dot--custom"></span>
                                    <span class="md-board-edit-right-panel__paint-pill-label">{{t "Custom Color" key="board_detail_custom_paint_color"}}</span>
                                  </button>
                                  {{#if this.show_paint_color_picker}}
                                    <div class="md-board-edit-right-panel__custom-picker">
                                      <input type="color"
                                        id="nb-paint-color-picker"
                                        class="md-board-edit-right-panel__custom-picker-input"
                                        value={{this.custom_paint_color}}
                                        aria-label={{t "Pick paint color" key="board_detail_pick_paint_color"}}
                                        autocomplete="off"
                                        {{on "input" (this.ctrlActionEventValue "update_custom_paint_color" "value")}}>
                                      <input value={{this.custom_paint_color}} id="nb-paint-hex-input" placeholder="#hex" aria-label={{t "Custom hex color" key="custom_hex_color"}} class="md-board-edit-right-panel__custom-picker-hex" autocomplete="off" {{on "input" (set-field this "custom_paint_color")}} />
                                      <button type="button"
                                        class="md-board-edit-right-panel__custom-picker-apply"
                                        {{on "click" (this.ctrlAction "apply_custom_paint_color")}}>
                                        {{t "Apply" key="board_detail_apply"}}
                                      </button>
                                    </div>
                                  {{/if}}
                                </div>
                              {{/if}}
                            </div>
                          {{else if (is-equal sec.id "layout")}}
                            {{!-- Board Layout — mirrors the board-detail
                                 edit panel's Board Layout. Grid Gap was
                                 moved here from Shape & Border (same
                                 step_display_pref binding). Rows/Columns
                                 COPY the page's existing grid-size
                                 counters (same plus_minus action +
                                 model.grid.rows/columns) — the originals
                                 in the Size & Labels section are left in
                                 place; this is an additional editor. --}}
                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label md-board-edit-right-panel__row-pair-label--center">{{t "Grid Gap" key="grid_gap"}} <span class="md-board-edit-right-panel__row-pair-label-hint">{{t "(Space between buttons)" key="space_between_buttons_hint"}}</span></span>
                              <div class="md-board-detail-edit-toolbar__stepper md-settings-stepper md-settings-stepper--compact">
                                <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_spacing_at_min}} data-tooltip={{t "Tighter" key="board_detail_settings_tighter"}} aria-label={{t "Tighter" key="board_detail_settings_tighter"}} {{on "click" (this.ctrlAction "step_display_pref" "button_spacing" -1)}}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                                </button>
                                <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_spacing_at_max}} data-tooltip={{t "Looser" key="board_detail_settings_looser"}} aria-label={{t "Looser" key="board_detail_settings_looser"}} {{on "click" (this.ctrlAction "step_display_pref" "button_spacing" 1)}}>
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                                </button>
                              </div>
                            </div>
                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Rows" key="board_detail_rows"}}</span>
                              <div class="md-board-edit-right-panel__stepper">
                                <button type="button" class="md-board-edit-right-panel__stepper-btn" {{on "click" (this.ctrlAction "plus_minus" "minus" "model.grid.rows")}} aria-label={{t "Decrease rows" key="decrease_rows"}}>−</button>
                                <span class="md-board-edit-right-panel__stepper-value">{{this.model.grid.rows}}</span>
                                <button type="button" class="md-board-edit-right-panel__stepper-btn" {{on "click" (this.ctrlAction "plus_minus" "plus" "model.grid.rows")}} aria-label={{t "Increase rows" key="increase_rows"}}>+</button>
                              </div>
                            </div>
                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Columns" key="board_detail_columns"}}</span>
                              <div class="md-board-edit-right-panel__stepper">
                                <button type="button" class="md-board-edit-right-panel__stepper-btn" {{on "click" (this.ctrlAction "plus_minus" "minus" "model.grid.columns")}} aria-label={{t "Decrease columns" key="decrease_columns"}}>−</button>
                                <span class="md-board-edit-right-panel__stepper-value">{{this.model.grid.columns}}</span>
                                <button type="button" class="md-board-edit-right-panel__stepper-btn" {{on "click" (this.ctrlAction "plus_minus" "plus" "model.grid.columns")}} aria-label={{t "Increase columns" key="increase_columns"}}>+</button>
                              </div>
                            </div>
                          {{else if (is-equal sec.id "background")}}
                            {{!-- Background (symbol-image background color)
                                 — moved (not copied) from the Preferences
                                 inset. Same actions/bindings the component
                                 already exposes; presented like the
                                 board-detail Background section (centered
                                 two-line label + dropdown). --}}
                            <div class="md-settings-sublabel-wrap">
                              <span class="md-settings-sublabel">{{t "Background Color" key="board_detail_settings_image_background_color_all_line1"}}<br />{{t "for All Board Buttons" key="board_detail_settings_image_background_color_all_line2"}}</span>
                              <div class="md-settings-dropdown-wrap">
                                <button type="button" class="md-settings-select md-settings-select--trigger md-settings-select--img-bg {{if this.display_prefs_symbol_background_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_symbol_background_dropdown_open "true" "false"}} data-tooltip={{t "Background color behind symbol images" key="board_detail_prefs_image_background_tooltip"}} aria-label={{t "Background color behind symbol images" key="board_detail_prefs_image_background_tooltip"}} {{on "click" (this.ctrlAction "toggle_display_symbol_background_dropdown")}}>
                                  <span class="md-settings-select__value">{{this.display_prefs_current_symbol_background_label}}</span>
                                </button>
                                {{#if this.display_prefs_symbol_background_dropdown_open}}
                                  <div class="md-settings-dropdown-backdrop" {{on "click" (this.ctrlAction "close_display_symbol_background_dropdown")}} aria-hidden="true"></div>
                                  <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Image background color" key="board_detail_prefs_image_background"}}>
                                    {{#each this.symbol_background_options as |opt|}}
                                      <li role="presentation">
                                        <button type="button" role="option" aria-selected={{if (is-equal this.display_prefs_current_symbol_background_id opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.display_prefs_current_symbol_background_id opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_display_symbol_background" opt.id)}}>
                                          {{#if (is-equal this.display_prefs_current_symbol_background_id opt.id)}}
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                          {{else}}
                                            <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                          {{/if}}
                                          <span>{{opt.label}}</span>
                                        </button>
                                      </li>
                                    {{/each}}
                                  </ul>
                                {{/if}}
                              </div>
                            </div>
                          {{else if (is-equal sec.id "symbols")}}
                            {{!-- Board Symbols — moved (not copied) from
                                 the Preferences inset. Same actions and
                                 bindings the component already exposes;
                                 presented like the board-detail Board
                                 Symbols section (centered scope hint +
                                 full-width dropdown). --}}
                            <p class="md-board-edit-right-panel__hint" style="text-align: center;">{{t "Your preferred symbol library (applies to all your boards)" key="board_symbols_hint_user_scope"}}</p>
                            <div class="md-settings-dropdown-wrap">
                              <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_symbol_library_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_symbol_library_dropdown_open "true" "false"}} data-tooltip={{t "Symbol library" key="board_detail_prefs_symbol_library"}} aria-label={{t "Symbol library" key="board_detail_prefs_symbol_library"}} {{on "click" (this.ctrlAction "toggle_display_symbol_library_dropdown")}}>
                                <span class="md-settings-select__value">{{this.display_prefs_current_symbol_library_label}}</span>
                              </button>
                              {{#if this.display_prefs_symbol_library_dropdown_open}}
                                <div class="md-settings-dropdown-backdrop" {{on "click" (this.ctrlAction "close_display_symbol_library_dropdown")}} aria-hidden="true"></div>
                                <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Symbol library" key="board_detail_prefs_symbol_library"}}>
                                  {{#each this.preferred_symbols_options as |opt|}}
                                    <li role="presentation">
                                      <button type="button" role="option" aria-selected={{if (is-equal this.appState.sessionUser.preferences.preferred_symbols opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.appState.sessionUser.preferences.preferred_symbols opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_display_symbol_library" opt.id)}}>
                                        {{#if (is-equal this.appState.sessionUser.preferences.preferred_symbols opt.id)}}
                                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                        {{else}}
                                          <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                        {{/if}}
                                        <span>{{opt.label}}</span>
                                      </button>
                                    </li>
                                  {{/each}}
                                </ul>
                              {{/if}}
                            </div>
                          {{else if (is-equal sec.id "speakbar")}}
                            {{!-- Speak Bar — same controls/actions as the
                                 board-detail edit panel's Speak Bar.
                                 "Show on Speak Bar as…" sets
                                 utterance_text_only; "Sentence Bar"
                                 sets vocalization_height. Bindings read
                                 the live session user prefs (this
                                 component is stateless, no pending). --}}
