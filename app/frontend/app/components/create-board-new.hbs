                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Show on Speak Bar as..." key="speak_bar_hint"}}</span>
                              <div class="md-settings-icongroup" role="radiogroup" aria-label={{t "Speak bar appearance" key="board_detail_prefs_speak_bar"}}>
                                <button type="button" role="radio" aria-checked={{if (is-equal this.utterance_text_only_str "false") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.utterance_text_only_str 'false') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Show on Speak Bar as... symbol buttons (image with text below)" key="board_detail_settings_speak_bar_symbols"}} aria-label={{t "Show on Speak Bar as... symbol buttons (image with text below)" key="board_detail_settings_speak_bar_symbols"}} {{on "click" (this.ctrlAction "set_utterance_text_only" "false")}}>
                                  <span class="md-settings-btnmock"><span class="md-settings-btnmock__img"></span><span class="md-settings-btnmock__text md-settings-btnmock__text--bottom">Aa</span></span>
                                </button>
                                <button type="button" role="radio" aria-checked={{if (is-equal this.utterance_text_only_str "true") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.utterance_text_only_str 'true') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Show on Speak Bar as... words only (text, no symbols)" key="board_detail_settings_speak_bar_words"}} aria-label={{t "Show on Speak Bar as... words only (text, no symbols)" key="board_detail_settings_speak_bar_words"}} {{on "click" (this.ctrlAction "set_utterance_text_only" "true")}}>
                                  <span class="md-settings-btnmock"><span class="md-settings-btnmock__text md-settings-btnmock__text--only">Aa</span></span>
                                </button>
                              </div>
                            </div>
                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Sentence Bar" key="board_detail_settings_voice_height"}}</span>
                              <div class="md-settings-dropdown-wrap">
                                <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_voice_height_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_voice_height_dropdown_open "true" "false"}} data-tooltip={{t "Height of the speak-mode sentence bar" key="board_detail_prefs_voice_height_tooltip"}} aria-label={{t "Sentence bar size" key="board_detail_prefs_voice_height_aria"}} {{on "click" (this.ctrlAction "toggle_display_voice_height_dropdown")}}>
                                  <span class="md-settings-select__value">{{this.display_prefs_current_voice_height_label}}</span>
                                </button>
                                {{#if this.display_prefs_voice_height_dropdown_open}}
                                  <div class="md-settings-dropdown-backdrop" {{on "click" (this.ctrlAction "close_display_voice_height_dropdown")}} aria-hidden="true"></div>
                                  <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Sentence bar size" key="board_detail_prefs_voice_height_aria"}}>
                                    {{#each this.voice_height_options as |opt|}}
                                      <li role="presentation">
                                        <button type="button" role="option" aria-selected={{if (is-equal this.appState.sessionUser.preferences.device.vocalization_height opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.appState.sessionUser.preferences.device.vocalization_height opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_display_voice_height" opt.id)}}>
                                          {{#if (is-equal this.appState.sessionUser.preferences.device.vocalization_height opt.id)}}
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                          {{else}}
                                            <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                          {{/if}}
                                          <span>{{opt.label}}</span>
                                        </button>
                                      </li>
                                    {{/each}}
                                  </ul>
                                {{/if}}
                              </div>
                            </div>
                          {{else}}
                            <p class="md-board-edit-right-panel__hint" style="font-style: italic; opacity: 0.6; margin: 0;">{{t "Controls coming soon." key="rail_section_coming_soon"}}</p>
                          {{/if}}
                        </div>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
                {{!-- Divider below the Appearance sections (Text Settings is the
                     last), then a Clear Grid action mirroring the labels-row
                     "clear grid" button (same clearGrid action) so the grid can
                     be reset from the live edit rail too. Shown only when there
                     are labels to clear. --}}
                {{#if this.label_count}}
                  <div class="md-board-edit-right-panel__divider" role="presentation"></div>
                  <div class="nb-create-rail__clear-grid">
                    <button type="button"
                            class="nb-link nb-link--danger nb-create-rail__clear-grid-btn"
                            {{on "click" (this.ctrlAction "clearGrid")}}
                            aria-label={{t "Clear all labels" key="clear_all_labels"}}>
                      <svg class="nb-link__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                        <path d="M3 4 L3 12 Q3 13 4 13 L10 13 Q11 13 11 12 L11 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2 4 L12 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                        <path d="M5.5 4 L5.5 2.5 Q5.5 2 6 2 L8 2 Q8.5 2 8.5 2.5 L8.5 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M5.5 6.5 L5.5 10.5 M8.5 6.5 L8.5 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                      </svg>
                      <span>{{t "clear grid" key="clear_grid"}}</span>
                    </button>
                  </div>
                {{/if}}
              </div>
              {{!-- Primary action docked at the foot of the Edit Tools rail on
                   the standalone page: a compact, bottom-aligned Save Board.
                   The legacy modal keeps its own footer below. --}}
              {{#if this.standalone}}
                <div class="nb-create-rail__actions">
                  <span id="new-board-create-hint" class="sr-only" aria-live="polite">{{this.missing_required_summary}}</span>
                  <button type="button" {{on "click" (this.ctrlAction "attemptSave")}}
                          class="btn btn-primary new-board__submit nb-create-rail__submit {{if this.createBoardDisabled 'new-board__submit--invalid'}}"
                          aria-disabled={{if this.createBoardDisabled "true" "false"}}
                          aria-describedby="new-board-create-hint">
                    {{#if this.status.saving}}
                      {{t "Creating Board..." key="creating_board"}}
                    {{else if this.status.error}}
                      {{t "Error Creating Board" key="error_creating_board"}}
                    {{else}}
                      {{t "Save Board" key="save_board"}}
                    {{/if}}
                  </button>
                </div>
              {{/if}}
            </aside>
            </div>
            {{/if}}
          </div>
        </section>
        {{/if}}

        {{!-- AI mode: Visibility + Advanced options stay hidden until
             the user has run "Generate Labels with AI". In regular
             mode show_full_size_section is always true, so this is a
             no-op there. --}}
        {{#if this.show_full_size_section}}
        {{!-- Visibility control removed from the create flow — boards are created
             PRIVATE by default (model.visibility = 'private'); visibility can still
             be changed later from board-detail. --}}
        <section class="nb-section nb-section--advanced">
          <button
            type="button"
            class="nb-advanced-toggle {{if this.more_options 'nb-advanced-toggle--open'}}"
            aria-expanded={{if this.more_options "true" "false"}}
            aria-controls="nb-advanced-panel"
            {{on "click" (this.ctrlAction "more_options")}}
          >
            <span class="nb-advanced-toggle__lockup">
              <div class="nb-section__title-row">
                <div class="nb-section__title nb-advanced-toggle__title">{{t "Advanced options" key="new_board_section_advanced"}}</div>
                <span class="nb-section__optional-pill">{{t "optional" key="optional"}}</span>
              </div>
              <ul class="nb-section__hint nb-advanced-toggle__hint" role="list" aria-label={{t "Includes" key="advanced_options_includes_aria"}}>
                <li class="nb-advanced-toggle__hint-item">{{t "Fill order" key="advanced_hint_fill_order"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Board key" key="advanced_hint_board_key"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Language" key="advanced_hint_language"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Icon" key="advanced_hint_icon"}}</li>
              </ul>
            </span>
            <svg class="nb-advanced-toggle__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          {{#if this.more_options}}
            <div id="nb-advanced-panel" class="nb-section__body">
              <div class="nb-field new-board-field--fill-order">
                <span class="nb-field__label">{{t "Fill order" key="fill_order"}}</span>
                <div class="nb-field__radio-group nb-field__radio-group--inline" role="radiogroup" aria-label={{t "Fill order" key="fill_order"}}>
                  <div class="nb-field__radio-row">
                    <label class="nb-radio">
                      <input type="radio"
                             name="labels_order"
                             value="rows"
                             checked={{is_equal this.model.grid.labels_order "rows"}}
                             {{on "change" (this.ctrlAction "setLabelsOrder" "rows")}} />
                      <span class="nb-radio__label">{{t "Rows, left to right" key="rows_first_short"}}</span>
                    </label>
                    <label class="nb-radio">
                      <input type="radio"
                             name="labels_order"
                             value="columns"
                             checked={{is_equal this.model.grid.labels_order "columns"}}
                             {{on "change" (this.ctrlAction "setLabelsOrder" "columns")}} />
                      <span class="nb-radio__label">{{t "Columns, top to bottom" key="columns_first_short"}}</span>
                    </label>
                  </div>
                </div>
              </div>
              <div class="nb-field new-board-field--key">
                <label for="new_board_key" class="nb-field__label">{{t "Key" key="key"}}</label>
                <input value={{this.model.key}} class="form-control nb-field__input nb-field__input--narrow" id="new_board_key" placeholder={{this.key_placeholder}} {{on "input" (set-field this "model.key")}} />
              </div>
              <div class="nb-field new-board-field--locale">
                <label for="locale" class="nb-field__label">{{t "Language" key="locale"}}</label>
                {{#if this.appState.feature_flags.english_first_board_generation}}
                  <p class="nb-field__hint">{{t "Boards are created in English first for accurate symbol colors. You can translate after saving." key="english_first_board_hint"}}</p>
                {{else}}
                  <ModernSelect @class="new-board-select--modern" @selectId="locale" @content={{this.locales}} @selection={{this.model.locale}} @action={{this.ctrlAction "setLocale"}} @ariaLabel={{t "Language" key="locale"}} />
                {{/if}}
              </div>
              <div class="nb-field new-board-field--icon nb-icon-disclosure {{if this.icon_picker_open 'nb-icon-disclosure--open'}}">
                <button
                  type="button"
                  class="nb-icon-disclosure__toggle"
                  aria-expanded={{if this.icon_picker_open "true" "false"}}
                  aria-controls="nb-icon-picker-panel"
                  {{on "click" (this.ctrlAction "toggleIconPicker")}}
                >
                  <span class="nb-icon-disclosure__lockup">
                    <span class="nb-field__label nb-icon-disclosure__label">{{t "Icon for your Board" key="icon_for_your_board"}}</span>
                  </span>
                  <svg class="nb-icon-disclosure__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
                {{#if this.icon_picker_open}}
                  <div id="nb-icon-picker-panel" class="nb-icon-disclosure__panel">
                    <IconSelect @selection={{this.model.image_url}} @action={{mut this.model.image_url}} />
                  </div>
                {{/if}}
              </div>
            </div>
          {{/if}}
        </section>
        {{/if}}
      </form>
    </div>
    {{!-- Standalone page: Create/Cancel now live in the Edit Tools rail
         (see nb-create-rail__actions above), so the page-level footer only
         renders for the legacy modal context. --}}
    {{#unless this.standalone}}
    <div class="la-new-board-modal-footer">
      {{!-- Visually hidden description tied to the Create button via
           aria-describedby. When fields are missing, the assistive
           technology announces what's needed; once everything's set
           the span clears. Replaces the previous inline floating hint —
           modern pattern (Stripe/Linear/Vercel) is to keep the disabled
           CTA self-explanatory and let the reason live in a tooltip /
           aria description, not as floating layout text. --}}
      {{!-- Verified false positive: this #new-board-create-hint and its twin are
           mutually-exclusive branches, only one renders (live DOM count=1). It is
           referenced by aria-describedby, so it must keep this id. --}}
      {{! template-lint-disable no-duplicate-id }}
      <span id="new-board-create-hint" class="sr-only" aria-live="polite">{{this.missing_required_summary}}</span>
      {{! template-lint-enable no-duplicate-id }}
      <div class="la-new-board-modal-footer__actions">
        <button type="button" {{on "click" (this.ctrlAction "attemptSave")}}
                class="la-btn la-btn--primary new-board__submit {{if this.createBoardDisabled 'new-board__submit--invalid'}}"
                aria-disabled={{if this.createBoardDisabled "true" "false"}}
                aria-describedby="new-board-create-hint">
          {{#if this.status.saving}}
            {{t "Creating Board..." key="creating_board"}}
          {{else if this.status.error}}
            {{t "Error Creating Board" key="error_creating_board"}}
          {{else}}
            {{t "Save Board" key="save_board"}}
          {{/if}}
        </button>
        <button type="button" class="la-btn la-btn--ghost" {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
      </div>
    </div>
    {{/unless}}
  </div>
</GridListener>
