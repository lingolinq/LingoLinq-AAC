<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    {{#if this.set_home_board}}
      <h3>{{t "Set Home Board?" key="set_home_board_question"}}</h3>
    {{else}}
      <h3>{{t "Confirm Remove" key="confirm_remove"}}</h3>
    {{/if}}
  </div>
  <div class="modal-body md-modal-body">
    <div class="form-horizontal">
      <div class="form-group">
        <div class="col-sm-8 col-sm-offset-2">
          <p class="form-control-static">
            {{#if this.set_home_board}}
              {{t "Would you like to set a home board for the user <b>%{user_name}</b>, if they don't already have one set?" user_name=this.model.user_name key="confirm_set_home_board"}}
            {{else if this.model.user_name}}
              {{t "Are you sure you want to remove the user <b>%{user_name}</b> from the org?" user_name=this.model.user_name key="confirm_remove_user"}}
              {{#if this.show_offboarding_age}}
                <span class="help-block" style="margin-top: 12px; display: block;">
                  {{t "Enter their birth month and year so we can apply the right family-account protections. Under 13 needs parental consent to keep using the account. Under 16 will have AI features turned off (a parent can approve AI later in preferences)." key="offboarding_age_help"}}
                </span>
              {{/if}}
            {{else if this.model.unit_user_name}}
              {{t "Are you sure you want to remove the user from the room?" user_name=this.model.user_name key="confirm_remove_unit_user"}}
            {{else if this.model.org_name}}
              {{t "Are you sure you want to delete the org <b>%{org_name}</b> permanently? This cannot be undone. If so, please type \"confirmed\" in the box below." org_name=this.model.org_name key="confirm_remove_org"}}
            {{else if this.model.lesson_name}}
              {{t "Are you sure you want to remove the training <b>%{ln}</b> from this organization?" ln=this.model.lesson_name key="confirm_remove_training"}}
            {{else}}
              {{t "Are you sure you want to remove this? If so, please type \"confirmed\" in the box below." key="confirm_remove_other"}}
            {{/if}}
          </p>
        </div>
      </div>
      {{#if this.set_home_board}}
        <div class='form-group'>
          <label for='home_board' class='col-sm-offset-1 col-sm-3'>
            {{t "Home Board:" key="home_board_colon"}}
          </label>
          <div class='col-sm-6'>
            <BoundSelect @select_class="form-control" @select_id="home_board" @content={{this.board_options}} @selection={{this.home_board_template}} @action={{mut this.home_board_template}} />
          </div>
        </div>
        {{#if this.board_will_copy}}
          <div class="form-group">
            <label for="symbols" class="col-sm-4 control-label">{{t "Preferred Symbols" key="preferred_symbols"}}</label>
            <div class="col-sm-6">
              <BoundSelect @select_class="form-control" @select_id="preferred_symbols" @content={{this.symbols_list}} @selection={{this.preferred_symbols}} @action={{mut this.preferred_symbols}} />
              {{#if this.premium_symbol_library}}
                {{#unless this.add_symbols}}
                  <div class='text-danger' style='margin-left: 10px;'>
                    {{t "(will not apply without premium symbols access)" key="wont_apply_without_premium_symbols"}}
                  </div>
                {{/unless}}
              {{/if}}
            </div>
          </div>
          {{#if this.premium_symbol_library}}
            {{#if this.model.org.extras_available}}
              <div class="form-group">
                <label for="extras" class="col-sm-4 control-label">{{t "Premium Symbols" key="premium_symbols"}}</label>
                <div class="col-sm-6">
                  <div class="checkbox big_checkbox">
                    <label>
                      <input type="checkbox" checked={{this.add_symbols}} id="extras" {{on "change" (set-field this "add_symbols" "checkbox")}} />
                      {{t "Grant premium symbol access if not already granted" key="grand_premium_symbols_if_needed"}}
                      ({{this.model.org.extras_available_count}} {{t "left" key="left"}})
                    </label>
                  </div>
                </div>
              </div>
            {{/if}}
          {{/if}}
        {{/if}}
      {{else}}
        {{#if this.show_offboarding_age}}
          <div class="form-group">
            <label class="col-sm-offset-1 col-sm-3 control-label" for="offboarding_birth_month">
              {{t "Date of birth" key="date_of_birth"}}
            </label>
            <div class="col-sm-6">
              <div class="row">
                <div class="col-xs-6" style="padding-left: 0;">
                  {{bound-select select_class="form-control" select_id="offboarding_birth_month" content=this.birthMonths selection=this.birth_month action=(mut this.birth_month) }}
                </div>
                <div class="col-xs-6" style="padding-right: 0;">
                  {{bound-select select_class="form-control" select_id="offboarding_birth_year" content=this.birthYears selection=this.birth_year action=(mut this.birth_year) }}
                </div>
              </div>
            </div>
          </div>
        {{/if}}
        {{#if this.show_offboarding_parent_email}}
          <div class="form-group">
            <label for="offboarding_parent_email" class="col-sm-offset-1 col-sm-3 control-label">
              {{t "Parent email (optional)" key="offboarding_parent_email_label"}}
            </label>
            <div class="col-sm-6">
              <Input @type="email" @value={{this.offboarding_parent_email}} class="form-control" id="offboarding_parent_email" placeholder={{t "Parent or guardian email" key="offboarding_parent_email_placeholder"}} autocomplete="email" inputmode="email" />
              <span class="help-block">
                {{t "Optional now. If blank, they will be asked for a parent email the next time they log in." key="offboarding_parent_email_under13_help"}}
              </span>
            </div>
          </div>
        {{/if}}
        {{#unless this.model.user_name}}
          {{#unless this.model.unit_user_name}}
            {{#unless this.model.lesson_name}}
              <div class="form-group">
                <div class="col-sm-8 col-sm-offset-2">
                  <input value={{this.confirmed}} class="form-control" placeholder="..." aria-label={{t "Please type \"confirmed\" to confirm." key="type_confirmed"}} {{on "input" (set-field this "confirmed")}} />
                </div>
              </div>
            {{/unless}}
          {{/unless}}
        {{/unless}}
      {{/if}}
    </div>
  </div>
  <div class="modal-header md-modal-header">
    {{#if this.set_home_board}}
      <button class='btn btn-default btn-lg' {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
      <button class='btn btn-primary btn-lg' {{on "click" (this.ctrlAction "confirm")}}>
        {{t "Continue" key="continue"}}
      </button>
    {{else}}
      <button class='btn btn-primary btn-lg' {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
      <button class='btn btn-default btn-lg' {{on "click" (this.ctrlAction "confirm")}}>
        {{#if this.model.user_name}}
          {{t "Remove User" key="remove_user"}}
        {{else if this.model.unit_user_name}}
          {{t "Remove User" key="remove_user"}}
        {{else if this.model.lesson_name}}
          {{t "Remove Training" key="remove_training"}}
        {{else if this.model.org_name}}
          {{t "Delete Account" key="delete_account"}}
        {{else}}
          {{t "Delete" key="delete"}}
        {{/if}}
      </button>
    {{/if}}
    {{#if this.error}}
      <p class='text-danger'>{{this.error}}</p>
    {{/if}}
  </div>
</ModalDialog>
