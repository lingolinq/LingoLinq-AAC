<div class="md-eval-intro__panel">
  <div class="md-eval-intro__icon" aria-hidden="true">
    {{!-- Clipboard-check: evaluation/assessment glyph, duotone verdigris over navy --}}
    <svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" focusable="false">
      <rect x="4" y="3.2" width="16" height="18" rx="3.2" fill="rgba(42,157,143,0.14)" stroke="#1B365D" stroke-width="1.6"/>
      <rect x="8.4" y="1.6" width="7.2" height="3.8" rx="1.5" fill="#ffffff" stroke="#1B365D" stroke-width="1.6"/>
      <path d="M8 12.6l2.4 2.4L16.2 9.2" stroke="#2A9D8F" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <p class="md-eval-intro__eyebrow">{{t "Evaluation" key="evaluation"}}</p>

  {{#if this.isWelcome}}
    {{!-- Combined welcome screen: the old welcome + how-to + first-section
          messages distilled into a scannable checklist (Starting jumps
          straight into the first assessment step). --}}
    <h2 class="md-eval-intro__heading">{{t "Welcome to the Evaluation Tool" key="eval_intro_heading"}}</h2>
    <ul class="md-eval-intro__checklist">
      <li class="md-eval-intro__checklist-item">
        <span class="md-eval-intro__check" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" focusable="false"><path d="M5 12.5l4 4L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span>{{t "Assesses how a communicator accesses and understands buttons, symbols, and concepts." key="eval_intro_point_1"}}</span>
      </li>
      <li class="md-eval-intro__checklist-item">
        <span class="md-eval-intro__check" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" focusable="false"><path d="M5 12.5l4 4L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span>{{t "Use the top-right menu to configure or end the evaluation anytime, and add notes when it's complete." key="eval_intro_point_2"}}</span>
      </li>
      <li class="md-eval-intro__checklist-item">
        <span class="md-eval-intro__check" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" focusable="false"><path d="M5 12.5l4 4L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span>{{t "You'll begin by finding a single target shown at different locations and sizes." key="eval_intro_point_3"}}</span>
      </li>
    </ul>
  {{else}}
    <p class="md-eval-intro__lead">{{this.text}}</p>
  {{/if}}

  <div class="md-eval-intro__actions">
    <button type="button" class="md-eval-intro__settings" {{action "settings"}} aria-label={{t "Eval Settings" key="eval_settings"}}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{{t "Eval Settings" key="eval_settings"}}</span>
    </button>

    <button type="button" class="md-eval-intro__cta" {{action "start"}} aria-label={{t "Start Evaluation" key="eval_intro_start_cta"}}>
      <span>{{t "Start Evaluation" key="eval_intro_start_cta"}}</span>
      <svg class="md-eval-intro__cta-arrow" viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true" focusable="false">
        <path d="M5 12h13M12.5 5.5L19 12l-6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  {{!-- Section navigation — mirrors the toolbar's Back / Skip / Next so the
        SLP can move between (or skip) evaluation sections from the card.
        These remain on the toolbar too. Hidden on the combined welcome
        screen (which only explains + starts the evaluation). --}}
  {{#unless this.isWelcome}}
  <div class="md-eval-intro__nav">
    <button type="button" class="md-eval-intro__nav-btn" {{action "back"}} aria-label={{t "Previous Section" key="previous_section"}}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true" focusable="false">
        <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{{t "Back" key="back"}}</span>
    </button>

    {{#if this.showSkip}}
      <button type="button" class="md-eval-intro__nav-btn md-eval-intro__nav-btn--skip" {{action "skip"}} aria-label={{t "Skip Section" key="skip_section"}}>
        <span>{{t "Skip" key="skip"}}</span>
      </button>
    {{/if}}

    <button type="button" class="md-eval-intro__nav-btn" {{action "next"}} aria-label={{t "Next Section" key="next_section"}}>
      <span>{{t "Next" key="next"}}</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true" focusable="false">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  {{/unless}}
</div>
