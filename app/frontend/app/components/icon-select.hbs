<!-- TODO: i18n for placeholders based on element id -->
<input value={{this.selection}} class="form-control" id="image_url" placeholder="pick from the list below or paste a URL" aria-label={{t "Image URL" key="image_url"}} {{on "input" (set-field this "selection")}} />
<div class="icon-select__preview {{if this.selection_preview "icon-select__preview--filled" "icon-select__preview--empty"}}">
  {{#if this.selection_preview}}
    <img class="icon-select__preview-img" src={{this.selection_preview}} {{on "click" (this.ctrlAction "pick" this.selection_preview)}} alt="current image">
  {{/if}}
</div>
<div class="icon_urls">
  {{#each this.iconUrls as |icon|}}
    <img src={{icon.url}} {{on "click" (this.ctrlAction "pick" icon.url)}} alt={{icon.alt}} >
  {{/each}}
  {{#each this.included_icon_urls as |url|}}
    <img src={{url}} {{on "click" (this.ctrlAction "pick" url)}} alt={{t "original" key="alternate"}} >
  {{/each}}
</div>
<div style="clear: left;"></div>
