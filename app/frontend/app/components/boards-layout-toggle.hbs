{{!-- Layout selector for the Boards page: SIDE-BY-SIDE vs TOP-DOWN.
      A radio GROUP rather than two independent buttons — the two options are
      mutually exclusive, so `role="radiogroup"` + `aria-checked` is what tells a
      screen reader that picking one clears the other. `aria-pressed` on separate
      toggle buttons would announce two independent on/off controls instead. --}}
{{!-- The visible "LAYOUT" caption was removed, but the group still needs an accessible
      NAME — without one the radiogroup announces as an unlabelled set of two radios. The
      same i18n key now supplies it via `aria-label` instead of a visible `aria-labelledby`
      target, so the string stays in use and translated. --}}
<span class="ub-boards-page__layout-toggle-options" role="radiogroup" aria-label={{t "Layout" key="boards_layout_label"}}>
  <button
    type="button"
    role="radio"
    aria-checked={{if this.isSideBySide "true" "false"}}
    class="ub-boards-page__layout-toggle-btn {{if this.isSideBySide 'ub-boards-page__layout-toggle-btn--active'}}"
    title={{t "Folders beside the boards — folders take a quarter of the width on the left" key="boards_layout_side_by_side_hint"}}
    {{on "click" (this.sendAction "choose" "side-by-side")}}
  >
    {{!-- Two unequal columns, matching the 1fr / 3fr split the layout actually uses. --}}
    <svg class="ub-boards-page__layout-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="5" height="16" rx="1"/>
      <rect x="11" y="4" width="10" height="16" rx="1"/>
    </svg>
    {{t "Side by side" key="boards_layout_side_by_side"}}
  </button>
  <button
    type="button"
    role="radio"
    aria-checked={{if this.isSideBySide "false" "true"}}
    class="ub-boards-page__layout-toggle-btn {{unless this.isSideBySide 'ub-boards-page__layout-toggle-btn--active'}}"
    title={{t "Folders stacked above the boards, each at full width" key="boards_layout_top_down_hint"}}
    {{on "click" (this.sendAction "choose" "top-down")}}
  >
    {{!-- Two stacked full-width bands — the original arrangement. --}}
    <svg class="ub-boards-page__layout-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="6" rx="1"/>
      <rect x="3" y="14" width="18" height="6" rx="1"/>
    </svg>
    {{t "Top down" key="boards_layout_top_down"}}
  </button>
</span>
