{{#if @parent.linked}}
  <div class="btn-group dropup">
    <button class='btn md-modal-btn md-modal-btn--secondary dropdown-toggle' data-toggle="dropdown" aria-expanded="false">
      {{t "More Options" key="more_options"}} <span class="caret"></span>
    </button>
    <ul class="dropdown-menu md-modal-dropup" role="menu">
      {{#if @parent.home_board}}
        <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "links_copy")}}>{{t "Copy Board & All Linked Boards" key="copy_everything"}}</a></li>
      {{else if @parent.sidebar_board}}
        <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "links_copy")}}>{{t "Copy Board & All Linked Boards" key="copy_everything"}}</a></li>
      {{else if @parent.in_board_set}}
        <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "links_copy")}}>{{t "Copy Board & All Linked Boards" key="copy_everything"}}</a></li>
      {{else if @parent.in_sidebar_set}}
        <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "links_copy")}}>{{t "Copy Board & All Linked Boards" key="copy_everything"}}</a></li>
      {{else if @parent.linked}}
      {{else}}
        <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "links_copy")}}>{{t "Copy Board & All Linked Boards" key="copy_everything"}}</a></li>
      {{/if}}
      {{#if @parent.in_board_set}}
        <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "modify_links_copy")}}>{{t "Copy Into the Communication Set" key="use_new_copy"}}</a></li>
        <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "modify_links_update")}}>{{t "Use Existing Copies if I Have Any" key="update_in_place"}}</a></li>
      {{else if @parent.in_sidebar_set}}
        <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "modify_links_copy")}}>{{t "Copy Into the Sidebar Set" key="use_new_sidebar_copy"}}</a></li>
        <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "modify_links_update")}}>{{t "Use Existing Copies if I Have Any" key="update_in_place"}}</a></li>
      {{/if}}
      <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "keep_links")}}>{{t "Copy Just This Board" key="copy_just_this_board"}}</a></li>
      <li><a href="#" {{on "click" (this.ctrlAction "tweakBoard" "remove_links")}}>{{t "Copy Board without Links" key="remove_links_while_copying"}}</a></li>
    </ul>
  </div>
{{else}}
  <button class='btn md-modal-btn md-modal-btn--secondary' {{on "click" (this.ctrlAction "tweakBoard" "keep_links")}}>{{t "Copy Just This Board" key="copy_just_this_board"}}</button>
{{/if}}
