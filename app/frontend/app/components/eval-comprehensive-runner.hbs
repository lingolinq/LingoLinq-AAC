{{!-- Comprehensive Eval (Mode 3) runner — Phase 3 scaffold. The
     dynamic_assessment subtest is fully implemented (every item
     escalates through 6 prompt levels and records every attempt).
     The other three subtests (literacy_probe, sett_form,
     ai_narration) render placeholder cards with Skip buttons so
     the SLP can run the flow end-to-end while subsequent
     iterations land each one. --}}
<section class="evq-comp__shell">
  <header class="evq-comp__header">
    <span class="evq-comp__eyebrow">{{t "Comprehensive Eval" key="comp_eyebrow"}}</span>
    <h2 class="evq-comp__title">{{this.subtestTitle}}</h2>
  </header>

  <div class="evq-comp__body">
    {{#if this.isDynamicAssessment}}
      <div class="evq-comp__da">
        <span class="evq-comp__trial-counter" aria-live="polite">
          {{t "Item %{n} of %{total}" key="comp_da_counter" n=this.daItemNumber total=this.daItemTotal}}
        </span>
        <div class="evq-comp__da-card">
          <span class="evq-comp__da-target">{{this.currentItemSpec.target}}</span>
          <p class="evq-comp__da-prompt">{{this.currentItemSpec.prompt}}</p>
        </div>
        <div class="evq-comp__da-level" role="status" aria-live="polite">
          <span class="evq-comp__da-level-label">{{t "Current prompt level" key="comp_da_current_level"}}</span>
          <strong class="evq-comp__da-level-value">{{this.currentLevel.label}}</strong>
          <span class="evq-comp__da-level-index">
            {{t "Level %{n} of 6" key="comp_da_level_index" n=this.currentLevel.index}}
          </span>
        </div>
        <ol class="evq-comp__da-ladder" aria-hidden="true">
          {{#each this.promptLevels as |lvl|}}
            <li class="evq-comp__da-rung {{if (is-equal lvl.id this.currentLevel.id) "is-active"}}">
              <span class="evq-comp__da-rung-num">{{lvl.index}}</span>
              <span class="evq-comp__da-rung-label">{{lvl.label}}</span>
            </li>
          {{/each}}
        </ol>
        <div class="evq-comp__da-actions">
          <button type="button" class="evq-btn evq-btn--ghost" {{on "click" (this.ctrlAction "daFailed")}}>
            {{t "Did not respond" key="comp_da_failed"}}
          </button>
          <button type="button" class="evq-btn evq-btn--primary" {{on "click" (this.ctrlAction "daSucceeded")}}>
            {{t "Responded at this level" key="comp_da_succeeded"}}
          </button>
        </div>
        <button type="button" class="evq-btn evq-btn--ghost evq-comp__skip-link" {{on "click" (this.ctrlAction "skipSubtest")}}>
          {{t "Skip this subtest" key="comp_skip_subtest"}}
        </button>
      </div>
    {{/if}}

    {{#if this.isLiteracyProbe}}
      <div class="evq-comp__literacy">
        <span class="evq-comp__trial-counter" aria-live="polite">
          {{t "Item %{n} of %{total}" key="comp_lit_counter" n=this.literacyTrialNumber total=this.literacyTrialTotal}}
        </span>
        <div class="evq-comp__lit-card">
          <span class="evq-comp__lit-word">{{this.currentLiteracyItem.word}}</span>
          <p class="evq-comp__lit-prompt">{{this.currentLiteracyItem.prompt}}</p>
        </div>
        <div class="evq-comp__da-actions">
          <button type="button" class="evq-btn evq-btn--ghost" {{on "click" (this.ctrlAction "literacyIncorrect")}}>
            {{t "Did not match" key="comp_lit_incorrect"}}
          </button>
          <button type="button" class="evq-btn evq-btn--primary" {{on "click" (this.ctrlAction "literacyCorrect")}}>
            {{t "Matched correctly" key="comp_lit_correct"}}
          </button>
        </div>
        <button type="button" class="evq-btn evq-btn--ghost evq-comp__skip-link" {{on "click" (this.ctrlAction "skipSubtest")}}>
          {{t "Skip this subtest" key="comp_skip_subtest"}}
        </button>
      </div>
    {{/if}}

    {{#if this.isSettForm}}
      <div class="evq-comp__sett">
        <p class="evq-comp__sett-intro">
          {{t "Capture the SETT framework alongside this evaluation — Student, Environment, Task. These notes attach to the saved eval and feed the AI-narrated SLP report." key="comp_sett_intro"}}
        </p>
        <div class="evq-comp__sett-field">
          <label class="evq-comp__sett-label" for="evq-sett-student">{{t "Student" key="comp_sett_student"}}</label>
          <textarea id="evq-sett-student" class="evq-comp__sett-input" rows="3" placeholder={{t "Strengths, needs, communication history, current AAC use…" key="comp_sett_student_placeholder"}} {{on "keyup" (this.ctrlActionEventValueBound "settChange" "student" "value")}}>{{this.session.sett.student}}</textarea>
        </div>
        <div class="evq-comp__sett-field">
          <label class="evq-comp__sett-label" for="evq-sett-environment">{{t "Environment" key="comp_sett_environment"}}</label>
          <textarea id="evq-sett-environment" class="evq-comp__sett-input" rows="3" placeholder={{t "Classrooms, home, community partners, supports, barriers…" key="comp_sett_environment_placeholder"}} {{on "keyup" (this.ctrlActionEventValueBound "settChange" "environment" "value")}}>{{this.session.sett.environment}}</textarea>
        </div>
        <div class="evq-comp__sett-field">
          <label class="evq-comp__sett-label" for="evq-sett-task">{{t "Task" key="comp_sett_task"}}</label>
          <textarea id="evq-sett-task" class="evq-comp__sett-input" rows="3" placeholder={{t "What does the student need to do? Curriculum, social, daily living tasks…" key="comp_sett_task_placeholder"}} {{on "keyup" (this.ctrlActionEventValueBound "settChange" "task" "value")}}>{{this.session.sett.task}}</textarea>
        </div>
        <div class="evq-comp__da-actions">
          <button type="button" class="evq-btn evq-btn--primary" {{on "click" (this.ctrlAction "settNext")}}>
            {{t "Save SETT and continue" key="comp_sett_save"}}
          </button>
        </div>
        <button type="button" class="evq-btn evq-btn--ghost evq-comp__skip-link" {{on "click" (this.ctrlAction "skipSubtest")}}>
          {{t "Skip this subtest" key="comp_skip_subtest"}}
        </button>
      </div>
    {{/if}}

    {{#if this.isAiNarration}}
      <div class="evq-comp__ai">
        {{#if this.aiFlagEnabled}}
          <p class="evq-comp__ai-intro">
            {{t "Generate a draft SLP narrative from the evaluation data. The AI summarizes the recommendation, dynamic-assessment results, and SETT framework into IEP-ready prose — you review and edit before saving." key="comp_ai_intro"}}
          </p>
          {{#if this.aiNarrative}}
            <textarea class="evq-comp__ai-textarea" rows="14" {{on "keyup" (this.ctrlActionEventValue "editAiNarrative" "value")}}>{{this.aiNarrative}}</textarea>
          {{else}}
            <div class="evq-comp__ai-empty">
              <p>{{t "No narrative drafted yet. Click below to generate." key="comp_ai_empty_state"}}</p>
            </div>
          {{/if}}
          {{#if this.aiError}}
            <p class="evq-comp__ai-error" role="alert">{{this.aiError}}</p>
          {{/if}}
          <div class="evq-comp__da-actions">
            <button type="button" class="evq-btn evq-btn--ghost" {{on "click" (this.ctrlAction "generateAiNarrative")}} disabled={{this.aiBusy}}>
              {{#if this.aiBusy}}
                {{t "Generating…" key="comp_ai_busy"}}
              {{else}}
                {{#if this.aiNarrative}}
                  {{t "Regenerate" key="comp_ai_regenerate"}}
                {{else}}
                  {{t "Generate narrative" key="comp_ai_generate"}}
                {{/if}}
              {{/if}}
            </button>
            <button type="button" class="evq-btn evq-btn--primary" {{on "click" (this.ctrlAction "aiNext")}}>
              {{t "Continue" key="comp_ai_continue"}}
            </button>
          </div>
        {{else}}
          <div class="evq-comp__placeholder">
            <p>{{t "AI-drafted SLP narrative is gated by the comprehensive_eval_ai feature flag. Ask your org admin to enable it." key="comp_ai_flag_off"}}</p>
            <button type="button" class="evq-btn evq-btn--ghost" {{on "click" (this.ctrlAction "skipSubtest")}}>{{t "Skip" key="skip"}}</button>
          </div>
        {{/if}}
      </div>
    {{/if}}

    {{#if this.isWrap}}
      <div class="evq-comp__wrap">
        <p>{{t "Comprehensive evaluation complete. Open the report to see the full feature-match recommendation." key="comp_wrap_body"}}</p>
        <button type="button" class="evq-btn evq-btn--primary" {{on "click" (this.ctrlAction "finishComprehensive")}}>
          {{t "Open report" key="comp_wrap_open_report"}}
        </button>
      </div>
    {{/if}}
  </div>
</section>
