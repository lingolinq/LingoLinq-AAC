<li class="recursive-board__item {{if @board.selected "selected"}}">
  <div class="recursive-board__row">
    {{#if @selectable}}
      <input type="checkbox" checked={{@board.selected}} disabled={{@board.disabled}} class="recursive-board__check" aria-label={{@board.key}} {{on "change" (set-field @board "selected" "checkbox")}}/>
    {{/if}}
    {{!-- Indent the CONTENT (not the checkbox) by depth, so every checkbox
         stays in one left-aligned column while the labels show hierarchy. --}}
    <div class="recursive-board__content" style={{safe-style (concat "padding-left:calc(" @depth " * 22px)")}}>
      {{#if @board.children}}
        <a href="#" class="recursive-board__toggle" {{on "click" (fn @toggleBoardHierarchy @board.id)}} aria-label={{if @board.open (t "Collapse" key="collapse") (t "Expand" key="expand")}}>
          <svg class="recursive-board__chevron {{if @board.open "recursive-board__chevron--open"}}" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      {{else}}
        <span class="recursive-board__toggle recursive-board__toggle--leaf" aria-hidden="true"></span>
      {{/if}}
      {{#if @board.already_linked}}
        <i class="recursive-board__label">{{@board.key}}</i>
      {{else}}
        <span class="recursive-board__label">{{@board.key}}</span>
      {{/if}}
    </div>
  </div>
  {{#if @board.children}}
    {{#if @board.open}}
      <ul>
        {{#each @board.children as |childBoard|}}
          <RecursiveBoard @board={{childBoard}} @depth={{this.childDepth}} @selectable={{@selectable}} @toggleBoardHierarchy={{@toggleBoardHierarchy}} />
        {{/each}}
      </ul>
    {{/if}}
  {{/if}}
</li>
