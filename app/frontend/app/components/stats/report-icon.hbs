{{! Icon set for the Reports summary. The glyphs are the ones already used on
    this page (the chat bubble, clock and calendar from the stats panels and the
    reports hero), kept in one place so the summary markup stays declarative and
    each metric/insight can just name its icon. Always decorative — every caller
    marks the wrapper aria-hidden and carries the meaning in text. }}
{{#if (is-equal @name "utterances")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.6-4.9A8.5 8.5 0 1 1 21 11.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="8.5" cy="11.5" r="1.05" fill="currentColor"/><circle cx="12" cy="11.5" r="1.05" fill="currentColor"/><circle cx="15.5" cy="11.5" r="1.05" fill="currentColor"/></svg>
{{else if (is-equal @name "message-length")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M20 4H4a1.5 1.5 0 0 0-1.5 1.5v9A1.5 1.5 0 0 0 4 16h3v3.5L11.5 16H20a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 20 4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M6.5 8.5h11M6.5 12h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
{{else if (is-equal @name "sessions")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7.5V12l3 1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{{else if (is-equal @name "words")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M4 6.5h11M4 12h16M4 17.5h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
{{else if (is-equal @name "buttons")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8"/></svg>
{{else if (is-equal @name "rate")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M4 17.5a8.5 8.5 0 1 1 16 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 17.5 16 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="17.5" r="1.4" fill="currentColor"/></svg>
{{else if (is-equal @name "calendar")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 9.5h17" stroke="currentColor" stroke-width="1.8"/><path d="M8 3v3.5M16 3v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
{{else if (is-equal @name "consistency")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="m8 12.3 2.6 2.7L16 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{{else if (is-equal @name "trend-up")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M3.5 17.5 10 11l3.5 3.5L20.5 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M15.5 7.5h5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{{else if (is-equal @name "trend-down")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M3.5 6.5 10 13l3.5-3.5L20.5 16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.5 11.5v5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{{else if (is-equal @name "activity")}}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M22 12h-4l-3 9-6-18-3 9H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{{else}}
  {{! Fallback is the DIRECTIONLESS activity pulse on purpose: an unrecognised
      icon name must never assert a rise or a fall it can't vouch for. }}
  <svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M22 12h-4l-3 9-6-18-3 9H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{{/if}}
