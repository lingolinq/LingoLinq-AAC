<div class="md-stats-filter {{this.elem_class}}" style={{this.elem_style}}>
  {{#if this.usage_stats}}
    <form class="md-stats-filter__form form-inline" style={{this.inner_elem_style}}>
      {{#unless this.side_by_side}}
        <div class="md-stats-filter__period-bar">
          <div class="md-stats-filter__row md-stats-filter__row--period-actions md-stats-filter__row--stacked">
            {{!-- One inline row: label, period select, compare action. The colon
                  is punctuation only, so it is aria-hidden and the label the
                  select points at stays the plain words. --}}
            <div class="md-stats-filter__period-stack">
              <span id="report-period-filter-label" class="md-stats-filter__period-title">{{t "Report period" key="report_period"}}<span aria-hidden="true">:</span></span>
              <div class="md-stats-filter__period-controls">
                <div class="form-group md-stats-filter__period-wrap">
                  <Stats::PeriodSelect @content={{this.filter_list}} @selection={{this.usage_stats.filter}} @action={{this.ctrlAction "onPeriodChange"}} @excludeSelectedFromList={{this.side_by_side}} @labelId="report-period-filter-label" />
                </div>
                {{#if this.usage_stats.custom_filter}}
                  {{#unless this.customFilterPendingApply}}
                    <button type="button" {{on "click" (this.ctrlAction "compare_to")}} class="md-btn md-btn--ghost md-stats-filter__compare">{{t "Compare with another period" key="compare_with_another_period"}}</button>
                  {{/unless}}
                {{else}}
                  <button type="button" {{on "click" (this.ctrlAction "compare_to")}} class="md-btn md-btn--ghost md-stats-filter__compare">{{t "Compare with another period" key="compare_with_another_period"}}</button>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
      {{else}}
        <div class="md-stats-filter__row md-stats-filter__row--period-actions">
          <button type="button" {{on "click" (this.ctrlAction "clear_side")}} class="md-btn md-btn--ghost md-stats-filter__clear" aria-label={{t "Remove this period" key="hide_this_side"}}><span class="md-stats-filter__clear-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md-stats-filter__clear-svg"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg></span><span class="md-stats-filter__clear-label">{{if this.right_side (t "Period 2" key="period_2") (t "Period 1" key="period_1")}}</span></button>
          <div class="form-group md-stats-filter__period-wrap">
            <Stats::PeriodSelect @content={{this.filter_list}} @selection={{this.usage_stats.filter}} @action={{this.ctrlAction "onPeriodChange"}} @excludeSelectedFromList={{this.side_by_side}} />
          </div>
        </div>
      {{/unless}}
      {{#if this.usage_stats.custom_filter}}
        {{#if this.usage_stats.device_id}}
          <div class="form-group">
            <button type="button" {{on "click" (this.ctrlAction "update_filter" "device")}} class="btn btn-default md-stats-filter__chip">
              {{this.usage_stats.device_name}}
              <span class="glyphicon glyphicon-remove"></span>
            </button>
          </div>
        {{/if}}
        {{#if this.usage_stats.location_id}}
          <div class="form-group">
            <button type="button" {{on "click" (this.ctrlAction "update_filter" "location")}} class="btn btn-default md-stats-filter__chip">
              {{this.usage_stats.location_name}}
              <span class="glyphicon glyphicon-remove"></span>
            </button>
          </div>
        {{/if}}
        <span class="md-stats-filter__dates">
        <div class="form-group">
          <input type="date" value={{this.usage_stats.start_date_field}} class="form-control" aria-label={{t "Start date" key="start_date"}} {{on "input" (set-field this "usage_stats.start_date_field")}} />
        </div>
          <span class="md-stats-filter__to">{{t "to" key="to"}}</span>
        <div class="form-group">
          <input type="date" value={{this.usage_stats.end_date_field}} class="form-control" aria-label={{t "End date" key="end_date"}} {{on "input" (set-field this "usage_stats.end_date_field")}} />
        </div>
        </span>
        <button type="button" {{on "click" (this.ctrlAction "applyCustomFilter")}} class="md-btn md-btn--primary md-stats-filter__apply">{{t "Apply" key="apply_report"}}</button>
      {{else if this.usage_stats.show_filtered_snapshot}}
        <span class="text-muted">
          {{#if this.usage_stats.device_id}}
            <div class="form-group well md-stats-filter__well">
              {{this.usage_stats.device_name}}
            </div>
          {{/if}}
          {{#if this.usage_stats.location_id}}
            <div class="form-group well md-stats-filter__well">
              {{this.usage_stats.location_name}}
            </div>
          {{/if}}
          <span class="md-stats-filter__dates">
          <div class="form-group well md-stats-filter__well">
            {{this.usage_stats.start_date_field}}
          </div>
            <span class="md-stats-filter__to">{{t "to" key="to"}}</span>
          <div class="form-group well md-stats-filter__well">
            {{this.usage_stats.end_date_field}}
          </div>
          </span>
        </span>
      {{/if}}
    </form>
    {{#if (and this.side_by_side this.status this.status.no_data)}}
      <p class="md-stats-load-status__no-data">{{t "No data available" key="no_data_available"}}</p>
    {{/if}}
  {{/if}}
</div>
