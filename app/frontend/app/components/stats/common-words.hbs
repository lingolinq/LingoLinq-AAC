<div class={{this.elem_class}} style={{this.elem_style}}>
  {{! Inner card so the column's own padding stays as the gutter between charts. }}
  <div class="report-chart-card">
    <div class="report-chart-card__head">
      <h3 class="report-chart-card__title">
        {{#if this.usage_stats.modeling}}<span class='glyphicon glyphicon-hand-up' aria-hidden="true"></span>{{/if}}
        {{t "Most common words" key="most_common_words"}}
      </h3>
      <button type="button" class="md-link-btn report-chart-card__action" {{on "click" (this.ctrlAction "word_cloud")}}>{{t "word cloud" key="word_cloud_lower"}}</button>
    </div>

    <div class="report-chart-card__body report-chart-card__body--scroll">
      <table class="report-chart-table">
        <caption class="sr-only">{{t "Most common words" key="most_common_words"}}</caption>
        <thead>
          <tr>
            <th scope="col">{{t "Word" key="word_column"}}</th>
            <th scope="col">{{t "Uses" key="uses"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#if this.usage_stats.popular_words}}
            {{#each this.usage_stats.popular_words as |word|}}
              <tr>
                <th scope="row"><button type="button" class="report-chart-table__link" {{on "click" (this.ctrlAction "word_data" word.text)}}>{{word.text}}</button></th>
                <td>{{word.count}}</td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="2" class="report-chart-card__empty">{{t "No data available" key="no_data"}}</td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>
