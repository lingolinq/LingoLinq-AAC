{{!-- Supervisor entry overlay — see components/board-picker-options.js for why
     this is not the create-board chooser and must not look like it. --}}
<div class="bp-options__panel">
  <button type="button" class="bp-options__close" {{on "click" this.onClose}} aria-label={{t "Close" key="close"}} title={{t "Close" key="close"}}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  {{!-- Eyebrow: names the task in one glance. Half of what keeps this overlay
       from reading as "create a board". --}}
  <span class="bp-options__eyebrow">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg>
    {{t "Home board setup" key="board_picker_options_eyebrow"}}
  </span>
  {{!-- Same string as the page h1 (board_picker_header_possessive) so the
       overlay and the page behind it name the same task. --}}
  <h2 id="bp-options-title" class="bp-options__title">{{t "Choose %{name}'s home board" key="board_picker_header_possessive" name=this.name}}</h2>
  <p class="bp-options__subtitle">{{t "Select a board to use as the communicator's starting board." key="board_picker_subtitle"}}</p>
  <div class="bp-options__separator" aria-hidden="true"></div>
  <div class="bp-options__list">
    <button type="button" class="bp-options__btn bp-options__btn--browse" {{on "click" this.onBrowse}}>
      <span class="bp-options__btn-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      </span>
      <span class="bp-options__btn-label">{{t "Browse Board Categories" key="board_picker_option_browse"}}</span>
    </button>
    <span class="bp-options__or" aria-hidden="true"><span class="bp-options__or-text">{{t "OR" key="or_separator_caps"}}</span></span>
    {{!-- One-click assignment. Disabled while the copy + save is in flight, and
         the label says so — the work is a board copy, not an instant write.
         `aria-busy` carries that state to assistive tech, which the visual
         animation cannot. --}}
    <button type="button" class="bp-options__btn bp-options__btn--quick" disabled={{this.assigning}} aria-busy={{if this.assigning "true" "false"}} {{on "click" this.onQuickAssign}}>
      <span class="bp-options__btn-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 2 4 14 11 14 10 22 20 9 13 9 13 2"/></svg>
      </span>
      <span class="bp-options__btn-label">
        {{#if this.assigning}}
          {{!-- Word and dots are separate elements so the dots can animate in
               sequence: a static "…" reads as a frozen UI on a copy that runs
               for minutes. The dots are decorative — aria-hidden keeps a screen
               reader from announcing three empty spans, and the note below is
               what actually reports progress. --}}
          {{t "Assigning" key="assigning_home_board"}}<span class="bp-options__dots" aria-hidden="true"><span class="bp-options__dot"></span><span class="bp-options__dot"></span><span class="bp-options__dot"></span></span>
        {{else}}
          {{t "Quick Assign Vocal Flair 84" key="board_picker_option_quick_assign"}}
        {{/if}}
      </span>
    </button>
    {{#if this.assigning}}
      {{!-- Sets expectations for a job that copies a ~98-board set. `role=status`
           announces it once, politely, without stealing focus. --}}
      <p class="bp-options__progress-note" role="status">{{t "Copying the board set to their account. This can take a few minutes — please keep this page open." key="board_picker_quick_assign_progress"}}</p>
    {{/if}}
    <span class="bp-options__or" aria-hidden="true"><span class="bp-options__or-text">{{t "OR" key="or_separator_caps"}}</span></span>
    <button type="button" class="bp-options__btn bp-options__btn--create" {{on "click" this.onCreate}}>
      <span class="bp-options__btn-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2.5"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      </span>
      <span class="bp-options__btn-label">{{t "Create New Board" key="board_picker_option_create"}}</span>
    </button>
  </div>
</div>
