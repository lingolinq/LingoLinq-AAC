{{#if this.display_name}}
  {{!-- The anchor is a zero-height positioned wrapper: it gives the absolutely
       positioned pill a containing block INSIDE the scrolling #content, so the
       pill scrolls away with the page instead of following the reader down it.
       It occupies no space, so nothing around it moves. --}}
  <div class="ll-supervising-pill-anchor">
    {{!-- role="status" + aria-live="polite" announces the change of context on
         arrival without stealing focus. The dot is decorative — the meaning is
         carried by the message text. Nothing here is focusable or interactive. --}}
    <div class="ll-supervising-pill" role="status" aria-live="polite">
      <span class="ll-supervising-pill__status" aria-hidden="true">
        <span class="ll-supervising-pill__status-dot"></span>
      </span>
      <span class="ll-supervising-pill__text">{{t "Viewing %{name}" key="supervising_context_viewing_name" name=this.display_name}}</span>
    </div>
  </div>
{{/if}}
