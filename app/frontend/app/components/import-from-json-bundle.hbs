<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Import Board from Another Platform" key="import_board_from_json_bundle"}}</h3>
  </div>
  <div class="modal-body md-modal-body">
    <section class="md-json-bundle-export" aria-labelledby="coughdrop-export-heading">
      <h4 id="coughdrop-export-heading" class="md-json-bundle-export__title">{{t "Moving from CoughDrop?" key="coughdrop_export_heading"}}</h4>
      <p class="md-json-bundle-export__lead">{{t "Use this one-time bookmark to export your boards from CoughDrop." key="coughdrop_export_intro"}}</p>

      <div class="md-json-bundle-export__drag">
        <p class="md-json-bundle-export__drag-label">{{t "Step 1: Drag this button to your bookmarks bar" key="coughdrop_export_step_drag"}}</p>
        <div class="md-json-bundle-export__actions">
          <a href={{this.coughdropExportBookmarkletHref}}
             class="btn btn-default md-json-bundle-export__bookmarklet"
             draggable="true"
             {{on "click" (this.ctrlAction "preventBookmarkletClick")}}
             {{on "dragstart" (this.ctrlAction "dragBookmarklet")}}>
            {{t "Export CoughDrop boards" key="coughdrop_export_bookmarklet_label"}}
          </a>
        </div>
        <p class="help-block md-json-bundle-export__help md-json-bundle-export__help--drag">{{t "Do not click it on this page. Drag it to your bookmarks bar, then use it on CoughDrop." key="coughdrop_export_drag_help"}}</p>
        <div class="md-json-bundle-export__alt-links">
          <button type="button" class="btn btn-link md-json-bundle-export__copy" {{on "click" (this.ctrlAction "openBookmarkletInstaller")}}>
            {{t "Open bookmark setup page" key="coughdrop_export_open_installer"}}
          </button>
          <span class="md-json-bundle-export__alt-sep" aria-hidden="true">·</span>
          <button type="button" class="btn btn-link md-json-bundle-export__copy" {{on "click" (this.ctrlAction "copyCoughdropExportBookmarklet")}}>
            {{t "Copy bookmark link instead" key="coughdrop_export_copy_link"}}
          </button>
        </div>
      </div>

      <ol class="md-json-bundle-export__steps" start="2">
        <li>{{t "Log in to CoughDrop and open the board you want to move." key="coughdrop_export_step_open"}}</li>
        <li>{{t "Click your bookmark and wait for the export file to download." key="coughdrop_export_step_run"}}</li>
        <li>{{t "Upload that file below." key="coughdrop_export_step_import"}}</li>
      </ol>
      <p class="help-block md-json-bundle-export__help">{{t "If you paste the bookmark link manually, remove any unsafe: prefix some browsers add." key="coughdrop_export_unsafe_prefix_help"}}</p>
    </section>

    <hr class="md-json-bundle-export__divider" aria-hidden="true">

    <section aria-labelledby="json-bundle-import-heading">
      <h4 id="json-bundle-import-heading" class="md-json-bundle-export__title">{{t "Upload your file" key="json_bundle_import_heading"}}</h4>
      <p>{{t "Choose the export file you downloaded from CoughDrop or LingoLinq." key="import_json_bundle_instructions"}}</p>
      <div class="form-group">
        <label for="import_json_bundle_file">{{t "Board export file" key="json_bundle_file"}}</label>
        <input type="file" accept=".json,application/json" class="form-control" id="import_json_bundle_file" {{on "change" (this.ctrlAction "fileSelected")}} />
        {{#if this.fileName}}
          <p class="help-block">{{this.fileName}}</p>
        {{/if}}
      </div>
    </section>
    {{#if this.status.error}}
      <div class="alert alert-danger">{{this.status.error}}</div>
    {{/if}}
  </div>
  <div class="modal-footer md-modal-footer">
    <button {{on "click" (this.ctrlAction "close")}} class="btn btn-default">{{t "Cancel" key="cancel"}}</button>
    <button {{on "click" (this.ctrlAction "importFromJsonBundle")}} class="btn btn-primary" disabled={{this.status.saving}}>
      {{#if this.status.saving}}
        {{t "Importing..." key="importing"}}
      {{else}}
        {{t "Import" key="import"}}
      {{/if}}
    </button>
  </div>
</ModalDialog>
