<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Current AAC Solution - %{un}" un=this.model.user.user_name key="current_aac_device"}}</h3>
  </div>
  <div class="modal-body md-modal-body">
    <form {{on "submit" (this.ctrlAction "nothing")}}>
      <p class="md-modal-hint">{{t "Every communicator should use the solution that works best for them -- and %app_name% can help whether they're using the app or something else. Select the user's current primary AAC solution and access method to help keep everything up-to-date and accurate." key="select_device_pref"}}</p>

      <div class="md-modal-field">
        <span class="md-modal-label">{{t "Primary Solution" key="primary_system"}}</span>
        <div class="md-modal-segment" role="group" aria-label={{t "Primary Solution" key="primary_system"}}>
          <button type="button" class="md-modal-segment__option {{if this.default_system 'md-modal-segment__option--active'}}" {{on "click" (this.ctrlAction "set_system" "default")}}>
            {{t "%app_name%" key="app_name"}}
          </button>
          <button type="button" class="md-modal-segment__option {{if this.other_system 'md-modal-segment__option--active'}}" {{on "click" (this.ctrlAction "set_system" "other")}}>
            {{t "Something Else" key="something_else"}}
          </button>
        </div>
      </div>

      {{#if this.default_system}}
        <p class="md-modal-hint">{{t "All other settings are controlled from the user's Settings page" key="other_settings_on_preferences"}}</p>
        {{#if this.model.user.preferences.home_board}}
          <div class="md-modal-field">
            <span class="md-modal-label">{{t "Current Home Board:" key="current_home_board_upper"}}</span>
            <p class="md-modal-value">{{this.model.user.preferences.home_board.key}}</p>
            <button type="button" class="md-modal-btn md-modal-btn--secondary" {{on "click" (this.ctrlAction "clear_home_board")}}>{{t "Clear Home Board" key="clear_home_board"}}</button>
          </div>
        {{/if}}
      {{else}}
        <div class="md-modal-field">
          <label class="md-modal-label" for="device_type">{{t "App/Device" key="app_device"}}</label>
          <input value={{this.external_device}} class="md-modal-input" id="device_type" list="ext_device_options" placeholder="third-party app or device name" autocomplete="off" {{on "input" (set-field this "external_device")}} />
          <datalist id="ext_device_options">
            {{#each this.device_options as |opt|}}<option value={{opt.name}}></option>{{/each}}
          </datalist>
        </div>
        {{#if this.external_device}}
          <div class="md-modal-field">
            <label class="md-modal-label" for="vocabulary_type">{{t "Vocabulary" key="vocabulary"}}</label>
            <input value={{this.external_vocab}} class="md-modal-input" id="vocabulary_type" list="ext_vocab_options" placeholder="vocabulary used" autocomplete="off" {{on "change" (this.ctrlAction "vocab_changed")}} {{on "input" (set-field this "external_vocab")}} />
            <datalist id="ext_vocab_options">
              {{#each this.vocab_options as |opt|}}<option value={{opt.name}}></option>{{/each}}
            </datalist>
          </div>
          <div class="md-modal-field">
            <label class="md-modal-label" for="vocab_size">{{t "Vocab Size" key="vocab_size"}}</label>
            <input type="number" value={{this.external_vocab_size}} class="md-modal-input" id="vocab_size" placeholder="typical buttons per board" {{on "input" (set-field this "external_vocab_size")}} />
            <p class="md-modal-hint">{{t "average buttons per board" key="average_buttons_per_view"}}</p>
          </div>
        {{/if}}
        <div class="md-modal-field">
          <label class="md-modal-label" for="external_access_method">{{t "Access Method" key="access_method"}}</label>
          {{bound-select select_class="md-modal-select" select_id="external_access_method" content=this.access_methods selection=this.external_access_method action=(mut this.external_access_method) }}
        </div>
      {{/if}}
    </form>
  </div>
  <div class="modal-footer md-modal-footer">
    <button type="button" class="md-modal-btn md-modal-btn--cancel" {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
    <button type="button" class="md-modal-btn md-modal-btn--primary" disabled={{this.status.loading}} {{on "click" (this.ctrlAction "update")}}>
      {{#if this.status.loading}}
        {{t "Updating User..." key="updating_user"}}
      {{else if this.status.error}}
        {{t "Error Updating User" key="error_updating_user"}}
      {{else}}
        {{t "Update User" key="update_user"}}
      {{/if}}
    </button>
  </div>
</ModalDialog>
