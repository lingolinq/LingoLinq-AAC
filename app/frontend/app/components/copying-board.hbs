<ModalDialog @action={{this.onClose}} @backdropAction={{this.onBackdropClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Copy Board" key="copy_board"}}</h3>
  </div>
  <div class="modal-body md-modal-body">
    {{#if this.error}}
      <p class="text-danger">{{this.error}}</p>
      {{#if this.isTimeoutError}}
        <p>{{t "The board hierarchy is still being generated in the background. You can wait a moment and try again, or copy all boards now." key="hierarchy_timeout_help"}}</p>
        <button class='btn btn-primary' {{on "click" (this.ctrlAction "copy_all")}}>{{t "Copy All Boards (Fast)" key="copy_all_boards_fast"}}</button>
      {{else if this.hierarchyLoadFailed}}
        <p>{{t "The linked board list could not be loaded. You can close and try again, or copy all linked boards now to preserve the full board set." key="copy_hierarchy_load_failed_help"}}</p>
        <button class='btn btn-primary' {{on "click" (this.ctrlAction "copy_all")}}>{{t "Copy All Boards" key="copy_all_boards"}}</button>
      {{/if}}
    {{else if this.loading}}
      {{!-- Modern CSS spinner (md-loading-spinner) centered above the
           label so the "we're working" signal is unmistakable. The
           prior bare "Loading…" string looked like a stuck modal. --}}
      <div class="md-copying-board-loading">
        <div class="md-loading-spinner" aria-hidden="true"></div>
        <p class="md-copying-board-loading__label">{{t "Loading..." key="loading"}}</p>
      </div>
    {{else if this.hierarchy}}
      <p class="md-modal-hint">{{t "All linked boards will be copied. Open the list below only if you want to leave some out." key="copy_all_default_hint"}}</p>
      <div class="md-modal-expander {{if this.show_board_picker "md-modal-expander--open"}}">
        <button type="button" class="md-modal-expander__toggle" aria-expanded={{if this.show_board_picker "true" "false"}} {{on "click" (this.ctrlAction "toggle_board_picker")}}>
          <svg class="md-modal-expander__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          <span>{{t "Choose which boards to copy" key="choose_which_boards"}}</span>
        </button>
        {{#if this.show_board_picker}}
          <div class="md-modal-expander__body">
            <BoardHierarchy @selectable={{true}} @hierarchy={{this.hierarchy}} />
          </div>
        {{/if}}
      </div>
    {{else}}
      {{!-- In-progress copy state — same spinner pattern as the
           hierarchy-loading branch above, replacing the legacy
           spinner.gif so visuals stay coherent across modal states. --}}
      <div class="md-copying-board-loading">
        <div class="md-loading-spinner" aria-hidden="true"></div>
        <p class="md-copying-board-loading__label">{{t "Copying the board <strong>%{board_key}</strong>, this could take a few minutes..." key="copying_the_board" board_key=this.model.board.key}}</p>
        {{!-- Determinate ONLY once the server reports a figure. A board copy runs in two
              phases and only the second is measured (edit_manager#copy_board), so
              `copy_percent` is null for the first one and the bar sweeps instead of sitting
              at a made-up 0%. progressbar role carries the same distinction to assistive
              tech: aria-valuenow is omitted entirely when there is no measurement. --}}
        <div class="ll-copy-meter {{if this.copy_percent 'll-copy-meter--determinate'}}"
             role="progressbar" aria-valuemin="0" aria-valuemax="100"
             aria-valuenow={{this.copy_percent}}
             aria-valuetext={{if this.copy_percent (concat this.copy_percent "%") (t "Copying, progress not yet measurable" key="copy_progress_indeterminate")}}>
          <div class="ll-copy-meter__fill" style={{safe-style (concat "width:" (or this.copy_percent 0) "%")}}></div>
        </div>
        {{#if this.copy_percent}}
          <p class="ll-copy-meter__value">{{this.copy_percent}}%</p>
        {{/if}}
      </div>
    {{/if}}
  </div>
  <div class="modal-footer md-modal-footer">
    {{#if this.hierarchy}}
      <button type="button" class="btn md-modal-btn md-modal-btn--cancel" {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
      {{#if this.hierarchyRootOnlyWarning}}
        <button type="button" class="btn md-modal-btn md-modal-btn--secondary" {{on "click" (this.ctrlAction "copy_all")}}>{{t "Copy All Boards" key="copy_all_boards"}}</button>
      {{/if}}
      <button type="button" class="btn md-modal-btn md-modal-btn--primary" {{on "click" (this.ctrlAction "start_copying")}} disabled={{this.hierarchy.root_deselected}}>{{t "Copy Selected Boards" key="copy_selected_boards"}}</button>
    {{else}}
      <a href="#" class="btn md-modal-btn md-modal-btn--cancel" {{on "click" (this.ctrlAction "close")}}>{{t "Close" key="close"}}</a>
    {{/if}}
  </div>
</ModalDialog>
