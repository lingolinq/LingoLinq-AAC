<div class="bound-select {{if this.isOpen "bound-select--open"}} {{if this.short "bound-select--short"}} {{if this._flipped "bound-select--up"}} {{if this.isGrid "bound-select--grid"}} {{this.gridColsClass}} {{this.select_class}}">
  <button
    id={{this.select_id}}
    type="button"
    class="bound-select__trigger"
    aria-haspopup="listbox"
    aria-expanded={{this.isOpen}}
    {{on "click" (this.ctrlAction "toggle")}}
  >
    <span class="bound-select__trigger-text {{if this.showPlaceholder "bound-select__trigger-text--placeholder"}}">{{this.triggerLabel}}</span>
  </button>
  {{#if this.isOpen}}
    <ul class="bound-select__list" role="listbox" {{on "click" (this.ctrlAction "stopPropagation")}} {{on "keydown" this.onListKeydown}}>
      {{#if this.searchable}}
        <li class="bound-select__search" role="presentation">
          <input type="text" value={{this.searchQuery}} class="bound-select__search-input" placeholder={{this.search_placeholder}} aria-label={{this.search_placeholder}} {{on "keydown" this.onSearchKeydown}} {{on "input" (set-field this "searchQuery")}} />
        </li>
      {{/if}}
      {{#if this.scroll_buttons}}
        {{!-- Chrome, not choices: role="presentation" keeps a screen reader walking the
              listbox from announcing these as two extra options. Same treatment as the
              search row above. --}}
        <li class="bound-select__scroll bound-select__scroll--up" role="presentation">
          <button type="button" class="bound-select__scroll-btn" aria-label={{t "Scroll up" key="scroll_up"}} {{on "click" (this.ctrlActionNoBubble "scroll_list" "up")}}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
          </button>
        </li>
      {{/if}}
      {{#if this.renderContent.length}}
        {{#each this.renderContent as |item|}}
          {{#if item._isDivider}}
            <li class="bound-select__divider" role="presentation">{{item.label}}</li>
          {{else}}
            <li
              class="bound-select__option {{if (is-equal this.selection item.id) "bound-select__option--selected"}} {{if item.disabled "bound-select__option--disabled"}}"
              role="option"
              tabindex={{if item.disabled "-1" "0"}}
              aria-selected={{is-equal this.selection item.id}}
              aria-disabled={{if item.disabled "true" "false"}}
              {{on "click" (this.ctrlAction "choose" item)}}
              {{on "keydown" (this.ctrlAction "option_keydown" item)}}
            >
              {{item.name}}
            </li>
          {{/if}}
        {{/each}}
      {{else}}
        {{!-- Empty-state row — modern alternative to a blank dropdown.
             Shown when renderContent is empty (e.g. the user has no
             supervisees + no managed orgs, so the "For" picker on the
             assessment-settings modal has nothing to offer). --}}
        <li class="bound-select__empty" role="presentation">
          <span class="bound-select__empty-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </span>
          <span class="bound-select__empty-text">{{t "No options available" key="bound_select_no_options"}}</span>
        </li>
      {{/if}}
      {{#if this.scroll_buttons}}
        <li class="bound-select__scroll bound-select__scroll--down" role="presentation">
          <button type="button" class="bound-select__scroll-btn" aria-label={{t "Scroll down" key="scroll_down"}} {{on "click" (this.ctrlActionNoBubble "scroll_list" "down")}}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </li>
      {{/if}}
    </ul>
  {{/if}}
</div>
