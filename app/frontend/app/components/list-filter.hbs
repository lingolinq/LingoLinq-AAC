{{!-- A SEARCH BOX THAT FILTERS A LIST ON THE PAGE (2026-10-01): the caseload's filter, extracted so the
     Rooms page could have the same control rather than a copy of its markup. Template-only.
       @value        the current text
       @label        the accessible name (input and search landmark); say what is filtered, since the
                     app header's "Search Boards" field looks similar
       @placeholder  shown while empty
       @onInput      called with the input event, e.g. (set-field this "filterText")
       @onClear      called by the Clear button, shown while there is text
     Class names are the caseload's (`md-caseload__filter*`, _caseload.scss), which are unscoped, so
     the control looks the same wherever it is used. The Basic home page (`ch-filter`) and the board
     picker (`bp-search`) still carry their own copies; folding them in is a follow-up. --}}
<div class="md-caseload__filter" role="search" aria-label={{@label}}>
  <span class="md-caseload__filter-icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  </span>
  <input type="search" value={{@value}} class="md-caseload__filter-input" placeholder={{@placeholder}} aria-label={{@label}} autocomplete="off" {{on "input" @onInput}} />
  {{#if @value}}
    <button type="button" class="md-caseload__filter-clear" {{on "click" @onClear}} aria-label={{t "Clear filter" key="clear_filter"}} title={{t "Clear filter" key="clear_filter"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  {{/if}}
</div>
