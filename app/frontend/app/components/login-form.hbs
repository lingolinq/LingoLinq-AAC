  <div class="login-card">
  {{#if this.prompt}}
    <p>{{t "You may need to log in to access this information" key="login_needed"}}</p>
  {{/if}}
    {{#if this.showDeviceStep}}
      {{#if this.login_followup_already_long_token}}
        <div class="la-section-header">
          <div class="la-hero-title-wrap">
            <h2 class="la-hero-title">{{t "Approve This Device" key="approve_this_device"}}</h2>
          </div>
          <hr class="la-about-hero-separator" aria-hidden="true">
        </div>
        <p>{{t "Currently this device is set to log out after a short period of inactivity. Would you like to change this?" key="confirm_device_long_token_with_long_token"}}</p>
      {{else}}
        <div class="la-section-header">
          <div class="la-hero-title-wrap">
            <h2 class="la-hero-title">{{t "Activate New Device" key="activate_new_device"}}</h2>
          </div>
          <hr class="la-about-hero-separator" aria-hidden="true">
        </div>
        <p>{{t "It looks like you haven't logged in before on this device. How would you like to proceed?" key="confirm_device_long_token"}}</p>
      {{/if}}
      <div class="login-device-buttons">
        <button type="button" {{on "click" this.loginFollowupTrue}} class="login-btn login-btn--device">
          <span class="login-btn__title">{{t "Trust this Device" key="trust_this_device"}}</span>
          <span class="login-btn__sub">{{t "Keep me logged in" key="keep_me_logged_in"}}</span>
        </button>
        <button type="button" {{on "click" this.loginFollowupFalse}} class="login-btn login-btn--outline login-btn--device">
          <span class="login-btn__title">{{t "This is a Shared Device" key="not_trust_this_device"}}</span>
          <span class="login-btn__sub">{{t "Log me out after a period of inactivity" key="log_me_out_when_inactive"}}</span>
        </button>
      </div>
    {{else if this.login_single_assertion}}
      <div class="la-section-header">
        <div class="la-hero-title-wrap">
          <h2 class="la-hero-title">{{t "Approve This Device" key="approve_this_device"}}</h2>
        </div>
        <hr class="la-about-hero-separator" aria-hidden="true">
      </div>
      <p>{{t "This account is only allowed to log in to one dedicated device at a time. If you log in on this device it will force a log out on your other device. How would you like to proceed?" key="confirm_device_force_logout"}}</p>
      <button {{on "click" this.loginForceLogoutYes}} class='login-btn login-btn--outline' style='width: 100%;'><div style='font-size: 25px;'>{{t "Log In on this Device" key="log_in_on_this_device"}}</div>{{t "Any other device will be logged out" key="other_device_logged_out"}}</button>
      <button {{on "click" this.loginForceLogoutNo}} class='login-btn login-btn--outline' style='width: 100%; margin-top: 10px;'><div style='font-size: 25px;'>{{t "Never Mind, Don't Log In" key="do_not_log_in"}}</div>{{t "Keep me logged in on the other device" key="keep_logged_in"}}</button>
    {{else if this.showGoogleLinkStep}}
      {{#if this.googleLinkStepLoading}}
        <div class="la-section-header">
          <div class="la-hero-title-wrap">
            <h2 class="la-hero-title">{{t "Checking..." key="checking"}}</h2>
          </div>
          <hr class="la-about-hero-separator" aria-hidden="true">
        </div>
      {{else}}
      <div class="la-section-header">
        <div class="la-hero-title-wrap">
          <h2 class="la-hero-title">
            {{#if this.googleLinkAccountSelectMode}}
              {{t "Choose an account to sign in" key="google_link_choose_account"}}
            {{else if this.googleLinkManualMode}}
              {{t "Connect Google to your LingoLinq account" key="google_link_manual_title"}}
            {{else if this.googleLinkNeedsPicker}}
              {{t "We found multiple accounts" key="google_link_multiple_accounts"}}
            {{else}}
              {{t "We found your account" key="google_link_single_account"}}
            {{/if}}
          </h2>
        </div>
        <hr class="la-about-hero-separator" aria-hidden="true">
      </div>
        {{#if this.google_link_state.email}}
          <p class="google-link-context">{{t "Signed in to Google as %{email}" email=this.google_link_state.email key="google_signed_in_as"}}</p>
        {{/if}}
        {{#if this.googleLinkManualMode}}
          <p>{{t "No LingoLinq account was found for this Google email. Enter your username and password to link an existing account, or create a new account with Google." key="google_link_manual_body"}}</p>
        {{/if}}
        {{#if this.googleLinkShowsReadonlyCandidate}}
          <p class="google-link-found-accounts__lead">{{t "We found this LingoLinq account with your email:" key="google_link_found_account_single"}}</p>
          {{#each this.googleLinkDisplayCandidates as |candidate|}}
            <div class="google-link-picker__option">
              <div class="google-link-picker__label google-link-picker__label--readonly" aria-label={{candidate.user_name}}>
                <span class="google-link-picker__username">{{candidate.user_name}}</span>
                {{#if candidate.display_name}}
                  <span class="google-link-picker__display-name">{{candidate.display_name}}</span>
                {{/if}}
              </div>
            </div>
          {{/each}}
        {{else if this.googleLinkResolvedUsername}}
          <div class="form-group google-link-account-name">
            <p class="google-link-found-accounts__lead">{{t "LingoLinq account" key="google_link_account_label"}}</p>
            <div class="google-link-picker__option">
              <div class="google-link-picker__label google-link-picker__label--readonly" aria-label={{this.googleLinkResolvedUsername}}>
                <span class="google-link-picker__username">{{this.googleLinkResolvedUsername}}</span>
                {{#if this.googleLinkResolvedDisplayName}}
                  <span class="google-link-picker__display-name">{{this.googleLinkResolvedDisplayName}}</span>
                {{/if}}
              </div>
            </div>
          </div>
        {{/if}}
        {{#if this.googleLinkAccountSelectMode}}
          <p class="google-link-found-accounts__lead">{{t "Choose a linked account to sign in:" key="google_link_choose_linked_account"}}</p>
          {{#if this.googleLinkNeedsPicker}}
            <fieldset class="google-link-picker">
              <legend class="sr-only">{{t "Choose your username" key="google_link_choose_username"}}</legend>
              {{#each this.google_link_state.candidates as |candidate|}}
                <div class="google-link-picker__option">
                  <label class="google-link-picker__label">
                    <input type="radio" name="google_link_user" value={{candidate.user_name}} checked={{is-equal this.google_link_selected_user_name candidate.user_name}} {{on "change" this.onGoogleLinkUserSelect}} />
                    <span class="google-link-picker__username">{{candidate.user_name}}</span>
                    {{#if candidate.display_name}}
                      <span class="google-link-picker__display-name">{{candidate.display_name}}</span>
                    {{/if}}
                  </label>
                </div>
              {{/each}}
            </fieldset>
          {{else if this.googleLinkDisplayCandidates.length}}
            {{#each this.googleLinkDisplayCandidates as |candidate|}}
              <div class="google-link-picker__option">
                <div class="google-link-picker__label google-link-picker__label--readonly" aria-label={{candidate.user_name}}>
                  <span class="google-link-picker__username">{{candidate.user_name}}</span>
                  {{#if candidate.display_name}}
                    <span class="google-link-picker__display-name">{{candidate.display_name}}</span>
                  {{/if}}
                </div>
              </div>
            {{/each}}
          {{/if}}
          {{#if this.googleLinkHasUnlinkedCandidates}}
            <p class="google-link-found-accounts__lead">{{t "Or link another account with your Google email:" key="google_link_link_unlinked_email"}}</p>
            {{#if this.googleLinkUnlinkedNeedsPicker}}
              <fieldset class="google-link-picker">
                <legend class="sr-only">{{t "Choose an account to link" key="google_link_choose_link_account"}}</legend>
                {{#each this.googleLinkUnlinkedCandidates as |candidate|}}
                  <div class="google-link-picker__option">
                    <label class="google-link-picker__label">
                      <input type="radio" name="google_link_user" value={{candidate.user_name}} checked={{is-equal this.google_link_selected_user_name candidate.user_name}} {{on "change" this.onGoogleLinkUserSelect}} />
                      <span class="google-link-picker__username">{{candidate.user_name}}</span>
                      {{#if candidate.display_name}}
                        <span class="google-link-picker__display-name">{{candidate.display_name}}</span>
                      {{/if}}
                    </label>
                  </div>
                {{/each}}
              </fieldset>
            {{else}}
              {{#each this.googleLinkUnlinkedCandidates as |candidate|}}
                <div class="google-link-picker__option">
                  <label class="google-link-picker__label">
                    <input type="radio" name="google_link_user" value={{candidate.user_name}} checked={{is-equal this.google_link_selected_user_name candidate.user_name}} {{on "change" this.onGoogleLinkUserSelect}} />
                    <span class="google-link-picker__username">{{candidate.user_name}}</span>
                    {{#if candidate.display_name}}
                      <span class="google-link-picker__display-name">{{candidate.display_name}}</span>
                    {{/if}}
                  </label>
                </div>
              {{/each}}
            {{/if}}
          {{/if}}
          {{#if this.googleLinkShowLinkAnother}}
            <div class="form-group">
              <button type="button" {{on "click" this.onStartGoogleLinkAnother}} class="login-btn login-btn--outline" style="width: 100%;">
                {{t "Link another account" key="google_link_another_account"}}
              </button>
            </div>
          {{/if}}
        {{else if this.googleLinkNeedsPicker}}
          <p class="google-link-found-accounts__lead">{{t "We found these LingoLinq accounts with your email. Choose yours:" key="google_link_found_accounts_multiple"}}</p>
          <fieldset class="google-link-picker">
            <legend class="sr-only">{{t "Choose your username" key="google_link_choose_username"}}</legend>
            {{#each this.google_link_state.candidates as |candidate|}}
              <div class="google-link-picker__option">
                <label class="google-link-picker__label">
                  <input type="radio" name="google_link_user" value={{candidate.user_name}} checked={{is-equal this.google_link_selected_user_name candidate.user_name}} {{on "change" this.onGoogleLinkUserPick}} />
                  <span class="google-link-picker__username">{{candidate.user_name}}</span>
                  {{#if candidate.display_name}}
                    <span class="google-link-picker__display-name">{{candidate.display_name}}</span>
                  {{/if}}
                </label>
              </div>
            {{/each}}
          </fieldset>
        {{/if}}
        {{#if this.googleLinkNeedsUsernameField}}
          <div class="form-group">
            <label for="google_link_user_name">{{t "Username" key="username"}}</label>
            <LowercaseTextField @id="google_link_user_name" @class="form-control input-lg touchy" @value={{this.google_link_selected_user_name}} @onChange={{set-value this "google_link_selected_user_name"}} @placeholder="username" @autocomplete="username" />
          </div>
        {{/if}}
        {{#if this.googleLinkNeedsPassword}}
          <div class="form-group">
            <label for="google_link_password">{{t "Please enter the password for this account to link your account with Google. You only need to enter it once to link." key="google_link_password_prompt"}}</label>
            <PasswordField @id="google_link_password" @class="form-control input-lg touchy" @value={{this.google_link_password}} @onChange={{set-value this "google_link_password"}} @autocomplete="current-password" />
          </div>
        {{/if}}
        {{#if this.google_link_error}}
          <div class="login-error">{{this.google_link_error}}</div>
        {{/if}}
        <div class="form-group">
          <button type="button" {{on "click" this.onConfirmGoogleLink}} disabled={{this.googleLinkSubmitDisabled}} class="login-btn" style="width: 100%;">
            {{#if this.google_link_state.linking}}
              {{t "Signing In..." key="logging_in"}}
            {{else if this.googleLinkConfirmIsSignIn}}
              {{t "Sign In" key="log_in"}}
            {{else}}
              {{t "Link and Sign In" key="google_link_confirm"}}
            {{/if}}
          </button>
          {{#if this.googleLinkManualMode}}
            <button type="button" {{on "click" this.onStartGoogleSignup}} class="login-btn login-btn--google" style="width: 100%; margin-top: 10px;">
              {{t "Create with Google" key="google_create_with_google"}}
            </button>
          {{/if}}
          <button type="button" {{on "click" this.onCancelGoogleLink}} class="login-btn login-btn--outline" style="width: 100%; margin-top: 10px;">
            {{t "Cancel and use password login" key="google_link_cancel"}}
          </button>
        </div>
      {{/if}}
    {{else if this.prompt_2fa}}
      <div class="la-section-header">
        <div class="la-hero-title-wrap">
          <h2 class="la-hero-title">{{t "Confirm Login" key="confirm_login"}}</h2>
        </div>
        <hr class="la-about-hero-separator" aria-hidden="true">
      </div>
      {{#if this.prompt_2fa.uri}}
        <p>{{t "Your account requires two-factor authentication. Please scan the QR code in your authenticator app and enter the generated code to continue." key="required_code_for_2fa"}}</p>
        <QrCode @text={{this.prompt_2fa.uri}} @size={{300}} />
      {{else}}
        <p>{{t "Please enter the confirmation code provided by your two-factor authentication app:" key="enter_2fa_code"}}</p>
      {{/if}}
      <div class="form-group">
        <input type="number" value={{this.code_2fa}} class="form-control" placeholder="# # # # # #" aria-label={{t "Two-factor authentication code" key="two_factor_code"}} style="text-align: center;" {{on "input" (set-field this "code_2fa")}} />
      </div>
      <button {{on "click" this.onConfirm2fa}} disabled={{this.status_2fa.loading}} class='login-btn' style='width: 100%;'>
        <div style='font-size: 20px;'>
          {{#if this.status_2fa.loading}}
            {{t "Checking..." key="checking"}}
          {{else if this.status_2fa.error}}
            {{t "Code not Accepted" key="code_not_accepted"}}
          {{else if this.status_2fa.confirmed}}
            {{t "Confirmed!" key="confirmed"}}
          {{else}}
            {{t "Confirm Login" key="confirm_login"}}
          {{/if}}
        </div>
      </button>
    {{else if this.stashes.enabled}}
      <div class="la-section-header">
        <div class="la-hero-title-wrap">
          <h2 class="la-hero-title"><span class="la-hero-title__prefix">{{t "Sign in to " key="sign_in_to_prefix"}}</span><span class="hero-gradient">{{t "LingoLinq" key="app_name"}}</span></h2>
        </div>
        <hr class="la-about-hero-separator" aria-hidden="true">
      </div>
      <form {{on "submit" this.onAuthenticateSubmit}} autocomplete="off" id="login_form">
          {{#unless this.prompt}}
          {{#unless this.force_logout}}
            {{#if this.app_state.feature_flags.emergency_boards}}
              <div style='font-size: 14px; text-align: right; margin-bottom: 10px; margin-top: -10px;'>
                <LinkTo @route="offline_boards"><span style='color: #3d8053;'>{{t "basic access" key="critical_access_lower"}}</span></LinkTo>
              </div>
            {{/if}}
          {{/unless}}
        {{/unless}}
        <div class="form-group">
          <label for="identification">{{t "Username" key="username"}}</label>
          <LowercaseTextField @id="identification" @class="form-control input-lg touchy" @value={{this.identification}} @onChange={{set-value this "identification"}} @placeholder="username" @autocomplete="username" />
        </div>
        <div class="form-group">
          <label for="password">{{t "Password" key="password"}}</label>
          <PasswordField @id="password" @class="form-control input-lg touchy" @value={{this.password}} @onChange={{set-value this "password"}} @placeholder="password" @autocomplete="current-password" />
        </div>
        {{#unless this.browserless}}
          <div class="form-group" style='display: none;'>
            <div class="checkbox big_checkbox">
              <label>
                <input type="checkbox" checked={{this.long_token}} id="long_token" {{on "change" (set-field this "long_token" "checkbox")}} />
                Keep me logged in on this device
              </label>
            </div>
          </div>
        {{/unless}}
        {{#if this.login_error}}
          <div class="login-error">
            {{ this.login_error }}
          </div>
        {{/if}}
        {{#if this.coppa_needs_parent_email}}
          <div class="form-group" style="margin-top: 12px;">
            <label for="login_parent_consent_email">{{t "Parent or guardian email" key="coppa_parent_email_label"}}</label>
            <input type="email" value={{this.parent_consent_email}} class="form-control input-lg" id="login_parent_consent_email" placeholder={{t "Parent's email address (must differ from account email)" key="coppa_parent_email_placeholder"}} autocomplete="email" inputmode="email" {{on "input" (set-field this "parent_consent_email")}} />
            <button type="button" class="login-btn login-btn--outline" style="width: 100%; margin-top: 10px;" disabled={{this.coppaSubmitParentEmailDisabled}} {{on "click" this.onSubmitParentConsentEmail}}>
              {{#if this.coppa_submit_parent_busy}}
                {{t "Sending Email..." key="sending_email"}}
              {{else}}
                {{t "Send approval email to parent" key="coppa_submit_parent_email"}}
              {{/if}}
            </button>
            {{#if this.coppa_submit_parent_notice}}
              <p class="text-muted" style="margin-top: 10px; font-size: 14px;">{{this.coppa_submit_parent_notice}}</p>
            {{/if}}
          </div>
        {{/if}}
        {{#if this.coppa_awaiting_parent}}
          <div class="form-group" style="margin-top: 8px;">
            <button type="button" class="login-btn login-btn--outline" style="width: 100%;" disabled={{this.coppaResendDisabled}} {{on "click" this.onResendParentConsentEmail}}>
              {{#if this.coppa_resend_busy}}
                {{t "Sending Email..." key="sending_email"}}
              {{else}}
                {{t "Resend approval email to parent" key="coppa_resend_parent_email"}}
              {{/if}}
            </button>
            {{#if this.coppa_resend_notice}}
              <p class="text-muted" style="margin-top: 10px; font-size: 14px;">{{this.coppa_resend_notice}}</p>
            {{/if}}
          </div>
        {{/if}}
        <div class="form-group">
          <button type="submit" class='login-btn' disabled={{this.noSubmit}}>
            {{#if this.noSecret}}
              {{#if this.requesting}}
                <span class="glyphicon glyphicon-refresh spinning"></span>
              {{/if}}
              {{#if this.checking_for_secret}}
                {{t "Initializing..." key="initializing"}}
              {{else}}
                {{#if (persistence-online)}}
                  <span style='font-size: 14px;'>{{t "Can't Reach %app_name% Cloud,<br>Check Your Signal Quality" key="cant_reach_app"}}</span>
                {{else}}
                  {{t "Not Online" key="not_connected"}}
                {{/if}}
              {{/if}}
            {{else}}
              {{#if this.redirecting}}
                {{t "Redirecting..." key="redirecting_upper"}}
              {{else if this.logging_in}}
                {{t "Signing In..." key="logging_in"}}
              {{else}}
                {{#if this.logged_in}}
                  {{t "Success! One Moment..." key="success"}}
                {{else}}
                  {{t "Sign In" key="login"}}
                {{/if}}
              {{/if}}
            {{/if}}
          </button>
          {{#if this.force_logout}}
            <button type='button' class='login-btn login-btn--outline' style='margin-top: 10px;' {{on "click" this.onLogout}}>{{t "Log Out" key="log_out"}}</button>
          {{/if}}
          <div class="login-links">
            {{#if this.force_logout}}<br>{{/if}}
            {{#if this.app_state.no_linky}}
              <LinkTo @route="forgot_login">{{t "need help?" key="forgot_login"}}</LinkTo>
            {{else}}
              <LinkTo @route="forgot_password">{{t "forgot password" key="forgot_password_lower"}}</LinkTo>
              {{#if this.app_state.domain_settings.full_domain}}
                |
                <span style="color: #000;">{{t "Don't have an account?" key="dont_have_account"}}</span>
                <LinkTo @route="register">{{t "sign up" key="sign_up_lower"}}</LinkTo>
              {{/if}}
            {{/if}}
          </div>
        </div>
      </form>
      {{#if this.googleSsoEnabled}}
        <div class="login-google-divider">
          <span>{{t "or" key="google_or_divider"}}</span>
        </div>
        <div class="form-group">
          {{!-- Sign-in-with-Google button per Google's official Identity
               Branding Guidelines (https://developers.google.com/identity/branding-guidelines):
               white field, 1px #dadce0 border, 18px 4-color "G" logo
               on the left, Roboto-family Medium 14px label. The inner
               SVG is the standard Google G mark. --}}
          <button type="button" {{on "click" this.onContinueWithGoogle}} class="login-btn login-btn--google" disabled={{this.noSecret}}>
            <span class="login-btn--google__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" fill="#4285F4"/>
                <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853"/>
                <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
                <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z" fill="#EA4335"/>
              </svg>
            </span>
            <span class="login-btn--google__label">
              {{#if this.redirecting}}
                {{t "Redirecting..." key="redirecting_upper"}}
              {{else}}
                {{t "Continue with Google" key="continue_with_google"}}
              {{/if}}
            </span>
          </button>
        </div>
      {{/if}}
    {{else}}
      <div class="la-section-header">
        <div class="la-hero-title-wrap">
          <h2 class="la-hero-title">{{t "Can't Log In" key="cant_login"}}</h2>
        </div>
        <hr class="la-about-hero-separator" aria-hidden="true">
      </div>
      <p>
        <span class="glyphicon glyphicon-exclamation-sign"></span>
        {{t "The privacy settings on your browser are preventing %app_name% from fully functioning, so login and registration are temporarily disabled. %app_name% uses browser storage for things like user identity, offline support and performance improvements." key="privacy_wont_work"}}
      </p>
      <p>
        <a href="https://lingolinq.zendesk.com/hc/en-us/articles/202007575" target="_blank" rel="noopener">
          {{t "Learn more about configuring your browser to run %app_name%" key="learn_privacy"}}
        </a>
      </p>
    {{/if}}
  </div>
