<div>
  <span style='width: calc(100% - 50px); display: inline-block; margin-bottom: 5px;'>
    <input value={{this.geos}} class="form-control" placeholder="latitude,longitude" aria-label={{t "Latitude and longitude" key="latitude_and_longitude"}} {{on "input" (set-field this "geos")}} />
  </span>
  <button class='btn btn-default' {{on "click" (this.ctrlAction "mark_center")}}><span class='glyphicon glyphicon-screenshot'></span></button>
</div>
<div class="map_with_geo" style="width: 100%; height: 400px;"></div>
<div style="clear: left;"></div>
