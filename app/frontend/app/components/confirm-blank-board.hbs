<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>&times;</button>
    <h3 class="md-modal-title">{{t "This board has no words yet" key="confirm_blank_board_title"}}</h3>
  </div>
  <div class="modal-body md-modal-body">
    <div class="md-modal-icon-row">
      <div class="md-modal-icon-circle">
        {{!-- An empty grid: the board as it would be saved. --}}
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2.5"/>
          <line x1="3" y1="9" x2="21" y2="9"/>
          <line x1="3" y1="15" x2="21" y2="15"/>
          <line x1="9" y1="3" x2="9" y2="21"/>
          <line x1="15" y1="3" x2="15" y2="21"/>
        </svg>
      </div>
    </div>
    <p class="md-modal-message md-modal-message--warn">
      {{t "You have not added any words to this board, so it will be saved as a blank %{g} grid." g=this.grid_label key="confirm_blank_board_message"}}
    </p>
    <p class="md-modal-hint">
      {{t "That is fine if you are laying the board out now and filling it in later. If you meant to add words, cancel and press Enter after typing each one so it lands on the grid." key="confirm_blank_board_hint"}}
    </p>
  </div>
  <div class="modal-footer md-modal-footer">
    <button type="button" class="btn md-modal-btn md-modal-btn--primary" {{on "click" (this.ctrlAction "confirm")}}>
      {{t "Save blank board" key="confirm_blank_board_confirm"}}
    </button>
    <button type="button" class="btn md-modal-btn md-modal-btn--cancel" {{on "click" (this.ctrlAction "close")}}>{{t "Go back and add words" key="confirm_blank_board_cancel"}}</button>
  </div>
</ModalDialog>
