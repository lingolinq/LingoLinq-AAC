<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3 class="md-modal-header__title">
      {{#if this.model.header}}
        {{this.model.header}}
      {{else}}
        {{t "Switch Communicators" key="switch_communicators"}}
      {{/if}}
    </h3>
  </div>
  <div class="modal-body md-modal-body">
    {{!-- Modernized choice rows: each pair of options is a segmented
         card group (two equal cards). Active card carries the brand
         verdigris tint + glow, inactive sits as glass. Feather-style
         stroke SVGs replace the legacy glyphicons; sizes match the
         modern-UI icon vocabulary (24px). Actions / conditionals are
         unchanged from the legacy markup. --}}
    {{#unless this.model.stay}}
      <div class="md-switch-comms__choice-row" role="group" aria-label={{t "Jump Home" key="jump_home_aria"}}>
        <button type="button"
          class="md-switch-comms__choice {{if this.model.jump_home 'md-switch-comms__choice--active'}}"
          aria-pressed={{if this.model.jump_home "true" "false"}}
          {{on "click" (this.ctrlAction "set_attribute" "jump_home" true)}}>
          <span class="md-switch-comms__choice-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12 12 3l9 9"/><path d="M5 10v10a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1V10"/></svg>
          </span>
          <span class="md-switch-comms__choice-label">{{t "Go to the Communicator's<br>Home Board" key="go_to_users_home_board"}}</span>
        </button>
        <button type="button"
          class="md-switch-comms__choice {{unless this.model.jump_home 'md-switch-comms__choice--active'}}"
          aria-pressed={{unless this.model.jump_home "true" "false"}}
          {{on "click" (this.ctrlAction "set_attribute" "jump_home" false)}}>
          <span class="md-switch-comms__choice-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"/><path d="M5 17h14"/><path d="M6 11l-2 6h16l-2-6"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          </span>
          <span class="md-switch-comms__choice-label">{{t "Stay on<br>This Board" key="stay_on_this_board"}}</span>
        </button>
      </div>
    {{/unless}}
    {{#unless this.modeling_choice}}
      {{#unless this.model.route}}
        <div class="md-switch-comms__choice-row" role="group" aria-label={{t "Speak Mode Style" key="speak_mode_style_aria"}}>
          <button type="button"
            class="md-switch-comms__choice {{if this.model.keep_as_self 'md-switch-comms__choice--active'}}"
            aria-pressed={{if this.model.keep_as_self "true" "false"}}
            {{on "click" (this.ctrlAction "set_attribute" "keep_as_self" true)}}>
            <span class="md-switch-comms__choice-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11V5a2 2 0 0 1 4 0v6"/><path d="M13 7V3a2 2 0 0 1 4 0v8"/><path d="M17 8V5a2 2 0 0 1 4 0v9a8 8 0 0 1-8 8h-2a8 8 0 0 1-8-8V12a2 2 0 0 1 4 0v3"/></svg>
            </span>
            <span class="md-switch-comms__choice-label">{{t "Model for the<br>Communicator" key="model_for_the_communicator"}}</span>
          </button>
          <button type="button"
            class="md-switch-comms__choice {{unless this.model.keep_as_self 'md-switch-comms__choice--active'}}"
            aria-pressed={{unless this.model.keep_as_self "true" "false"}}
            {{on "click" (this.ctrlAction "set_attribute" "keep_as_self" false)}}>
            <span class="md-switch-comms__choice-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
            </span>
            <span class="md-switch-comms__choice-label">{{t "Speak as the<br>Communicator" key="speak_as_the_communicator"}}</span>
          </button>
        </div>
      {{/unless}}
    {{/unless}}
    {{!-- Compact: small rows stacked vertically so picking a communicator reads
         like a dropdown list rather than a wall of large cards. --}}
    <UserSelect @select_id="currently_selected_id" @skip_me={{this.model.skip_me}} @allow_all={{this.allow_all}} @buttons={{true}} @compact={{true}} @selection={{this.currently_selected_id}} @action={{this.ctrlAction "updateCurrentlySelectedId"}} />
  </div>
  <div class="modal-footer md-modal-footer">
    <button {{on "click" (this.ctrlAction "close")}} class="btn btn-default md-modal-btn md-modal-btn--cancel">{{t "Cancel" key="cancel"}}</button>
  </div>
</ModalDialog>
