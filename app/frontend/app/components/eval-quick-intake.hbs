{{!-- Intake form — 4 quick fields with pill-button pickers --}}
<section class="evq-intake" aria-labelledby="evq-intake-title">
  <header class="evq-intake__header">
    <h2 id="evq-intake-title" class="evq-intake__title">
      {{#if this.user}}
        {{t "Tell us about %{user_name}" key="intake_tell_us_about" user_name=this.user.user_name}}
      {{else}}
        {{t "Tell us about this communicator" key="intake_tell_us_generic"}}
      {{/if}}
    </h2>
    <p class="evq-intake__caption">
      {{t "Four quick questions route the screen to age- and etiology-appropriate items." key="intake_caption"}}
    </p>
  </header>

  <form class="evq-intake__form" {{on "submit" (action "begin")}}>
    <div class="evq-intake__field">
      <p class="evq-intake__legend">{{t "Age band" key="intake_age_band"}}</p>
      <div class="evq-pillgroup" role="radiogroup" aria-label={{t "Age band" key="intake_age_band"}}>
        {{#each this.ageBands as |opt|}}
          <button type="button" role="radio" class="evq-pill {{if (is_equal this.ageBand opt.value) 'evq-pill--active'}}" aria-checked={{if (is_equal this.ageBand opt.value) "true" "false"}} {{on "click" (this.ctrlAction "pick" "ageBand" opt.value)}}>
            {{opt.label}}
          </button>
        {{/each}}
      </div>
    </div>

    <div class="evq-intake__field">
      <p class="evq-intake__legend">{{t "Etiology" key="intake_etiology"}}</p>
      <div class="evq-pillgroup" role="radiogroup" aria-label={{t "Etiology" key="intake_etiology"}}>
        {{#each this.etiologyOptions as |opt|}}
          <button type="button" role="radio" class="evq-pill {{if (is_equal this.etiology opt.value) 'evq-pill--active'}}" aria-checked={{if (is_equal this.etiology opt.value) "true" "false"}} {{on "click" (this.ctrlAction "pick" "etiology" opt.value)}}>
            {{opt.label}}
          </button>
        {{/each}}
      </div>
    </div>

    <div class="evq-intake__field">
      <p class="evq-intake__legend">{{t "Current communication" key="intake_current_comm"}}</p>
      <div class="evq-pillgroup" role="radiogroup" aria-label={{t "Current communication" key="intake_current_comm"}}>
        {{#each this.currentCommOptions as |opt|}}
          <button type="button" role="radio" class="evq-pill {{if (is_equal this.currentComm opt.value) 'evq-pill--active'}}" aria-checked={{if (is_equal this.currentComm opt.value) "true" "false"}} {{on "click" (this.ctrlAction "pick" "currentComm" opt.value)}}>
            {{opt.label}}
          </button>
        {{/each}}
      </div>
    </div>

    <div class="evq-intake__field">
      <p class="evq-intake__legend">{{t "Suspected access channel" key="intake_suspected_access"}}</p>
      <div class="evq-pillgroup evq-pillgroup--access" role="radiogroup" aria-label={{t "Suspected access channel" key="intake_suspected_access"}}>
        {{#each this.accessOptions as |opt|}}
          <button type="button" role="radio"
                  class="evq-pill evq-pill--access {{if (is_equal this.suspectedAccess opt.value) 'evq-pill--active'}} evq-pill--access-status-{{opt.status}}"
                  aria-checked={{if (is_equal this.suspectedAccess opt.value) "true" "false"}}
                  disabled={{opt.unavailable}}
                  {{on "click" (this.ctrlAction "pick" "suspectedAccess" opt.value)}}>
            <span class="evq-pill__label">{{opt.label}}</span>
            {{#if opt.statusLabel}}
              <span class="evq-pill__status-badge evq-pill__status-badge--{{opt.status}}" aria-label={{opt.statusLabel}}>
                {{#if (is_equal opt.status 'ready')}}
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 13 10 18 19 7"/></svg>
                {{else if (is_equal opt.status 'software_fallback')}}
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{else}}
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                {{/if}}
                {{opt.statusLabel}}
              </span>
            {{/if}}
          </button>
        {{/each}}
      </div>
    </div>

    {{#if this.previewProfile}}
      <aside class="evq-intake__preview" aria-live="polite">
        <span class="evq-intake__preview-label">{{t "We'll use the" key="intake_preview_prefix"}}</span>
        <strong class="evq-intake__preview-name">{{this.previewProfile}}</strong>
        <span class="evq-intake__preview-suffix">{{t "item bank." key="intake_preview_suffix"}}</span>
      </aside>
    {{/if}}

    <div class="evq-intake__actions">
      <button type="submit" class="evq-btn evq-btn--primary" disabled={{unless this.isComplete "disabled"}}>
        {{t "Begin Quick Screen" key="intake_begin"}}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </form>
</section>
