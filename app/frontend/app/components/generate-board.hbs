<GridListener @gridEvent={{this.ctrlAction "grid_event"}}>
<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}}>
  <div class="la-new-board-modal-wrap la-generate-board-modal-wrap">
    <div class="la-modal-header">
      <span class="la-modal-header-label">{{t "Generate Board with AI" key="generate_board_with_ai"}}</span>
      <div class="la-support-modal-header-meta">
        <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>✕</button>
      </div>
    </div>
    <div class="la-support-modal-body">
      <p style="margin-bottom: 16px; font-size: 14px; color: var(--md-ink);">{{t "Describe the board you want. AI will generate word labels for an AAC communication board." key="generate_board_prompt_instructions"}}</p>
      <form class="form-horizontal la-new-board-form" {{on "submit" (this.ctrlAction "createBoard")}}>
      <div class="form-group">
        <label for="generate_board_prompt" class="col-sm-2 control-label">{{t "Description" key="description"}}</label>
        <div class="col-sm-10">
          <textarea class="form-control" id="generate_board_prompt" rows="3" placeholder={{this.prompt_placeholder}} {{on "input" (set-field this "prompt")}}>{{this.prompt}}</textarea>
        </div>
      </div>
      <div class="form-group">
        <label for="generate_board_rows" class="col-sm-2 control-label">{{t "Rows" key="rows"}}</label>
        <div class="col-sm-3">
          <div class="input-group">
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "minus" "rows")}}>-</button>
            </span>
            <input type="number" value={{this.rows}} class="form-control" id="generate_board_rows" placeholder="2" {{on "input" (set-field this "rows")}} />
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "plus" "rows")}}>+</button>
            </span>
          </div>
        </div>
      </div>
      <div class="form-group">
        <label for="generate_board_columns" class="col-sm-2 control-label">{{t "Columns" key="columns"}}</label>
        <div class="col-sm-3" style="height: 100px;">
          <div class="input-group">
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "minus" "columns")}}>-</button>
            </span>
            <input type="number" value={{this.columns}} class="form-control" id="generate_board_columns" placeholder="4" {{on "input" (set-field this "columns")}} />
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "plus" "columns")}}>+</button>
            </span>
          </div>
        </div>
        <div class="col-sm-7" id="grid_selection">
          <div class="row">
            {{#each this.showGrid as |row|}}
              {{#each row as |cell|}}
                <div style="width: 8.33%; float: left;" class={{cell.preview_class}} data-row={{cell.row}} data-col={{cell.column}}>
                  <div title="{{cell.row}} x {{cell.column}}">
                    &nbsp;
                  </div>
                </div>
              {{/each}}
            {{/each}}
          </div>
        </div>
      </div>
      <div class="form-group">
        <div class="col-sm-10 col-sm-offset-2">
          <div class="checkbox big_checkbox">
            <label title={{this.core_words_tooltip}}>
              <input type="checkbox" checked={{this.include_core_words}} id="generate_board_core_words" {{on "change" (fn (mut this.include_core_words) value="target.checked")}} {{on "change" (set-field this "include_core_words" "checkbox")}} />
              {{t "Core Words" key="core_words"}}
            </label>
          </div>
        </div>
      </div>
      <div class="form-group">
        <label for="generate_board_locale" class="col-sm-2 control-label">{{t "Language" key="locale"}}</label>
        <div class="col-sm-10">
          <ModernSelect @class="new-board-select--modern" @selectId="generate_board_locale" @content={{this.locales}} @selection={{this.locale}} @action={{this.ctrlAction "setLocale"}} @ariaLabel={{t "Language" key="locale"}} />
        </div>
      </div>
      <div class="form-group">
        <label for="generate_board_icon" class="col-sm-2 control-label">{{t "Icon" key="icon"}}</label>
        <div class="col-sm-10">
          <IconSelect @selection={{this.image_url}} @action={{fn (mut this.image_url)}} />
        </div>
      </div>
      <div class="form-group">
        <label for="generate_board_labels" class="col-sm-2 control-label">{{t "Labels" key="labels"}}</label>
        <div class="col-sm-10">
          <div style="margin-bottom: 8px;">
            <button type="button" class="la-btn la-btn--ghost" {{on "click" (this.ctrlAction "generateLabels")}} disabled={{this.status.generatingLabels}}>
              {{#if this.status.generatingLabels}}
                {{t "Generating..." key="generating"}}
              {{else}}
                {{t "Generate with AI" key="generate_with_ai"}}
              {{/if}}
            </button>
          </div>
          <textarea class="form-control" id="generate_board_labels" rows="4" placeholder={{this.labels_placeholder}} {{on "input" (set-field this "labels")}}>{{this.labels}}</textarea>
        </div>
      </div>
      <div class="form-group">
        <label for="generate_board_name" class="col-sm-2 control-label">{{t "Board name" key="board_name"}}</label>
        <div class="col-sm-10">
          <input value={{this.name}} class="form-control" id="generate_board_name" placeholder="AI Generated Board" {{on "input" (set-field this "name")}} />
        </div>
      </div>
      <div class="form-group">
        <label for="generate_board_description" class="col-sm-2 control-label">{{t "Description" key="description"}}</label>
        <div class="col-sm-10">
          <textarea class="form-control" id="generate_board_description" rows="2" placeholder={{this.description_placeholder}} {{on "input" (set-field this "description")}}>{{this.description}}</textarea>
        </div>
      </div>
      {{#if this.has_supervisees}}
        <div class="form-group">
          <label for="for_user_id" class="col-sm-2 control-label">{{t "For" key="for"}}</label>
          <div class="col-sm-10">
            <UserSelect @select_id="for_user_id" @selection={{this.for_user_id}} @action={{this.ctrlAction "setForUserId"}} />
          </div>
        </div>
      {{/if}}
      
      <div class="form-group">
        <label for="generate_board_labels_order" class="col-sm-2 control-label">{{t "Label order" key="labels_order"}}</label>
        <div class="col-sm-10">
          <ModernSelect @class="new-board-select--modern" @selectId="generate_board_labels_order" @content={{this.labels_order_list}} @selection={{this.labels_order}} @action={{this.ctrlAction "setLabelsOrder"}} @ariaLabel={{t "Label order" key="labels_order"}} />
        </div>
      </div>
      {{#if this.status.error}}
        <div class="alert alert-danger">{{this.status.error}}</div>
      {{/if}}
    </form>
    </div>
    <div class="la-new-board-modal-footer">
      <div class="la-new-board-modal-footer__actions">
        <button type="button" class="la-btn la-btn--ghost" {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
        <button type="button" {{on "click" (this.ctrlAction "createBoard")}} class="la-btn la-btn--primary" disabled={{this.create_board_disabled}}>
          {{#if this.status.saving}}
            {{t "Creating Board..." key="creating_board"}}
          {{else}}
            {{t "Create Board" key="create_board"}}
          {{/if}}
        </button>
      </div>
    </div>
  </div>
</ModalDialog>
</GridListener>
