{{#if @isOpen}}
  <div class="la-mobile-drawer">
    <button type="button" class="la-mobile-drawer__backdrop" {{on "click" @onClose}} aria-label={{t "Close menu" key="fsa_close_menu"}}></button>
    <div class="la-mobile-drawer__panel">
      <button class="la-mobile-drawer__close" type="button" aria-label={{t "Close menu" key="fsa_close_menu"}} {{on "click" @onClose}}>&times;</button>
      {{yield}}
    </div>
  </div>
{{/if}}
