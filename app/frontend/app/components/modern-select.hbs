<div class="modern-select {{if this.isOpen "modern-select--open"}} {{this.class}}">
  <button
    id={{this.selectId}}
    type="button"
    class="modern-select__trigger"
    aria-haspopup="listbox"
    aria-expanded={{this.isOpen}}
    aria-label={{this.ariaLabel}}
    {{on "click" this.onToggle}}
  >
    <span class="modern-select__trigger-text {{unless this.selectedItem 'modern-select__trigger-text--placeholder'}}">{{this.triggerLabel}}</span>
  </button>
  {{#if this.isOpen}}
    <ul class="modern-select__list {{if this.searchable "modern-select__list--searchable"}}" role="listbox" {{on "click" this.onStopPropagation}} {{on "keydown" this.onListKeydown}}>
      {{#if this.searchable}}
        {{!-- Filter row pinned at the top of the open dropdown. The
             outer <li role="none"> takes the row out of the listbox
             accessibility tree (so screen readers still announce
             only `option` children), while letting the row sit
             inside the absolute-positioned dropdown chrome without
             restructuring the wrapper. ArrowDown / Enter / Escape in
             the input are handled by search_keydown. --}}
        <li class="modern-select__search-row" role="none">
          <span class="modern-select__search-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </span>
          <input type="text" value={{this.searchString}} class="modern-select__search-input" placeholder={{this.searchPlaceholder}} aria-label={{this.searchPlaceholder}} {{on "keydown" this.onSearchKeydown}} {{on "input" (set-field this "searchString")}} />
        </li>
      {{/if}}
      {{#each this.filteredContent as |item|}}
        {{#if item.heading}}
          {{!-- Group heading (the custom-list equivalent of <optgroup label>).
               It WAS `role="none"`, which kept it out of the listbox a11y tree
               entirely — so the grouping was purely visual and a screen-reader
               user heard Root / Liked / Shared with Me / Private as flat siblings
               with no group label at all (WCAG 1.3.1).

               `role="option" aria-disabled="true"` gets the label announced in
               its correct position, ahead of the options it introduces, without
               touching the data shape. The ideal markup is a nested
               `<ul role="group" aria-label>`, but the content here is a FLAT
               list of headings and options, so that would mean restructuring
               `filteredContent` and every producer that feeds it — a large change
               to a select used across many modals.

               Safe because option handling in modern-select.js is entirely
               CLASS-based (`.modern-select__option` at :182, :183, :246, :285,
               :290) and this element carries `modern-select__group-label`, so
               focus landing and ArrowDown/Up still skip it exactly as before; it
               also still has no tabindex.

               Known trade-off: AT that announces positional counts will include
               the heading in "n of m". That is a smaller harm than the grouping
               being inaudible. --}}
          <li class="modern-select__group-label" role="option" aria-disabled="true" aria-selected="false">{{item.name}}</li>
        {{else}}
          <li
            class="modern-select__option {{if (is-equal this.selection item.id) "modern-select__option--selected"}}"
            role="option"
            tabindex="0"
            aria-selected={{is-equal this.selection item.id}}
            {{on "click" (fn this.onChoose item)}}
            {{on "keydown" (fn this.onOptionKeydown item)}}
          >
            {{item.name}}
          </li>
        {{/if}}
      {{else}}
        {{!-- Empty-state row — modern alternative to a blank dropdown. --}}
        <li class="modern-select__empty" role="presentation">
          <span class="modern-select__empty-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </span>
          <span class="modern-select__empty-text">
            {{#if this.searchString}}
              {{t "No matches for your search" key="modern_select_no_matches"}}
            {{else}}
              {{t "No options available" key="bound_select_no_options"}}
            {{/if}}
          </span>
        </li>
      {{/each}}
    </ul>
  {{/if}}
</div>
