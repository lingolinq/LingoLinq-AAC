<div class='row md-board-preview'>
  <div class="{{if this.include_canvas "col-sm-4" "col-sm-8 col-sm-offset-2"}} md-board-preview__info">
    {{#if this.model.loading}}
      <div class='md-board-preview__status'>{{t "Loading board..." key="loading_board"}}</div>
    {{else if this.model.error}}
      <div class='md-board-preview__status md-board-preview__status--error'>{{t "Error loading board" key="error_loading_board"}}</div>
    {{else if this.model}}
      <div class='md-board-preview__heading'>
        <h3 class='md-board-preview__title'>{{this.model.name}}</h3>
        <div class='md-board-preview__byline'>{{#if (board-attribution-owner this.model)}}{{t "by" key="by"}} {{board-attribution-owner this.model}}{{/if}}</div>
      </div>
      <div class='md-board-preview__description'>
          <span class='md-board-preview__description-text'>{{this.model.description}}</span>
      </div>
      <dl class="dl-horizontal md-board-preview__meta">
        <dt>{{t "Full Name" key="full_name"}}</dt>
          <dd>{{this.model.key}}</dd>
        <dt>{{t "Dimensions" key="dimensions"}}</dt>
          <dd>{{this.model.grid.rows}} x {{this.model.grid.columns}}</dd>
        <dt>{{t "Created" key="created"}}</dt>
          <dd>{{date this.model.created "day"}}</dd>
        <dt>{{t "Last Updated" key="updated"}}</dt>
          <dd>{{date this.model.updated "day"}}</dd>
        {{#if this.model.locale}}
          <dt>{{t "Default Language" key="default_language"}}</dt>
            <dd>{{this.language}}</dd>
        {{/if}}
        {{#if this.multiple_locales}}
          <dt>{{t "Translations" key="translations"}}</dt>
            <dd>{{this.languages}}</dd>
        {{/if}}
        <dt>{{t "People Using" key="people_using"}}</dt>
          <dd>
            {{this.model.non_author_uses}}
          </dd>
        <dt>{{t "Connected Boards" key="connected_boards"}}</dt>
          <dd>
            {{this.model.downstream_boards}}
          </dd>
        <dt>{{t "Available Buttons" key="available_buttons"}}</dt>
          <dd>
            {{this.model.unlinked_buttons}}
          </dd>
        <dt>{{t "Likes" key="stars"}}</dt>
          <dd>
            {{this.model.stars}}
          </dd>
      </dl>
    {{else}}
      <div class='md-board-preview__status'>{{t "No data to show" key="no_data_to_show"}}</div>
    {{/if}}
  </div>
  {{!-- Right column: the preview canvas, with the action buttons DIRECTLY BELOW
       it (to the right of the board-detail info on the left). The column always
       renders so the buttons show even on narrow viewports where the canvas is
       suppressed (include_canvas=false); there it stacks under the info. --}}
  <div class="{{if this.include_canvas "col-sm-8" "col-sm-8 col-sm-offset-2"}} md-board-preview__canvas-col">
    {{#if this.include_canvas}}
      <BoardPreviewCanvas @board={{this.model}} @locale={{this.locale}} @show_links={{true}} @size="modal" @dark_mode={{this.dark_mode}} @onCanvasReady={{this.ctrlAction "canvas_ready"}} @onCanvasProgress={{this.ctrlAction "canvas_progress"}} />
    {{/if}}
    {{!-- Action buttons: secondary / Back flow from the LEFT; the primary CTA is
         pushed to the RIGHT (.md-board-preview__action--primary { margin-left:auto }
         in app.scss). Same row for board-picker TOUR mode (Pick this Board) and the
         regular board-preview details modal (Try This Board / Board Actions). --}}
    <div class='md-board-preview__actions'>
      {{#if this.tour_pick}}
        {{!-- Board-picker TOUR mode: "Back" returns to the live tour modal (left);
             "Pick this Board" copies the board to the user and opens it in edit
             mode (right). See board-preview-overlay#pick_for_home. --}}
        <button class='btn btn-default md-modal-btn md-modal-btn--secondary md-board-preview__action' {{on "click" (this.ctrlAction "close")}}>
          {{t "Back to Picker" key="board_picker_back"}}
        </button>
        {{#if this.back}}
          <button class='btn btn-lg btn-default md-modal-btn md-modal-btn--secondary md-board-preview__action' {{on "click" (this.ctrlAction this.back)}}>
            {{t "Back to List" key="back_to_list"}}
          </button>
        {{/if}}
        <button class='btn btn-lg btn-primary md-modal-btn md-modal-btn--primary md-board-preview__action md-board-preview__action--primary' {{on "click" (this.ctrlAction "pick_for_home")}}>
          {{t "Pick this Board" key="pick_this_board"}}
        </button>
      {{else if this.return_only}}
        {{!-- Opened from another modal (e.g. button-settings) that stays open
             underneath: view-only. Close dismisses this overlay and returns the
             user to that modal. --}}
        <button class='btn btn-lg btn-primary md-modal-btn md-modal-btn--primary md-board-preview__action md-board-preview__action--primary' {{on "click" (this.ctrlAction "close")}}>
          {{t "Close" key="close"}}
        </button>
      {{else}}
        {{!-- Regular details modal: destructive Remove sits at the far LEFT
             (isolated from the positive CTAs); Back / Cancel / Board Actions /
             Copy For follow; the primary CTA (Try / Choose This Board) is pushed
             to the RIGHT. --}}
        {{#if this.removeContext}}
          {{!-- Touch-device parity for the tile's hover-only delete/unlike/unshare
               button. Danger treatment, far-left + isolated. Label + icon come from
               board_list.remove_* so all four contextual variants (delete, unstar,
               unlink, untag) are covered with their correct copy. --}}
          <button type='button' class='btn btn-default md-modal-btn md-board-preview__action md-board-preview__action--remove' {{on "click" (this.ctrlAction this.onRemove)}} aria-label={{this.removeContext.label}}>
            {{#if this.removeContext.icon}}
              <span class='md-board-preview__action--remove-icon {{this.removeContext.icon}}' aria-hidden="true"></span>
            {{/if}}
            <span class='md-board-preview__action--remove-text'>{{this.removeContext.label}}</span>
          </button>
        {{/if}}
        {{#if this.back}}
          <button class='btn btn-lg btn-default md-modal-btn md-modal-btn--secondary md-board-preview__action' {{on "click" (this.ctrlAction this.back)}}>
            {{t "Back to List" key="back_to_list"}}
          </button>
        {{/if}}
        {{#if this.select_option}}
          <button class='btn btn-default md-modal-btn md-modal-btn--cancel md-board-preview__action' {{on "click" (this.ctrlAction "close")}}>
            {{t "Cancel" key="cancel"}}
          </button>
        {{/if}}
        {{#if this.app_state.currentUser.supervisees}}
          <button class='btn btn-default md-modal-btn md-modal-btn--secondary md-board-preview__action' {{on "click" (this.ctrlAction "copy")}}>
            {{t "Copy For..." key="copy_for_ellipses"}}
          </button>
        {{/if}}
        <button class='btn btn-lg btn-primary md-modal-btn md-modal-btn--primary md-board-preview__action md-board-preview__action--primary' {{on "click" (this.ctrlAction "select")}}>
          {{#if this.select_option}}
            {{t "Choose This Board" key="choose_this_board"}}
          {{else}}
            {{t "Try This Board" key="try_this_board"}}
          {{/if}}
        </button>
      {{/if}}
    </div>
  </div>
</div>
