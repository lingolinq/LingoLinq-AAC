<div class='row'>
  <div class='col-sm-2'>
    <div class='fill_preview'>
      <div class='box' style={{this.box_style}}></div>
      {{@row.label}}  
    </div>
  </div>
  <div class='col-sm-3'>
    <input class='form-control' value={{@row.label}} placeholder="label" aria-label={{t "Label" key="label"}} {{on "input" (set-field @row "label")}}/>
  </div>
  <div class='col-sm-3'>
    <input class='form-control' value={{@row.border}} placeholder="border color" aria-label={{t "Border color" key="border_color"}} {{on "input" (set-field @row "border")}}/>
  </div>
  <div class='col-sm-3'>
    <input class='form-control' value={{@row.fill}} placeholder="fill color" aria-label={{t "Fill color" key="fill_color"}} {{on "input" (set-field @row "fill")}}/>
  </div>
  <div class='col-sm-1'>
    <button class='btn btn-default' {{on "click" (this.ctrlAction "remove" @row)}}><span class='glyphicon glyphicon-remove'></span></button>
  </div>
</div>
