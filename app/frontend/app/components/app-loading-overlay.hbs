{{#if this.app_state.loading_overlay_message}}
  {{!-- Uses the same .ll-premium-progress chrome as the bootstrap
       skeleton (boards/index.html.erb + app/index.html) and the
       index-loading template. Visual continuity from the first paint
       through any mid-session route-loading state — no separate
       "Loading…" spinner overlay. The dynamic message rides in the
       __sub slot (e.g. "Loading Home Page…", "Loading board…"). Bound
       directly to the tracked service property so it reacts reliably. --}}
  <div class="ll-premium-progress" role="status" aria-live="polite" aria-busy="true">
    <div class="ll-premium-progress__card">
      <h2 class="ll-premium-progress__title">{{t "Preparing your workspace" key="preparing_your_workspace"}}</h2>
      <p class="ll-premium-progress__sub">{{this.app_state.loading_overlay_message}}</p>
      <div class="ll-premium-progress__bar" aria-hidden="true"></div>
    </div>
  </div>
{{/if}}
