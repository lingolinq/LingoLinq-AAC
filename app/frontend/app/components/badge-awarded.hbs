<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>
      {{#if this.model.badge.avatar_url}}
        <img src={{this.model.badge.avatar_url}} alt="" class='fit_image' style='height: 60px; width: 60px; margin: -15px 10px -25px -5px; border: 1px solid rgba(0, 0, 0, 0.5); border-radius: 100%; padding: 1px; background: #fff; box-shadow: 0px 0px 3px;' onerror='button_broken_image(this)'>
      {{/if}}
      {{#if this.user_goals_and_badges}}
        {{t "Badges and Goals" key="badges_and_goals"}}
      {{else if this.model.badge.earned}}
        {{t "Badge Awarded!" key="badge_awarded"}}
      {{else if this.model.badge.id}}
        {{t "Badge In Progress" key="badge_in_progress"}}
      {{else}}
        {{t "Badge Details" key="badge_details"}}
      {{/if}}
    </h3>
  </div>
  <div class="modal-body md-modal-body md-badge-awarded">
    {{#if this.user_goals_and_badges}}
      <div style='margin-bottom: 15px;'>
        {{#if this.user_badges.loading}}
          <p class="md-badge-awarded__inline-status">{{t "Loading badges..." key="loading_badges"}}</p>
        {{else if this.user_badges.error}}
          <p class="md-badge-awarded__inline-status md-badge-awarded__inline-status--error">
            <span class="md-badge-awarded__inline-status-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </span>
            {{t "Couldn't load badges right now — try again in a moment." key="badges_load_error_friendly"}}
          </p>
        {{else if this.user_badges}}
          {{#each this.user_badges as |badge|}}
            <div style='float: left;'>
              <button type="button" class="md-link-btn" {{on "click" (this.ctrlAction "show_badge" badge.id)}} aria-label={{t "View badge details" key="view_badge_details"}}>
                {{#if badge.image_url}}
                  <img src={{badge.image_url}} alt="" style="height: 80px; margin-right: 10px;" onerror='button_broken_image(this)' data-fallback={{path "images/badge-fallback.png"}} >
                {{else}}
                  <img src={{path "images/badge-fallback.png"}} alt="" style="height: 80px; margin-right: 10px;" onerror='button_broken_image(this)' data-fallback={{path "images/badge-fallback.png"}} >
                {{/if}}
              </button>
            </div>
          {{/each}}
          <div style='clear: left;'></div>
        {{/if}}
      </div>
      <div>
      {{#if this.user_goals.loading}}
        <p class="md-badge-awarded__inline-status">{{t "Loading goals..." key="loading_goals"}}</p>
      {{else if this.user_goals.error}}
        <p class="md-badge-awarded__inline-status md-badge-awarded__inline-status--error">
          <span class="md-badge-awarded__inline-status-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </span>
          {{t "Couldn't load goals right now — try again in a moment." key="goals_load_error_friendly"}}
        </p>
      {{else if this.user_goals}}
        {{#each this.user_goals as |goal|}}
          <button type="button" {{on "click" (this.ctrlAction "show_goal" goal.id)}} class={{if goal.badge_image_url "cursor"}} style='padding-top: 10px; padding-bottom: 15px; margin-bottom: 5px; border-bottom: 1px solid #eee; background: none; border-left: none; border-right: none; border-top: none; width: 100%; text-align: left; font: inherit; color: inherit; cursor: pointer; display: block;'>
            <div style='float: left; margin-right: 10px;'>
            {{#if goal.badge_image_url}}
              <img src={{goal.badge_image_url}} style='width: 50px; max-height: 50px; opacity: 0.8;' alt="">
            {{else}}
              <span class='glyphicon glyphicon-flag' style='margin-top: 5px; display: inline-block;width: 50px; height: 40px; font-size: 30px; text-align: center;' aria-hidden="true"></span>
            {{/if}}
            </div>
            <div style='font-size: 20px; white-space: nowrap; overflow: hidden;'>
            {{goal.summary}}
            </div>
            <div class='text-muted'>
              {{#if goal.advance}}
                {{t "advances" key="advances_in"}}
                {{date_ago goal.advance "day"}}
              {{else if goal.expires}}
                {{t "concludes" key="concludes_in"}}
                {{date_ago goal.expires "day"}}
              {{else}}
                long goal
              {{/if}}
            </div>
          </button>
        {{/each}}
      {{else}}
        <span class='glyphicon glyphicon-flag' style='font-size: 30px; float: left; margin-right: 10px;'></span>
        <p>{{t "This communicator had earned one or more badges! Some badges are automatically set up in %app_name%, but you can also easily set your own goals and assign new badges to go with them." key="badges_explainer"}}</p>
        <p>{{t "Setting goals is an important part of the communication process! In %app_name%, goals can help keep the team on the same page and working on the same thing, which is important for newly-developing communicators." key="goals_explainer"}}</p>
        {{#if this.appState.speak_mode}}
          <p>{{t "If you exit Speak Mode and go to the 'Goals' section of your account you can find an existing goal or set one of your own. You can even have the system automatically track progress toward the goal, and award badges to the communicator as they progress!" key="goals_explainer_12"}}</p>
        {{else}}
          <p>{{t "To set your first goal, hit the 'New Goal' button below and get started. You can find an existing goal or set one of your own. You can even have the system automatically track progress toward the goal, and award badges to the communicator as they progress!" key="goals_explainer_2"}}</p>
        {{/if}}
      {{/if}}
      </div>
    {{else}}
      <div style='text-align: center;'>
        {{#if this.model.badge.loading}}
          {{t "Loading badge details" key="loading_badge_details"}}
        {{else if this.model.badge.error}}
          {{t "Error loading badge details" key="error_loading_badge_details"}}
        {{else if this.model.badge.id}}
          {{!-- Real badge data path — original layout. --}}
          {{#if this.model.badge.earned}}
            <div class='medal-holder'>
              <div class='medal'>
                {{#if this.model.badge.image_url}}
                  <img src={{this.model.badge.image_url}} alt="" style='width: 200px;' onerror='button_broken_image(this)' data-fallback={{path "images/badge-fallback.png"}} >
                {{else}}
                  <img src={{path "images/badge-fallback.png"}} alt="" style='width: 200px;' onerror='button_broken_image(this)' data-fallback={{path "images/badge-fallback.png"}} >
                {{/if}}
                <div class='sparkle'>&#10022;</div>
              </div>
              <div class="medal-ribbon">
                <div style="width: 34px;height: 0;border-left: 11px solid transparent;border-right: 11px solid transparent;border-top: 111px solid #444;top: 0;left: 0;transform: rotate(-33deg) translate(44px,24px);position: absolute;"></div>
                <div style="width: 30px;height: 0;border-left: 10px solid transparent;border-right: 10px solid transparent;border-top: 112px solid red;top: 0;left: 0;transform: rotate(-33deg) translate(46px,27px);position: absolute;"></div>
                <div style="width: 35px;height: 0;border-left: 11px solid transparent;border-right: 11px solid transparent;border-top: 111px solid #444;top: 0;left: 0;transform: rotate(36deg) translate(96px,-72px);position: absolute;"></div>
                <div style="width: 30px;height: 0;border-left: 10px solid transparent;border-right: 10px solid transparent;border-top: 112px solid red;top: 0;left: 0;transform: rotate(36deg) translate(98px,-72px);position: absolute;"></div>
              </div>
              <div class='medal-hanger'>
                <div style='border: 2px solid #444; background: #ff0; width: 30px; height: 30px; border-radius: 15px; position: absolute; top: 95px; left: 85px;'></div>
              </div>
            </div>
            {{#if this.model.badge.sound_url_with_fallback}}
              <audio src={{this.model.badge.sound_url_with_fallback}} autoplay='true' aria-label={{t "Badge sound" key="badge_sound_label"}} />
            {{/if}}
          {{else}}
            <div class="md-badge-awarded__art">
              {{!-- GUARDED, like the earned branch above. This one bound `src` straight to
                    `image_url`, so a badge with no image rendered `src=""` — which browsers
                    resolve to the page URL rather than failing cleanly, so `onerror` could
                    not reliably rescue it and a broken-image glyph stayed on screen.

                    BOTH PATHS LAND ON `badge-in-progress.svg`, and they are different failures.
                    The `{{#if}}` covers a badge with NO artwork at all. The `data-fallback`
                    covers the far more common case seen in practice: the badge HAS an
                    `image_url` — usually a remote OpenSymbols asset — which is not in the
                    local cache and cannot be fetched, so `Button.broken_image` swaps the
                    fallback in. Before this, that second path landed on `badge-fallback.png`,
                    the GENERIC medal that an EARNED badge also falls back to, so a badge still
                    being worked toward rendered as a finished one.

                    `badge-in-progress.svg` carries a deliberately incomplete ring, so the
                    state reads without text. It lives in the Rails-served `public/images/` at
                    the repo ROOT, alongside `badge-fallback.png` — NOT in
                    `app/frontend/public/images/`. `{{path}}` resolves it to `/images/...`,
                    which the Rails app serves and `.ember-cli` proxies in development.

                    `badge-fallback.png` stays as the second-level fallback on the no-artwork
                    branch: if the SVG itself ever fails, the generic medal is better than a
                    broken glyph. `alt=""` on both, as before — the modal title already says
                    "Badge In Progress", the badge name sits directly below, and the progress
                    bar carries its own value, so this image is decorative. --}}
              {{#if this.model.badge.image_url}}
                <img src={{this.model.badge.image_url}} alt="" onerror='button_broken_image(this)' data-fallback={{path "images/badge-in-progress.svg"}} >
              {{else}}
                <img src={{path "images/badge-in-progress.svg"}} alt="" onerror='button_broken_image(this)' data-fallback={{path "images/badge-fallback.png"}} >
              {{/if}}
            </div>
          {{/if}}
          <div style='font-weight: bold; font-size: 30px;'>{{this.model.badge.name}}</div>
          {{#if this.model.badge.level}}
            <div style='color: #888; font-size: 16px;'>{{t "Level %{level}" level=this.model.badge.level key="level_n2"}}</div>
          {{/if}}
          {{#if this.model.badge.earned}}
            <div style='color: #888;'>
              {{t "earned" key="earned_lower"}}
              {{date this.model.badge.earned "short_day"}}
            </div>
          {{else if this.model.badge.id}}
            <div style='color: #888; font-size: 25px; margin-top: 10px;'>
              {{#if this.model.badge.progress}}
                {{this.model.badge.time_left}}
              {{/if}}
            </div>
            <div style='width: 200px; margin: 0 auto;'>
              {{!-- Track and fill are styled in app.scss, scoped via
                    `.modal-content:has(.md-badge-awarded)`. The 1px #aaa border and 25px
                    height that used to be inline here had to go: an inline style beats the
                    stylesheet, so the modern treatment could not reach this element while
                    they were present. The bar's WIDTH is still bound below via
                    `progress_style` (models/badge.js:42), which sets width only. --}}
              <div class="progress">
                {{!-- `aria-valuenow` from `progress_out_of_100`, the SAME rounded value the
                      width and the sr-only text below use — which is exactly why
                      `progress_style` reuses it rather than recomputing the raw float
                      (models/badge.js:43-46), so the three can never disagree. Matches
                      badge-progress.hbs:9; its absence here left a `progressbar` with a min
                      and a max and no current value. --}}
                <div class="progress-bar" role="progressbar" aria-valuenow={{this.model.badge.progress_out_of_100}} aria-valuemin="0" aria-valuemax="100" style={{this.model.badge.progress_style}}>
                  <span class="sr-only">
                    {{t "%{pct}% Complete" key="percent_complete" pct=this.model.badge.progress_out_of_100}}
                  </span>
                </div>
              </div>
            </div>
          {{/if}}
          {{#if this.model.badge.completion_explanation}}
            {{!-- Was inline `max-width: 300px`, which pinned this to 300px however wide the
                  modal got and left it as a narrow column with ~125px of dead space either
                  side. Moved to a class so the width can be a percentage of the modal and so
                  an inline style is not sitting where the stylesheet cannot reach it. --}}
            <div class="md-badge-awarded__explain">
              <span style='color: #888;'>
                {{#if this.model.badge.earned}}
                  {{t "To earn this badge, %{user} had to:" user=this.user_name key="to_earn_user_had_to"}}<br>
                {{else}}
                  {{t "To earn this badge, %{user} needs to:" user=this.user_name key="to_earn_user_needs_to"}}<br>
                {{/if}}
              </span>

              {{this.model.badge.completion_explanation}}
            </div>
          {{/if}}
        {{else}}
          {{!-- Empty state — no badge data passed in. Friendly,
               encouraging UX rather than a blank modal body. --}}
          <div class="md-badge-awarded__empty">
            <div class="md-badge-awarded__empty-medal" aria-hidden="true">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6"/>
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
              </svg>
              <span class="md-badge-awarded__empty-sparkle md-badge-awarded__empty-sparkle--1" aria-hidden="true">✦</span>
              <span class="md-badge-awarded__empty-sparkle md-badge-awarded__empty-sparkle--2" aria-hidden="true">✦</span>
              <span class="md-badge-awarded__empty-sparkle md-badge-awarded__empty-sparkle--3" aria-hidden="true">✦</span>
            </div>
            <h3 class="md-badge-awarded__empty-title">{{t "No badges yet — but they're on the way!" key="badge_empty_title"}}</h3>
            <p class="md-badge-awarded__empty-message">{{t "Set a goal, practice every day, and watch your shiny new badges show up here. We can't wait to celebrate your first one!" key="badge_empty_message"}}</p>
          </div>
        {{/if}}
      </div>
      {{#if this.model.badge.earned}}
        {{#each this.confettis as |confetti|}}
          <div class='confetti' style={{confetti.style}}></div>
        {{/each}}
      {{/if}}
    {{/if}}
  </div>
  <div class="modal-footer md-modal-footer">
    <button type="button" {{on "click" (this.ctrlAction "close")}} class="btn md-modal-btn md-modal-btn--cancel">{{t "Close" key="close"}}</button>
    {{#if this.user_goals_and_badges}}
      {{#if this.model.badge}}
        <button type="button" {{on "click" (this.ctrlAction "show_badge")}} class="btn md-modal-btn md-modal-btn--cancel">{{t "Back to Badge" key="back_to_badge"}}</button>
      {{/if}}
    {{else}}
      {{#if (persistence-online)}}
        <button type="button" {{on "click" (this.ctrlAction "user_badges")}} class="btn md-modal-btn md-modal-btn--cancel"><span class='glyphicon glyphicon-flag'></span> {{t "Goals and Badges" key="see_user_goals_and_badges"}}</button>
      {{/if}}
    {{/if}}
    {{#if (persistence-online)}}
      {{#unless this.appState.speak_mode}}
        <button type="button" {{on "click" (this.ctrlAction "new_goal")}} class="btn md-modal-btn md-modal-btn--primary">{{t "New Goal" key="new_goal"}}</button>
      {{/unless}}
    {{/if}}
    {{#if this.model.speak_mode}}
      {{#if this.has_modeling_activities}}
        <button type="button" {{on "click" (this.ctrlAction "modeling_ideas")}} class="btn md-modal-btn md-modal-btn--cancel">{{t "Modeling Ideas" key="modeling_ideas"}}</button>
      {{/if}}
    {{/if}}
  </div>
</ModalDialog>
