<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Button Settings" key="button_settings"}} - {{this.model.label}}</h3>
  </div>
  <div class="modal-body md-modal-body" id="button_settings">
    <div class="row">
      <div class="col-sm-3">
        <ul class="nav nav-pills nav-stacked" role="tablist">
          <li class={{if this.helpState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.helpState "true" "false"}} {{on "click" (this.ctrlAction "setState" "help")}}>{{t "Help" key="help"}}</a></li>
          {{!-- Items below are alphabetized (Help stays pinned at the top). Tabs
               ({{action "setState"}}) and quick ACTIONS (color/stash/word_data/clear
               — which close the modal, see components/button-settings.js) interleave
               by their visible label. --}}
          <li class={{if this.actionState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.actionState "true" "false"}} {{on "click" (this.ctrlAction "setState" "action")}}>{{t "Action" key="action"}}</a></li>
          {{#if this.is_modern}}<li class="inactive md-button-settings__nav-action" role="presentation"><a href="#" role="button" {{on "click" (this.ctrlAction "color_button")}}>{{t "Color" key="color"}}</a></li>{{/if}}
          {{#if this.appState.feature_flags.board_levels}}
            <li class={{if this.extrasState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.extrasState "true" "false"}} {{on "click" (this.ctrlAction "setState" "extras")}}>{{t "Extras" key="extras"}}</a></li>
          {{/if}}
          <li class={{if this.generalState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.generalState "true" "false"}} {{on "click" (this.ctrlAction "setState" "general")}}>{{t "General" key="general"}}</a></li>
          {{#if this.board.translations}}
            <li class={{if this.languageState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.languageState "true" "false"}} {{on "click" (this.ctrlAction "setState" "language")}}>{{t "Language" key="language"}}</a></li>
          {{/if}}
          <li class={{if this.pictureState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.pictureState "true" "false"}} {{on "click" (this.ctrlAction "setState" "picture")}}>{{t "Picture" key="picture"}}</a></li>
          <li class={{if this.soundState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.soundState "true" "false"}} {{on "click" (this.ctrlAction "setState" "sound")}}>{{t "Sound" key="sound"}}</a></li>
          {{#if this.is_modern}}
          <li class="inactive md-button-settings__nav-action" role="presentation"><a href="#" role="button" {{on "click" (this.ctrlAction "stash_this_button")}}>{{t "Stash" key="stash"}}</a></li>
          <li class="inactive md-button-settings__nav-action" role="presentation"><a href="#" role="button" {{on "click" (this.ctrlAction "word_data_this_button")}}>{{t "Word Data" key="view_word_data_title"}}</a></li>
          {{/if}}
        </ul>
      </div>
      <div class="col-sm-9 content" role="tabpanel">
        {{!-- Help tab content --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
        <div class={{if this.helpState "active" "hidden"}}>
          <div class="form-group">
            <div class="col-sm-12">
              <div style='position: relative;'>
                <h4>{{t "Button Settings" key="button_settings"}}</h4>
                {{#if this.auto_help}}
                  <button type="button" {{on "click" (this.ctrlAction "disable_auto_help")}} class='btn btn-default btn-sm' style='position: absolute; top: -10px; right: 0;'>{{t "Skip this help in the future" key="skip_help"}}</button>
                {{else if this.appState.currentUser.preferences.disable_button_help}}
                  <button type="button" {{on "click" (this.ctrlAction "enable_auto_help")}} class='btn btn-default btn-sm' style='position: absolute; top: -10px; right: 0;'>{{t "Start here in the future" key="re_enable_help"}}</button>
                {{/if}}
              </div>
              <p>{{t "Buttons configurations are very flexible, and you can explore settings using the tabs to the left, or the quick actions below." key="button_settings_explainer"}}</p>
            </div>
          </div>
          <div class="form-group">
            <div class="col-sm-12">
              <div class='btn-group-vertical' style='width: 90%;'>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "picture")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-picture' style='margin-right: 3px;'></span> {{t "Change this Button's Picture" key="change_image"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "label")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-edit' style='margin-right: 3px;'></span> {{t "Change this Button's Label" key="change_label"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "sound")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-volume-down' style='margin-right: 3px;'></span> {{t "Change what this Button Speaks" key="change_speak_sound"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "folder")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-folder-open' style='margin-right: 3px;'></span> {{t "Link to Another Board" key="link_to_board"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "url")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-link' style='margin-right: 3px;'></span> {{t "Link to a Web Site or Video" key="link_to_web_site"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "hide")}} class='btn btn-lg btn-default' style='text-align: left;'>
                  {{#if this.model.hidden}}
                    <span class='glyphicon glyphicon-eye-open' style='margin-right: 3px;'></span> {{t "Un-Hide this Button" key="unhide_this_button"}}
                  {{else}}
                    <span class='glyphicon glyphicon-eye-close' style='margin-right: 3px;'></span> {{t "Hide this Button" key="hide_this_button"}}
                  {{/if}}
                </button>
                {{#if this.paint_hide_reminder}}
                  <em class='text-muted' style='font-size: 14px;'>{{t "Remember, you can hide/show multiple buttons more quickly using the Paint tool!" key="hide_and_show_using_paint"}}</em>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
        </form>

        {{!-- General tab content --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
        <div class={{if this.generalState "active" "hidden"}}>
          <div class="form-group">
            <label for="label" class="col-sm-2 control-label">{{t "Label" key="label"}}</label>
            <div class="col-sm-10">
              <input value={{this.model.label}} class="form-control" id="label" {{on "input" (set-field this "model.label")}} />
            </div>
          </div>
          <div class="form-group" style='margin-top: -20px;'>
            <div class="col-sm-10 col-sm-offset-2">
              <div class="checkbox big_checkbox">
                <label>
                  <input type="checkbox" checked={{this.model.hide_label}} {{on "change" (this.ctrlActionEventValue "updateHideLabel" "checked")}} {{on "change" (set-field this "model.hide_label" "checkbox")}} />
                  {{t "Hide the label when the picture is shown" key="hide_label"}}
                </label>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label for="part_of_speech" class="col-sm-2 control-label">{{t "Word" key="part_of_speech"}}</label>
            <div class="col-sm-10">
              <BoundSelect @select_class="form-control" @select_id="part_of_speech" @content={{this.parts_of_speech}} @selection={{this.model.part_of_speech}} @action={{this.ctrlAction "updateModelPartOfSpeech"}} />
            </div>
          </div>
          <div class="form-group">
            <label for="fill" class="col-sm-2 control-label">{{t "Fill" key="fill"}}</label>
            <div class="col-sm-10">
              <span role="button" tabindex="0" {{on "click" (this.ctrlAction "toggle_color" "fill")}} style="display: inline-block; border-width: 3px; border: 2px dotted #ccc; height: 34px; width: 70px; vertical-align: bottom; cursor: pointer;" class={{this.fake_button_class}} aria-label={{t "Choose fill color" key="choose_fill_color"}}></span>
              <span class="button_field">
                <input value={{this.model.background_color}} class="form-control" id="fill" {{on "input" (set-field this "model.background_color")}} />
              </span>
              <br>
              <em style="font-size: 14px; line-height: 12px;">{{t "You can also color multiple buttons at once with standard color schemes using the Paint button" key="use_paint_button"}}</em>
            </div>
          </div>
          <div class="form-group">
            <label for="border" class="col-sm-2 control-label">{{t "Border" key="border"}}</label>
            <div class="col-sm-10">
              <span role="button" tabindex="0" {{on "click" (this.ctrlAction "toggle_color" "border")}} id="background_pattern" style={{safe-style (concat "display: inline-block; height: 34px; width: 70px; vertical-align: bottom; border: 6px solid " this.model.border_color "; background-color:" this.model.background_color "; cursor: pointer;")}} aria-label={{t "Choose border color" key="choose_border_color"}}></span>
              <span class="button_field">
                <input value={{this.model.border_color}} class="form-control" id="border" {{on "input" (set-field this "model.border_color")}} />
              </span>
            </div>
          </div>
          <div class="form-group">
            <label for="hidden" class="col-sm-2 control-label">{{t "Hidden" key="hidden"}}</label>
            <div class="col-sm-10">
              <div class="checkbox big_checkbox">
                <label>
                  <input type="checkbox" checked={{this.model.hidden}} {{on "change" (set-field this "model.hidden" "checkbox")}} />
                  {{t "Hide this button from view" key="hide_this_button_from_view"}}
                </label>
              </div>
            </div>
          </div>
          <div class="form-group">
            <div class="col-sm-10 col-sm-offset-2">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "clear_button")}}>{{t "Clear" key="clear"}}</button>
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "swapButton")}}>{{t "Swap With..." key="swap_with"}}</button>
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "stash_button")}}>
                {{#if this.stashed}}
                  <span class="glyphicon glyphicon-check"></span>
                  {{t "Copied to Stash" key="copied_to_stash"}}
                {{else}}
                  {{t "Copy to Stash" key="copy_to_stash"}}
                {{/if}}
              </button>
            </div>
          </div>
        </div>
        </form>

        {{!-- Picture tab content (inlined) --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
        <div class={{if this.pictureState "active" "hidden"}}>
  {{#if this.show_libraries}}
    {{#if this.image_libraries}}
      <div style='float: left; width: 55px; font-size: 14px;'>{{t "Library: " key="library_colon"}}</div>
      <div style='margin-top: -5px; width: 200px; float: left;'>
        <BoundSelect @select_class="form-control skip_select" @select_id="image_library" @short={{true}} @content={{this.image_libraries}} @selection={{this.image_library}} @action={{this.ctrlAction "updateImageLibrary"}} />
      </div>
    {{else}}
      <div style='float: left; width: 255px; font-size: 14px;'>{{t "Library: opensymbols.org" key="library_open_symbols"}}</div>
    {{/if}}
    {{#if this.appState.feature_flags.skin_tones}}
      <div style='float: left; width: 50px; margin-top: -5px; margin-left: 5px;'><button type="button" class='btn btn-sm btn-default' {{on "click" (this.ctrlAction "library_options")}} style='height: 25px; padding-top: 3px;'>{{t "options" key="options"}}</button></div>
    {{/if}}
    <div style="clear: left;"></div>
    {{#if this.premium_symbol_library}}
      {{#if this.appState.currentUser.subscription.grace_trial_period}}
        <div class='text-danger'>
          {{t "(requires extra fee after trial period)" key="extra_fee_at_purchase"}}            
        </div>
      {{/if}}
    {{/if}}
    <div style='font-size: 14px; margin-top: 5px;' class='text-muted'>
      <em>{{t "Enter a search term, or paste a URL or file" key="search_or_paste"}}</em>
    </div>
  {{/if}}
  <div style="margin-bottom: 10px;" class="options">
    <span class="picture_search_field">
      <span class={{if this.multi_locales "picture_search_input_with_locale" "picture_search_input_full"}}>
        <Input id="find_picture" @value={{this.model.image_field}} @enter={{this.ctrlAction "find_picture"}} placeholder={{this.search_prompt}} class="form-control inline select_on_click" />
      </span>
      {{#if this.multi_locales}}
        <span style='display: inline-block; width: 55px; vertical-align: middle;'>
          <div class="btn-group" style='vertical-align: middle;'>
            <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style='width: 100%;'>
              <span style='vertical-align: middle; max-width: 20px; overflow: hidden; display: inline-block;'>{{this.search_locale}}</span> 
              <span class="caret"></span>
            </button>
            <ul class="dropdown-menu">
              {{#each this.locales as |loc|}}
                <li><a href="#" {{on "click" (this.ctrlAction "set_locale" loc.id)}}>{{loc.name}}</a></li>
              {{/each}}
            </ul>
          </div>        
        </span>
      {{/if}}
    </span>
    <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "find_picture")}}>{{t "Search" key="search"}}</button>
    <button type="button" {{on "click" (this.ctrlAction "webcamPicture")}} disabled={{this.webcam_unavailable}} class="btn btn-default" style='width: 42px; height: 34px; overflow: hidden;'>
      <img src={{path "images/camera.svg"}} style="height: 42px; margin: -13px;" alt="take a picture">
    </button>
    <span class="file_select_holder">
      <button type="button" class='btn btn-default' style='width: 44px; height: 34px; overflow: hidden;'>
        <img src={{path "images/upload.svg"}} style="height: 30px; margin: -10px -6px -6px;" alt="upload">
      </button>
      <input type="file" name="image_upload" id="image_upload" accept="image/*" tabindex="-1">
    </span>
    {{#if this.show_library_options}}
      <div style='margin-top: 3px;'>
        <div style='width: calc(100% - 170px); float: left;'>
          <BoundSelect @select_class="form-control skip_select" @select_id="skin_preference" @short={{true}} @content={{this.skin_options}} @selection={{this.skin_preference}} @action={{this.ctrlAction "updateSkinPreference"}} />
        </div>
        <div style='width: 150px; float: left; margin-left: 5px;'>
          <div class='checkbox big_checkbox' style='margin-top: -8px; padding-top: 10px;'>
            <label><input type="checkbox" checked={{this.safe_search}} {{on "change" (set-field this "safe_search" "checkbox")}} /> {{t "safe search" key="safe_search"}}</label>
          </div>
        </div>
      </div>
      <div style='clear: left;'></div>
    {{/if}}
  </div>

  <div style="text-align: center;" class={{if this.webcam "shown" "hidden"}}>
    {{#if this.webcam.error}}
      <p>{{t "There was an error loading the camera" key="error_loading_camera"}}</p>
    {{else}}
      <video autoplay id="webcam_video" {{on "click" (this.ctrlAction "webcamToggle" true)}} class={{this.webcam_class}}></video>
      <canvas id="webcam_canvas" style="display:none;" width="800" height="800"></canvas>
      {{#unless this.webcam.snapshot}}
        <br>
        <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
        {{#if this.webcam.video_streams}}
          <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "swapStreams")}}>{{t "Switch Views" key="switch_cameras"}}</button>
        {{/if}}
        <button type="button" class='btn btn-primary' {{on "click" (this.ctrlAction "webcamToggle" true)}}>{{t "Take Pic" key="take_pic"}}</button>
      {{/unless}}
    {{/if}}
  </div>

  {{#if this.model.image.url}}
    {{#unless this.image_preview}}
      <div style="text-align: center; margin-bottom: 15px; margin-top: 5px;">
        <div style="font-size: 14px; color: #666; margin-bottom: 5px;">{{t "Current picture" key="current_picture"}}</div>
        <img src={{or this.fresh_picture_url this.model.image.url this.model.image.best_url_without_preferred_symbols}} class="button_image" alt="">
      </div>
    {{/unless}}
  {{/if}}
  {{#if this.image_preview}}
    {{#if this.image_preview.error}}
      {{this.image_preview.error}}
      <div style='margin-top: 10px;'>
        <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
      </div>
    {{else}}
      <div style="text-align: center;">
        {{#if this.image_preview.word_editor}}
          <iframe src="https://www.opensymbols.org/word_maker#embed" style="width: 100%; height: 225px;" frameborder="0" title="Word art editor"></iframe>
        {{else if this.image_preview.editor}}
          <iframe src="https://www.opensymbols.org/editor#embed" style="width: 100%; height: 225px;" frameborder="0" title="Image editor"></iframe>
        {{else}}
          <img src={{this.image_preview.url}} class="button_image">
        {{/if}}
        <div style="margin-top: 10px;">
          {{pick-license license=this.image_preview.license}}
        </div>
        {{#unless this.image_preview.license.uneditable}}
          <div style='margin-top: -10px; text-align: left;'>
            <div class='form-group'>
              <div class='col-sm-2'>
                <label><p class='form-control-static'>{{t "Contrast" key="contrast"}}</p></label>
              </div>
              <div class='col-sm-10'>
                <div class="checkbox big_checkbox">
                  <label>
                    <input type="checkbox" checked={{this.image_preview.hc}} {{on "change" (set-field this "image_preview.hc" "checkbox")}} />
                    {{t "This is a high-contrast image" key="mark_high_contrast"}}
                  </label>
                </div>
              </div>
            </div>
          </div>
        {{/unless}}
        <div style="margin-top: 10px;">
          <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
          {{#unless this.image_preview.editor}}
            <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "edit_image_preview")}}>{{t "Edit" key="edit"}}</button>
          {{/unless}}
          {{#if this.stream}}
            <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "webcamToggle" false)}}>{{t "Try Again" key="try_again"}}</button>
          {{/if}}
          {{#if this.image_search.previews}}
            <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clear_image_preview")}}>{{t "Back to List" key="back_to_list"}}</button>
            {{#if this.model.image.permissions.edit}}
              <div class="btn-group" role="group" aria-label="extra" style='width: 30px; margin-right: 5px;'>
                <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <span class="caret"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-right">
                  <li><a href="#" {{on "click" (this.ctrlAction "set_alternate")}}>{{t "Set as Library Default" key="set_as_library_default"}}</a></li>
                </ul>
              </div>
            {{/if}}
          {{/if}}
          <button type="button" class='btn btn-primary' {{on "click" (this.ctrlAction "select_image_preview")}}>
            {{#if this.model.pending_image}}
              {{t "Saving..." key="saving"}}
            {{else}}
              {{t "Use This" key="use_this"}}
            {{/if}}
          </button>
        </div>
      </div>
    {{/if}}
  {{else}}
    {{#if this.image_search.error}}
      <p class='text-danger' style='margin: 15px 0;'>{{this.image_search.error}}</p>
      <div style='margin-top: 10px;'>
        <button type='button' class='btn btn-default' {{on "click" (this.ctrlAction "word_art")}}>{{t "Make Word Art" key="make_word_art"}}</button>
        <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
      </div>
    {{else}}
      {{#if this.missing_library}}
        <div style="margin: 10px 0 10px 0;">
          {{#if this.missing_library.lessonpix}}
            <img src="https://lingolinq.s3.amazonaws.com/icons/lessonpix.png" style='width: 50px; float: left; margin-right: 10px; margin-bottom: 5px;'>
            {{t "LessonPix is a paid third-party symbol library with over 33,000 symbols. If you have a <a href='https://lessonpix.com' target='_blank' rel='noopener'>LessonPix account</a> you can <b>connect it to your %app_name% account in your User Profile</b>, and then you and any supervisors will be able to add LessonPix symbols to your boards." key="lessonpix_detailer"}}
          {{else if this.missing_library.pcs}}
            <img src="https://lingolinq.s3.amazonaws.com/icons/pcs.png" style='width: 50px; float: left; margin-right: 10px; margin-bottom: 5px;'>
            {{t "PCS (BoardMaker) is a paid third-party symbol library supported by Tobii Dynavix with over 18,000 symbols. %app_name% users can purchase access to PCS symbols as an upgrade on their"  key="pcs_explainer"}}
            <LinkTo @route="user.subscription" @model={{this.appState.currentUser.user_name}}>billing page</LinkTo>.
          {{else if this.missing_library.symbolstix}}
            <img src="https://lingolinq.s3.amazonaws.com/icons/symbolstix.png" style='width: 50px; float: left; margin-right: 10px; margin-bottom: 5px;'>
            {{t "SymbolStix is a paid third-party symbol library supported by News2You with over 48,000 symbols. %app_name% users can purchase access to SymbolStix symbols as an upgrade on their"  key="symbolstix_explainer"}}
            <LinkTo @route="user.subscription" @model={{this.appState.currentUser.user_name}}>billing page</LinkTo>.
          {{else}}
            {{t "Premium symbol support required" key="premium_symbols_required"}}
          {{/if}}
        </div>
        <button type='button' class='btn btn-default' {{on "click" (this.ctrlAction "word_art")}}>{{t "Make Word Art" key="make_word_art"}}</button>
        <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
      {{else if this.image_search.previews}}
        <div style="margin: 10px 0 10px 0;">
          {{#each this.image_search.previews as |image|}}
            <img src={{image.thumbnail_url}} {{on "click" (this.ctrlAction "pick_preview" image)}} style="height: 50px; max-width: 100px; border: 1px solid #ccc; padding: 1px; margin-bottom: 4px;">
          {{/each}}
        </div>
        {{#if this.current_library.giphy_asl}}
          <img src={{path "images/logos/giphy.png"}} style='padding-bottom: 10px; margin-left: -10px;'><br>
        {{/if}}

        <button type='button' class='btn btn-default' {{on "click" (this.ctrlAction "word_art")}}>{{t "Make Word Art" key="make_word_art"}}</button>
        <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
      {{else if this.image_search.previews_loaded}}
        <div style="margin: 10px 0 10px 0;">
          {{t "No results found for %{term}" key="no_image_results_for" term=this.image_search.term}}
        </div>
        <button type='button' class='btn btn-default' {{on "click" (this.ctrlAction "word_art")}}>{{t "Make Word Art" key="make_word_art"}}</button>
        <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
      {{else}}
        {{#if this.current_library.giphy_asl}}
          <img src={{path "images/logos/giphy.png"}} style='padding-bottom: 10px; margin-left: -10px;'><br>
        {{/if}}
        <button type='button' class='btn btn-default' {{on "click" (this.ctrlAction "word_art")}}>{{t "Make Word Art" key="make_word_art"}}</button>
      {{/if}}
    {{/if}}
  {{/if}}
</div>
        </form>

        {{!-- Action tab content (inlined) --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
<div class={{if this.actionState "active" "hidden"}}>
  <div class="form-group">
    <label for="action" class="col-sm-2 control-label">{{t "Action" key="action"}}</label>
    <div class="col-sm-10">
      <BoundSelect @select_class="form-control" @select_id="action" @content={{this.buttonActions}} @selection={{this.model.buttonAction}} @action={{this.ctrlAction "updateModelButtonAction"}} />
    </div>
  </div>
  {{#if this.model.folderAction}}
    <div class="form-group">
      <label class="col-sm-2 control-label">{{t "Board" key="board"}}</label>
      <div class="col-sm-10">
        <p class="form-control-static">
          {{#if this.model.load_board.key}}
            <img src={{this.model.icon}} style="height: 20px;">
            <a href={{this.model.link}} target="_blank" rel="noopener">{{this.model.load_board.key}}</a>
          {{else}}
            {{t "None Set" key="none_set"}}
          {{/if}}
        </p>
      </div>
    </div>
    <div class="form-group">
      <label for="change_to" class="col-sm-2 control-label">{{t "Find/Add" key="find_add"}}</label>
      <div class="col-sm-10 options">
        <!-- for some reason this invisible button needs to be here otherwise when I hit 'enter' it triggers build_board instead of find_board -->
        <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "find_board")}} style='display: none; margin-right: 20px;'>{{t "Find" key="find"}}</button>
        <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "build_board")}} style='margin-right: 20px;'>{{t "New" key="new"}}</button>
        <span class="board_search_field">
          <Input @value={{this.linkedBoardName}} class="form-control" id="change_to" placeholder="Board name or key" @enter={{this.ctrlAction "find_board"}} />
        </span>
        <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "find_board")}}>{{t "Find" key="find"}}</button>
        {{#unless this.pending_board}}
          <div class="row" style="margin-top: 5px;">
            <div class="col-sm-12">
              <BoundSelect @select_class="form-control" @select_id="board_search_type" @content={{this.board_search_options}} @selection={{this.board_search_type}} @action={{this.ctrlAction "updateBoardSearchType"}} />
            </div>
          </div>
          {{#if this.confirm_found_board}}
            <div class="row" style="margin-top: 10px;">
              {{#if this.confirm_found_board.copy_status.copying}}
                <div class="col-sm-12">
                  <p>{{t "Copying board %{board_key}..." board_key=this.confirm_found_board.key key="copying_board_key"}}</p>
                </div>
              {{else if this.confirm_found_board.copy_status.error}}
                <div class="col-sm-12">
                  <p>{{t "There was an error copying the board" key="error_copying_board"}}</p>
                </div>
              {{else if this.confirm_found_board.share_status.sharing}}
                <div class="col-sm-12">
                  <p>{{t "Sharing board %{board_key}..." board_key=this.confirm_found_board.key key="sharing_board_key"}}</p>
                </div>
              {{else if this.confirm_found_board.share_status.error}}
                <div class="col-sm-12">
                  <p>{{t "There was an error sharing the board" key="error_sharing_board"}}</p>
                </div>
              {{else}}
                {{#let this.confirm_found_board as |board|}}
                  <div class="col-sm-4">
                    <span class="well well-sm board_icon">
                      <span style='display: block;' title={{board.long_preview}}>
    <span class="icon" style='display: block;'>
      <img src={{board.icon_url_with_fallback}} onerror="button_broken_image(this);">
    </span>
    <span style="display: block; height: 50px">
      <span style="color: #666; padding-left: 8px; display: block;">
        {{board.grid.rows}} x {{board.grid.columns}}
      </span>
      {{#if board.unlinked_buttons}}
        <span style="color: #888; padding-left: 8px; display: block;">
          <span class="glyphicon glyphicon-th"></span>
          {{board.unlinked_buttons}}
        </span>
      {{/if}}
      {{#if board.stars}}
        <span style="color: #222; padding-left: 8px; display: block;">
          <span class="glyphicon glyphicon-star"></span>
          {{board.stars}}
        </span>
      {{/if}}
      {{#if board.different_locale}}
        <span style='color: #888; padding-left: 8px; display: block;'>
          {{board.shortened_locale}}
        </span>
      {{/if}}
    </span>
    <span style="display: block; clear: both;"></span>
</span>
<span class="names" title={{board.long_preview}}>
  <span class="name">
    {{#unless board.public}}<span class="glyphicon glyphicon-lock"></span>{{/unless}}
    {{board.name}}{{#if board.copy_version}} <span style='color: #666; font-size: 14px;'>({{board.copy_version}})</span>{{/if}}
  </span><br>
  <span class="labels">{{board.labels}}</span>
</span><br>
<span class="user_name">{{board.user_name}}</span><br>

                    </span>
                  </div>
                  <div class="col-sm-12">
                    {{#if board.copy_or_share}}
                      <p>{{t "The current board's author may not have access to this board as it is marked private. Would you like to share this board, or make a copy of it?" key="copy_or_share_board"}}</p>
                    {{else}}
                      <p>{{t "This board was created by someone other than the current board's author. Would you like to use the board as-is, or make a copy of it?" key="copy_or_link_board"}}</p>
                    {{/if}}
                    {{#if board.downstream_boards}}
                      <p>{{t "NOTE: To copy linked boards with this board you should navigate to the board and manually make a copy." key="links_are_not_copied"}}</p>
                    {{/if}}
                    {{#if board.copy_or_share}}
                      <button type="button" class='btn btn-primary' {{on "click" (this.ctrlAction "shareFoundBoard" board)}}>{{t "Share This Board" key="share_this_board"}}</button>
                    {{else}}
                      <button type="button" class='btn btn-primary' {{on "click" (this.ctrlAction "selectFoundBoard" board true)}}>{{t "Link to This Board" key="link_to_this_board"}}</button>
                    {{/if}}
                    <!-- TODO: option to select who to copy for? -->
                    <!-- TODO: option to copy downstream boards as well? I'm deliberately
                               not adding right now because it's a potentially-complicated
                               action, and I'd rather people did that through the
                               copy board menu instead of making this intra-form confirmation
                               even more confusing. -->
                    <!-- TODO: if you can't copy FOR the person, copy for yourself and
                               share with them? -->
                    <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "copy_found_board")}}>{{t "Copy This Board" key="copy_this_board"}}</button>
                  </div>
                {{/let}}
              {{/if}}
            </div>
          {{else}}
            {{#if this.foundBoards.ready}}
              {{#if this.foundBoards.results}}
                <div class="row" style="margin-top: 10px; max-height: 250px; overflow: auto;">
                  {{#each this.foundBoards.results as |board|}}
                    <div class="col-sm-4 simple_board_holder">
                      {{board-icon board=board noinfo=true option="select" onAction=(this.ctrlAction "selectFoundBoard") locale=this.foundBoards.locale}}
                    </div>
                  {{/each}}
                </div>
              {{else}}
                <div style="margin-top: 10px;">
                  {{#if this.foundBoards.term}}
                    {{t "No results found for \"%{term}\"" key="no_results_for" term=this.foundBoards.term}}
                  {{else}}
                    {{t "No results found" key="no_results_found"}}
                  {{/if}}
                </div>
              {{/if}}
            {{else}}
              {{#if this.foundBoards.term}}
                <div style="margin-top: 10px;">
                  {{t "Searching for \"%{term}\"..." key="searching_for" term=this.foundBoards.term}}
                </div>
              {{/if}}
            {{/if}}
          {{/if}}
        {{/unless}}
      </div>
    </div>
    {{#if this.pending_board}}
      {{#if this.has_supervisees}}
        <div class="form-group">
          <label for="for_user_id" class="col-sm-2 control-label">{{t "For" key="for"}}</label>
          <div class="col-sm-10">
            {{user-select select_id="for_user_id" selection=this.pending_board.for_user_id action=(this.ctrlAction "updatePendingBoardForUserId") }}
          </div>
        </div>
      {{/if}}
      <div class="form-group">
        <label for="pending_board_name" class="col-sm-2 control-label">{{t "Name" key="name"}}</label>
        <div class="col-sm-10">
          <input value={{this.pending_board.name}} id="pending_board_name" class="form-control" placeholder="Board name" {{on "input" (set-field this "pending_board.name")}} />
        </div>
      </div>
      <div class="form-group">
        <label for="pending_board_key" class="col-sm-2 control-label">{{t "Key" key="key"}}</label>
        <div class="col-sm-10">
          <input value={{this.pending_board.key}} id="pending_board_key" class="form-control" placeholder={{this.pending_board.key_placeholder}} {{on "input" (set-field this "pending_board.key")}} />
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label">{{t "Size" key="size"}}</label>
        <div class="col-sm-4">
          <div class="input-group">
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "minus" "pending_board.grid.rows")}}>-</button>
            </span>
            <input value={{this.pending_board.grid.rows}} class="form-control" id="pending_board_rows" placeholder="##" title="rows" {{on "input" (set-field this "pending_board.grid.rows")}} />
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "plus" "pending_board.grid.rows")}}>+</button>
            </span>
          </div>
          <em style="padding-left: 35px;">{{t "Rows" key="row"}}</em>
        </div>
        <div class="col-sm-2"><p class="form-control-static"> by </p></div>
        <div class="col-sm-4">
          <div class="input-group">
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "minus" "pending_board.grid.columns")}}>-</button>
            </span>
            <input value={{this.pending_board.grid.columns}} class="form-control" id="pending_board_columns" placeholder="##" title="columns" {{on "input" (set-field this "pending_board.grid.columns")}} />
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "plus" "pending_board.grid.columns")}}>+</button>
            </span>
          </div>
          <em style="padding-left: 35px;">{{t "Columns" key="columns"}}</em>
        </div>
      </div>
      <div class="form-group">
        <div class="col-sm-10 col-sm-offset-2">
          <div class="checkbox big_checkbox">
            <label>
              <input type="checkbox" checked={{this.pending_board.copy_access}} {{on "change" (set-field this "pending_board.copy_access" "checkbox")}} />
              {{t "Use same license and access settings as are set for this board" key="use_same_license"}}
            </label>
          </div>
        </div>
      </div>
      <div class="form-group">
        <div class="col-sm-10 col-sm-offset-2">
          <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "cancel_build_board")}}>{{t "Cancel" key="cancel"}}</button>
          <button type="button" class="btn btn-primary" {{on "click" (this.ctrlAction "create_board")}}>{{t "Create" key="create"}}</button>
        </div>
      </div>
    {{/if}}
  {{else if this.model.integrationOrWebhookAction}}
    {{#if this.has_supervisees}}
      <div class="form-group">
        <label for="for_user_id" class="col-sm-2 control-label">{{t "For" key="for"}}</label>
        <div class="col-sm-10">
          {{user-select select_id="for_user_id" selection=this.model.integration_user_id action=(this.ctrlAction "updateModelIntegrationUserId") }}
        </div>
      </div>
    {{/if}}
    <div class="form-group">
      <label for="tool" class="col-sm-2 control-label">{{t "Tool" key="tool"}}</label>
      <div class="col-sm-10">
        {{#if this.user_integrations.loading}}
          <p class='form-control-static'>{{t "Loading tools..." key="loading_tools"}}</p>
        {{else if this.user_integrations.error}}
          <p class='text-danger form-control-static'>{{t "Error loading tools" key="error_loading_tools"}}</p>
        {{else if this.user_integrations.content}}
          {{#unless this.user_integrations.content.length}}
            <p class='form-control-static'>{{t "You haven't connected any tools yet. Open a web browser and visit your User Profile page to add integrations." key="no_integrations_found"}}</p>
          {{else}}
            <BoundSelect @select_class="form-control" @select_id="integration" @content={{this.user_integrations.content}} @selection={{this.integration}} @action={{this.ctrlAction "updateIntegrationId"}} @optionLabelPath="content.name" />
          {{/unless}}
        {{/if}}
      </div>
    </div>
    {{#if this.integration}}
      {{#if this.integration.has_accounts}}
        <div class="form-group">
          <label for="account" class="col-sm-2 control-label">{{t "Account" key="account"}}</label>
          <div class="col-sm-10">
            {{#if this.integration.accounts}}
              <div class="row">
                <div class="col-sm-12">
                  <BoundSelect @select_class="form-control" @select_id="integration_account" @content={{this.integration.accounts}} @selection={{this.integration_account}} @action={{this.ctrlAction "updateIntegrationAccount"}} @optionLabelPath="content.label" />
                </div>
              </div>
            {{else}}
              <p class='text-muted form-control-static'>{{t "Loading account list..." key="loading_account_list"}}</p>
            {{/if}}
          </div>
        </div>
      {{/if}}
      {{#if this.integration.takes_inputs}}
        {{#if this.integration.fields}}
          {{#if this.integration.accounts}}
            {{#if this.integration_account}}
              {{!-- account selected --}}
            {{else}}
              <div class="form-group">
                <div class="col-sm-12">
                  <p class='text-muted form-control-static'>{{t "Choose an account above." key="choose_an_account"}}</p>
                </div>
              </div>
            {{/if}}
          {{/if}}
          {{#each this.integration.fields as |field|}}
            <div class="form-group">
              <label for={{field.name}} class="col-sm-2 control-label">{{field.label}}</label>
              <div class="col-sm-10">
                {{#if field.info}}
                  <p class='text-muted'>{{field.info}}</p>
                {{/if}}
                {{#if field.string}}
                  <Input @value={{field.value}} class="form-control" id={{field.name}} placeholder={{field.placeholder}} />
                {{else if field.boolean}}
                  <div class="checkbox big_checkbox">
                    <label>
                      <Input @checked={{field.value}} @type="checkbox" />
                    </label>
                  </div>
                {{else if field.preferred_languages}}
                  <BoundSelect @select_class="form-control" @select_id="pref_langs" @content={{field.preferred_languages}} @selection={{field.value}} @action={{this.ctrlAction "updateIntegrationFieldValue" field}} @optionValuePath="content.id" @optionLabelPath="content.label" />
                {{else if field.field_type_key}}
                  {{#if field.field_type_key.is_locale}}
                    <div class="row">
                      <div class="col-sm-9">
                        <Input @value={{field.value}} class="form-control" id={{field.name}} placeholder={{field.placeholder}} />
                      </div>
                      <div class="col-sm-3">
                        <BoundSelect @select_class="form-control" @select_id="pref_langs_for_locale" @content={{field.locales}} @selection={{field.locale}} @action={{this.ctrlAction "updateIntegrationFieldLocale" field}} @optionValuePath="content.code" @optionLabelPath="content.label" />
                      </div>
                    </div>
                  {{/if}}
                {{/if}}
              </div>
            </div>
          {{/each}}
        {{else}}
          <div class="form-group">
            <div class="col-sm-12">
              <p class='text-muted form-control-static'>{{t "Loading form..." key="loading_form"}}</p>
            </div>
          </div>
        {{/if}}
      {{/if}}
      {{#if this.integration.has_groups}}
        <div class="form-group">
          <label for="group" class="col-sm-2 control-label">{{t "Group" key="group"}}</label>
          <div class="col-sm-10">
            {{#if this.integration.groups}}
              <div class="row">
                <div class="col-sm-12">
                  <BoundSelect @select_class="form-control" @select_id="integration_group" @content={{this.integration.groups}} @selection={{this.integration_group}} @action={{this.ctrlAction "updateIntegrationGroup"}} @optionLabelPath="content.label" />
                </div>
              </div>
            {{else}}
              <p class='text-muted form-control-static'>{{t "Loading group list..." key="loading_group_list"}}</p>
            {{/if}}
          </div>
        </div>
      {{/if}}
      {{#if this.integration.takes_multiple_inputs}}
        <div class="form-group">
          <label for="max_inputs" class="col-sm-2 control-label">{{t "Max items" key="max_items"}}</label>
          <div class="col-sm-10">
            <div class="btn-group" role="group">
              <button type="button" class={{if this.max_inputs_is_exact "btn btn-default active" "btn btn-default"}} {{on "click" (this.ctrlAction "set_max_inputs_exact" true)}}>{{t "Exact" key="exact"}}</button>
              <button type="button" class={{unless this.max_inputs_is_exact "btn btn-default active" "btn btn-default"}} {{on "click" (this.ctrlAction "set_max_inputs_exact" false)}}>{{t "Up to" key="up_to"}}</button>
            </div>
            <span class="btn-group" role="group">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "max_inputs_minus")}}>-</button>
              <button type="button" class="btn btn-default" disabled>{{this.max_inputs}}</button>
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "max_inputs_plus")}}>+</button>
            </span>
          </div>
        </div>
      {{/if}}
      {{#if this.integration.show_sync_note}}
        <div class="form-group">
          <div class="col-sm-10 col-sm-offset-2">
            <p class='text-muted'>{{t "Note: these commands will only run online and will fail if not connected." key="integration_sync_note"}}</p>
          </div>
        </div>
      {{/if}}
    {{/if}}
  {{else if this.model.webhookAction}}
    <div class="form-group">
      <label class="col-sm-2 control-label">{{t "Webhook" key="webhook"}}</label>
      <div class="col-sm-10">
        {{#if this.webhook}}
          {{#if this.webhook.title}}
            <p class='form-control-static'><strong>{{this.webhook.title}}</strong></p>
          {{/if}}
          <p class='form-control-static'>{{this.webhook.url}}</p>
        {{else}}
          <p class='form-control-static'>{{t "Not set" key="not_set"}}</p>
        {{/if}}
        <p class='text-muted'>{{t "Webhooks can be configured for this user by opening their profile in a web browser." key="webhooks_setup_web"}}</p>
      </div>
    </div>
  {{else if this.model.exportAction}}
    <div class="form-group">
      <label for="format" class="col-sm-2 control-label">{{t "Format" key="format"}}</label>
      <div class="col-sm-10">
        <BoundSelect @select_class="form-control" @select_id="format" @content={{this.export_formats}} @selection={{this.model.export_format}} @action={{this.ctrlAction "updateModelExportFormat"}} @optionValuePath="content.id" @optionLabelPath="content.name" />
      </div>
    </div>
    <div class="form-group">
      <label for="print_size" class="col-sm-2 control-label">{{t "Print Size" key="print_size"}}</label>
      <div class="col-sm-10">
        <BoundSelect @select_class="form-control" @select_id="print_size" @content={{this.print_sizes}} @selection={{this.model.print_size}} @action={{this.ctrlAction "updateModelPrintSize"}} />
        <p class='text-muted'>{{t "There may be a short delay before your export is ready" key="delay_before_export"}}</p>
      </div>
    </div>
  {{else if this.model.enunciateAction}}
    <div class="form-group">
      <label class="col-sm-2 control-label">{{t "Audio Delay" key="audio_delay"}}</label>
      <div class="col-sm-10">
        <BoundSelect @select_class="form-control" @select_id="audio_delay" @content={{this.audio_delay_options}} @selection={{this.model.audio_delay}} @action={{this.ctrlAction "updateModelAudioDelay"}} />
        <p class='text-muted'>{{t "When enabled, audio will play without waiting for other sounds to finish." key="audio_delay_info"}}</p>
      </div>
    </div>
  {{else if this.model.integrationUserAction}}
    <div class="form-group">
      <label class="col-sm-2 control-label">{{t "Action" key="action"}}</label>
      <div class="col-sm-10">
        <BoundSelect @select_class="form-control" @select_id="integration_user_action" @content={{this.integration_user_actions}} @selection={{this.model.integration_user_action_key}} @action={{this.ctrlAction "updateModelIntegrationUserActionKey"}} @optionValuePath="content.id" @optionLabelPath="content.name" />
        <p class='text-muted'>{{t "Actions configure commands for the user; these are set up on the web." key="integration_user_action_info"}}</p>
      </div>
    </div>
  {{else if this.model.toggleFeatureAction}}
    <div class="form-group">
      <label class="col-sm-2 control-label">{{t "Feature" key="feature"}}</label>
      <div class="col-sm-10">
        <BoundSelect @select_class="form-control" @select_id="feature_toggle" @content={{this.feature_toggle_options}} @selection={{this.model.feature_toggle_key}} @action={{this.ctrlAction "updateModelFeatureToggleKey"}} @optionValuePath="content.id" @optionLabelPath="content.name" />
      </div>
    </div>
  {{else if this.model.volumeAction}}
    <div class="form-group">
      <label class="col-sm-2 control-label">{{t "Volume" key="volume"}}</label>
      <div class="col-sm-10">
        <div class="btn-group" role="group">
          <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "set_volume" "down")}}>{{t "Down" key="down"}}</button>
          <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "set_volume" "up")}}>{{t "Up" key="up"}}</button>
        </div>
        <div class="btn-group" role="group">
          <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "set_volume" "mute")}}>{{t "Mute" key="mute"}}</button>
          <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "set_volume" "max")}}>{{t "Max" key="max"}}</button>
        </div>
      </div>
    </div>
  {{else if this.model.keyCommandAction}}
    <div class="form-group">
