          {{/if}}
          <div class="md-bs-video__times">
            <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "set_time" "start")}}>{{t "Set Start" key="set_start"}}</button>
            <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "set_time" "end")}}>{{t "Set End" key="set_end"}}</button>
            <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "clear_times")}}>{{t "Clear Times" key="clear_times"}}</button>
          </div>
          <div class="md-bs-video__time-fields">
            <label class="md-bs-field-label" for="video_start">{{t "Start" key="start_at"}}</label>
            <input id="video_start" class="form-control md-bs-select md-bs-video__time-input" value={{this.model.video.start}} placeholder="0" {{on "input" (set-field this "model.video.start")}} />
            <span class="md-bs-video__time-unit">{{t "seconds" key="seconds"}}</span>
            <label class="md-bs-field-label" for="video_end">{{t "End" key="end_at"}}</label>
            <input id="video_end" class="form-control md-bs-select md-bs-video__time-input" value={{this.model.video.end}} placeholder={{t "ending" key="ending"}} {{on "input" (set-field this "model.video.end")}} />
            <span class="md-bs-video__time-unit">{{t "seconds" key="seconds"}}</span>
          </div>
        {{/if}}
