        <div class="col-sm-10 options">
          <span class="board_search_field">
            <input value={{this.android_app_name}} class="form-control" id="app_search_android" placeholder="App name" {{on "input" (set-field this "android_app_name")}} {{on-enter (this.ctrlAction "find_app")}} />
