        {{!-- Sound tab content (inlined) --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
<div class={{if this.soundState "active" "hidden"}}>
  <div class="form-group">
    <label for="vocalization" class="col-sm-2 control-label">{{t "Speak" key="speak"}}</label>
    <div class="col-sm-10 options">
      <span class="vocalization_field">
        <input value={{this.model.vocalization}} class="form-control inline" id="vocalization" placeholder={{this.label}} {{on "input" (set-field this "model.vocalization")}} />
      </span>
      <button type="button" {{on "click" (this.ctrlAction "record_sound")}} disabled={{this.recorder_unavailable}} class="btn btn-default">
        <img src={{path "images/microphone.svg"}} style="height: 20px; margin: -15px -3px -13px -3px;" alt="record_a_sound">
      </button>
      <span class="file_select_holder">
        <button type="button" class='btn btn-default'>
          <img src={{path "images/upload.svg"}} style="height: 30px; margin: -10px -6px -6px;" alt="upload">
        </button>
        <input type="file" name="sound_upload" id="sound_upload" accept="audio/*" tabindex="-1" aria-label={{t "Upload Sound" key="upload_sound"}}>
      </span>
      {{#unless this.sound_preview}}
        {{#unless this.model.sound.url}}
          {{#unless this.browse_audio}}
            <div>
              <a href="#" {{on "click" (this.ctrlAction "browse_audio")}}>{{t "browse stored audio" key="browse_audio"}}</a>
            </div>
          {{/unless}}
        {{/unless}}
      {{/unless}}
    </div>
  </div>
  <div class="form-group">
    <label for="blocking_speech" class="col-sm-2 control-label">{{t "Hold" key="hold"}}</label>
    <div class="col-sm-10">
      <div class="checkbox big_checkbox">
        <label>
          <input type="checkbox" checked={{this.model.blocking_speech}} {{on "change" (set-field this "model.blocking_speech" "checkbox")}} />
          {{t "Hold other speech until this button completes" key="hold_other_speech_until_this_button_completes"}}
        </label>
      </div>
    </div>
  </div>
  {{#if this.browse_audio}}
    <div class="col-sm-10 col-sm-offset-2">
    <AudioBrowser @audio_selected={{this.ctrlAction "audio_selected"}} @prompt={{this.model.vocalization}} @fallback_prompt={{this.model.label}} />
    <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clear_sound_work")}}>{{t "Clear Sound" key="clear_sound"}}</button>
    </div>
  {{else if this.sound_preview}}
    {{#if this.vocalization_sound_conflict}}
      <p class='text_danger'>{{t "WARNING: Sound attachments will be removed if there is a value in the 'Speak' field" key="vocalization_sound_conflict"}}</p>
    {{/if}}
    <div style="text-align: center;">
      Selected sound{{#if this.sound_preview.name}} ({{this.sound_preview.name}}){{/if}}:<br>
      <audio controls src={{this.sound_preview.url}} aria-label={{t "Selected sound preview" key="selected_sound_preview"}}></audio>
    </div>
    <div style="margin-top: 10px;">
      <div class="form-group">
        <div class="col-sm-2 control-label">{{t "Name" key="name"}}</div>
        <div class='col-sm-10'>
          <input type="text" value={{this.sound_preview.name}} aria-label={{t "Sound name" key="sound_name"}} class="form-control" {{on "input" (set-field this "sound_preview.name")}} />
        </div>
      </div>
    </div>

    <div style="margin-top: 10px;">
      <PickLicense @license={{this.sound_preview.license}} />
    </div>
    <div style="margin-top: 10px;">
      <button type="button" {{on "click" (this.ctrlAction "clear_sound_work")}} class='btn btn-default'>{{t "Cancel" key="cancel"}}</button>
      {{#if this.sound_preview.from_recording}}
        <button type="button" {{on "click" (this.ctrlAction "record_sound")}} class='btn btn-default'>
          {{t "Try Again" key="try_again"}}
        </button>
      {{/if}}
      <button type="button" {{on "click" (this.ctrlAction "select_sound_preview")}} class='btn btn-primary'>{{t "Use This" key="use_this"}}</button>
    </div>
  {{else}}
    {{#if this.sound_record.error}}
      <p>{{t "There was an error while trying to record audio" key="error_recording_audio"}}</p>
    {{else if this.sound_recording.ready}}
      {{#if this.vocalization_sound_conflict}}
        <p class='text_danger'>{{t "WARNING: Sound attachments will be removed if there is a value in the 'Speak' field" key="vocalization_sound_conflict"}}</p>
      {{/if}}
      <button id="recording_status" type="button" {{on "click" (this.ctrlAction "toggle_recording_sound")}} class={{if this.sound_recording.recording "recording"}} aria-pressed={{if this.sound_recording.recording "true" "false"}}>
        <span class="sub_status">
          <span>Start</span>
        </span>
      </button>
      {{#unless this.capabilities.mobile}}
        <div class='col-sm-10 col-sm-offset-2 text-muted' style='margin-top: -20px; margin-bottom: 20px;'>{{t "Hit spacebar to start/stop without recording a clicking sound" key="spacebar_to_silently_toggle_recording"}}</div>
      {{/unless}}
      <canvas id="sound_levels" width="400" height="300" style="display: none;"></canvas>
      <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clear_sound_work")}}>{{t "Cancel" key="cancel"}}</button>
      <button type="button" {{on "click" (this.ctrlAction "toggle_recording_sound")}} class='btn btn-primary'>
        {{#if this.sound_recording.recording}}
          {{t "Stop" key="stop"}}
        {{else}}
          {{t "Start" key="start"}}
        {{/if}}
      </button>
    {{else}}
      {{#if this.model.sound.url}}
        {{#if this.vocalization_sound_conflict}}
          <p class='text_danger'>{{t "WARNING: Sound attachments will be removed if there is a value in the 'Speak' field" key="vocalization_sound_conflict"}}</p>
        {{/if}}
        <div style="margin-bottom: 10px; text-align: center;">
          {{t "Played sound:" key="played_sound_colon"}} ({{this.model.sound.extension}})<div style='width: 100%; overflow: hidden;'>{{this.model.sound.name}}</div><br>
          <audio controls src={{this.model.sound.url}} aria-label={{t "Played sound" key="played_sound"}}></audio>
        </div>
        <PickLicense @license={{this.model.sound.license}} />
        <br>
        <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clear_sound")}}>{{t "Clear Sound" key="clear_sound"}}</button>
      {{else}}
        <div style="margin-bottom: 10px; text-align: center;">
          {{#if this.modifiers}}
            {{#each this.modifiers as |mod|}}
              {{#if mod.special}}
                <strong>{{mod.special}}</strong> {{t "when selected" key="when_selected"}}<br>
              {{else if mod.modifier}}
                <strong>{{mod.modifier}}</strong> {{t "modifier via Text-To-Speech" key="modifying_via_tts"}}<br>
              {{else if mod.text}}
                <strong>{{mod.text}}</strong> {{t "via Text-To-Speech" key="via_tts"}}<br>
              {{/if}}
            {{/each}}
            {{#if this.modifiers.any_basic}}
              <span class="modifier_example_field">
                <input value={{this.modifier_text}} class="form-control" id="modifier" placeholder="enter a word to hear it modified" aria-label={{t "Word to modify" key="word_to_modify"}} {{on "input" (set-field this "modifier_text")}} />
              </span>
            {{/if}}
          {{else}}
            {{#if this.model.vocalization}}
              <strong>"{{this.model.vocalization}}"</strong> {{t "via Text-To-Speech" key="via_tts"}}
            {{else}}
              <strong>"{{this.model.label}}"</strong> {{t "via Text-To-Speech" key="via_tts"}}
            {{/if}}
          {{/if}}
        </div>
        {{#unless this.modifiers.none}}
          <div style="text-align: center;">
            <button type="button" {{on "click" (this.ctrlAction "testVocalization" this)}} class="btn btn-default">{{t "Listen" key="listen"}}</button>
          </div>
        {{/unless}}
      {{/if}}
    {{/if}}
  {{/if}}
</div>
        </form>

        {{!-- Language tab content (inlined) --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
<div class={{if this.languageState "active" "hidden"}}>
  {{#each this.model.translations as |locale|}}
    <div class="form-group">
      <label for="label" class="col-sm-2 control-label">{{t "Language" key="language"}}</label>
      <div class="col-sm-10">
        <p class='form-control-static'>{{locale.locale}}</p>
      </div>
    </div>
    <div class="form-group">
      <label for={{locale.label_id}} class="col-sm-4 control-label">{{t "Label" key="label"}}</label>
