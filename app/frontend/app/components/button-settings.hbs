              <div class="form-group">
                <div class="col-sm-12">
                  <p class='text-muted form-control-static'>{{t "Choose an account above." key="choose_an_account"}}</p>
                </div>
              </div>
            {{/if}}
          {{/if}}
          {{#each this.integration.fields as |field|}}
            <div class="form-group">
              <label for={{field.name}} class="col-sm-2 control-label">{{field.label}}</label>
