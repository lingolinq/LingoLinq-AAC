      {{#if this.level_overrides.hidden}}
        <div class='form-group'>
          <label class='col-sm-offset-2 col-sm-4'>
            {{t "Visibility" key="visibility"}}
          </label>
          <div class='col-sm-6'>
            {{#if this.level_overrides.hidden.set_true}}
              {{t "Never Show Button" key="never_show_button"}}
            {{else}}
              {{t "Always Show Button" key="always_show_button"}}
            {{/if}}
            <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clear_override" "hidden")}}>{{t "Clear" key="clear_override"}}</button>
          </div>
        </div>
      {{/if}}
      {{#if this.level_overrides.link_disabled}}
        <div class='form-group'>
          <label class='col-sm-offset-2 col-sm-4'>
            {{t "Links" key="links"}}
          </label>
          <div class='col-sm-6'>
            {{#if this.level_overrides.hidden.set_true}}
              {{t "Never Disable Link" key="never_disable_link"}}
            {{else}}
              {{t "Always Disable Link" key="always_disable_link"}}
            {{/if}}
            <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clear_override" "link_disabled")}}>{{t "Clear" key="clear_override"}}</button>
          </div>
        </div>
      {{/if}}
      <div class='form-group'>
        <label for='hidden_level' class='col-sm-offset-2 col-sm-4'>
          {{#if this.level_overrides.hidden}}
            <s>{{t "Hide Until Level" key="hide_until_level"}}</s>
          {{else}}
            {{t "Hide Until Level" key="hide_until_level"}}
          {{/if}}
        </label>
        <div class='col-sm-6'>
            <BoundSelect @select_class="form-control" @select_id="hidden_level" @content={{this.board_levels}} @selection={{this.model.hidden_level}} @action={{this.ctrlAction "updateModelHiddenLevel"}} />
        </div>
      </div>
      {{#unless this.model.talkAction}}
        <div class='form-group'>
          <label for='link_disabled_level' class='col-sm-offset-2 col-sm-4'>
            {{#if this.level_overrides.link_disabled}}
              <s>{{t "Disable Link Until Level" key="disable_link_until_level"}}</s>
            {{else}}
              {{t "Disable Link Until Level" key="disable_link_until_level"}}
            {{/if}}
          </label>
          <div class='col-sm-6'>
            <BoundSelect @select_class="form-control" @select_id="link_disabled_level" @content={{this.board_levels}} @selection={{this.model.link_disabled_level}} @action={{this.ctrlAction "updateModelLinkDisabledLevel"}} />
          </div>
        </div>
      {{/unless}}
    {{else if this.advanced_level_style}}
      <div class='form-group'>
        <div class='col-sm-2'>
          <p class='form-control-static'>{{t "Level Settings" key="level_settings"}}</p>
        </div>
        <div class='col-sm-10'>
          <Textarea @value={{this.model.level_json}} class="form-control" placeholder="level override configuration" />
        </div>
      </div>
    {{/if}}
    {{#if this.appState.feature_flags.inflections_overlay}}
      <div class='form-group'>
        <label for="inflections" class="col-sm-2 control-label">{{t "Inflections" key="inflections"}}</label>
        <div class='col-sm-10'>
          <p class='form-control-static'>{{t "When users enable inflections and long-press on the button, these are the options they will see:" key="inflections_overlay_description"}}</p>
          <div>
            {{#if this.board.translations}}
              <p>{{t "See the \"Language\" section for per-language inflections" key="see_language_for_inflections"}}</p>
            {{else}}
              <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
                <input value={{this.inflections_hash.nw}} class="form-control" placeholder={{this.inflections_suggestions.nw}} {{on "input" (set-field this "inflections_hash.nw")}} />
              </div>
              <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
                <input value={{this.inflections_hash.n}} class="form-control" placeholder={{this.inflections_suggestions.n}} {{on "input" (set-field this "inflections_hash.n")}} />
              </div>
              <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
                <input value={{this.inflections_hash.ne}} class="form-control" placeholder={{this.inflections_suggestions.ne}} {{on "input" (set-field this "inflections_hash.ne")}} />
              </div>
              <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
                <input value={{this.inflections_hash.w}} class="form-control" placeholder={{this.inflections_suggestions.w}} {{on "input" (set-field this "inflections_hash.w")}} />
              </div>
              <div style='float: left; width: calc(33% - 10px); margin: 5px; text-align: center; overflow: hidden;'>
                {{this.model.label}}
              </div>
              <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
                <input value={{this.inflections_hash.e}} class="form-control" placeholder={{this.inflections_suggestions.e}} {{on "input" (set-field this "inflections_hash.e")}} />
              </div>
              <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
                <input value={{this.inflections_hash.sw}} class="form-control" placeholder={{this.inflections_suggestions.sw}} {{on "input" (set-field this "inflections_hash.sw")}} />
              </div>
              <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
                <input value={{this.inflections_hash.s}} class="form-control" placeholder={{this.inflections_suggestions.s}} {{on "input" (set-field this "inflections_hash.s")}} />
              </div>
              <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
                <input value={{this.inflections_hash.se}} class="form-control" placeholder={{this.inflections_suggestions.se}} {{on "input" (set-field this "inflections_hash.se")}} />
              </div>
              <div>
                <Textarea @value={{this.rules_string}} class="form-control" placeholder={{this.inflection_overrides_placeholder}} />
              </div>
            {{/if}}
          </div>
        </div>
      </div>
    {{/if}}
  <div class="form-group">
    <label for="ref_id" class="col-sm-2 control-label" style='padding-left: 0; padding-right: 0;'>{{t "Pointer ID" key="pointer_id"}}</label>
    <div class="col-sm-10">
      <input value={{this.model.ref_id}} class="form-control" id="ref_id" placeholder="ID for custom referencing" {{on "input" (set-field this "model.ref_id")}} />
    </div>
  </div>

</div>
</form>
      </div>
    </div>
  </div>
  <div class="modal-footer md-modal-footer">
    <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "clear_button")}}>{{t "Clear Button" key="clear_button"}}</button>
    <a href="#" class="btn btn-default btn-lg" {{on "click" (this.ctrlAction "close")}} style='vertical-align: top;'>{{t "Close" key="close"}}</a>
  </div>
  {{#if this.show_clear_confirm}}
    <div class="ll-confirm-overlay" role="alertdialog" aria-modal="true" aria-labelledby="clear-confirm-title" aria-describedby="clear-confirm-desc">
      <div class="ll-confirm-card">
        <h4 id="clear-confirm-title" class="ll-confirm-title">{{t "Clear Button" key="clear_button"}}</h4>
        <p id="clear-confirm-desc" class="ll-confirm-desc">{{t "Are you sure you want to clear this button? This will remove the label, image, and all settings." key="clear_button_confirm"}}</p>
        <div class="ll-confirm-actions">
          <button type="button" class="ll-confirm-btn ll-confirm-btn--cancel" {{on "click" (this.ctrlAction "cancel_clear_button")}}>{{t "Cancel" key="cancel"}}</button>
          <button type="button" class="ll-confirm-btn ll-confirm-btn--danger" {{on "click" (this.ctrlAction "confirm_clear_button")}}>{{t "Clear" key="clear"}}</button>
        </div>
      </div>
    </div>
  {{/if}}
</ModalDialog>
