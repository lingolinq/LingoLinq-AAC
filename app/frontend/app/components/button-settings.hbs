<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="md-bs-header__title-row">
      <h3>{{t "Button Settings" key="button_settings"}}</h3>
      {{!-- A live copy of the button as it looks in speak mode (fill + border
           colour, symbol, label) instead of just the text label. --}}
      <span class="md-bs-header__button {{if this.preview_text_only 'md-bs-preview--text-only'}} {{if this.preview_text_on_top 'md-bs-preview--text-top'}}" style={{safe-style (concat "background-color:" this.model.background_color "; border-color:" this.model.border_color ";")}} aria-label={{concat (t "Button preview" key="button_preview") ": " this.model.label}}>
        {{#unless this.preview_text_only}}
          {{#if this.model.local_image_url}}
            <img class="md-bs-header__button-img" src={{this.model.local_image_url}} alt="" onerror="button_broken_image(this);">
          {{/if}}
        {{/unless}}
        <span class="md-bs-header__button-label">{{this.model.label}}</span>
      </span>
    </div>
  </div>
  <div class="modal-body md-modal-body" id="button_settings">
    <div class="row">
      <div class="col-sm-3">
        <ul class="nav nav-pills nav-stacked" role="tablist">
          <li class={{if this.helpState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.helpState "true" "false"}} {{on "click" (this.ctrlAction "setState" "help")}}>{{t "Quick Actions" key="quick_actions"}}</a></li>
          <li class="md-bs-nav-sep" role="presentation" aria-hidden="true"><div class="md-bs-card__sep"></div></li>
          {{!-- Items below are alphabetized (Help stays pinned at the top). Tabs
               ({{action "setState"}}) and quick ACTIONS (color/stash/word_data/clear
               — which close the modal, see components/button-settings.js) interleave
               by their visible label. --}}
          <li class={{if this.actionState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.actionState "true" "false"}} {{on "click" (this.ctrlAction "setState" "action")}}>{{t "Action" key="action"}}</a></li>
          {{#if this.is_modern}}<li class={{if this.colorState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.colorState "true" "false"}} {{on "click" (this.ctrlAction "setState" "color")}}>{{t "Color" key="color"}}</a></li>{{/if}}
          {{#if this.appState.feature_flags.board_levels}}
            <li class={{if this.extrasState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.extrasState "true" "false"}} {{on "click" (this.ctrlAction "setState" "extras")}}>{{t "Extras" key="extras"}}</a></li>
          {{/if}}
          <li class={{if this.generalState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.generalState "true" "false"}} {{on "click" (this.ctrlAction "setState" "general")}}>{{t "General" key="general"}}</a></li>
          {{#if this.board.translations}}
            <li class={{if this.languageState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.languageState "true" "false"}} {{on "click" (this.ctrlAction "setState" "language")}}>{{t "Language" key="language"}}</a></li>
          {{/if}}
          <li class={{if this.pictureState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.pictureState "true" "false"}} {{on "click" (this.ctrlAction "setState" "picture")}}>{{t "Picture" key="picture"}}</a></li>
          <li class={{if this.soundState "active" "inactive"}} role="presentation"><a href="#" role="tab" aria-selected={{if this.soundState "true" "false"}} {{on "click" (this.ctrlAction "setState" "sound")}}>{{t "Sound" key="sound"}}</a></li>
          {{#if this.is_modern}}
          <li class="inactive md-button-settings__nav-action" role="presentation"><a href="#" role="button" {{on "click" (this.ctrlAction "stash_this_button")}}>{{t "Stash" key="stash"}}</a></li>
          <li class="inactive md-button-settings__nav-action" role="presentation"><a href="#" role="button" {{on "click" (this.ctrlAction "word_data_this_button")}}>{{t "Word Data" key="view_word_data_title"}}</a></li>
          {{/if}}
        </ul>
      </div>
      <div class="col-sm-9 content" role="tabpanel">
        {{!-- Help tab content --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
        <div class={{if this.helpState "active" "hidden"}}>
          <div class="form-group md-bs-help__head">
            <div class="col-sm-12">
              <div style='position: relative;'>
                <h4>{{t "Button Settings" key="button_settings"}}</h4>
              </div>
            </div>
          </div>
          <div class="form-group">
            <div class="col-sm-12">
              <div class="md-bs-card__eyebrow">{{t "Quick actions" key="quick_actions"}}</div>
              <div class="md-bs-card__sep" aria-hidden="true"></div>
              <div class='btn-group-vertical' style='width: 90%;'>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "picture")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-picture' style='margin-right: 3px;'></span> {{t "Change this Button's Picture" key="change_image"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "label")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-edit' style='margin-right: 3px;'></span> {{t "Change this Button's Label" key="change_label"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "sound")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-volume-down' style='margin-right: 3px;'></span> {{t "Change what this Button Speaks" key="change_speak_sound"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "folder")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-folder-open' style='margin-right: 3px;'></span> {{t "Link to Another Board" key="link_to_board"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "url")}} class='btn btn-lg btn-default' style='text-align: left;'><span class='glyphicon glyphicon-link' style='margin-right: 3px;'></span> {{t "Link to a Web Site or Video" key="link_to_web_site"}}</button>
                <button type="button" {{on "click" (this.ctrlAction "quick_action" "hide")}} class='btn btn-lg btn-default' style='text-align: left;'>
                  {{#if this.model.hidden}}
                    <span class='glyphicon glyphicon-eye-open' style='margin-right: 3px;'></span> {{t "Un-Hide this Button" key="unhide_this_button"}}
                  {{else}}
                    <span class='glyphicon glyphicon-eye-close' style='margin-right: 3px;'></span> {{t "Hide this Button" key="hide_this_button"}}
                  {{/if}}
                </button>
                {{#if this.paint_hide_reminder}}
                  <em class='text-muted' style='font-size: 14px;'>{{t "Remember, you can hide/show multiple buttons more quickly using the Paint tool!" key="hide_and_show_using_paint"}}</em>
                {{/if}}
              </div>
              {{!-- Hidden for now — the "Skip this help / Start here in the future"
                   auto-help toggle. Restore this block to bring it back.
              <div class="md-bs-help__skip-wrap">
                {{#if this.auto_help}}
                  <button type="button" {{on "click" (this.ctrlAction "disable_auto_help")}} class='md-bs-help__skip'>{{t "Skip this help in the future" key="skip_help"}}</button>
                {{else if this.appState.currentUser.preferences.disable_button_help}}
                  <button type="button" {{on "click" (this.ctrlAction "enable_auto_help")}} class='md-bs-help__skip'>{{t "Start here in the future" key="re_enable_help"}}</button>
                {{/if}}
              </div>
              --}}
            </div>
          </div>
        </div>
        </form>

        {{!-- General tab content --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
        <div class={{if this.generalState "active" "hidden"}}>
          <div class="form-group">
            <label for="label" class="col-sm-2 control-label">{{t "Label" key="label"}}</label>
            <div class="col-sm-10">
              <input value={{this.model.label}} class="form-control" id="label" {{on "input" (set-field this "model.label")}} />
            </div>
          </div>
          <div class="form-group">
            <label for="part_of_speech" class="col-sm-2 control-label">{{t "Word" key="part_of_speech"}}</label>
            <div class="col-sm-10">
              <BoundSelect @select_class="form-control" @select_id="part_of_speech" @content={{this.parts_of_speech}} @selection={{this.model.part_of_speech}} @action={{this.ctrlAction "updateModelPartOfSpeech"}} />
            </div>
          </div>
          <div class="form-group">
            <label for="fill" class="col-sm-2 control-label">{{t "Fill" key="fill"}}</label>
            <div class="col-sm-10">
              <span role="button" tabindex="0" {{on "click" (this.ctrlAction "toggle_color" "fill")}} style="display: inline-block; border-width: 3px; border: 2px dotted #ccc; height: 34px; width: 70px; vertical-align: bottom; cursor: pointer;" class={{this.fake_button_class}} aria-label={{t "Choose fill color" key="choose_fill_color"}}></span>
              <span class="button_field">
                <input value={{this.model.background_color}} class="form-control" id="fill" {{on "input" (set-field this "model.background_color")}} />
              </span>
              <br>
              <em style="font-size: 14px; line-height: 12px;">{{t "You can also color multiple buttons at once with standard color schemes using the Paint button" key="use_paint_button"}}</em>
            </div>
          </div>
          <div class="form-group">
            <label for="border" class="col-sm-2 control-label">{{t "Border" key="border"}}</label>
            <div class="col-sm-10">
              <span role="button" tabindex="0" {{on "click" (this.ctrlAction "toggle_color" "border")}} id="background_pattern" style={{safe-style (concat "display: inline-block; height: 34px; width: 70px; vertical-align: bottom; border: 6px solid " this.model.border_color "; background-color:" this.model.background_color "; cursor: pointer;")}} aria-label={{t "Choose border color" key="choose_border_color"}}></span>
              <span class="button_field">
                <input value={{this.model.border_color}} class="form-control" id="border" {{on "input" (set-field this "model.border_color")}} />
              </span>
            </div>
          </div>
          <div class="form-group">
            <label for="hidden" class="col-sm-2 control-label">{{t "Hidden" key="hidden"}}</label>
            <div class="col-sm-10">
              <div class="checkbox big_checkbox">
                <label>
                  <input type="checkbox" checked={{this.model.hidden}} {{on "change" (set-field this "model.hidden" "checkbox")}} />
                  {{t "Hide this button from view" key="hide_this_button_from_view"}}
                </label>
              </div>
            </div>
          </div>
          <div class="form-group">
            <div class="col-sm-10 col-sm-offset-2">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "clear_button")}}>{{t "Clear" key="clear"}}</button>
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "swapButton")}}>{{t "Swap With..." key="swap_with"}}</button>
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "stash_button")}}>
                {{#if this.stashed}}
                  <span class="glyphicon glyphicon-check"></span>
                  {{t "Copied to Stash" key="copied_to_stash"}}
                {{else}}
                  {{t "Copy to Stash" key="copy_to_stash"}}
                {{/if}}
              </button>
            </div>
          </div>
        </div>
        </form>

        {{!-- Color tab content --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
        <div class={{if this.colorState "active" "hidden"}}>
          <section class="md-bs-card md-bs-card--config">
            <div class="md-bs-card__eyebrow">{{t "Color" key="color"}}</div>
            <div class="md-bs-card__sep" aria-hidden="true"></div>
            <div class="md-bs-color__preview-wrap">
              <div class="md-bs-color__preview {{if this.preview_text_only 'md-bs-preview--text-only'}} {{if this.preview_text_on_top 'md-bs-preview--text-top'}}" style={{safe-style (concat "background-color: " this.model.background_color "; border-color: " this.model.border_color ";")}}>
                {{#unless this.preview_text_only}}
                  {{#if this.model.local_image_url}}
                    <img class="md-bs-color__preview-img" src={{this.model.local_image_url}} alt="" onerror="button_broken_image(this);">
                  {{/if}}
                {{/unless}}
                <span class="md-bs-color__preview-label">{{this.model.label}}</span>
              </div>
            </div>
            <div class="md-bs-color__field-label">{{t "Choose a color" key="choose_a_color"}}</div>
            <div class="md-bs-color__swatches">
              {{#each this.color_swatches as |color|}}
                <button type="button" class="md-bs-color__swatch {{if (is_equal this.model.background_color color.fill) "is-selected"}}" title={{color.color}} aria-label={{color.color}} {{on "click" (this.ctrlAction "pick_color" color)}}>
                  <span class="md-bs-color__swatch-chip" style={{color.style}}></span>
                  <span class="md-bs-color__swatch-name">{{color.color}}</span>
                  {{#if color.hint}}<span class="md-bs-color__swatch-hint">{{color.hint}}</span>{{/if}}
                </button>
              {{/each}}
            </div>
            <div class="md-bs-color__field-label md-bs-color__field-label--custom">{{t "Custom color" key="custom_color"}}</div>
            <div class="md-bs-color__custom">
              <div class="md-bs-color__custom-row">
                <span class="md-bs-color__custom-label">{{t "Fill" key="fill"}}</span>
                <input type="color" class="md-bs-color__picker" value={{this.custom_fill_hex}} {{on "input" (this.ctrlActionEventValue "set_custom_fill" "value")}} aria-label={{t "Custom fill color" key="custom_fill_color"}} />
                <input type="text" class="form-control md-bs-color__value" value={{this.model.background_color}} {{on "input" (set-field this "model.background_color")}} aria-label={{t "Fill color value" key="fill_color_value"}} />
              </div>
              <div class="md-bs-color__custom-row">
                <span class="md-bs-color__custom-label">{{t "Border" key="border"}}</span>
                <input type="color" class="md-bs-color__picker" value={{this.custom_border_hex}} {{on "input" (this.ctrlActionEventValue "set_custom_border" "value")}} aria-label={{t "Custom border color" key="custom_border_color"}} />
                <input type="text" class="form-control md-bs-color__value" value={{this.model.border_color}} {{on "input" (set-field this "model.border_color")}} aria-label={{t "Border color value" key="border_color_value"}} />
              </div>
            </div>
            <div class="md-bs-color__footer">
              <button type="button" class="md-bs-choose__change" {{on "click" (this.ctrlAction "revert_color")}}>
                <svg class="md-bs-dest__change-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"></path></svg>
                {{t "Revert Color" key="revert_color"}}
              </button>
            </div>
          </section>
        </div>
        </form>

        {{!-- Picture tab content (inlined) --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
        <div class="md-bs-picture {{if this.pictureState "active" "hidden"}}">
  {{!-- Current picture at the TOP (replaces the PICTURE section header) — shows the
       button's existing image before the find/choose workflow below. --}}
  {{#if this.model.image.url}}
    {{#unless this.image_preview}}
      <div class="md-bs-card__eyebrow md-bs-picture__current-eyebrow">{{t "Current Picture" key="current_picture"}}</div>
      <section class="md-bs-card md-bs-picture__current">
        <div class="md-bs-picture__current-thumb">
          <img src={{or this.fresh_picture_url this.model.image.url this.model.image.best_url_without_preferred_symbols}} alt="">
        </div>
        <div class="md-bs-picture__current-meta">
          <div class="md-bs-picture__current-title">{{t "Current image" key="current_image"}}</div>
          {{#if this.model.label}}
            <div class="md-bs-picture__current-sub">{{t "Used for" key="used_for_label"}} “{{this.model.label}}”</div>
          {{/if}}
        </div>
      </section>
    {{/unless}}
  {{/if}}

  {{!-- One unified "Find a picture" card: library, search, own-image sources. --}}
  <section class="md-bs-card md-bs-picture__find">
    <div class="md-bs-card__eyebrow">{{t "Find a Picture" key="find_a_picture"}}</div>
    {{#if this.show_libraries}}
      <label class="md-bs-picture__field-label" for="image_library">{{t "Library" key="library"}}</label>
      {{#if this.image_libraries}}
        <BoundSelect @select_class="form-control skip_select md-bs-picture__library" @select_id="image_library" @short={{true}} @content={{this.image_libraries}} @selection={{this.image_library}} @action={{this.ctrlAction "updateImageLibrary"}} />
      {{else}}
        <div class="md-bs-picture__library-static">{{t "opensymbols.org" key="library_open_symbols_short"}}</div>
      {{/if}}
      {{#if this.premium_symbol_library}}
        {{#if this.appState.currentUser.subscription.grace_trial_period}}
          <div class='text-danger md-bs-picture__premium-note'>{{t "(requires extra fee after trial period)" key="extra_fee_at_purchase"}}</div>
        {{/if}}
      {{/if}}
    {{/if}}
    <div class="md-bs-picture__search-row">
      <span class="picture_search_field">
        <span class={{if this.multi_locales "picture_search_input_with_locale" "picture_search_input_full"}}>
          <input id="find_picture" value={{this.model.image_field}} {{on "input" (set-field this "model.image_field")}} {{on-enter (this.ctrlAction "find_picture")}} placeholder={{this.search_prompt}} aria-label={{this.search_prompt}} class="form-control inline select_on_click" />
        </span>
        {{#if this.multi_locales}}
          <span style='display: inline-block; width: 55px; vertical-align: middle;'>
            <div class="btn-group" style='vertical-align: middle;'>
              <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style='width: 100%;'>
                <span style='vertical-align: middle; max-width: 20px; overflow: hidden; display: inline-block;'>{{this.search_locale}}</span>
                <span class="caret"></span>
              </button>
              <ul class="dropdown-menu">
                {{#each this.locales as |loc|}}
                  <li><a href="#" {{on "click" (this.ctrlAction "set_locale" loc.id)}}>{{loc.name}}</a></li>
                {{/each}}
              </ul>
            </div>
          </span>
        {{/if}}
      </span>
      <button type="button" class='btn btn-default md-bs-picture__search-btn' {{on "click" (this.ctrlAction "find_picture")}}>{{t "Search" key="search"}}</button>
    </div>

    {{!-- Search options (skin tone / safe search) MOVED into the Search section
         below, grouped with the results they refine under the Search header. --}}

    {{!-- Other ways to add a picture (labeled, not icon-only). --}}
    <div class="md-bs-picture__field-label md-bs-picture__sources-label">{{t "Or add your own" key="or_add_your_own"}}</div>
    <div class="md-bs-picture__sources">
      <button type="button" class="md-bs-picture__source-btn" {{on "click" (this.ctrlAction "webcamPicture")}} disabled={{this.webcam_unavailable}}>
        <img src={{path "images/camera.svg"}} class="md-bs-picture__source-icon" alt=""> {{t "Take photo" key="take_photo"}}
      </button>
      <span class="file_select_holder md-bs-picture__source-file">
        <button type="button" class="md-bs-picture__source-btn">
          <img src={{path "images/upload.svg"}} class="md-bs-picture__source-icon" alt=""> {{t "Upload image" key="upload_image"}}
        </button>
        <input type="file" name="image_upload" id="image_upload" accept="image/*" tabindex="-1" aria-label={{t "Upload image" key="upload_image"}}>
      </span>
      <button type="button" class="md-bs-picture__source-btn" {{on "click" (this.ctrlAction "word_art")}}>
        <span class="md-bs-picture__source-icon md-bs-picture__source-icon--wordart" aria-hidden="true">T</span> {{t "Create word art" key="create_word_art"}}
      </button>
    </div>
  </section>

  {{!-- Per-button picture/label options — below the Find a Picture card.
       hide_label: image only (no caption). text_only: stretch label, no image
       (restored from pre-Ember-5.12 button-settings-picture.hbs). --}}
  <div class="md-bs-picture__label-options">
    <label class="md-bs-picture__hide-label">
      <input type="checkbox" checked={{this.model.hide_label}} {{on "change" (this.ctrlActionEventValue "updateHideLabel" "checked")}} {{on "change" (set-field this "model.hide_label" "checkbox")}} />
      {{t "Hide the label when the picture is shown" key="hide_label"}}
    </label>
    <label class="md-bs-picture__text-only">
      <input type="checkbox" checked={{this.model.text_only}} {{on "change" (this.ctrlActionEventValue "updateTextOnly" "checked")}} {{on "change" (set-field this "model.text_only" "checkbox")}} />
      {{t "Show only text (as large as fits) for this button" key="stretch_text_only"}}
    </label>
  </div>

  <div style="text-align: center;" class={{if this.webcam "shown" "hidden"}}>
    {{#if this.webcam.error}}
      <p>{{t "There was an error loading the camera" key="error_loading_camera"}}</p>
    {{else}}
      <video autoplay id="webcam_video" {{on "click" (this.ctrlAction "webcamToggle" true)}} class={{this.webcam_class}} aria-label={{t "Camera preview" key="camera_preview"}}></video>
      <canvas id="webcam_canvas" style="display:none;" width="800" height="800"></canvas>
      {{#unless this.webcam.snapshot}}
        <br>
        <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
        {{#if this.webcam.video_streams}}
          <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "swapStreams")}}>{{t "Switch Views" key="switch_cameras"}}</button>
        {{/if}}
        <button type="button" class='btn btn-primary' {{on "click" (this.ctrlAction "webcamToggle" true)}}>{{t "Take Pic" key="take_pic"}}</button>
      {{/unless}}
    {{/if}}
  </div>

  {{#if this.image_preview}}
    {{#if this.image_preview.error}}
      {{this.image_preview.error}}
      <div style='margin-top: 10px;'>
        <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
      </div>
    {{else}}
      <div style="text-align: center;">
        {{#if this.image_preview.word_editor}}
          <iframe src="https://www.opensymbols.org/word_maker#embed" style="width: 100%; height: 225px;" frameborder="0" title="Word art editor"></iframe>
        {{else if this.image_preview.editor}}
          <iframe src="https://www.opensymbols.org/editor#embed" style="width: 100%; height: 225px;" frameborder="0" title="Image editor"></iframe>
        {{else}}
          <img src={{this.image_preview.url}} class="button_image">
        {{/if}}
        <div style="margin-top: 10px;">
          <PickLicense @license={{this.image_preview.license}} />
        </div>
        {{#unless this.image_preview.license.uneditable}}
          <div style='margin-top: -10px; text-align: left;'>
            <div class='form-group'>
              <div class='col-sm-2'>
                <label><p class='form-control-static'>{{t "Contrast" key="contrast"}}</p></label>
              </div>
              <div class='col-sm-10'>
                <div class="checkbox big_checkbox">
                  <label>
                    <input type="checkbox" checked={{this.image_preview.hc}} {{on "change" (set-field this "image_preview.hc" "checkbox")}} />
                    {{t "This is a high-contrast image" key="mark_high_contrast"}}
                  </label>
                </div>
              </div>
            </div>
          </div>
        {{/unless}}
        <div style="margin-top: 10px;">
          <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clearImageWork")}}>{{t "Cancel" key="cancel"}}</button>
          {{#unless this.image_preview.editor}}
            <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "edit_image_preview")}}>{{t "Edit" key="edit"}}</button>
          {{/unless}}
          {{#if this.stream}}
            <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "webcamToggle" false)}}>{{t "Try Again" key="try_again"}}</button>
          {{/if}}
          {{#if this.image_search.previews}}
            <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "clear_image_preview")}}>{{t "Back to List" key="back_to_list"}}</button>
            {{#if this.model.image.permissions.edit}}
              <div class="btn-group" role="group" aria-label="extra" style='width: 30px; margin-right: 5px;'>
                <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <span class="caret"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-right">
                  <li><a href="#" {{on "click" (this.ctrlAction "set_alternate")}}>{{t "Set as Library Default" key="set_as_library_default"}}</a></li>
                </ul>
              </div>
            {{/if}}
          {{/if}}
          <button type="button" class='btn btn-primary' {{on "click" (this.ctrlAction "select_image_preview")}}>
            {{#if this.model.pending_image}}
              {{t "Saving..." key="saving"}}
            {{else}}
              {{t "Use This" key="use_this"}}
            {{/if}}
          </button>
        </div>
      </div>
    {{/if}}
  {{else}}
    {{!-- SEARCH — the search options (filters) grouped with the results they
         refine, under one Search header (the options moved here from the Find a
         Picture card above so they sit with the results they affect). Rendered in
         the browsing state (not while confirming a picked image), and the options
         stay above the result states so they're available in EVERY state,
         including no-results, to loosen the filters. --}}
    <div class="md-bs-picture__search-section">
      <div class="md-bs-card__eyebrow md-bs-picture__results-eyebrow">
        <span>{{t "Search" key="search"}}</span>
        {{#if this.image_search.previews}}
          <span class="md-bs-picture__results-count">{{this.image_search.previews.length}} {{t "results" key="results_count"}}</span>
        {{/if}}
      </div>

      {{#if this.appState.feature_flags.skin_tones}}
        <button type="button" class="md-bs-picture__disclosure {{if this.show_library_options 'is-open'}}" {{on "click" (this.ctrlAction "library_options")}} aria-expanded={{if this.show_library_options "true" "false"}}>
          <svg class="md-bs-picture__disclosure-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
          {{t "Search options" key="search_options"}}
        </button>
        {{#if this.show_library_options}}
          <div class="md-bs-picture__options-body">
            <BoundSelect @select_class="form-control skip_select" @select_id="skin_preference" @short={{true}} @content={{this.skin_options}} @selection={{this.skin_preference}} @action={{this.ctrlAction "updateSkinPreference"}} />
            <label class="md-bs-picture__checkbox"><input type="checkbox" checked={{this.safe_search}} {{on "change" (set-field this "safe_search" "checkbox")}} /> {{t "safe search" key="safe_search"}}</label>
          </div>
        {{/if}}
      {{/if}}

      {{#if this.image_search.error}}
        <p class='text-danger' style='margin: 15px 0;'>{{this.image_search.error}}</p>
      {{else if this.missing_library}}
        <div style="margin: 10px 0 10px 0;">
          {{#if this.missing_library.lessonpix}}
            <img src="https://lingolinq.s3.amazonaws.com/icons/lessonpix.png" style='width: 50px; float: left; margin-right: 10px; margin-bottom: 5px;'>
            {{t "LessonPix is a paid third-party symbol library with over 33,000 symbols. If you have a <a href='https://lessonpix.com' target='_blank' rel='noopener'>LessonPix account</a> you can <b>connect it to your %app_name% account in your User Profile</b>, and then you and any supervisors will be able to add LessonPix symbols to your boards." key="lessonpix_detailer"}}
          {{else if this.missing_library.pcs}}
            <img src="https://lingolinq.s3.amazonaws.com/icons/pcs.png" style='width: 50px; float: left; margin-right: 10px; margin-bottom: 5px;'>
            {{t "PCS (BoardMaker) is a paid third-party symbol library supported by Tobii Dynavix with over 18,000 symbols. %app_name% users can purchase access to PCS symbols as an upgrade on their"  key="pcs_explainer"}}
            <LinkTo @route="user.subscription" @model={{this.appState.currentUser.user_name}}>billing page</LinkTo>.
          {{else if this.missing_library.symbolstix}}
            <img src="https://lingolinq.s3.amazonaws.com/icons/symbolstix.png" style='width: 50px; float: left; margin-right: 10px; margin-bottom: 5px;'>
            {{t "SymbolStix is a paid third-party symbol library supported by News2You with over 48,000 symbols. %app_name% users can purchase access to SymbolStix symbols as an upgrade on their"  key="symbolstix_explainer"}}
            <LinkTo @route="user.subscription" @model={{this.appState.currentUser.user_name}}>billing page</LinkTo>.
          {{else}}
            {{t "Premium symbol support required" key="premium_symbols_required"}}
          {{/if}}
        </div>
      {{else if this.image_search.previews}}
        <p class="md-bs-picture__results-sub">{{t "Select an image to use for this button." key="select_image_for_button"}}</p>
        <section class="md-bs-card md-bs-picture__results-surface">
          <div class="md-bs-picture__results">
            {{#each this.image_search.previews as |image|}}
              <button type="button" class="md-bs-picture__result" {{on "click" (this.ctrlAction "pick_preview" image)}} aria-label={{t "Choose this picture" key="choose_this_picture"}}>
                <img src={{image.thumbnail_url}} alt="">
              </button>
            {{/each}}
          </div>
          {{#if this.current_library.giphy_asl}}
            <img src={{path "images/logos/giphy.png"}} style='padding-bottom: 10px; margin-left: -10px;'><br>
          {{/if}}
        </section>
      {{else if this.image_search.previews_loaded}}
        <div style="margin: 10px 0 10px 0;">
          {{t "No results found for %{term}" key="no_image_results_for" term=this.image_search.term}}
        </div>
      {{else}}
        {{#if this.current_library.giphy_asl}}
          <img src={{path "images/logos/giphy.png"}} style='padding-bottom: 10px; margin-left: -10px;'><br>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}
</div>
        </form>

        {{!-- Action tab content (inlined) --}}
        <form class="form-horizontal" {{on "submit" this.onNothing}}>
<div class={{if this.actionState "active" "hidden"}}>
  <section class="md-bs-card md-bs-card--action">
    <div class="md-bs-card__eyebrow">{{t "Action" key="action"}}</div>
    <div class="md-bs-card__sep" aria-hidden="true"></div>
    <p class="md-bs-card__hint">{{t "Choose what should happen when this item is selected." key="action_hint"}}</p>
    <BoundSelect @select_class="form-control md-bs-select" @select_id="action" @content={{this.buttonActions}} @selection={{this.model.buttonAction}} @action={{this.ctrlAction "updateModelButtonAction"}} />
  </section>
  {{#if this.model.folderAction}}
    {{#unless this.pending_board}}
    {{#unless this.model.load_board.key}}
    <section class="md-bs-card md-bs-card--destination">
      <div class="md-bs-card__eyebrow">{{t "Destination board" key="destination_board"}}</div>
        <div class="md-bs-methods">
        <div class="md-board-collection md-bs-collection">
          <div class="md-board-collection__header md-bs-collection__header">
            <div class="md-board-collection__search {{if this.panel_filter 'md-board-collection__search--active'}}">
              <svg class="md-board-collection__search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input value={{this.panel_filter}} class="md-board-collection__search-input" placeholder={{t "Find a board…" key="search_board_jump_placeholder"}} aria-label={{t "Find a board…" key="search_board_jump_placeholder"}} {{on "input" (set-field this "panel_filter")}} />
            </div>
          </div>
          <div class="md-board-collection__body md-bs-collection__body">
            {{#if this.collection_loading}}
              <p class="md-board-collection__loading">{{t "Loading boards…" key="loading_boards"}}</p>
            {{/if}}
            {{#if this.collection_my_boards.length}}
              <section class="md-board-collection__section">
                <h3 class="md-board-collection__section-label"><span>{{t "My Boards" key="my_boards"}}</span><span class="md-board-collection__grid-size-label">{{t "Grid size" key="grid_size"}}</span></h3>
                <ul class="md-board-collection__list">
                  {{#each this.collection_my_boards as |board|}}
                    {{#if board.key}}
                      <li class="md-board-collection__row">
                        <button type="button" class="md-board-collection__item" {{on "click" (this.ctrlAction "selectFoundBoard" board)}}>
                          <img class="md-board-collection__item-icon" src={{board.icon_url_with_fallback}} alt="" onerror="button_broken_image(this);">
                          <BoardListItemLabel @board={{board}} @name={{board.name}} />
                          {{#if (board-language-label board)}}<span class="md-board-collection__item-lang">{{board-language-label board}}</span>{{/if}}
                          {{#if board.grid.rows}}<span class="md-board-collection__item-count md-board-collection__item-count--grid" aria-label={{t "%{rows} by %{columns} grid" rows=board.grid.rows columns=board.grid.columns key="board_collection_grid_size"}}>{{board.grid.rows}} x {{board.grid.columns}}</span>{{/if}}
                        </button>
                      </li>
                    {{/if}}
                  {{/each}}
                </ul>
              </section>
            {{/if}}
            {{#each this.collection_online_filtered as |group|}}
              <section class="md-board-collection__section">
                <h3 class="md-board-collection__section-label"><span>{{t group.default_label key=group.label_key}}</span><span class="md-board-collection__grid-size-label">{{t "Grid size" key="grid_size"}}</span></h3>
                <ul class="md-board-collection__list">
                  {{#each group.boards as |board|}}
                    {{#if board.key}}
                      <li class="md-board-collection__row">
                        <button type="button" class="md-board-collection__item" {{on "click" (this.ctrlAction "selectFoundBoard" board)}}>
                          <img class="md-board-collection__item-icon" src={{board.icon_url_with_fallback}} alt="" onerror="button_broken_image(this);">
                          <BoardListItemLabel @board={{board}} @name={{board.name}} />
                          {{#if (board-language-label board)}}<span class="md-board-collection__item-lang">{{board-language-label board}}</span>{{/if}}
                          {{#if board.grid.rows}}<span class="md-board-collection__item-count md-board-collection__item-count--grid" aria-label={{t "%{rows} by %{columns} grid" rows=board.grid.rows columns=board.grid.columns key="board_collection_grid_size"}}>{{board.grid.rows}} x {{board.grid.columns}}</span>{{/if}}
                        </button>
                      </li>
                    {{/if}}
                  {{/each}}
                </ul>
              </section>
            {{/each}}
            {{#if this.collection_empty}}
              <p class="md-board-collection__empty">{{t "No boards found" key="no_boards_found"}}</p>
            {{/if}}
          </div>
        </div>
        <div class="md-bs-or" aria-hidden="true"><span class="md-bs-or-text">{{t "OR" key="or_separator_caps"}}</span></div>
        <button type="button" class="md-bs-choice md-bs-choice--create" {{on "click" (this.ctrlAction "build_board")}}>
          <span class="md-bs-choice__icon" aria-hidden="true"><span class="glyphicon glyphicon-plus"></span></span>
          <span class="md-bs-choice__label">{{t "Create a new board" key="create_a_new_board"}}</span>
        </button>
        </div>
    </section>
    {{/unless}}
    <section class="md-bs-card md-bs-card--selected">
      <div class="md-bs-card__eyebrow">{{#if this.confirm_found_board}}{{t "Choose how to use this board" key="choose_how_to_use_board"}}{{else}}{{t "Selected board" key="selected_board"}}{{/if}}</div>
      {{#if this.model.load_board.key}}
        <div class="md-bs-dest__selected">
          <img class="md-bs-dest__icon" src={{this.model.icon}} alt="" onerror="button_broken_image(this);">
          <div class="md-bs-dest__meta">
            <a class="md-bs-dest__name" href={{this.model.link}} target="_blank" rel="noopener">{{this.model.load_board.key}}</a>
            <span class="md-bs-dest__owner">{{t "Linked board" key="linked_board"}}</span>
          </div>
          <button type="button" class="md-bs-dest__change" {{on "click" (this.ctrlAction "change_linked_board")}}>
            <svg class="md-bs-dest__change-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"></path></svg>
            {{t "Change Board" key="change_board"}}
          </button>
        </div>
      {{else if this.confirm_found_board}}
        <div class="md-bs-card__sep" aria-hidden="true"></div>
        {{#if this.confirm_found_board.copy_status.copying}}
          <p class="md-bs-choose__status">{{t "Copying board %{board_key}..." board_key=this.confirm_found_board.key key="copying_board_key"}}</p>
        {{else if this.confirm_found_board.copy_status.error}}
          <p class="md-bs-choose__status text-danger">{{t "There was an error copying the board" key="error_copying_board"}}</p>
        {{else if this.confirm_found_board.share_status.sharing}}
          <p class="md-bs-choose__status">{{t "Sharing board %{board_key}..." board_key=this.confirm_found_board.key key="sharing_board_key"}}</p>
        {{else if this.confirm_found_board.share_status.error}}
          <p class="md-bs-choose__status text-danger">{{t "There was an error sharing the board" key="error_sharing_board"}}</p>
        {{else}}
          {{#let this.confirm_found_board as |board|}}
            <div class="md-bs-choose">
              {{!-- Clean vertical preview card: thumbnail on top, title / grid / preview below --}}
              <div class="md-bs-choose__preview">
                <div class="md-bs-choose__thumb">
                  <img src={{board.icon_url_with_fallback}} alt="" onerror="button_broken_image(this);">
                </div>
                <div class="md-bs-choose__preview-info">
                  <div class="md-bs-choose__preview-name" title={{board.name}}>{{board.name}}</div>
                  {{#if (board-attribution-owner board)}}
                    <div class="md-bs-choose__preview-owner">{{t "by" key="by"}} {{board-attribution-owner board}}</div>
                  {{/if}}
                  {{#if board.grid.rows}}<div class="md-bs-choose__preview-grid">{{board.grid.rows}} × {{board.grid.columns}} {{t "layout" key="layout_lower"}}</div>{{/if}}
                  <button type="button" class="btn md-bs-choose__preview-btn" {{on "click" (this.ctrlAction "preview_confirm_board" board)}}>{{t "Preview" key="preview"}}</button>
                </div>
              </div>
              {{!-- Decision content --}}
              <div class="md-bs-choose__body">
                {{#if board.downstream_boards}}
                  <p class="md-bs-choose__note">{{t "NOTE: To copy linked boards with this board you should navigate to the board and manually make a copy." key="links_are_not_copied"}}</p>
                {{/if}}
                <div class="md-bs-choose__actions">
                  {{#if board.copy_or_share}}
                    <button type="button" class="md-bs-choose__btn md-bs-choose__btn--secondary" {{on "click" (this.ctrlAction "shareFoundBoard" board)}}>
                      <span class="md-bs-choose__btn-label">{{t "Share this board" key="share_this_board_label"}}</span>
                      <span class="md-bs-choose__btn-sub">{{t "Give the owner access so it appears here." key="share_this_board_sub"}}</span>
                    </button>
                  {{else}}
                    <button type="button" class="md-bs-choose__btn md-bs-choose__btn--secondary" {{on "click" (this.ctrlAction "selectFoundBoard" board true)}}>
                      <span class="md-bs-choose__btn-label">{{t "Use original board" key="use_original_board"}}</span>
                      <span class="md-bs-choose__btn-sub">{{t "Link directly to the existing board." key="use_original_board_sub"}}</span>
                    </button>
                  {{/if}}
                  <div class="md-bs-or" aria-hidden="true"><span class="md-bs-or-text">{{t "OR" key="or_separator_caps"}}</span></div>
                  <button type="button" class="md-bs-choose__btn md-bs-choose__btn--primary" {{on "click" (this.ctrlAction "copy_found_board")}}>
                    <span class="md-bs-choose__btn-label">{{t "Create editable copy" key="create_editable_copy"}}</span>
                    <span class="md-bs-choose__btn-sub">{{t "Make changes without affecting the original." key="create_editable_copy_sub"}}</span>
                  </button>
                </div>
                <div class="md-bs-choose__footer">
                  <button type="button" class="md-bs-choose__change" {{on "click" (this.ctrlAction "clear_confirm_board")}}>
                    <svg class="md-bs-choose__change-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"></path></svg>
                    {{t "Change Board" key="change_board"}}
                  </button>
                </div>
              </div>
            </div>
          {{/let}}
        {{/if}}
      {{else}}
        <div class="md-bs-status">
          <div class="md-bs-status__row">
            <span class="md-bs-status__dot" aria-hidden="true"></span>
            <span class="md-bs-status__text">{{t "No board selected" key="no_board_selected"}}</span>
          </div>
        </div>
      {{/if}}
    </section>
    {{/unless}}
    {{#if this.pending_board}}
    <section class="md-bs-card md-bs-card--create">
      <div class="md-bs-card__eyebrow">{{t "Create a new board" key="create_a_new_board"}}</div>
      {{#if this.has_supervisees}}
        <div class="form-group">
          <label for="for_user_id" class="col-sm-2 control-label">{{t "For" key="for"}}</label>
          <div class="col-sm-10">
            <UserSelect @select_id="for_user_id" @selection={{this.pending_board.for_user_id}} @action={{this.ctrlAction "updatePendingBoardForUserId"}} />
          </div>
        </div>
      {{/if}}
      <div class="form-group">
        <label for="pending_board_name" class="col-sm-2 control-label">{{t "Name" key="name"}}</label>
        <div class="col-sm-10">
          <input value={{this.pending_board.name}} id="pending_board_name" class="form-control" placeholder="Board name" {{on "input" (set-field this "pending_board.name")}} />
        </div>
      </div>
      <div class="form-group">
        <label for="pending_board_key" class="col-sm-2 control-label">{{t "Key" key="key"}}</label>
        <div class="col-sm-10">
          <input value={{this.pending_board.key}} id="pending_board_key" class="form-control" placeholder={{this.pending_board.key_placeholder}} {{on "input" (set-field this "pending_board.key")}} />
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label">{{t "Size" key="size"}}</label>
        <div class="col-sm-4">
          <div class="input-group">
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "minus" "pending_board.grid.rows")}}>-</button>
            </span>
            <input value={{this.pending_board.grid.rows}} class="form-control" id="pending_board_rows" placeholder="##" title="rows" aria-label={{t "Rows" key="rows"}} {{on "input" (set-field this "pending_board.grid.rows")}} />
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "plus" "pending_board.grid.rows")}}>+</button>
            </span>
          </div>
          <em style="padding-left: 35px;">{{t "Rows" key="row"}}</em>
        </div>
        <div class="col-sm-2"><p class="form-control-static"> by </p></div>
        <div class="col-sm-4">
          <div class="input-group">
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "minus" "pending_board.grid.columns")}}>-</button>
            </span>
            <input value={{this.pending_board.grid.columns}} class="form-control" id="pending_board_columns" placeholder="##" title="columns" aria-label={{t "Columns" key="columns"}} {{on "input" (set-field this "pending_board.grid.columns")}} />
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "plus_minus" "plus" "pending_board.grid.columns")}}>+</button>
            </span>
          </div>
          <em style="padding-left: 35px;">{{t "Columns" key="columns"}}</em>
        </div>
      </div>
      <div class="form-group">
        <div class="col-sm-10 col-sm-offset-2">
          <div class="checkbox big_checkbox">
            <label>
              <input type="checkbox" checked={{this.pending_board.copy_access}} {{on "change" (set-field this "pending_board.copy_access" "checkbox")}} />
              {{t "Use same license and access settings as are set for this board" key="use_same_license"}}
            </label>
          </div>
        </div>
      </div>
      <div class="form-group">
        <div class="col-sm-10 col-sm-offset-2">
          <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "cancel_build_board")}}>{{t "Cancel" key="cancel"}}</button>
          <button type="button" class="btn btn-primary" {{on "click" (this.ctrlAction "create_board")}}>{{t "Create" key="create"}}</button>
        </div>
      </div>
    </section>
    {{/if}}
    <section class="md-bs-card md-bs-card--config">
      <label class="md-bs-check">
        <input type="checkbox" checked={{this.speak_and_add}} {{on "change" (set-field this "speak_and_add" "checkbox")}} />
        {{t "Also speak & add to the vocalization box" key="also_speak_and_add"}}
      </label>
      <label class="md-bs-check">
        <input type="checkbox" checked={{this.model.home_lock}} {{on "change" (set-field this "model.home_lock" "checkbox")}} />
        {{t "Set as temporary home when loaded" key="set_home_lock"}}
      </label>
      <label class="md-bs-check">
        <input type="checkbox" checked={{this.model.link_disabled}} {{on "change" (set-field this "model.link_disabled" "checkbox")}} />
        {{t "Disable this link action for now" key="disable_link_action"}}
      </label>
    </section>
  {{else if this.model.integrationOrWebhookAction}}
