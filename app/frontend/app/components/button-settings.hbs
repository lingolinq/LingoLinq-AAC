                {{#each this.foundApps.results as |result|}}
                  <button type="button" class="col-sm-12 well well-sm app_result" style="cursor: pointer; margin-bottom: 5px; line-height: 16px; white-space: nowrap; overflow: hidden; display: block; width: 100%; text-align: left; border: 1px solid #e3e3e3;" {{on "click" (this.ctrlAction "pick_app" result)}}>
                    <img src={{result.image_url}} alt="" style="width: 50px; height: 50px; margin-right: 5px; float: left;">
                    {{result.name}}<br>
                    <span class="text-muted">{{result.author_name}} ${{result.price}}</span>
                    <br>
                    {{#if result.launch_url}}
                      <em class="text-muted">{{t "launchable" key="launchable"}}</em>
                    {{else}}
                      <em class="text-danger">{{t "not launchable" key="not_launchable"}}</em>
                    {{/if}}
                    <span style="clear: left;"></span>
                  </button>
