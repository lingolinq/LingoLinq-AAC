          <a href="#" role="button" style="margin-right: 25px;" {{on "click" (this.ctrlAction "set_app_find_mode" "android")}} class={{if this.android_search "really_bold"}}><span class={{this.android_status_class}}></span> {{t "Android" key="android"}}</a>
          <a href="#" role="button" {{on "click" (this.ctrlAction "set_app_find_mode" "web")}} class={{if this.web_search "really_bold"}}><span class={{this.web_status_class}}></span> {{t "Web/Other" key="web_other"}}</a>
