        <label class="md-bs-check">
          <input type="checkbox" checked={{this.model.video.popup}} {{on "change" (set-field this "model.video.popup" "checkbox")}} />
          {{t "Show video in a popup" key="show_video_popup"}}
        </label>
        {{#if this.model.video.popup}}
          <div class="md-bs-video-preview">
            {{#if this.video_test_url}}
              <iframe src={{this.video_test_url}} id="link_video_preview" frameborder="0" allow="autoplay; fullscreen; encrypted-media" title={{t "Video preview" key="video_preview"}}></iframe>
