                  <em class="text-muted">{{t "This app will be launched by LingoLinq" key="app_can_be_launched"}}</em>
                {{else}}
                  <em class="text-danger">{{t "This app won't be launched by LingoLinq" key="app_cant_be_launched"}}</em>
                  <br><a href="#" role="button" {{on "click" (this.ctrlAction "set_custom")}}>{{t "advanced" key="advanced"}}</a>
