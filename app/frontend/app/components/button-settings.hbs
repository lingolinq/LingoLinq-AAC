                  <div class="checkbox big_checkbox">
                    <label>
                      <input checked={{field.value}} id={{field.name}} type="checkbox"  {{on "change" (set-field field "value" "checkbox")}}/>
                    </label>
                  </div>
                {{else if field.preferred_languages}}
                  <BoundSelect @select_class="form-control" @select_id="pref_langs" @content={{field.preferred_languages}} @selection={{field.value}} @action={{this.ctrlAction "updateIntegrationFieldValue" field}} @optionValuePath="content.id" @optionLabelPath="content.label" />
                {{else if field.field_type_key}}
                  {{#if field.field_type_key.is_locale}}
                    <div class="row">
                      <div class="col-sm-9">
                        <input value={{field.value}} class="form-control" id={{field.name}} placeholder={{field.placeholder}}  {{on "input" (set-field field "value")}}/>
                      </div>
                      <div class="col-sm-3">
                        <BoundSelect @select_class="form-control" @select_id="pref_langs_for_locale" @content={{field.locales}} @selection={{field.locale}} @action={{this.ctrlAction "updateIntegrationFieldLocale" field}} @optionValuePath="content.code" @optionLabelPath="content.label" />
                      </div>
                    </div>
                  {{/if}}
                {{/if}}
              </div>
            </div>
          {{/each}}
        {{else}}
          <div class="form-group">
            <div class="col-sm-12">
              <p class='text-muted form-control-static'>{{t "Loading form..." key="loading_form"}}</p>
            </div>
          </div>
        {{/if}}
      {{/if}}
      {{#if this.integration.has_groups}}
        <div class="form-group">
          <label for="group" class="col-sm-2 control-label">{{t "Group" key="group"}}</label>
          <div class="col-sm-10">
            {{#if this.integration.groups}}
              <div class="row">
                <div class="col-sm-12">
                  <BoundSelect @select_class="form-control" @select_id="integration_group" @content={{this.integration.groups}} @selection={{this.integration_group}} @action={{this.ctrlAction "updateIntegrationGroup"}} @optionLabelPath="content.label" />
                </div>
              </div>
            {{else}}
              <p class='text-muted form-control-static'>{{t "Loading group list..." key="loading_group_list"}}</p>
            {{/if}}
          </div>
        </div>
      {{/if}}
      {{#if this.integration.takes_multiple_inputs}}
        <div class="form-group">
          <label for="max_inputs" class="col-sm-2 control-label">{{t "Max items" key="max_items"}}</label>
          <div class="col-sm-10">
            <div class="btn-group" role="group">
              <button type="button" class={{if this.max_inputs_is_exact "btn btn-default active" "btn btn-default"}} {{on "click" (this.ctrlAction "set_max_inputs_exact" true)}}>{{t "Exact" key="exact"}}</button>
              <button type="button" class={{unless this.max_inputs_is_exact "btn btn-default active" "btn btn-default"}} {{on "click" (this.ctrlAction "set_max_inputs_exact" false)}}>{{t "Up to" key="up_to"}}</button>
            </div>
            <span class="btn-group" role="group">
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "max_inputs_minus")}}>-</button>
              <button type="button" class="btn btn-default" disabled>{{this.max_inputs}}</button>
              <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "max_inputs_plus")}}>+</button>
            </span>
          </div>
        </div>
      {{/if}}
      {{#if this.integration.show_sync_note}}
        <div class="form-group">
          <div class="col-sm-10 col-sm-offset-2">
            <p class='text-muted'>{{t "Note: these commands will only run online and will fail if not connected." key="integration_sync_note"}}</p>
          </div>
        </div>
      {{/if}}
    {{/if}}
    </section>
  {{else if this.model.webhookAction}}
    <div class="form-group">
      <label class="col-sm-2 control-label">{{t "Webhook" key="webhook"}}</label>
      <div class="col-sm-10">
        {{#if this.webhook}}
          {{#if this.webhook.title}}
            <p class='form-control-static'><strong>{{this.webhook.title}}</strong></p>
          {{/if}}
          <p class='form-control-static'>{{this.webhook.url}}</p>
        {{else}}
          <p class='form-control-static'>{{t "Not set" key="not_set"}}</p>
        {{/if}}
        <p class='text-muted'>{{t "Webhooks can be configured for this user by opening their profile in a web browser." key="webhooks_setup_web"}}</p>
      </div>
    </div>
  {{else if this.model.exportAction}}
    <div class="form-group">
      <label for="format" class="col-sm-2 control-label">{{t "Format" key="format"}}</label>
      <div class="col-sm-10">
        <BoundSelect @select_class="form-control" @select_id="format" @content={{this.export_formats}} @selection={{this.model.export_format}} @action={{this.ctrlAction "updateModelExportFormat"}} @optionValuePath="content.id" @optionLabelPath="content.name" />
      </div>
    </div>
    <div class="form-group">
      <label for="print_size" class="col-sm-2 control-label">{{t "Print Size" key="print_size"}}</label>
      <div class="col-sm-10">
        <BoundSelect @select_class="form-control" @select_id="print_size" @content={{this.print_sizes}} @selection={{this.model.print_size}} @action={{this.ctrlAction "updateModelPrintSize"}} />
        <p class='text-muted'>{{t "There may be a short delay before your export is ready" key="delay_before_export"}}</p>
