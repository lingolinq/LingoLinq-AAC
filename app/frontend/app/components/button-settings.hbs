        <input value={{locale.label}} class="form-control" id={{locale.label_id}}  {{on "input" (set-field locale "label")}}/>
      </div>
    </div>
    <div class="form-group">
      <label for={{locale.vocalization_id}} class="col-sm-4 control-label">{{t "Speech" key="speech"}}</label>
      <div class="col-sm-8">
        <input value={{locale.vocalization}} class="form-control" id={{locale.vocalization_id}} placeholder="matches label if empty"  {{on "input" (set-field locale "vocalization")}}/>
      </div>
    </div>
    {{#if this.appState.feature_flags.inflections_overlay}}
      <div class='form-group'>
        <label for="inflections" class="col-sm-4 control-label">{{t "Inflections" key="inflections"}}</label>
        <div class='col-sm-8'>
          <p class='form-control-static'>{{t "When users enable inflections and long-press on the button, these are the options they will see:" key="inflections_overlay_description"}}</p>
        </div>
        <div class='col-sm-10 col-sm-offset-2'>
          <div>
            <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
              <input class="form-control" value={{locale.inflections_hash.nw}} placeholder={{locale.inflections_suggestions.nw}} aria-label={{t "Inflection, top left" key="inflection_top_left"}}  {{on "input" (set-field locale "inflections_hash.nw")}}/>
            </div>
            <div style='float: left; width: calc(33% - 10px); margin: 5px;'>
              <input class="form-control" value={{locale.inflections_hash.n}} placeholder={{locale.inflections_suggestions.n}} aria-label={{t "Inflection, top" key="inflection_top"}}  {{on "input" (set-field locale "inflections_hash.n")}}/>
