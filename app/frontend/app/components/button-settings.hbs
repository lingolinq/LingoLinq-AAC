      <div class="col-sm-10">
        <BoundSelect @select_class="form-control" @select_id="toggle" @content={{this.toggle_options}} @selection={{this.model.toggle_action}} @action={{this.ctrlAction "updateModelToggleAction"}} @optionValuePath="content.id" @optionLabelPath="content.name" />
      </div>
    </div>
  {{else if this.model.linkAction}}
    <section class="md-bs-card md-bs-card--config">
      <div class="md-bs-card__eyebrow">{{t "Web address" key="web_address"}}</div>
      <label for="url" class="md-bs-field-label">{{t "URL" key="url"}}</label>
