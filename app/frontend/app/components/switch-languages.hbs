<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3>{{t "Switch Languages" key="switch_languages"}}</h3>
  </div>
  <div class="modal-body md-modal-body" id='languages_prompt'>
    <form class="form-horizontal" {{on "submit" (this.ctrlAction "nothing")}}>
      <div class="form-group">
        <div class="col-sm-12">
          <p class='form-control-static'>
            {{t "This board supports multiple languages. You can quickly switch between languages for both the text labels and the system-generated speech." key="select_a_language_for_switching"}}
          </p>
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-4 control-label" for="vocalization_locale">
          {{#if this.same_locale}}
            <span class='glyphicon glyphicon-globe'></span>
            {{t "Language" key="language"}}
          {{else}}
            <span class='glyphicon glyphicon-volume-up'></span>
            {{t "Spoken Language" key="speech_generation"}}
          {{/if}}
        </label>
        <div class="col-sm-8">
          {{#if this.two_languages}}
            <div class='btn-group' style='width: 100%;'>
              {{#each this.locales as |locale|}}
                <button type='button' style='max-width: 50%; overflow: hidden; text-overflow: ellipsis;' {{on "click" (this.ctrlAction "set_locale" "vocalization" locale.id)}} class={{if (is-equal this.vocalization_locale locale.id) "btn btn-primary btn-lg" "btn btn-default btn-lg"}}>{{locale.name}}</button>
              {{/each}}
            </div>
          {{else}}
            <div class='input-group input-group-lg' style='min-width: 200px;'>
              <BoundSelect @select_class="form-control big_select" @select_id="vocalization_locale" @content={{this.locales}} @selection={{this.vocalization_locale}} @action={{this.ctrlAction "set_locale" "vocalization"}} />
            </div>
          {{/if}}
        </div>
      </div>
      <div class="form-group">
        <div class='col-sm-8 col-sm-offset-4'>
          <div class="checkbox big_checkbox">
            <label>
              <input type="checkbox" checked={{this.same_locale}} {{on "change" (set-field this "same_locale" "checkbox")}} />
              {{t "Use the same language for button labels and speech generation" key="use_same_language"}}
            </label>
          </div>
        </div>
      </div>
      {{#unless this.same_locale}}
        <div class="form-group">
          <label class="col-sm-4 control-label" for="label_locale">
            <span class='glyphicon glyphicon-text-background'></span>
            {{t "Text Language" key="text_language"}}
          </label>
          <div class="col-sm-8">
            {{#if this.two_languages}}
              <div class='btn-group' style='width: 100%;'>
                {{#each this.locales as |locale|}}
                  <button type='button' style='max-width: 50%; overflow: hidden; text-overflow: ellipsis;' {{on "click" (this.ctrlAction "set_locale" "label" locale.id)}} class={{if (is-equal this.label_locale locale.id) "btn btn-primary btn-lg" "btn btn-default btn-lg"}}>{{locale.name}}</button>
                {{/each}}
              </div>
            {{else}}
              <div class='input-group input-group-lg' style='min-width: 200px;'>
                <BoundSelect @select_class="form-control big_select" @select_id="label_locale" @content={{this.locales}} @selection={{this.label_locale}} @action={{this.ctrlAction "set_locale" "label"}} />
              </div>
            {{/if}}
          </div>
        </div>
      {{/unless}}
    </form>
  </div>
  <div class="modal-footer md-modal-footer">
    <button type="button" class="btn btn-lg btn-default" {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
    <button type="button" class="btn btn-lg btn-default" {{on "click" (this.ctrlAction "open_translate")}}>
      {{t "Translate to Another Language" key="translate_another_language"}}
    </button>
    <button class='btn btn-lg btn-primary' {{on "click" (this.ctrlAction "set_languages")}}>{{t "Switch Languages" key="switch_languages"}}</button>
  </div>
</ModalDialog>
