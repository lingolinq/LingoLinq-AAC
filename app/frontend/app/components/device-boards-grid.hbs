{{#if @boards.loading}}
  <p class="ub-boards-page__offline-note" role="status">{{t "Finding the boards on this device..." key="device_boards_loading"}}</p>
{{else if this.items.length}}
  <p class="ub-boards-page__offline-note" role="status">{{t "You're offline. These boards are saved on this device and open without internet." key="device_boards_note"}}</p>
  <div class="ub-boards-page__board-grid ub-boards-page__board-grid--device">
    {{#each this.items key="board.id" as |item|}}
      <div class="ub-boards-page__board-item board_with_action simple_board_holder {{if item.home 'ub-boards-page__board-item--home'}} {{if item.board.starred_for_current_user 'ub-boards-page__board-item--liked'}}" data-board-key={{item.board.key}} draggable="false">
        {{#if item.board.starred_for_current_user}}
          <span class="ub-boards-page__board-item-heart" aria-label={{t "Liked" key="starred"}} title={{t "Liked" key="starred"}}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M12 21s-7.5-4.5-9.5-9.5C1.2 7.6 3.6 4 7.3 4c2 0 3.5 1 4.7 2.6C13.2 5 14.7 4 16.7 4c3.7 0 6.1 3.6 4.8 7.5C19.5 16.5 12 21 12 21z"/>
            </svg>
          </span>
        {{/if}}
        <BoardIcon @board={{item}} @flag_home={{item.home}} @onAction={{this.onOpen}} />
      </div>
    {{/each}}
  </div>
{{else}}
  <div class="ub-boards-page__empty" role="status">
    <span class="ub-boards-page__empty-icon" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
        <rect x="14" y="14" width="7" height="7" rx="1.5"/>
      </svg>
    </span>
    <h3 class="ub-boards-page__empty-title">{{t "No boards are saved on this device yet" key="device_boards_empty"}}</h3>
    <p class="ub-boards-page__empty-subtitle">{{t "Connect to the internet and sync to use your boards offline." key="device_boards_empty_subtitle"}}</p>
  </div>
{{/if}}
