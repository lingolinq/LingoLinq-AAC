{{#if this.shown}}
  {{!-- The copy drawer's classes and slot (styles: .ll-copy-drawer); the tone modifier picks the colour. --}}
  <div class="ll-copy-drawer ll-copy-drawer--{{this.tone}} {{if this.appState.toast 'll-copy-drawer--above-toast'}}" data-test-sync-drawer={{this.sync_notice.status}} data-test-sync-drawer-stage={{this.stage}}>
    {{#if this.is_saving}}
      <div class="ll-copy-drawer__spinner md-loading-spinner" aria-hidden="true"></div>
      <div class="ll-copy-drawer__body">
        {{!-- Only the sentence is a live region: the count changes every few seconds. --}}
        <p class="ll-copy-drawer__title" role="status">{{t "Saving your boards for offline use" key="sync_drawer_saving"}}</p>
        {{#if this.current_board}}
          <p class="ll-copy-drawer__hint" data-test-sync-drawer-board>{{this.current_board}}</p>
        {{/if}}
        {{!-- A moving bar, not a percentage: the total grows as the sync finds folders (Traci, 2026-11-11). --}}
        <div class="ll-sync-drawer__bar" aria-hidden="true"><span class="ll-sync-drawer__bar-fill"></span></div>
        <p class="ll-copy-drawer__hint" data-test-sync-drawer-progress>{{this.progress_line}}</p>
        <p class="ll-copy-drawer__hint">{{t "Keep working. We'll let you know when it's done." key="sync_drawer_keep_working"}}</p>
      </div>
    {{else if this.is_waiting}}
      <span class="ll-copy-drawer__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
      </span>
      <div class="ll-copy-drawer__body">
        <p class="ll-copy-drawer__title" role="status">{{t "Waiting for a better connection" key="sync_drawer_waiting"}}</p>
        <p class="ll-copy-drawer__hint">{{this.waiting_line}}</p>
        <div class="ll-copy-drawer__actions">
          <button type="button" class="ll-copy-drawer__btn" {{on "click" this.onTryNow}}>{{t "Try now" key="try_now"}}</button>
        </div>
      </div>
    {{else}}
      <span class="ll-copy-drawer__icon" aria-hidden="true">
        {{#if this.done_icon}}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        {{else}}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        {{/if}}
      </span>
      <div class="ll-copy-drawer__body" role="status">
        <p class="ll-copy-drawer__title">{{this.result_title}}</p>
        {{#if this.result_detail}}
          <p class="ll-copy-drawer__hint">{{this.result_detail}}</p>
        {{/if}}
        <div class="ll-copy-drawer__actions">
          {{#if this.is_attention}}
            <button type="button" class="ll-copy-drawer__btn ll-copy-drawer__btn--primary" {{on "click" this.onTryAgain}}>{{t "Try again" key="try_again"}}</button>
            <button type="button" class="ll-copy-drawer__btn" {{on "click" this.onDetails}}>{{t "See details" key="sync_see_details"}}</button>
          {{else}}
            <button type="button" class="ll-copy-drawer__btn ll-copy-drawer__btn--primary" {{on "click" this.onDetails}}>{{t "Sync Details" key="sync_details"}}</button>
            {{#if this.offer_try_again}}
              {{!-- A folder saved without its picture: try again, secondary; the close button still dismisses. --}}
              <button type="button" class="ll-copy-drawer__btn" {{on "click" this.onTryAgain}}>{{t "Try again" key="try_again"}}</button>
            {{else}}
              <button type="button" class="ll-copy-drawer__btn" {{on "click" this.onDismiss}}>{{t "Dismiss" key="dismiss"}}</button>
            {{/if}}
          {{/if}}
        </div>
      </div>
      <button type="button" class="ll-copy-drawer__close" aria-label={{t "Dismiss" key="dismiss"}} {{on "click" this.onDismiss}}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    {{/if}}
  </div>
{{/if}}
