{{#if this.copy_progress.status}}
  {{!-- --above-toast lifts this clear of <AppToast />. Both are position:fixed at
        z-index 10000 and, at <=480px, both span the full width at bottom:12px — the
        identical rectangle — so a toast raised during a background copy was painted
        over by this drawer (it renders later in application.hbs) and never seen.
        They also overlap on mid-width desktops (~144px at a 900px viewport). Only
        applied while a toast is actually on screen, so the resting position is
        unchanged. --}}
  <div class="ll-copy-drawer ll-copy-drawer--{{this.copy_progress.status}} {{if this.app_state.toast 'll-copy-drawer--above-toast'}}" role="status" aria-live="polite">
    {{#if this.copy_progress.is_copying}}
      <div class="ll-copy-drawer__spinner md-loading-spinner" aria-hidden="true"></div>
      <div class="ll-copy-drawer__body">
        <p class="ll-copy-drawer__title">{{t "Copying <strong>%{board_key}</strong>..." key='copying_board_in_background' board_key=this.copy_progress.board_key}}</p>
        <p class="ll-copy-drawer__hint">{{t "Keep working — we'll let you know as soon as it's done." key='copy_notify_when_complete'}}</p>
      </div>
    {{else}}
      <span class="ll-copy-drawer__icon" aria-hidden="true">
        {{#if this.copy_progress.is_done}}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        {{else}}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        {{/if}}
      </span>
      <div class="ll-copy-drawer__body">
        <p class="ll-copy-drawer__title">{{this.copy_progress.message}}</p>
        {{#if this.copy_progress.copy.key}}
          <p class="ll-copy-drawer__hint">{{this.copy_progress.copy.key}}</p>
        {{/if}}
        {{#if this.copy_progress.copy}}
          <div class="ll-copy-drawer__actions">
            <button type="button" class="ll-copy-drawer__btn ll-copy-drawer__btn--primary" {{on "click" this.onOpen}}>{{t "Open Board" key='open_board'}}</button>
            <button type="button" class="ll-copy-drawer__btn" {{on "click" this.onDismiss}}>{{t "Dismiss" key='dismiss'}}</button>
          </div>
        {{/if}}
      </div>
      <button type="button" class="ll-copy-drawer__close" aria-label={{t "Dismiss" key='dismiss'}} {{on "click" this.onDismiss}}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    {{/if}}
  </div>
{{/if}}
