{{!-- Grid-size picker. Rendered INLINE as the wizard's grid-size step: the panel IS
     that step's content, so there is no expander to open — the grid is on screen from
     the moment the step appears, and clicking a cell sets rows x columns in one
     gesture. The Rows/Cols steppers above it stay the primary, always-visible control
     and the accessible source of truth; this is the fast path and the preview, showing
     the SHAPE of the current size, which two number inputs never convey.
     See components/grid-size-picker.js for why it is its own component. --}}
<div class="nb-grid-picker">
  <div class="nb-grid-picker__panel" id="{{this.pickerId}}-panel">
    {{!-- Above the grid, and only once the board has outgrown it. `role="status"` so a
         screen reader hears it when the steppers push past the ceiling, rather than it
         being a silent visual-only caveat. It does not block or clamp anything -- the
         size stands; this only says the picture below has stopped matching it. --}}
    {{#if this.over_ceiling}}
      <p class="nb-grid-picker__notice" role="status">
        {{t "Grids larger than %{max} × %{max} may not display as expected." key="grid_over_max_notice" max=this.max_grid}}
      </p>
    {{/if}}
    {{!-- Events are delegated to this container rather than bound per cell:
         225 cells x 3 handlers would be 675 listeners. `mouseover` (not
         mouseenter) and `focusin` bubble, so both pointer and keyboard land
         here. --}}
    <div class="nb-grid-picker__grid"
         role="grid"
         aria-label={{t "Grid size" key="grid_size"}}
         {{on "mouseover" this.onGridPointer}}
         {{on "focusin" this.onGridPointer}}
         {{on "mouseleave" this.onClearHover}}
         {{on "click" this.onGridClick}}
         {{on "keydown" this.onGridKeydown}}>
      {{#each this.matrix key="row" as |line|}}
        {{!-- `display: contents` on the row (see .nb-grid-picker__row) keeps the
             cells auto-placing into the one CSS grid while completing the
             grid > row > gridcell ARIA structure. Same pattern as
             .md-board-detail-grid__row. --}}
        <div class="nb-grid-picker__row" role="row">
          {{#each line.cells key="col" as |cell|}}
            <button type="button"
                    role="gridcell"
                    class="nb-grid-picker__cell {{if cell.on "nb-grid-picker__cell--on"}}"
                    data-row={{cell.row}}
                    data-col={{cell.col}}
                    tabindex={{if cell.focusable "0" "-1"}}
                    aria-selected={{if cell.selected "true" "false"}}
                    aria-label={{cell.label}}></button>
          {{/each}}
        </div>
      {{/each}}
    </div>
    {{!-- Live readout only. Cancel / OK went with the popover: nothing is staged any
         more (a cell click commits straight to the caller) and there is no panel left
         to dismiss, so both were controls that could not do anything. --}}
    <div class="nb-grid-picker__footer">
      <p class="nb-grid-picker__readout" aria-live="polite">{{this.readout}}</p>
    </div>
  </div>
</div>
