<ModalDialog @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="modal-header md-modal-header">
    <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3 class="md-modal-title">{{t "Button List for %{board_name}" key="button_list_for" board_name=this.model.board.name}}</h3>
  </div>
  <div class="modal-body md-modal-body">
    {{#if this.translating}}
      <div class="md-translate-hero">
        <h4 class="md-translate-hero__title">{{t "Translating from %{lang1} to %{lang2}" lang1=this.source_language lang2=this.destination_language key="translating_to_lang"}}</h4>
        {{#if this.translating.loading}}
          <div class="md-translate-hero__spinner">
            <div class="md-loading-spinner" aria-hidden="true"></div>
          </div>
          <p class="md-translate-hero__caption">{{t "Loading translations..." key="loading_translations"}}</p>
        {{else if this.root_only_fallback}}
          <p class="md-translate-hero__caption md-translate-status--error">{{t "Linked board labels could not be loaded. Try again when online, or translate the root board only." key="linked_board_labels_load_failed"}}</p>
          <p class="md-translate-hero__caption">
            {{t "The translations below are auto-generated. Please review them to make sure they are correct for your communicator's language." key="please_review_translations"}}
          </p>
        {{else if this.translating.error}}
          {{#if this.translating.load_error}}
            <p class="md-translate-hero__caption md-translate-status--error">{{t "Linked board labels could not be loaded. Try again when online, or translate the root board only." key="linked_board_labels_load_failed"}}</p>
          {{else}}
            <p class="md-translate-hero__caption md-translate-status--error">{{t "Error loading translations, you can enter the translations by hand." key="error_loading_translations"}}</p>
          {{/if}}
        {{else if this.translating.not_enabled}}
          <p class="md-translate-hero__caption">{{t "Automatic translation is not enabled for this account. You can still enter translations by hand." key="translation_not_enabled_for_account"}}</p>
        {{else}}
          <p class="md-translate-hero__caption">
            {{t "The translations below are auto-generated. Please review them to make sure they are correct for your communicator's language." key="please_review_translations"}}
          </p>
        {{/if}}
      </div>
    {{else}}
      <div class="md-translate-actions-row">
        <div class="md-translate-filters" role="group" aria-label={{t "Button list filter" key="button_list_filter_aria"}}>
          <a href="#" {{on "click" (this.ctrlAction "filter" "all")}} class="md-translate-filter {{if this.show_all 'md-translate-filter--active'}}">{{t "Show All" key="show_all"}}</a>
          <a href="#" {{on "click" (this.ctrlAction "filter" "repeats")}} class="md-translate-filter {{if this.show_repeats 'md-translate-filter--active'}}">{{t "Show Repeats" key="show_repeats"}}</a>
        </div>
        <a href="#" {{on "click" (this.ctrlAction "download_list")}} class="md-translate-download">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>{{t "Download this list" key="download_this_list"}}</span>
        </a>
      </div>
    {{/if}}

    <div class="md-translate-list">
      {{#if this.translating}}
        <div class="md-translate-row md-translate-row--board">
          <div class="md-translate-row__source">{{this.model.board.name}}</div>
          <div class="md-translate-row__target">
            <input aria-label={{t "translation" key="translation_placeholder"}} value={{this.model.board.translated_name}} type="text" class="md-translate-input" placeholder={{t "translation" key="translation_placeholder"}} {{on "input" (set-field this "model.board.translated_name")}} />
          </div>
        </div>
      {{/if}}
      {{#each this.sorted_filtered_buttons as |button|}}
        <div class="md-translate-row {{if button.repeat 'md-translate-row--repeat'}}">
          {{#if this.translating}}
            <div class="md-translate-row__source">
              <span>{{button.label}}</span>
              {{#if button.linked_board_id}}
                <svg class="md-translate-row__source-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                </svg>
              {{/if}}
            </div>
            <div class="md-translate-row__target">
              <input aria-label={{t "translation" key="translation_placeholder"}} type="text" value={{button.translation}} class="md-translate-input" placeholder={{t "translation" key="translation_placeholder"}}  {{on "input" (set-field button "translation")}}/>
            </div>
            {{#if button.secondary_translation}}
              <div class="md-translate-row__source">
                <span>{{button.vocalization}}</span>
                {{#if button.linked_board_id}}
                  <svg class="md-translate-row__source-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                  </svg>
                {{/if}}
              </div>
              <div class="md-translate-row__target">
                <input aria-label={{t "translation" key="translation_placeholder"}} type="text" value={{button.secondary_translation}} class="md-translate-input" placeholder={{t "translation" key="translation_placeholder"}}  {{on "input" (set-field button "secondary_translation")}}/>
              </div>
            {{/if}}
          {{else}}
            <div class="md-translate-row__source">
              <span>{{button.label}}</span>
              {{#if this.show_all}}
                {{#if button.repeat}}
                  <span class="md-translate-row__source-tag">{{t "(repeat)" key="repeat_paren"}}</span>
                {{/if}}
              {{/if}}
              {{#if button.linked_board_id}}
                <svg class="md-translate-row__source-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                </svg>
              {{/if}}
            </div>
          {{/if}}
          <div class="md-translate-row__path">
            <LinkTo @route="board" @model={{button.board_key}}>{{button.board_key}}</LinkTo>
          </div>
        </div>
      {{/each}}
    </div>
  </div>
  <div class="modal-footer md-modal-footer">
    {{#if this.translating}}
      <button class="md-modal-btn md-modal-btn--cancel" {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
      <button class="md-modal-btn md-modal-btn--save" {{on "click" (this.ctrlAction "save_translations")}} disabled={{this.saving_translations}}>
        {{#if this.saving_translations}}
          <div class="md-loading-spinner md-translate-footer-spinner" aria-hidden="true"></div>
          {{t "Accepting Translations..." key="accepting_translations"}}
        {{else if this.error_saving_translations}}
          {{t "Error Accepting Translations" key="error_accepting_translations"}}
        {{else}}
          {{t "Accept Translations" key="accept_translations"}}
        {{/if}}
      </button>
    {{else}}
      <button class="md-modal-btn md-modal-btn--primary" {{on "click" (this.ctrlAction "close")}}>{{t "Close" key="close"}}</button>
    {{/if}}
  </div>
</ModalDialog>
