<GridListener @gridEvent={{this.ctrlAction "grid_event"}}>
<ModalDialog @standalone={{this.standalone}} @action={{this.onClose}} @opening={{this.onOpening}} @closing={{this.onClosing}}>
  <div class="board_drop {{if this.standalone "new-board--modern" "la-new-board-modal-wrap"}}">
    {{#if this.standalone}}
    <div class="modal-header md-modal-header">
      <h3>{{t "Create a New Board" key="create_a_new_board"}}</h3>
      <div class="create-board-actions">
        <span class="file_select_holder">
          <button type="button" class="btn btn-default">
            {{t "Import Board(s)" key="import_boards"}}
          </button>
          <input type="file" name="board_upload" id="board_upload" tabindex="-1" aria-label={{t "Import Board(s)" key="import_boards"}}>
        </span>
        {{#if this.paste_html_import_enabled}}
          <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "importFromHtml")}}>
            {{t "Paste HTML" key="paste_html"}}
          </button>
          <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "importFromJsonBundle")}}>
            {{t "Import Board from Another Platform" key="import_json_bundle"}}
          </button>
        {{/if}}
        {{#if this.ai_board_generation_enabled}}
          <button type="button" class="btn btn-default" {{on "click" (this.ctrlAction "generateWithAi")}}>
            {{t "Generate with AI" key="generate_with_ai"}}
          </button>
        {{/if}}
      </div>
    </div>
    {{else}}
    <div class="la-modal-header">
      <span class="la-modal-header-label">{{t "Create a New Board" key="create_a_new_board"}}</span>
      <div class="la-support-modal-header-meta">
        <button type="button" class="la-modal-close" {{on "click" (this.ctrlAction "close")}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
      </div>
    </div>
    {{/if}}
    <div class="{{if this.standalone "modal-body" "la-support-modal-body"}}">
      {{#unless this.standalone}}
      <div class="la-new-board-modal-actions">
        <span class="file_select_holder">
          <button type="button" class="la-btn la-btn--ghost">
            {{t "Import Board(s)" key="import_boards"}}
          </button>
          {{!-- Verified false positive: #board_upload appears in the if-standalone
               (header) and unless-standalone (body) branches, so provably only one
               renders. It is JS-targeted (getElementById + content-grabbers), so
               renaming breaks board import. --}}
          {{! template-lint-disable no-duplicate-id }}
          <input type="file" name="board_upload" id="board_upload" tabindex="-1" aria-label={{t "Import Board(s)" key="import_boards"}}>
          {{! template-lint-enable no-duplicate-id }}
        </span>
        {{#if this.paste_html_import_enabled}}
          <button type="button" class="la-btn la-btn--ghost" {{on "click" (this.ctrlAction "importFromHtml")}}>
            {{t "Paste HTML" key="paste_html"}}
          </button>
          <button type="button" class="la-btn la-btn--ghost" {{on "click" (this.ctrlAction "importFromJsonBundle")}}>
            {{t "Import Board from Another Platform" key="import_json_bundle"}}
          </button>
        {{/if}}
        {{#if this.ai_board_generation_enabled}}
          <button type="button" class="la-btn la-btn--ghost" {{on "click" (this.ctrlAction "generateWithAi")}}>
            {{t "Generate with AI" key="generate_with_ai"}}
          </button>
        {{/if}}
      </div>
      {{/unless}}
      <form class="nb-form {{unless this.standalone "la-new-board-form"}}" {{on "submit" (this.ctrlAction "saveBoard")}}>

        <section class="nb-section">
          <h4 class="nb-section__title">{{t "Basics" key="new_board_section_basics"}}</h4>
          <p class="nb-section__hint">{{t "Give your board a name and brief description." key="new_board_section_basics_hint"}}</p>
          <div class="nb-section__body">
            <div class="nb-basics-grid">
              <div class="nb-basics-grid__col nb-basics-grid__col--left">
                <div class="nb-field">
                  <label for="new_board_name" class="nb-field__label">{{t "Name" key="name"}}</label>
                  <input value={{this.model.name}} class="form-control nb-field__input" id="new_board_name" placeholder="My Board" {{on "input" (set-field this "model.name")}} />
                </div>
                <div class="nb-field new-board-field--description">
                  <label for="new_board_description" class="nb-field__label">{{t "Description" key="description"}}</label>
                  <textarea class="form-control nb-field__input nb-field__input--fill" id="new_board_description" placeholder="Brief description of the board" {{on "input" (set-field this "model.description")}}>{{this.model.description}}</textarea>
                </div>
              </div>
            </div>
            {{#if this.has_supervisees}}
              <div class="nb-field">
                <label for="for_user_id" class="nb-field__label">{{t "For" key="for"}}</label>
                <UserSelect @select_id="for_user_id" @selection={{this.for_user_id}} @action={{this.ctrlAction "setForUserId"}} />
              </div>
            {{/if}}
          </div>
        </section>

        <section class="nb-section">
          <div class="nb-section__head">
            <h4 class="nb-section__title">{{t "Size & Labels" key="new_board_section_size"}}</h4>
            <div class="new-board-dimensions" role="group" aria-label={{t "Grid size" key="grid_size"}}>
              <div class="nb-stepper-mini">
                <span class="nb-stepper-mini__label" id="nb-rows-label">{{t "Rows" key="rows"}}</span>
                <button type="button" class="nb-stepper-mini__btn" {{on "click" (this.ctrlAction "plus_minus" "minus" "model.grid.rows")}} aria-label={{t "Decrease rows" key="decrease_rows"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <input type="number" value={{this.model.grid.rows}} class="nb-stepper-mini__input" id="new_board_rows" aria-labelledby="nb-rows-label" {{on "input" (set-field this "model.grid.rows")}} />
                <button type="button" class="nb-stepper-mini__btn" {{on "click" (this.ctrlAction "plus_minus" "plus" "model.grid.rows")}} aria-label={{t "Increase rows" key="increase_rows"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 2.5 L6 9.5 M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="nb-stepper-mini">
                <span class="nb-stepper-mini__label" id="nb-cols-label">{{t "Cols" key="cols_short"}}</span>
                <button type="button" class="nb-stepper-mini__btn" {{on "click" (this.ctrlAction "plus_minus" "minus" "model.grid.columns")}} aria-label={{t "Decrease columns" key="decrease_columns"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <input type="number" value={{this.model.grid.columns}} class="nb-stepper-mini__input" id="new_board_columns" aria-labelledby="nb-cols-label" {{on "input" (set-field this "model.grid.columns")}} />
                <button type="button" class="nb-stepper-mini__btn" {{on "click" (this.ctrlAction "plus_minus" "plus" "model.grid.columns")}} aria-label={{t "Increase columns" key="increase_columns"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 2.5 L6 9.5 M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>
          </div>
          <div class="nb-hint-row">
            <ul class="nb-checklist nb-hint-row__text">
              <li class="nb-checklist__item">{{t "Auto-sizes as you add labels" key="new_board_size_hint_grid"}}</li>
              <li class="nb-checklist__item">{{t "Type, paste, or upload CSV" key="new_board_size_hint_input"}}</li>
              <li class="nb-checklist__item">{{t "Enter key adds word/word grouping" key="new_board_size_hint_grouping"}}</li>
            </ul>
            <div class="nb-field__radio-group nb-field__radio-group--inline nb-hint-row__controls" role="radiogroup" aria-label={{t "Fill order" key="fill_order"}}>
              <div class="nb-field__radio-row">
                <label class="nb-radio">
                  <input type="radio"
                         name="labels_order"
                         value="rows"
                         checked={{is_equal this.model.grid.labels_order "rows"}}
                         {{on "change" (this.ctrlAction "setLabelsOrder" "rows")}} />
                  <span class="nb-radio__label">{{t "Rows, left to right" key="rows_first_short"}}</span>
                </label>
                <label class="nb-radio">
                  <input type="radio"
                         name="labels_order"
                         value="columns"
                         checked={{is_equal this.model.grid.labels_order "columns"}}
                         {{on "change" (this.ctrlAction "setLabelsOrder" "columns")}} />
                  <span class="nb-radio__label">{{t "Columns, top to bottom" key="columns_first_short"}}</span>
                </label>
              </div>
            </div>
          </div>
          <div class="nb-section__body">
            <div class="nb-words-grid">
              <div class="nb-basics-grid__col nb-words-grid__col--labels">
                <div class="nb-field new-board-field--labels">
                  <div class="nb-field__label-row nb-field__label-row--page-center">
                    <label for="new_board_labels" class="nb-field__label">{{t "Labels" key="labels"}}</label>
                    <div class="nb-field__meta nb-field__meta--center">
                      <span class={{this.labels_class}}>
                        {{this.label_count}} {{t "labels" key="label_count"}}
                      </span>
                      <span class="nb-field__sep" aria-hidden="true">·</span>
                      <button type="button" class="nb-link" data-count={{this.label_count}} {{on "click" (this.ctrlAction "pick_core")}}>{{t "pick from core lists" key="pick_from_core_lists"}}</button>
                      {{#if this.speech}}
                        <span class="nb-field__sep" aria-hidden="true">·</span>
                        <button type="button" class="nb-link" data-count={{this.label_count}} {{on "click" (this.ctrlAction "record_words")}}>{{t "speech recognition" key="record_words"}}</button>
                      {{/if}}
                      {{#if this.label_count}}
                        <span class="nb-field__sep" aria-hidden="true">·</span>
                        <button type="button"
                                class="nb-link nb-link--danger"
                                {{on "click" (this.ctrlAction "clearGrid")}}
                                aria-label={{t "Clear all labels" key="clear_all_labels"}}>
                          <svg class="nb-link__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                            <path d="M3 4 L3 12 Q3 13 4 13 L10 13 Q11 13 11 12 L11 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2 4 L12 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            <path d="M5.5 4 L5.5 2.5 Q5.5 2 6 2 L8 2 Q8.5 2 8.5 2.5 L8.5 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M5.5 6.5 L5.5 10.5 M8.5 6.5 L8.5 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                          </svg>
                          <span>{{t "clear grid" key="clear_grid"}}</span>
                        </button>
                      {{/if}}
                      <button type="button" class="nb-link" style="display: none;" {{on "click" (this.ctrlAction "import_from_pdf")}}>{{t "import from pdf" key="import_from_pdf"}}</button>
                    </div>
                    <span class="nb-field__label-row__spacer" aria-hidden="true"></span>
                  </div>
                  {{#if this.has_duplicate_labels}}
                    <span class="nb-pill nb-pill--warn" role="status">
                      <svg class="nb-pill__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                        <path d="M7 1.5 L13 12 L1 12 Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                        <path d="M7 5.5 L7 8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                        <circle cx="7" cy="10.3" r="0.7" fill="currentColor"/>
                      </svg>
                      <span class="nb-pill__text">{{t "Duplicate labels detected" key="duplicate_labels_pill"}}</span>
                    </span>
                  {{/if}}
                  {{#if this.too_many_total_labels}}
                    <div class="nb-alert nb-alert--warning" role="alert">
                      <span class="nb-alert__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                          <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                          <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                          <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                        </svg>
                      </span>
                      <div class="nb-alert__body">
                        <p class="nb-alert__title">{{t "Too many labels" key="too_many_labels_title"}}</p>
                        <p class="nb-alert__text">{{t "You've entered %{count} labels — %{unused} of them won't be used because the grid maximum is %{max} buttons (20 × 20). Remove the extras or split them into a second board." key="too_many_labels_message" count=this.label_count unused=this.unused_label_count max=this.max_grid_labels}}</p>
                      </div>
                    </div>
                  {{/if}}
                  <LabelChips @value={{this.model.grid.labels}} @onChange={{this.ctrlAction "setLabels"}} @inputId="new_board_labels" @placeholder={{t "Type a word and press Enter, or paste a list" key="labels_chip_placeholder_short"}} />
                </div>
              </div>
            </div>
            {{#if this.core_lists}}
              <div class="nb-field">
                <ul class="nav nav-pills">
                  {{#each this.core_words as |core_word|}}
                    <li class={{if core_word.active "active"}}>
                      <button type="button" class="md-link-btn-pill" {{on "click" (this.ctrlAction "enable_word" core_word.id)}} aria-pressed={{if core_word.active "true" "false"}}>{{ core_word.label }}</button>
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{else}}
              {{#if this.speech.ready}}
                <div class="nb-field">
                  <div style="margin-bottom: 5px;">
                    {{t "Listening..." key="listening"}}
                    <button type="button" class='btn btn-default' {{on "click" (this.ctrlAction "next_word")}}>{{t "Next Word" key="next_word"}}</button>
                    <SpeechListener @content={{this.ctrlAction "speech_content"}} @error={{this.ctrlAction "speech_error"}} @stop={{this.ctrlAction "speech_stop"}} @speech={{this.speech}} />
                  </div>
                  <ul class="nav nav-pills">
                    {{#each this.speech.words as |word|}}
                      <li class="active" style="margin-right: 3px; margin-bottom: 3px;">
                        <button type="button" class="md-link-btn-pill" {{on "click" (this.ctrlAction "remove_word" word.id)}} aria-label={{t "Remove %{word}" key="remove_word_named" word=word.label}}>
                          {{word.label}}
                          <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                        </button>
                      </li>
                    {{/each}}
                  </ul>
                </div>
              {{else}}
                {{#if this.speech.almost_recording}}
                  <div class="nb-field">
                    <p>{{t "Waiting for Approval..." key="waiting_for_approval"}}</p>
                  </div>
                {{/if}}
              {{/if}}
            {{/if}}
            <div class="new-board-preview"
                 style={{this.preview_style}}
                 role="grid"
                 aria-label={{t "Board preview" key="board_preview"}}
                 {{on "dragover" (this.eventAction "previewDragOver")}}
                 {{on "drop" (this.eventAction "previewDrop")}}>
              {{#each this.preview_grid as |row|}}
                {{!-- grid → row → gridcell: the role="row" wrapper completes the
                     ARIA grid structure require-context-role requires. It carries
                     `display: contents` (.new-board-preview__row) so the cells keep
                     auto-placing into the same CSS grid — layout unchanged. --}}
                <div class="new-board-preview__row" role="row">
                {{#each row as |cell|}}
                  <div class="new-board-preview__cell {{if cell.empty "new-board-preview__cell--empty"}} {{if cell.editing "new-board-preview__cell--editing"}}"
                       role="gridcell"
                       draggable={{if (or cell.empty cell.editing) "false" "true"}}
                       {{on "dragstart" (this.eventAction "cellDragStart" cell.row cell.col)}}
                       {{on "dragover" (this.eventAction "cellDragOver")}}
                       {{on "drop" (this.eventAction "cellDrop" cell.row cell.col)}}
                       {{on "dragend" (this.eventAction "cellDragEnd")}}>
                    {{#if cell.editing}}
                      <input type="text"
                             id={{concat "new-board-cell-edit-" cell.idx}}
                             class="new-board-preview__edit-input"
                             value={{this._editValue}}
                             aria-label={{t "Edit label" key="edit_cell_label"}}
                             {{on "input" (this.ctrlActionEventValue "cellEditChanged" "value")}}
                             {{on "keydown" (this.eventAction "cellEditKeydown")}}
                             {{on "blur" (this.ctrlAction "commitCellEdit")}} />
                    {{else if cell.empty}}
                      <span class="new-board-preview__label">{{cell.label}}</span>
                    {{else}}
                      <button type="button"
                              class="new-board-preview__label-btn"
                              {{on "click" (this.ctrlActionNoBubble "startCellEdit" cell.idx)}}
                              aria-label={{t "Edit %{word}" key="edit_cell_label_named" word=cell.label}}>
                        <span class="new-board-preview__label">{{cell.label}}</span>
                      </button>
                    {{/if}}
                  </div>
                {{/each}}
                </div>
              {{/each}}
            </div>
          </div>
        </section>

        <section class="nb-section">
          <h4 class="nb-section__title">{{t "Visibility" key="new_board_section_appearance"}}</h4>
          <p class="nb-section__hint">{{t "Pick who can see this board." key="new_board_section_appearance_hint"}}</p>
          <div class="nb-section__body">
            <div class="nb-field new-board-field--visibility">
              <ModernSelect @class="new-board-visibility-select" @selectId="new_board_visibility" @content={{this.public_options}} @selection={{this.model.visibility}} @action={{this.ctrlAction "setVisibility"}} @ariaLabel={{t "Visibility" key="visibility"}} />
            </div>
          </div>
        </section>

        <section class="nb-section nb-section--advanced">
          <div class="nb-section__head">
            <h4 class="nb-section__title">{{t "Advanced options" key="new_board_section_advanced"}}</h4>
            {{#unless this.more_options}}
              <button type="button" class="md-link-btn nb-section__toggle" {{on "click" (this.ctrlAction "more_options")}}>{{t "Show advanced options" key="show_advanced_options"}}</button>
            {{/unless}}
          </div>
          {{#if this.more_options}}
            <div class="nb-section__body">
              <div class="nb-field new-board-field--icon">
                <label for="image_url" class="nb-field__label">{{t "Icon for your Board" key="icon_for_your_board"}}</label>
                <IconSelect @selection={{this.model.image_url}} @action={{fn (mut this.model.image_url)}} />
              </div>
              <div class="nb-field new-board-field--key">
                <label for="new_board_key" class="nb-field__label">{{t "Key" key="key"}}</label>
                <input value={{this.model.key}} class="form-control nb-field__input nb-field__input--narrow" id="new_board_key" placeholder={{this.key_placeholder}} {{on "input" (set-field this "model.key")}} />
              </div>
              <div class="nb-field new-board-field--license">
                <label for="license" class="nb-field__label">{{t "License" key="license"}}</label>
                <ModernSelect @class="new-board-select--modern" @selectId="license" @content={{this.license_options}} @selection={{this.model.license.type}} @action={{this.ctrlAction "setLicenseType"}} @ariaLabel={{t "License" key="license"}} />
              </div>
              <div class="nb-field new-board-field--locale">
                <label for="locale" class="nb-field__label">{{t "Language" key="locale"}}</label>
                <ModernSelect @class="new-board-select--modern" @selectId="locale" @content={{this.locales}} @selection={{this.model.locale}} @action={{this.ctrlAction "setLocale"}} @ariaLabel={{t "Language" key="locale"}} />
              </div>
              {{#if this.attributable_license_type}}
                <div class="nb-field nb-field--row">
                  <div class="nb-field__col">
                    <label for="author" class="nb-field__label">{{t "Author" key="author"}}</label>
                    <input value={{this.model.license.author_name}} class="form-control nb-field__input" id="author" placeholder="Name" {{on "input" (set-field this "model.license.author_name")}} />
                  </div>
                  <div class="nb-field__col">
                    <label for="author_url" class="nb-field__label">{{t "Author URL" key="author_url"}}</label>
                    <input value={{this.model.license.author_url}} class="form-control nb-field__input" id="author_url" title="Author URL" placeholder="Author URL" {{on "input" (set-field this "model.license.author_url")}} />
                  </div>
                </div>
              {{/if}}
              <div class="nb-field nb-field--checkbox new-board-checkbox-row">
                <label for="home_board" class="nb-checkbox">
                  <input type="checkbox" checked={{this.model.home_board}} id="home_board" {{on "change" (set-field this "model.home_board" "checkbox")}} />
                  <span>{{t "This board can be used as a home board" key="is_home_board"}}</span>
                </label>
              </div>
              {{#if this.model.home_board}}
                <div class="nb-field">
                  <p class="nb-field__hint">{{t "Select any categories that this home board may fit well into." key="select_categories"}}</p>
                  {{#each this.board_categories as |category|}}
                    <label class="nb-checkbox">
                      <input type="checkbox" checked={{category.selected}}  {{on "change" (set-field category "selected" "checkbox")}}/>
                      <span>{{category.name}}</span>
                    </label>
                  {{/each}}
                </div>
              {{/if}}
            </div>
          {{/if}}
        </section>
      </form>
    </div>
    <div class="{{if this.standalone "modal-footer" "la-new-board-modal-footer"}}">
      {{#if this.standalone}}
      <button {{on "click" (this.ctrlAction "saveBoard")}} class="btn btn-primary new-board__submit" disabled={{this.createBoardDisabled}}>
        {{#if this.status.saving}}
          {{t "Creating Board..." key="creating_board"}}
        {{else if this.status.error}}
          {{t "Error Creating Board" key="error_creating_board"}}
        {{else}}
          {{t "Create Board" key="create_board"}}
        {{/if}}
      </button>
      {{else}}
      <div class="la-new-board-modal-footer__actions">
        <button type="button" class="la-btn la-btn--ghost" {{on "click" (this.ctrlAction "close")}}>{{t "Cancel" key="cancel"}}</button>
        <button type="button" {{on "click" (this.ctrlAction "saveBoard")}} class="la-btn la-btn--primary new-board__submit" disabled={{this.createBoardDisabled}}>
          {{#if this.status.saving}}
            {{t "Creating Board..." key="creating_board"}}
          {{else if this.status.error}}
            {{t "Error Creating Board" key="error_creating_board"}}
          {{else}}
            {{t "Create Board" key="create_board"}}
          {{/if}}
        </button>
      </div>
      {{/if}}
    </div>
  </div>
</ModalDialog>
</GridListener>
