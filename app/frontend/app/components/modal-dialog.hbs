{{#if this.standalone}}
  <div class="modal-content modal-content--standalone">
    {{yield}}
  </div>
{{else}}
<div class="modal fade in" style="display: block;" data-uncloseable={{this.uncloseable}} role="dialog" aria-modal="true" aria-labelledby={{this.labelledBy}} aria-describedby={{this.describedBy}}>
  <div class="modal-dialog {{this.dialogClass}}">
    <TouchListener @select={{this.onAnySelect}}>
      <div class="modal-content {{this.contentClass}} {{if this.auto_close 'auto_close'}}">
        {{yield}}
      </div><!-- /.modal-content -->
    </TouchListener>
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
{{/if}}
