{{!-- The boards section owns its own loading state.
     The condition covers `board_list` being ABSENT as well as loading:
     `update_selected` assigns the Mine list asynchronously, so on the first paint
     board_list is undefined. The previous `{{#if board_list}}` wrapper rendered
     NOTHING in that window — a blank section body — which was invisible only
     because a full-viewport "Preparing your workspace" overlay sat on top of the
     whole page until the list resolved. That overlay is gone (the page now paints
     immediately), so this branch is what the user actually sees while boards load. --}}
{{#if (or (not this.boardsCtrl.board_list) this.boardsCtrl.board_list.loading)}}
  <div class="ub-boards-page__loading" role="status" aria-live="polite" aria-busy="true">
    <div class="md-loading-spinner" aria-hidden="true"></div>
    <p class="ub-boards-page__loading-label">{{t "Loading your boards..." key="loading_your_boards"}}</p>
  </div>
  {{else if this.boardsCtrl.board_list.error}}
    <p class="ub-boards-page__loading">{{t "Failed to load" key="failed_to_load"}}</p>
  {{else if this.boardsCtrl.board_list.results}}
    {{#if this.boardsCtrl.prior_home_selected}}
      <ul class="list-group" style="max-width: 350px;">
        {{#each this.boardsCtrl.board_list.filtered_results as |board|}}
          <li class="list-group-item">
            <LinkTo @route="board" @model={{board.board.key}}>{{board.board.key}}</LinkTo>
          </li>
        {{/each}}
      </ul>
      {{#if this.boardsCtrl.board_list.has_more}}
        <a href="#" {{on "click" (this.ctrlAction "show_more_boards")}}>{{t "show more" key="show_more"}}</a>
      {{else}}
        {{#unless this.boardsCtrl.show_all_boards}}
          <a href="#" {{on "click" (this.ctrlAction "show_more_boards")}}>{{t "show more" key="show_more"}}</a>
        {{/unless}}
      {{/if}}
    {{else}}
      {{#if this.boardsCtrl.board_list.sub_result}}
        <div class="ub-boards-page__subresult">
          <button type="button" class="ub-boards-page__subresult-back" {{on "click" (this.ctrlAction "load_children")}}>
            <span class="ub-boards-page__subresult-back-arrow" aria-hidden="true">←</span>
            {{t "Back to Full List" key="back_to_full_list"}}
          </button>
          <p class="ub-boards-page__subresult-label">{{t "Showing boards copied with %{k}" key="showing_boards_copied_with" k=this.boardsCtrl.parent_object.board.key}}</p>
        </div>
      {{/if}}

      {{!-- "Set / Change Home Board" button used to live up here as a
           centered single-pill row, but design moved it onto the
           Boards Filter row below (right-aligned next to the filter
           input). See the .ub-boards-page__boards-filter-row wrapper
           further down for the new mount point. --}}

      {{#if this.boardsCtrl.mineFoldersEnabled}}
        {{!-- Folders accordion: always renders when mineFoldersEnabled,
             whether or not a folder is drilled in. When drilled in,
             the folder strip is replaced by a folder-context row
             (FOLDER · name · edit/delete · back) so the "you're inside
             a folder" indicator lives in the Folders section rather
             than in the Boards section below. --}}
        {{!-- Entire folders accordion is a drop target — boards
             dragged onto the header, the toolbar, or the empty area
             beside the folder strip all fire the same "open the tag
             modal" flow. Inner folder tags and the strip drop zone
             have their own handlers and call stopPropagation so they
             win when the drop lands on them specifically. --}}
        <div class="ub-boards-page__folders-section {{if this.foldersExpanded 'ub-boards-page__folders-section--open'}}"
          {{on "dragover" (this.selfEventAction "emptyFolderDragOver")}}
          {{on "drop" (this.selfEventAction "emptyFolderDrop")}}>
          {{!-- Header row: split into three click targets so the action
               buttons (+ New folder / Tag a board) can sit visually
               between the title and the chevron without nesting
               <button> inside <button>. The title toggle on the left
               and the chevron toggle on the right BOTH fire the same
               expand/collapse action; the action buttons in the middle
               (rendered only when expanded) fire their own modals via
               bubbles=false so they don't trigger the toggle. --}}
          <div class="ub-boards-page__folders-header">
            <button
              type="button"
              class="ub-boards-page__folders-toggle"
              aria-expanded={{if this.foldersExpanded "true" "false"}}
              aria-controls="ub-boards-page__folders-body"
              {{on "click" (this.sendAction "toggleFoldersExpanded")}}
            >
              <span class="ub-boards-page__folders-title">
                <span class="ub-boards-page__section-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z"/></svg>
                </span>
                {{t "Folders" key="folders"}}
                <span class="ub-boards-page__folders-count" aria-label={{t "Folder count" key="folder_count"}}>{{this.filteredFolderSummaries.length}}</span>
              </span>
              {{!-- Inline tagline shown in the header just to the right
                   of the folder count chip. Replaces the previous
                   centered hint pill that lived inside the folder
                   strip. --}}
              <span class="ub-boards-page__folders-subtitle">{{t "Organize your boards" key="mine_folders_multi_tag_hint_v3_short"}}</span>
            </button>
            {{#if this.foldersExpanded}}
              {{#if this.boardsCtrl.model.permissions.model}}
                <div class="ub-boards-page__folders-actions ub-boards-page__folders-actions--header">
                  <button type="button" class="ub-boards-page__folders-action-btn" {{on "click" (this.ctrlActionNoBubble "openNewBoardFolderModal")}}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    {{t "New folder" key="new_board_folder_title"}}
                  </button>
                  <button type="button" class="ub-boards-page__folders-action-btn" {{on "click" (this.selfActionNoBubble "openTagBoardModal")}}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                    {{t "Tag a board" key="tag_a_board"}}
                  </button>
                </div>
              {{/if}}
            {{/if}}
            <button
              type="button"
              class="ub-boards-page__folders-chevron-btn"
              aria-label={{if this.foldersExpanded (t "Collapse folders" key="folders_collapse") (t "Expand folders" key="folders_expand")}}
              {{on "click" (this.sendAction "toggleFoldersExpanded")}}
            >
              <svg class="ub-boards-page__folders-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
          </div>
          {{#if this.foldersExpanded}}
          <div id="ub-boards-page__folders-body" class="ub-boards-page__folders-body">
            {{!-- Single toolbar row: Folders Filter pinned left, action
                 buttons pinned right via flex space-between. Filter +
                 buttons share vertical center. The filter form is
                 hidden when the user has zero folders — nothing to
                 filter yet. The New folder / Tag a board buttons stay
                 visible so the user can still create their first
                 folder; once one exists, the filter form (and the
                 folder strip below) come back automatically. --}}
            <div class="ub-boards-page__folders-toolbar">
              {{#if this.boardsCtrl.mineTagFolderSummaries.length}}
                <form class="ub-boards-page__folder-filter-form" {{on "submit" (this.ctrlAction "nothing")}}>
                  <span id="folder-filter-input-label" class="ub-boards-page__folder-filter-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    {{t "Folders Filter" key="folders_filter"}}
                  </span>
                  <input
                    id="folder-filter-input"
                    type="text"
                    class="ub-boards-page__folder-filter-input"
                    aria-labelledby="folder-filter-input-label"
                    autocomplete="off"
                    placeholder={{t "Search folders and boards..." key="filter_folders"}}
                    value={{this.folderFilterString}}
                    {{on "input" (this.selfEventAction "updateFolderFilter")}}
                  />
                  {{#if this.folderFilterString}}
                    <button type="button" class="ub-boards-page__folder-filter-clear" {{on "click" (this.sendAction "clearFolderFilter")}} aria-label={{t "Clear filter" key="clear_filter"}}>
                      {{t "Clear" key="clear"}}
                    </button>
                  {{/if}}
                </form>
              {{else}}
                {{!-- Compact "No folders yet" empty state — sits in the
                     same toolbar row as the New folder / Tag a board
                     buttons, occupying the left slot the filter form
                     would otherwise hold. Also acts as a drop target so
                     a user can drag a board onto it to create the
                     first folder via emptyFolderDrop. --}}
                <div class="ub-boards-page__folders-empty" role="status"
                  {{on "dragover" (this.selfEventAction "emptyFolderDragOver")}}
                  {{on "drop" (this.selfEventAction "emptyFolderDrop")}}
                >
                  <span class="ub-boards-page__folders-empty-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z"/>
                    </svg>
                  </span>
                  <span class="ub-boards-page__folders-empty-text">
                    <span class="ub-boards-page__folders-empty-headline">{{t "No folders yet" key="folders_empty_headline"}}</span>
                    <span class="ub-boards-page__folders-empty-hint">{{t "Create a folder or tag a board to organize your vocabularies." key="folders_empty_hint"}}</span>
                  </span>
                </div>
              {{/if}}
              {{!-- Action buttons (+ New folder, Tag a board) moved up
                   into the header row, just left of the chevron. See
                   .ub-boards-page__folders-actions--header above. --}}
            </div>
            {{#if this.boardsCtrl.mineTagFolderDrillIn}}
              {{!-- Folder destination view — replaces the folder strip
                   when drilled in. Three distinct layers:
                   (1) breadcrumb navigation row at the top
                   (2) identity block: large folder icon + name + subtitle
                   (3) action row: pill-styled Edit + Delete buttons
                   Each layer has its own breathing room so the user
                   reads them as separate purposes (navigation,
                   identity, actions) instead of one cramped toolbar. --}}
              <div class="ub-boards-page__folder-context">
                {{!-- TOP ROW — breadcrumb on the left, the way out centred.
                     A wrapper rather than placing both directly in the card grid: the card
                     is `auto 1fr auto`, whose middle column is only centred when the two
                     auto flanks happen to match, and its other children auto-place, so a
                     second item in the breadcrumb's row would have been dropped into the
                     identity row's first free cell. This row owns `1fr auto 1fr`, which
                     centres the link on the CARD regardless of how wide the breadcrumb
                     text gets. --}}
                <div class="ub-boards-page__folder-context-toprow">
                  {{!-- Breadcrumb row — clickable "Folders" returns to
                       the folder list; the current folder name sits
                       after a chevron separator. --}}
                  <nav class="ub-boards-page__folder-context-breadcrumb" aria-label={{t "Breadcrumb" key="breadcrumb"}}>
                    <button type="button" class="ub-boards-page__folder-context-breadcrumb-back" {{on "click" (this.ctrlAction "exitMineFolderTag")}}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                      <span>{{t "Folders" key="folders"}}</span>
                    </button>
                    <span class="ub-boards-page__folder-context-breadcrumb-sep" aria-hidden="true">/</span>
                    <span class="ub-boards-page__folder-context-breadcrumb-current">{{this.boardsCtrl.mineTagFolderDrillIn}}</span>
                  </nav>
                  <a href="#" class="ub-boards-page__folder-context-back" {{on "click" (this.ctrlAction "exitMineFolderTag")}}>
                    <svg class="ub-boards-page__folder-context-back-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    <span class="ub-boards-page__folder-context-back-label">{{t "Back to Folders" key="folder_context_back"}}</span>
                  </a>
                {{!-- Delete. Swapped with the boards-in-folder dropdown
                     (2026-08-17, requested): this now occupies the top row's right
                     track. The Edit pill was removed in favor of the inline pencil
                     icon next to the folder name. --}}
                {{#unless this.editingFolderName}}
                  <div class="ub-boards-page__folder-context-actions">
                    <button type="button" class="ub-boards-page__folder-context-action ub-boards-page__folder-context-action--delete" {{on "click" (this.sendAction "startDeleteFolder")}}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      <span>{{t "Delete" key="delete"}}</span>
                    </button>
                  </div>
                {{/unless}}
                </div>
                {{!-- Identity block — large folder icon, name as page
                     title, plus subtitle hint. This is the "destination"
                     anchor of the view. --}}
                <div class="ub-boards-page__folder-context-identity">
                  <div class="ub-boards-page__folder-context-identity-icon" aria-hidden="true">
                    {{!-- Two-path layered folder for depth: the "back"
                         path is the full folder body including the tab
                         on top-left; the "front" path overlays the
                         visible face of the folder with a slightly
                         lighter tone. Reads as a manila card with a
                         peeking tab rather than a flat silhouette. --}}
                    <svg class="ub-boards-page__folder-context-identity-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="none">
                      <path class="ub-boards-page__folder-context-identity-icon-back" d="M2 6.5a2 2 0 0 1 2-2h5.5a2 2 0 0 1 1.41.58l1.5 1.5a2 2 0 0 0 1.41.58H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/>
                      <path class="ub-boards-page__folder-context-identity-icon-front" d="M2 9.5h20v8.5a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/>
                    </svg>
                  </div>
                  <div class="ub-boards-page__folder-context-identity-text">
                    {{#if this.editingFolderName}}
                      <form class="ub-boards-page__folder-rename-form" {{on "submit" this.onSaveFolderRename}}>
                        <input class="ub-boards-page__folder-rename-input" type="text" value={{this.editFolderNameValue}} {{on "input" (set-field this "editFolderNameValue")}} aria-label={{t "Folder name" key="folder_name"}} />
                        <button type="submit" class="ub-boards-page__folder-rename-save" aria-label={{t "Save" key="save"}}>
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </button>
                        <button type="button" class="ub-boards-page__folder-rename-cancel" {{on "click" (this.sendAction "cancelFolderRename")}} aria-label={{t "Cancel" key="cancel"}}>
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                      </form>
                    {{else}}
                      <h3 class="ub-boards-page__folder-context-name">
                        <span class="ub-boards-page__folder-context-name-text">{{this.boardsCtrl.mineTagFolderDrillIn}}</span>
                        {{!-- Inline rename trigger — verdigris pencil sat right
                             after the folder name. Replaces the standalone
                             "Edit" pill in the actions row so the affordance
                             reads as "edit this name" instead of "edit this
                             folder entity". Same startFolderRename action. --}}
                        <button type="button"
                          class="ub-boards-page__folder-context-name-edit"
                          {{on "click" (this.selfActionNoBubble "startFolderRename")}}
                          aria-label={{t "Rename folder" key="rename_folder"}}
                          title={{t "Rename folder" key="rename_folder"}}>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>
                      </h3>
                      <p class="ub-boards-page__folder-context-description">{{t "Organize related vocabularies and page-sets" key="folder_context_description"}}</p>
                    {{/if}}
                  </div>
                </div>
                {{!-- Boards-in-folder dropdown. Swapped with the Delete row
                     (2026-08-17, requested): this now sits on the identity row at the
                     card's right edge, where Delete used to be. --}}
                {{!-- Boards-in-folder dropdown — sits between the identity
                     block and the actions row. Lists every board tagged
                     with this folder; each row has a modern × button that
                     untags the board (the board itself is not deleted). --}}
                {{#unless this.editingFolderName}}
                  <div class="ub-boards-page__folder-context-boards-menu">
                    <button type="button"
                      class="ub-boards-page__folder-context-boards-menu-trigger {{if this.folderBoardsMenuOpen 'ub-boards-page__folder-context-boards-menu-trigger--open'}}"
                      aria-haspopup="true"
                      aria-expanded={{if this.folderBoardsMenuOpen "true" "false"}}
                      {{on "click" (this.selfActionNoBubble "toggleFolderBoardsMenu")}}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7" rx="1"/>
                        <rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/>
                        <rect x="14" y="14" width="7" height="7" rx="1"/>
                      </svg>
                      <span class="ub-boards-page__folder-context-boards-menu-label">{{t "Boards in this folder" key="boards_in_this_folder"}}</span>
                      <span class="ub-boards-page__folder-context-boards-menu-count">{{this.folderBoardsList.length}}</span>
                      <svg class="ub-boards-page__folder-context-boards-menu-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"/>
                      </svg>
                    </button>
                    {{#if this.folderBoardsMenuOpen}}
                      <div class="ub-boards-page__folder-context-boards-menu-panel" role="group" aria-label={{t "Boards in this folder" key="boards_in_this_folder"}}>
                        {{!-- Inline search — filters folderBoardsList by name
                             so the user can quickly find a board when the
                             folder has many. Focus is set on open via the
                             toggle action below. --}}
                        <div class="ub-boards-page__folder-context-boards-menu-search">
                          <svg class="ub-boards-page__folder-context-boards-menu-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                          </svg>
                          <input
                            type="text"
                            class="ub-boards-page__folder-context-boards-menu-search-input"
                            autocomplete="off"
                            placeholder={{t "Search boards..." key="folder_menu_search_placeholder"}}
                            aria-label={{t "Search boards in this folder" key="folder_menu_search_label"}}
                            value={{this.folderBoardsSearch}}
                            {{on "input" (this.selfEventAction "updateFolderBoardsSearch")}}
                          />
                          {{#if this.folderBoardsSearch}}
                            <button type="button"
                              class="ub-boards-page__folder-context-boards-menu-search-clear"
                              {{on "click" (this.selfActionNoBubble "clearFolderBoardsSearch")}}
                              aria-label={{t "Clear search" key="clear_search"}}>
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                          {{/if}}
                        </div>
                        {{#each this.filteredFolderBoardsList key="@index" as |entry|}}
                          <div class="ub-boards-page__folder-context-boards-menu-row">
                            {{!-- Row name acts as an open-in-speak-mode trigger.
                                 Separate sibling button from the × so we don't
                                 nest interactives — bubble of the open-action
                                 is the implicit row click; × uses bubbles=false
                                 so it doesn't double-fire the open action. --}}
                            <button type="button"
                              class="ub-boards-page__folder-context-boards-menu-row-open"
                              {{on "click" (this.sendAction "openBoardFromMenu" entry.board)}}
                              title={{entry.name}}>
                              {{entry.name}}
                            </button>
                            <button type="button"
                              class="ub-boards-page__folder-context-boards-menu-row-remove"
                              {{on "click" (this.selfActionNoBubble "removeBoardFromFolder" entry.board)}}
                              aria-label={{t "Remove from folder" key="remove_from_folder"}}
                              title={{t "Remove from folder" key="remove_from_folder"}}>
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                          </div>
                        {{else}}
                          <p class="ub-boards-page__folder-context-boards-menu-empty">
                            {{#if this.folderBoardsSearch}}
                              {{t "No matching boards." key="folder_menu_search_empty"}}
                            {{else}}
                              {{t "No boards in this folder yet." key="folder_menu_empty"}}
                            {{/if}}
                          </p>
                        {{/each}}
                      </div>
                    {{/if}}
                  </div>
                {{/unless}}
                {{#if this.confirmingFolderDelete}}
                  <div class="la-delete-folder-backdrop" {{on "click" (this.sendAction "cancelDeleteFolder")}}></div>
                  <div class="la-delete-folder-modal la-delete-folder-modal--inline">
                    <div class="la-modal-header">
                      <span class="la-modal-header-label">{{t "Delete folder" key="delete_folder"}}</span>
                      <button type="button" class="la-modal-close" {{on "click" (this.sendAction "cancelDeleteFolder")}} aria-label={{t "Close" key="close"}}>✕</button>
                    </div>
                    <div class="la-delete-folder-modal-body">
                      <div class="la-delete-folder-modal-icon" aria-hidden="true">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      </div>
                      <p class="la-delete-folder-modal-title">{{t "Are you sure you want to delete" key="confirm_delete_folder_pre"}} <strong>"{{this.boardsCtrl.mineTagFolderDrillIn}}"</strong>?</p>
                      <p class="la-delete-folder-modal-desc">{{t "The boards in this folder won't be deleted. They will be moved back to the main boards view where you can reorganize them." key="delete_folder_explainer"}}</p>
                    </div>
                    <div class="la-delete-folder-modal-actions">
                      <button type="button" class="la-delete-folder-modal-delete" {{on "click" (this.sendAction "confirmDeleteFolder")}} disabled={{this.deletingFolder}}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        {{t "Delete folder" key="delete_folder"}}
                      </button>
                      <button type="button" class="la-delete-folder-modal-cancel" {{on "click" (this.sendAction "cancelDeleteFolder")}}>{{t "Cancel" key="cancel"}}</button>
                    </div>
                  </div>
                {{/if}}
                {{!-- Boards inside the drilled-in folder render here so
                     the folder card itself becomes the destination
                     container. The Boards summary section below is
                     hidden while drilled in (see {{#unless drill-in}}
                     wrap further down) so the boards appear only here,
                     not in two places. --}}
                <div class="ub-boards-page__folder-context-boards" role="region" aria-label={{t "Boards in folder" key="boards_in_folder"}}>
                  <div
                    class="ub-boards-page__board-grid {{if this.compactBoards 'll-boards-grid--compact'}}"
                    aria-describedby={{this.boardGridAriaDescribedby}}
                  >
                    {{#each this.boardsCtrl.boards_page_visible_results key="board.id" as |board|}}
                      {{#if board.board.key}}
                        {{#unless board.board.removed}}
                          <div
                            class="ub-boards-page__board-item board_with_action simple_board_holder {{if (and this.boardsCtrl.mine_selected this.boardsCtrl.model.permissions.edit) "ub-boards-page__board-item--draggable"}} {{if (is-equal board.board.key this.boardsCtrl.model.preferences.home_board.key) 'ub-boards-page__board-item--home'}} {{if board.board.starred_for_current_user 'ub-boards-page__board-item--liked'}}"
                            draggable={{if (and this.boardsCtrl.mine_selected this.boardsCtrl.model.permissions.edit) "true" "false"}}
                            {{on "dragstart" (this.selfEventAction "boardDragStart" board.board)}}
                          >
                            {{#if (is-equal board.board.key this.boardsCtrl.model.preferences.home_board.key)}}
                              <span class="ub-boards-page__board-item-home-badge">{{t "Home Board" key="home_board"}}</span>
                            {{/if}}
                            {{#if board.board.starred_for_current_user}}
                              <span class="ub-boards-page__board-item-heart" aria-label={{t "Liked" key="starred"}} title={{t "Liked" key="starred"}}>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                                  <path d="M12 21s-7.5-4.5-9.5-9.5C1.2 7.6 3.6 4 7.3 4c2 0 3.5 1 4.7 2.6C13.2 5 14.7 4 16.7 4c3.7 0 6.1 3.6 4.8 7.5C19.5 16.5 12 21 12 21z"/>
                                </svg>
                              </span>
                            {{/if}}
                            <BoardIcon @board={{board}} @compactRow={{this.compactBoards}} @onAction={{this.onOpenBoardInUserView}} @removeType={{this.boardsCtrl.board_list.remove_type}} @removeLabel={{this.boardsCtrl.board_list.remove_label}} @removeIcon={{this.boardsCtrl.board_list.remove_icon}} @removeCallback={{if this.boardsCtrl.model.permissions.edit (this.ctrlAction "remove_board" this.boardsCtrl.board_list.remove_type board.board)}} />
                            {{#if this.boardsCtrl.model.permissions.edit}}
                              {{!-- Contextual remove affordance. DELETE is deliberately NOT offered
                                   here: a hover-only trash can sitting on a board tile is a one-click
                                   path to destroying a whole board set, and being hover-only it never
                                   existed on touch devices in the first place. Deleting a board lives
                                   in Board Actions and Board Details, and in the board preview —
                                   BoardIcon still receives @removeCallback above, so the preview's
                                   touch-reachable remove is unaffected. The NON-destructive contextual
                                   removes (un-like, unlink, untag) stay: undoing one costs a click. --}}
                              {{#if (and board.board.id (not (is-equal this.boardsCtrl.board_list.remove_type "delete")))}}
                                <button class="board_action" type="button" {{on "click" (this.ctrlAction "remove_board" this.boardsCtrl.board_list.remove_type board.board)}}>
                                  <span title={{this.boardsCtrl.board_list.remove_label}}><span class={{this.boardsCtrl.board_list.remove_icon}}></span></span>
                                </button>
                              {{/if}}
                            {{/if}}
                          </div>
                        {{/unless}}
                      {{/if}}
                    {{else}}
                      <p class="ub-boards-page__folder-context-empty">{{t "No boards in this folder yet. Drag a board onto a folder, or use \"Tag a board\" to add one." key="folder_empty_hint"}}</p>
                    {{/each}}
                    {{#if this.boardsCtrl.boards_page_search_truncated}}
                      <p class="ub-boards-page__filter-truncated-hint">{{t "Showing the first %{count} matches. Keep typing to narrow results." key="boards_filter_truncated_hint" count=this.boardsCtrl.boards_page_search_limit}}</p>
                    {{/if}}
                    {{#if this.boardsCtrl.board_list.has_more}}
                      {{#unless this.boardsCtrl.filterString}}
                        <div class="ub-boards-page__show-more" style="overflow-anchor: none;">
                          <a href="#" class="ub-boards-page__show-more-btn" {{on "click" (this.ctrlAction "show_more_boards")}}>
                            {{t "More" key="more"}}
                            <span class="ub-boards-page__show-more-chevrons" aria-hidden="true">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                            </span>
                          </a>
                        </div>
                      {{/unless}}
                    {{/if}}
                  </div>
                </div>
              </div>
            {{else}}
              {{!-- Folder strip — only renders when the user has at
                   least one folder AND is not drilled into one. --}}
              {{#if this.boardsCtrl.mineTagFolderSummaries.length}}
                <div class="ub-boards-page__folder-strip" role="list" aria-label={{t "Board folders" key="mine_board_folders_label"}}
                  {{on "dragover" (this.selfEventAction "emptyFolderDragOver")}}
                  {{on "drop" (this.selfEventAction "emptyFolderDrop")}}
                >
                  {{#each this.filteredFolderSummaries as |folder|}}
                    <button
                      type="button"
                      class="ub-boards-page__tag-folder"
                      role="listitem"
                      {{on "click" (this.ctrlAction "enterMineFolderTag" folder.tag)}}
                      {{on "dragover" (this.selfEventAction "folderDragOver" folder.tag)}}
                      {{on "dragenter" (this.selfEventAction "folderDragEnter" folder.tag)}}
                      {{on "dragleave" (this.selfEventAction "folderDragLeave" folder.tag)}}
                      {{on "drop" (this.selfEventAction "folderDrop" folder.tag)}}
                    >
                      <span class="ub-boards-page__tag-folder-back">
                        <span class="ub-boards-page__tag-folder-tab"></span>
                      </span>
                      <span class="ub-boards-page__tag-folder-card">
                        <span class="ub-boards-page__tag-folder-name">{{folder.tag}}</span>
                        <span class="ub-boards-page__tag-folder-count">{{folder.count}}</span>
                      </span>
                    </button>
                  {{/each}}
                </div>
              {{/if}}
            {{/if}}
          </div>
          {{/if}}
        </div>
      {{/if}}

      {{!-- Boards Summary section: same sunken-in chrome as the
           Folders accordion above (`.ub-boards-page__folders-section`
           inset gradient + shadow). Static header — no chevron, no
           toggle — surfaces the BOARDS / FAVORITES counts and the
           "+ New Board" entry point. Body always-open; wraps the
           filter row, tabs, folder-drill-in context, and the board
           grid so they read as the contents of this section.
           Hidden entirely while drilled into a folder — the folder
           card above becomes the sole boards container. --}}
      {{#unless this.boardsCtrl.mineTagFolderDrillIn}}
      <div class="ub-boards-page__boards-summary-section">
        <div class="ub-boards-page__boards-summary-header">
          <span class="ub-boards-page__boards-summary-title">
            <span class="ub-boards-page__section-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
              </svg>
            </span>
            {{t "BOARDS" key="boards_upper"}}
          </span>
          {{#if this.boardsCtrl.model.my_boards.done}}
              {{!-- Dual-stat split: "in folders" + "in this section".
                   Replaces the single ambiguous total chip — that
                   number didn't match the visible tile count
                   whenever any root board was tagged into a folder
                   (filtered out of the grid). Splitting tells the
                   user exactly where their boards live: tagged-into-
                   folders vs sitting in the BOARDS grid. The two
                   substats always sum to the total root count. The
                   in-folders pill is only rendered when there's
                   actually something in folders, so a clean
                   no-folders user just sees the unfiled count.
                   Moved out of the title span so it becomes a
                   sibling at the header level — at narrow widths
                   the header's flex-column layout (in app.scss)
                   can now place it on its own row below the title
                   instead of having it ride inside the title. --}}
              <span class="ub-boards-page__boards-summary-stats" aria-label={{t "Board count" key="board_count"}}>
                {{#if this.boardsCtrl.myBoardsInFoldersCount}}
                  <span class="ub-boards-page__boards-summary-stat ub-boards-page__boards-summary-stat--in-folders">
                    <svg class="ub-boards-page__boards-summary-stat-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z"/></svg>
                    <span class="ub-boards-page__boards-summary-stat-num">{{this.boardsCtrl.myBoardsInFoldersCount}}</span>
                    <span class="ub-boards-page__boards-summary-stat-label">{{t "in folders" key="boards_count_in_folders"}}</span>
                  </span>
                  <span class="ub-boards-page__boards-summary-stats-sep" aria-hidden="true"></span>
                {{/if}}
                <span class="ub-boards-page__boards-summary-stat ub-boards-page__boards-summary-stat--unfiled">
                  <svg class="ub-boards-page__boards-summary-stat-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/>
                    <rect x="14" y="14" width="7" height="7" rx="1"/>
                  </svg>
                  <span class="ub-boards-page__boards-summary-stat-num">{{this.boardsCtrl.myBoardsUnfiledCount}}</span>
                  <span class="ub-boards-page__boards-summary-stat-label">{{t "in this section" key="boards_count_in_this_section"}}</span>
                </span>
                {{!-- Info affordance — only rendered when the home
                     board is tagged into a folder, the one case where
                     the unfiled pill includes a duplicate tile (the
                     home always stays visible here regardless of
                     folder filtering). Click toggles a brief popover
                     that explains the +1 to the user; click-outside
                     dismisses it. --}}
                {{#if this.boardsCtrl.homeBoardIsTagged}}
                  <span class="ub-boards-page__boards-summary-info-wrap">
                    <button type="button"
                      class="ub-boards-page__boards-summary-info-btn {{if this.homeBoardInfoOpen 'ub-boards-page__boards-summary-info-btn--open'}}"
                      aria-haspopup="true"
                      aria-expanded={{if this.homeBoardInfoOpen "true" "false"}}
                      aria-label={{t "Why is the home board counted in both?" key="home_board_count_info_label"}}
                      title={{t "Why is the home board counted in both?" key="home_board_count_info_label"}}
                      {{on "click" (this.selfActionNoBubble "toggleHomeBoardInfo")}}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="16" x2="12" y2="12"/>
                        <line x1="12" y1="8" x2="12.01" y2="8"/>
                      </svg>
                    </button>
                    {{#if this.homeBoardInfoOpen}}
                      <div class="ub-boards-page__boards-summary-info-popover" role="tooltip">
                        <div class="ub-boards-page__boards-summary-info-popover-title">{{t "Your home board" key="home_board_count_info_title"}}</div>
                        <p class="ub-boards-page__boards-summary-info-popover-body">{{t "Your home board stays visible in this section even when it's organized into a folder, so you can always reach it from the boards page. That's why it appears in both the folder count and the count here." key="home_board_count_info_body"}}</p>
                      </div>
                    {{/if}}
                  </span>
                {{/if}}
              </span>
            {{/if}}
          <LinkTo @route="board-picker" @query={{this.boardPickerQuery}}
            class="ub-boards-page__set-home-btn ub-boards-page__set-home-btn--in-header">
            <svg class="ub-boards-page__set-home-btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none" width="16" height="16" aria-hidden="true">
              <path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z"/>
            </svg>
            {{this.boardsCtrl.setHomeButtonLabel}}
          </LinkTo>
        </div>
        <div class="ub-boards-page__boards-summary-body">

      {{#unless this.boardsCtrl.allBoardsCategorized}}
        {{!-- Boards Filter row: filter form pinned left (aligned with
             the boards grid below), Set/Change Home Board button
             pinned right. Wrapper flexes them onto one row.
             Order is filter row FIRST, then the tabs (underline
             variant) — design moved the tabs below the filter so
             the primary affordance on first glance is the search,
             not the category switch. --}}
        <div class="ub-boards-page__boards-filter-row">
        <form class="ub-boards-page__filter-form" {{on "submit" (this.ctrlAction "nothing")}}>
          <span id="{{this.filterInputId}}-label" class="ub-boards-page__filter-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            {{t "Boards Filter" key="boards_filter"}}
          </span>
          <input
            id={{this.filterInputId}}
            type="text"
            class="ub-boards-page__filter-input"
            aria-labelledby="{{this.filterInputId}}-label"
            autocomplete="off"
            placeholder={{t "Filter boards..." key="filter_results"}}
            value={{this.boardsCtrl.filterString}}
            {{on "input" (this.eventAction "updateFilterString")}}
          />
          {{#if this.boardsCtrl.filterString}}
            <button type="button" class="ub-boards-page__filter-clear" {{on "click" (this.ctrlAction "clearFilter")}} aria-label={{t "Clear filter" key="clear_filter"}}>
              {{t "Clear" key="clear"}}
            </button>
          {{/if}}
        </form>
        {{#if this.boardsCtrl.boards_page_search_incomplete}}
          <p class="ub-boards-page__filter-truncated-hint" role="status">{{t "Still loading your library. Some boards may not appear in results yet." key="boards_filter_library_loading"}}</p>
        {{/if}}
        </div>
        {{!-- Tabs row — tabs on the left, "+ New Board" button
             pinned right on the same baseline. The wrapper hosts the
             layered gradient divider beneath both so the seam under
             the tab strip extends across the full row (including the
             button area), not just under the tabs. --}}
        <div class="ub-boards-page__tabs-row">
        {{!-- ≤640px collapsed picker. Shown only at ≤640px via
             `.ub-boards-page__tabs-mobile-picker` in app.scss; the styled
             .ub-boards-page__tabs pill row below hides at the same breakpoint.

             <ModernSelect>, NOT a native <select>: a native select's POPUP is
             OS-rendered and effectively unstyleable — `option` padding is
             ignored and the highlight row is the browser's — so the collapsed
             picker could never match the rest of the page no matter what CSS
             the trigger carried. This renders a real list we control, and
             brings keyboard nav, an ARIA listbox and click-outside with it.

             Contents MIRROR THE DESKTOP TAB ROW and must keep doing so — see
             `boardsSectionOptions` in the .js, which builds the two top-level
             entries plus a `heading` row for everything the desktop hides
             behind [More ▾], in the same order under the same permission
             gates. `tag:` ids route to `set_tag` rather than `set_selected`
             (see onBoardsSectionChoose). --}}
        <ModernSelect
          @class="md-modal-modern-select ub-boards-page__tabs-mobile-picker"
          @selectId="boards-section-picker"
          @content={{this.boardsSectionOptions}}
          @selection={{this.boardsSectionSelection}}
          @action={{this.onBoardsSectionChoose}}
          @ariaLabel={{t "Boards section" key="boards_section_picker"}} />
        <ul class="ub-boards-page__tabs ub-boards-page__tabs--boards" role="tablist">
          {{#if this.boardsCtrl.model.permissions.edit}}
            <li role="presentation" class={{if this.boardsCtrl.mine_selected "is-active"}}><a href="#" {{on "click" (this.ctrlAction "set_selected" "mine")}}>{{t "My Boards" key="my_boards"}}</a></li>
          {{else if this.boardsCtrl.model.permissions.model}}
            <li role="presentation" class={{if this.boardsCtrl.mine_selected "is-active"}}><a href="#" {{on "click" (this.ctrlAction "set_selected" "mine")}}>{{t "My Boards" key="my_boards"}}</a></li>
          {{/if}}
          {{#unless this.appState.currentUser.modeling_only}}
            <li role="presentation" class={{if this.boardsCtrl.public_selected "is-active"}}><a href="#" {{on "click" (this.ctrlAction "set_selected" "public")}}>{{t "Public Boards" key="public_boards"}}</a></li>
          {{/unless}}
          {{#unless this.appState.currentUser.modeling_only}}
            {{#if this.boardsCtrl.model.permissions.model}}
              <li role="presentation" class="dropdown {{if this.boardsCtrl.other_selected "is-active"}}">
                <a class="dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">
                  {{this.boardsCtrl.more_label}} <span class="caret"></span>
                </a>
                <ul class="dropdown-menu">
                  {{#if this.boardsCtrl.model.permissions.model}}
                    <li><a href="#" {{on "click" (this.ctrlAction "set_selected" "root")}}>{{t "Root" key="root"}}</a></li>
                  {{/if}}
                  <li><a href="#" {{on "click" (this.ctrlAction "set_selected" "starred")}}>{{t "Liked" key="starred"}}</a></li>
                  {{#if this.boardsCtrl.model.permissions.edit}}
                    <li><a href="#" {{on "click" (this.ctrlAction "set_selected" "shared")}}>{{t "Shared with Me" key="shared_with_me"}}</a></li>
                  {{/if}}
                  {{#if this.boardsCtrl.model.prior_home_boards}}
                    <li><a href="#" {{on "click" (this.ctrlAction "set_selected" "prior_home")}}>{{t "Prior Home Boards" key="prior_home"}}</a></li>
                  {{/if}}
                  {{#if this.boardsCtrl.model.permissions.edit}}
                    <li><a href="#" {{on "click" (this.ctrlAction "set_selected" "private")}}>{{t "Private" key="private"}}</a></li>
                  {{/if}}
                  {{#each this.boardsCtrl.model.board_tags as |tag|}}
                    <li><a href="#" {{on "click" (this.ctrlAction "set_tag" tag)}}>{{tag}}</a></li>
                  {{/each}}
                </ul>
              </li>
            {{/if}}
          {{/unless}}
        </ul>
        {{#if this.boardsCtrl.model.permissions.edit}}
          <button type="button" class="ub-boards-page__boards-summary-new-btn ub-boards-page__boards-summary-new-btn--in-tabs-row" {{on "click" (this.ctrlAction "newBoard")}}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            {{t "New Board" key="create_a_new_board"}}
          </button>
        {{/if}}
        </div>{{!-- /.ub-boards-page__tabs-row --}}
        {{!-- Board display density — the SAME control as the board picker's, reusing its
             `bp-segmented` classes and markup so the two are one component visually and
             behaviourally. Compact first, matching the picker's order and for the same
             reason: a segmented control reads left-to-right as least-to-most detail.
             Native <button>s with aria-pressed, so the state is not carried by colour
             alone. The compact STYLING is shared too — both pages emit
             `ll-boards-grid--compact` and the rules live once in _board_picker.scss. --}}
        <div class="bp-segmented ub-boards-page__density" role="group" aria-label={{t "Board display style" key="board_picker_display_style"}}>
          <button type="button" class="bp-segmented__option {{if this.compactBoards "bp-segmented__option--active"}}" aria-pressed={{if this.compactBoards "true" "false"}} {{on "click" (this.sendAction "setCompactBoards" true)}}>
            {{t "Compact" key="board_picker_compact"}}
          </button>
          <button type="button" class="bp-segmented__option {{unless this.compactBoards "bp-segmented__option--active"}}" aria-pressed={{unless this.compactBoards "true" "false"}} {{on "click" (this.sendAction "setCompactBoards" false)}}>
            {{t "Detailed" key="board_picker_detailed"}}
          </button>
        </div>

      {{/unless}}

      {{!-- Folder-context drill-in row (FOLDER · name · edit/delete ·
           back arrow) now lives INSIDE the Folders section above,
           replacing the folder strip when drilled in. The Boards
           section below shows only the boards belonging to that
           folder, without the duplicate header. --}}

      <div
        class="ub-boards-page__board-grid {{if this.boardsCtrl.mineTagFolderDrillIn 'ub-boards-page__board-grid--in-folder'}} {{if this.compactBoards 'll-boards-grid--compact'}}"
        aria-describedby={{this.boardGridAriaDescribedby}}
      >
        {{#each this.boardsCtrl.boards_page_visible_results key="board.id" as |board|}}
          {{#if board.board.key}}
            {{#unless board.board.removed}}
              <div
                class="ub-boards-page__board-item board_with_action simple_board_holder {{if (and this.boardsCtrl.mine_selected this.boardsCtrl.model.permissions.edit) "ub-boards-page__board-item--draggable"}} {{if (is-equal board.board.key this.boardsCtrl.model.preferences.home_board.key) 'ub-boards-page__board-item--home'}} {{if board.board.starred_for_current_user 'ub-boards-page__board-item--liked'}}"
                draggable={{if (and this.boardsCtrl.mine_selected this.boardsCtrl.model.permissions.edit) "true" "false"}}
                {{on "dragstart" (this.selfEventAction "boardDragStart" board.board)}}
              >
                {{#if (is-equal board.board.key this.boardsCtrl.model.preferences.home_board.key)}}
                  <span class="ub-boards-page__board-item-home-badge">{{t "Home Board" key="home_board"}}</span>
                {{/if}}
                {{#if board.board.starred_for_current_user}}
                  {{!-- Filled-heart indicator in the top-right corner
                       for liked boards (mirrors the My Boards picker
                       treatment). Inert (pointer-events:none) so it
                       doesn't intercept the tile's click. --}}
                  <span class="ub-boards-page__board-item-heart" aria-label={{t "Liked" key="starred"}} title={{t "Liked" key="starred"}}>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                      <path d="M12 21s-7.5-4.5-9.5-9.5C1.2 7.6 3.6 4 7.3 4c2 0 3.5 1 4.7 2.6C13.2 5 14.7 4 16.7 4c3.7 0 6.1 3.6 4.8 7.5C19.5 16.5 12 21 12 21z"/>
                    </svg>
                  </span>
                {{/if}}
                {{!-- Tile click opens the clicked board in the user's
                     preferred view (classic = board-alt, modern =
                     board-detail). The copy-cluster drill-in that
                     `load_children` used to fire was confusing —
                     clicking the Vocal Flair 84 - Categorías Comida
                     tile drilled into its copies instead of opening
                     it. The Preview chip (with its "N boards" count)
                     still provides the cluster-inspection
                     affordance. --}}
                <BoardIcon @board={{board}} @compactRow={{this.compactBoards}} @onAction={{this.onOpenBoardInUserView}} @removeType={{this.boardsCtrl.board_list.remove_type}} @removeLabel={{this.boardsCtrl.board_list.remove_label}} @removeIcon={{this.boardsCtrl.board_list.remove_icon}} @removeCallback={{if this.boardsCtrl.model.permissions.edit (this.ctrlAction "remove_board" this.boardsCtrl.board_list.remove_type board.board)}} />
                {{#if this.boardsCtrl.model.permissions.edit}}
                  {{!-- Contextual remove affordance. DELETE is deliberately NOT offered
                       here: a hover-only trash can sitting on a board tile is a one-click
                       path to destroying a whole board set, and being hover-only it never
                       existed on touch devices in the first place. Deleting a board lives
                       in Board Actions and Board Details, and in the board preview —
                       BoardIcon still receives @removeCallback above, so the preview's
                       touch-reachable remove is unaffected. The NON-destructive contextual
                       removes (un-like, unlink, untag) stay: undoing one costs a click. --}}
                  {{#if (and board.board.id (not (is-equal this.boardsCtrl.board_list.remove_type "delete")))}}
                    <button class="board_action" type="button" {{on "click" (this.ctrlAction "remove_board" this.boardsCtrl.board_list.remove_type board.board)}}>
                      <span title={{this.boardsCtrl.board_list.remove_label}}><span class={{this.boardsCtrl.board_list.remove_icon}}></span></span>
                    </button>
                  {{/if}}
                {{/if}}
              </div>
            {{/unless}}
          {{else if board.orphan}}
            {{!-- ORPHAN CLUSTERS ARE HIDDEN IN COMPACT. These are not real boards: the
                 controller synthesises an unsaved record named "Orphan Boards id:<id>"
                 (controllers/user/index.js ~770) to group boards whose parent is not in
                 the list. The row's only affordance is drilling into the cluster, and
                 compact deliberately suppresses the Preview chip that presents it — so in
                 it showed a raw internal label with a global id and no useful action.
                 Guarded in the TEMPLATE rather than hidden in CSS so it leaves the DOM and
                 the accessibility tree entirely, instead of being an invisible tab stop.
                 Hidden in BOTH densities — see `showOrphanClusters` in the .js for the
                 flag and the trade-off (the clustered boards have no other entry point on
                 this page, so they are no longer listed here). --}}
            {{#if this.showOrphanClusters}}
            {{#if board.children}}
              <div class="ub-boards-page__board-item board_with_action simple_board_holder">
                <BoardIcon @board={{board}} @compactRow={{this.compactBoards}} @onAction={{this.onLoadChildren}} />
                {{#if this.boardsCtrl.model.permissions.edit}}
                  <button type="button" class="board_action" {{on "click" (this.ctrlAction "remove_board" "delete_orphans" board)}}>
                    <span title={{t "delete" key="delete"}}><span class="glyphicon glyphicon-trash"></span></span>
                  </button>
                {{/if}}
              </div>
            {{/if}}
            {{/if}}
          {{/if}}
        {{/each}}
        {{#if this.boardsCtrl.boards_page_search_truncated}}
          <p class="ub-boards-page__filter-truncated-hint">{{t "Showing the first %{count} matches. Keep typing to narrow results." key="boards_filter_truncated_hint" count=this.boardsCtrl.boards_page_search_limit}}</p>
        {{/if}}
        {{#if this.boardsCtrl.board_list.has_more}}
          {{#unless this.boardsCtrl.filterString}}
            <div class="ub-boards-page__show-more" style="overflow-anchor: none;">
              <a href="#" class="ub-boards-page__show-more-btn" {{on "click" (this.ctrlAction "show_more_boards")}}>
                {{t "More" key="more"}}
                <span class="ub-boards-page__show-more-chevrons" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </a>
            </div>
          {{/unless}}
        {{/if}}
      </div>
        </div>{{!-- /.ub-boards-page__boards-summary-body --}}
      </div>{{!-- /.ub-boards-page__boards-summary-section --}}
      {{/unless}}
    {{/if}}
  {{else}}
    {{!-- Empty state: shown when the current user has no boards
         (or the active filter/tab returns no results). Reuses the
         existing `no_boards_yet` and `create_first_board` keys plus
         a new supporting line. CTA bubbles `newBoard` up to the
         application route, same as the header `+ New Board` pill. --}}
    <div class="ub-boards-page__empty" role="status">
      <span class="ub-boards-page__empty-icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1.5"/>
          <rect x="14" y="3" width="7" height="7" rx="1.5"/>
          <rect x="3" y="14" width="7" height="7" rx="1.5"/>
          <rect x="14" y="14" width="7" height="7" rx="1.5"/>
        </svg>
      </span>
      <h3 class="ub-boards-page__empty-title">{{t "You don't have any boards yet" key="no_boards_yet"}}</h3>
      <p class="ub-boards-page__empty-subtitle">{{t "Create your first board and it'll appear here." key="boards_empty_subtitle"}}</p>
    </div>
  {{/if}}
