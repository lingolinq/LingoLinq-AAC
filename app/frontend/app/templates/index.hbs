<OpeningObserver @opening={{this.opening_index}} @closing={{this.closing_index}}></OpeningObserver>
{{#if this.app_state}}
  <div id="index_view" class={{if this.hasCurrentUser "row main_columns" "row"}}  style='touch-action: manipulation;'>
    {{#if this.hasCurrentUser}}
      {{!-- Classic vs modern home. `classicHome` is true only when the user's
           preferences.board_view_style is 'classic' — the same toggle that already
           picks the board route (utils/board_view.js). Anything else, including the
           unset default, renders the modern dashboard below exactly as before. --}}
      {{#if this.classicHome}}
        <Dashboard::ClassicView @model={{this.model}} @user={{this.user}} />
      {{else}}
        <Dashboard::AuthenticatedView @model={{this.model}} @user={{this.user}} />
      {{/if}}
    {{else if this.hasFullDomain}}
      <LandingAltPage />
    {{else}}
      {{! Show login form as fallback when no user and not full_domain }}
      <div style="text-align: center; margin-bottom: 30px;">
        <AppLogo />
      </div>
      <LoginForm />
    {{/if}}
  </div>
  {{#if this.app_state.login_modal}}
    <div id="login_overlay">
      <div style="text-align: center; margin-bottom: 30px;">
        <AppLogo />
      </div>
      {{#unless this.app_state.no_linky}}
        {{#if this.app_state.domain_settings.full_domain}}
          <div class="row" style="margin-bottom: 10px;">
            <div class="col-md-offset-4 col-md-4 col-sm-offset-3 col-sm-6">
              <a href="#" {{on "click" this.hide_login}} class='btn btn-default' style="width: 100%; margin-top: -10px; margin-bottom: 15px;">{{t "New to %app_name%? Find out more." key="find_out_more"}}</a>
            </div>
          </div>
        {{/if}}
      {{/unless}}
      <LoginForm @set_overflow={{true}} />
    </div>
  {{/if}}
{{else}}
  {{! Show login form while app_state is initializing }}
  <div id="index_view" class="row" style='touch-action: manipulation;'>
    <div style="text-align: center; margin-bottom: 30px;">
      <AppLogo />
    </div>
    <LoginForm />
  </div>
{{/if}}
