{{#opening-observer opening=this.onOpening closing=this.onClosing}}
{{#touch-listener release=this.onSelectRelease}}
  <div class="highlight" style={{this.model.top_style}} {{on "click" (fn this.ctrlAction "close")}}>
  </div>
  <div class="highlight" style={{this.model.left_style}} {{on "click" (fn this.ctrlAction "close")}}>
  </div>
  <div class="highlight" style={{this.model.right_style}} {{on "click" (fn this.ctrlAction "close")}}>
  </div>
  <div class="highlight" style={{this.model.bottom_style}} {{on "click" (fn this.ctrlAction "close")}}>
  </div>
  <div class={{this.highlight_class}} style={{this.model.highlight_style}} {{on "click" (fn this.ctrlAction "select")}}>
  </div>
  <div class={{this.highlight_inner_class}} id='highlight_box' style={{this.model.inner_highlight_style}} {{on "click" (fn this.ctrlAction "select")}}>
    {{#if this.model.icon_class}}
      <span class={{this.model.icon_class}} style={{this.model.icon_style}}></span>
    {{/if}}
  </div>
{{/touch-listener}}
{{/opening-observer}}
