{{!-- AN APP PAGE, BUILT AS THE OTHERS ARE (2026-11-09, requested: "modern -> add the menus like the
     other app pages"). It was the public site's marketing page (`la-wrapper` / `la-main`, a fixed
     full-screen layer), which in Modern covered the app shell's rail and set its own spacing. Now
     `.md-shell` > `.md-workspace`, the structure of templates/organizations.hbs: Modern's app shell
     wraps it with the rail (controllers/application.js CHROME_ROUTES), and in Basic its own rail is a
     direct child of `.md-shell`, turned into a row by the rule Organizations and the board picker use
     (_classic-home.scss). --}}
<div class="md-shell md-shell--system-settings la-system-settings">
      {{#if this.isBasicView}}
        <Dashboard::ClassicRail @menuLabel={{t "System Settings" key="system_settings_title"}} />
      {{/if}}
      <div class="md-workspace">
        {{!-- THE APP'S PAGE HEADER, NOT THE MARKETING HERO (2026-11-09, requested: "the header and
             subheader styles don't match the other pages", and "it starts too far down"). It was
             `la-section` / `la-hero-title` / `la-pricing-hero-subtitle` from the public pricing and
             support pages: a 35px title, a 24px two-line subtitle and the marketing section's
             padding, which put the form a third of the way down the page. `md-hero` is the header
             every app page uses (templates/organizations.hbs); the section's spacing is its own
             (app.scss `.la-system-settings__section`). --}}
        <section class="la-system-settings__section" aria-labelledby="system-settings-heading">
          <header class="md-hero md-hero--dashboard la-system-settings__header">
            <h1 id="system-settings-heading" class="md-hero__title">{{t "System Settings" key="system_settings_title"}}</h1>
            <p class="md-hero__sub">{{t "Manage system emails and feature flags for your organization." key="system_settings_intro"}}</p>
          </header>

          <div class="la-support-content-wrapper">
            <article class="la-about-glass-card la-support-page-card la-system-settings__card">
              <div class="la-support-page-card__body md-support-content la-system-settings__body">
                <div class="la-system-settings__org-row">
                  <label class="la-system-settings__org-label">
                    <span class="la-system-settings__label-text">{{t "Organization" key="system_settings_org_label"}}</span>
                    <select class="form-control la-system-settings__org-select" {{on "change" (this.ctrlActionEventValue "setOrgId" "value")}}>
                      {{#each this.scopeOptionGroups as |group|}}
                        <optgroup label={{group.label}}>
                          {{#each group.options as |opt|}}
                            <option value={{opt.id}} selected={{is-equal opt.id this.org_id}}>{{opt.name}}</option>
                          {{/each}}
                        </optgroup>
                      {{/each}}
                    </select>
                  </label>
                </div>

                <nav class="md-pillnav md-pillnav--dashboard la-system-settings__tabs" aria-label={{t "System settings sections" key="system_settings_tabs_label"}}>
                  <LinkTo @route="system-settings.emails" class="md-pillnav__pill">{{t "Emails" key="system_settings_tab_emails"}}</LinkTo>
                  {{#if this.canEditSiteWide}}
                    <LinkTo @route="system-settings.app-defaults" class="md-pillnav__pill">{{t "App defaults" key="system_settings_tab_app_defaults"}}</LinkTo>
                  {{/if}}
                  <LinkTo @route="system-settings.features" class="md-pillnav__pill">{{t "Features" key="system_settings_tab_features"}}</LinkTo>
                </nav>

                {{outlet}}
              </div>
            </article>
          </div>
        </section>
      </div>
</div>
