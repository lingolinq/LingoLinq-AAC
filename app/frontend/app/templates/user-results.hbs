{{#modal-dialog action=(this.ctrlAction "close") opening=(this.ctrlAction "opening") closing=(this.ctrlAction "closing")}}
  <div class="modal-header">
    <button type="button" class="close" {{on "click" (this.ctrlAction "close")}}>&times;</button>
    <h3>{{t "User Search Results" key="user_search_results"}} - {{this.model.q}}</h3>
  </div>
  <div class="modal-body">
    <div class='list-group'>
      {{#each this.model.list as |user|}}
        <LinkTo @route="user" @model={{this.user.user_name}} class="list-group-item">
          <img src={{this.user.avatar_url}} style='height: 30px;'>
          {{this.user.user_name}}
        </LinkTo>
      {{/each}}
    </div>
  </div>
  <div class="modal-footer">
    <a href="#" class="btn" {{on "click" (this.ctrlAction "close")}}>{{t "Close" key="close"}}</a>
  </div>
{{/modal-dialog}}
