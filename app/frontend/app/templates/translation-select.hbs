{{#modal-dialog action=(action "close") opening=(action "opening") closing=(action "closing")}}
  <div class="modal-header">
    <button type="button" class="close" {{action "close"}}>&times;</button>
    <h3>{{t "Translate Boards" key="translate_boards"}}
</h3>
  </div>
  <div class="modal-body">
    <form class="form-horizontal" {{action "nothing" on="submit"}}>
      <div class="form-group">
        <label for="boards" class="col-sm-3 control-label">{{t "Boards" key="boards"}}</label>
        <div class="col-sm-9">
          {{#if this.hierarchy.loading}}
            {{t "Loading linked boards..." key="loading_linked_boards"}}
          {{else if this.hierarchy.error}}
            {{t "There was an error trying to retrieve linked boards" key="error_getting_linked_boards"}}
          {{else}}
            <div style='margin-top: 5px;'>
              {{board-hierarchy hierarchy=this.hierarchy selectable=true}}
            </div>
          {{/if}}
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-3 control-label" for="translate_locale">
          {{t "Language" key="language"}}
        </label>
        <div class="col-sm-9">
          {{bound-select select_class="form-control" select_id="translate_locale" content=this.locales selection=this.translate_locale action=(action (mut this.translate_locale)) }}
        </div>
      </div>
      <div class="form-group">
        <div class="col-sm-9 col-sm-offset-3">
          <label>
            <Input @type="checkbox" @checked={{this.default_language}} />
            {{t "Switch to this as the Default Language" key="set_as_default_language"}}
          </label>
        </div>
      </div>
      {{#if this.existing_default_language}}
        <div class='form-group'>
          <div class='col-sm-9 col-sm-offset-3'>
            <p class='form-control-static text-info'>
              {{t "This board already has translations for this language. Use Switch to Existing Translation to make it the default display and speak language. To change languages, open the original English board copy or use Switch Language from the board menu." key="board_already_translated_prompt"}}
            </p>
          </div>
        </div>
      {{else if this.is_source_language}}
        <div class='form-group'>
          <div class='col-sm-9 col-sm-offset-3'>
            <p class='form-control-static text-info'>
              {{t "This board is already in %{language}. To view another language, use Switch Language from the board menu or open a translated copy of this board." key="board_already_in_source_language" language=this.source_language_name}}
            </p>
          </div>
        </div>
      {{/if}}
    </form>
  </div>
  <div class="modal-footer">
    {{#if this.existing_default_language}}
      <button disabled={{this.switch_status.pending}} class='btn btn-primary' {{action "switch_language"}}>
        {{#if this.switch_status.pending}}
          {{t "Switching Language..." key="switching_language"}}
        {{else if this.switch_status.error}}
          {{t "Error Switching Language" key="error_switching_language"}}
        {{else}}
          {{t "Switch to Existing Translation" key="switch_translation"}}
        {{/if}}
      </button>
    {{else if this.is_source_language}}
      <button class='btn btn-primary' disabled={{true}}>{{t "Already Translated" key="already_translated"}}</button>
    {{else}}
      <button class='btn btn-primary' {{action "translate"}} disabled={{this.not_ready}}>{{t "Start Translation" key="start_translation"}}</button>
    {{/if}}
    <a href="#" class="btn btn-default" {{action "close"}}>{{t "Cancel" key="cancel"}}</a>
  </div>
{{/modal-dialog}}
