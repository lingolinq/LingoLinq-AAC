<div class="register-page-bg beta-welcome-page" role="main">
  <div class="la-bg-orbs" aria-hidden="true">
    <span class="la-bg-orb la-bg-orb--a"></span>
    <span class="la-bg-orb la-bg-orb--b"></span>
    <span class="la-bg-orb la-bg-orb--c"></span>
    <span class="la-bg-orb la-bg-orb--d"></span>
  </div>
  <div class="beta-mode-toggle {{if this.showShort 'beta-mode-toggle--short'}}" role="group" aria-label={{t "Preview layout" key="beta_mode_toggle_aria"}}>
    <span class="beta-mode-toggle__slider" aria-hidden="true"></span>
    <button type="button" class="beta-mode-toggle__option {{if this.showShort '' 'beta-mode-toggle__option--active'}}" aria-pressed={{if this.showShort "false" "true"}} {{action "set_beta_mode" false}}>
      {{t "Original" key="beta_mode_original"}}
    </button>
    <button type="button" class="beta-mode-toggle__option {{if this.showShort 'beta-mode-toggle__option--active' ''}}" aria-pressed={{if this.showShort "true" "false"}} {{action "set_beta_mode" true}}>
      {{t "Short" key="beta_mode_short"}}
    </button>
  </div>
  <div class="register-page beta-welcome-page__frame">
    <div class="register-card beta-welcome-card">
      <div class="la-section-header">
        <span class="la-section-eyebrow-badge">{{t "Beta program" key="beta_welcome_eyebrow"}}</span>
        <div class="la-hero-title-wrap">
          {{#if this.showShort}}
            <h1 class="la-hero-title">{{t "Welcome to LingoLinq Beta Program" key="beta_welcome_title_short"}}</h1>
          {{else}}
            <h1 class="la-hero-title">{{t "Welcome to LingoLinq" key="beta_welcome_title"}}</h1>
          {{/if}}
        </div>
        <p class="beta-welcome-card__subtitle">
          {{#if this.displayName}}
            {{t "Hi %{name} — explore, communicate, and" name=this.displayName key="beta_welcome_tagline_named_pre"}} <span class="hero-gradient">{{t "help shape what comes next." key="beta_welcome_tagline_highlight"}}</span>
          {{else}}
            {{t "Explore, communicate, and" key="beta_welcome_tagline_pre"}} <span class="hero-gradient">{{t "help shape what comes next." key="beta_welcome_tagline_highlight"}}</span>
          {{/if}}
        </p>
      </div>

      {{#if this.showShort}}
      <div class="beta-welcome-footer">
        <div class="register-checkboxes beta-welcome-accept">
          <div class="checkbox big_checkbox">
            <Input @type="checkbox" @checked={{this.agreementAccepted}} id="beta_agreement_accept_check" aria-labelledby="beta_agreement_accept_text" />
            <span id="beta_agreement_accept_text" class="big_checkbox__consent">
              {{t "I have read and accept the " key="beta_agreement_accept_prefix"}}<LinkTo @route="beta-welcome">{{t "Beta Test Agreement" key="beta_agreement_link"}}</LinkTo>{{t "." key="beta_agreement_accept_suffix"}}
            </span>
          </div>
        </div>

        <div class="register-btn-wrap beta-welcome-actions">
          <button type="button" disabled={{this.acceptButtonDisabled}} class="register-btn" {{action "acceptAgreement"}}>
            {{t "Get Started" key="get_started"}}
          </button>
        </div>
      </div>
      {{else}}
      <div class="beta-welcome-body">
        <div class="beta-welcome-intro">
          <p>{{t "Thanks for joining the beta. We're building LingoLinq with AAC users, therapists, teachers, and families, and your feedback helps us improve what we ship." key="beta_welcome_intro"}}</p>
        </div>

        <section class="beta-welcome-section" aria-labelledby="beta-welcome-explore-heading">
          <h3 id="beta-welcome-explore-heading" class="beta-welcome-section__title">{{t "Two ways we can explore together" key="beta_welcome_explore_title"}}</h3>
          <div class="la-feature-grid beta-welcome-feature-grid">
            <div class="la-feature-card beta-welcome-feature-card beta-welcome-feature-card--featured">
              <div class="beta-welcome-feature-card__head">
                <div class="la-feature-icon la-feature-icon--teal" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="bwSpeakFill" x1="3" y1="3" x2="20" y2="18" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#2A9D8F" stop-opacity="0.20"/>
                      <stop offset="1" stop-color="#4ECDC4" stop-opacity="0.08"/>
                    </linearGradient>
                    <linearGradient id="bwSpeakStroke" x1="3" y1="3" x2="20" y2="18" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#2A9D8F"/>
                      <stop offset="1" stop-color="#3FBEAE"/>
                    </linearGradient>
                    <linearGradient id="bwSpeakBars" x1="12" y1="5" x2="12" y2="13" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#37B7A8"/>
                      <stop offset="1" stop-color="#1F8C7F"/>
                    </linearGradient>
                  </defs>
                  <path d="M6 3 H18 A3 3 0 0 1 21 6 V12 A3 3 0 0 1 18 15 H10 L6 19 V15 A3 3 0 0 1 3 12 V6 A3 3 0 0 1 6 3 Z"
                        fill="url(#bwSpeakFill)" stroke="url(#bwSpeakStroke)" stroke-width="1.6" stroke-linejoin="round"/>
                  <g stroke="url(#bwSpeakBars)" stroke-width="2.1" stroke-linecap="round">
                    <line x1="8" y1="7.6" x2="8" y2="10.4"/>
                    <line x1="10.5" y1="5.9" x2="10.5" y2="12.1"/>
                    <line x1="13" y1="6.7" x2="13" y2="11.3"/>
                    <line x1="15.5" y1="8" x2="15.5" y2="10"/>
                  </g>
                </svg>
              </div>
                <h4>{{t "Speak, play & discover" key="beta_welcome_explore_speak_title"}}</h4>
              </div>
              <p>{{t "You have an official license to roam! Explore, try things out, and find how you like to talk, share, and communicate." key="beta_welcome_explore_speak_body"}}</p>
            </div>
            <div class="la-feature-card beta-welcome-feature-card beta-welcome-feature-card--missions">
              <div class="beta-welcome-feature-card__head">
                <div class="la-feature-icon la-feature-icon--navy" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="bwFlagFabric" x1="6" y1="4" x2="18.5" y2="12" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#4C86D8"/>
                      <stop offset="1" stop-color="#8585E6"/>
                    </linearGradient>
                    <linearGradient id="bwFlagPole" x1="6" y1="3" x2="6" y2="21" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#5E7FD2"/>
                      <stop offset="1" stop-color="#7178D6"/>
                    </linearGradient>
                  </defs>
                  <line x1="6" y1="4" x2="6" y2="21" stroke="url(#bwFlagPole)" stroke-width="2.1" stroke-linecap="round"/>
                  <circle cx="6" cy="3.4" r="1.15" fill="#5E7FD2"/>
                  <path d="M6 4.4 C8.5 3.2 10.6 5.6 13 4.65 C15.2 3.8 16.9 4.25 18.5 4.55 L18.5 11.95 C16.9 11.65 15.2 11.2 13 12.05 C10.6 13 8.5 10.6 6 11.8 Z"
                        fill="url(#bwFlagFabric)"/>
                  <path d="M6 4.4 C8.5 3.2 10.6 5.6 13 4.65 C15.2 3.8 16.9 4.25 18.5 4.55"
                        stroke="#ffffff" stroke-opacity="0.55" stroke-width="1" stroke-linecap="round"/>
                  <path d="M13 4.65 C13.45 7 13.4 9.6 13 12.05"
                        stroke="#ffffff" stroke-opacity="0.3" stroke-width="0.9" stroke-linecap="round"/>
                  <path d="M19.4 14.1 l0.42 1.18 1.18 0.42 -1.18 0.42 -0.42 1.18 -0.42 -1.18 -1.18 -0.42 1.18 -0.42 Z" fill="#8585E6"/>
                </svg>
              </div>
                <h4>{{t "Weekly missions" key="beta_welcome_explore_missions_title"}}</h4>
              </div>
              <p>{{t "Each week we'll share a short activity so we can practice using different features together." key="beta_welcome_explore_missions_body"}}</p>
            </div>
          </div>
        </section>

        <section class="beta-welcome-section" aria-labelledby="beta-welcome-start-heading">
          <h3 id="beta-welcome-start-heading" class="beta-welcome-section__title">{{t "Getting started" key="beta_welcome_start_title"}}</h3>
          <ol class="beta-welcome-steps">
            <li class="beta-welcome-steps__item">
              <span class="beta-welcome-steps__num" aria-hidden="true">1</span>
              <div class="beta-welcome-steps__content">
                <strong>{{t "Watch the quick tour" key="beta_welcome_step_tour_title"}}</strong>
                <p>{{t "We put together a short video to show how everything works and help you feel at ease." key="beta_welcome_step_tour_body"}}</p>
              </div>
            </li>
            <li class="beta-welcome-steps__item">
              <span class="beta-welcome-steps__num" aria-hidden="true">2</span>
              <div class="beta-welcome-steps__content">
                <strong>{{t "Pop-ups along the way" key="beta_welcome_step_popups_title"}}</strong>
                <p>{{t "Throughout the app, helpful messages explain features as you go. Like a cheat sheet from day one." key="beta_welcome_step_popups_body"}}</p>
              </div>
            </li>
            <li class="beta-welcome-steps__item">
              <span class="beta-welcome-steps__num" aria-hidden="true">3</span>
              <div class="beta-welcome-steps__content">
                <strong>{{t "A quick bit of housekeeping" key="beta_welcome_step_agreement_title"}}</strong>
                <p>{{t "On the next screen you'll see a short agreement in plain English. Please review it and accept when you're ready, or contact us with any questions." key="beta_welcome_step_agreement_body"}}</p>
              </div>
            </li>
            <li class="beta-welcome-steps__item">
              <span class="beta-welcome-steps__num" aria-hidden="true">4</span>
              <div class="beta-welcome-steps__content">
                <strong>{{t "You're signed in" key="beta_welcome_step_signed_in_title"}}</strong>
                <p>{{t "When you finish the agreement, you'll head into LingoLinq and can start exploring right away." key="beta_welcome_step_signed_in_body"}}</p>
              </div>
            </li>
          </ol>
        </section>

        <section class="beta-welcome-section beta-welcome-section--feedback" aria-labelledby="beta-welcome-feedback-heading">
          <h3 id="beta-welcome-feedback-heading" class="beta-welcome-section__title">{{t "Help shape LingoLinq" key="beta_welcome_feedback_title"}}</h3>
          <p class="beta-welcome-feedback__intro">{{t "As an early beta member, your feedback directly helps shape the future of communication tools for AAC users, families, therapists, and educators." key="beta_welcome_feedback_intro"}}</p>

          <ul class="beta-welcome-missions">
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "Explore communication boards" key="beta_welcome_mission_explore"}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "Try speaking, modeling, and navigation tools" key="beta_welcome_mission_tools"}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "Tell us what feels confusing or difficult" key="beta_welcome_mission_confusing"}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "Share ideas or feature requests" key="beta_welcome_mission_ideas"}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "Report bugs or anything that feels off" key="beta_welcome_mission_bugs"}}</span>
            </li>
            <li class="la-plan-item">
              <span class="la-plan-check" aria-hidden="true">✓</span>
              <span>{{t "Let us know what you love, too" key="beta_welcome_mission_love"}}</span>
            </li>
          </ul>
        </section>

        <div class="beta-welcome-listening" role="group" aria-labelledby="beta-welcome-listening-heading">
          <span class="beta-welcome-listening__pill" id="beta-welcome-listening-heading">
            <span class="beta-welcome-listening__dot" aria-hidden="true"></span>
            {{t "We're listening" key="beta_welcome_listening_pill"}}
          </span>
          <p class="beta-welcome-listening__body">{{t "Every idea, bug report, and observation helps us build communication tools that feel more human, modern, and accessible. No detail is too small." key="beta_welcome_listening_body"}}</p>
          <p class="beta-welcome-listening__hint">{{t "The Beta Feedback button is always available inside the app whenever inspiration strikes." key="beta_welcome_listening_hint"}}</p>
          <span class="beta-welcome-listening__team">{{t "The LingoLinq Team" key="beta_welcome_team"}}</span>
        </div>
      </div>

      <div class="register-btn-wrap beta-welcome-actions">
        <button type="button" class="register-btn" {{on "click" (this.ctrlAction "goToAgreement")}}>
          {{t "Next" key="next"}}
        </button>
      </div>
      {{/if}}
    </div>
  </div>
</div>
