{{#if this.model.valid}}
  <h2>{{t "Change Password" key="change_password"}}</h2>
  <form class="form-horizontal" {{on "submit" (this.ctrlAction "changePassword")}}>
    <div class="form-group">
      <div class="col-sm-6">
        {{t "Here we go. Pick a new password." key="choose_new_password"}}
      </div>
    </div>
    <div class="form-group">
      <label for="password" class="col-sm-2 control-label">{{t "Password" key="password"}}</label>
      <div class="col-sm-4">
        <input type="password" value={{this.model.password}} class="form-control" id="password" placeholder="new password" autocomplete="new-password" {{on "input" (set-field this "model.password")}} />
      </div>
    </div>
    <div class="form-group">
      <div class="col-sm-4 col-sm-offset-2">
        <input type="password" value={{this.model.password2}} class="form-control" id="password2" title="Repeat password" placeholder="new password again" aria-label={{t "Repeat new password" key="repeat_new_password"}} autocomplete="new-password" {{on "input" (set-field this "model.password2")}} />
        {{#if this.badPassword.mismatch}}
          {{t "Passwords do not match" key="passwords_dont_match"}}
        {{else}}
          {{#if this.badPassword.short}}
            {{t "Password must be at least 8 characters" key="min_password_8"}}
          {{/if}}
        {{/if}}
      </div>
    </div>
    <div class="form-group">
      <div class="col-sm-4 col-sm-offset-2">
        <div style="margin-bottom: 10px;">
        {{#if this.cantSubmit}}{{/if}}
        <button class='btn btn-primary' type='submit' disabled={{this.cantSubmit}}>
          {{#if this.password_reset.pending}}
            {{t "Saving Password..." key="saving_password"}}
          {{else}}
            {{t "Save Password" key="save_password"}}
          {{/if}}
        </button>
        </div>
        {{#if this.password_reset.pending}}
          <p>{{t "Resetting password..." key="resetting_password"}}</p>
        {{else}}
          {{#if this.password_reset.failed}}
            <p>{{t "Something went wrong. Please try again." key="password_reset_failed_try_again"}}</p>
          {{else}}
            {{#if this.password_reset.succeeded}}
              <p>
              {{t "Hooray, it worked! Now you can" key="password_reset_confirmed"}}
              <a href="#" {{on "click" (this.ctrlAction "authenticateSession")}}>{{t "sign back in" key="sign_back_in"}}</a>
              </p>
            {{/if}}
          {{/if}}
        {{/if}}
      </div>
    </div>
  </form>
{{else}}
  <h2>{{t "Change Password" key="change_password"}}</h2>
  <p>
  {{t "Bad code. Maybe there's a newer email in your inbox?" key="bad_password_confirmation"}}
  </p>
{{/if}}
