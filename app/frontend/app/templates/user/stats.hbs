<OpeningObserver @done_opening={{this.ctrlAction "draw_charts"}}>
<div class="md-shell md-shell--reports-view">
  <div class="md-workspace">
    <UserPillNav @active="reports" @userName={{this.model.user_name}} />
    <header class="md-hero md-hero--dashboard md-hero--reports-dashboard">
      <h1 class="md-hero__title"><span class="md-hero__title--from-left">{{t "Activity for" key="reports_activity_for_pre"}} <em class="md-hero__sub-user">{{this.model.user_name}}</em></span></h1>
      <p class="md-hero__sub md-hero__sub--meta"><span class="md-hero__sub--from-right">{{#if this.model.joined}}<span class="md-hero-meta__item"><svg class="md-hero-meta__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="16" rx="3" fill="rgba(42,157,143,0.16)" stroke="#1B365D" stroke-width="1.8"/><path d="M3.5 9.5h17" stroke="#1B365D" stroke-width="1.8"/><path d="M8 3v3.5M16 3v3.5" stroke="#2A9D8F" stroke-width="1.8" stroke-linecap="round"/></svg>{{t "Joined" key="joined_cap"}} <strong>{{date_ago this.model.joined}}</strong></span>{{/if}}{{#if this.model.last_access}}<span class="md-hero-meta__item"><span class="md-hero-meta__dot" aria-hidden="true"></span>{{t "Last active" key="last_active"}} <strong>{{date_ago this.model.last_access "day"}}</strong></span>{{/if}}</span></p>
      {{!-- Switch Communicators lives in the HERO, not in the page body: it acts
           on the whole report (which communicator you are looking at), so it
           belongs beside the title that names them rather than inside the
           stats content it would otherwise appear to scope. Rendered once here
           for every page state — the header sits outside the
           premium/logging/authenticated branches below, which each used to
           carry their own copy of this button. --}}
      {{#if this.app_state.currentUser.supervisees.length}}
        <button type="button" class="md-btn md-btn--ghost md-reports-hero__action" {{on "click" (this.ctrlAction "switch_communicators")}}>{{t "Switch Communicators" key="switch_communicators"}}</button>
      {{/if}}
    </header>
<div class="md-stats-page">
  <main class="md-stats-main">
    {{!-- Focused View header/subheader — shown ONLY in Focused View via CSS, and
         only on the states that do NOT render the "Communication progress"
         summary (login / premium-required / logging-off). When the summary is on
         screen it carries the page title itself, so _focused-view.scss suppresses
         this head via :has(.communication-report). --}}
    <div class="md-stats-main__focus-head">
      <h3 class="md-card__title">{{t "Reports" key="reports"}} <span class="md-card__title-accent--verdigris">{{t "(Usage & Progress)" key="reports_focus_accent"}}</span></h3>
      <div class="md-card__sub">{{t "View usage and progress" key="reports_card_sub"}}</div>
    </div>
    <div class="md-stats-main__focus-divider md-card--boards__divider" aria-hidden="true"></div>
{{#if this.app_state.currentUser.modeling_only}}
  <ModelingOnlyNotice />
{{else if this.model.currently_premium}}
  {{#if this.model.preferences.logging}}
    {{!-- Joined / Last active now live in the hero subheader (above). This
          row remains only for the Reset control in compare mode. --}}
    {{#if (and this.usage_stats this.usage_stats2)}}
    <div class="md-user-meta md-user-meta--before-hero" role="list">
      <button type="button" class="md-user-meta__chip md-user-meta__chip--reset" {{on "click" (this.ctrlAction "reset_to_default")}} aria-label={{t "Reset to default report" key="reset_to_default_report"}}>
        <span class="md-user-meta__label">{{t "Reset" key="reset"}}</span>
      </button>
    </div>
    {{/if}}
    {{#if this.usage_stats2}}
      <section class="md-stats-hero-card" aria-labelledby="md-stats-hero-title">
        <div class="md-stats-hero__head">
          <h1 id="md-stats-hero-title" class="md-stats-hero__title">{{t "%{un}'s Reports" key="usage_reports_for" un=this.model.user_name}}</h1>
        </div>
      </section>
      <hr class="la-about-hero-separator" aria-hidden="true">
    {{/if}}
    {{#unless this.usage_stats}}
      <div class="md-card__loading md-card__loading--reports">
        <div class="md-spinner" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="16" r="13" stroke="rgba(76,134,216,0.15)" stroke-width="3"/>
            <path d="M16 3a13 13 0 0 1 13 13" stroke="#4C86D8" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="md-card__loading-text">{{t "Loading reports..." key="loading_reports"}}</p>
      </div>
    {{/unless}}
    {{#if this.usage_stats2}}
      {{!-- Compare mode is unchanged: side-by-side period filters, then the two
            LoadStatus columns and the compare stat groups below. --}}
      <div class="md-stats-compare-filter-group md-stats-compare-filter-group--active">
        <span class="md-stats-compare-filter-group__badge">{{t "Compare report periods" key="compare_report_periods"}}</span>
        <div class="row md-stats-compare-row md-stats-compare-row--filter" style='page-break-inside: avoid;'>
          <Stats::DataFilter @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} @status={{this.status}} @app_state={{this.app_state}} @snapshots={{this.snapshots}} @compare_to={{this.ctrlAction "compare_to"}} @clear_side={{this.ctrlAction "clear_left_side"}} @update_filter={{this.ctrlAction "update_left_filter"}} />
          <div class="md-stats-compare-filter-group__between" aria-hidden="true">
            <img src={{path "images/compare-reports.png"}} alt="" class="md-stats-compare-filter-group__between-img">
          </div>
          <Stats::DataFilter @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @status={{this.status2}} @snapshots={{this.snapshots}} @right_side={{true}} @clear_side={{this.ctrlAction "clear_right_side"}} @update_filter={{this.ctrlAction "update_right_filter"}} />
        </div>
      </div>
      <div class="row md-stats-compare-row" style='page-break-inside: avoid;'>
        <Stats::LoadStatus @status={{this.status}} @ref_status={{this.status2}} @side_by_side={{true}} />
        <Stats::LoadStatus @status={{this.status2}} @ref_status={{this.status}} @side_by_side={{true}} @right_side={{true}} />
      </div>
    {{else}}
      {{!-- Communication progress — the single-period summary. Replaces the old
            "%{un}'s Reports" hero + REPORT SUMMARY grid of eight equal-weight
            panels with one takeaway, three KPIs, a trend, and observations.
            Every value below is read from the same usage_stats fields the old
            panels used; the five secondary values are demoted, not dropped.
            Everything from "Communication Usage" down is unchanged. --}}
      <section class="report-panel communication-report" aria-labelledby="communication-report-title">
        <header class="communication-report__header">
          <div class="communication-report__heading">
            <h1 id="communication-report-title">{{t "Progress and Usage" key="progress_and_usage"}}</h1>
            {{#if this.formattedDateRange}}
              <p class="communication-report__date-range">{{this.formattedDateRange}}</p>
            {{/if}}
          </div>

          {{#if this.usage_stats}}
            <div class="communication-report__controls" role="group" aria-label={{t "Report controls" key="report_controls"}}>
              <Stats::DataFilter @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} @status={{this.status}} @app_state={{this.app_state}} @snapshots={{this.snapshots}} @compare_to={{this.ctrlAction "compare_to"}} @clear_side={{this.ctrlAction "clear_left_side"}} @update_filter={{this.ctrlAction "update_left_filter"}} />
            </div>
          {{/if}}
        </header>

        {{!-- Reuses the page's existing load-status component for the in-flight and
              failed states; "no data" is handled by the empty state below, and the
              first-load spinner by the .md-card__loading block above. --}}
        {{#if (or this.status.loading this.status.error)}}
          <Stats::LoadStatus @status={{this.status}} @ref_status={{this.status2}} />
        {{/if}}

        {{#if this.hasReportData}}
          <section class="progress-highlight progress-highlight--{{this.primaryInsight.tone}}" aria-labelledby="progress-highlight-title">
            <div class="progress-highlight__icon" aria-hidden="true">
              <Stats::ReportIcon @name={{this.primaryInsightIcon}} />
            </div>

            <div class="progress-highlight__content">
              {{!-- No eyebrow here: the compared range is already named in the
                    description below and stated in full under the KPI row. --}}
              <h2 id="progress-highlight-title">{{this.primaryInsight.title}}</h2>

              <p class="progress-highlight__description">{{this.primaryInsight.description}}</p>
            </div>
          </section>

          <section class="report-kpis" aria-label={{t "Communication summary" key="communication_summary"}}>
            {{#each this.summaryMetrics as |metric|}}
              <article class="report-kpi report-kpi--{{metric.key}}">
                <div class="report-kpi__icon" aria-hidden="true">
                  <Stats::ReportIcon @name={{metric.icon}} />
                </div>

                <div class="report-kpi__content">
                  <p class="report-kpi__value">{{metric.formattedValue}}</p>
                  <h3 class="report-kpi__label">{{metric.label}}</h3>
                </div>

                {{#if metric.context}}
                  {{!-- The arrow + percentage is the visual cue and the caption
                        under it names what the change measures and over which
                        dates; the sr-only sentence carries the same meaning, so
                        direction never rests on color or an arrow alone. --}}
                  <p class="report-kpi__change report-kpi__change--{{metric.tone}}">
                    <span class="report-kpi__change-value" aria-hidden="true">{{metric.context}}</span>
                    <span class="report-kpi__change-caption" aria-hidden="true">{{metric.contextLabel}}</span>
                    <span class="sr-only">{{metric.accessibleContext}}</span>
                  </p>
                {{/if}}
              </article>
            {{/each}}
          </section>

          {{#if this.comparisonBasis}}
            <p class="report-kpis__basis">{{this.comparisonBasis}}</p>
          {{/if}}

          <div class="report-analysis">
            <Stats::CommunicationTrend @trend={{this.reportTrend}} @draw_id={{this.usage_stats.draw_id}} />

            <aside class="report-insights" aria-labelledby="report-insights-title">
              <div class="report-panel-heading">
                <div>
                  <p class="report-panel-heading__eyebrow">{{t "Highlights" key="report_panel_highlights"}}</p>
                  <h2 id="report-insights-title">{{t "What stands out" key="what_stands_out"}}</h2>
                </div>
              </div>

              {{#if this.hasInsights}}
                <ul class="report-insights__list">
                  {{#each this.reportInsights as |insight|}}
                    <li class="report-insight">
                      <div class="report-insight__icon" aria-hidden="true">
                        <Stats::ReportIcon @name={{insight.icon}} />
                      </div>

                      <div class="report-insight__content">
                        <h3>{{insight.title}}</h3>
                        <p>{{insight.description}}</p>
                      </div>
                    </li>
                  {{/each}}
                </ul>
              {{else}}
                <p class="report-insights__empty">{{t "More insights will appear as communication activity is recorded." key="more_insights_later"}}</p>
              {{/if}}
            </aside>
          </div>

          {{!-- Secondary values — the same figures the old summary grid showed at
                equal weight, kept on the page but demoted below the takeaway. --}}
          <dl class="report-secondary" aria-label={{t "Additional totals and rates" key="additional_totals_and_rates"}}>
            {{#each this.secondaryMetrics as |metric|}}
              <div class="report-secondary__item">
                <dt class="report-secondary__label">{{metric.label}}</dt>
                <dd class="report-secondary__value">{{metric.formattedValue}}</dd>
              </div>
            {{/each}}
          </dl>
        {{else if this.usage_stats}}
          <section class="communication-report__empty">
            <h2>{{t "No communication activity yet" key="no_communication_activity_yet"}}</h2>
            <p>{{t "Activity and progress insights will appear here after communication sessions are recorded." key="no_communication_activity_yet_desc"}}</p>
          </section>
        {{/if}}
      </section>
    {{/if}}
    {{#if this.some_data}}
      {{!-- Everything below the summary sits in the same panel container the
            summary uses, so both blocks share one gutter and one max width. --}}
      <div class="report-panel report-details">
      {{#if this.usage_stats2}}
        {{!-- Compare mode: the same eight figures per period, now rendered with
              the summary's KPI card (compact variant) instead of the old
              Bootstrap panels with tinted header strips. Values and order are
              unchanged; decimals follow the report's one-place convention. --}}
        <div class="row md-stats-compare-row" style='page-break-inside: avoid;'>
          <div class="col-sm-6 col-xs-12 md-stats-compare-group">
            <div class="md-stats-compare-group__inner">
              <section class="report-kpis report-kpis--compare" aria-label={{t "Period 1 summary" key="period_1_summary"}}>
                {{#each this.compareMetrics as |metric|}}
                  <article class="report-kpi report-kpi--compact report-kpi--{{metric.key}}">
                    <div class="report-kpi__icon" aria-hidden="true">
                      <Stats::ReportIcon @name={{metric.icon}} />
                    </div>
                    <div class="report-kpi__content">
                      <p class="report-kpi__value">{{metric.formattedValue}}</p>
                      <h3 class="report-kpi__label">{{metric.label}}</h3>
                    </div>
                  </article>
                {{/each}}
              </section>
            </div>
          </div>
          <div class="col-sm-6 col-xs-12 md-stats-compare-group">
            <div class="md-stats-compare-group__inner">
              <section class="report-kpis report-kpis--compare" aria-label={{t "Period 2 summary" key="period_2_summary"}}>
                {{#each this.compareMetrics2 as |metric|}}
                  <article class="report-kpi report-kpi--compact report-kpi--{{metric.key}}">
                    <div class="report-kpi__icon" aria-hidden="true">
                      <Stats::ReportIcon @name={{metric.icon}} />
                    </div>
                    <div class="report-kpi__content">
                      <p class="report-kpi__value">{{metric.formattedValue}}</p>
                      <h3 class="report-kpi__label">{{metric.label}}</h3>
                    </div>
                  </article>
                {{/each}}
              </section>
            </div>
          </div>
        </div>
      {{/if}}
      {{#unless this.usage_stats2}}
        <div class="md-stats-section-head">
          <h2 class="md-stats-section-head__label">{{t "Communication Usage" key="communication_usage"}}</h2>
          <span class="md-stats-section-head__rule" aria-hidden="true"></span>
        </div>
      {{/unless}}
      <div class="row{{if this.usage_stats2 " md-stats-compare-row" ""}}" style='page-break-inside: avoid;'>
        <Stats::WordUsage @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} @show_logs="show_logs" />
        {{#if this.usage_stats2}}
          <Stats::WordUsage @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} @show_logs="show_logs" />
        {{/if}}
        <Stats::CommonWords @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} @word_cloud={{this.ctrlAction "word_cloud_left"}} @word_data={{this.ctrlAction "word_data"}} />
        {{#if this.usage_stats2}}
          <Stats::CommonWords @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} @word_cloud={{this.ctrlAction "word_cloud_right"}} @word_data={{this.ctrlAction "word_data"}} />
        {{/if}}
        {{#if this.usage_stats2}}
          {{#if this.different_dates}}
            <Stats::LostOrGainedWords @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{true}} @word_cloud={{this.ctrlAction "word_cloud_left"}} @word_data={{this.ctrlAction "word_data"}} />
            <Stats::LostOrGainedWords @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} @word_cloud={{this.ctrlAction "word_cloud_right"}} @word_data={{this.ctrlAction "word_data"}} />
          {{/if}}
        {{/if}}
      </div>
      {{#unless this.usage_stats2}}
        <div class="md-stats-section-head">
          <h2 class="md-stats-section-head__label">{{t "Vocabulary Analysis" key="vocabulary_analysis"}}</h2>
          <span class="md-stats-section-head__rule" aria-hidden="true"></span>
        </div>
      {{/unless}}
      <div class="row md-stats-vocab-row{{if this.usage_stats2 " md-stats-compare-row" ""}}" style='page-break-inside: avoid;'>
        <Stats::CoreList @core={{this.model.core_lists}} @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} @word_cloud={{this.ctrlAction "word_cloud_left"}} @word_data={{this.ctrlAction "word_data"}} @edit_permission={{this.model.permissions.edit}} @modify_core={{this.ctrlAction "modify_core"}} />
        {{#if this.usage_stats2}}
          <Stats::CoreList @core={{this.model.core_lists}} @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} @word_cloud={{this.ctrlAction "word_cloud_right"}} @word_data={{this.ctrlAction "word_data"}} @edit_permission={{this.model.permissions.edit}} @modify_core={{this.ctrlAction "modify_core"}} />
        {{/if}}
        <Stats::CoreFringe @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} />
        {{#if this.usage_stats2}}
          <Stats::CoreFringe @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} />
        {{/if}}
        <Stats::PartsOfSpeechBreakdown @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} />
        {{#if this.usage_stats2}}
          <Stats::PartsOfSpeechBreakdown @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} />
        {{/if}}
        <Stats::SankeyPartsOfSpeech @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} />
        {{#if this.usage_stats2}}
          <Stats::SankeyPartsOfSpeech @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} />
        {{/if}}
        <Stats::SankeyWordPairs @wordPairsData={{this.wordPairsForSankey}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} />
        {{#if this.usage_stats2}}
          <Stats::SankeyWordPairs @wordPairsData={{this.wordPairsForSankey2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} />
        {{/if}}
      </div>
      <div class="row{{if this.usage_stats2 " md-stats-compare-row" ""}}" style='page-break-inside: avoid;'>
        <Stats::TimeOfDay @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} />
        {{#if this.usage_stats2}}
          <Stats::TimeOfDay @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} />
        {{/if}}
        <Stats::WeightedWords @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} @word_cloud={{this.ctrlAction "word_cloud_left"}} @word_data={{this.ctrlAction "word_data"}} />
        {{#if this.usage_stats2}}
          <Stats::WeightedWords @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} @word_cloud={{this.ctrlAction "word_cloud_right"}} @word_data={{this.ctrlAction "word_data"}} />
        {{/if}}
      </div>
      <div class="row{{if this.usage_stats2 " md-stats-compare-row" ""}}" style='page-break-inside: avoid;'>
        {{#if this.model.preferences.geo_logging }}
          <Stats::GeoLocations @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} @filter={{this.ctrlAction "update_left_filter"}} @snapshots={{this.filter_list}} />
          {{#if this.usage_stats2}}
            <Stats::GeoLocations @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} @filter={{this.ctrlAction "update_right_filter"}} />
          {{/if}}
          <Stats::IpAddresses @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} @filter={{this.ctrlAction "update_left_filter"}} />
          {{#if this.usage_stats2}}
            <Stats::IpAddresses @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} @filter={{this.ctrlAction "update_right_filter"}} />
          {{/if}}
        {{else}}
          <Stats::GeoDisabled @side_by_side={{this.usage_stats2}} />
          {{#if this.usage_stats2}}
            <Stats::GeoDisabled @side_by_side={{true}} @right_side={{true}} />
          {{/if}}
        {{/if}}
      </div>
      <div class="row{{if this.usage_stats2 " md-stats-compare-row" ""}}" style='page-break-inside: avoid;'>
        <Stats::HeatMap @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} />
        {{#if this.usage_stats2}}
          <Stats::HeatMap @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} />
        {{/if}}
        <Stats::UserDevices @usage_stats={{this.usage_stats}} @ref_stats={{this.usage_stats2}} @side_by_side={{this.usage_stats2}} @filter={{this.ctrlAction "update_left_filter"}} />
        {{#if this.usage_stats2}}
          <Stats::UserDevices @usage_stats={{this.usage_stats2}} @ref_stats={{this.usage_stats}} @side_by_side={{true}} @right_side={{true}} @filter={{this.ctrlAction "update_right_filter"}} />
        {{/if}}
      </div>
      {{#unless this.usage_stats2}}
        <div class="md-stats-actions hide_print">
          <LinkTo @route="user.logs" @model={{this.model.user_name}} @query={{hash start=this.usage_stats.start_date_field end=this.usage_stats.end_date_field location_id=this.controller.location_id device_id=this.controller.device_id highlighted=null type="session"}} class="md-btn md-btn--ghost">
            {{t "Log Entries for this Report" key="log_entries_for_report"}}
          </LinkTo>
          {{#if this.model.permissions.edit}}
            {{#unless this.snapshot_id}}
              <button type="button" class="md-btn md-btn--ghost" {{on "click" (this.ctrlAction "save_snapshot")}} title={{t "Save this date range to use later for report filtering and side-by-side comparisons" key="save_report_period_tooltip"}}>{{t "Create Snapshot" key="create_snapshot"}}</button>
            {{/unless}}
          {{/if}}
        </div>
      {{/unless}}
      </div>
    {{/if}}
  {{else if this.model.permissions.edit}}
    <section class="md-stats-hero-card" aria-labelledby="md-stats-hero-title">
      <h1 id="md-stats-hero-title" class="md-stats-hero__title">{{t "Reports" key="reports"}}</h1>
      <hr class="la-about-hero-separator" aria-hidden="true">
    </section>
    <p class="md-stats-text">{{t "%app_name% can generate insightful reports on word frequency, usage by time of day or location, etc., but only if logging is enabled. Right now it's turned off, but you can enable it in your settings." key="logging_disabled"}}</p>
    <button type="button" class="md-btn md-btn--primary" {{on "click" (this.ctrlAction "enable_logging")}}>{{t "Enable Communication Logging & Reports" key="enable_logging_and_reports"}}</button>
  {{else}}
    <section class="md-stats-hero-card" aria-labelledby="md-stats-hero-title">
      <h1 id="md-stats-hero-title" class="md-stats-hero__title">{{t "Reports" key="reports"}}</h1>
      <hr class="la-about-hero-separator" aria-hidden="true">
    </section>
    <p class="md-stats-text">{{t "Looks like this user has logging turned off, and you don't have permission to enable it for the user." key="unauthorized_reports"}}</p>
  {{/if}}
{{else if this.session.isAuthenticated}}
  <section class="md-stats-hero-card" aria-labelledby="md-stats-hero-title">
    <div class="md-stats-hero__head">
      <h1 id="md-stats-hero-title" class="md-stats-hero__title">{{t "Premium Membership Required" key="premium_required"}}</h1>
    </div>
    <hr class="la-about-hero-separator" aria-hidden="true">
  </section>
  <p class="md-stats-text">
    {{t "%app_name% is a powerful, flexible communication tool with lots of great features. Some features, including this one, are only available to users who have purchased a premium account. Please " key="purchase_subscription_1h"}}
    {{#if this.app_state.feature_flags.subscriptions}}
      <LinkTo @route="user.subscription" @model={{this.model.user_name}}>{{t "purchase a premium account" key="purchase_subscription_2"}}</LinkTo>
    {{else}}
      {{t "purchase a premium account" key="purchase_subscription_2"}}
    {{/if}}
    {{t "to support this good cause and to unlock this feature." key="purchase_subscription_3"}}
  </p>
{{else}}
  <LoginForm @left={{true}} @prompt={{true}} @return={{true}} />
{{/if}}
  </main>
</div>
  </div>
</div>
</OpeningObserver>
