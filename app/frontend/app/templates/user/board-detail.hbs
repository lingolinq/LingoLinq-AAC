<div class="md-shell md-shell--board-detail {{if this.edit_mode 'md-shell--board-detail-edit'}} {{if this.board_collapsed 'md-shell--board-collapsed'}} {{if this.paint_mode 'md-shell--board-paint'}} {{if this.dark_mode 'md-board-detail--dark'}} {{if this.model.integration 'md-shell--board-detail-integration'}} {{if this.model.public 'md-shell--board-public'}} {{if this.portrait_overlay_active 'md-shell--portrait-locked'}} {{if this.immersive_tools 'md-shell--immersive-tools'}} {{if this.board_collection_open 'md-shell--board-collection'}} {{if this.edit_board_collection_open 'md-shell--board-collection-left'}} {{if this.board_many_columns 'md-shell--many-columns'}} {{if this.board_buttons_narrow 'md-shell--buttons-narrow'}} {{this.word_suggestion_position_class}}">
  {{!-- Landscape-orientation overlay (feature: portrait_orientation_overlay).
       At ≤640px with >8 button columns, the board behind is dimmed +
       blurred + frozen (see .md-shell--portrait-locked) and this premium
       glass card invites a rotate. "Continue Anyway" is the accessibility
       escape hatch for mounted / one-handed / non-rotatable setups. --}}
  {{#if this.portrait_overlay_active}}
    <div class="md-board-detail-portrait-overlay" role="dialog" aria-modal="true" aria-labelledby="md-portrait-overlay-title" aria-describedby="md-portrait-overlay-desc">
      <div class="md-board-detail-portrait-overlay__card">
        <span class="md-board-detail-portrait-overlay__accent" aria-hidden="true"></span>
        <div class="md-board-detail-portrait-overlay__phone" aria-hidden="true">
          {{!-- Larger-screen icon: a monitor (bigger display) on a stand. Replaces the former
               rotate-to-landscape animation now that the recommendation is about DEVICE SIZE,
               not orientation. --}}
          <svg class="md-board-detail-portrait-overlay__phone-svg" width="76" height="76" viewBox="0 0 76 76" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="12" y="16" width="52" height="34" rx="4.5"/>
            <line x1="29" y1="59" x2="47" y2="59"/>
            <line x1="38" y1="50" x2="38" y2="59"/>
          </svg>
        </div>
        <h2 class="md-board-detail-portrait-overlay__title" id="md-portrait-overlay-title">{{t "Larger screen recommended" key="board_detail_larger_screen_recommended"}}</h2>
        <p class="md-board-detail-portrait-overlay__desc" id="md-portrait-overlay-desc">{{t "Boards this size are easier to view and edit on a larger screen. Consider switching to a larger device." key="board_detail_larger_screen_explanation"}}</p>
        <div class="md-board-detail-portrait-overlay__actions">
          <button type="button" class="md-board-detail-portrait-overlay__btn md-board-detail-portrait-overlay__btn--secondary" data-bd-action="dismiss_portrait_overlay" {{on "click" (this.ctrlAction "dismiss_portrait_overlay")}}>{{t "Continue Anyway" key="board_detail_continue_anyway"}}</button>
        </div>
      </div>
    </div>
  {{/if}}
  {{#if this.board_recoloring}}
    <div class="md-board-detail-loading md-board-detail-loading--overlay">
      <div class="md-board-detail-loading__card">
        <div class="md-loading-spinner"></div>
        <span class="md-board-detail-loading__text">{{t "Recoloring board — this may take a moment for larger boards..." key="board_detail_recoloring"}}</span>
        <button type="button" class="md-board-detail-loading__cancel" onclick="window.location.reload()">{{t "Cancel" key="cancel"}}</button>
      </div>
    </div>
  {{else if this.board_reverting_colors}}
    <div class="md-board-detail-loading md-board-detail-loading--overlay">
      <div class="md-board-detail-loading__card">
        <div class="md-loading-spinner"></div>
        <span class="md-board-detail-loading__text">{{t "Reverting to previous colors..." key="board_detail_reverting_colors"}}</span>
      </div>
    </div>
  {{/if}}
  {{outlet}}
  <div class="md-board-detail-layout {{if this.panels_collapsed 'md-board-detail-layout--collapsed'}}">
    {{!-- Overlay backdrop for mobile panels.
         The backdrop is a redundant click target — the explicit close button
         below provides the keyboard-accessible path. Mark the backdrop as
         aria-hidden so screen readers + keyboard users skip it. --}}
    {{#unless this.model.integration}}
      {{#unless this.panels_collapsed}}
        <div class="md-board-detail-overlay-backdrop" data-bd-action="toggle_panels" {{on "click" (this.ctrlAction "toggle_panels")}} aria-hidden="true"></div>
        <button type="button" class="md-board-detail-panels-close-btn" data-bd-action="toggle_panels" {{on "click" (this.ctrlAction "toggle_panels")}} aria-label={{t "Collapse panels" key="board_detail_collapse_panels"}}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      {{/unless}}
    {{/unless}}
    {{!-- Left Sidebar Navigation --}}
    {{#unless this.model.integration}}
    <aside class="md-board-detail-sidebar {{if this.panels_collapsed 'md-board-detail-sidebar--collapsed'}}" aria-label={{t "Board navigation" key="board_navigation"}}>
      {{!-- Collapse the side panels — visible only when expanded; hides when sidebar is collapsed (width:0). --}}
      <button type="button"
        class="md-board-detail-collapse-btn md-board-detail-collapse-btn--side md-board-detail-collapse-btn--side-left"
        title={{t "Collapse Side Panels" key="board_detail_collapse_side_panels"}}
        aria-label={{t "Collapse Side Panels" key="board_detail_collapse_side_panels"}}
        data-bd-action="toggle_panels" {{on "click" (this.ctrlAction "toggle_panels")}}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
      <section class="md-board-detail-sidebar__section">
        <h3 class="md-board-detail-sidebar__heading">{{t "Communicate" key="board_detail_communicate"}}</h3>
        {{#each this.sidebar_nav.communicate as |item|}}
          <button type="button"
            class="md-board-detail-sidebar__item {{if item.active 'md-board-detail-sidebar__item--active'}}"
            aria-current={{if item.active "page" "false"}}
            data-bd-action="nav_select" data-bd-arg="{{item.id}}" {{on "click" (this.ctrlAction "nav_select" item.id)}}>
            <span class="md-board-detail-sidebar__icon md-board-detail-sidebar__icon--{{item.icon}}" aria-hidden="true"></span>
            <span class="md-board-detail-sidebar__label">{{item.label}}</span>
          </button>
        {{/each}}
      </section>

      <section class="md-board-detail-sidebar__section">
        <h3 class="md-board-detail-sidebar__heading">{{t "Clinical" key="board_detail_clinical"}}</h3>
        {{#each this.sidebar_nav.clinical as |item|}}
          <button type="button"
            class="md-board-detail-sidebar__item {{if item.active 'md-board-detail-sidebar__item--active'}}"
            aria-current={{if item.active "page" "false"}}
            data-bd-action="nav_select" data-bd-arg="{{item.id}}" {{on "click" (this.ctrlAction "nav_select" item.id)}}>
            <span class="md-board-detail-sidebar__icon md-board-detail-sidebar__icon--{{item.icon}}" aria-hidden="true"></span>
            <span class="md-board-detail-sidebar__label">{{item.label}}</span>
          </button>
        {{/each}}
      </section>

      <section class="md-board-detail-sidebar__section">
        <h3 class="md-board-detail-sidebar__heading">{{t "Settings" key="board_detail_settings"}}</h3>
        {{#each this.sidebar_nav.settings as |item|}}
          <button type="button"
            class="md-board-detail-sidebar__item {{if item.active 'md-board-detail-sidebar__item--active'}}"
            aria-current={{if item.active "page" "false"}}
            data-bd-action="nav_select" data-bd-arg="{{item.id}}" {{on "click" (this.ctrlAction "nav_select" item.id)}}>
            <span class="md-board-detail-sidebar__icon md-board-detail-sidebar__icon--{{item.icon}}" aria-hidden="true"></span>
            <span class="md-board-detail-sidebar__label">{{item.label}}</span>
          </button>
        {{/each}}
      </section>
    </aside>
    {{/unless}}

    {{!-- Edit-mode Side Panel — permanent left rail visible only while
         editing a board. Houses primary navigation, Save/Cancel, the
         button-search filter, and the Board Details + Share & Export
         action groups. Every action wires to an existing controller
         method (no new wiring); this is purely chrome relocation.
         Lives as a sibling of <main> so the flex layout pushes the
         board grid + edit toolbar to the right column. See plan at
         .planning/phases/03-board-edit-side-panel/03-PLAN.md. --}}
    {{#if this.edit_mode}}
      {{!-- Removed aside-level {{on "click" (this.ctrlAction "expand_left_panel")}} per
           request: previously any click on the collapsed rail
           bubbled up here and re-expanded the panel, which meant a
           tap on the Copy/Search/Filter/etc. icon would fire the
           icon's action AND then immediately expand the panel. Now
           only the dedicated chevron button at the top expands;
           icon clicks fire just their own action and stay in the
           rail. --}}
      <aside class="md-board-edit-panel {{if this.left_panel_collapsed 'md-board-edit-panel--collapsed'}}" aria-label={{t "Board edit tools" key="board_edit_panel_label"}}>

        {{!-- Collapse/expand control at the TOP of the panel, mirroring
             the right panel's collapse chevron. Label hides when the
             panel is collapsed to a rail. bubbles=false: without it
             the click also reaches the <aside>'s expand_left_panel,
             which would immediately re-expand the just-collapsed
             panel. --}}
        <div class="md-board-edit-panel__header">
          <button type="button"
            class="md-board-edit-panel__collapse-btn"
            aria-expanded={{unless this.left_panel_collapsed "true" "false"}}
            aria-label={{if this.left_panel_collapsed (t "Expand panel" key="expand_panel") (t "Collapse panel" key="collapse_panel")}}
            data-bd-action="toggle_left_panel" {{on "click" (this.ctrlActionNoBubble "toggle_left_panel")}}>
            <svg class="md-board-edit-panel__collapse-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="11 17 6 12 11 7"/>
              <polyline points="18 17 13 12 18 7"/>
            </svg>
          </button>
          <h3 class="md-board-edit-panel__collapse-label">{{t "Action Panel" key="action_panel"}}</h3>
          {{!-- Collapsed rail shows the short form (CSS-swapped). --}}
          <span class="md-board-edit-panel__label-collapsed">{{t "Actions" key="actions_collapsed_short"}}</span>
        </div>

        <div class="md-board-edit-panel__divider" role="presentation"></div>

        {{!-- Board Collections — opens the inline BoardCollection drawer from the
             LEFT (the edit rail hides and the drawer takes its place; the center
             shifts right). Selecting a board loads it into the center in edit mode.
             Mirrors the speak-mode My Board Collection drawer. --}}
        <button type="button"
          class="md-board-edit-panel__row md-board-edit-panel__row--collection"
          data-tooltip={{t "Board Collections" key="board_collections"}}
          data-bd-action="open_edit_board_collection" {{on "click" (this.ctrlAction "open_edit_board_collection")}}>
          <svg class="md-board-edit-panel__icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z" clip-rule="evenodd"/>
          </svg>
          <span class="md-board-edit-panel__label">{{t "Board Collections" key="board_collections"}}</span>
          <span class="md-board-edit-panel__label-collapsed">{{t "Boards" key="board_collections_short"}}</span>
        </button>

        {{!-- TOP CLUSTER — single Back-to-Boards button. Triggers the
             confirm-leave-edit modal (Save & Continue / Discard / Keep
             Editing) instead of navigating directly, so the user is
             never able to leave with unsaved work by accident. The
             modal returns 'save' or 'discard' or undefined; the
             controller handles the redirect after each branch. --}}
        {{!-- Discard + Save tiles RELOCATED to the title-row-center in
             the edit-card header (search the file for
             `md-board-detail-header__edit-actions`). They were
             previously in this left-panel __top cluster but have been
             moved into the header per request, where they sit in the
             slot that used to hold the "Editing" pill (which itself
             now sits above the mock speak bar). The actions, classes,
             and disabled gating are unchanged — only the position
             moved — so the existing __top scoped CSS in app.scss still
             paints them. Left intentionally as a comment for easy
             rollback / future re-introduction. --}}

        {{!-- CATEGORIZE — opens the full-width category-order panel below. Sits
             ABOVE Board Actions: categorising is a board-shaping decision the
             user makes before reaching for the destructive/one-off actions in the
             gear menu. Gated on the grouping flag so the rail is unchanged when
             the feature is off. --}}
        {{#if this.app_state.feature_flags.board_category_grouping}}
        <div class="md-board-edit-panel__group md-board-edit-panel__group--categorize">
          <button type="button"
            class="md-board-edit-panel__row md-board-edit-panel__row--categorize {{if this.category_order_open 'md-board-edit-panel__row--active'}}"
            aria-expanded={{if this.category_order_open "true" "false"}}
            aria-controls="board-category-order-panel"
            data-bd-action="toggle_category_order"
            {{on "click" (this.ctrlAction "toggle_category_order")}}>
            <svg class="md-board-edit-panel__row-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1"></rect>
            </svg>
            <span class="md-board-edit-panel__label">{{t "Categorize" key="board_categorize"}}</span>
          </button>
        </div>
        {{/if}}

        {{!-- BOARD ACTIONS — sits below Categorize (which was moved above it
             2026-08-23). Expandable, mirrors the Filter by Category control:
             outlined toggle surface + chevron, body shown when open. Its
             `__filter-toggle` surface is the shared reference the Categorize and
             Board Collections rows now match — see `__row--categorize` and
             `__row--collection` in app.scss. --}}
        <div class="md-board-edit-panel__filter md-board-edit-panel__filter--actions {{unless this.board_actions_collapsed 'md-board-edit-panel__filter--open'}}">
          <button type="button"
            class="md-board-edit-panel__filter-toggle"
            aria-expanded={{if this.board_actions_collapsed "false" "true"}}
            aria-controls="board-edit-panel-actions-list"
            data-bd-action="toggle_board_actions" {{on "click" (this.ctrlAction "toggle_board_actions")}}>
            {{!-- Two-tone gear (matches right-panel section icons):
                 verdigris inner cog circle, charcoal outer teeth. --}}
            <svg class="md-board-edit-panel__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3" stroke="#2A9D8F"/>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" stroke="currentColor"/>
            </svg>
            <span class="md-board-edit-panel__filter-text">
              <span class="md-board-edit-panel__label">{{t "Board Actions" key="board_actions_caps"}}</span>
              {{!-- Collapsed-rail short form: "Actions". (Was briefly "Boards", but
                   the new Board Collections rail item above now owns the "Boards"
                   caption, so the gear reverts to "Actions" to avoid two "BOARDS"
                   captions in the collapsed rail.) --}}
              <span class="md-board-edit-panel__label-collapsed">{{t "Actions" key="actions_collapsed_short"}}</span>
            </span>
            <svg class="md-board-edit-panel__filter-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          {{#unless this.board_actions_collapsed}}
          <div id="board-edit-panel-actions-list" class="md-board-edit-panel__collapse">
          {{!-- All Board Actions sub-items get two-tone (verdigris
               primary / charcoal secondary) to match the right-
               panel section icons. --}}
          <button type="button" class="md-board-edit-panel__row" data-tooltip={{t "Add to Sidebar" key="add_to_sidebar"}} data-bd-action="add_to_sidebar" {{on "click" (this.ctrlAction "add_to_sidebar")}}>
            <svg class="md-board-edit-panel__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke="currentColor"/>
              <line x1="9" y1="3" x2="9" y2="21" stroke="#2A9D8F"/>
            </svg>
            <span class="md-board-edit-panel__label">{{t "Add to Sidebar" key="add_to_sidebar"}}</span>
          </button>
          {{!-- Board Ideas, Button Stash and Set as Home Board were relocated
               2026-08-24 into the Board Actions modal (components/board-actions.hbs),
               just above View Style, which came from this panel earlier. This group
               had grown to seven rows. `suggestions` and `open_button_stash` had NO
               other render site anywhere in the app, so they were MOVED, not deleted --
               dropping the rows alone would have made Button Stash unreachable. The
               modal opens from this same panel via "Other Actions" below, so the
               edit-mode path is unchanged. --}}
          <button type="button" class="md-board-edit-panel__row" data-tooltip={{t "Edit Board Details" key="edit_board_details"}} data-bd-action="board_details" {{on "click" (this.ctrlAction "board_details")}}>
            {{!-- Pencil-on-paper edit mark — page = charcoal,
                 pencil = verdigris. --}}
            <svg class="md-board-edit-panel__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke="currentColor"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke="#2A9D8F"/>
            </svg>
            <span class="md-board-edit-panel__label">{{t "Edit Board Details" key="edit_board_details"}}</span>
          </button>
          <button type="button" class="md-board-edit-panel__row" data-tooltip={{t "Speak Mode PIN" key="speak_mode_pin"}} {{on "click" (this.ctrlAction "pin_settings")}}>
            {{!-- Padlock — body = charcoal, shackle = verdigris. --}}
            <svg class="md-board-edit-panel__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="#2A9D8F"/>
            </svg>
            <span class="md-board-edit-panel__label">{{t "Set a PIN" key="set_a_pin"}}</span>
          </button>
          <button type="button" class="md-board-edit-panel__row" data-tooltip={{t "Set as Favorite" key="set_as_favorite"}} data-bd-action="toggle_favorite" {{on "click" (this.ctrlAction "toggle_favorite")}}>
            <svg class="md-board-edit-panel__icon" width="18" height="18" viewBox="0 0 24 24" fill={{if this.model.starred "#2A9D8F" "none"}} stroke="#2A9D8F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span class="md-board-edit-panel__label">{{t "Set as Favorite" key="set_as_favorite"}}</span>
          </button>
          {{!-- (Word Prediction moved to its own expandable section under
               BOARD SETTINGS in the right panel — see below.) --}}
          <button type="button" class="md-board-edit-panel__row" data-tooltip={{t "Other Actions" key="other_actions"}} data-bd-action="other_board_actions" {{on "click" (this.ctrlAction "other_board_actions")}}>
            <svg class="md-board-edit-panel__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
              <circle cx="5" cy="12" r="2"/>
              <circle cx="12" cy="12" r="2" fill="#2A9D8F"/>
              <circle cx="19" cy="12" r="2"/>
            </svg>
            <span class="md-board-edit-panel__label">{{t "Other Actions" key="other_actions"}}</span>
          </button>
          {{!-- Take a tour — the LAST Board Action, in normal flow after "Other
               Actions" so it pushes the content below it down (not floated over
               the menu). Hosts the GuidedTour "Take a tour" trigger AND the
               edit-tour runner. --}}
          {{#if this.app_state.feature_flags.home_tour}}
            <span class="md-board-edit-panel__tour"><GuidedTour @editHost={{true}} /></span>
          {{/if}}
          </div>
          {{/unless}}
        </div>

        {{!-- SEARCH & FILTER GROUP — the buttons-search input and the
             Filter by Category control share one labelled section,
             mirroring the Share & Export group's group+subheader
             pattern. --}}
        <div class="md-board-edit-panel__group md-board-edit-panel__group--search">
          <div class="md-board-edit-panel__subheader">
            {{t "Search & Filter" key="search_and_filter"}}
          </div>

          {{!-- SEARCH — inline filter input. Reuses board_search_string +
               update_board_search + clear_board_search (the same state
               the toolbar's existing search input writes to), so the
               grid filter "just works" with no controller changes. --}}
          <div class="md-board-edit-panel__search" role="search" {{on "click" (this.ctrlAction "open_board_search_panel")}}>
            {{!-- Two-tone: verdigris lens, charcoal handle. --}}
            <svg class="md-board-edit-panel__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8" stroke="#2A9D8F"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor"/>
            </svg>
            {{!-- Collapsed-rail caption — paired with the magnifier
                 icon when the panel is a 56px rail. The search input
                 itself is hidden in collapsed mode, so this label
                 stands in as the icon's identity. The matching
                 __label-collapsed class is already shown at 8px by
                 the rail label rules in app.scss. --}}
            <span class="md-board-edit-panel__label-collapsed">{{t "Search" key="search_short"}}</span>
            {{!-- size="1" defeats the browser's default ~20ch intrinsic
                 width so the input doesn't claim more horizontal room
                 than the panel's widest text row. The flexbox rules in
                 app.scss let it visually fill the search wrap up to the
                 panel's actual content width. --}}
            <input
              id="board-edit-panel-search"
              type="text"
              size="1"
              class="md-board-edit-panel__search-input"
              placeholder={{t "Search" key="search_short"}}
              aria-label={{t "Search buttons" key="search_buttons_aria"}}
              value={{this.board_search_string}}
              {{on "input" (this.eventAction "update_board_search")}}
            />
            {{#if this.board_search_string}}
              <button type="button" class="md-board-edit-panel__search-clear" data-bd-action="clear_board_search" {{on "click" (this.ctrlAction "clear_board_search")}} aria-label={{t "Clear filter" key="clear_filter"}}>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
            {{/if}}
          </div>

          {{!-- FILTER BY CATEGORY — expandable. Header reuses the row
               style; expanded body shows each part-of-speech category
               with a small Fitzgerald color swatch + label. Selecting
               a row writes to the controller's `active_category` (via
               set_panel_category), which the existing grid filter
               listens to — same data path as the toolbar's Categories
               dropdown, just exposed in the panel. --}}
          <div class="md-board-edit-panel__filter {{if this.panel_filter_open 'md-board-edit-panel__filter--open'}}">
            <button type="button"
              class="md-board-edit-panel__filter-toggle"
              aria-expanded={{if this.panel_filter_open "true" "false"}}
              aria-controls="board-edit-panel-filter-list"
              data-bd-action="toggle_panel_filter" {{on "click" (this.ctrlAction "toggle_panel_filter")}}>
              {{!-- Funnel filter icon — 16×16 to match the search
                   magnifier's declared size so the two icons read
                   as uniform across the search + filter card.
                   Two-tone: verdigris funnel body. --}}
              <svg class="md-board-edit-panel__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" stroke="#2A9D8F"/>
              </svg>
              <span class="md-board-edit-panel__filter-text">
                <span class="md-board-edit-panel__label">{{t "Category" key="filter_category_short"}}</span>
                {{#if this.active_filter_label}}
                  <span class="md-board-edit-panel__filter-sublabel">{{this.active_filter_label}}</span>
                {{/if}}
              </span>
              <svg class="md-board-edit-panel__filter-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            {{#if this.panel_filter_open}}
              <ul id="board-edit-panel-filter-list" class="md-board-edit-panel__filter-list" role="listbox" aria-label={{t "Filter by Category" key="filter_by_category"}}>
                {{#each this.pos_categories as |cat|}}
                  <li
                    class="md-board-edit-panel__filter-item md-board-edit-panel__filter-item--{{cat.css_class}} {{if (is-equal this.active_category cat.id) 'md-board-edit-panel__filter-item--active'}}"
                    role="option"
                    aria-selected={{if (is-equal this.active_category cat.id) "true" "false"}}
                    tabindex="0"
                    data-bd-action="set_panel_category" data-bd-arg="{{cat.id}}"
                    {{on "click" (this.ctrlAction "set_panel_category" cat.id)}}>
                    <span class="md-board-edit-panel__filter-swatch" aria-hidden="true"></span>
                    <span class="md-board-edit-panel__filter-name">{{cat.label}}</span>
                    {{#if (is-equal this.active_category cat.id)}}
                      <svg class="md-board-edit-panel__filter-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    {{/if}}
                  </li>
                {{/each}}
              </ul>
            {{/if}}
          </div>
        </div>

        {{!-- SHARE & EXPORT GROUP — 2x2 tile grid. Each tile is a
             square-ish card with a centered icon over its label,
             reading more like an iOS share sheet than a stacked
             list of rows. Click targets remain the same actions. --}}
        <div class="md-board-edit-panel__group md-board-edit-panel__group--share">
          <div class="md-board-edit-panel__subheader">
            {{t "Share & Print" key="share_and_print_caps"}}
          </div>
          <div class="md-board-edit-panel__share-grid">
            {{!-- All Share & Print tiles use the two-tone treatment
                 (verdigris primary, charcoal secondary) to match the
                 right-panel section icons. --}}
            <button type="button" class="md-board-edit-panel__tile" data-tooltip={{t "Copy" key="copy"}} data-bd-action="make_a_copy" {{on "click" (this.ctrlAction "make_a_copy")}}>
              <svg class="md-board-edit-panel__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" stroke="#2A9D8F"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke="currentColor"/>
              </svg>
              <span class="md-board-edit-panel__tile-label">{{t "Copy" key="copy"}}</span>
            </button>
            <button type="button" class="md-board-edit-panel__tile md-board-edit-panel__tile--download" data-tooltip={{t "Download" key="download"}} data-bd-action="download_board" {{on "click" (this.ctrlAction "download_board")}}>
              <svg class="md-board-edit-panel__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor"/>
                <polyline points="7 10 12 15 17 10" stroke="#2A9D8F"/>
                <line x1="12" y1="15" x2="12" y2="3" stroke="#2A9D8F"/>
              </svg>
              {{!-- Collapsed rail: "Down-" / "Load" stacked on two
                   lines so the label fits the 56px rail (DOWNLOAD on
                   one line was truncating to DOWNL…). The trailing
                   dash on "Down-" signals the word continues onto the
                   next line. Expanded panel keeps the single-word
                   "Download". --}}
              <span class="md-board-edit-panel__tile-label">{{#if this.left_panel_collapsed}}{{t "Down-" key="word_down_hyphen"}}<br>{{t "Load" key="word_load"}}{{else}}{{t "Download" key="download"}}{{/if}}</span>
            </button>
            <button type="button" class="md-board-edit-panel__tile" data-tooltip={{t "Print" key="print"}} data-bd-action="print_board" {{on "click" (this.ctrlAction "print_board")}}>
              <svg class="md-board-edit-panel__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 6 2 18 2 18 9" stroke="#2A9D8F"/>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" stroke="currentColor"/>
                <rect x="6" y="14" width="12" height="8" stroke="#2A9D8F"/>
              </svg>
              <span class="md-board-edit-panel__tile-label">{{t "Print" key="print"}}</span>
            </button>
            <button type="button" class="md-board-edit-panel__tile" data-tooltip={{t "Share" key="share"}} data-bd-action="share_board" {{on "click" (this.ctrlAction "share_board")}}>
              <svg class="md-board-edit-panel__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3" stroke="#2A9D8F"/>
                <circle cx="6" cy="12" r="3" stroke="#2A9D8F"/>
                <circle cx="18" cy="19" r="3" stroke="#2A9D8F"/>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" stroke="currentColor"/>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" stroke="currentColor"/>
              </svg>
              <span class="md-board-edit-panel__tile-label">{{t "Share" key="share"}}</span>
            </button>
          </div>
        </div>

        {{!-- Collapsed-rail Light/Dark toggle — uses the IDENTICAL
             `new-board-mockup-toggle` markup + classes from the
             create-board-new preview (see
             app/components/create-board-new.hbs around the
             nb-create-rail__theme-toggle). Sun ⟷ thumb ⟷ moon
             segmented pill, --dark modifier slides the thumb to the
             moon side. Wired to the existing set_dark_mode action so
             the toggle controls the same dark_mode state the
             expanded DISPLAY segmented toggle uses (the two stay in
             sync). Rendered only when the panel is collapsed so it
             doesn't compete with the expanded DISPLAY toggle in the
             __bottom block below. --}}
        {{#if this.left_panel_collapsed}}
          {{!-- Wrap toggle + MODE caption so the label sits underneath
               the pill and matches the other rail items' icon-over-
               caption layout. --}}
          <div class="md-board-edit-panel__row--theme-pill-wrap">
            <button type="button"
              class="md-board-edit-panel__row--theme-pill new-board-mockup-toggle nb-create-rail__theme-toggle {{if this.dark_mode 'new-board-mockup-toggle--dark'}}"
              role="switch"
              aria-checked={{if this.dark_mode "true" "false"}}
              aria-label={{t "Toggle light or dark mode" key="toggle_light_dark_mode"}}
              title={{t "Toggle light or dark mode" key="toggle_light_dark_mode"}}
              {{!-- Uses the flip action `toggle_dark_mode` (de-duped), NOT
                   `set_dark_mode (unless dark_mode …)`. The AAC pointer layer
                   re-fires a synthetic click on top of the native one, and the
                   `unless` recomputed dark_mode BETWEEN the two clicks, so the
                   pill toggled ON then straight back OFF and looked dead. The
                   de-dupe guard in toggle_dark_mode swallows the duplicate. --}}
              {{on "click" (this.ctrlAction "toggle_dark_mode")}}>
              <span class="new-board-mockup-toggle__icon new-board-mockup-toggle__icon--sun" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
              </span>
              <span class="new-board-mockup-toggle__thumb" aria-hidden="true"></span>
              <span class="new-board-mockup-toggle__icon new-board-mockup-toggle__icon--moon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              </span>
            </button>
            <span class="md-board-edit-panel__label-collapsed">{{t "Mode" key="mode_short"}}</span>
          </div>
        {{/if}}

        {{!-- ── VIEW STYLE + THEME (bottom of left panel) ───────────
             View Style: explains the current (Modern) view and offers a
             single button to switch to Classic, which persists the
             preference and navigates to the board-alt page (normal mode).
             Theme: segmented Light/Dark toggle directly beneath, both
             options always visible. --}}
        <div class="md-board-edit-panel__bottom">
          {{!-- View Style (Classic/Modern) was MOVED to the Board Actions modal
               (components/board-actions) — between Record Messages and Delete
               Board. The Theme (Board Display) toggle stays here. --}}
          <div class="md-board-edit-panel__group md-board-edit-panel__group--theme">
            <div class="md-board-edit-view-style md-board-edit-view-style--theme">
              <div class="md-board-edit-panel__subheader">{{t "Board Display" key="board_detail_board_display_label"}}</div>
              <div class="md-board-edit-view-style__toggle {{if this.dark_mode 'md-board-edit-view-style__toggle--dark'}}" role="group" aria-label={{t "Board Display" key="board_detail_board_display_label"}}>
                <button type="button"
                  class="md-board-edit-view-style__opt {{unless this.dark_mode 'md-board-edit-view-style__opt--active'}}"
                  aria-pressed={{if this.dark_mode "false" "true"}}
                  {{on "click" (this.ctrlAction "set_dark_mode" false)}}>
                  <svg class="md-board-edit-view-style__opt-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                  {{t "Light" key="board_detail_light_short"}}
                </button>
                <button type="button"
                  class="md-board-edit-view-style__opt {{if this.dark_mode 'md-board-edit-view-style__opt--active'}}"
                  aria-pressed={{if this.dark_mode "true" "false"}}
                  {{on "click" (this.ctrlAction "set_dark_mode" true)}}>
                  <svg class="md-board-edit-view-style__opt-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                  {{t "Dark" key="board_detail_dark_short"}}
                </button>
              </div>
            </div>
          </div>

        </div>

      </aside>
    {{/if}}

    {{!-- Main Content Area --}}
    <main class="md-board-detail-main">
      {{#if this.model.error}}
        <div class="md-board-detail-error" role="alert">
          <div class="md-board-detail-error__card">
            {{!-- Board frame with a slash — names the thing that failed (a board)
                 rather than a generic warning triangle, which reads as an app
                 fault. Decorative: the heading below carries the meaning. --}}
            <span class="md-board-detail-error__icon" aria-hidden="true">
              {{!-- The slash is NOT drawn here: it spans the whole badge, which is
                   larger than this 24x24 viewBox, so it is a ::after bar on the
                   disc itself (see .md-board-detail-error__icon in app.scss). --}}
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="16" rx="3"/>
                <line x1="3" y1="9" x2="21" y2="9"/>
                <line x1="9" y1="9" x2="9" y2="20"/>
              </svg>
            </span>
            <h2 class="md-board-detail-error__title">{{this.error_message}}</h2>
            <p class="md-board-detail-error__message">{{this.error_detail}}</p>
          {{#if this.retrying}}
            <p class="md-board-detail-error__retrying">
              <span class="md-board-detail-error__spinner" aria-hidden="true"></span>
              {{t "Trying again..." key="trying_again"}}
            </p>
          {{else}}
            {{!-- Broken links rarely recover with retry. Offer Home / Back
                 for everyone; supervisors also get Exit Speak Mode. --}}
            <div class="md-board-detail-error__actions">
              {{#if this.error_show_home}}
                <button type="button" class="btn btn-primary btn-lg md-board-detail-error__action md-board-detail-error__action--primary" data-bd-action="go_home" {{on "click" (this.ctrlAction "go_home")}}>
                  {{t "Go to Home Board" key="error_go_to_home_board"}}
                </button>
              {{/if}}
              {{#if this.show_board_back_nav}}
                <button type="button" class="btn btn-default btn-lg md-board-detail-error__action" data-bd-action="go_back" {{on "click" (this.ctrlAction "go_back")}}>
                  {{t "Go Back" key="error_go_back"}}
                </button>
              {{/if}}
              {{#if this.error_show_exit_speak}}
                <button type="button" class="btn btn-default btn-lg md-board-detail-error__action" data-bd-action="exit_speak_mode" {{on "click" (this.ctrlAction "exit_speak_mode")}}>
                  {{t "Exit Speak Mode" key="exit_speak_mode"}}
                </button>
              {{/if}}
            </div>
            <button type="button" class="md-board-detail-error__retry-link" data-bd-action="re_transition" {{on "click" (this.ctrlAction "re_transition")}}>
              {{t "Try Again" key="try_again"}}
            </button>
          {{/if}}
          </div>
        </div>
      {{else if this.model.integration}}
        {{#unless this.app_state.sessionUser.currently_premium_or_premium_supporter}}
          <p class='text-danger'>{{t "Installed tools will only work correctly for currently-active premium accounts" key="premium_required_for_tools"}}</p>
        {{else}}
          <div id="board_description" class="md-board-detail-integration-header">
            <button type="button" class="md-board-detail-integration-exit" {{on "click" (this.ctrlAction "exitBoards")}} aria-label={{t "Exit Boards" key="exit_boards"}}>
              <span class="glyphicon glyphicon-log-out" aria-hidden="true"></span>
              <span class="md-board-detail-integration-exit__label">{{t "Exit Boards" key="exit_boards"}}</span>
            </button>
            <span class="md-board-detail-integration-header__title">{{this.model.integration_name}}</span>
          </div>
          {{#if this.model.embed_url}}
            <EmbedFrame @board_style="width: 100%; height: 100%; position: relative;" @code={{this.model.action}} @embed_url={{this.model.embed_url}} @user_token={{this.model.user_token}} />
          {{else}}
            <p class='text-danger'>{{t "There was an error loading the tool's page, it appears to not be configured properly" key="misconfigured_integration"}}</p>
          {{/if}}
        {{/unless}}
      {{else}}
      {{!-- Sentence Bar — id="speak" lets the scanner find this row as the
           speak target on board-detail (mirrors board-alt's #speak element).
           Hidden in edit mode by `.md-shell--board-detail-edit
           .md-board-detail-sentence-row { display: none }` in app.scss; the
           editing state is shown by the session bar in the header instead. --}}
      <div id="speak" class="md-board-detail-sentence-row {{this.sentence_bar_height_class}} {{this.symbol_background_class}} {{if this.hide_speak_bar 'md-board-detail-sentence-row--hide-bar'}}">
      {{!-- Left nav column: Home on top; inside a folder the back button
           drops beneath it (styled like the right-side sidebar dropdown
           button) instead of sitting inside the sentence bar, so the row
           reads as symmetric stacked-controls | bar | stacked-controls. --}}
      {{!-- "Try this Board" return path. Sits to the LEFT of the nav stack (so
           left of Home) and is deliberately larger than the other nav controls,
           with a glow: it is a temporary way out of a trial rather than part of
           the permanent chrome, and should read as the obvious thing to press if
           the board is not what they wanted. Shows only while the trial marker
           names THIS board, and is cleared on any exit from board-detail (see
           routes/user/board-detail#resetController). --}}
      {{#if this.show_try_back_nav}}
        <button type="button" class="md-board-detail-try-back" data-bd-action="try_back_to_picker" {{on "click" (this.ctrlAction "try_back_to_picker")}} aria-label={{t "Back to board picker" key="board_detail_try_back_aria"}} title={{t "Back to board picker" key="board_detail_try_back_aria"}}>
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          <span class="md-board-detail-try-back__label">{{t "Back" key="board_detail_try_back"}}</span>
        </button>
      {{/if}}
      <div class="md-board-detail-nav-stack">
        {{!-- Home and the modeling control share one COLUMN so modeling sits
             directly under Home at the same width; Back stays a sibling of the
             column, keeping the row's Home|Back pairing. The column is a flex
             column and Home is the flexible child, so Home shrinks by exactly
             the modeling button's height when modeling is active and takes the
             full height when it is not — no separate "shrink" rule needed. --}}
        <div class="md-board-detail-nav-stack__home-col">
        <button type="button" class="md-board-detail-home-btn" data-bd-action="go_home" {{on "click" (this.ctrlAction "go_home")}} aria-label={{t "Home" key="board_detail_home"}} title={{t "Home" key="board_detail_home"}}>
          <svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12 12 3l9 9"/>
            <path d="M5 10v10a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1V10"/>
          </svg>
          <span class="md-board-detail-nav-btn__label">{{t "Home" key="board_detail_home"}}</span>
        </button>
        {{!-- Modeling indicator — was a pill inside the sentence bar, then a third nav
             button under Home, and is now a read-only badge in that same slot. The long
             "Modeling is paused" caption the pill carried is still dropped: it cannot fit a
             60px box, and the aria-label says it in full for screen readers. The play/pause
             icon that used to carry the state visually is gone with the toggle; colour and
             the aria-label carry it now. --}}
        {{!-- STATUS BADGE, not a control. The manual pause/resume toggle is commented out
              below rather than deleted, pending verification — restore that block and drop
              this span to bring it back.

              What was removed is only the MANUAL toggle. `modeling_paused` itself is still
              live and still written by the edit route (routes/user/board-detail/edit.js:69
              on entry, :126 on exit), because app-state.js:4072 reads it to keep a
              supervisor's taps while editing OUT of the communicator's report data. That
              behaviour is untouched; only the user-facing button is gone.

              The badge still distinguishes the paused case, because saying "Modeling" while
              modeling is suppressed would misreport what the system is doing. It is a
              <span role="status"> in both states, so it is no longer a scan or dwell target
              — two fewer stops in the cycle. --}}
        {{#if this.app_state.modeling_session_active}}
          <span class="md-board-detail-modeling-btn md-board-detail-modeling-btn--badge {{if this.edit_mode 'md-board-detail-modeling-btn--paused'}}" role="status"
                aria-label={{if this.edit_mode
                             (t "Modeling paused while editing — will resume on exit" key="board_detail_modeling_paused_edit")
                             (t "Modeling mode is active" key="board_detail_modeling_active")}}>
            <span class="md-board-detail-nav-btn__label">{{t "Modeling" key="board_detail_modeling_label"}}</span>
          </span>
        {{/if}}
        {{!-- COMMENTED OUT 2026-08-31 — manual modeling pause/resume. Restore verbatim to
              re-enable, and remove the badge above. The controller action it calls
              (`toggle_modeling_pause`) is commented out in board-detail.js in the same pass.
        {{#if this.app_state.modeling_session_active}}
          {{#if this.edit_mode}}
            <span class="md-board-detail-modeling-btn md-board-detail-modeling-btn--paused" role="status" aria-label={{t "Modeling paused while editing — will resume on exit" key="board_detail_modeling_paused_edit"}}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                <path d="M8 5.5a1 1 0 0 1 1.5-.87l9 6.5a1 1 0 0 1 0 1.74l-9 6.5A1 1 0 0 1 8 18.5v-13z"/>
              </svg>
              <span class="md-board-detail-nav-btn__label">{{t "Modeling" key="board_detail_modeling_label"}}</span>
            </span>
          {{else if this.app_state.modeling_paused}}
            <button type="button" class="md-board-detail-modeling-btn md-board-detail-modeling-btn--paused" data-bd-action="toggle_modeling_pause" {{on "click" (this.ctrlAction "toggle_modeling_pause")}} aria-label={{t "Modeling paused — click to resume" key="board_detail_modeling_paused_resume"}}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                <path d="M8 5.5a1 1 0 0 1 1.5-.87l9 6.5a1 1 0 0 1 0 1.74l-9 6.5A1 1 0 0 1 8 18.5v-13z"/>
              </svg>
              <span class="md-board-detail-nav-btn__label">{{t "Modeling" key="board_detail_modeling_label"}}</span>
            </button>
          {{else}}
            <button type="button" class="md-board-detail-modeling-btn" data-bd-action="toggle_modeling_pause" {{on "click" (this.ctrlAction "toggle_modeling_pause")}} aria-label={{t "Modeling mode is active — click to pause" key="board_detail_modeling_active_pause"}}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                <rect x="6" y="5" width="4" height="14" rx="1.5"/>
                <rect x="14" y="5" width="4" height="14" rx="1.5"/>
              </svg>
              <span class="md-board-detail-nav-btn__label">{{t "Modeling" key="board_detail_modeling_label"}}</span>
            </button>
          {{/if}}
        {{/if}}
        --}}
        </div>
        {{#if this.show_board_back_nav}}
          <button type="button" class="md-board-detail-nav-stack__back" data-bd-action="go_back" {{on "click" (this.ctrlAction "go_back")}} aria-label={{t "Go back to previous board" key="board_detail_go_back"}}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6" stroke="currentColor"/>
            </svg>
            <span class="md-board-detail-nav-btn__label">{{t "Back" key="board_detail_back"}}</span>
          </button>
        {{/if}}
      </div>
      {{!-- Non-transformed wrapper. It exists ONLY so the quick-actions popover below
            can escape the sentence bar, which is a STACKING CONTEXT of its own: the bar
            carries backdrop-filter plus a transform/will-change GPU layer, and any one of
            those traps its descendants. A popover rendered inside it could never paint
            above the board however high its z-index went — measured at 640/480/375px, the
            panel lost 2 of 5 hit-tests to board buttons carrying a mere `z-index: 1`
            (scripts/speak-header-narrow-qa.mjs). `position: fixed` would not have escaped
            either; a transformed ancestor captures that too. Moving the markup OUT is the
            only fix that does not mean stripping the frosted bar of its own styling. --}}
      <div class="md-board-detail-sentence-bar-wrap">
      <div class="md-board-detail-sentence-bar" role="region" aria-label={{t "Message composition" key="board_detail_message_composition"}}>
        {{!-- Tapping the composed message also speaks it (mouse/touch bonus —
             the inline mic below is the keyboard/SR speak control, so this
             stays a plain click target with no tabindex/role to avoid a
             duplicate "Speak sentence" tab stop). --}}
        <div class="md-board-detail-sentence-bar__text {{if (and this.utterance_show_symbols this.has_sentence) "md-board-detail-sentence-bar__text--with-symbols"}}" aria-live="polite" data-bd-action="speak_sentence" {{on "click" (this.ctrlAction "speak_sentence")}}>
          {{#if this.has_sentence}}
            {{#if (or this.utterance_show_symbols this.sentence_bar_editing_enabled)}}
              {{#each this.sentence_parts as |part index|}}
                <SentenceBarChip
                  @part={{part}}
                  @index={{index}}
                  @total={{this.sentence_parts.length}}
                  @editingEnabled={{this.sentence_bar_editing_enabled}}
                  @selected={{is-equal this.selected_chip_index index}}
                  @swapSource={{is-equal this.swap_source_index index}}
                  @swapActive={{this.chip_swap_active}}
                  @textOnTop={{this.utterance_text_on_top}}
                  @showSymbols={{this.utterance_show_symbols}}
                  @onSelect={{this.ctrlAction "select_chip"}}
                  @onRemove={{this.ctrlAction "remove_chip"}}
                  @onMove={{this.ctrlAction "move_chip"}}
                  @onToggleSwap={{this.ctrlAction "toggle_chip_swap"}}
                  @onSwapTarget={{this.ctrlAction "chip_swap_target"}}
                  @onDragMove={{this.ctrlAction "chip_drag_move"}}
                  @onCancel={{this.ctrlAction "cancel_chip_edit"}} />
              {{/each}}
            {{else}}
              {{this.sentence_text}}
            {{/if}}
            {{!-- Inline word predictions --}}
            {{#if this.show_word_suggestions}}
              {{#if this.suggestions.ready}}
                {{#if this.prediction_suggestions.length}}
                  {{!-- --is-loading is set only once a lookup has been running longer
                       than the cue delay (see suggestions_loading_visible); the words
                       themselves stay put and stay clickable while it is on. --}}
                  <span class="md-board-detail-sentence-bar__prediction-group {{this.button_text_position_class}} {{if this.suggestions_loading_visible 'md-board-detail-sentence-bar__prediction-group--is-loading'}}" role="group" aria-label={{t "Word predictions" key="board_detail_word_predictions"}} aria-busy={{if this.suggestions_loading_visible "true" "false"}} style={{safe-style (concat "--bd-button-text-size:" this.button_text_size_px "px")}}>
                    {{#each this.prediction_bar_suggestions key="word" as |suggestion|}}
                      <button type="button" class="md-board-detail-sentence-bar__prediction" {{on "click" (this.ctrlActionNoBubble "complete_word" suggestion)}} aria-label={{concat (t "Predicted word" key="board_detail_predicted_word") ": " suggestion.word}}>
                        {{#if this.utterance_show_symbols}}
                          {{#if suggestion.image}}
                            <img src={{suggestion.image}} rel={{suggestion.fallback_image}} {{image-fallback-to-rel}} alt="" class="md-board-detail-sentence-bar__prediction-img" decoding="async" loading="eager">
                          {{/if}}
                        {{/if}}
                        <span class="md-board-detail-sentence-bar__prediction-label">{{suggestion.word}}</span>
                      </button>
                    {{/each}}
                  </span>
                {{/if}}
              {{/if}}
            {{/if}}
          {{else}}
            <span class="md-board-detail-sentence-bar__placeholder">{{t "Tap symbols to build your message" key="board_detail_tap_symbols"}}</span>
          {{/if}}
        </div>
        {{!-- Screen-reader announcements for speak-bar edits (remove / move /
             swap / replace) — visually hidden, polite so it never steals focus. --}}
        {{#if this.sentence_bar_editing_enabled}}
          <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">{{this.sentence_edit_announcement}}</div>
        {{/if}}
        {{!-- Below-chip labeled edit menu (feature: sentence_bar_editing). The
             tapped chip HIGHLIGHTS immediately; this menu opens after a 2s dwell
             (accidental / repeat-tap guard). Rendered here as a child of the bar
             — NOT inside the overflow-clipped __text scroller — so it can drop
             below the chip; JS anchors it (chip_menu_style) with a caret. --}}
        {{#if (and this.sentence_bar_editing_enabled this.chip_menu_open)}}
          <div class="md-board-detail-sentence-bar__chip-menu" role="group"
               aria-label={{t "Edit word" key='sentence_bar_edit_word'}}
               style={{this.chip_menu_style}}>
            <span class="md-board-detail-sentence-bar__chip-menu-caret" style={{this.chip_menu_caret_style}} aria-hidden="true"></span>
            <div class="md-board-detail-sentence-bar__chip-menu-actions">
              {{#if this.selected_chip_can_move_left}}
                <button type="button" class="md-board-detail-sentence-bar__chip-menu-btn"
                  aria-label={{t "Move left (%{word})" key='sentence_bar_move_left' word=this.selected_chip_word}}
                  {{on "click" (this.ctrlAction "move_chip" this.selected_chip_index -1)}}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                  <span class="md-board-detail-sentence-bar__chip-menu-btn-label">{{t "Move left" key='sentence_bar_action_move_left'}}</span>
                </button>
              {{/if}}
              <button type="button" class="md-board-detail-sentence-bar__chip-menu-btn md-board-detail-sentence-bar__chip-menu-btn--switch {{if this.selected_chip_swapping 'is-active'}}"
                aria-pressed={{if this.selected_chip_swapping "true" "false"}}
                aria-label={{t "Switch or replace (%{word})" key='sentence_bar_switch' word=this.selected_chip_word}}
                {{on "click" (this.ctrlAction "toggle_chip_swap" this.selected_chip_index)}}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                <span class="md-board-detail-sentence-bar__chip-menu-btn-label">{{t "Switch" key='sentence_bar_action_switch'}}</span>
              </button>
              <button type="button" class="md-board-detail-sentence-bar__chip-menu-btn md-board-detail-sentence-bar__chip-menu-btn--remove"
                aria-label={{t "Remove (%{word})" key='sentence_bar_remove' word=this.selected_chip_word}}
                {{on "click" (this.ctrlAction "remove_chip" this.selected_chip_index)}}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                <span class="md-board-detail-sentence-bar__chip-menu-btn-label">{{t "Remove" key='sentence_bar_action_remove'}}</span>
              </button>
              {{#if this.selected_chip_can_move_right}}
                <button type="button" class="md-board-detail-sentence-bar__chip-menu-btn"
                  aria-label={{t "Move right (%{word})" key='sentence_bar_move_right' word=this.selected_chip_word}}
                  {{on "click" (this.ctrlAction "move_chip" this.selected_chip_index 1)}}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                  <span class="md-board-detail-sentence-bar__chip-menu-btn-label">{{t "Move right" key='sentence_bar_action_move_right'}}</span>
                </button>
              {{/if}}
            </div>
          </div>
        {{/if}}
        <div class="md-board-detail-sentence-bar__actions">
          {{!-- Inline mic = the primary, keyboard/SR-accessible speak control.
               Tapping the sentence-bar text above also speaks (a bonus
               pointer target — see its {{on "click" (this.ctrlAction "speak_sentence")}}). Immersive
               mode (≤640px, feature on): mic/backspace/clear collapse into the
               down-arrow chevron's quick-actions popover below, reclaiming
               horizontal space. Otherwise they stay inline as before. --}}
          {{#unless this.immersive_tools}}
          <button type="button" class="md-board-detail-sentence-bar__btn md-board-detail-sentence-bar__btn--speak" aria-label={{t "Speak sentence" key="board_detail_speak_sentence"}} data-bd-action="speak_sentence" {{on "click" (this.ctrlAction "speak_sentence")}}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/>
              <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
          </button>
          {{/unless}}
          <div class="md-board-detail-sentence-bar__tools">
            {{#unless this.immersive_tools}}
            <button type="button" class="md-board-detail-sentence-bar__tool-btn" title={{t "Backspace" key="backspace_lower"}} aria-label={{t "Backspace" key="backspace_lower"}} data-bd-action="backspace_sentence" {{on "click" (this.ctrlAction "backspace_sentence")}}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/>
                <line x1="18" y1="9" x2="12" y2="15"/>
                <line x1="12" y1="9" x2="18" y2="15"/>
              </svg>
            </button>
            <button type="button" class="md-board-detail-sentence-bar__tool-btn" title={{t "Clear" key="board_detail_clear"}} aria-label={{t "Clear" key="board_detail_clear"}} data-bd-action="clear_sentence" {{on "click" (this.ctrlAction "clear_sentence")}}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 6 5 6 21 6"/>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                <line x1="10" y1="11" x2="10" y2="17"/>
                <line x1="14" y1="11" x2="14" y2="17"/>
              </svg>
            </button>
            <button type="button" class="md-board-detail-sentence-bar__tool-btn" title={{t "Speak options" key="speak_options"}} aria-label={{t "Speak options" key="speak_options"}} data-bd-action="open_speak_menu" {{on "click" (this.ctrlAction "open_speak_menu")}}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
            </button>
            {{else}}
            {{!-- Consolidated down-arrow: opens the quick-actions popover
                 holding Speak / Backspace / Clear, plus "More" → the
                 existing speak-menu modal so nothing becomes unreachable. --}}
            <button type="button" class="md-board-detail-sentence-bar__tool-btn md-board-detail-sentence-bar__tool-btn--chevron {{if this.quick_actions_open 'md-board-detail-sentence-bar__tool-btn--active'}}" title={{t "Sentence actions" key="board_detail_sentence_actions"}} aria-label={{t "Sentence actions" key="board_detail_sentence_actions"}} aria-haspopup="menu" aria-expanded={{if this.quick_actions_open "true" "false"}} data-bd-action="toggle_quick_actions" {{on "click" (this.ctrlAction "toggle_quick_actions")}}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            {{/unless}}
          </div>
        </div>
      </div>
        {{#if this.quick_actions_open}}
          <div class="md-board-detail-sentence-bar__quick-actions" role="menu" aria-label={{t "Sentence actions" key="board_detail_sentence_actions"}}>
            <button type="button" role="menuitem" class="md-board-detail-sentence-bar__quick-action" data-bd-action="speak_sentence" {{on "click" (this.ctrlAction "speak_sentence")}}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                <line x1="12" y1="19" x2="12" y2="23"/>
                <line x1="8" y1="23" x2="16" y2="23"/>
              </svg>
            <span>{{t "Speak" key="board_detail_speak"}}</span>
          </button>
        <button type="button" role="menuitem" class="md-board-detail-sentence-bar__quick-action" data-bd-action="backspace_sentence" {{on "click" (this.ctrlAction "backspace_sentence")}}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/>
            <line x1="18" y1="9" x2="12" y2="15"/>
            <line x1="12" y1="9" x2="18" y2="15"/>
          </svg>
        <span>{{t "Backspace" key="backspace_lower"}}</span>
        </button>
        <button type="button" role="menuitem" class="md-board-detail-sentence-bar__quick-action" data-bd-action="clear_sentence" {{on "click" (this.ctrlAction "clear_sentence")}}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="3 6 5 6 21 6"/>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
        <line x1="10" y1="11" x2="10" y2="17"/>
        <line x1="14" y1="11" x2="14" y2="17"/>
        </svg>
        <span>{{t "Clear" key="board_detail_clear"}}</span>
        </button>
        <button type="button" role="menuitem" class="md-board-detail-sentence-bar__quick-action md-board-detail-sentence-bar__quick-action--more" data-bd-action="open_speak_menu" {{on "click" (this.ctrlAction "open_speak_menu")}}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>
        </svg>
        <span>{{t "More" key="board_detail_more"}}</span>
        </button>
        </div>
        {{/if}}
      </div>
      <div class="md-board-detail-sentence-bar__actions-wrap md-board-detail-sentence-bar__actions-wrap--stacked">
        <button type="button"
          class="md-board-detail-actions-toggle"
          title={{t "Options" key="board_detail_options"}}
          aria-label={{t "Options" key="board_detail_options"}}
          aria-expanded={{if this.show_options_menu "true" "false"}}
          aria-haspopup="menu"
          data-bd-action="toggle_options_menu" {{on "click" (this.ctrlAction "toggle_options_menu")}}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
            <circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/>
          </svg>
        </button>
        {{#unless this.model.integration}}
        {{#unless this.app_state.currentUser.preferences.disable_quick_sidebar}}
        {{#unless this.edit_mode}}
          <button type="button" class="md-board-detail-sidebar-toggle md-board-detail-sidebar-toggle--stacked {{if this.inlineSidebarOpen 'md-board-detail-sidebar-toggle--open'}}" title={{t "Toggle sidebar" key="toggle_sidebar"}} aria-label={{t "Toggle sidebar" key="toggle_sidebar"}} aria-pressed={{if this.inlineSidebarOpen "true" "false"}} {{on "click" (this.ctrlAction "toggleInlineSidebar")}}>
            {{#if this.inlineSidebarOpen}}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="18 14 12 8 6 14" stroke="currentColor"/>
                <polyline points="18 22 12 16 6 22" stroke="#7693B9"/>
              </svg>
            {{else}}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 14 12 20 18 14" stroke="currentColor"/>
                <polyline points="6 6 12 12 18 6" stroke="#7693B9"/>
              </svg>
            {{/if}}
          </button>
        {{/unless}}
        {{/unless}}
        {{/unless}}
        {{!-- Speak-mode guided-tour RUNNER (no on-screen button — its trigger is
             hidden via .md-board-detail-speak-tour in app.scss; the user-facing
             entry point is the "Take a tour" item in the options menu below). This
             host is the ONLY runner that may auto-start the speak tour after
             "Pick this Board" (@speakHost gates
             guided-tour.js _consumePendingBoardDetailSpeakTour — the navbar
             runner must not steal the start during the empty_header race). The
             menu item triggers via the same pending flag. Gated to NON-edit mode
             (the edit-session bar has its own @editHost GuidedTour) and the
             home_tour flag. Always rendered (not inside the conditional menu) so
             the runner is present on page load for the auto-open. --}}
        {{#unless this.edit_mode}}
          {{#if this.app_state.feature_flags.home_tour}}
            <span class="md-board-detail-speak-tour" aria-hidden="true"><GuidedTour @speakHost={{true}} /></span>
          {{/if}}
        {{/unless}}
        {{#if this.show_options_menu}}
          {{!-- Click-outside scrim. Keyboard users dismiss the menu via Escape
            (handled by board-detail controller) so this is purely a mouse
            convenience — hide it from AT. --}}
          <div class="md-board-detail-actions-backdrop" data-bd-action="toggle_options_menu" {{on "click" (this.ctrlAction "toggle_options_menu")}} aria-hidden="true"></div>
          <div class="md-board-detail-actions-menu" role="menu" {{on "keydown" (this.eventAction "options_menu_keydown")}}>
            {{#unless this.edit_mode}}
              {{!-- Edit Board — pulled out of the BOARD section per
                   design request and floated above all other items as
                   the single primary destination from the options
                   dropdown. No section label / divider on this row so
                   it reads as a hero-action shortcut. --}}
              {{#if this.can_edit_or_copy_board}}
                <div class="md-board-detail-actions-menu__section">
                  <button type="button" class="md-board-detail-actions-menu__item md-board-detail-actions-menu__item--edit" data-bd-action="enter_edit_mode" {{on "click" (this.ctrlAction "enter_edit_mode")}}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                    <span>{{t "Edit Board" key="board_detail_edit_board"}}</span>
                  </button>
                </div>
              {{/if}}

              {{!-- Set as Home — the one action from the edit panel that had NO
                    view-mode route at all. Copy already had one (Share & Print ->
                    Copy, below); this did not, which is why "unreachable outside
                    edit mode" was reported for both. Sits beside Edit Board rather
                    than in Share & Print because it is a "make this mine" action,
                    not an export one — and it is the step that makes a board work
                    offline, so it belongs at the top level, not two menus deep. --}}
              {{#if (and this.can_set_as_home (not (get this.speak_menu_hidden_set "set_as_home")))}}
                <div class="md-board-detail-actions-menu__section">
                  <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="set_as_home" {{on "click" (this.ctrlAction "set_as_home")}}
                    title={{t "Make this the board you start on, and available offline" key="board_detail_set_as_home_tooltip"}}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                      <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    <span>{{t "Set as Home Board" key="set_as_home_board"}}</span>
                  </button>
                </div>
              {{/if}}

              {{!-- Board Section — flattened to a single row that
                   opens the inline My Board Collection panel. The
                   prior expandable Board → (My Boards / Find Boards)
                   structure was replaced 2026-05-28: both legacy
                   children collapse into one entry that surfaces a
                   sectioned, alphabetized browse-by-brand list in
                   place of the rest of the menu. --}}
              {{#if this.speak_section_visible_board}}
                <div class="md-board-detail-actions-menu__section">
                  <button type="button" class="md-board-detail-actions-menu__item md-board-detail-actions-menu__item--has-sub" data-bd-action="open_board_collection" {{on "click" (this.ctrlAction "open_board_collection")}}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                      <path fill-rule="evenodd" d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z" clip-rule="evenodd"/>
                    </svg>
                    <span>{{t "My Board Collection" key="my_board_collection"}}</span>
                    <svg class="md-board-detail-actions-menu__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                  </button>
                </div>
              {{/if}}

              {{!-- Buttons Section — now expandable. Contains Find a
                   Button, Focus Words, Show Hidden Buttons. Whole
                   section hides when all three are hidden via
                   Customize Menu. --}}
              {{#if this.speak_section_visible_buttons}}
              <div class="md-board-detail-actions-menu__section">
                <button type="button" class="md-board-detail-actions-menu__item md-board-detail-actions-menu__item--has-sub md-board-detail-actions-menu__section-toggle" aria-expanded={{if this.buttons_submenu_open "true" "false"}} data-bd-action="toggle_buttons_submenu" {{on "click" (this.ctrlAction "toggle_buttons_submenu")}}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/>
                  </svg>
                  <span>{{t "Buttons" key="buttons"}}</span>
                  <svg class="md-board-detail-actions-menu__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                {{#if this.buttons_submenu_open}}
                  <div class="md-board-detail-actions-menu__submenu">
                    {{#unless (get this.speak_menu_hidden_set "find_button")}}
                    {{#if this.app_state.currentBoardState}}
                      {{#unless this.app_state.eval_mode}}
                        <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="find_button" {{on "click" (this.ctrlAction "find_button")}}>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                          </svg>
                          <span>{{t "Find a Button" key="find_a_button"}}</span>
                        </button>
                      {{/unless}}
                    {{/if}}
                    {{/unless}}
                    {{#unless (get this.speak_menu_hidden_set "focus_words")}}
                    {{#if this.app_state.feature_flags.focus_word_highlighting}}
                      {{#unless this.app_state.eval_mode}}
                        <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="toggle_focus" {{on "click" (this.ctrlAction "toggle_focus")}}>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
                          </svg>
                          <span>
                            {{#if this.app_state.focus_words}}
                              {{t "Clear Focus Words" key="clear_focus_words"}}
                            {{else}}
                              {{t "Focus Words" key="focus_words"}}
                            {{/if}}
                          </span>
                        </button>
                      {{/unless}}
                    {{/if}}
                    {{/unless}}
                    {{#unless (get this.speak_menu_hidden_set "show_hidden_buttons")}}
                    {{#if this.app_state.feature_flags.enable_all_buttons}}
                      {{#unless this.app_state.currentUser.preferences.prevent_hide_buttons}}
                        {{#unless this.app_state.eval_mode}}
                          <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="toggle_all_buttons" {{on "click" (this.ctrlAction "toggle_all_buttons")}}>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              {{#if this.stashes.all_buttons_enabled}}
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                              {{else}}
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                              {{/if}}
                            </svg>
                            <span>
                              {{#if this.stashes.all_buttons_enabled}}
                                {{t "Hide Hidden Buttons" key="hide_disabled_buttons"}}
                              {{else}}
                                {{t "Show Hidden Buttons" key="show_all_buttons"}}
                              {{/if}}
                            </span>
                          </button>
                        {{/unless}}
                      {{/unless}}
                    {{/if}}
                    {{/unless}}
                  </div>
                {{/if}}
              </div>
              {{/if}}

              {{!-- Share & Print — now expandable. Contains Copy,
                   Download, Print, Share. Translate was previously
                   inside this group; pulled out and moved below the
                   Session section per request. Whole section hides
                   when all four children are hidden via Customize
                   Menu. --}}
              {{#if this.speak_section_visible_share}}
              <div class="md-board-detail-actions-menu__section">
                <button type="button" class="md-board-detail-actions-menu__item md-board-detail-actions-menu__item--has-sub md-board-detail-actions-menu__section-toggle" aria-expanded={{if this.share_print_submenu_open "true" "false"}} data-bd-action="toggle_share_print_submenu" {{on "click" (this.ctrlAction "toggle_share_print_submenu")}}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="18" cy="5" r="3"/>
                    <circle cx="6" cy="12" r="3"/>
                    <circle cx="18" cy="19" r="3"/>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                  </svg>
                  <span>{{t "Share & Print" key="share_and_print"}}</span>
                  <svg class="md-board-detail-actions-menu__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                {{#if this.share_print_submenu_open}}
                  <div class="md-board-detail-actions-menu__submenu">
                    {{!-- "Make a Copy", not "Copy": under a Share & Print heading a
                          bare "Copy" reads as copy-to-clipboard / export, which is
                          why two usability reviews reported this action as missing
                          when it was here all along. Own key — `copy` is shared
                          with the utterance clipboard button and a button-settings
                          form label, which must stay "Copy".
                          Also gated on can_copy_board now, so an uncopyable or
                          for-sale board no longer offers a copy that cannot happen. --}}
                    {{#unless (get this.speak_menu_hidden_set "copy")}}
                      {{#if this.can_copy_board}}
                        <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="make_a_copy" {{on "click" (this.ctrlAction "make_a_copy")}}
                          title={{t "Make your own copy of this board set" key="board_detail_copy_board_tooltip"}}>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                          </svg>
                          <span>{{t "Make a Copy" key="board_detail_copy_board"}}</span>
                        </button>
                      {{/if}}
                    {{/unless}}
                    {{#unless (get this.speak_menu_hidden_set "download")}}
                      <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="download_board" {{on "click" (this.ctrlAction "download_board")}}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                          <polyline points="7 10 12 15 17 10"/>
                          <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span>{{t "Download" key="download"}}</span>
                      </button>
                    {{/unless}}
                    {{#unless (get this.speak_menu_hidden_set "print")}}
                      <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="print_board" {{on "click" (this.ctrlAction "print_board")}}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polyline points="6 9 6 2 18 2 18 9"/>
                          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                          <rect x="6" y="14" width="12" height="8"/>
                        </svg>
                        <span>{{t "Print" key="print"}}</span>
                      </button>
                    {{/unless}}
                    {{#unless (get this.speak_menu_hidden_set "share")}}
                      <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="share_board" {{on "click" (this.ctrlAction "share_board")}}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="18" cy="5" r="3"/>
                          <circle cx="6" cy="12" r="3"/>
                          <circle cx="18" cy="19" r="3"/>
                          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                        </svg>
                        <span>{{t "Share" key="share"}}</span>
                      </button>
                    {{/unless}}
                  </div>
                {{/if}}
              </div>
              {{/if}}

              {{!-- Session Section — moved ABOVE the Translate row per
                   request, so the menu reads:
                   …Share & Print → Session → Translate → Exit.
                   Whole section hides when all children are hidden
                   via Customize Menu. --}}
              {{#if this.speak_section_visible_session}}
              <div class="md-board-detail-actions-menu__section">
                <div class="md-board-detail-actions-menu__submenu-wrap">
                  <button type="button" class="md-board-detail-actions-menu__item md-board-detail-actions-menu__item--has-sub" data-bd-action="toggle_session_submenu" {{on "click" (this.ctrlAction "toggle_session_submenu")}}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <span>{{t "Session" key="session"}}</span>
                    <svg class="md-board-detail-actions-menu__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                  {{#if this.session_submenu_open}}
                    <div class="md-board-detail-actions-menu__submenu">
                      {{!-- Button Levels — collapsible row inside Session.
                           Tapping expands a nested level grid (1-10)
                           that lets any speak-mode viewer change the
                           board's display level. Writes to
                           stashes.board_level via set_speak_level so
                           board/index.js#current_level re-renders the
                           grid. The icon mirrors the right-panel
                           Button Levels accordion: three ascending
                           bars (currentColor for menu inheritance). --}}
                      {{#unless (get this.speak_menu_hidden_set "button_levels")}}
                      <button type="button" class="md-board-edit-panel__row md-board-detail-actions-menu__item md-board-detail-actions-menu__item--has-sub" aria-expanded={{if this.levels_submenu_open "true" "false"}} data-bd-action="toggle_levels_submenu" {{on "click" (this.ctrlAction "toggle_levels_submenu")}}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="3"  y="14" width="4" height="7"  rx="0.5"/>
                          <rect x="10" y="9"  width="4" height="12" rx="0.5"/>
                          <rect x="17" y="4"  width="4" height="17" rx="0.5"/>
                        </svg>
                        <span>{{t "Button Levels" key="button_levels"}}</span>
                        <svg class="md-board-detail-actions-menu__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                      </button>
                      {{#if this.levels_submenu_open}}
                        <div class="md-board-detail-actions-menu__submenu" style="padding: 10px 14px;">
                          {{!-- 5 columns × 2 rows; each tile is a
                               square (aspect-ratio 1) at a 44×44 min
                               so the touch target meets accessibility
                               minimums. Glossy treatment: top white
                               highlight + bottom darken via inset
                               box-shadows, gradient sheen on the
                               background, optional backdrop-blur for
                               translucent look. --}}
                          <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px;">
                            {{#each this.speak_level_options as |lvl|}}
                              <button type="button" aria-label={{lvl}}
                                style={{safe-style (concat "display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1; min-width: 44px; min-height: 44px; padding: 0; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 15px; line-height: 1; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); transition: transform 0.08s ease, box-shadow 0.12s ease, background 0.12s ease; " (if (is-equal this.current_speak_level lvl) (concat "border: 1.5px solid " (get this.level_color_map lvl) "AA; background: linear-gradient(180deg, " (get this.level_color_map lvl) "B3 0%, " (get this.level_color_map lvl) "80 100%), #111A2E; color: #fff; box-shadow: inset 0 1px 0 rgba(255,255,255,0.20), inset 0 -1px 0 rgba(0,0,0,0.08);") (concat "border: 1.5px solid " (get this.level_color_map lvl) "55; background: linear-gradient(180deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.01) 100%), #111A2E; color: " (get this.level_color_map lvl) "D9; box-shadow: inset 0 1px 0 rgba(255,255,255,0.10);")))}}
                                {{on "click" (this.ctrlAction "set_speak_level" lvl)}}>
                                {{lvl}}
                              </button>
                            {{/each}}
                          </div>
                        </div>
                      {{/if}}
                      {{/unless}}
                      {{#unless this.app_state.superProtectedSpeakMode}}
                        {{!-- Board lock. MUST stay reachable here: board-detail ENFORCES
                              stashes.sticky_board on both folder navigation and back
                              navigation (board-detail.js toggle_board / activate_button),
                              warning "Board lock is enabled, disable to leave this board."
                              sticky_board is a PERSISTED stash and can be switched on from
                              the classic speak menu, so without this control a user could
                              arrive here locked, be told to disable it, and have nothing to
                              disable it with. --}}
                        {{#if this.board_lock_control_visible}}
                        {{#if this.stashes.sticky_board}}
                          <button type="button" class="md-board-detail-actions-menu__item" aria-pressed="true" data-bd-action="toggle_sticky_board" {{on "click" (this.ctrlAction "toggle_sticky_board")}}>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            <span>{{t "Release Board Lock" key="release_board_lock"}}</span>
                          </button>
                        {{else}}
                          <button type="button" class="md-board-detail-actions-menu__item" aria-pressed="false" data-bd-action="toggle_sticky_board" {{on "click" (this.ctrlAction "toggle_sticky_board")}}>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 5-5 5 5 0 0 1 5 5v4"/>
                            </svg>
                            <span>{{t "Stay on this Board" key="stay_on_board"}}</span>
                          </button>
                        {{/if}}
                        {{/if}}
                        {{#unless (get this.speak_menu_hidden_set "pause_logging")}}
                        {{#if this.app_state.currentUser.preferences.logging}}
                          <PauseLoggingButton @paused={{this.app_state.logging_paused}} @onToggle={{this.ctrlAction "toggle_pause_logging"}} />
                        {{/if}}
                        {{/unless}}
                      {{/unless}}
                      {{#unless (get this.speak_menu_hidden_set "modeling")}}
                      <button type="button" class="md-board-detail-actions-menu__item" aria-pressed={{if this.app_state.modeling "true" "false"}} data-bd-action="toggle_modeling" {{on "click" (this.ctrlAction "toggle_modeling")}}>
                        {{#if this.app_state.modeling}}
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                            <path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4" stroke="currentColor" stroke-width="2"/><line x1="10" y1="1" x2="10" y2="4" stroke="currentColor" stroke-width="2"/><line x1="14" y1="1" x2="14" y2="4" stroke="currentColor" stroke-width="2"/>
                          </svg>
                          <span>{{t "Stop Modeling" key="board_detail_stop_modeling"}}</span>
                        {{else}}
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/>
                          </svg>
                          <span>{{t "Model for Communicator" key="board_detail_model_for_communicator"}}</span>
                        {{/if}}
                      </button>
                      {{/unless}}
                      {{#unless (get this.speak_menu_hidden_set "switch_communicators")}}
                      {{#unless this.app_state.eval_mode}}
                        {{#if this.app_state.sessionUser.supervisees}}
                          {{#if this.app_state.currentUser.permissions.delete}}
                            <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="switch_communicators" {{on "click" (this.ctrlAction "switch_communicators")}}>
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                              </svg>
                              <span>{{t "Switch Communicators" key="switch_communicators"}}</span>
                            </button>
                          {{/if}}
                        {{/if}}
                      {{/unless}}
                      {{/unless}}
                    </div>
                  {{/if}}
                </div>
              </div>
              {{/if}}

              {{!-- Pause Logging, for a communicator-only account.

                   The row proper lives in the Session submenu just above, and
                   speak_section_visible_session returns false for a communicator-only
                   account before it considers any single item (board-detail.js:4321) —
                   deliberately, because the board lock lives in that section and a locked
                   communicator must not be able to release it. So the item is offered here
                   instead, as its own top-level row: the classic speak menu
                   (application.hbs:1239) has always offered it to communicators with no role
                   gate, and this restores that parity without opening the Session section.

                   pause_logging_row_visible carries the whole condition — communicator-only,
                   not super-protected, logging enabled, not hidden in the Customize Menu.
                   Top-level rather than in a submenu, so it needs no expanding. --}}
              {{#if this.pause_logging_row_visible}}
              <div class="md-board-detail-actions-menu__section">
                <PauseLoggingButton @paused={{this.app_state.logging_paused}} @onToggle={{this.ctrlAction "toggle_pause_logging"}} />
              </div>
              {{/if}}

              {{!-- Translate Section — language tools, below Session per the menu order
                   (…Share & Print → Session → Translate → Exit). Both actions live on the
                   controller: translate_board opens the translation-select modal, switch_languages
                   opens the switch-languages modal (see board-detail.js). The submenu toggles on
                   language_submenu_open (toggle_language_submenu). Reuses the shared section-toggle
                   / submenu classes; dispatched in speak mode via the generic data-bd-action path
                   in raw_events. Hidden on communicator-only accounts (a setup tool). --}}
              {{#unless this.is_communicator_only_account}}
              <div class="md-board-detail-actions-menu__section">
                <button type="button" class="md-board-detail-actions-menu__item md-board-detail-actions-menu__item--has-sub md-board-detail-actions-menu__section-toggle" aria-expanded={{if this.language_submenu_open "true" "false"}} data-bd-action="toggle_language_submenu" {{on "click" (this.ctrlAction "toggle_language_submenu")}}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                  <span>{{t "Translate" key="translate"}}</span>
                  <svg class="md-board-detail-actions-menu__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                {{#if this.language_submenu_open}}
                  <div class="md-board-detail-actions-menu__submenu">
                    <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="translate_board" {{on "click" (this.ctrlAction "translate_board")}}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>
                      </svg>
                      <span>{{t "Translate Boards" key="translate_boards"}}</span>
                    </button>
                    <button type="button" class="md-board-detail-actions-menu__item" data-bd-action="switch_languages" {{on "click" (this.ctrlAction "switch_languages")}}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                      </svg>
                      <span>{{t "Switch Languages" key="switch_languages"}}</span>
                    </button>
                  </div>
                {{/if}}
              </div>
              {{/unless}}

              {{!-- Take a tour — moved to the bottom (just above Exit). The ONLY
                   entry point for the speak-mode guided tour (the runner host near
                   the top of the page is hidden). Triggers
                   controllers/user/board-detail#start_speak_tour. Behind the
                   home_tour flag; hidden on a communicator-only account
                   (is_communicator_only_account), matching the Session section. --}}
              {{#if this.app_state.feature_flags.home_tour}}
                {{#unless this.is_communicator_only_account}}
                <div class="md-board-detail-actions-menu__section">
                  <button type="button" class="md-board-detail-actions-menu__item" {{on "click" (this.ctrlAction "start_speak_tour")}}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
                      <line x1="8" y1="2" x2="8" y2="18"/>
                      <line x1="16" y1="6" x2="16" y2="22"/>
                    </svg>
                    <span>{{t "Take a tour" key="home_tour_trigger_label"}}</span>
                  </button>
                </div>
                {{/unless}}
              {{/if}}

              <div class="md-board-detail-actions-menu__section">
                <button type="button" class="md-board-detail-actions-menu__item md-board-detail-actions-menu__item--exit" data-bd-action="exit_to_home" {{on "click" (this.ctrlAction "exit_to_home")}}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>
                  </svg>
                  <div>
                    <span>{{t "Exit Boards" key="exit_boards"}}</span>
                    <span class="md-board-detail-actions-menu__hint">{{t "To Home Page" key="to_home_page"}}</span>
                  </div>
                </button>
              </div>
            {{/unless}}
          </div>
        {{/if}}
      </div>
      </div>
      {{!-- tease-row removed: collapse btn moved to sentence row, sidebar toggle moved to actions-wrap --}}

      {{!-- Word suggestions now render inline inside the sentence bar above --}}

      {{!-- Board Search Filter moved to edit toolbar Filter section --}}

      {{!-- Saving overlay — full-screen fixed overlay with backdrop blur
           that freezes the edit page in place while the save round-trip
           completes. Mirrors the loading-overlay UX used elsewhere in
           the app (e.g. login). The route transition out of edit mode
           is deferred until save + fetch resolve, so the user never
           sees a half-rendered speak-mode view during the save. --}}
      {{#if this.board_saving}}
        <div class="md-board-detail-loading md-board-detail-loading--overlay" role="status" aria-live="polite">
          <div class="md-board-detail-loading__card">
            <div class="md-board-detail-loading__spinner"></div>
            <span class="md-board-detail-loading__text">{{t "Saving Changes..." key="board_detail_saving_changes"}}</span>
          </div>
        </div>
      {{/if}}

      {{!-- Board Title --}}
      <header class="md-board-detail-header">
        {{!-- Collapse mid-section: visible when expanded; hidden along with the
             header when board_collapsed is true (rule in app.scss). --}}
        <button type="button"
          class="md-board-detail-collapse-btn md-board-detail-collapse-btn--mid-top"
          title={{t "Collapse Mid Panel" key="board_detail_collapse_mid_panel"}}
          aria-label={{t "Collapse Mid Panel" key="board_detail_collapse_mid_panel"}}
          data-bd-action="toggle_board_collapsed" {{on "click" (this.ctrlAction "toggle_board_collapsed")}}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="18 15 12 9 6 15"/>
          </svg>
        </button>
        <div class="md-board-detail-header__row">
          <div class="md-board-detail-header__title-group">
            {{#unless this.edit_mode}}
              <div class="md-board-detail-nav-btns">
                {{#if this.show_board_back_nav}}
                  <button type="button"
                    class="md-board-detail-nav-btn"
                    title={{t "Go back" key="board_detail_go_back"}}
                    aria-label={{t "Go back" key="board_detail_go_back"}}
                    data-bd-action="go_back" {{on "click" (this.ctrlAction "go_back")}}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="15 18 9 12 15 6"/>
                    </svg>
                  </button>
                {{/if}}
              </div>
            {{/unless}}
            {{#if this.board_image_url}}
              {{!-- View mode: board icon sits outside the header content
                   block, alongside the title group. In edit mode it
                   moves inside the unified edit-card title row (below). --}}
              {{#unless this.edit_mode}}
                <img src={{this.board_image_url}} alt={{t "Board icon" key="board_detail_board_icon_alt"}} class="md-board-detail-header__board-icon">
              {{/unless}}
            {{/if}}
            <div class="md-board-detail-header__title-col">
              {{#if this.edit_mode}}
                {{!-- Edit-mode header: a single visually-unified card
                     (same glass styling as the prior info-panel) that
                     groups the Board icon, Title, Editing badge
                     (centered), action checklist, and the always-visible
                     description editor. The Board Description toggle is
                     gone — its content is shown unconditionally. The
                     privacy pill + license icon both park at the right
                     end of the title row so the title and its
                     attribution state read as one unit. --}}
                {{!-- Editing pill — rendered OUTSIDE the edit card, centered
                     in the row ABOVE it, so it reads as a top-center page
                     badge on all screen sizes (was an absolutely-centered
                     column inside the title row, which overlapped the
                     title). --}}
                {{!-- Unified EDITING SESSION BAR — replaces the floating "Editing"
                     pill AND the detached Discard/Save tiles (relocated here from the
                     title row). Spans the top of the editing region: a clear "you are
                     editing" state on the left, the completion actions on the right —
                     so how to FINISH editing is unmistakable. "Save" is the
                     primary (filled) action; "Cancel" is the quiet secondary. --}}
                <div class="md-board-edit-session" role="region" aria-label={{t "Editing session" key="board_detail_editing_session"}}>
                  <div class="md-board-edit-session__state">
                    {{!-- The board icon + name (was a pencil icon + "Editing Board")
                         so the sticky session bar always shows WHICH board you're
                         editing. --}}
                    {{#if this.board_image_url}}
                      <img src={{this.board_image_url}} alt={{t "Board icon" key="board_detail_board_icon_alt"}} class="md-board-edit-session__board-icon">
                    {{/if}}
                    <span class="md-board-edit-session__state-label md-board-edit-session__board-title" role="status">{{this.title}}</span>
                    {{!-- Rename affordance — opens the existing Edit Board Details
                         modal (name, description, icon, license, language,
                         visibility) straight from the title, instead of the
                         Board Actions → Edit Board Details → modal detour.
                         Same action the Board Actions row ultimately reaches
                         (edit_board_details). Carries data-bd-action so touch,
                         dwell and eye-gaze releases route through raw_events
                         like the rest of the board-detail chrome. --}}
                    <button type="button" class="md-board-edit-session__title-edit" data-bd-action="edit_board_details" {{on "click" (this.ctrlAction "edit_board_details")}} aria-label={{t "Edit Board Details" key="edit_board_details"}} title={{t "Edit Board Details" key="edit_board_details"}}>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke="#46505F"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke="#2A9D8F"/>
                      </svg>
                    </button>
                    {{#if this.is_copy_on_save}}
                      <span class="md-board-edit-session__badge md-board-edit-session__badge--copying">{{t "Creating a Copy of This Board" key="board_detail_creating_copy_badge"}}</span>
                    {{/if}}
                  </div>
                  {{!-- Top-center status badge — styled like the Take-a-tour glass pill
                       but non-interactive (a status indicator, not a button). Absolutely
                       centered in the sticky session bar = top-center of the edit page.
                       Reads "Editing" (pencil) normally, but flips to "Previewing" (eye)
                       while the Board Collections drawer is open, since the center is
                       showing a browsed board rather than the one being edited. --}}
                  <span class="md-board-detail-edit-pill" role="status" aria-label={{if this.edit_board_collection_open (t "Previewing" key="board_detail_previewing") (t "Editing" key="board_detail_editing")}}>
                    {{#if this.edit_board_collection_open}}
                      <svg class="md-board-detail-edit-pill__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="#46505F"/>
                        <circle cx="12" cy="12" r="3" stroke="#2A9D8F"/>
                      </svg>
                      <span class="md-board-detail-edit-pill__label">{{t "Previewing" key="board_detail_previewing"}}</span>
                    {{else}}
                      <svg class="md-board-detail-edit-pill__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke="#46505F"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke="#2A9D8F"/>
                      </svg>
                      <span class="md-board-detail-edit-pill__label">{{t "Editing" key="board_detail_editing"}}</span>
                    {{/if}}
                  </span>
                  <div class="md-board-edit-session__actions">
                    {{!-- Exit to Home — a quiet text link, not a third button, so it
                         reads as a way OUT of editing rather than a competing
                         completion action beside Cancel/Save. Routes through
                         exit_to_home_from_edit (not exit_to_home) so it confirms
                         discard first, exactly like Cancel — see the controller. --}}
                    <button type="button"
                      class="md-board-edit-session__exit-link"
                      disabled={{this.board_saving}}
                      data-bd-action="exit_to_home_from_edit" {{on "click" (this.ctrlAction "exit_to_home_from_edit")}}>
                      {{!-- Two-tone in the house pair used everywhere else for this
                           glyph (slate roof, verdigris body) — see the getting-started
                           home icon in create-board-new.hbs and the pencil/report icons
                           in this file. Explicit strokes, NOT currentColor, so the icon
                           keeps both tones while the label alone follows the link colour. --}}
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 12 12 3l9 9" stroke="#46505F"/>
                        <path d="M5 10v10a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1V10" stroke="#2A9D8F"/>
                      </svg>
                      <span class="md-board-edit-session__exit-link-label">{{t "Exit to Home" key="board_detail_exit_to_home"}}</span>
                    </button>
                    <button type="button"
                      class="md-board-edit-session__btn md-board-edit-session__btn--discard"
                      disabled={{this.board_saving}}
                      data-bd-action="cancel_edit" {{on "click" (this.ctrlAction "cancel_edit")}}>
                      <span class="md-board-edit-session__btn-badge" aria-hidden="true">
                        {{!-- Two-tone X-in-circle for the glassy centre: medium-slate
                             disc (reads on the dark surface) + light-mint X (contrast
                             against the disc). --}}
                        <svg class="md-board-edit-session__btn-icon" viewBox="0 0 24 24" fill="none">
                          <circle cx="12" cy="12" r="9" fill="#6b7888"/>
                          <path d="M15 9 9 15" stroke="#b9e8e0" stroke-width="2" stroke-linecap="round"/>
                          <path d="M9 9l6 6" stroke="#b9e8e0" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                      </span>
                      <span class="md-board-edit-session__btn-label">{{t "Cancel" key="cancel"}}</span>
                    </button>
                    <button type="button"
                      class="md-board-edit-session__btn md-board-edit-session__btn--save {{if this.board_saving 'is-saving'}}"
                      disabled={{this.board_saving}}
                      data-bd-action="back_to_boards" {{on "click" (this.ctrlAction "back_to_boards")}}>
                      {{!-- Raised circular icon badge: a teal ring around a glossy
                           light face (see .md-board-edit-session__btn-badge). --}}
                      <span class="md-board-edit-session__btn-badge" aria-hidden="true">
                        {{!-- Two-tone check, light tones so it reads on the glassy
                             centre over the slate button: light short arm, teal long arm. --}}
                        <svg class="md-board-edit-session__btn-icon" viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17.5" stroke="#cdd6e3"/><path d="M10 17.5 19 7" stroke="#8fe4df"/></svg>
                      </span>
                      <span class="md-board-edit-session__btn-label">{{t "Save" key="board_detail_save"}}</span>
                    </button>
                  </div>
                </div>
                {{!-- Board-details edit-card removed: the session bar above now
                     carries the board identity (icon + title), and description /
                     privacy / license editing lives in the "Edit Board Details"
                     Board Action. --}}
              {{else}}
                <div class="md-board-detail-header__title-row">
                  <span class="md-board-detail-header__title">{{this.title}}</span>
                  {{!-- Board Description expander — pill styled to mirror
                       the edit toolbar's "More Settings" affordance:
                       chevron + label in a glass pill, chevron rotates
                       180° when the description info panel is open. --}}
                  <button type="button" class="md-board-detail-header__info-toggle {{if this.description_info_expanded 'md-board-detail-header__info-toggle--open'}}" data-bd-action="toggle_description_info" {{on "click" (this.ctrlAction "toggle_description_info")}} aria-expanded={{if this.description_info_expanded "true" "false"}} aria-label={{t "Board Description" key="board_description"}} title={{t "Board Description" key="board_description"}}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                    <span class="md-board-detail-header__info-toggle-label">{{t "Board Description" key="board_description"}}</span>
                  </button>
                </div>
                {{#if this.subtitle}}
                  <p class="md-board-detail-header__sub {{unless this.description_expanded 'md-board-detail-header__sub--collapsed'}}">{{this.subtitle}}</p>
                  {{#if this.subtitle_is_long}}
                    <button type="button"
                      class="md-board-detail-header__expand-link {{if this.description_expanded 'md-board-detail-header__expand-link--open'}}"
                      aria-expanded={{if this.description_expanded "true" "false"}}
                      data-bd-action="toggle_description" {{on "click" (this.ctrlAction "toggle_description")}}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"/>
                      </svg>
                      <span>{{t "Board Description" key="board_description"}}</span>
                    </button>
                  {{/if}}
                {{/if}}
                {{#if this.description_info_expanded}}
                  <div class="md-board-detail-header__info-panel" role="region" aria-label={{t "Board details" key="board_detail_info_panel"}}>
                    {{#if this.has_info_icons}}
                      <div class="md-board-detail-header__info-icons">
                        {{#if this.model.protected_material}}
                          <span class="md-board-detail-header__info-icon md-board-detail-header__info-icon--lock" title={{t "Protected material" key="protected_material"}} aria-label={{t "Protected material" key="protected_material"}}>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            <span class="md-board-detail-header__info-icon-label">{{t "Protected" key="protected"}}</span>
                          </span>
                        {{else if this.model.public}}
                          {{#if this.model.permissions.edit}}
                            <button type="button" class="md-board-detail-header__info-icon md-board-detail-header__info-icon--public md-board-detail-header__info-icon--clickable" title={{t "Public board — click to change privacy" key="public_board_click_to_change"}} aria-label={{t "Public board — click to change privacy" key="public_board_click_to_change"}} data-bd-action="open_board_privacy" {{on "click" (this.ctrlAction "open_board_privacy")}}>
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="2" y1="12" x2="22" y2="12"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                              </svg>
                              <span class="md-board-detail-header__info-icon-label">{{t "Public" key="public"}}</span>
                            </button>
                          {{else}}
                            <span class="md-board-detail-header__info-icon md-board-detail-header__info-icon--public" title={{t "Public board" key="public_board"}} aria-label={{t "Public board" key="public_board"}}>
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="2" y1="12" x2="22" y2="12"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                              </svg>
                              <span class="md-board-detail-header__info-icon-label">{{t "Public" key="public"}}</span>
                            </span>
                          {{/if}}
                        {{else if this.model.permissions.edit}}
                          <button type="button" class="md-board-detail-header__info-icon md-board-detail-header__info-icon--private md-board-detail-header__info-icon--clickable" title={{t "Private board — click to change privacy" key="private_board_click_to_change"}} aria-label={{t "Private board — click to change privacy" key="private_board_click_to_change"}} data-bd-action="open_board_privacy" {{on "click" (this.ctrlAction "open_board_privacy")}}>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                              <circle cx="12" cy="12" r="3"/>
                              <line x1="4" y1="20" x2="20" y2="4"/>
                            </svg>
                            <span class="md-board-detail-header__info-icon-label">{{t "Private" key="private"}}</span>
                          </button>
                        {{else}}
                          <span class="md-board-detail-header__info-icon md-board-detail-header__info-icon--private" title={{t "Private board" key="private_board"}} aria-label={{t "Private board" key="private_board"}}>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                              <circle cx="12" cy="12" r="3"/>
                              <line x1="4" y1="20" x2="20" y2="4"/>
                            </svg>
                            <span class="md-board-detail-header__info-icon-label">{{t "Private" key="private"}}</span>
                          </span>
                        {{/if}}
                        {{#if this.cc_license}}
                          <img src={{path "images/cc.png"}} alt={{t "Creative Commons license" key="cc_license_label"}} class="md-board-detail-header__license-icon">
                        {{else if this.pd_license}}
                          <img src={{path "images/pd.png"}} alt={{t "Public Domain" key="pd_license_label"}} class="md-board-detail-header__license-icon">
                        {{/if}}
                      </div>
                    {{/if}}
                    {{#if this.model.description}}
                      <p class="md-board-detail-header__info-description">{{this.model.description}}</p>
                    {{else}}
                      <p class="md-board-detail-header__info-description md-board-detail-header__info-description--empty">{{t "No description provided for this board." key="board_detail_no_description"}}</p>
                    {{/if}}
                  </div>
                {{/if}}
              {{/if}}
            </div>
          </div>
          {{!-- Removed in edit mode: the right-side board-actions wrap
               (quick-actions icon row + Details & Actions dropdown).
               Every action — share_board, make_a_copy, print_board,
               download_board, board_details, set_as_home,
               add_to_sidebar, toggle_favorite, other_board_actions —
               is now reachable from the left edit panel (BOARD
               DETAILS group + SHARE & EXPORT tile grid). --}}
          {{#unless this.edit_mode}}
            <div class="md-board-detail-header__actions">
              <button type="button"
                class="md-board-detail-quick-toggle {{if this.show_quick_phrases 'md-board-detail-quick-toggle--active'}}"
                data-bd-action="toggle_quick_phrases" {{on "click" (this.ctrlAction "toggle_quick_phrases")}}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <span>{{t "Quick Phrases" key="board_detail_quick_phrases_label"}}</span>
                <svg class="md-board-detail-quick-toggle__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <button type="button"
                class="md-board-detail-quick-toggle md-board-detail-quick-toggle--categories {{if this.show_categories 'md-board-detail-quick-toggle--active'}}"
                data-bd-action="toggle_categories" {{on "click" (this.ctrlAction "toggle_categories")}}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                <span>{{t "Categories" key="board_detail_categories_label"}}</span>
                <svg class="md-board-detail-quick-toggle__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <button type="button"
                class="md-board-detail-color-legend-toggle {{if this.show_color_legend 'md-board-detail-color-legend-toggle--active'}}"
                data-bd-action="toggle_color_legend" {{on "click" (this.ctrlAction "toggle_color_legend")}}
                title={{t "Color key — see what each button color means" key="board_detail_color_key_tooltip"}}>
                <span class="md-board-detail-color-legend-toggle__icon" aria-hidden="true">&#x1F3A8;</span>
                <span class="md-board-detail-color-legend-toggle__label">{{t "Color Key" key="board_detail_color_key"}}</span>
              </button>
              {{!-- Set as Home / Make a Copy are NOT here. They were added to this
                    header on 2026-08-23 and browser-verification showed they never
                    rendered: this header is inside .md-board-detail-header, which
                    .md-shell--board-collapsed hides outright (app.scss:76138), and
                    `board_collapsed` defaults to true in view mode
                    (controllers/user/board-detail.js:267) — it is set false ONLY on
                    entering edit mode. The one control that expands it,
                    toggle_board_collapsed, sits inside the hidden header itself, so
                    a view-mode user cannot reveal it. Putting view-mode actions here
                    just swaps a Handlebars edit-mode gate for a CSS one. They now
                    live in the options menu, which stays visible in view mode. --}}
              {{#if this.can_edit_or_copy_board}}
                <button type="button" class="md-board-detail-edit-btn" data-bd-action="enter_edit_mode" {{on "click" (this.ctrlAction "enter_edit_mode")}}>
                  <svg class="md-board-detail-edit-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                  <span class="md-board-detail-edit-btn__label">{{t "Edit Board" key="board_detail_edit_board"}}</span>
                </button>
              {{/if}}
            </div>
          {{/unless}}
        </div>

        {{#if this.show_color_legend}}
          <div class="md-board-detail-color-legend" role="region" aria-label={{t "Button color legend" key="board_detail_color_legend"}}>
            <div class="md-board-detail-color-legend__grid">
              {{#each this.color_legend_items as |item|}}
                <div class="md-board-detail-color-legend__item">
                  {{#if (is-equal item.css_class "folder")}}
                    <span class="md-board-detail-color-legend__folder-wrap">
                      <span class="md-folder-back"><span class="md-folder-tab"></span></span>
                      <span class="md-board-detail-color-legend__swatch md-board-detail-symbol-card--folder"></span>
                    </span>
                  {{else}}
                    <span class="md-board-detail-color-legend__swatch md-board-detail-symbol-card--{{item.css_class}}"></span>
                  {{/if}}
                  <div class="md-board-detail-color-legend__info">
                    <span class="md-board-detail-color-legend__type">{{item.type}}</span>
                    <span class="md-board-detail-color-legend__parts">{{item.parts}}</span>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        {{/if}}
      </header>

      {{!-- Edit Mode Toolbar — two mutually-exclusive content sets share one
           toolbar container: normal edit controls when the settings gear is
           off, and the display-settings controls when it's on. The
           over-arching actions (Settings/Save/Cancel) render in a centered
           dock ABOVE the toolbar. --}}
      {{!-- Edit Mode Toolbar removed in favor of the right-side edit
           panel (paint, hide, recolor, settings) and bottom toolbar
           (undo/redo). The legacy 700+ line inline toolbar block from
           earlier staging branches is intentionally absent here. --}}


      {{!-- Toolbar row: filter chip + reveal panels (Quick Phrases / Categories
           toggles moved into the header actions row above). --}}
      <div class="md-board-detail-toolbar">
        <div class="md-board-detail-quick-wrap">
          {{#if this.active_filter_label}}
            <span class="md-board-detail-filter-chip">
              {{#if this.active_filter_css}}
                <span class="md-board-detail-filter-chip__swatch md-board-detail-symbol-card--{{this.active_filter_css}}"></span>
              {{/if}}
              <span class="md-board-detail-filter-chip__label">{{this.active_filter_label}}</span>
              <button type="button" class="md-board-detail-filter-chip__clear" {{on "click" (this.ctrlAction "set_category" "all")}} title={{t "Clear filter" key="board_detail_clear_filter"}} aria-label={{t "Clear filter" key="board_detail_clear_filter"}}>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </span>
          {{/if}}

          {{#if this.show_categories}}
            <div class="md-board-detail-cat-panel" role="toolbar" aria-label={{t "Symbol categories" key="board_detail_symbol_categories"}}>
              <div class="md-board-detail-cat-panel__left">
                <button type="button"
                  class="md-board-detail-quick-reveal__btn {{if (is-equal 'all' this.active_category) 'md-board-detail-quick-reveal__btn--active'}}"
                  {{on "click" (this.ctrlAction "set_category" "all")}}>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                  <span class="md-board-detail-quick-reveal__btn-label">{{t "All" key="category_all"}}</span>
                </button>
                <button type="button"
                  class="md-board-detail-quick-reveal__btn {{if (is-equal 'folder' this.active_category) 'md-board-detail-quick-reveal__btn--active'}}"
                  {{on "click" (this.ctrlAction "set_category" "folder")}}>
                  <span class="md-board-detail-quick-reveal__swatch md-board-detail-symbol-card--folder"></span>
                  <span class="md-board-detail-quick-reveal__btn-label">{{t "Folders" key="category_folders"}}</span>
                </button>
              </div>
              <div class="md-board-detail-cat-panel__divider"></div>
              <div class="md-board-detail-cat-panel__right">
                {{#each this.pos_type_categories as |cat|}}
                  <button type="button"
                    class="md-board-detail-quick-reveal__btn {{if (is-equal cat.id this.active_category) 'md-board-detail-quick-reveal__btn--active'}}"
                    {{on "click" (this.ctrlAction "set_category" cat.id)}}>
                    <span class="md-board-detail-quick-reveal__swatch md-board-detail-symbol-card--{{cat.css_class}}"></span>
                    <span class="md-board-detail-quick-reveal__btn-label">{{cat.label}}</span>
                  </button>
                {{/each}}
              </div>
            </div>
          {{/if}}

          {{!-- Quick Phrases content (non-edit mode, full width) --}}
          {{#unless this.edit_mode}}
            {{#if this.show_quick_phrases}}
              <div class="md-board-detail-quick-reveal" role="toolbar" aria-label={{t "Quick phrases" key="board_detail_quick_phrases"}}>
                {{#each this.quick_buttons as |qb|}}
                  <button type="button" class="md-board-detail-quick-reveal__btn" {{on "click" (this.ctrlAction "select_quick" qb)}}>
                    <span class="md-board-detail-quick-reveal__btn-icon" aria-hidden="true">{{qb.icon}}</span>
                    <span class="md-board-detail-quick-reveal__btn-label">{{qb.label}}</span>
                  </button>
                {{/each}}
              </div>
            {{/if}}
          {{/unless}}
        </div>

      </div>

      <div class="md-board-detail-divider"></div>

      {{!-- Saving indicator now lives above the header (top of page). --}}


      {{!-- Grid + Sidebar wrapper --}}
      <div class="md-board-detail-grid-sidebar-wrap">

      {{#if (is-equal this.active_view "phrase-builder")}}
        {{!-- =========================================================
              Phrase Builder view: search-driven button finder
              ========================================================= --}}
        <section class="md-board-detail-phrase-builder" aria-label={{t "Phrase builder" key="board_detail_phrase_builder"}}>
          <header class="md-board-detail-phrase-builder__header">
            <div class="md-board-detail-phrase-builder__title-row">
              <h2 class="md-board-detail-phrase-builder__title">{{t "Phrase Builder" key="board_detail_phrase_builder_title"}}</h2>
              <p class="md-board-detail-phrase-builder__hint">{{t "Search for words to add to your message" key="board_detail_phrase_builder_hint"}}</p>
            </div>
            <div class="md-board-detail-phrase-builder__search">
              <span class="md-board-detail-phrase-builder__search-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </span>
              <input type="text" value={{this.phrase_search}} id="bd-phrase-builder-search" name="bd-phrase-builder-search" class="md-board-detail-phrase-builder__input" placeholder={{t "Type a word or a full sentence…" key="board_detail_phrase_builder_placeholder"}} aria-label={{t "Search for buttons or type a sentence" key="board_detail_search_buttons_aria"}} autocomplete="off" autocorrect="off" spellcheck="false" {{on "input" (set-field this "phrase_search")}} />
              {{#if this.has_phrase_search}}
                <button type="button" class="md-board-detail-phrase-builder__clear" data-bd-action="clear_phrase_search" {{on "click" (this.ctrlAction "clear_phrase_search")}} aria-label={{t "Clear search" key="board_detail_clear_search"}}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              {{/if}}
            </div>
            {{#unless this.phrase_loading}}
              {{#if this.has_phrase_search}}
                {{#if this.phrase_sentence_mode}}
                  <p class="md-board-detail-phrase-builder__count">
                    {{t "Building phrase from sentence" key="board_detail_phrase_sentence_mode"}}
                  </p>
                {{else}}
                  <p class="md-board-detail-phrase-builder__count">
                    {{#if this.phrase_results.length}}
                      {{t "%{n} matches across this board and linked sub-boards" n=this.phrase_results.length key="board_detail_phrase_n_matches"}}
                    {{else}}
                      {{t "No matches" key="board_detail_phrase_no_matches"}}
                    {{/if}}
                  </p>
                {{/if}}
              {{else if this.phrase_all_buttons.length}}
                <p class="md-board-detail-phrase-builder__count">
                  {{t "%{n} buttons · alphabetical · type a sentence to build a phrase" n=this.phrase_all_buttons.length key="board_detail_phrase_n_total_with_hint"}}
                </p>
              {{/if}}
            {{/unless}}
          </header>

          <div class="md-board-detail-phrase-builder__results">
            {{#if this.phrase_loading}}
              <div class="md-board-detail-phrase-builder__loading">
                <div class="md-loading-spinner"></div>
                {{#if this.has_phrase_search}}
                  <p>{{t "Searching…" key="board_detail_phrase_searching"}}</p>
                {{else}}
                  <p>{{t "Loading buttons from this board and all linked sub-boards…" key="board_detail_phrase_loading_buttons"}}</p>
                {{/if}}
              </div>
            {{else if this.phrase_search_error}}
              <div class="md-board-detail-phrase-builder__empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <p>{{this.phrase_search_error}}</p>
              </div>
            {{else if this.has_phrase_search}}
              {{#if this.phrase_sentence_mode}}
                {{!-- Sentence mode: one chip per typed word, in order, with an Add All button --}}
                <div class="md-board-detail-phrase-builder__sentence">
                  <div class="md-board-detail-phrase-builder__sentence-row">
                    {{#each this.phrase_results as |btn index|}}
                      {{#if index}}
                        <span class="md-board-detail-phrase-builder__sentence-sep" aria-hidden="true">→</span>
                      {{/if}}
                      {{#if btn.is_match}}
                        <button type="button"
                          class="md-board-detail-phrase-builder__sentence-chip md-board-detail-phrase-builder__sentence-chip--match"
                          {{on "click" (this.ctrlAction "phrase_builder_select" btn)}}
                          aria-label={{btn.label}}>
                          {{#if btn.image}}
                            <span class="md-board-detail-phrase-builder__sentence-chip-img">
                              <img src={{btn.image}} alt="" draggable="false" {{hide-on-error "display"}}>
                            </span>
                          {{/if}}
                          <span class="md-board-detail-phrase-builder__sentence-chip-label">{{btn.label}}</span>
                        </button>
                      {{else}}
                        <span class="md-board-detail-phrase-builder__sentence-chip md-board-detail-phrase-builder__sentence-chip--missing" aria-label={{t "No match" key="board_detail_phrase_no_match_label"}}>
                          <span class="md-board-detail-phrase-builder__sentence-chip-label">{{btn.label}}</span>
                          <span class="md-board-detail-phrase-builder__sentence-chip-missing">{{t "not found" key="board_detail_phrase_not_found"}}</span>
                        </span>
                      {{/if}}
                    {{/each}}
                  </div>
                  <button type="button" class="md-board-detail-phrase-builder__sentence-commit" data-bd-action="phrase_builder_commit_sentence" {{on "click" (this.ctrlAction "phrase_builder_commit_sentence")}}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    {{t "Add to sentence bar" key="board_detail_phrase_add_all"}}
                  </button>
                </div>
              {{else if this.phrase_results.length}}
                <div class="md-board-detail-phrase-builder__chip-list">
                  {{#each this.phrase_results as |btn|}}
                    <button type="button"
                      class="md-board-detail-phrase-builder__chip {{unless btn.on_this_board 'md-board-detail-phrase-builder__chip--linked'}}"
                      {{on "click" (this.ctrlAction "phrase_builder_select" btn)}}
                      aria-label={{btn.label}}>
                      <span class="md-board-detail-phrase-builder__chip-label">{{btn.label}}</span>
                      {{#unless btn.on_this_board}}
                        {{#if btn.pre_buttons.length}}
                          <span class="md-board-detail-phrase-builder__chip-path">
                            {{#each btn.pre_buttons as |pre index|}}{{#if index}} › {{/if}}{{#if pre.label}}{{pre.label}}{{else}}{{pre.vocalization}}{{/if}}{{/each}}
                          </span>
                        {{/if}}
                      {{/unless}}
                    </button>
                  {{/each}}
                </div>
              {{else}}
                <div class="md-board-detail-phrase-builder__empty">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                  <p>{{t "No buttons match your search" key="board_detail_phrase_empty_search"}}</p>
                  <p class="md-board-detail-phrase-builder__empty-hint">{{t "Try a different word or clear the search" key="board_detail_phrase_empty_hint"}}</p>
                </div>
              {{/if}}
            {{else if this.phrase_all_buttons.length}}
              <div class="md-board-detail-phrase-builder__chip-list">
                {{#each this.phrase_all_buttons as |btn|}}
                  <button type="button"
                    class="md-board-detail-phrase-builder__chip"
                    {{on "click" (this.ctrlAction "phrase_builder_select" btn)}}
                    aria-label={{btn.label}}>
                    <span class="md-board-detail-phrase-builder__chip-label">{{btn.label}}</span>
                  </button>
                {{/each}}
              </div>
            {{else}}
              <div class="md-board-detail-phrase-builder__empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                <p>{{t "No buttons found on this board" key="board_detail_phrase_empty_all"}}</p>
              </div>
            {{/if}}
          </div>
        </section>
      {{else}}
      {{#if this.nothing_visible_not_edit}}
        <div class="md-board-detail-empty-board">
          <p>{{t "This board hasn't been set up yet, or doesn't have any visible buttons." key="no_visible_buttons"}}</p>
          {{#if this.can_edit_or_copy_board}}
            <button type="button" class="btn btn-default btn-lg" data-bd-action="enter_edit_mode" {{on "click" (this.ctrlAction "enter_edit_mode")}}>
              {{t "Edit this Board" key="edit_this_board"}}
            </button>
          {{/if}}
        </div>
      {{else}}
      <div class="md-board-detail-grid-fade {{if this.grid_loading 'md-board-detail-grid-fade--loading'}}">

        {{!-- Word-prediction BELOW-BAR panel. Sits directly under the speak bar and spans
              exactly the board buttons' width, because it is the first child of grid-fade
              (the block that holds the grid). Same glass surface as the side rail, laid out
              horizontally with a FIXED height, so the board never reflows as predictions come
              and go. CSS decides whether it shows (see app.scss .md-shell--wordpred-below-bar);
              like the rail, the markup is kept isolated rather than shared with the in-bar
              group so a change here cannot regress the other placements. --}}
        {{#unless this.edit_mode}}
          {{#if this.show_word_suggestions}}
            <div class="md-board-detail-prediction-below {{this.button_text_position_class}} {{if this.suggestions_loading_visible 'md-board-detail-prediction-below--is-loading'}}" role="group" aria-label={{t "Word predictions" key="board_detail_word_predictions"}} aria-busy={{if this.suggestions_loading_visible "true" "false"}} style={{safe-style (concat "--bd-button-text-size:" this.button_text_size_px "px")}}>
              {{#each this.prediction_below_suggestions key="word" as |suggestion|}}
                <button type="button" class="md-board-detail-sentence-bar__prediction" {{on "click" (this.ctrlActionNoBubble "complete_word" suggestion)}} aria-label={{concat (t "Predicted word" key="board_detail_predicted_word") ": " suggestion.word}}>
                  {{#if this.utterance_show_symbols}}
                    {{#if suggestion.image}}
                      <img src={{suggestion.image}} rel={{suggestion.fallback_image}} {{image-fallback-to-rel}} alt="" class="md-board-detail-sentence-bar__prediction-img" decoding="async" loading="eager">
                    {{/if}}
                  {{/if}}
                  <span class="md-board-detail-sentence-bar__prediction-label">{{suggestion.word}}</span>
                </button>
              {{else}}
                {{!-- Same empty state as the side rail, laid out along the panel instead of
                      down it: glyph + copy on the left, ghost tiles filling the rest. The
                      panel keeps its fixed height either way, so the board never moves as
                      predictions arrive or clear. Copy and label reuse the rail's i18n keys —
                      it is the same message on a different surface. --}}
                <div class="md-board-detail-prediction-below__empty">
                  <span class="md-board-detail-prediction-below__empty-lead">
                    {{!-- Decorative: the copy carries the meaning, and the group already has
                          an accessible label. --}}
                    <svg class="md-board-detail-prediction-below__empty-glyph" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <span class="md-board-detail-prediction-below__empty-copy">{{t "Tap a board button, and we'll suggest words here." key="board_detail_prediction_empty"}}</span>
                  </span>
                  <span class="md-board-detail-prediction-below__empty-ghosts" aria-hidden="true">
                    {{#each this.prediction_below_ghost_slots}}
                      <span class="md-board-detail-prediction-below__empty-ghost"></span>
                    {{/each}}
                  </span>
                </div>
              {{/each}}
            </div>
          {{/if}}
        {{/unless}}
      <BoardDetailGrid
        @board={{this.model}}
        @orderedButtons={{this.ordered_buttons}}
        @activeCategory={{this.active_category}}
        @editMode={{this.edit_mode}}
        @previewLevelsMode={{this.preview_levels_mode}}
        @paintMode={{this.paint_mode}}
        @labelsEditable={{true}}
        @boardSaving={{this.board_saving}}
        @folderLabelsOnTab={{this.folder_labels_on_tab}}
        @folderColoredCorner={{this.folder_colored_corner}}
        @folderColoredFace={{this.folder_colored_face}}
        {{!-- Both are already ANDed with grouping_active in the controller, so they are
             inert on an ungrouped board. --}}
        @categoryEnabled={{this.categorize_enabled}}
        @showCategoryNames={{this.show_category_names}}
        @categoryScrollEnabled={{this.category_scroll_enabled}}
        @softBorders={{this.soft_borders}}
        @buttonTextSizeClass={{this.button_text_size_class}}
        @buttonTextPositionClass={{this.button_text_position_class}}
        @hiddenButtonsClass={{this.hidden_buttons_class}}
        @symbolBackgroundClass={{this.symbol_background_class}}
        @highContrastClass={{this.high_contrast_class}}
        @buttonShapeClass={{this.button_shape_class}}
        @gridStyle={{this.grid_style}}
        @buttonTextSizePx={{this.button_text_size_px}}
        @buttonSpacingPx={{this.button_spacing_px}}
        @buttonBorderPx={{this.button_border_px}}
        @buttonFontStyle={{this.button_font_style}}
        @bgStyle={{this.bg_style}}
        @bgClass={{this.bg_class}}
        @bgImgStyle={{this.bg_img_style}}
        @colorPickerButton={{this.color_picker_button}}
        @colorPickerSwatches={{this.color_picker_swatches}}
        @customColorValue={{this.custom_color_value}}
        @buttonEvent={{this.ctrlAction "button_event"}}
        @selectButton={{this.ctrlAction "select_button"}}
        @selectButtonKey={{this.ctrlAction "select_button_key"}}
        @closeColorPicker={{this.ctrlAction "close_color_picker"}}
        @applySwatchColor={{this.ctrlAction "apply_swatch_color"}}
        @toggleMinicolors={{this.ctrlAction "toggle_minicolors"}}
        @applyCustomColor={{this.ctrlAction "apply_custom_color"}} />
      </div>{{!-- /.md-board-detail-grid-fade --}}
      {{/if}}{{!-- /nothing_visible_not_edit --}}
      {{/if}}{{!-- /active_view phrase-builder vs symbol-board --}}

      {{!-- Word-prediction rail. At <=1024px the inline predictions inside the
           speak bar overflow, so they relocate here as a vertical column
           between the board grid and the inline sidebar (CSS toggles which
           location shows — see app.scss .md-board-detail-prediction-rail).
           The button markup intentionally mirrors the inline group above and
           is kept as isolated markup (not a shared component) so a change here
           can't regress the working in-bar predictions; safe to extract to a
           <WordPredictionButtons> component once verified. --}}
      {{#unless this.edit_mode}}
        {{#if this.show_word_suggestions}}
          {{!-- The rail element is mounted for the WHOLE time word prediction is on —
               deliberately NOT gated on suggestions.ready / list.length. It is a
               flex-shrink:0 sibling of the flex:1 board grid, so unmounting it handed
               its width straight to the grid and the board buttons stretched wider, then
               snapped back when it returned — invisible locally, very visible on
               deployment. The panel no longer blanks mid-lookup either (see
               _begin_suggestion_lookup), but it still empties whenever a lookup yields
               nothing, and that must not resize the board. Only the TILES
               are conditional; the rail itself has no background or border, so an empty
               rail is invisible while still holding the column width.

               The rail carries the board's text-position class so its tiles mirror the
               board buttons' label position (top/bottom/none/text_only) at all times —
               the label order is fixed in the DOM (image, then label) and CSS flips
               flex-direction per the class (see app.scss
               .md-board-detail-prediction-rail text-pos rules). --}}
          <div class="md-board-detail-prediction-rail {{this.button_text_position_class}} {{if this.suggestions_loading_visible 'md-board-detail-prediction-rail--is-loading'}}" role="group" aria-label={{t "Word predictions" key="board_detail_word_predictions"}} aria-busy={{if this.suggestions_loading_visible "true" "false"}} style={{safe-style (concat "--bd-button-text-size:" this.button_text_size_px "px")}}>
            {{#each this.prediction_rail_suggestions key="word" as |suggestion|}}
              <button type="button" class="md-board-detail-sentence-bar__prediction" {{on "click" (this.ctrlActionNoBubble "complete_word" suggestion)}} aria-label={{concat (t "Predicted word" key="board_detail_predicted_word") ": " suggestion.word}}>
                {{#if this.utterance_show_symbols}}
                  {{#if suggestion.image}}
                    <img src={{suggestion.image}} rel={{suggestion.fallback_image}} {{image-fallback-to-rel}} alt="" class="md-board-detail-sentence-bar__prediction-img" decoding="async" loading="eager">
                  {{/if}}
                {{/if}}
                <span class="md-board-detail-sentence-bar__prediction-label">{{suggestion.word}}</span>
              </button>
            {{else}}
              {{!-- The rail stays mounted with no predictions so the board does not resize
                    under the user, which leaves a blank panel. Say why it is empty. --}}
              <div class="md-board-detail-prediction-rail__empty">
                {{!-- Decorative only: the copy below carries the meaning, so this is
                      aria-hidden and adds no announcement to a panel a screen reader
                      already reaches through the group's label. --}}
                <svg class="md-board-detail-prediction-rail__empty-glyph" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                {{!-- Both are rendered; CSS picks one by panel width. Below 640px the panel
                      is too narrow for a sentence, so it becomes a vertical spine label. --}}
                <span class="md-board-detail-prediction-rail__empty-copy">{{t "Tap a board button, and we'll suggest words here." key="board_detail_prediction_empty"}}</span>
                <span class="md-board-detail-prediction-rail__empty-spine">{{t "Word prediction panel" key="board_detail_prediction_panel_label"}}</span>
                {{!-- Ghost tiles: they show WHERE words will land rather than leaving the
                      column blank below the copy, which is what made the empty panel read as
                      unfinished. Purely decorative, aria-hidden, no animation (this surface
                      is used with eye-gaze and switch scanning). The count comes from
                      prediction_ghost_slots — the rail's row count less the rows the glyph and
                      copy occupy — so every ghost is whole. There is no overflow mask: it
                      dimmed the last ghost even when it fitted, which is the opposite of what
                      this state is for. --}}
                <span class="md-board-detail-prediction-rail__empty-ghosts" aria-hidden="true">
                  {{#each this.prediction_ghost_slots}}
                    <span class="md-board-detail-prediction-rail__empty-ghost"></span>
                  {{/each}}
                </span>
              </div>
            {{/each}}
          </div>
        {{/if}}
      {{/unless}}

      {{!-- Inline Sidebar Boards (speak mode navigation) --}}
      {{#unless this.app_state.currentUser.preferences.disable_quick_sidebar}}
      {{#unless this.edit_mode}}
        {{#if this.inlineSidebarOpen}}
          <div class="md-board-detail-inline-sidebar">
            {{!-- Inner scroll layer (absolutely filling the stretched shell) so the
                 sidebar's content scrolls WITHIN the board's height instead of
                 growing the row and spilling below the grid. --}}
            <div class="md-board-detail-inline-sidebar__scroll">
            {{!-- The persistent open/pin state is now owned by the sidebar
                 expand/collapse toggle (md-board-detail-sidebar-toggle, which
                 flips quick_sidebar) — the separate in-sidebar pin control was
                 removed to avoid duplicating that behavior. --}}
            {{#each this.app_state.sidebar_boards as |board|}}
              {{#if board.alert}}
                <button type="button" data-bd-action="sidebar_alert" {{on "click" (this.ctrlAction "sidebar_alert")}} class="md-board-detail-inline-sidebar__item">
                  <img src={{board.image}} class="md-board-detail-inline-sidebar__img" alt="" onerror="button_broken_image(this);">
                  <span class="md-board-detail-inline-sidebar__name">{{board.name}}</span>
                </button>
              {{else if board.special}}
                <button type="button" class="md-board-detail-inline-sidebar__item" data-bd-action="sidebar_special" data-bd-arg="{{board.key}}" {{on "click" (this.ctrlAction "sidebar_special" board)}}>
                  <img src={{board.image}} class="md-board-detail-inline-sidebar__img" alt="" onerror="button_broken_image(this);">
                  <span class="md-board-detail-inline-sidebar__name">{{board.name}}</span>
                </button>
              {{else}}
                <button type="button" class="md-board-detail-inline-sidebar__item" data-bd-action="sidebar_jump" data-bd-arg="{{board.key}}" {{on "click" (this.ctrlAction "sidebar_jump" board.key board)}}>
                  <img src={{board.image}} class="md-board-detail-inline-sidebar__img" alt="" onerror="button_broken_image(this);">
                  <span class="md-board-detail-inline-sidebar__name">{{board.name}}</span>
                </button>
              {{/if}}
            {{/each}}
            {{!-- Edit — opens the inline sidebar-editor panel. Sits at the BOTTOM of
                 the sidebar content, styled like the boards-page "Create New Board"
                 pill (aria-label keeps the full "Edit Sidebar" intent for SRs).
                 Behind the edit_sidebar feature flag (new user-facing surface — AAC
                 users get unexpected UI changes only via beta opt-in). --}}
            {{#if this.app_state.feature_flags.edit_sidebar}}
              <div class="md-board-detail-inline-sidebar__edit-row">
                <button type="button" class="md-board-detail-inline-sidebar__edit-btn" data-bd-action="open_sidebar_editor" {{on "click" (this.ctrlAction "open_sidebar_editor")}} aria-label={{t "Edit Sidebar" key="edit_sidebar"}}>
                  <svg class="md-board-detail-inline-sidebar__edit-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                  <span class="md-board-detail-inline-sidebar__edit-label">{{t "Edit" key="edit"}}</span>
                </button>
              </div>
            {{/if}}
            </div>{{!-- /.md-board-detail-inline-sidebar__scroll --}}
          </div>
        {{/if}}
      {{/unless}}
      {{/unless}}

      </div>{{!-- /.md-board-detail-grid-sidebar-wrap --}}

      {{!-- The per-button edit dropdown (triple-dot menu) was REMOVED. Edit-mode
           button actions now live in the Button Settings modal (opened by clicking
           the button); speak mode has no per-button menu. --}}
      {{/if}}

    </main>

    {{!-- Edit-mode Right Panel — Live Preview Edit. Collapsible
         glass container with two accordion groups (Button Settings,
         Board Settings). Each section, when expanded, surfaces the
         live tools for that topic. All controls reuse the existing
         controller actions/state, so live-preview behavior is
         preserved end-to-end. See plan at
         .planning/phases/03-board-edit-side-panel/03-PLAN.md. --}}
    {{#if this.edit_mode}}
      <aside class="md-board-edit-right-panel {{if this.right_panel_collapsed 'md-board-edit-right-panel--collapsed'}}" aria-label={{t "Settings Panel" key="settings_panel"}}>
        <div class="md-board-edit-right-panel__header">
          <button type="button"
            class="md-board-edit-right-panel__collapse-btn"
            aria-expanded={{unless this.right_panel_collapsed "true" "false"}}
            aria-label={{if this.right_panel_collapsed (t "Expand panel" key="expand_panel") (t "Collapse panel" key="collapse_panel")}}
            data-bd-action="toggle_right_panel" {{on "click" (this.ctrlAction "toggle_right_panel")}}>
            {{!-- Double-right chevron, mirroring the left panel's
                 double-left collapse chevron. Points » when expanded
                 (collapse outward to the right) and flips to « when
                 collapsed (expand back) via the rotate rule in
                 app.scss. Same toggle_right_panel action. --}}
            <svg class="md-board-edit-right-panel__collapse-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="13 17 18 12 13 7"/>
              <polyline points="6 17 11 12 6 7"/>
            </svg>
          </button>
          <h3 class="md-board-edit-right-panel__title">{{t "Settings Panel" key="settings_panel"}}</h3>
          {{!-- Collapsed rail shows a short "Settings" caption. --}}
          <span class="md-board-edit-right-panel__title-collapsed">{{t "Settings" key="settings_collapsed_short"}}</span>
        </div>

        {{!-- Body is always rendered; in collapsed-rail mode the
             SCSS hides the labels/chevrons/bodies and arranges
             section icons vertically (VS Code activity-bar style).
             Clicking an icon while collapsed re-expands the panel
             and opens that section — see toggle_right_panel_section
             in the controller. --}}
        <div class="md-board-edit-right-panel__body">

          <div class="md-board-edit-right-panel__divider" role="presentation"></div>

          {{!-- ── BUTTON SETTINGS ─────────────────────────────── --}}
          <div class="md-board-edit-right-panel__group">
            <div class="md-board-edit-right-panel__subheader">
              {{t "Button Settings" key="button_settings_caps"}}
            </div>

            {{!-- Background section moved to BOARD SETTINGS (above
                 Board Symbols). The background color is now grouped
                 with board-level display prefs, not button styling. --}}

            {{!-- Button Levels — moved from the center toolbar's
                 Levels section. Always rendered (the toolbar
                 gated this on has_levels, but per spec users
                 should be able to SET levels here even if the
                 board doesn't have them yet, so the gate is
                 removed). Same actions (toggle_preview_levels,
                 shift_level "down" / "up" / "done") and same
                 state bindings (preview_levels, preview_level). --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'button-levels') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'button-levels') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "button-levels")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="button-levels" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3"  y="14" width="4" height="7"  rx="0.5" stroke="currentColor"/>
                    <rect x="10" y="9"  width="4" height="12" rx="0.5" stroke="#2A9D8F"/>
                    <rect x="17" y="4"  width="4" height="17" rx="0.5" stroke="currentColor"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Button Levels" key="button_levels"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Levels" key="button_levels_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'button-levels')}}
                {{!-- Modern Button Levels paint UI — drives the same
                     editManager.set_paint_mode('level', action, level)
                     call the legacy paint-level modal uses, so the
                     underlying paint engine + dirty/save tracking is
                     unchanged. UI flow:
                       1. Pick an action (Reveal at level / Enable link
                          at level / Clear all level settings)
                       2. If action needs a level, pick a level pill (1-10)
                       3. "Start Painting" arms paint mode; clicking any
                          board button applies the modification
                       4. While armed, an active strip shows what's
                          being painted with a "Stop" button
                     Preview Levels stays as a separate sub-section. --}}
                <div class="md-board-edit-right-panel__section-body">
                  {{!-- Modern info callout: tinted teal card + filled
                       circular check badge. Reads as a tip/highlight
                       rather than plain body copy. --}}
                  <div style="display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; background: linear-gradient(135deg, rgba(42,157,143,0.10), rgba(42,157,143,0.04)); border: 1px solid rgba(42,157,143,0.28); border-radius: 12px; margin-bottom: 10px; box-shadow: 0 1px 0 rgba(255,255,255,0.04) inset;">
                    <span style="display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: #2A9D8F; flex-shrink: 0; margin-top: 1px; box-shadow: 0 0 8px rgba(42,157,143,0.4);">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    </span>
                    <span class="md-board-levels-callout-text" style="font-size: 12.5px; line-height: 1.45; flex: 1; letter-spacing: 0.01em;">
                      {{t "Levels let you start basic and gradually reveal vocabulary as a communicator grows." key="button_levels_intro_hint"}}
                    </span>
                  </div>
                  {{!-- Live progress count, styled as an information
                       badge with a teal glow so it reads as a
                       status pill rather than body copy. --}}
                  <div style="display: flex; justify-content: center; margin-bottom: 14px;">
                    <span class="md-board-levels-callout-text" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; background: rgba(42,157,143,0.14); border: 1px solid rgba(42,157,143,0.5); font-size: 11.5px; font-weight: 600; line-height: 1; box-shadow: 0 0 12px rgba(42,157,143,0.35), 0 0 4px rgba(42,157,143,0.55);">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#2A9D8F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="16" x2="12" y2="12"/>
                        <line x1="12" y1="8" x2="12.01" y2="8"/>
                      </svg>
                      <span>{{this.button_level_count.with_rules}} {{t "of" key="of_separator"}} {{this.button_level_count.total}} {{t "buttons have level rules" key="button_level_count_suffix"}}</span>
                    </span>
                  </div>

                  {{!-- Active paint top-of-section banner removed.
                       The action banner inside Step 1 doubles as the
                       "currently selected" indicator AND the way to
                       exit paint mode (click the banner / its ✕ to
                       clear). Other exits: pick a different action,
                       click the same level pill again. --}}

                  {{!-- ─── Card 1 of 2: PAINT LEVELS ────────────────
                       A bordered card visually contains the multi-step
                       paint flow (Action → Level → Start). Stepped
                       sub-labels make the order obvious. --}}
                  <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.10); border-radius: 12px; padding: 14px 12px; margin-bottom: 14px;">
                    <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; text-align: center; opacity: 0.75; margin-bottom: 4px;">
                      {{t "Paint Levels" key="level_paint_card_heading"}}
                    </div>
                    {{!-- Step 1 — Choose Action --}}
                    <div style="font-size: 10px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.6; text-align: center; margin-bottom: 6px;">
                      {{t "Step 1 — Choose Action" key="level_paint_step_action"}}
                    </div>
                    {{#if this.level_paint_action_is_add}}
                      {{!-- Add-action banner — replaces both sub-cards
                           once an add action is chosen. Click anywhere
                           on the banner (or the X) to clear the
                           selection and re-show the picker. --}}
                      <button type="button" class="md-board-levels-callout-text"
                        style="display: flex; align-items: center; gap: 10px; width: 100%; padding: 12px 14px; border-radius: 10px; cursor: pointer; margin-bottom: 12px; font-weight: 700; font-size: 12.5px; line-height: 1.2; background: rgba(42,157,143,0.18); border: 1px solid rgba(42,157,143,0.55); box-shadow: 0 0 14px rgba(42,157,143,0.35), 0 0 4px rgba(42,157,143,0.5);"
                        aria-label={{t "Change action" key="level_paint_change_action_aria"}}
                        {{on "click" (this.ctrlAction "set_level_paint_action" this.level_paint_action)}}>
                        <span style="width: 14px; flex-shrink: 0;" aria-hidden="true"></span>
                        <span style="flex: 1; text-align: center;">
                          {{#if (is-equal this.level_paint_action 'hidden')}}
                            {{t "Adding Levels to Buttons" key="level_paint_selected_add_buttons"}}
                          {{else if (is-equal this.level_paint_action 'link_disabled')}}
                            {{t "Adding Locks to Folders" key="level_paint_selected_add_folder_locks"}}
                          {{/if}}
                        </span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: 0.85; flex-shrink: 0;">
                          <line x1="18" y1="6" x2="6" y2="18"/>
                          <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                      </button>
                    {{else}}
                      {{!-- Two semantically-distinct sub-groups inside
                           Step 1. The Remove sub-group only renders
                           when the board has at least one button with
                           level rules — nothing to remove otherwise.
                           When 'clear' is the active action, the
                           Remove pill itself glows red instead of
                           collapsing into a banner. --}}
                      <div style="display: flex; flex-direction: column; gap: 6px; padding: 10px; border-radius: 10px; background: rgba(42,157,143,0.06); border: 1px solid rgba(42,157,143,0.2); margin-bottom: 4px;">
                        <div style="font-size: 9.5px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; opacity: 0.7; text-align: center; margin-bottom: 2px;">
                          {{t "Add Rules" key="level_paint_subgroup_add"}}
                        </div>
                        <button type="button" class="md-board-edit-right-panel__pill" style="display: flex; align-items: center; justify-content: center; text-align: center;" {{on "click" (this.ctrlAction "set_level_paint_action" "hidden")}}>{{t "Add Levels to Buttons" key="level_paint_add_levels_to_buttons"}}</button>
                        <button type="button" class="md-board-edit-right-panel__pill" style="display: flex; align-items: center; justify-content: center; text-align: center;" {{on "click" (this.ctrlAction "set_level_paint_action" "link_disabled")}}>{{t "Add Locks to Folders" key="level_paint_add_locks_to_folders"}}</button>
                      </div>

                      {{#if this.button_level_count.with_rules}}
                        <div class="md-board-edit-right-panel__or" style="margin: 8px 0;">
                          <span class="md-board-edit-right-panel__or-text">{{t "OR" key="or_separator_caps"}}</span>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 6px; padding: 10px; border-radius: 10px; background: rgba(192,57,43,0.06); border: 1px solid rgba(192,57,43,0.22); margin-bottom: 12px;">
                          <div style="font-size: 9.5px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; opacity: 0.7; text-align: center; margin-bottom: 2px;">
                            {{t "Remove Rules" key="level_paint_subgroup_remove"}}
                          </div>
                          <button type="button" class="md-board-edit-right-panel__pill"
                            style="display: flex; align-items: center; justify-content: center; text-align: center; background: rgba(192,57,43,0.16); border: 1px solid rgba(192,57,43,0.50); box-shadow: 0 0 12px rgba(192,57,43,0.30), 0 0 4px rgba(192,57,43,0.45);"
                            {{on "click" (this.ctrlAction "set_level_paint_action" "clear")}}>{{t "Remove level rules" key="level_paint_remove_rules"}}</button>
                        </div>
                      {{/if}}
                    {{/if}}

                    {{!-- Step 2 — Choose Level. Only appears after Step 1
                         has been chosen, so the user isn't presented with
                         an empty pending-state placeholder before they've
                         picked an action. --}}
                    {{#if this.level_paint_action}}
                      <div style="font-size: 10px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.6; text-align: center; margin-bottom: 6px;">
                        {{t "Step 2 — Choose Level" key="level_paint_step_level"}}
                      </div>
                      {{#if this.level_paint_needs_level}}
                        <div style="display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin-bottom: 12px;">
                          {{#each this.level_paint_options as |opt|}}
                            <button type="button" data-tooltip={{opt.name}} aria-label={{opt.name}}
                              style={{safe-style (concat "display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1; min-width: 0; min-height: 36px; padding: 0; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 15px; line-height: 1; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); transition: transform 0.08s ease, box-shadow 0.12s ease, background 0.12s ease; " (if (is-equal this.level_paint_level opt.id) (concat "border: 1.5px solid " (get this.level_color_map opt.id) "AA; background: linear-gradient(180deg, " (get this.level_color_map opt.id) "B3 0%, " (get this.level_color_map opt.id) "80 100%), #111A2E; color: #fff; box-shadow: inset 0 1px 0 rgba(255,255,255,0.20), inset 0 -1px 0 rgba(0,0,0,0.08);") (concat "border: 1.5px solid " (get this.level_color_map opt.id) "55; background: linear-gradient(180deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.01) 100%), #111A2E; color: " (get this.level_color_map opt.id) "D9; box-shadow: inset 0 1px 0 rgba(255,255,255,0.10);")))}}
                              {{on "click" (this.ctrlAction "set_level_paint_level" opt.id)}}>
                              {{opt.id}}
                            </button>
                          {{/each}}
                        </div>
                      {{else if (is-equal this.level_paint_action 'clear')}}
                        <p class="md-board-edit-right-panel__hint" style="margin: 0 0 12px; text-align: center; font-style: italic; font-size: 11.5px;">{{t "Not needed — Clear removes all level settings." key="level_paint_step_level_clear_note"}}</p>
                      {{/if}}
                    {{/if}}

                  </div>

                  {{!-- Preview is now implicit: clicking an add-action
                       in Card 1 above engages preview at the picked
                       level (defaults to Level 1). Picking a different
                       Step 2 pill shifts the preview to that level.
                       Toggling the action off exits preview. --}}
                </div>
              {{/if}}
            </div>

            {{!-- Hidden Tool --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'hidden-tool') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'hidden-tool') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "hidden-tool")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="hidden-tool" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" stroke="currentColor"/>
                    <line x1="1" y1="1" x2="23" y2="23" stroke="#2A9D8F"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Hidden Tool" key="hidden_tool"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Hidden" key="hidden_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'hidden-tool')}}
                {{!-- Hidden controls — moved from the center
                     toolbar's Hidden section. Three display
                     options drive set_display_pref "hidden_buttons"
                     ("grid" / "hint" / "hide"); two paint toggles
                     drive toggle_paint_hide / toggle_paint_show.
                     All buttons keep their original svg icons and
                     get always-visible labels below for clarity. --}}
                <div class="md-board-edit-right-panel__section-body">
                  <span class="md-board-edit-right-panel__row-pair-label" style="display: block; margin-bottom: 6px;">{{t "Show hidden buttons as..." key="hidden_show_as_label"}}</span>
                  <div role="radiogroup" aria-label={{t "Hidden buttons" key="board_detail_prefs_hidden_buttons"}} style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px;">
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" role="radio" aria-checked={{if (is-equal this.current_display_prefs.hidden_buttons "grid") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.current_display_prefs.hidden_buttons 'grid') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Show as Placeholder on Grid" key="board_detail_settings_hidden_grid"}} aria-label={{t "Show as Placeholder on Grid" key="board_detail_settings_hidden_grid"}} {{on "click" (this.ctrlAction "set_display_pref" "hidden_buttons" "grid")}}>
                        <svg width="22" height="22" viewBox="0 0 24 24" stroke="none" aria-hidden="true">
                          <rect x="3"  y="3"  width="8" height="8" fill="currentColor" stroke="#000" stroke-width="0.75"/>
                          <rect x="13" y="3"  width="8" height="8" fill="#6b7280"      stroke="#000" stroke-width="0.75"/>
                          <rect x="3"  y="13" width="8" height="8" fill="#6b7280"      stroke="#000" stroke-width="0.75"/>
                          <rect x="13" y="13" width="8" height="8" fill="currentColor" stroke="#000" stroke-width="0.75"/>
                        </svg>
                      </button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Grid" key="hidden_label_grid"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" role="radio" aria-checked={{if (is-equal this.current_display_prefs.hidden_buttons "hint") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.current_display_prefs.hidden_buttons 'hint') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Show as hint" key="board_detail_settings_hidden_hint"}} aria-label={{t "Show as hint" key="board_detail_settings_hidden_hint"}} {{on "click" (this.ctrlAction "set_display_pref" "hidden_buttons" "hint")}}>
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" stroke-dasharray="3 3"/></svg>
                      </button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Hint" key="hidden_label_hint"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" role="radio" aria-checked={{if (is-equal this.current_display_prefs.hidden_buttons "hide") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.current_display_prefs.hidden_buttons 'hide') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Hide completely" key="board_detail_settings_hidden_hide"}} aria-label={{t "Hide completely" key="board_detail_settings_hidden_hide"}} {{on "click" (this.ctrlAction "set_display_pref" "hidden_buttons" "hide")}}>
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="9"/>
                          <line x1="5.64" y1="5.64" x2="18.36" y2="18.36"/>
                        </svg>
                      </button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Hide" key="hidden_label_hide"}}</span>
                    </div>
                  </div>
                  <span class="md-board-edit-right-panel__row-pair-label" style="display: block; margin-bottom: 6px;">{{t "Paint mode" key="hidden_paint_mode_label"}}</span>
                  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-icon-btn {{if this.paint_mode_is_hide 'md-settings-icon-btn--active'}}" aria-pressed={{if this.paint_mode_is_hide "true" "false"}} data-tooltip={{t "Paint buttons as hidden (click buttons on the board to mark them hidden)" key="board_detail_settings_paint_hide"}} aria-label={{t "Paint buttons as hidden (click buttons on the board to mark them hidden)" key="board_detail_settings_paint_hide"}} data-bd-action="toggle_paint_hide" {{on "click" (this.ctrlAction "toggle_paint_hide")}}>
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                          <circle cx="12" cy="12" r="3"/>
                          <line x1="3" y1="3" x2="21" y2="21"/>
                        </svg>
                      </button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Hide buttons" key="paint_hide_buttons"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-icon-btn {{if this.paint_mode_is_show 'md-settings-icon-btn--active'}}" aria-pressed={{if this.paint_mode_is_show "true" "false"}} data-tooltip={{t "Paint buttons as visible (click hidden buttons on the board to reveal them)" key="board_detail_settings_paint_show"}} aria-label={{t "Paint buttons as visible (click hidden buttons on the board to reveal them)" key="board_detail_settings_paint_show"}} data-bd-action="toggle_paint_show" {{on "click" (this.ctrlAction "toggle_paint_show")}}>
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                          <circle cx="12" cy="12" r="3"/>
                        </svg>
                      </button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Reveal buttons" key="paint_show_buttons"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-icon-btn" data-tooltip={{t "Reveal every hidden button on this board" key="board_detail_settings_reveal_all_tip"}} aria-label={{t "Reveal every hidden button on this board" key="board_detail_settings_reveal_all_tip"}} data-bd-action="reveal_all_hidden_buttons" {{on "click" (this.ctrlAction "reveal_all_hidden_buttons")}}>
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="3" y="3" width="7" height="7" rx="1.2"/>
                          <rect x="14" y="3" width="7" height="7" rx="1.2"/>
                          <rect x="3" y="14" width="7" height="7" rx="1.2"/>
                          <rect x="14" y="14" width="7" height="7" rx="1.2"/>
                        </svg>
                      </button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Reveal All" key="paint_reveal_all"}}</span>
                    </div>
                  </div>
                </div>
              {{/if}}
            </div>

            {{!-- Paint Tool — single-button color picker + brush
                 toggle for painting individual buttons. Reuses
                 the toolbar's `show_paint_dropdown` state and
                 swatches list so live preview keeps working. --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'paint-tool') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'paint-tool') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "paint-tool")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="paint-tool" aria-hidden="true">
                  {{!-- Brush only — no swap-arrows; this section is
                       per-button painting, not full-board recolor. --}}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 6 L18 10 L9 19 L4 20 L5 15 Z" stroke="currentColor" stroke-linejoin="round"/>
                    <path d="M14 6 L17 3 L21 7 L18 10" stroke="#2A9D8F"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Paint Tool" key="paint_tool"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Paint" key="paint_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'paint-tool')}}
                {{!-- Wrap the entire paint UI in the toolbar's
                     dropdown-wrap--paint class so the global
                     outside-click handler in board-detail.js
                     (line ~167) treats clicks in here as "inside"
                     and doesn't close show_paint_dropdown. --}}
                <div class="md-board-edit-right-panel__section-body md-board-detail-edit-toolbar__dropdown-wrap md-board-detail-edit-toolbar__dropdown-wrap--paint">
                  <div class="md-board-edit-right-panel__paint-row">
                    {{!-- Color preview + dropdown trigger. Reuses
                         this.show_paint_dropdown state with the
                         existing toggle_paint_dropdown action. --}}
                    <button type="button"
                      class="md-board-edit-right-panel__palette {{if this.show_paint_dropdown 'md-board-edit-right-panel__palette--open'}}"
                      aria-haspopup="menu"
                      aria-expanded={{if this.show_paint_dropdown "true" "false"}}
                      data-bd-action="toggle_paint_dropdown" {{on "click" (this.ctrlAction "toggle_paint_dropdown")}}>
                      <span class="md-board-edit-right-panel__palette-preview" style={{safe-style (concat "background-color:" (if this.paint_mode.fill this.paint_mode.fill "#ffffff"))}}></span>
                      <span class="md-board-edit-right-panel__palette-label">{{t "Select Color" key="select_color_caps"}}</span>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"/>
                      </svg>
                    </button>
                  </div>
                  {{#if this.show_paint_dropdown}}
                    {{!-- Two-column pill grid + Custom Color row +
                         inline color picker. All buttons fire the
                         existing controller actions (set_paint_mode,
                         toggle_paint_color_picker,
                         update_custom_paint_color,
                         apply_custom_paint_color), which set
                         `paint_mode` on both the controller and the
                         editManager. Once paint_mode is set, clicking
                         any button in the preview area paints it
                         (handled by the existing edit-mode click
                         handler — same path the toolbar uses). --}}
                    <div class="md-board-edit-right-panel__paint-grid" role="menu">
                      {{#each this.color_picker_swatches as |swatch|}}
                        <button type="button"
                          role="menuitem"
                          class="md-board-edit-right-panel__paint-pill {{if (is-equal this.paint_mode.fill swatch.bg) 'md-board-edit-right-panel__paint-pill--active'}}"
                          aria-label={{swatch.label}}
                          {{on "click" (this.ctrlAction "set_paint_mode" swatch.bg swatch.border swatch.pos_class)}}>
                          <span class="md-board-edit-right-panel__paint-pill-dot" style={{safe-style (concat "background-color:" swatch.bg ";border-color:" swatch.border)}}></span>
                          <span class="md-board-edit-right-panel__paint-pill-label">{{swatch.label}}</span>
                        </button>
                      {{/each}}
                      {{!-- Custom Color pill — full-width row inside
                           the grid; toggles the picker that follows. --}}
                      <button type="button"
                        role="menuitem"
                        class="md-board-edit-right-panel__paint-pill md-board-edit-right-panel__paint-pill--custom {{if this.show_paint_color_picker 'md-board-edit-right-panel__paint-pill--open'}}"
                        aria-label={{t "Custom Color" key="board_detail_custom_paint_color"}}
                        aria-expanded={{if this.show_paint_color_picker "true" "false"}}
                        data-bd-action="toggle_paint_color_picker" {{on "click" (this.ctrlAction "toggle_paint_color_picker")}}>
                        <span class="md-board-edit-right-panel__paint-pill-dot md-board-edit-right-panel__paint-pill-dot--custom"></span>
                        <span class="md-board-edit-right-panel__paint-pill-label">{{t "Custom Color" key="board_detail_custom_paint_color"}}</span>
                      </button>
                      {{#if this.show_paint_color_picker}}
                        {{!-- Inline picker — sits inside the grid as
                             a full-width row directly below Custom
                             Color, so it visually reads as that
                             pill's expanded body. --}}
                        <div class="md-board-edit-right-panel__custom-picker">
                          {{!-- Same ids as the toolbar's picker so
                               any global handlers / focus
                               management treat both as the same
                               control. The toolbar will be
                               removed once this panel proves out. --}}
                          <input type="color"
                            id="bd-paint-color-picker"
                            class="md-board-edit-right-panel__custom-picker-input"
                            value={{this.custom_paint_color}}
                            aria-label={{t "Pick paint color" key="board_detail_pick_paint_color"}}
                            autocomplete="off"
                            oninput={{this.onUpdateCustomPaintColor}}
                            onchange={{this.onUpdateCustomPaintColor}}>
                          <input value={{this.custom_paint_color}} id="bd-paint-hex-input" placeholder="#hex" aria-label={{t "Custom hex color" key="custom_hex_color"}} class="md-board-edit-right-panel__custom-picker-hex" autocomplete="off" {{on "input" (set-field this "custom_paint_color")}} />
                          <button type="button"
                            class="md-board-edit-right-panel__custom-picker-apply"
                            data-bd-action="apply_custom_paint_color" {{on "click" (this.ctrlAction "apply_custom_paint_color")}}>
                            {{t "Apply" key="board_detail_apply"}}
                          </button>
                        </div>
                      {{/if}}
                    </div>
                  {{/if}}
                  {{!-- "OR" divider + auto-recolor shortcut. Sits
                       below the manual color-picker so the user
                       sees both options in one section: pick a
                       color manually, OR let the system recolor
                       by word type. Calls the same recolor_board
                       action that the Recolor Tool section uses. --}}
                  <div class="md-board-edit-right-panel__or">
                    <span class="md-board-edit-right-panel__or-text">{{t "OR" key="or_separator_caps"}}</span>
                  </div>
                  {{!-- Sub-section label for the recolor-by-word-type
                       affordance — matches the row-pair-label tone
                       used by Size / Font / Position / etc. so the
                       grouping reads consistently. --}}
                  <span class="md-board-edit-right-panel__row-pair-label">{{t "Recolor Wizard" key="recolor_wizard"}}</span>
                  <button type="button"
                    class="md-board-edit-right-panel__pill {{if this.board_recolored 'md-board-edit-right-panel__pill--active'}}"
                    data-bd-action="recolor_board" {{on "click" (this.ctrlAction "recolor_board")}}>
                    {{t "Recolor by Word Type" key="recolor_by_word_type"}}
                  </button>
                  {{!-- Highlight Labels toggle — moved here from Shape & Border and
                       renamed from "Soft borders". Function is unchanged: it still
                       toggles user.preferences.soft_borders and the
                       .md-board-detail-grid--soft-borders class (softer per-button
                       outer shadow + inset highlight + muted outline). Only the
                       label text and its placement changed. --}}
                  <div class="md-folder-toggle-row">
                    <span class="md-folder-toggle-row__label" id="highlight-labels-label">{{t "Highlight Labels" key="board_detail_highlight_labels"}}</span>
                    <div class="md-folder-toggle-row__control">
                      <span class="md-folder-toggle-row__state {{unless this.soft_borders 'md-folder-toggle-row__state--active'}}" aria-hidden="true">{{t "Off" key="off"}}</span>
                      <button type="button"
                        role="switch"
                        aria-checked={{if this.soft_borders "true" "false"}}
                        aria-labelledby="highlight-labels-label"
                        class="nb-toggle__switch {{if this.soft_borders 'nb-toggle__switch--on'}}"
                        data-bd-action="toggle_soft_borders" {{on "click" (this.ctrlAction "toggle_soft_borders")}}>
                        <span class="nb-toggle__thumb" aria-hidden="true"></span>
                      </button>
                      <span class="md-folder-toggle-row__state {{if this.soft_borders 'md-folder-toggle-row__state--active'}}" aria-hidden="true">{{t "On" key="on"}}</span>
                    </div>
                  </div>
                </div>
              {{/if}}
            </div>

            {{!-- Recolor Tool section removed — its only useful
                 affordance ("Recolor by Word Type") now lives in
                 the Paint Tool body under the OR divider, so a
                 separate accordion section was redundant. The
                 recolor_board action is unchanged. --}}

            {{!-- Shape & Border — combines Button Shape + Button
                 Border into one accordion section. Both controls
                 are about the button's outer geometry, so they
                 live together. Icon: rounded outer rect (shape)
                 with a dashed inner rect (border) overlaid. --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'shape-border') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'shape-border') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "shape-border")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="shape-border" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="6" stroke="#2A9D8F"/>
                    <rect x="7" y="7" width="10" height="10" rx="2" stroke-dasharray="3 3" stroke="currentColor"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Shape & Border" key="shape_and_border"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Shape" key="shape_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'shape-border')}}
                <div class="md-board-edit-right-panel__section-body">
                  {{!-- Shape (stretch_buttons) and Border (button_border)
                       controls — copied verbatim from the center
                       toolbar's Shape and Border sections (lines ~1540
                       and ~1575) so the right panel and center share
                       the exact same markup, classes, action names, and
                       computed property bindings. The shape icongroup's
                       active state automatically picks up the solid
                       charcoal-blue fill via the right-panel-scoped
                       .md-settings-icon-btn--active rule. --}}
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label">{{t "Shape" key="board_detail_settings_shape"}}</span>
                    <div class="md-settings-icongroup" role="radiogroup" aria-label={{t "Stretch buttons" key="board_detail_prefs_stretch"}}>
                      <button type="button" role="radio" aria-checked={{if (is-equal this.current_display_prefs.stretch_buttons "none") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.current_display_prefs.stretch_buttons 'none') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Fit cell" key="board_detail_settings_fit_cell"}} aria-label={{t "Fit cell" key="board_detail_settings_fit_cell"}} {{on "click" (this.ctrlAction "set_display_pref" "stretch_buttons" "none")}}>
                        <span class="md-settings-stretch-icon md-settings-stretch-icon--square"></span>
                      </button>
                      <button type="button" role="radio" aria-checked={{if (is-equal this.current_display_prefs.stretch_buttons "prefer_tall") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.current_display_prefs.stretch_buttons 'prefer_tall') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Thin" key="board_detail_settings_thin"}} aria-label={{t "Thin" key="board_detail_settings_thin"}} {{on "click" (this.ctrlAction "set_display_pref" "stretch_buttons" "prefer_tall")}}>
                        <span class="md-settings-stretch-icon md-settings-stretch-icon--tall"></span>
                      </button>
                      <button type="button" role="radio" aria-checked={{if (is-equal this.current_display_prefs.stretch_buttons "prefer_wide") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.current_display_prefs.stretch_buttons 'prefer_wide') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Wide" key="board_detail_settings_wide"}} aria-label={{t "Wide" key="board_detail_settings_wide"}} {{on "click" (this.ctrlAction "set_display_pref" "stretch_buttons" "prefer_wide")}}>
                        <span class="md-settings-stretch-icon md-settings-stretch-icon--wide"></span>
                      </button>
                    </div>
                  </div>
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label">{{t "Border" key="board_detail_settings_border_label"}}</span>
                    <div class="md-board-detail-edit-toolbar__stepper md-settings-stepper md-settings-stepper--compact">
                      <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_border_at_min}} data-tooltip={{t "Thinner" key="board_detail_settings_thinner"}} aria-label={{t "Thinner" key="board_detail_settings_thinner"}} {{on "click" (this.ctrlAction "step_display_pref" "button_border" -1)}}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                      </button>
                      <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_border_at_max}} data-tooltip={{t "Thicker" key="board_detail_settings_thicker"}} aria-label={{t "Thicker" key="board_detail_settings_thicker"}} {{on "click" (this.ctrlAction "step_display_pref" "button_border" 1)}}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                      </button>
                    </div>
                  </div>
                </div>
              {{/if}}
            </div>

            {{!-- Stash section moved to the left panel as
                 "Button Stash" (under Board Ideas). Same
                 `open_button_stash` action. --}}

            {{!-- Text Settings — combines Text Size & Type with
                 Text Position into one accordion section. Size +
                 Font + Position controls live together since they
                 all configure how text renders inside a button. --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'text-settings') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'text-settings') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "text-settings")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="text-settings" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="4 7 4 4 20 4 20 7" stroke="#2A9D8F"/>
                    <line x1="9" y1="20" x2="15" y2="20" stroke="currentColor"/>
                    <line x1="12" y1="4" x2="12" y2="20" stroke="currentColor"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Text & Image" key="text_settings"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Text" key="text_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'text-settings')}}
                <div class="md-board-edit-right-panel__section-body">
                  {{!-- Text size stepper, font dropdown, and text-position
                       icongroup — copied verbatim from the center
                       toolbar's Text + Text Position sections so the
                       right panel and center share the exact same
                       markup, classes, action names, and computed
                       property bindings. When the center sections are
                       removed later, this remains as the canonical
                       editor for the same prefs. --}}

                  {{!-- Font size stepper, with the right-panel
                       "Size" sub-label restored. The control inside is
                       the same center-toolbar markup. --}}
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label">{{t "Text Size" key="text_size"}}</span>
                    <div class="md-board-detail-edit-toolbar__stepper md-settings-stepper md-settings-stepper--compact">
                      <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_text_size_at_min}} data-tooltip={{t "Smaller" key="board_detail_settings_smaller"}} aria-label={{t "Smaller" key="board_detail_settings_smaller"}} {{on "click" (this.ctrlAction "step_display_pref" "button_text" -1)}}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                      </button>
                      <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_text_size_at_max}} data-tooltip={{t "Larger" key="board_detail_settings_larger"}} aria-label={{t "Larger" key="board_detail_settings_larger"}} {{on "click" (this.ctrlAction "step_display_pref" "button_text" 1)}}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                      </button>
                    </div>
                  </div>

                  {{!-- Font style custom dropdown, with restored
                       "Font" sub-label. --}}
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label">{{t "Font Type" key="font_type"}}</span>
                    <div class="md-settings-dropdown-wrap">
                      <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_font_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_font_dropdown_open "true" "false"}} data-tooltip={{t "Font style" key="board_detail_prefs_font_style"}} aria-label={{t "Font style" key="board_detail_prefs_font_style"}} data-bd-action="toggle_display_font_dropdown" {{on "click" (this.ctrlAction "toggle_display_font_dropdown")}}>
                        <span class="md-settings-select__value">{{this.display_prefs_current_font_label}}</span>
                      </button>
                      {{#if this.display_prefs_font_dropdown_open}}
                        <div class="md-settings-dropdown-backdrop" data-bd-action="close_display_font_dropdown" {{on "click" (this.ctrlAction "close_display_font_dropdown")}} aria-hidden="true"></div>
                        <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Font style" key="board_detail_prefs_font_style"}}>
                          <li class="md-settings-dropdown-search-row" role="presentation">
                            <input type="text"
                                   id="bd-font-dropdown-search"
                                   class="md-settings-dropdown-search__input"
                                   placeholder={{t "Search fonts..." key="search_fonts_placeholder"}}
                                   value={{this.display_prefs_font_filter}}
                                   oninput={{this.onFilterDisplayFonts}}
                                   onkeydown={{this.onFontDropdownKeydown}}
                                   autocomplete="off"
                                   aria-label={{t "Search fonts" key="search_fonts_label"}} />
                          </li>
                          {{#each this.filtered_button_style_options as |opt|}}
                            {{#if opt.divider}}
                              <li class="md-settings-dropdown-divider" role="separator" aria-hidden="true"></li>
                            {{else}}
                              <li role="presentation">
                                <button type="button" role="option" aria-selected={{if (is-equal this.current_display_prefs.button_style opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.current_display_prefs.button_style opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_display_font" opt.id)}}>
                                  {{#if (is-equal this.current_display_prefs.button_style opt.id)}}
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                  {{else}}
                                    <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                  {{/if}}
                                  <span>{{opt.label}}</span>
                                </button>
                              </li>
                            {{/if}}
                          {{/each}}
                        </ul>
                      {{/if}}
                    </div>
                  </div>

                  {{!-- Text position icongroup, with restored
                       "Position" sub-label. --}}
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label">{{t "Text Position" key="text_position"}}</span>
                    <div class="md-settings-icongroup" role="radiogroup" aria-label={{t "Text position" key="board_detail_prefs_text_position"}}>
                      <button type="button" role="radio" aria-checked={{if (is-equal this.current_display_prefs.button_text_position "top") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.current_display_prefs.button_text_position 'top') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Text on top" key="board_detail_settings_text_top"}} aria-label={{t "Text on top" key="board_detail_settings_text_top"}} {{on "click" (this.ctrlAction "set_display_pref" "button_text_position" "top")}}>
                        <span class="md-settings-btnmock"><span class="md-settings-btnmock__text md-settings-btnmock__text--top">Aa</span><span class="md-settings-btnmock__img"></span></span>
                      </button>
                      <button type="button" role="radio" aria-checked={{if (is-equal this.current_display_prefs.button_text_position "bottom") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.current_display_prefs.button_text_position 'bottom') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Text on bottom" key="board_detail_settings_text_bottom"}} aria-label={{t "Text on bottom" key="board_detail_settings_text_bottom"}} {{on "click" (this.ctrlAction "set_display_pref" "button_text_position" "bottom")}}>
                        <span class="md-settings-btnmock"><span class="md-settings-btnmock__img"></span><span class="md-settings-btnmock__text md-settings-btnmock__text--bottom">Aa</span></span>
                      </button>
                      <button type="button" role="radio" aria-checked={{if (is-equal this.current_display_prefs.button_text_position "text_only") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.current_display_prefs.button_text_position 'text_only') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Text only" key="board_detail_settings_text_only"}} aria-label={{t "Text only" key="board_detail_settings_text_only"}} {{on "click" (this.ctrlAction "set_display_pref" "button_text_position" "text_only")}}>
                        <span class="md-settings-btnmock"><span class="md-settings-btnmock__text md-settings-btnmock__text--only">Aa</span></span>
                      </button>
                    </div>
                  </div>
                </div>
              {{/if}}
            </div>

          </div>

          <div class="md-board-edit-right-panel__divider" role="presentation"></div>

          {{!-- ── BOARD SETTINGS ──────────────────────────────── --}}
          <div class="md-board-edit-right-panel__group">
            <div class="md-board-edit-right-panel__subheader">
              {{t "Board Settings" key="board_settings_caps"}}
            </div>

            {{!-- Background — moved here from BUTTON SETTINGS so
                 it sits with other board-level display prefs.
                 Same actions (toggle_display_symbol_background_dropdown,
                 close_display_symbol_background_dropdown,
                 pick_display_symbol_background) and same state
                 (display_prefs_symbol_background_dropdown_open). --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'background') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'background') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "background")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="background" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor"/>
                    <path d="M3 21 L21 3" stroke="currentColor"/>
                    <path d="M21 3 L21 21 L3 21 Z" fill="#2A9D8F" fill-opacity="0.18" stroke="none"/>
                    <circle cx="16" cy="9" r="2.5" fill="#2A9D8F" stroke="none"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Background" key="symbol_background"}}</span>
                {{!-- Two-line on the collapsed rail (BACK- / GROUND),
                     mirrors the DOWN- / LOAD pattern on the left
                     rail's Download tile. <br> forces the break;
                     trailing dash signals the word continues. --}}
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Back-" key="background_split_back"}}<br>{{t "ground" key="background_split_ground"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'background')}}
                <div class="md-board-edit-right-panel__section-body">
                  <div class="md-settings-sublabel-wrap">
                    <span class="md-settings-sublabel">{{t "Background Color" key="board_detail_settings_image_background_color_all_line1"}}<br />{{t "for All Board Buttons" key="board_detail_settings_image_background_color_all_line2"}}</span>
                    <div class="md-settings-dropdown-wrap">
                      <button type="button" class="md-settings-select md-settings-select--trigger md-settings-select--img-bg {{if this.display_prefs_symbol_background_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_symbol_background_dropdown_open "true" "false"}} data-tooltip={{t "Background color behind symbol images" key="board_detail_prefs_image_background_tooltip"}} aria-label={{t "Background color behind symbol images" key="board_detail_prefs_image_background_tooltip"}} data-bd-action="toggle_display_symbol_background_dropdown" {{on "click" (this.ctrlAction "toggle_display_symbol_background_dropdown")}}>
                        <span class="md-settings-select__value">{{this.display_prefs_current_symbol_background_label}}</span>
                      </button>
                      {{#if this.display_prefs_symbol_background_dropdown_open}}
                        <div class="md-settings-dropdown-backdrop" data-bd-action="close_display_symbol_background_dropdown" {{on "click" (this.ctrlAction "close_display_symbol_background_dropdown")}} aria-hidden="true"></div>
                        <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Image background color" key="board_detail_prefs_image_background"}}>
                          {{#each this.symbol_background_options as |opt|}}
                            <li role="presentation">
                              <button type="button" role="option" aria-selected={{if (is-equal this.display_prefs_current_symbol_background_id opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.display_prefs_current_symbol_background_id opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_display_symbol_background" opt.id)}}>
                                {{#if (is-equal this.display_prefs_current_symbol_background_id opt.id)}}
                                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                {{else}}
                                  <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                {{/if}}
                                <span>{{opt.label}}</span>
                              </button>
                            </li>
                          {{/each}}
                        </ul>
                      {{/if}}
                    </div>
                  </div>
                </div>
              {{/if}}
            </div>

            {{!-- Board Layout — single accordion that holds two
                 sub-groupings (Grid Gap + Rows & Columns) inside
                 its body. Sub-groupings are visually separated by
                 small uppercase headers and a subtle horizontal
                 rule between them. Same actions/state preserved
                 for both controls (step_display_pref "button_spacing",
                 modify_size, etc.). --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'board-layout') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'board-layout') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "board-layout")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="board-layout" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="1" stroke="currentColor"/>
                    <line x1="3" y1="10" x2="21" y2="10" stroke="#2A9D8F"/>
                    <line x1="10" y1="10" x2="10" y2="21" stroke="#2A9D8F"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Board Layout" key="board_layout"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Layout" key="layout_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'board-layout')}}
                <div class="md-board-edit-right-panel__section-body">
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label md-board-edit-right-panel__row-pair-label--center">{{t "Grid Gap" key="grid_gap"}} <span class="md-board-edit-right-panel__row-pair-label-hint">{{t "(Space between buttons)" key="space_between_buttons_hint"}}</span></span>
                    <div class="md-board-detail-edit-toolbar__stepper md-settings-stepper md-settings-stepper--compact">
                      <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_spacing_at_min}} data-tooltip={{t "Tighter" key="board_detail_settings_tighter"}} aria-label={{t "Tighter" key="board_detail_settings_tighter"}} {{on "click" (this.ctrlAction "step_display_pref" "button_spacing" -1)}}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                      </button>
                      <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_spacing_at_max}} data-tooltip={{t "Looser" key="board_detail_settings_looser"}} aria-label={{t "Looser" key="board_detail_settings_looser"}} {{on "click" (this.ctrlAction "step_display_pref" "button_spacing" 1)}}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                      </button>
                    </div>
                  </div>
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label">{{t "Rows" key="board_detail_rows"}}</span>
                    <div class="md-board-edit-right-panel__stepper">
                      <button type="button" class="md-board-edit-right-panel__stepper-btn" disabled={{this.grid_rows_at_min}} {{on "click" (this.ctrlAction "modify_size" "row" "remove")}} aria-label={{t "Remove Row" key="board_detail_remove_row"}}>−</button>
                      <span class="md-board-edit-right-panel__stepper-value">{{this.model.grid.rows}}</span>
                      <button type="button" class="md-board-edit-right-panel__stepper-btn" {{on "click" (this.ctrlAction "modify_size" "row" "add")}} aria-label={{t "Add Row" key="board_detail_add_row"}}>+</button>
                    </div>
                  </div>
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label">{{t "Columns" key="board_detail_columns"}}</span>
                    <div class="md-board-edit-right-panel__stepper">
                      <button type="button" class="md-board-edit-right-panel__stepper-btn" disabled={{this.grid_cols_at_min}} {{on "click" (this.ctrlAction "modify_size" "column" "remove")}} aria-label={{t "Remove Column" key="board_detail_remove_col"}}>−</button>
                      <span class="md-board-edit-right-panel__stepper-value">{{this.model.grid.columns}}</span>
                      <button type="button" class="md-board-edit-right-panel__stepper-btn" {{on "click" (this.ctrlAction "modify_size" "column" "add")}} aria-label={{t "Add Column" key="board_detail_add_col"}}>+</button>
                    </div>
                  </div>
                </div>
              {{/if}}
            </div>

            {{!-- Board Symbols --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'board-symbols') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'board-symbols') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "board-symbols")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="board-symbols" aria-hidden="true">
                  {{!-- 2x2 grid of distinct shapes — each in its
                       own quadrant with matched visual weight, so
                       the icon reads as a focused "set of symbols"
                       (was a scattered circle/square/tri + tiny
                       extra circle that looked off). --}}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="6.5" cy="6.5" r="3" stroke="#2A9D8F"/>
                    <rect x="13.5" y="3.5" width="6" height="6" rx="0.8" stroke="currentColor"/>
                    <path d="M6.5 14 L10 20.5 L3 20.5 Z" stroke="#2A9D8F"/>
                    <path d="M16.5 13.5 L20 17 L16.5 20.5 L13 17 Z" stroke="currentColor"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Board Symbols" key="board_symbols"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Symbols" key="symbols_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'board-symbols')}}
                <div class="md-board-edit-right-panel__section-body">
                  <p class="md-board-edit-right-panel__hint" style="text-align: center;">{{t "Your preferred symbol library (applies to all your boards)" key="board_symbols_hint_user_scope"}}</p>
                  {{!-- Symbols dropdown — copied verbatim from the
                       center toolbar's Symbols sublabel-wrap so the
                       right panel uses the same custom dropdown
                       (md-settings-select trigger + listbox menu)
                       and shares the exact same actions
                       (toggle_display_symbol_library_dropdown,
                       close_display_symbol_library_dropdown,
                       pick_display_symbol_library) and state binding
                       (display_prefs_symbol_library_dropdown_open). --}}
                  <div class="md-settings-dropdown-wrap">
                    <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_symbol_library_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_symbol_library_dropdown_open "true" "false"}} data-tooltip={{t "Symbol library" key="board_detail_prefs_symbol_library"}} aria-label={{t "Symbol library" key="board_detail_prefs_symbol_library"}} data-bd-action="toggle_display_symbol_library_dropdown" {{on "click" (this.ctrlAction "toggle_display_symbol_library_dropdown")}}>
                      <span class="md-settings-select__value">{{this.display_prefs_current_symbol_library_label}}</span>
                    </button>
                    {{#if this.display_prefs_symbol_library_dropdown_open}}
                      <div class="md-settings-dropdown-backdrop" data-bd-action="close_display_symbol_library_dropdown" {{on "click" (this.ctrlAction "close_display_symbol_library_dropdown")}} aria-hidden="true"></div>
                      <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Symbol library" key="board_detail_prefs_symbol_library"}}>
                        {{#each this.preferred_symbols_options as |opt|}}
                          <li role="presentation">
                            <button type="button" role="option" aria-selected={{if (is-equal this.current_display_prefs.preferred_symbols opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.current_display_prefs.preferred_symbols opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_display_symbol_library" opt.id)}}>
                              {{#if (is-equal this.current_display_prefs.preferred_symbols opt.id)}}
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                              {{else}}
                                <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                              {{/if}}
                              <span>{{opt.label}}</span>
                            </button>
                          </li>
                        {{/each}}
                      </ul>
                    {{/if}}
                  </div>
                </div>
              {{/if}}
            </div>

            {{!-- Customize Menu — lets the user show/hide individual
                 entries on the speak-mode options dropdown (Edit Board,
                 My Boards, Find Boards, etc.). Each row reuses the
                 .nb-toggle__switch chrome from the Colored Folder Front
                 row above for visual consistency. Section headings are
                 rendered as small uppercase labels grouping their
                 child rows (matches the pattern used by the
                 speak-mode menu itself). Persists to
                 user.preferences.speak_mode_hidden_menu_items.
                 Gated behind `customize_menu` feature flag (Scot #1
                 pre-merge review). Currently flag is ON for everyone
                 during testing; will move to per-user beta opt-in
                 once testing completes — see lib/feature_flags.rb
                 comment above AVAILABLE_FRONTEND_FEATURES. --}}
            {{#if this.app_state.feature_flags.customize_menu}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'customize-menu') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'customize-menu') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "customize-menu")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="customize-menu" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="6"  x2="14" y2="6"  stroke="currentColor"/>
                    <line x1="4" y1="12" x2="14" y2="12" stroke="#2A9D8F"/>
                    <line x1="4" y1="18" x2="14" y2="18" stroke="currentColor"/>
                    <circle cx="18" cy="6"  r="1.5" stroke="currentColor"/>
                    <circle cx="18" cy="12" r="1.5" stroke="#2A9D8F" fill="#2A9D8F"/>
                    <circle cx="18" cy="18" r="1.5" stroke="currentColor"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Customize Menu" key="customize_menu"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Menu" key="menu_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'customize-menu')}}
                <div class="md-board-edit-right-panel__section-body">
                  <p class="md-board-edit-right-panel__hint" style="text-align: center;">{{t "Choose which options appear on the speak-mode options menu" key="customize_menu_hint"}}</p>
                  <div class="md-customize-menu">
                    {{#each this.speak_menu_sections_list as |group|}}
                      {{#if group.items.length}}
                        <div class="md-customize-menu__group">
                          {{#if group.section}}
                            <div class="md-customize-menu__group-label">{{t group.section.default_label key=group.section.label_key}}</div>
                          {{/if}}
                          <div class="md-customize-menu__group-card">
                            {{#each group.items as |item|}}
                              <button type="button"
                                role="checkbox"
                                aria-checked={{unless item.hidden "true" "false"}}
                                class="md-customize-menu__row md-customize-menu__row--check {{unless item.hidden 'md-customize-menu__row--checked'}}"
                                {{on "click" (this.ctrlAction "set_speak_menu_item_hidden" item.id (unless item.hidden true false))}}>
                                <span class="md-customize-menu__check" aria-hidden="true">
                                  {{#unless item.hidden}}
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 7"/></svg>
                                  {{/unless}}
                                </span>
                                <span class="md-customize-menu__label" id={{concat "customize-menu-" item.id "-label"}}>{{t item.default_label key=item.label_key}}</span>
                                <span class="md-customize-menu__check-hint {{if item.hidden 'md-customize-menu__check-hint--hidden' 'md-customize-menu__check-hint--shown'}}" aria-label={{if item.hidden (t "Hidden" key="hidden_word") (t "Shown" key="shown_word")}} title={{if item.hidden (t "Hidden" key="hidden_word") (t "Shown" key="shown_word")}}>
                                  {{#if item.hidden}}
                                    {{!-- eye-off glyph: stroked eye outline with a slash through it --}}
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                      <line x1="1" y1="1" x2="23" y2="23"/>
                                    </svg>
                                  {{else}}
                                    {{!-- eye glyph: stroked eye outline with pupil --}}
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                      <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                  {{/if}}
                                </span>
                              </button>
                            {{/each}}
                          </div>
                        </div>
                      {{/if}}
                    {{/each}}
                  </div>
                </div>
              {{/if}}
            </div>
            {{/if}}{{!-- /customize_menu feature flag --}}

            {{!-- Folders --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'folders') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'folders') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "folders")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="folders" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7.5 A1.5 1.5 0 0 1 4.5 6 H9 L11 8 H19.5 A1.5 1.5 0 0 1 21 9.5 V18 A1.5 1.5 0 0 1 19.5 19.5 H4.5 A1.5 1.5 0 0 1 3 18 Z" stroke="currentColor"/>
                    <line x1="7" y1="13" x2="17" y2="13" stroke="#2A9D8F"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Folders" key="folders"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Folders" key="folders"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'folders')}}
                {{!-- Folder controls — surfaced as a labeled radio list
                     (display style) plus an on/off switch (colored
                     front), replacing the prior dropdown + icon-toggle
                     pair. Actions and persistence are unchanged —
                     set_folder_style still writes to
                     user.preferences.folder_display_style and
                     toggle_folder_colored_face still writes
                     user.preferences.folder_colored_face. --}}
                <div class="md-board-edit-right-panel__section-body">
                  <span class="md-board-edit-right-panel__row-pair-label" style="display: block; margin-bottom: 8px;">{{t "Display Style" key="board_detail_folder_display_style_label"}}</span>
                  {{#if this.grouping_active}}
                    {{!-- Succinct, and it names the control that unlocks this. Rendered
                         ABOVE the options so the reason precedes the disabled buttons
                         rather than explaining them after the fact. --}}
                    <p class="md-folder-style-locked-note" id="folder-style-locked-note">{{t "Grouping by category sets folders to Colored Corner. Turn off Categorize above to choose another style." key="board_detail_folder_style_locked_by_grouping"}}</p>
                  {{/if}}
                  <div class="md-folder-style-list" role="radiogroup" aria-label={{t "Folder display style" key="board_detail_folder_style"}} aria-describedby={{if this.grouping_active "folder-style-locked-note"}}>
                    <button type="button" role="radio"
                      aria-checked={{if (is-equal this.effective_folder_display_style "default") "true" "false"}}
                      disabled={{this.grouping_active}}
                      aria-disabled={{if this.grouping_active "true" "false"}}
                      class="md-folder-style-option {{if (is-equal this.effective_folder_display_style 'default') 'md-folder-style-option--active'}} {{if this.grouping_active 'md-folder-style-option--locked'}}"
                      {{on "click" (this.ctrlAction "set_folder_style" "default")}}>
                      <span class="md-folder-style-option__icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z"/></svg>
                      </span>
                      <span class="md-folder-style-option__label">{{t "Default" key="board_detail_folder_default"}}</span>
                      <span class="md-folder-style-option__check" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 7"/></svg>
                      </span>
                    </button>
                    <button type="button" role="radio"
                      aria-checked={{if (is-equal this.effective_folder_display_style "colored_corner") "true" "false"}}
                      disabled={{this.grouping_active}}
                      aria-disabled={{if this.grouping_active "true" "false"}}
                      class="md-folder-style-option {{if (is-equal this.effective_folder_display_style 'colored_corner') 'md-folder-style-option--active'}} {{if this.grouping_active 'md-folder-style-option--locked'}}"
                      {{on "click" (this.ctrlAction "set_folder_style" "colored_corner")}}>
                      <span class="md-folder-style-option__icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M21 3l-6 6" stroke-width="3"/></svg>
                      </span>
                      <span class="md-folder-style-option__label">{{t "Colored Corner Tab" key="board_detail_folder_colored_corner"}}</span>
                      <span class="md-folder-style-option__check" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 7"/></svg>
                      </span>
                    </button>
                    <button type="button" role="radio"
                      aria-checked={{if (is-equal this.effective_folder_display_style "tab_labels") "true" "false"}}
                      disabled={{this.grouping_active}}
                      aria-disabled={{if this.grouping_active "true" "false"}}
                      class="md-folder-style-option {{if (is-equal this.effective_folder_display_style 'tab_labels') 'md-folder-style-option--active'}} {{if this.grouping_active 'md-folder-style-option--locked'}}"
                      {{on "click" (this.ctrlAction "set_folder_style" "tab_labels")}}>
                      <span class="md-folder-style-option__icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
                      </span>
                      <span class="md-folder-style-option__label">{{t "Show Labels on Tab" key="board_detail_folder_tab_labels"}}</span>
                      <span class="md-folder-style-option__check" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 7"/></svg>
                      </span>
                    </button>
                  </div>

                  {{!-- Colored Folder Front: separate setting, applies
                       on top of whichever display style is active.
                       Reuses the .nb-toggle__switch chrome from
                       create-board-new so all switches in the app
                       read the same. --}}
                  <div class="md-folder-toggle-row">
                    <span class="md-folder-toggle-row__label" id="folder-colored-face-label">{{t "Colored Folder Front" key="board_detail_folder_colored_face"}}</span>
                    <div class="md-folder-toggle-row__control">
                      <span class="md-folder-toggle-row__state {{unless this.folder_colored_face 'md-folder-toggle-row__state--active'}}" aria-hidden="true">{{t "Off" key="off"}}</span>
                      <button type="button"
                        role="switch"
                        aria-checked={{if this.folder_colored_face "true" "false"}}
                        aria-labelledby="folder-colored-face-label"
                        class="nb-toggle__switch {{if this.folder_colored_face 'nb-toggle__switch--on'}}"
                        data-bd-action="toggle_folder_colored_face" {{on "click" (this.ctrlAction "toggle_folder_colored_face")}}>
                        <span class="nb-toggle__thumb" aria-hidden="true"></span>
                      </button>
                      <span class="md-folder-toggle-row__state {{if this.folder_colored_face 'md-folder-toggle-row__state--active'}}" aria-hidden="true">{{t "On" key="on"}}</span>
                    </div>
                  </div>
                </div>
              {{/if}}
            </div>

            {{!-- Skin-Tones --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'skin-tones') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'skin-tones') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "skin-tones")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="skin-tones" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" stroke="currentColor"/>
                    <circle cx="9" cy="10" r="1" stroke="#2A9D8F"/>
                    <circle cx="15" cy="10" r="1" stroke="#2A9D8F"/>
                    <path d="M9 15c1 1 2 1.5 3 1.5s2-.5 3-1.5" stroke="#2A9D8F"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Skin-Tones" key="skin_tones"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Skin" key="skin_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'skin-tones')}}
                {{!-- Skin-Tones picker — moved from the center
                     toolbar's Skin-Tones section. Each swatch
                     button uses the same md-settings-skin--*
                     classes (so colors come from existing CSS)
                     and the same set_display_pref / set_compound_skin
                     actions and skin_is_mix / skin_is_mix_only /
                     skin_is_mix_prefer state bindings. Labels are
                     always visible here (panel context) per
                     "make it more user friendly with labels". --}}
                <div class="md-board-edit-right-panel__section-body">
                  <p class="md-board-edit-right-panel__hint">{{t "Preferred skin tone for symbol images" key="skin_tones_hint"}}</p>
                  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 6px; margin-top: 4px;">
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-skin md-settings-skin--original {{if (is-equal this.current_display_prefs.skin 'default') 'md-settings-skin--active'}}" data-tooltip={{t "Original" key="board_detail_settings_skin_original"}} aria-label={{t "Original" key="board_detail_settings_skin_original"}} {{on "click" (this.ctrlAction "set_display_pref" "skin" "default")}}></button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Original" key="skin_label_original"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-skin md-settings-skin--light {{if (is-equal this.current_display_prefs.skin 'light') 'md-settings-skin--active'}}" data-tooltip={{t "Light" key="board_detail_settings_skin_light"}} aria-label={{t "Light" key="board_detail_settings_skin_light"}} {{on "click" (this.ctrlAction "set_display_pref" "skin" "light")}}></button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Light" key="skin_label_light"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-skin md-settings-skin--medium-light {{if (is-equal this.current_display_prefs.skin 'medium-light') 'md-settings-skin--active'}}" data-tooltip={{t "Medium Light" key="board_detail_settings_skin_medium_light"}} aria-label={{t "Medium Light" key="board_detail_settings_skin_medium_light"}} {{on "click" (this.ctrlAction "set_display_pref" "skin" "medium-light")}}></button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Medium Light" key="skin_label_medium_light"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-skin md-settings-skin--medium {{if (is-equal this.current_display_prefs.skin 'medium') 'md-settings-skin--active'}}" data-tooltip={{t "Medium" key="board_detail_settings_skin_medium"}} aria-label={{t "Medium" key="board_detail_settings_skin_medium"}} {{on "click" (this.ctrlAction "set_display_pref" "skin" "medium")}}></button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Medium" key="skin_label_medium"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-skin md-settings-skin--medium-dark {{if (is-equal this.current_display_prefs.skin 'medium-dark') 'md-settings-skin--active'}}" data-tooltip={{t "Medium Dark" key="board_detail_settings_skin_medium_dark"}} aria-label={{t "Medium Dark" key="board_detail_settings_skin_medium_dark"}} {{on "click" (this.ctrlAction "set_display_pref" "skin" "medium-dark")}}></button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Medium Dark" key="skin_label_medium_dark"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-skin md-settings-skin--dark {{if (is-equal this.current_display_prefs.skin 'dark') 'md-settings-skin--active'}}" data-tooltip={{t "Dark" key="board_detail_settings_skin_dark"}} aria-label={{t "Dark" key="board_detail_settings_skin_dark"}} {{on "click" (this.ctrlAction "set_display_pref" "skin" "dark")}}></button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Dark" key="skin_label_dark"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-skin md-settings-skin--mix {{if this.skin_is_mix 'md-settings-skin--active'}}" data-tooltip={{t "Mix of tones" key="board_detail_settings_skin_mix"}} aria-label={{t "Mix of tones" key="board_detail_settings_skin_mix"}} {{on "click" (this.ctrlAction "set_compound_skin" "mix")}}></button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Mix" key="skin_label_mix_short"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-skin md-settings-skin--mix-only {{if this.skin_is_mix_only 'md-settings-skin--active'}}" data-tooltip={{t "Restrict to only the tones you choose" key="board_detail_settings_skin_mix_only"}} aria-label={{t "Restrict to only the tones you choose" key="board_detail_settings_skin_mix_only"}} {{on "click" (this.ctrlAction "set_compound_skin" "mix_only")}}>
                        <span class="md-settings-skin__glyph" aria-hidden="true">&#10003;</span>
                      </button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Only these" key="skin_label_mix_only_short"}}</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                      <button type="button" class="md-settings-skin md-settings-skin--mix-prefer {{if this.skin_is_mix_prefer 'md-settings-skin--active'}}" data-tooltip={{t "Favor certain tones (shows them more often while still mixing others)" key="board_detail_settings_skin_mix_prefer"}} aria-label={{t "Favor certain tones (shows them more often while still mixing others)" key="board_detail_settings_skin_mix_prefer"}} {{on "click" (this.ctrlAction "set_compound_skin" "mix_prefer")}}>
                        <svg class="md-settings-skin__glyph-svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <rect x="3"  y="14" width="4" height="7"  rx="1"/>
                          <rect x="10" y="8"  width="4" height="13" rx="1"/>
                          <rect x="17" y="11" width="4" height="10" rx="1"/>
                        </svg>
                      </button>
                      <span style="font-size: 11px; line-height: 1.2; text-align: center;">{{t "Prefer these" key="skin_label_mix_prefer_short"}}</span>
                    </div>
                  </div>
                  {{#if this.skin_suboptions}}
                    <div class="md-settings-skin-suboptions" style="margin-top: 12px; display: flex; flex-direction: column; align-items: flex-start; gap: 8px;">
                      <span class="md-settings-skin-suboptions__label" style="display: block;">
                        {{#if this.skin_is_mix_only}}
                          {{t "Only these skin-tones:" key="board_detail_skin_only_label_long"}}
                        {{else if this.skin_is_mix_prefer}}
                          {{t "Prefer these skin-tones:" key="board_detail_skin_prefer_label_long"}}
                        {{/if}}
                      </span>
                      <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                        {{#each this.skin_suboptions as |option|}}
                          <label class="md-settings-skin-suboption md-settings-skin-suboption--{{option.id}} {{if option.checked 'md-settings-skin-suboption--checked'}}" data-tooltip={{option.label}} aria-label={{option.label}}>
                            <input id={{concat "rp-skin-sub-" option.id}} name={{concat "rp-skin-sub-" option.id}} type="checkbox" checked={{option.checked}} onchange={{fn this.onToggleSkinSuboption option}} class="md-settings-skin-suboption__input" />
                            <span class="md-settings-skin-suboption__swatch md-settings-skin--{{option.id}}" aria-hidden="true"></span>
                          </label>
                        {{/each}}
                      </div>
                    </div>
                  {{/if}}
                </div>
              {{/if}}
            </div>

            {{!-- Speak Bar --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'speak-bar') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'speak-bar') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "speak-bar")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="speak-bar" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="6" width="20" height="12" rx="2" stroke="currentColor"/>
                    <circle cx="6" cy="12" r="1.2" fill="#2A9D8F" stroke="none"/>
                    <circle cx="10" cy="12" r="1.2" fill="#2A9D8F" stroke="none"/>
                    <circle cx="14" cy="12" r="1.2" fill="#2A9D8F" stroke="none"/>
                    <circle cx="18" cy="12" r="1.2" fill="#2A9D8F" stroke="none"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Speak Bar" key="speak_bar"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Bar" key="speak_bar_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'speak-bar')}}
                <div class="md-board-edit-right-panel__section-body">
                  {{!-- Show on Speak Bar appearance — wrapped in
                       row-pair to share the same outer card
                       background as the Sentence Bar control below. --}}
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label">{{t "Show on Speak Bar as..." key="speak_bar_hint"}}</span>
                    {{!-- Speak bar appearance icongroup — copied verbatim
                         from the center toolbar (line ~1288) so the
                         right panel and center share the same markup,
                         classes, action names, and computed bindings.
                         The .md-settings-icon-btn--active state inside
                         .md-board-edit-right-panel picks up the solid
                         charcoal-blue rule (line ~67930) automatically,
                         matching the active text-position button. --}}
                    <div class="md-settings-icongroup" role="radiogroup" aria-label={{t "Speak bar appearance" key="board_detail_prefs_speak_bar"}}>
                      <button type="button" role="radio" aria-checked={{if (is-equal this.utterance_text_only_str "false") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.utterance_text_only_str 'false') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Show on Speak Bar as... symbol buttons (image with text below)" key="board_detail_settings_speak_bar_symbols"}} aria-label={{t "Show on Speak Bar as... symbol buttons (image with text below)" key="board_detail_settings_speak_bar_symbols"}} {{on "click" (this.ctrlAction "set_utterance_text_only" "false")}}>
                        <span class="md-settings-btnmock"><span class="md-settings-btnmock__img"></span><span class="md-settings-btnmock__text md-settings-btnmock__text--bottom">Aa</span></span>
                      </button>
                      <button type="button" role="radio" aria-checked={{if (is-equal this.utterance_text_only_str "true") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.utterance_text_only_str 'true') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Show on Speak Bar as... words only (text, no symbols)" key="board_detail_settings_speak_bar_words"}} aria-label={{t "Show on Speak Bar as... words only (text, no symbols)" key="board_detail_settings_speak_bar_words"}} {{on "click" (this.ctrlAction "set_utterance_text_only" "true")}}>
                        <span class="md-settings-btnmock"><span class="md-settings-btnmock__text md-settings-btnmock__text--only">Aa</span></span>
                      </button>
                    </div>
                  </div>
                  {{!-- Sentence Bar size dropdown — moved from the
                       center toolbar's display-prefs panel. Drives
                       the height of the speak-mode header and the
                       size of fonts/symbols inside it. Same actions
                       (toggle_display_voice_height_dropdown,
                       close_display_voice_height_dropdown,
                       pick_display_voice_height) and same state
                       bindings (display_prefs_voice_height_dropdown_open,
                       display_prefs_current_voice_height_label,
                       voice_height_options). --}}
                  {{!-- Hide speak bar — collapses the speak row to
                       just the options chevron. Useful for boards
                       where the speak bar's chrome isn't needed.
                       Persists to user.preferences.hide_speak_bar. --}}
                  <div class="md-folder-toggle-row">
                    <span class="md-folder-toggle-row__label" id="hide-speak-bar-label">{{t "Hide speak bar" key="board_detail_hide_speak_bar"}}</span>
                    <div class="md-folder-toggle-row__control">
                      <span class="md-folder-toggle-row__state {{unless this.hide_speak_bar 'md-folder-toggle-row__state--active'}}" aria-hidden="true">{{t "Off" key="off"}}</span>
                      <button type="button"
                        role="switch"
                        aria-checked={{if this.hide_speak_bar "true" "false"}}
                        aria-labelledby="hide-speak-bar-label"
                        class="nb-toggle__switch {{if this.hide_speak_bar 'nb-toggle__switch--on'}}"
                        data-bd-action="toggle_hide_speak_bar" {{on "click" (this.ctrlAction "toggle_hide_speak_bar")}}>
                        <span class="nb-toggle__thumb" aria-hidden="true"></span>
                      </button>
                      <span class="md-folder-toggle-row__state {{if this.hide_speak_bar 'md-folder-toggle-row__state--active'}}" aria-hidden="true">{{t "On" key="on"}}</span>
                    </div>
                  </div>
                  <div class="md-board-edit-right-panel__row-pair">
                    <span class="md-board-edit-right-panel__row-pair-label">{{t "Sentence Bar" key="board_detail_settings_voice_height"}}</span>
                    <div class="md-settings-dropdown-wrap">
                      <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_voice_height_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_voice_height_dropdown_open "true" "false"}} data-tooltip={{t "Height of the speak-mode sentence bar" key="board_detail_prefs_voice_height_tooltip"}} aria-label={{t "Sentence bar size" key="board_detail_prefs_voice_height_aria"}} data-bd-action="toggle_display_voice_height_dropdown" {{on "click" (this.ctrlAction "toggle_display_voice_height_dropdown")}}>
                        <span class="md-settings-select__value">{{this.display_prefs_current_voice_height_label}}</span>
                      </button>
                      {{#if this.display_prefs_voice_height_dropdown_open}}
                        <div class="md-settings-dropdown-backdrop" data-bd-action="close_display_voice_height_dropdown" {{on "click" (this.ctrlAction "close_display_voice_height_dropdown")}} aria-hidden="true"></div>
                        <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Sentence bar size" key="board_detail_prefs_voice_height_aria"}}>
                          {{#each this.voice_height_options as |opt|}}
                            <li role="presentation">
                              <button type="button" role="option" aria-selected={{if (is-equal this.current_display_prefs.vocalization_height opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.current_display_prefs.vocalization_height opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_display_voice_height" opt.id)}}>
                                {{#if (is-equal this.current_display_prefs.vocalization_height opt.id)}}
                                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                {{else}}
                                  <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                {{/if}}
                                <span>{{opt.label}}</span>
                              </button>
                            </li>
                          {{/each}}
                        </ul>
                      {{/if}}
                    </div>
                  </div>
                </div>
              {{/if}}
            </div>

            {{!-- Word Prediction — on/off + placement. These are GLOBAL user
                 preferences (word_suggestions / word_suggestion_position), also
                 surfaced on the Preferences page; this is the in-editor
                 reference. The same toggle_word_suggestions /
                 pick_word_suggestion_position actions persist to the user. --}}
            <div class="md-board-edit-right-panel__section {{if (is-equal this.right_panel_open_section 'word-prediction') 'md-board-edit-right-panel__section--open'}}">
              <button type="button" class="md-board-edit-right-panel__section-toggle" aria-expanded={{if (is-equal this.right_panel_open_section 'word-prediction') "true" "false"}} {{on "click" (this.ctrlAction "toggle_right_panel_section" "word-prediction")}}>
                <span class="md-board-edit-right-panel__section-icon" data-section="word-prediction" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor"/>
                    <circle cx="8.5" cy="11.5" r="1" fill="#2A9D8F" stroke="none"/>
                    <circle cx="12" cy="11.5" r="1" fill="#2A9D8F" stroke="none"/>
                    <circle cx="15.5" cy="11.5" r="1" fill="#2A9D8F" stroke="none"/>
                  </svg>
                </span>
                <span class="md-board-edit-right-panel__section-label">{{t "Word Prediction" key="word_prediction"}}</span>
                <span class="md-board-edit-right-panel__section-label-collapsed">{{t "Predict" key="word_prediction_short"}}</span>
                <svg class="md-board-edit-right-panel__section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              {{#if (is-equal this.right_panel_open_section 'word-prediction')}}
                <div class="md-board-edit-right-panel__section-body">
                  {{!-- On/off (mirrors the "Hide speak bar" switch). --}}
                  <div class="md-folder-toggle-row">
                    <span class="md-folder-toggle-row__label" id="word-prediction-toggle-label">{{t "Show in Speak Mode" key="word_prediction_show"}}</span>
                    <div class="md-folder-toggle-row__control">
                      <span class="md-folder-toggle-row__state {{unless this.word_suggestions_enabled 'md-folder-toggle-row__state--active'}}" aria-hidden="true">{{t "Off" key="off"}}</span>
                      <button type="button"
                        role="switch"
                        aria-checked={{if this.word_suggestions_enabled "true" "false"}}
                        aria-labelledby="word-prediction-toggle-label"
                        class="nb-toggle__switch {{if this.word_suggestions_enabled 'nb-toggle__switch--on'}}"
                        data-bd-action="toggle_word_suggestions" {{on "click" (this.ctrlAction "toggle_word_suggestions")}}>
                        <span class="nb-toggle__thumb" aria-hidden="true"></span>
                      </button>
                      <span class="md-folder-toggle-row__state {{if this.word_suggestions_enabled 'md-folder-toggle-row__state--active'}}" aria-hidden="true">{{t "On" key="on"}}</span>
                    </div>
                  </div>
                  {{!-- Placement (only when on) — dropdown mirroring Sentence Bar size. --}}
                  {{#if this.word_suggestions_enabled}}
                    <div class="md-board-edit-right-panel__row-pair">
                      <span class="md-board-edit-right-panel__row-pair-label">{{t "Position" key="word_prediction_position_short"}}</span>
                      <div class="md-settings-dropdown-wrap">
                        <button type="button" class="md-settings-select md-settings-select--trigger {{if this.word_prediction_position_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.word_prediction_position_dropdown_open "true" "false"}} aria-label={{t "Word prediction position" key="word_prediction_position"}} data-bd-action="toggle_word_prediction_position_dropdown" {{on "click" (this.ctrlAction "toggle_word_prediction_position_dropdown")}}>
                          <span class="md-settings-select__value">{{this.word_prediction_position_label}}</span>
                        </button>
                        {{#if this.word_prediction_position_dropdown_open}}
                          <div class="md-settings-dropdown-backdrop" data-bd-action="close_word_prediction_position_dropdown" {{on "click" (this.ctrlAction "close_word_prediction_position_dropdown")}} aria-hidden="true"></div>
                          <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Word prediction position" key="word_prediction_position"}}>
                            {{#each this.word_prediction_position_options as |opt|}}
                              <li role="presentation">
                                <button type="button" role="option" aria-selected={{if (is-equal this.word_suggestion_position_value opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.word_suggestion_position_value opt.id) 'md-settings-dropdown-item--active'}}" {{on "click" (this.ctrlAction "pick_word_suggestion_position" opt.id)}}>
                                  {{#if (is-equal this.word_suggestion_position_value opt.id)}}
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                  {{else}}
                                    <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                  {{/if}}
                                  <span>{{opt.label}}</span>
                                </button>
                              </li>
                            {{/each}}
                          </ul>
                        {{/if}}
                      </div>
                    </div>
                  {{/if}}
                </div>
              {{/if}}
            </div>

          </div>

          {{!-- Footer divider + Undo / Redo cluster — sits below
               BOARD SETTINGS, anchored to the bottom-right of the
               right panel's body. Same actions as the toolbar
               history cluster (undo_edit / redo_edit) and same
               disabled binding (undo_redo_disabled), so behavior
               matches whichever path the user reaches them from. --}}
          <div class="md-board-edit-right-panel__divider" role="presentation"></div>
          <div class="md-board-edit-right-panel__history">
            <div class="md-board-edit-right-panel__history-group" role="group" aria-label={{t "Edit history" key="edit_history_aria"}}>
              <button type="button"
                class="md-board-edit-right-panel__history-btn"
                disabled={{this.undo_redo_disabled}}
                data-tooltip={{t "Undo" key="board_detail_undo"}}
                aria-label={{t "Undo" key="board_detail_undo"}}
                data-bd-action="undo_edit" {{on "click" (this.ctrlAction "undo_edit")}}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="1 4 1 10 7 10" stroke="#2A9D8F"/>
                  <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" stroke="currentColor"/>
                </svg>
                <span>{{t "Undo" key="board_detail_undo"}}</span>
              </button>
              <button type="button"
                class="md-board-edit-right-panel__history-btn"
                disabled={{this.undo_redo_disabled}}
                data-tooltip={{t "Redo" key="board_detail_redo"}}
                aria-label={{t "Redo" key="board_detail_redo"}}
                data-bd-action="redo_edit" {{on "click" (this.ctrlAction "redo_edit")}}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="23 4 23 10 17 10" stroke="#2A9D8F"/>
                  <path d="M20.49 15a9 9 0 1 1-2.13-9.36L23 10" stroke="currentColor"/>
                </svg>
                <span>{{t "Redo" key="board_detail_redo"}}</span>
              </button>
            </div>
          </div>

          {{!-- Back button — only while a section is open (the panel
               is collapsed to that one section by the :has() rule).
               Passing the currently-open id to toggle_right_panel_section
               clears it, restoring the full section list. --}}
          {{#if this.right_panel_open_section}}
            <div class="md-board-edit-right-panel__divider" role="presentation"></div>
            <button type="button"
              class="md-board-edit-right-panel__back"
              aria-label={{t "Expand panel" key="expand_panel"}}
              data-bd-action="expand_right_panel" {{on "click" (this.ctrlAction "expand_right_panel")}}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="11 17 6 12 11 7"/>
                <polyline points="18 17 13 12 18 7"/>
              </svg>
              <span class="md-board-edit-right-panel__back-label">{{t "Back" key="board_detail_back"}}</span>
            </button>
          {{/if}}

          <div class="md-board-edit-right-panel__divider" role="presentation"></div>

        </div>
      </aside>
    {{/if}}

    {{!-- Right Sidebar --}}
    {{#unless this.model.integration}}
    <aside class="md-board-detail-right-panel {{if this.panels_collapsed 'md-board-detail-right-panel--collapsed'}}" aria-label={{t "Activity panel" key="board_detail_activity_panel"}}>
      {{!-- Collapse the side panels — visible only when expanded; hides when right panel is collapsed (width:0). --}}
      <button type="button"
        class="md-board-detail-collapse-btn md-board-detail-collapse-btn--side md-board-detail-collapse-btn--side-right"
        title={{t "Collapse Side Panels" key="board_detail_collapse_side_panels"}}
        aria-label={{t "Collapse Side Panels" key="board_detail_collapse_side_panels"}}
        data-bd-action="toggle_panels" {{on "click" (this.ctrlAction "toggle_panels")}}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      {{!-- Recent Phrases --}}
      <section class="md-board-detail-right-panel__section">
        <h3 class="md-board-detail-right-panel__heading">{{t "Recent Phrases" key="board_detail_recent_phrases"}}</h3>
        {{#if this.recent_phrases.length}}
          <ul class="md-board-detail-phrase-list">
            {{#each this.recent_phrases as |phrase|}}
              <li class="md-board-detail-phrase-list__item" {{on "click" (this.ctrlAction "speak_phrase" phrase)}}>
                <span class="md-board-detail-phrase-list__dot" aria-hidden="true"></span>
                {{phrase.text}}
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="md-board-detail-right-panel__empty">{{t "Phrases appear here" key="board_detail_phrases_empty"}}</p>
        {{/if}}
      </section>

      {{!-- Weekly Goals --}}
      <section class="md-board-detail-right-panel__section">
        <h3 class="md-board-detail-right-panel__heading">{{t "Weekly Goals" key="board_detail_weekly_goals"}}</h3>
        {{#if this.weekly_goals.length}}
          <ul class="md-board-detail-goals-list">
            {{#each this.weekly_goals as |goal|}}
              <li class="md-board-detail-goals-list__item">
                <div class="md-board-detail-goals-list__header">
                  <span class="md-board-detail-goals-list__label">{{goal.label}}</span>
                  <span class="md-board-detail-goals-list__count">{{goal.current}} / {{goal.target}}</span>
                </div>
                <div class="md-board-detail-goals-list__bar">
                  <div class="md-board-detail-goals-list__fill md-board-detail-goals-list__fill--{{goal.color}}" style={{safe-style (concat "width:" goal.percent "%")}}></div>
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="md-board-detail-right-panel__empty">{{t "No goals set yet" key="board_detail_no_goals"}}</p>
        {{/if}}
      </section>

      {{!-- Today's Schedule --}}
      <section class="md-board-detail-right-panel__section">
        <h3 class="md-board-detail-right-panel__heading">{{t "Today's Schedule" key="board_detail_todays_schedule"}}</h3>
        {{#if this.todays_schedule.length}}
          <ul class="md-board-detail-schedule-list">
            {{#each this.todays_schedule as |event|}}
              <li class="md-board-detail-schedule-list__item">
                <span class="md-board-detail-schedule-list__time">{{event.time}}</span>
                <div class="md-board-detail-schedule-list__info">
                  <span class="md-board-detail-schedule-list__name">{{event.name}}</span>
                  <span class="md-board-detail-schedule-list__type md-board-detail-schedule-list__type--{{event.type_class}}">{{event.type}}</span>
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="md-board-detail-right-panel__empty">{{t "No events scheduled" key="board_detail_no_events"}}</p>
        {{/if}}
      </section>
    </aside>
    {{/unless}}
  </div>

  {{!-- Pinned My Board Collection drawer — a SIBLING of .md-board-detail-layout
       (top-level in the shell), NOT inside it. The layout's right-padding
       (md-shell--board-collection) pushes the board content left, while this
       fixed drawer stays pinned at the true viewport right edge and overlays the
       freed gap. (When the drawer lived inside the layout, the layout's padding
       + containing block dragged it left too.) Opened from the speak-mode options
       menu; PERSISTS across board taps (select loads the board in the grid on the
       left, drawer stays); "Back to Speak Mode" (close_board_collection) unpins
       onto the last-selected board. No modal backdrop → the grid stays interactive. --}}
  {{#if this.board_collection_open}}
    <div class="md-board-detail-actions-menu md-board-detail-actions-menu--collection md-board-detail-actions-menu--collection-pinned" role="region" aria-label={{t "My Board Collection" key="my_board_collection"}}>
      <BoardCollection
        @onBack={{this.onCloseBoardCollection}}
        @onSelect={{this.onSelectBoardFromCollection}}
        @currentBoard={{this.model}} />
    </div>
  {{/if}}
  {{!-- Edit-mode Board Collections drawer — same pinned host as the speak-mode
       collection, but the --collection-left modifier pins it to the LEFT edge (the
       edit rail hides and it takes its place) and the shell pushes the center right.
       Selecting a board loads it into the center in edit mode. --}}
  {{#if this.edit_board_collection_open}}
    <div class="md-board-detail-actions-menu md-board-detail-actions-menu--collection md-board-detail-actions-menu--collection-pinned md-board-detail-actions-menu--collection-left" role="region" aria-label={{t "Board Collections" key="board_collections"}}>
      <BoardCollection
        @onBack={{this.onCloseEditBoardCollection}}
        @onSelect={{this.onSelectBoardFromCollectionEdit}}
        @originalBoard={{this.edit_collection_original_board}}
        @editContext={{true}} />
    </div>
  {{/if}}
  {{!-- Edit Sidebar panel — same pinned-drawer host as My Board Collection. Gated
        on the edit_sidebar feature flag (matches the inline Edit button) so the
        whole surface is beta-opt-in. --}}
  {{#if this.app_state.feature_flags.edit_sidebar}}
    {{#if this.sidebar_editor_open}}
      <div class="md-board-detail-actions-menu md-board-detail-actions-menu--collection md-board-detail-actions-menu--collection-pinned md-board-detail-actions-menu--sidebar-editor" role="region" aria-label={{t "Edit Sidebar" key="edit_sidebar"}}>
        <SidebarEditor @onBack={{this.onCloseSidebarEditor}} />
      </div>
    {{/if}}
  {{/if}}

  {{!-- CATEGORY ORDER PANEL — full-width takeover.
        Rendered last in the shell and positioned over the layout, so opening it
        needs no surgery on the edit page's three-column grid. The preview uses
        the SAME BoardDetailGrid the live board uses, with @forceGrouping, so what
        is previewed cannot drift from what ships; @editMode is deliberately false
        so the preview is not draggable and the real board's drag/swap/paint
        behaviour is untouched. --}}
  {{!-- GATED ON edit_mode. This block sits at shell level, so without the gate the
       Categorize takeover — position:absolute, inset:0, opaque — kept rendering over the
       SPEAK board after leaving edit mode by any path other than its own Done button,
       and its live preview would repaint real board buttons outside an edit session,
       with no Save, Cancel or undo. --}}
  {{#if (and this.edit_mode this.category_order_open)}}
    <div class="md-board-category-order" id="board-category-order-panel" role="region" aria-label={{t "Categorize board" key="board_categorize_panel"}}>
      {{!-- HEADER + two option cards, not one horizontal row.
           The row treated the primary switch, two sub-options, an explanatory
           paragraph, an accessibility note and both page-level actions as six peers on
           one line, which is what made it read as clutter. Now: a titled header that
           owns Reset/Done, then one card per setting, with a setting's own sub-option
           NESTED inside its card so hierarchy is carried by structure rather than by
           reading order.
           The cards sit SIDE BY SIDE and wrap, rather than stacking as drawn: this bar
           is `flex: 0 0 auto` above the order list and the live preview, so every pixel
           it takes comes out of the preview. Side-by-side keeps the grouping without
           halving the thing the panel exists to show. --}}
      <div class="md-board-category-order__bar">
        {{!-- The header IS the grouping setting. It used to carry a panel title and a
             subtitle ("Button organization" / "Control how buttons are grouped and
             navigated.") that only restated what the panel obviously is, and the setting that
             decides whether ANY of it applies sat below in a strip beside two sub-settings of
             its own. Grouping now owns the header — heading, description and switch — and the
             strip holds only the two settings that depend on it. --}}
        <div class="md-board-category-order__head">
          <div class="md-board-category-order__head-text">
            <h2 class="md-board-category-order__title" id="bd-cat-group-title">{{t "Group by category" key="board_categorize_group_title"}}</h2>
            <p class="md-board-category-order__subtitle" id="bd-cat-group-desc">{{t "Organize buttons into category groups." key="board_categorize_group_desc"}}</p>
          </div>
          {{!-- The long explanation, same disclosure the strip settings use. --}}
          <details class="md-board-category-order__info">
            <summary class="md-board-category-order__info-btn" aria-label={{t "More information about grouping by category" key="board_categorize_group_info_label"}}>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            </summary>
            <p class="md-board-category-order__info-body">
              {{#if this.categorize_enabled}}
                {{t "Organize this board's buttons into ordered category groups. Use the arrows below to change the order." key="board_categorize_group_hint"}}
              {{else}}
                {{t "Grouping is off. This board's buttons are shown in their original order." key="board_categorize_group_hint_off"}}
              {{/if}}
            </p>
          </details>
          <label class="md-board-category-order__onoff md-board-category-order__onoff--master" for="bd-cat-group">
            <span class="md-board-category-order__onoff-word {{unless this.categorize_switch_on "md-board-category-order__onoff-word--active"}}" aria-hidden="true">{{t "Off" key="off"}}</span>
            <span class="md-board-category-order__switch-wrap md-board-category-order__switch-wrap--master">
              <input id="bd-cat-group" type="checkbox" data-bd-control="categorize" checked={{this.categorize_switch_on}} {{on "change" (this.ctrlAction "toggle_categorize")}} aria-describedby="bd-cat-group-desc">
              <span class="md-board-category-order__switch {{unless this.categorize_switch_on "md-board-category-order__switch--off"}}" aria-hidden="true"><span class="md-board-category-order__switch-knob"></span></span>
            </span>
            <span class="md-board-category-order__onoff-word {{if this.categorize_switch_on "md-board-category-order__onoff-word--active"}}" aria-hidden="true">{{t "On" key="on"}}</span>
          </label>
          {{!-- Page-level actions live in the header, where they are expected — beside
               the panel title rather than at the end of a settings row. --}}
          <div class="md-board-category-order__bar-actions">
            {{!-- Nested, not `(and …)`: Reset needs BOTH. The order list it resets is only
                 rendered while grouping is on, so offering it with grouping off is a
                 button pointing at nothing; and offering it on an order nobody has
                 changed is a button that does nothing. --}}
            {{!-- Reset order rides with the ordering list below: both are gated on
                 `category_ordering_available`, which is off while category ORDERING is
                 parked as a future feature. Resetting an order the user cannot see or
                 change is a button pointing at nothing. --}}
            {{#if this.category_ordering_available}}
            {{#if this.categorize_enabled}}
            {{#if this.category_order_changed}}
              <button type="button" class="md-board-category-order__reset" data-bd-action="reset_category_order" {{on "click" (this.ctrlAction "reset_category_order")}}>{{t "Reset order" key="board_categorize_reset"}}</button>
            {{/if}}
            {{/if}}
            {{/if}}
            {{!-- Done wears the edit bar's SAVE styling, classes and all, rather than a
                 lookalike: same pill, same raised slate, same two-tone check in its badge.
                 Reusing `md-board-edit-session__btn--save` means the two cannot drift.
                 `md-board-category-order__close` stays as the behaviour hook (probes and the
                 focus rule key off it) but no longer carries any paint of its own. --}}
            <button type="button" class="md-board-category-order__close md-board-edit-session__btn md-board-edit-session__btn--save" data-bd-action="toggle_category_order" {{on "click" (this.ctrlAction "toggle_category_order")}}>
              <span class="md-board-edit-session__btn-badge" aria-hidden="true">
                <svg class="md-board-edit-session__btn-icon" viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17.5" stroke="#cdd6e3"/><path d="M10 17.5 19 7" stroke="#8fe4df"/></svg>
              </span>
              <span class="md-board-edit-session__btn-label">{{t "Done" key="done"}}</span>
            </button>
          </div>
        </div>

        {{!-- ONE settings strip, not a card per setting. The three settings were two glass
             cards holding a switch, a paragraph of body copy, a nested sub-option and a
             permanent amber advisory — ~250px of chrome above the thing the panel exists to
             show. They are three peer decisions, so they get three equal columns of one
             strip: title, one-line description, switch. The long explanations moved into the
             per-setting disclosures below, and the advisory now appears only in the state it
             is advising about. --}}
          {{!-- The switch paints `categorize_switch_on` (the user's INTENT), NOT
               `categorize_enabled` (the stored value that drives the regroup). Flipping
               grouping re-renders the whole board grid, which blocks the main thread long
               enough on a tablet that nothing repainted — including this control — and the
               click read as ignored. Intent paints in the current frame; the regroup is
               applied one frame later (controller#toggle_categorize).
               OFF/ON words either side of the track, unlike the two switches in the strip:
               this one governs the whole panel, so it states its value in words as well as by
               knob position. `aria-hidden` on both — the checkbox already announces its own
               checked state, and reading "Off Group by category On" would be worse, not
               better. --}}
        {{!-- The two settings that only mean something while grouping is on. Both are
             DISABLED rather than removed when it is off: removing them silently changed the
             strip's height and read as the settings having been taken away. `disabled` keeps
             them in the accessibility tree, announced as unavailable; the dimming says the
             same thing visually. The stored preferences are untouched either way. --}}
        <div class="md-board-category-order__strip">
          {{!-- Scrolling. Also gated on grouping: `category_scroll_enabled` is ANDed with
               `grouping_active` in the controller, so with grouping off this preference
               changes nothing about how the board draws. --}}
          <div class="md-board-category-order__setting {{unless this.categorize_enabled "md-board-category-order__inactive"}}">
            <div class="md-board-category-order__row">
              <span class="md-board-category-order__row-text">
                <label class="md-board-category-order__row-label" for="bd-cat-scroll">{{t "Board scrolling" key="board_categorize_scroll_title"}}</label>
                <span class="md-board-category-order__row-desc" id="bd-cat-scroll-desc">{{t "Allow page scrolling for larger boards." key="board_categorize_scroll_desc"}}</span>
              </span>
              <details class="md-board-category-order__info">
                <summary class="md-board-category-order__info-btn" aria-label={{t "More information about board scrolling" key="board_categorize_scroll_info_label"}}>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                </summary>
                <p class="md-board-category-order__info-body">
                  {{t "Allow the board to scroll vertically. With it off, the board is sized to fit the current view." key="board_categorize_scroll_hint_full"}}
                </p>
              </details>
              <span class="md-board-category-order__switch-wrap">
                <input id="bd-cat-scroll" type="checkbox" data-bd-control="category_scroll" checked={{this.category_vertical_scroll}} disabled={{not this.categorize_enabled}} {{on "change" (this.ctrlAction "toggle_category_scroll")}} aria-describedby="bd-cat-scroll-desc{{if this.category_vertical_scroll " bd-cat-scroll-note"}}">
                <span class="md-board-category-order__switch {{unless this.category_vertical_scroll "md-board-category-order__switch--off"}}" aria-hidden="true"><span class="md-board-category-order__switch-knob"></span></span>
              </span>
            </div>
            {{!-- Only in the state it is advising ABOUT. A permanent advisory reserved a line
                 of height in every state and read as a live warning even beside a switch that
                 was already off. Icon AND wording carry the meaning, so it does not rest on
                 the amber alone.
                 BELOW the row rather than inside the text block, which is where it started:
                 in the text block it shares the column with the info button and the switch,
                 which is ~100px narrower, and the sentence wrapped to two lines — measured at
                 106px of strip against 92px out here. Only this column grows either way
                 (`align-self: start` on the setting). --}}
            {{#if this.category_vertical_scroll}}
              <p class="md-board-category-order__advisory" id="bd-cat-scroll-note">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                <span>{{t "Not recommended for switch, dwell, or head-pointer access." key="board_categorize_scroll_warning_on"}}</span>
              </p>
            {{/if}}
          </div>

          {{!-- Category labels only exist while the board SCROLLS. With scrolling off the
               board is tiled to fit the screen and the tiles carry no headers at all (the
               `--compact` rule hides them), so the setting would be a switch with nothing to
               switch. Gated in the template rather than dimmed, so it leaves the tab order
               too — and the strip drops to one column with it, which takes its left divider
               with it. --}}
          {{#if this.category_vertical_scroll}}
          <div class="md-board-category-order__setting {{unless this.categorize_enabled "md-board-category-order__inactive"}}">
            <div class="md-board-category-order__row">
              <span class="md-board-category-order__row-text">
                <label class="md-board-category-order__row-label" for="bd-cat-labels">{{t "Show category labels" key="board_categorize_show_labels"}}</label>
                <span class="md-board-category-order__row-desc" id="bd-cat-labels-desc">{{t "Display a heading above each group." key="board_categorize_show_labels_desc"}}</span>
              </span>
              <span class="md-board-category-order__switch-wrap">
                <input id="bd-cat-labels" type="checkbox" data-bd-control="category_names" checked={{this.category_names_visible}} disabled={{not this.categorize_enabled}} {{on "change" (this.ctrlAction "toggle_category_names")}} aria-describedby="bd-cat-labels-desc">
                <span class="md-board-category-order__switch {{unless this.category_names_visible "md-board-category-order__switch--off"}}" aria-hidden="true"><span class="md-board-category-order__switch-knob"></span></span>
              </span>
            </div>
          </div>
          {{/if}}
        </div>
      </div>

      <div class="md-board-category-order__body">
        {{!-- Order list only while categorizing is on: with it off the board is not
             grouped, so a category SEQUENCE has nothing to sequence. Gated in the
             template rather than hidden in CSS so it leaves the accessibility tree
             and the tab order too, instead of being invisible tab stops.
             ALSO gated on `category_ordering_available` — category ordering is parked as a
             future feature, so the list and its Reset button are not rendered at all. The
             live preview beside it stays: it shows the board the two settings above act on,
             which is useful with or without ordering. --}}
        {{#if (and this.category_ordering_available this.categorize_enabled)}}
        <ol class="md-board-category-order__list" aria-label={{t "Category order" key="board_category_order"}}>
          {{#each this.category_order_list as |cat|}}
            <li class="md-board-category-order__item" style={{safe-style (concat "--bd-group-fill:var(" cat.fillVar ");--bd-group-text:var(" cat.textVar ")")}}>
              <span class="md-board-category-order__swatch" aria-hidden="true"></span>
              <span class="md-board-category-order__name">{{cat.label}}</span>
              <span class="md-board-category-order__controls">
                <button type="button" class="md-board-category-order__move" disabled={{cat.first}}
                  aria-label={{concat (t "Move up" key="move_up") " " cat.label}}
                  {{on "click" (this.ctrlAction "move_category" cat.key "up")}}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"></polyline></svg>
                </button>
                <button type="button" class="md-board-category-order__move" disabled={{cat.last}}
                  aria-label={{concat (t "Move down" key="move_down") " " cat.label}}
                  {{on "click" (this.ctrlAction "move_category" cat.key "down")}}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
              </span>
            </li>
          {{/each}}
        </ol>
        {{/if}}

        <div class="md-board-category-order__preview {{if this.categorize_preview_loading 'md-board-category-order__preview--loading'}}">
          {{!-- Shown for the one frame (or the few seconds, on a slow device) between the
               switch painting and the regrouped board being ready. The grid below is
               HIDDEN BY CSS while this shows (`--loading`), deliberately NOT unmounted:
               an `{{#if}}` around it destroyed and rebuilt all ~84 button components on
               every toggle, which added render work to the very transition this change
               exists to speed up — measured as a regression in the Categorize probe at
               6x CPU throttle. Hiding keeps the components alive, so only the CSS
               changes and the user still never sees the stale arrangement.
               role=status + aria-live=polite so it is announced without stealing focus;
               the switch itself already announced the state change. --}}
          {{!-- selectButton is wired to the move picker rather than to activation:
                inside this panel, tapping a button means "move this one", not
                "speak this one".
                GATED ON THE SWITCH: with categorizing off the preview is the plain,
                ungrouped board and there are no categories on screen, so offering to
                "move this button to a category" has nothing to point at. Passing no
                handler is enough — BoardDetailGrid#invokeAttr no-ops when the action
                is falsy (board-detail-grid.js:169-177) — and the action itself also
                guards, so neither path can open the picker on its own. --}}
          {{#if this.categorize_preview_loading}}
            <p class="md-board-category-order__preview-loading" role="status" aria-live="polite">{{t "Updating categories..." key="board_categorize_loading"}}</p>
          {{/if}}
          <BoardDetailGrid
            @board={{this.model}}
            @orderedButtons={{this.ordered_buttons}}
            {{!-- Follows the switch. Hard-coding this to `true` made the preview
                  lie: unchecking Categorize saved the preference but the preview
                  stayed grouped, because `forceGrouping` short-circuits
                  BoardDetailGrid#groupingEnabled before it consults the
                  preference. Bound, the off state falls through to the preference
                  (editMode is false here) and renders the original board. --}}
            @forceGrouping={{this.categorize_enabled}}
            @selectButton={{if this.categorize_enabled (this.ctrlAction "begin_category_move")}}
            @editMode={{false}}
            {{!-- Folder treatment MUST be passed here or the preview lies. While grouping
                 is on, `effective_folder_display_style` (controller :3314) pins the style
                 to colored_corner — DERIVED, so the user's stored `folder_display_style`
                 is never rewritten and returns the moment grouping goes off. The real
                 board passes these three; the preview did not, so it rendered the DEFAULT
                 folder treatment instead of the colored corners that actually ship.
                 It also fitted LOOSER than the real board: the folder-tab top reserve
                 (app.scss:83604) is skipped for `--folder-colored-corner`, so without the
                 class the preview kept a reserve the shipped board drops — every cell
                 padded down by `--bd-cell-min * 0.14` for tabs that are not there. --}}
            @folderLabelsOnTab={{this.folder_labels_on_tab}}
            @folderColoredCorner={{this.folder_colored_corner}}
            @folderColoredFace={{this.folder_colored_face}}
            {{!-- The preview must show what SHIPS, including whether category names
                 render — that is the whole point of a live preview. --}}
            @categoryEnabled={{this.categorize_enabled}}
            @showCategoryNames={{this.show_category_names}}
            @categoryScrollEnabled={{this.category_scroll_enabled}}
            @softBorders={{this.soft_borders}}
            @buttonTextSizeClass={{this.button_text_size_class}}
            @buttonTextPositionClass={{this.button_text_position_class}}
            @hiddenButtonsClass={{this.hidden_buttons_class}}
            @symbolBackgroundClass={{this.symbol_background_class}}
            @highContrastClass={{this.high_contrast_class}}
            @buttonShapeClass={{this.button_shape_class}}
            @gridStyle={{this.grid_style}}
            @buttonTextSizePx={{this.button_text_size_px}}
            @buttonSpacingPx={{this.button_spacing_px}}
            @buttonBorderPx={{this.button_border_px}}
            @buttonFontStyle={{this.button_font_style}} />
        </div>
      </div>

      {{!-- MOVE-TO-CATEGORY PICKER. Moving a button between categories RECOLOURS
            it on the real board — the category is derived from the colour — so
            the swatch beside each name is the colour the button will become, not
            decoration. This is a board edit and follows the board's Save/Cancel,
            unlike the category order above it. --}}
      {{#if this.category_move_button}}
        <div class="md-board-category-order__picker-backdrop" data-bd-action="cancel_category_move" {{on "click" (this.ctrlAction "cancel_category_move")}}></div>
        <div class="md-board-category-order__picker" role="dialog" aria-modal="true" aria-label={{t "Move button to a category" key="board_move_button_category"}}>
          <div class="md-board-category-order__picker-head">
            <span class="md-board-category-order__picker-title">
              {{t "Move" key="move"}} “{{or this.category_move_button.label this.category_move_button.vocalization}}”
            </span>
            <button type="button" class="md-board-category-order__picker-close" data-bd-action="cancel_category_move" {{on "click" (this.ctrlAction "cancel_category_move")}} aria-label={{t "Cancel" key="cancel"}}>×</button>
          </div>
          <p class="md-board-category-order__picker-note">{{t "This changes the button's color on the board." key="board_move_button_recolors"}}</p>
          <div class="md-board-category-order__picker-list">
            {{!-- category_move_targets, not category_order_list: two registry categories
                 have no paintable colour and silently no-op as destinations. --}}
            {{#each this.category_move_targets as |cat|}}
              <button type="button" class="md-board-category-order__picker-item"
                style={{safe-style (concat "--bd-group-fill:var(" cat.fillVar ")")}}
                {{on "click" (this.ctrlAction "move_button_to_category" cat.key)}}>
                <span class="md-board-category-order__swatch" aria-hidden="true"></span>
                <span class="md-board-category-order__name">{{cat.label}}</span>
              </button>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </div>
  {{/if}}
</div>

