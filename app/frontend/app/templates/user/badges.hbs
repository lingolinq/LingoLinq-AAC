{{#if this.app_state.currentUser.modeling_only}}
  <ModelingOnlyNotice />
{{else if this.model.currently_premium}}
  <div class="md-badges">
    <header class="md-badges__hero">
      <h2 class="md-badges__title">{{t "Current Badges" key="current_badges"}}</h2>
      <p class="md-badges__sub">{{t "Milestones earned as this communicator works toward their goals." key="badges_subtitle"}}</p>
    </header>

    {{#if this.badges.loading}}
      <p class="md-badges__note">{{t "Loading badges..." key="loading_badges"}}</p>
    {{else if this.badges.error}}
      <p class="md-badges__note">{{t "Badges failed to load" key="badges_failed_to_load"}}</p>
    {{else if this.badges}}
      <div class="md-badges__grid">
        {{#each this.badges as |badge|}}
          <article class="md-badge {{if badge.earned "is-earned"}}">
            {{#if this.user.permissions.edit}}
              {{#if badge.earned}}
                {{#if badge.highlighted}}
                  <button type="button" class="md-badge__star is-on" {{on "click" (this.ctrlAction "highlight_badge" badge false)}} title={{t "un-highlight badge" key="unhighlight_badge"}} aria-label={{t "un-highlight badge" key="unhighlight_badge"}}>
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  </button>
                {{else}}
                  <button type="button" class="md-badge__star" {{on "click" (this.ctrlAction "highlight_badge" badge true)}} title={{t "highlight badge" key="highlight_badge"}} aria-label={{t "highlight badge" key="highlight_badge"}}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  </button>
                {{/if}}
              {{/if}}
            {{/if}}

            <button type="button" class="md-badge__image-btn" {{on "click" (this.ctrlAction "badge_popup" badge)}} aria-label={{badge.name}}>
              <img src={{badge.image_url}} class="md-badge__image" alt="">
              {{#if badge.earned}}<span class="md-badge__spark" aria-hidden="true">&#10022;</span>{{/if}}
            </button>

            <h3 class="md-badge__name">
              {{#if badge.global}}
                <LinkTo @route="goals.goal" @model={{badge.goal_id}}>{{badge.name}}</LinkTo>
              {{else}}
                <LinkTo @route="user.goal" @models={{array this.model.user_name badge.goal_id}}>{{badge.name}}</LinkTo>
              {{/if}}
            </h3>

            {{#if badge.earned}}
              <span class="md-badge__earned">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {{t "Earned!" key="earned"}}
              </span>
            {{else}}
              <div class="md-badge__progress" role="progressbar" aria-valuenow={{badge.progress_out_of_100}} aria-valuemin="0" aria-valuemax="100">
                <div class="md-badge__bar" style={{badge.progress_style}}></div>
              </div>
            {{/if}}

            <span class="md-badge__level">{{t "Level %{level}" level=badge.level key="level_n"}}</span>
            <p class="md-badge__hint">
              {{#if badge.earned}}
                {{#if badge.max_level}}
                  {{t "Great job, you've completed all levels of this badge!" key="all_levels_completed"}}
                {{else}}
                  {{t "Keep at it, there's another level of this badge to unlock!" key="more_levels_to_unlock"}}
                {{/if}}
              {{else}}
                {{t "Keep working to unlock this badge!" key="keep_working_on_badge"}}
              {{/if}}
            </p>
          </article>
        {{/each}}
      </div>
    {{else}}
      <p class="md-badges__empty">{{t "No badges earned yet" key="no_badges_earned_yet"}}</p>
    {{/if}}
  </div>
{{else if this.session.isAuthenticated}}
  <div class="md-badges">
    <section class="md-badges__gate">
      <h2 class="md-badges__title">{{t "Premium Membership Required" key="premium_required"}}</h2>
      <p class="md-badges__gate-text">
        {{t "%app_name% is a powerful, flexible communication tool with lots of great features. Some features, including this one, are only available to users who have purchased a premium account. Please " key="purchase_subscription_1d"}}
        {{#if this.app_state.feature_flags.subscriptions}}
          <LinkTo @route="user.subscription" @model={{this.model.user_name}}>{{t "purchase a premium account" key="purchase_subscription_2"}}</LinkTo>
        {{else}}
          {{t "purchase a premium account" key="purchase_subscription_2"}}
        {{/if}}
        {{t "to support this good cause and to unlock this feature." key="purchase_subscription_3"}}
      </p>
    </section>
  </div>
{{else}}
  <LoginForm @left={{true}} @prompt={{true}} @return={{true}} />
{{/if}}
