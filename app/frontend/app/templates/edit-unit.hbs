{{#modal-dialog action=(action "close") opening=(action "opening") closing=(action "closing")}}
  <form class="md-modal-form md-edit-unit" {{action "save" on="submit"}}>
    <div class="modal-header md-modal-header">
      <button type="button" class="close" {{action "close"}} aria-label={{t "Close" key="close"}}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <h3 class="md-modal-title">{{t "Edit Room Details" key="edit_room_details"}}</h3>
    </div>
    <div class="modal-body md-modal-body">
      {{#unless this.model.curriculum_only}}
        <div class="md-modal-field">
          <label for="name" class="md-modal-label">{{t "Name" key="name"}}</label>
          <Input @value={{this.model.unit.name}} class="form-control" id="name" placeholder="Room Name" />
        </div>
      {{else}}
        <p class="md-modal-hint">
          {{t "Each room can have its own list of assigned cirruclum. These can be links to any topics or material the room is curretly focused on. Any curriculum set will be available to all room communicators." key="curriculum_explainer"}}
        </p>
      {{/unless}}
      <div class="md-modal-field">
        <label class="md-modal-label">{{t "Curriculum" key="curriculum"}}</label>
        <div class="md-edit-unit-curriculum">
          {{#each this.model.unit.topics as |row|}}
            <div class="md-edit-unit-curriculum__row">
              <Input @value={{row.title}} class="form-control md-edit-unit-curriculum__title" placeholder="topic" />
              <Input @value={{row.url}} class="form-control md-edit-unit-curriculum__url" placeholder="https://" />
              <button type="button" class="md-edit-unit-curriculum__remove" {{action "remove_curriculum_row" row}} aria-label={{t "Remove curriculum row" key="remove_curriculum_row"}} title={{t "Remove" key="remove"}}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </div>
          {{/each}}
          <button type="button" class="md-edit-unit-curriculum__add" {{action "add_curriculum_row"}}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>{{t "Add Row" key="add_row_lower"}}</span>
          </button>
        </div>
      </div>
      {{#if this.error}}
        <p class="md-modal-error">{{t "There was an unexpected error while updating the room" key="error_updating_room"}}</p>
      {{/if}}
    </div>
    <div class="modal-footer md-modal-footer">
      <button type="button" class="btn md-modal-btn md-modal-btn--cancel" {{action "close"}}>{{t "Cancel" key="cancel"}}</button>
      <button type="submit" class="btn md-modal-btn md-modal-btn--save" disabled={{this.saving}}>
        {{#if this.saving}}
          {{t "Updating Room..." key="updating_room"}}
        {{else}}
          {{t "Update Room" key="update_room"}}
        {{/if}}
      </button>
    </div>
  </form>
{{/modal-dialog}}
