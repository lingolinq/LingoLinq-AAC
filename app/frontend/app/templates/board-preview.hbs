<div class="modal fade in md-board-details-modal" style="display: block;" data-uncloseable={{this.uncloseable}} role="dialog" aria-modal="true">
  <div class="modal-dialog md-board-details-modal__dialog">
    <div class="modal-content md-board-details-modal__content">
      <div class="modal-header md-modal-header md-board-details-modal__header">
        <button type="button" class="la-modal-close md-board-details-modal__close" {{action "close"}} aria-label={{t "Close" key="close"}}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <h3>{{t "Board Preview - Details" key="board_preview_details"}}</h3>
        {{#if this.preview_loading}}
          {{!-- Loading indicator sits next to the title (centered in
               the header) while the board data + canvas preview are
               still resolving. Hides as soon as the board model
               populates. --}}
          <span class="md-board-details-modal__header-loading" role="status" aria-live="polite">
            <span class="md-board-details-modal__header-spinner" aria-hidden="true"></span>
            <span class="md-board-details-modal__header-loading-text">{{t "Loading preview..." key="loading_preview"}}</span>
          </span>
        {{/if}}
      </div>
      {{#if this.style_missing}}
        <div class="modal-body md-modal-body md-board-details-modal__body">
          {{#if this.model.board.style.long_description}}
            <p>{{this.model.board.style.long_description}}</p>
          {{/if}}
          <p>{{t "This board style has multiple grid sizes. As you choose a grid size, try to focus on the smallest buttons that the user can reliably hit, rather than worrying about showing too many buttons. A many-button grid can be \"turned down\" to show fewer buttons more easily than a few-button grid can be adjusted to add more buttons later." key="grid_size_suggestion_prompt"}}</p>
          <div class='row'>
            {{#each this.style_boards as |board|}}
              <div class={{this.style_cols}}>
                {{board-icon board=board onActionOverride=(action "preview") locale=this.model.locale}}
              </div>
            {{/each}}
          </div>
        </div>
      {{else}}
        <div class="modal-body md-modal-body md-board-details-modal__body">
          {{#if this.preview_loading}}
            {{!-- Full-body loading overlay — stays visible until both
                 the board model has finished loading AND the canvas
                 has finished settling every button-image promise.
                 The board-preview component emits onLoadingChange(false)
                 only after both are true. Uses the shared
                 .ll-loading-overlay chrome so the modal's loading
                 visual matches the page-level "Loading boards..."
                 and the board-icon's "Loading Board Preview..." that
                 fires on click. The `--in-modal` modifier scopes
                 the overlay to its modal container (position:
                 absolute, not fixed) instead of covering the full
                 viewport. --}}
            <div class="ll-loading-overlay ll-loading-overlay--in-modal" role="status" aria-live="polite" aria-busy="true">
              <div class="ll-loading-overlay__card">
                <span class="ll-loading-overlay__spinner" aria-hidden="true"></span>
                <p class="ll-loading-overlay__message">{{t "Loading Board Preview..." key="loading_board_preview_modal"}}</p>
              </div>
            </div>
          {{/if}}
          {{board-preview key=this.model_key back=this.back_func option=this.model.option onSelect=(action "select") dark_mode=true onLoadingChange=(action "set_preview_loading") removeContext=this.model.remove onRemove=(action "remove")}}
        </div>
      {{/if}}
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->


