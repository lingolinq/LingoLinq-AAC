<div class="md-shell md-shell--home-boards md-shell--board-picker">
  <div class="md-workspace">
    <nav class="md-pillnav md-pillnav--dashboard" aria-label={{t "Board picker navigation" key="board_picker_nav_label"}}>
      <LinkTo @route="user.boards" @model={{this.boardsBackUserName}} class="md-pillnav__pill md-pillnav__pill--home">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 4px;"><polyline points="15 18 9 12 15 6"/></svg>
        {{t "Boards" key="boards"}}
      </LinkTo>
      <span class="md-pillnav__pill is-active" aria-current="page">{{t "Choose Board" key="board_picker_nav_choose_board"}}</span>
    </nav>
    <main class="md-main md-main--home-boards">
      {{#if this.other_user.loading}}
        <article class="md-card md-card--home-boards md-card--board-picker">
          <p class="ub-boards-page__loading">{{t "Loading User..." key="loading_user"}}</p>
        </article>
      {{else if this.other_user.error}}
        <article class="md-card md-card--home-boards md-card--board-picker">
          <p class="text-danger">{{t "Error loading user, please make sure you have permission to support this user" key="error_loading_user_check_permission"}}</p>
        </article>
      {{else}}
      <article class="md-card md-card--home-boards md-card--board-picker">
        <div class="md-card--board-picker__header">
          <header class="md-hero md-hero--home-boards bp-page-head">
            {{!-- Plain page heading, not a capsule: this is the page's h1, and a
                 gradient-filled pill around it read as an input. The title names
                 the communicator by DISPLAY NAME (never the raw handle) — see
                 controllers/board-picker.js#setupUserDisplayName. --}}
            <div class="bp-page-head__text">
              <h1 class="md-hero__title bp-page-head__title">{{this.boardPickerHeader}}</h1>
              <p class="bp-page-head__subtitle">{{this.boardPickerSubtitle}}</p>
            </div>
            {{!-- Supervisor-only: the way BACK to the entry overlay, which owns
                 the quick-assign and create-a-board shortcuts. A link, not a
                 button — the page's only real actions are picking a board and
                 this is navigation between two views of the same choice. --}}
            {{#unless this.for_self}}
              <div class="bp-page-head__aside">
                <button type="button" class="bp-page-head__options-link" {{on "click" (this.ctrlAction "open_picker_options")}}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
                  {{t "Return to Board Picker Options" key="board_picker_return_to_options"}}
                </button>
              </div>
            {{/unless}}
          </header>
        </div>
        {{!-- Shortcut CTAs are for picking your OWN home board. A supervisor
             choosing for a communicator goes straight to the picker below and
             selects a specific board deliberately, so the whole actions block —
             the assign button, "Create My Own Board", and the divider that only
             exists to separate them from the picker — is self-only. --}}
        {{#if this.for_self}}
          <div class="md-card--board-picker__actions">
            <div class="board-picker-page__assign">
              <button type="button" class="board-picker-page__assign-btn" disabled={{this.assigning_home_board}} {{on "click" (this.ctrlAction "assign_default_home_board")}}><svg class="board-picker-page__cta-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                {{if this.assigning_home_board (t "Assigning…" key="assigning_home_board_ellipsis") this.assignHomeButtonLabel}}
              </button>
              <button type="button" class="board-picker-page__new-btn" {{on "click" (this.ctrlAction "create_new_board")}}><svg class="board-picker-page__cta-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>{{t "Create My Own Board" key="board_picker_create_own"}}</button>
            </div>
            <div class="board-picker-page__divider" role="separator">
              <span class="board-picker-page__divider-line" aria-hidden="true"></span>
              <span class="board-picker-page__divider-label">{{t "or preview other board options" key="board_picker_divider"}}</span>
              <span class="board-picker-page__divider-line board-picker-page__divider-line--right" aria-hidden="true"></span>
            </div>
          </div>
        {{/if}}
        <div class="md-card--home-boards__picker">
          <BoardPicker @searchAtTop={{true}} />
        </div>
        {{!-- Rendered LAST and positioned fixed, so the picker behind it is fully
             built by the time a supporter dismisses it — "Browse Board
             Categories" is a dismiss, not a load. Supervisor-only and
             self-suppressing: `show_picker_options` stays false for the self
             flow and while `setup_user` is still resolving
             (controllers/board-picker.js). --}}
        {{#if this.show_picker_options}}
          <BoardPickerOptions
            @name={{this.setupUserDisplayName}}
            @assigning={{this.assigning_home_board}}
            @onBrowse={{this.ctrlAction "dismiss_picker_options"}}
            @onQuickAssign={{this.ctrlAction "assign_default_home_board"}}
            @onCreate={{this.ctrlAction "create_new_board"}}
            @onClose={{this.ctrlAction "dismiss_picker_options"}} />
        {{/if}}
      </article>
      {{/if}}
    </main>
  </div>
</div>
