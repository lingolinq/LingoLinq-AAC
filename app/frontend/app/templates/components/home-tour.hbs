{{!-- Trigger button — Shepherd portals the actual tour popovers and
     modal overlay into <body> at run time, so this template is just
     the entry point. Scoped class `.md-tour__trigger` is styled in
     app.scss alongside the `.shepherd-*` overrides. --}}
<button
  type="button"
  class="md-tour__trigger"
  aria-label={{t "Take a tour of the dashboard" key="home_tour_trigger_aria"}}
  {{action "startTour"}}
>
  <svg class="md-tour__trigger-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
    <line x1="12" y1="17" x2="12.01" y2="17"></line>
  </svg>
  <span class="md-tour__trigger-label">{{t "Take a tour" key="home_tour_trigger_label"}}</span>
</button>
