{{#modal-dialog action=(action "close") opening=(action "opening") closing=(action "closing")}}
  {{#opening-observer opening=(action "opening")}}{{/opening-observer}}
  <div class="modal-body md-modal-body" style="padding: 0; font-size: 18px;">
    <div class="modal-header md-modal-header">
      <button type="button" class="la-modal-close" {{action "close"}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
      <h3>{{t "PIN Required" key="pin_required"}}</h3>
    </div>
    <div class="modal-body md-modal-body" style="text-align: center;">
      <input type="text" class="form-control" readonly value={{if this.show_typed_digits this.pin this.pin_dots}} rel={{this.pin}} style="font-size: 50px; height: 55px; text-align: center; line-height: 20px; padding-top: 0; margin-bottom: 12px;">
      {{#if this.invalid_pin}}
        <p class="text-danger" role="alert" style="color: #c0392b; font-size: 1.1rem; margin-bottom: 12px;">{{t "Invalid PIN. Try again!" key="invalid_pin_try_again"}}</p>
      {{/if}}
      <table class="table table-bordered advanced_selection" id="pin">
        <colgroup>
          <col span="3" style="width: 33.33%;">
        </colgroup>
        <tbody>
        <tr>
          <td><a href="#" {{action "add_digit" "1"}}>1</a></td>
          <td><a href="#" {{action "add_digit" "2"}}>2</a></td>
          <td><a href="#" {{action "add_digit" "3"}}>3</a></td>
        </tr>
        <tr>
          <td><a href="#" {{action "add_digit" "4"}}>4</a></td>
          <td><a href="#" {{action "add_digit" "5"}}>5</a></td>
          <td><a href="#" {{action "add_digit" "6"}}>6</a></td>
        </tr>
        <tr>
          <td><a href="#" {{action "add_digit" "7"}}>7</a></td>
          <td><a href="#" {{action "add_digit" "8"}}>8</a></td>
          <td><a href="#" {{action "add_digit" "9"}}>9</a></td>
        </tr>
        <tr>
          <td>
            <a href="#" class="pin-key__icon" {{action "delete_digit"}} aria-label={{t "Backspace" key="backspace_lower"}}>
              <img src={{path "images/delete.svg"}} alt="">
            </a>
          </td>
          <td><a href="#" {{action "add_digit" "0"}}>0</a></td>
          <td>
            <a href="#" class="pin-key__icon" {{action "toggle_typed_digits"}} aria-label={{if this.show_typed_digits (t "Hide digits" key="pin_hide_digits") (t "Show digits" key="pin_show_digits")}}>
              {{#if this.show_typed_digits}}
                <span class="glyphicon glyphicon-eye-close" aria-hidden="true"></span>
              {{else}}
                <span class="glyphicon glyphicon-eye-open" aria-hidden="true"></span>
              {{/if}}
            </a>
          </td>
        </tr>
      </tbody></table>
    </div>
    <div class="modal-footer md-modal-footer">
      <button type="button" class="btn btn-primary pass_through" {{action "submit_pin"}}>{{t "Submit" key="pin_submit_button"}}</button>
      {{#unless this.model.hide_hint}}
        {{#if this.show_pin}}
          PIN: {{ this.model.actual_pin }}
        {{else}}
          <a href="#" class="pass_through" {{action "reveal_pin" on="click"}}>touch here to show the PIN</a>
        {{/if}}
      {{/unless}}
    </div>
  </div>
{{/modal-dialog}}
