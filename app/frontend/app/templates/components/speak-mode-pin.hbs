{{#modal-dialog action=(action "close") opening=(action "opening") closing=(action "closing")}}
  {{#opening-observer opening=(action "opening")}}{{/opening-observer}}
  <div class="modal-body md-modal-body" style="padding: 0; font-size: 18px;">
    <div class="modal-header md-modal-header">
      <button type="button" class="la-modal-close" {{action "close"}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
      <h3>{{t "PIN Required" key="pin_required"}}</h3>
    </div>
    <div class="modal-body md-modal-body" style="text-align: center;">
      <div class="speak-mode-pin-entry">
        <input type="text" class="form-control speak-mode-pin-entry__input" readonly value={{if this.show_typed_digits this.pin this.pin_dots}} rel={{this.pin}} aria-label={{t "Speak Mode PIN" key="speak_mode_pin"}}>
        <button type="button" class="btn btn-primary pass_through speak-mode-pin-entry__submit" {{action "submit_pin"}}>{{t "Submit" key="pin_submit_button"}}</button>
      </div>
      {{#if this.invalid_pin}}
        <p class="text-danger speak-mode-pin-entry__error" role="alert">{{t "Invalid PIN. Try again!" key="invalid_pin_try_again"}}</p>
      {{/if}}
      <table class="table table-bordered advanced_selection" id="pin">
        <colgroup>
          <col span="3" style="width: 33.33%;">
        </colgroup>
        <tbody>
        <tr>
          <td><button type="button" class="pin-key" {{action "add_digit" "1"}}>1</button></td>
          <td><button type="button" class="pin-key" {{action "add_digit" "2"}}>2</button></td>
          <td><button type="button" class="pin-key" {{action "add_digit" "3"}}>3</button></td>
        </tr>
        <tr>
          <td><button type="button" class="pin-key" {{action "add_digit" "4"}}>4</button></td>
          <td><button type="button" class="pin-key" {{action "add_digit" "5"}}>5</button></td>
          <td><button type="button" class="pin-key" {{action "add_digit" "6"}}>6</button></td>
        </tr>
        <tr>
          <td><button type="button" class="pin-key" {{action "add_digit" "7"}}>7</button></td>
          <td><button type="button" class="pin-key" {{action "add_digit" "8"}}>8</button></td>
          <td><button type="button" class="pin-key" {{action "add_digit" "9"}}>9</button></td>
        </tr>
        <tr>
          <td>
            <button type="button" class="pin-key pin-key__icon" {{action "delete_digit"}} aria-label={{t "Backspace" key="backspace_lower"}}>
              <img src={{path "images/delete.svg"}} alt="">
            </button>
          </td>
          <td><button type="button" class="pin-key" {{action "add_digit" "0"}}>0</button></td>
          <td>
            <button type="button" class="pin-key pin-key__icon" {{action "toggle_typed_digits"}} aria-label={{if this.show_typed_digits (t "Hide digits" key="pin_hide_digits") (t "Show digits" key="pin_show_digits")}}>
              {{#if this.show_typed_digits}}
                <span class="glyphicon glyphicon-eye-close" aria-hidden="true"></span>
              {{else}}
                <span class="glyphicon glyphicon-eye-open" aria-hidden="true"></span>
              {{/if}}
            </button>
          </td>
        </tr>
      </tbody></table>
    </div>
    <div class="modal-footer md-modal-footer">
      {{#unless this.model.hide_hint}}
        {{#if this.show_pin}}
          PIN: {{ this.model.actual_pin }}
        {{else}}
          <a href="#" class="pass_through" {{action "reveal_pin" on="click"}}>{{t "Reveal PIN" key="pin_reveal_pin"}}</a>
        {{/if}}
      {{/unless}}
    </div>
  </div>
{{/modal-dialog}}
