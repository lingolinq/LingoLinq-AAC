<div class='row md-board-preview'>
  <div class="{{if this.include_canvas "col-sm-4" "col-sm-8 col-sm-offset-2"}} md-board-preview__info">
    <div class='md-board-preview__actions'>
      {{#if this.tour_pick}}
        {{!-- Board-picker TOUR mode: a single "Pick this Board" CTA replaces
             "Try This Board" + "Board Actions" — it sets this board as the home
             board and opens it in speak mode (board-preview-overlay#pick_for_home).
             Closing the preview (overlay X) returns to the live tour modal. --}}
        <button class='btn btn-lg btn-primary md-modal-btn md-modal-btn--primary md-board-preview__action md-board-preview__action--primary' {{action "pick_for_home"}}>
          {{t "Pick this Board" key="pick_this_board"}}
        </button>
        {{!-- Back to the live board-picker tour modal (closing this preview
             overlay reveals the tour modal, which stays mounted underneath). --}}
        <button class='btn btn-default md-modal-btn md-modal-btn--secondary md-board-preview__action' {{action "close"}}>
          {{t "Back" key="board_picker_back"}}
        </button>
        {{#if this.back}}
          <button class='btn btn-lg btn-default md-modal-btn md-modal-btn--secondary md-board-preview__action' {{action this.back}}>
            {{t "Back to List" key="back_to_list"}}
          </button>
        {{/if}}
      {{else}}
        <button class='btn btn-lg btn-primary md-modal-btn md-modal-btn--primary md-board-preview__action md-board-preview__action--primary' {{action "select"}}>
          {{#if this.select_option}}
            {{t "Choose This Board" key="choose_this_board"}}
          {{else}}
            {{t "Try This Board" key="try_this_board"}}
          {{/if}}
        </button>
        {{#if this.back}}
          <button class='btn btn-lg btn-default md-modal-btn md-modal-btn--secondary md-board-preview__action' {{action this.back}}>
            {{t "Back to List" key="back_to_list"}}
          </button>
        {{/if}}
        {{#if this.select_option}}
          <button class='btn btn-default md-modal-btn md-modal-btn--cancel md-board-preview__action' {{action "close"}}>
            {{t "Cancel" key="cancel"}}
          </button>
        {{else}}
          <button class='btn btn-default md-modal-btn md-modal-btn--secondary md-board-preview__action' {{action "visit"}}>
            {{t "Board Actions" key="board_actions"}}
          </button>
        {{/if}}
      {{/if}}
      {{#if this.app_state.currentUser.supervisees}}
        <button class='btn btn-default md-modal-btn md-modal-btn--secondary md-board-preview__action' {{action "copy"}}>
          {{t "Copy For..." key="copy_for_ellipses"}}
        </button>
      {{/if}}
      {{#if this.removeContext}}
        {{!-- Touch-device parity for the tile's hover-only delete/unlike/unshare
             button. Renders at the bottom of the action stack with a danger
             treatment and a separator above so it reads as a destructive
             action, isolated from the positive CTAs. Label + icon come from
             board_list.remove_* so all four contextual variants (delete,
             unstar, unlink, untag) are covered with their correct copy. --}}
        <button type='button' class='btn btn-default md-modal-btn md-board-preview__action md-board-preview__action--remove' {{action this.onRemove}} aria-label={{this.removeContext.label}}>
          {{#if this.removeContext.icon}}
            <span class='md-board-preview__action--remove-icon {{this.removeContext.icon}}' aria-hidden="true"></span>
          {{/if}}
          <span class='md-board-preview__action--remove-text'>{{this.removeContext.label}}</span>
        </button>
      {{/if}}
    </div>
    {{#if this.model.loading}}
      <div class='md-board-preview__status'>{{t "Loading board..." key="loading_board"}}</div>
    {{else if this.model.error}}
      <div class='md-board-preview__status md-board-preview__status--error'>{{t "Error loading board" key="error_loading_board"}}</div>
    {{else if this.model}}
      <div class='md-board-preview__heading'>
        <h3 class='md-board-preview__title'>{{this.model.name}}</h3>
        <div class='md-board-preview__byline'>{{t "by" key="by"}} {{this.model.user_name}}</div>
      </div>
      <div class='md-board-preview__description'>
          <span class='md-board-preview__description-text'>{{this.model.description}}</span>
      </div>
      <dl class="dl-horizontal md-board-preview__meta">
        <dt>{{t "Full Name" key="full_name"}}</dt>
          <dd>{{this.model.key}}</dd>
        <dt>{{t "Dimensions" key="dimensions"}}</dt>
          <dd>{{this.model.grid.rows}} x {{this.model.grid.columns}}</dd>
        <dt>{{t "Created" key="created"}}</dt>
          <dd>{{date this.model.created "day"}}</dd>
        <dt>{{t "Last Updated" key="updated"}}</dt>
          <dd>{{date this.model.updated "day"}}</dd>
        {{#if this.model.locale}}
          <dt>{{t "Default Language" key="default_language"}}</dt>
            <dd>{{this.language}}</dd>
        {{/if}}
        {{#if this.multiple_locales}}
          <dt>{{t "Translations" key="translations"}}</dt>
            <dd>{{this.languages}}</dd>
        {{/if}}
        <dt>{{t "People Using" key="people_using"}}</dt>
          <dd>
            {{this.model.non_author_uses}}
          </dd>
        <dt>{{t "Connected Boards" key="connected_boards"}}</dt>
          <dd>
            {{this.model.downstream_boards}}
          </dd>
        <dt>{{t "Available Buttons" key="available_buttons"}}</dt>
          <dd>
            {{this.model.unlinked_buttons}}
          </dd>
        <dt>{{t "Likes" key="stars"}}</dt>
          <dd>
            {{this.model.stars}}
          </dd>
      </dl>
    {{else}}
      <div class='md-board-preview__status'>{{t "No data to show" key="no_data_to_show"}}</div>
    {{/if}}
  </div>
  {{#if this.include_canvas}}
    <div class='col-sm-8 md-board-preview__canvas-col'>
      {{board-preview-canvas board=this.model locale=this.locale show_links=true size="modal" dark_mode=this.dark_mode onCanvasReady=(action "canvas_ready")}}
    </div>
  {{/if}}
</div>
