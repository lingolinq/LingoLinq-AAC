<div class="bound-select {{if this.isOpen "bound-select--open"}} {{if this.short "bound-select--short"}} {{this.select_class}}">
  <button
    id={{this.select_id}}
    type="button"
    class="bound-select__trigger"
    aria-haspopup="listbox"
    aria-expanded={{this.isOpen}}
    {{action "toggle"}}
  >
    <span class="bound-select__trigger-text {{if this.showPlaceholder "bound-select__trigger-text--placeholder"}}">{{this.triggerLabel}}</span>
  </button>
  {{#if this.isOpen}}
    <ul class="bound-select__list" role="listbox" {{action "stopPropagation" on="click"}} {{action "list_keydown" on="keydown"}}>
      {{#if this.renderContent.length}}
        {{#each this.renderContent as |item|}}
          {{#if item._isDivider}}
            <li class="bound-select__divider" role="presentation">{{item.label}}</li>
          {{else}}
            <li
              class="bound-select__option {{if (is-equal this.selection item.id) "bound-select__option--selected"}} {{if item.disabled "bound-select__option--disabled"}}"
              role="option"
              tabindex={{if item.disabled "-1" "0"}}
              aria-selected={{is-equal this.selection item.id}}
              aria-disabled={{if item.disabled "true" "false"}}
              {{action "choose" item}}
              {{action "option_keydown" item on="keydown"}}
            >
              {{item.name}}
            </li>
          {{/if}}
        {{/each}}
      {{else}}
        {{!-- Empty-state row — modern alternative to a blank dropdown.
             Shown when renderContent is empty (e.g. the user has no
             supervisees + no managed orgs, so the "For" picker on the
             assessment-settings modal has nothing to offer). --}}
        <li class="bound-select__empty" role="presentation" aria-disabled="true">
          <span class="bound-select__empty-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </span>
          <span class="bound-select__empty-text">{{t "No options available" key="bound_select_no_options"}}</span>
        </li>
      {{/if}}
    </ul>
  {{/if}}
</div>
