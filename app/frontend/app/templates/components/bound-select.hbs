<div class="bound-select {{if this.isOpen "bound-select--open"}} {{if this.short "bound-select--short"}} {{this.select_class}}">
  <button
    id={{this.select_id}}
    type="button"
    class="bound-select__trigger"
    aria-haspopup="listbox"
    aria-expanded={{this.isOpen}}
    {{action "toggle"}}
  >
    <span class="bound-select__trigger-text {{if this.showPlaceholder "bound-select__trigger-text--placeholder"}}">{{this.triggerLabel}}</span>
  </button>
  {{#if this.isOpen}}
    <ul class="bound-select__list" role="listbox" {{action "stopPropagation" on="click"}}>
      {{#each this.renderContent as |item|}}
        {{#if item._isDivider}}
          <li class="bound-select__divider" role="presentation">{{item.label}}</li>
        {{else}}
          <li
            class="bound-select__option {{if (is-equal this.selection item.id) "bound-select__option--selected"}} {{if item.disabled "bound-select__option--disabled"}}"
            role="option"
            aria-selected={{is-equal this.selection item.id}}
            aria-disabled={{if item.disabled "true" "false"}}
            {{action "choose" item}}
          >
            {{item.name}}
          </li>
        {{/if}}
      {{/each}}
    </ul>
  {{/if}}
</div>
