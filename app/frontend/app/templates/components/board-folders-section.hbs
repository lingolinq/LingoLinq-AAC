{{#if this.enabled}}
  {{#if this.drillIn}}
    {{!-- Drilled-in state: "back to all" affordance + current folder
         name. Replaces the accordion entirely while drilled in. --}}
    <div class="board-folders-section__drilled-in">
      <button type="button" class="board-folders-section__back" {{action "exitFolder"}} aria-label={{t "Back to all boards" key="back_to_all_boards"}}>
        <span class="board-folders-section__back-arrow" aria-hidden="true">←</span>
        {{t "Back to all boards" key="back_to_all_boards"}}
      </button>
      <span class="board-folders-section__current">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z"/></svg>
        {{this.drillIn}}
      </span>
    </div>
  {{else}}
    {{!-- Accordion: collapsed by default. --}}
    <div class="board-folders-section {{if this.expanded 'board-folders-section--open'}}">
      <button
        type="button"
        class="board-folders-section__toggle"
        aria-expanded={{if this.expanded "true" "false"}}
        aria-controls="board-folders-section__body"
        {{action "toggle"}}
      >
        <span class="board-folders-section__title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z"/></svg>
          {{t "Folders" key="folders"}}
          <span class="board-folders-section__count" aria-label={{t "Folder count" key="folder_count"}}>{{this.summaries.length}}</span>
        </span>
        {{#if this.expanded}}
          <span class="board-folders-section__subtitle">{{t "Drag boards here to organize, or click Tag a board to manually assign a folder" key="mine_folders_multi_tag_hint_v2"}}</span>
        {{else}}
          <span class="board-folders-section__subtitle">{{t "Organize your boards into folders for easy access" key="folders_collapsed_subtitle"}}</span>
        {{/if}}
        <svg class="board-folders-section__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
      {{#if this.expanded}}
        <div id="board-folders-section__body" class="board-folders-section__body">
          {{#if this.canModel}}
            <div class="board-folders-section__actions">
              <button type="button" class="board-folders-section__action-btn" {{action "openNewFolder"}}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                {{t "New folder" key="new_board_folder_title"}}
              </button>
              <button type="button" class="board-folders-section__action-btn" {{action "openTagBoard"}}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                {{t "Tag a board" key="tag_a_board"}}
              </button>
            </div>
          {{/if}}
          {{#if this.filterEnabled}}
            <form class="board-folders-section__filter-form" {{action "noop" on="submit"}}>
              <span id="board-folders-section__filter-label" class="board-folders-section__filter-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                {{t "Folders Filter" key="folders_filter"}}
              </span>
              <input
                id="board-folders-section__filter-input"
                type="text"
                class="board-folders-section__filter-input"
                aria-labelledby="board-folders-section__filter-label"
                autocomplete="off"
                placeholder={{t "Search folders and boards..." key="filter_folders"}}
                value={{this.filterValue}}
                {{on "input" (action "updateFilter")}}
              />
              {{#if this.hasFilter}}
                <button type="button" class="board-folders-section__filter-clear" {{action "clearFilter"}} aria-label={{t "Clear filter" key="clear_filter"}}>
                  {{t "Clear" key="clear"}}
                </button>
              {{/if}}
            </form>
          {{/if}}
          <div class="board-folders-section__strip" role="list" aria-label={{t "Board folders" key="mine_board_folders_label"}}
            {{on "dragover" (action "emptyFolderDragOver")}}
            {{on "drop" (action "emptyFolderDrop")}}
          >
            {{#each this.summaries as |folder|}}
              <button
                type="button"
                class="board-folders-section__chip"
                role="listitem"
                {{action "enterFolder" folder.tag}}
                {{on "dragover" (action "folderDragOver" folder.tag)}}
                {{on "dragenter" (action "folderDragEnter" folder.tag)}}
                {{on "dragleave" (action "folderDragLeave" folder.tag)}}
                {{on "drop" (action "folderDrop" folder.tag)}}
              >
                <span class="board-folders-section__chip-back">
                  <span class="board-folders-section__chip-tab"></span>
                </span>
                <span class="board-folders-section__chip-card">
                  <span class="board-folders-section__chip-name">{{folder.tag}}</span>
                  <span class="board-folders-section__chip-count">{{folder.count}}</span>
                </span>
              </button>
            {{else}}
              {{#if this.showStripEmptyState}}
                <div class="board-folders-section__strip-empty">
                  <span class="board-folders-section__strip-empty-text">{{t "No folders yet — drag a board here to create one" key="no_folders_yet_drag"}}</span>
                </div>
              {{/if}}
            {{/each}}
          </div>
        </div>
      {{/if}}
    </div>
  {{/if}}
{{/if}}
