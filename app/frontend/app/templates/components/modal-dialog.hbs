{{#if this.standalone}}
  <div class="modal-content modal-content--standalone">
    {{yield}}
  </div>
{{else}}
<div class="modal fade in" style="display: block;" data-uncloseable={{this.uncloseable}} role="dialog" aria-modal="true">
  <div class="modal-dialog {{this.dialogClass}}">
    {{#touch-listener select=(action "any_select")}}
      <div class="modal-content {{this.contentClass}} {{if this.auto_close 'auto_close'}}">
        {{yield}}
      </div><!-- /.modal-content -->
    {{/touch-listener}}
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
{{/if}}
