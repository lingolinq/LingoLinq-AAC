{{!-- Final report card with recommendation summary and next-step actions --}}
<section class="evq-report" aria-labelledby="evq-report-title">
  <header class="evq-report__header">
    <span class="evq-report__eyebrow">{{t "Quick Screen complete" key="report_complete_eyebrow"}}</span>
    <h2 id="evq-report-title" class="evq-report__title">
      {{t "Recommended starting point" key="report_title"}}
    </h2>
    <div class="evq-report__meta">
      <span class="evq-report__chip">{{this.durationLabel}}</span>
      <span class="evq-report__chip evq-report__chip--confidence">
        {{t "%{pct}% confidence" key="report_confidence" pct=this.confidencePct}}
      </span>
    </div>
  </header>

  <div class="evq-report__grid">
    <article class="evq-card">
      <span class="evq-card__label">{{t "Access method" key="report_access_method"}}</span>
      <strong class="evq-card__value">{{this.recommendation.access_method}}</strong>
      {{#if this.recommendation.access_secondary}}
        <small class="evq-card__hint">{{t "Secondary: %{m}" key="report_access_secondary" m=this.recommendation.access_secondary}}</small>
      {{/if}}
    </article>

    <article class="evq-card">
      <span class="evq-card__label">{{t "Grid" key="report_grid"}}</span>
      <strong class="evq-card__value">{{this.gridLabel}}</strong>
    </article>

    <article class="evq-card">
      <span class="evq-card__label">{{t "Symbol library" key="report_library"}}</span>
      <strong class="evq-card__value">
        {{#if this.recommendation.library}}
          {{this.recommendation.library}}
        {{else}}
          {{t "Not enough data yet" key="report_library_unknown"}}
        {{/if}}
      </strong>
    </article>

    <article class="evq-card">
      <span class="evq-card__label">{{t "Communicator stage" key="report_stage"}}</span>
      <strong class="evq-card__value">{{this.recommendation.communicator_stage}}</strong>
      <small class="evq-card__hint">{{t "Communication Matrix scale (1–7)" key="report_stage_hint"}}</small>
    </article>

    <article class="evq-card evq-card--wide">
      <span class="evq-card__label">{{t "Vocabulary" key="report_vocab"}}</span>
      <strong class="evq-card__value">{{this.recommendation.vocab_recommendation.band}}</strong>
      {{#if this.recommendation.vocab_recommendation.fringe_categories}}
        <ul class="evq-card__chips">
          {{#each this.recommendation.vocab_recommendation.fringe_categories as |cat|}}
            <li class="evq-card__chip">{{cat}}</li>
          {{/each}}
        </ul>
      {{/if}}
    </article>
  </div>

  {{#if this.shouldPromote}}
    <aside class="evq-report__promote" role="note">
      <strong class="evq-report__promote-title">{{t "Consider promoting to a Targeted Eval" key="report_promote_title"}}</strong>
      <span class="evq-report__promote-reasons">{{this.promoteReasonsLabel}}</span>
    </aside>
  {{/if}}

  <div class="evq-report__actions">
    <button type="button" class="evq-btn evq-btn--ghost" {{action "promote"}}>
      {{t "Promote to Targeted (10 min)" key="report_promote_button"}}
    </button>
    <button type="button" class="evq-btn evq-btn--primary" {{action "save"}}>
      {{t "Save eval" key="report_save"}}
    </button>
  </div>
</section>
