{{!-- Shared focused-home content. The SINGLE source of truth for the focused view —
     the real view and the Getting Started Focused preview both render this, so any
     change here shows in both places. (The Grown-Ups lock is interactive and lives
     in the real view only, not here.) --}}
<main class="md-main md-main--focused" aria-label={{t "Home" key="home"}}>
  <header class="md-focused-greeting">
    <span class="md-focused-greeting__wave" aria-hidden="true">👋</span>
    <h1 class="md-focused-greeting__title">{{t "Hi %{name}" key="focused_home_greeting" name=@greetingName}}</h1>
  </header>

  {{!-- Talk hero: full-width, fastest path to communicate (the speak action). --}}
  <button type="button" class="md-focused-talk" style={{@hideSpeak}} {{action @onTalk}} aria-label={{t "Talk" key="focused_talk"}}>
    <span class="md-focused-talk__icon" aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><path d="M12 18v3"/><path d="M8 21h8"/></svg>
    </span>
    <span class="md-focused-talk__title">{{t "Talk" key="focused_talk"}}</span>
    <span class="md-focused-talk__sub">{{t "Continue where you left off" key="focused_talk_sub"}}</span>
  </button>

  {{!-- Boards as a wrapping preview grid — previews only, no New Board / View All
       buttons. Reuses previewBoards (same data + thumbs as the dynamic strip). --}}
  {{#if @previewBoards.length}}
  <section class="md-focused-boards" style={{@hideBoards}} aria-label={{t "My boards" key="focused_my_boards"}}>
    <h2 class="md-focused-boards__title">{{t "My boards" key="focused_my_boards"}}</h2>
    <div class="md-focused-boards__grid" role="list">
      {{#each @previewBoards key="key" as |preview|}}
        <button type="button" class="md-focused-board {{if preview.isHome 'md-focused-board--home'}} {{if preview.board.starred_for_current_user 'md-focused-board--liked'}}" role="listitem" {{action @onBoard preview.key}}>
          {{#if preview.isHome}}<span class="md-focused-board__home-icon" aria-label={{t "Home Board" key="home_board"}} title={{t "Home Board" key="home_board"}}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg></span>{{/if}}
          <div class="md-thumb {{preview.thumbClass}}" aria-hidden="true">
            <img src={{if preview.board preview.board.icon_url_with_fallback preview.imageUrl}} class="md-thumb__board-img" alt="">
          </div>
          <div class="md-focused-board__label">
            {{preview.name}}
            {{#if preview.languageLabel}}<span class="md-strip__lang">{{preview.languageLabel}}</span>{{/if}}
          </div>
        </button>
      {{/each}}
    </div>
  </section>
  {{/if}}
</main>
