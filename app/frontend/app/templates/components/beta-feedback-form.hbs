<form class="la-contact-form la-support-form md-support-form" {{action "submit_feedback" on="submit"}} {{on "paste" (action "screenshotPaste")}} novalidate>
  {{#if this.hasAnyError}}
    <div class="la-beta-feedback__validation-banner" role="alert">
      {{t "Please review the highlighted fields below and fix any issues before sending." key="beta_feedback_validation_banner"}}
    </div>
  {{/if}}
  {{#if this.prompt_user}}
    <div class="la-contact-form__row">
      <label for="beta_name" class="la-contact-form__label">{{t "Name" key="name"}}</label>
      <Input @value={{this.name}} class="la-contact-input" id="beta_name" placeholder={{t "Your Name" key="your_name"}} maxlength="255" />
    </div>
    <div class="la-contact-form__row">
      <label for="beta_email" class="la-contact-form__label">{{t "Email" key="email"}}</label>
      <Input @value={{this.email}} class="la-contact-input" id="beta_email" type="email" placeholder="you@example.com" maxlength="254" />
    </div>
  {{/if}}
  <fieldset class="la-contact-form__row la-beta-feedback__reaction-row {{if this.errors.reaction "la-contact-form__row--error"}}" id="beta_reaction">
    <legend class="la-contact-form__label">{{t "How did this beta session feel?" key="beta_feedback_reaction_label"}}</legend>
    <div class="la-beta-feedback__reaction-options">
      {{#each this.reactionOptions as |opt|}}
        <button type="button" class="la-beta-feedback__reaction-btn la-beta-feedback__reaction-btn--{{opt.tone}} {{if (is-equal this.reaction opt.id) "la-beta-feedback__reaction-btn--selected"}}" {{action "chooseReaction" opt.id}} aria-pressed={{if (is-equal this.reaction opt.id) "true" "false"}}>
          <span class="la-beta-feedback__reaction-face la-beta-feedback__reaction-face--{{opt.face}}" aria-hidden="true">
            {{#if (is-equal opt.face "smile")}}
              <svg class="la-beta-feedback__reaction-icon" viewBox="0 0 36 36" focusable="false" aria-hidden="true">
                <circle cx="18" cy="18" r="15"></circle>
                <circle cx="13" cy="14" r="1.8"></circle>
                <circle cx="23" cy="14" r="1.8"></circle>
                <path d="M12 21c1.6 3 3.6 4.4 6 4.4s4.4-1.4 6-4.4"></path>
              </svg>
            {{else if (is-equal opt.face "neutral")}}
              <svg class="la-beta-feedback__reaction-icon" viewBox="0 0 36 36" focusable="false" aria-hidden="true">
                <circle cx="18" cy="18" r="15"></circle>
                <circle cx="13" cy="14" r="1.8"></circle>
                <circle cx="23" cy="14" r="1.8"></circle>
                <path d="M12.5 23h11"></path>
              </svg>
            {{else}}
              <svg class="la-beta-feedback__reaction-icon" viewBox="0 0 36 36" focusable="false" aria-hidden="true">
                <circle cx="18" cy="18" r="15"></circle>
                <circle cx="13" cy="14" r="1.8"></circle>
                <circle cx="23" cy="14" r="1.8"></circle>
                <path d="M12 25c1.6-3 3.6-4.4 6-4.4s4.4 1.4 6 4.4"></path>
              </svg>
            {{/if}}
          </span>
          <span>{{opt.label}}</span>
        </button>
      {{/each}}
    </div>
    {{#if this.errors.reaction}}
      <p class="la-contact-form__field-error" id="beta_reaction_error">{{t "Please choose how this beta session felt." key="beta_feedback_validation_reaction"}}</p>
    {{/if}}
  </fieldset>
  <div class="la-contact-form__row">
    <label for="beta_feedback_type" class="la-contact-form__label">{{t "What area is this about? (optional)" key="beta_feedback_area_label"}}</label>
    {{bound-select select_class="la-contact-input" select_id="beta_feedback_type" content=this.feedbackTypeOptions selection=this.feedback_type action=(action "updateFeedbackType") }}
  </div>
  <div class="la-contact-form__row {{if this.errors.details "la-contact-form__row--error"}}">
    <label for="beta_general" class="la-contact-form__label">{{t "What happened, or what would you like us to know?" key="beta_feedback_main_prompt_label"}}</label>
    <Textarea @value={{this.general_feedback}} class={{if this.errors.details "la-contact-input la-contact-input--textarea la-contact-input--invalid" "la-contact-input la-contact-input--textarea"}} id="beta_general" placeholder={{t "Tell us what you tried, what felt confusing, or what worked well." key="beta_feedback_main_prompt_placeholder"}} rows={{5}} maxlength="20000" aria-invalid={{if this.errors.details "true" "false"}} {{on "input" (action "clearFieldError" "details")}} />
    {{#if this.errors.details}}
      <p class="la-contact-form__field-error" id="beta_details_error">{{t "Please add at least a few words about what happened." key="beta_feedback_validation_details_simple"}}</p>
    {{/if}}
  </div>
  <div class="la-contact-form__row">
    <label for="beta_workflow_context" class="la-contact-form__label">{{t "What were you trying to do? (optional)" key="beta_feedback_workflow_label"}}</label>
    <Textarea @value={{this.workflow_context}} class="la-contact-input la-contact-input--textarea" id="beta_workflow_context" placeholder={{t "For example, building a board, trying Speak Mode, or reviewing a report." key="beta_feedback_workflow_placeholder"}} rows={{3}} maxlength="10000" />
  </div>
  <div class="la-contact-form__row">
    <label for="beta_device" class="la-contact-form__label">{{t "Device and app context (optional)" key="beta_feedback_device_label"}}</label>
    <Input @value={{this.device_context}} class="la-contact-input" id="beta_device" placeholder={{t "e.g. iPad + Safari, Windows + Chrome, app version if known" key="beta_feedback_device_placeholder"}} maxlength="2000" />
    <p class="la-contact-form__hint">{{t "When you submit, we add a short summary (viewport, time zone, app route, path, and online status) after your text for troubleshooting." key="beta_feedback_device_auto_hint"}}</p>
  </div>
  <div class="la-contact-form__row">
    <label for="beta_feedback_screenshot" class="la-contact-form__label">{{t "Screenshot (optional)" key="beta_feedback_screenshot_label"}}</label>
    <div
      class="la-beta-feedback__dropzone {{if this.screenshotDragActive "la-beta-feedback__dropzone--active"}}"
      tabindex="0"
      role="region"
      aria-label={{t "Drop an image file here or paste from the clipboard" key="beta_feedback_dropzone_aria"}}
      {{on "dragenter" (action "screenshotDragEnter")}}
      {{on "dragover" (action "screenshotDragOver")}}
      {{on "dragleave" (action "screenshotDragLeave")}}
      {{on "drop" (action "screenshotDrop")}}
    >
      <p class="la-beta-feedback__dropzone-hint">{{t "Drop an image here, paste from the clipboard (when not typing in a field), or choose a file." key="beta_feedback_dropzone_hint"}}</p>
      <input type="file" class="la-contact-input la-contact-input--file la-beta-feedback__file-input" id="beta_feedback_screenshot" accept="image/png,image/jpeg,image/jpg,image/gif,image/webp" {{on "change" (action "screenshotChanged")}} />
    </div>
    <p class="la-contact-form__hint">{{t "PNG, JPG, GIF, or WebP, about 1.5 MB or smaller." key="beta_feedback_screenshot_hint"}}</p>
    <p class="la-contact-form__hint">{{t "Screenshots may show personal or sensitive information—only attach what you are comfortable sharing." key="beta_feedback_screenshot_sensitive_hint"}}</p>
    {{#if this.screenshotData}}
      <div class="la-beta-feedback__screenshot-preview">
        <img src={{this.screenshotData}} alt="" class="la-beta-feedback__screenshot-img" aria-hidden="true">
        <button type="button" class="la-btn la-btn--ghost la-beta-feedback__clear-shot" {{action "clearScreenshot"}}>{{t "Remove image" key="beta_feedback_clear_screenshot"}}</button>
      </div>
    {{/if}}
  </div>
  <div class="la-contact-form__row {{if this.errors.recording "la-contact-form__row--error"}}">
    <label class="la-contact-form__label">{{t "Screen recording (optional)" key="beta_feedback_recording_label"}}</label>
    <p class="la-contact-form__hint">{{t "Recordings can help us understand beta issues, but they may include personal or sensitive information. If your browser offers audio, choose a browser tab and share tab audio so Speak Mode sound can be heard." key="beta_feedback_recording_sensitive_hint_audio"}}</p>
    <label class="la-beta-feedback__consent" id="beta_recording_consent">
      <Input @type="checkbox" @checked={{this.recordingConsent}} {{on "change" (action "toggleRecordingConsent")}} />
      <span>{{t "I am 13 or older, or I am a parent/guardian/authorized adult, and I consent to upload this recording with my beta feedback. I understand it may include personal or sensitive information, including browser audio if I share tab audio." key="beta_feedback_recording_consent_upload"}}</span>
    </label>
    {{#if this.errors.recording}}
      <p class="la-contact-form__field-error">{{t "Please confirm consent before recording or submitting a recording." key="beta_feedback_recording_consent_error"}}</p>
    {{/if}}
    {{#if this.recordingSupported}}
      <div class="la-beta-feedback__recording-actions">
        {{#if this.isRecording}}
          <button type="button" class="la-btn la-btn--ghost" {{action "stopRecording"}}>{{t "Stop recording" key="beta_feedback_recording_stop"}}</button>
          <span class="la-beta-feedback__recording-status" aria-live="polite">{{t "Recording..." key="beta_feedback_recording_in_progress"}}</span>
        {{else}}
          <button type="button" class="la-btn la-btn--ghost" disabled={{or this.disabled this.recordingUploading}} {{action "startRecording"}}>{{t "Start screen recording" key="beta_feedback_recording_start"}}</button>
        {{/if}}
      </div>
      {{#if this.recordingBrowserSoundHint}}
        <p class="la-contact-form__hint" role="status">{{this.recordingBrowserSoundHint}}</p>
      {{/if}}
      <p class="la-contact-form__hint">{{t "You can also use your device's built-in screen recording feature, then choose the saved video here." key="beta_feedback_device_recording_hint"}}</p>
      <input type="file" class="la-contact-input la-contact-input--file" id="beta_feedback_recording_file" accept="video/webm,video/mp4,video/quicktime,video/*" disabled={{or this.disabled this.recordingUploading this.isRecording}} {{on "change" (action "recordingFileChanged")}} />
      {{#if this.recordingUrl}}
        <div class="la-beta-feedback__recording-preview">
          <video src={{this.recordingUrl}} controls class="la-beta-feedback__recording-video"></video>
          <p class="la-contact-form__hint">{{t "Recording size: %{size}" key="beta_feedback_recording_size_label" size=this.recordingSizeLabel}}</p>
          <p class="la-contact-form__hint">{{t "The recording is attached and will upload when you send beta feedback." key="beta_feedback_recording_upload_hint"}}</p>
          <button type="button" class="la-btn la-btn--ghost" disabled={{this.recordingUploading}} {{action "clearRecording"}}>{{t "Remove recording" key="beta_feedback_recording_remove"}}</button>
        </div>
      {{/if}}
      {{#if this.recordingUploading}}
        <p class="la-contact-form__hint" aria-live="polite">{{t "Uploading recording..." key="beta_feedback_recording_uploading"}}</p>
      {{/if}}
      {{#if this.recordingError}}
        <p class="la-contact-form__field-error" role="alert">{{this.recordingError}}</p>
      {{/if}}
    {{else}}
      <p class="la-contact-form__hint">{{t "Screen recording is not supported in this browser. You can still submit text feedback or a screenshot." key="beta_feedback_recording_unsupported"}}</p>
    {{/if}}
  </div>
  {{#if this.error}}
    <p class="la-support-form-error">{{t "Submission failed, please try again" key="ticket_failed"}}</p>
  {{/if}}
  <div class="la-contact-form__actions la-support-form__actions md-support-form__actions">
    <button disabled={{this.disabled}} type="button" class="la-btn la-btn--primary" {{on "click" (action "submit_feedback")}}>
      {{#if this.disabled}}
        {{t "Sending..." key="sending"}}
      {{else}}
        {{t "Send beta feedback" key="beta_feedback_submit"}}
      {{/if}}
    </button>
    {{#if this.onCancel}}
      <button type="button" class="la-btn la-btn--ghost" {{action this.onCancel}}>
        {{#if this.isDrawer}}
          {{t "Hide" key="hide"}}
        {{else}}
          {{t "Cancel" key="cancel"}}
        {{/if}}
      </button>
    {{else}}
      <LinkTo @route="support" class="la-btn la-btn--ghost">{{t "Go to Support" key="faq_cta_support"}}</LinkTo>
    {{/if}}
  </div>
</form>
