{{!-- Chip-style input for board labels. Bulk-paste compatible. --}}
<div class="label-chips__container"
     role="group"
     aria-label={{t "Labels" key="labels"}}
     {{action "focusInput" on="click"}}>
  {{#each this.chips as |chip index|}}
    <span class="label-chips__chip">
      <span class="label-chips__chip-label">{{chip}}</span>
      <button type="button"
              class="label-chips__chip-remove"
              {{action "removeChipAt" index bubbles=false}}
              aria-label={{t "Remove %{word}" key="remove_label_chip" word=chip}}>
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
          <path d="M1 1 L9 9 M9 1 L1 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </span>
  {{/each}}
  <input type="text"
         value={{this.currentInput}}
         id={{this.inputId}}
         class="label-chips__input"
         placeholder={{this.placeholder}}
         autocomplete="off"
         autocorrect="off"
         autocapitalize="off"
         spellcheck="true"
         oninput={{action "inputChanged" value="target.value"}}
         onkeydown={{action "handleKeydown"}}
         onpaste={{action "handlePaste"}}
         onfocus={{action "handleFocus"}}
         onblur={{action "handleBlur"}} />
</div>
