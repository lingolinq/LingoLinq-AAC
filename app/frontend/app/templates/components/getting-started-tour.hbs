{{!-- Getting Started entry badge — a gradient icon circle (mirrors the
     beta-welcome step circle, .beta-welcome-steps__num) that opens the
     Getting Started tour modal. Shepherd portals the modal into <body>. --}}
<button
  type="button"
  class="md-getting-started-tour__trigger beta-welcome-steps__num"
  aria-label={{t "Get started" key="getting_started_tour_trigger_aria"}}
  {{action "startGettingStarted"}}
>
  {{!-- App-layout glyph ("dashboard design"): a page frame with a solid left
        sidebar and a divided main area — the standard "dashboard layout" shape.
        Two-toned (both currentColor so it inherits the badge colour): the sidebar
        is a strong fill, the main area a light wash, for clear legibility at 18px. --}}
  <svg class="md-getting-started-tour__trigger-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2" fill="currentColor" fill-opacity="0.18" stroke="none"></rect>
    <path d="M4 5h5v14H4z" fill="currentColor" fill-opacity="0.9" stroke="none"></path>
    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
    <path d="M9 4v16"></path>
    <path d="M9 12h12"></path>
  </svg>
  {{!-- Label ("Get Started") shows at all widths (see app.scss). --}}
  <span class="md-getting-started-tour__trigger-label">{{t "Get Started" key="getting_started_tour_trigger_label"}}</span>
</button>
