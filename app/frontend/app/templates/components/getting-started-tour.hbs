{{!-- Getting Started entry badge — a gradient icon circle (mirrors the
     beta-welcome step circle, .beta-welcome-steps__num) that opens the
     Getting Started tour modal. Shepherd portals the modal into <body>. --}}
<button
  type="button"
  class="md-getting-started-tour__trigger beta-welcome-steps__num"
  aria-label={{t "Get started" key="getting_started_tour_trigger_aria"}}
  {{action "startGettingStarted"}}
>
  {{!-- The standard "layout" glyph (Feather/Lucide `layout`): a page frame with a
        top header bar and a sidebar in the lower-left. The vertical divider only
        spans the lower half (below the header), so it reads as a page layout — not
        columns. Two-toned via currentColor fill-opacity (light header, solid
        sidebar) so it inherits the badge colour and stays legible at 18px. --}}
  <svg class="md-getting-started-tour__trigger-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 4h16v5H4z" fill="currentColor" fill-opacity="0.2" stroke="none"></path>
    <path d="M4 9h5v11H4z" fill="currentColor" fill-opacity="0.85" stroke="none"></path>
    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
    <line x1="3" y1="9" x2="21" y2="9"></line>
    <line x1="9" y1="9" x2="9" y2="21"></line>
  </svg>
  {{!-- Label ("Get Started") shows at all widths (see app.scss). --}}
  <span class="md-getting-started-tour__trigger-label">{{t "Get Started" key="getting_started_tour_trigger_label"}}</span>
</button>
