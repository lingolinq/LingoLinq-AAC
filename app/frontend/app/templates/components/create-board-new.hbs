                                        autocomplete="off"
                                        oninput={{action "update_custom_paint_color" value="target.value"}}
                                        onchange={{action "update_custom_paint_color" value="target.value"}}>
                                      <Input id="nb-paint-hex-input"
                                        @value={{this.custom_paint_color}}
                                        placeholder="#hex"
                                        class="md-board-edit-right-panel__custom-picker-hex"
                                        autocomplete="off" />
                                      <button type="button"
                                        class="md-board-edit-right-panel__custom-picker-apply"
                                        {{action "apply_custom_paint_color"}}>
                                        {{t "Apply" key="board_detail_apply"}}
                                      </button>
                                    </div>
                                  {{/if}}
                                </div>
                              {{/if}}
                            </div>
