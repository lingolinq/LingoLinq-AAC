                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Skin-Tones" key="board_detail_settings_skin_tones"}}</span>
                              <div class="md-settings-dropdown-wrap">
                                <button type="button" class="md-settings-select md-settings-select--trigger md-settings-select--with-swatch {{if this.display_prefs_skin_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_skin_dropdown_open "true" "false"}} data-tooltip={{t "Skin tone" key="board_detail_prefs_skin"}} aria-label={{t "Skin tone" key="board_detail_prefs_skin"}} {{action "toggle_display_skin_dropdown"}}>
                                  <span class="md-settings-select__swatch md-settings-skin md-settings-skin--{{this.display_prefs_current_skin_swatch}}" aria-hidden="true"></span>
                                  <span class="md-settings-select__value">{{this.display_prefs_current_skin_label}}</span>
                                </button>
                                {{#if this.display_prefs_skin_dropdown_open}}
                                  <div class="md-settings-dropdown-backdrop" {{action "close_display_skin_dropdown"}} aria-hidden="true"></div>
                                  <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Skin tone" key="board_detail_prefs_skin"}}>
                                    {{#each this.skin_tone_options as |opt|}}
                                      <li>
                                        <button type="button" role="option" aria-selected={{if (is-equal this.display_prefs_current_skin_id opt.id) "true" "false"}} class="md-settings-dropdown-item md-settings-dropdown-item--with-swatch {{if (is-equal this.display_prefs_current_skin_id opt.id) 'md-settings-dropdown-item--active'}}" {{action "pick_display_skin" opt.id}}>
                                          {{#if (is-equal this.display_prefs_current_skin_id opt.id)}}
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                          {{else}}
                                            <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                          {{/if}}
                                          <span class="md-settings-dropdown-item__swatch md-settings-skin md-settings-skin--{{opt.swatch}}" aria-hidden="true"></span>
