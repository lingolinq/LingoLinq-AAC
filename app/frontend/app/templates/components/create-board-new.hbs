{{#grid-listener gridEvent=(action "grid_event")}}
  <div class="board_drop new-board--modern md-workspace md-workspace--create-board-new">
    {{#if this.standalone}}
    <button type="button" class="md-workspace__close" {{action "close"}} aria-label={{t "Close and return to previous page" key="close_create_board"}} title={{t "Close" key="close"}}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="modal-header md-modal-header">
      <h3>{{t "Create a New Board" key="create_a_new_board"}}</h3>
      <div class="create-board-actions">
        <span class="file_select_holder">
          <button type="button" class="btn btn-default">
            {{t "Import Board(s)" key="import_boards"}}
          </button>
          <input type="file" name="board_upload" id="board_upload" tabindex="-1">
        </span>
        <button type="button" class="btn btn-default" {{action "importFromHtml"}}>
          {{t "Paste HTML" key="paste_html"}}
        </button>
        {{#if this.ai_board_generation_enabled}}
          <button type="button" class="btn btn-default" {{action "generateWithAi"}}>
            {{t "Generate with AI" key="generate_with_ai"}}
          </button>
        {{/if}}
      </div>
    </div>
    {{else}}
    <div class="la-modal-header">
      <span class="la-modal-header-label">{{t "Create a New Board" key="create_a_new_board"}}</span>
      <div class="la-support-modal-header-meta">
        <button type="button" class="la-modal-close" {{action "close"}} aria-label={{t "Close" key="close"}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
      </div>
    </div>
    {{/if}}
    <div class="{{if this.standalone "modal-body" "la-support-modal-body"}}">
      {{#unless this.standalone}}
      <div class="la-new-board-modal-actions">
        <span class="file_select_holder">
          <button type="button" class="la-btn la-btn--ghost">
            {{t "Import Board(s)" key="import_boards"}}
          </button>
          <input type="file" name="board_upload" id="board_upload" tabindex="-1">
        </span>
        <button type="button" class="la-btn la-btn--ghost" {{action "importFromHtml"}}>
          {{t "Paste HTML" key="paste_html"}}
        </button>
        {{#if this.ai_board_generation_enabled}}
          <button type="button" class="la-btn la-btn--ghost" {{action "generateWithAi"}}>
            {{t "Generate with AI" key="generate_with_ai"}}
          </button>
        {{/if}}
      </div>
      {{/unless}}
      <form class="nb-form {{unless this.standalone "la-new-board-form"}}" {{action "saveBoard" on="submit"}}>

        <section class="nb-section">
          <h4 class="nb-section__title">{{t "Basics" key="new_board_section_basics"}}</h4>
          <p class="nb-section__hint">{{t "Give your board a name and brief description." key="new_board_section_basics_hint"}}</p>
          <div class="nb-section__body">
            <div class="nb-basics-grid">
              <div class="nb-basics-grid__col nb-basics-grid__col--left">
                <div class="nb-field">
                  <label for="new_board_name" class="nb-field__label">{{t "Name" key="name"}}</label>
                  <Input @value={{this.model.name}}
                         required={{true}}
                         aria-required="true"
                         aria-invalid={{if this.field_errors.name "true" "false"}}
                         aria-describedby={{if this.field_errors.name "new-board-name-error"}}
                         class="form-control nb-field__input {{if this.field_errors.name 'nb-field__input--error'}}"
                         id="new_board_name"
                         placeholder="My Board"
                         {{action "markFieldTouched" "name" on="blur"}} />
                  {{#if this.field_errors.name}}
                    <p id="new-board-name-error" class="nb-field__hint nb-field__hint--error" role="alert">{{this.field_errors.name}}</p>
                  {{/if}}
                </div>
                <div class="nb-field new-board-field--description">
                  <label for="new_board_description" class="nb-field__label">{{t "Description" key="description"}}<span class="nb-field__optional-pill">{{t "optional" key="optional"}}</span></label>
                  <Textarea @value={{this.model.description}} class="form-control nb-field__input nb-field__input--fill" id="new_board_description" placeholder="Brief description of the board" rows={{1}} />
                </div>
              </div>
              {{#if this.show_user_options}}
                <div class="nb-basics-grid__col nb-basics-grid__col--right">
                  <div class="nb-field nb-toggle-row">
                    <span class="nb-toggle-row__question" id="new_board_for_someone_else_label">{{t "Are you creating this board for someone else?" key="creating_for_someone_else"}}</span>
                    <div class="nb-toggle-row__control">
                      <span class="nb-toggle-row__state {{unless this.creating_for_someone_else 'nb-toggle-row__state--active'}}" aria-hidden="true">{{t "No" key="no"}}</span>
                      <button type="button"
                              role="switch"
                              aria-checked={{if this.creating_for_someone_else "true" "false"}}
                              aria-labelledby="new_board_for_someone_else_label"
                              class="nb-toggle__switch {{if this.creating_for_someone_else 'nb-toggle__switch--on'}}"
                              {{action "toggleCreatingForSomeoneElse"}}>
                        <span class="nb-toggle__thumb" aria-hidden="true"></span>
                      </button>
                      <span class="nb-toggle-row__state {{if this.creating_for_someone_else 'nb-toggle-row__state--active'}}" aria-hidden="true">{{t "Yes" key="yes"}}</span>
                    </div>
                  </div>
                  <div class="new-board-for-collapse {{if this.creating_for_someone_else 'new-board-for-collapse--open'}} {{if this.for_user_needs_attention 'new-board-for-collapse--needs-attention'}}" aria-hidden={{unless this.creating_for_someone_else "true" "false"}}>
                    {{modern-select class="new-board-select--modern new-board-for-select" selectId="new_board_for_user" content=this.user_options selection=this.for_user_id action=(action "setForUserId") ariaLabel=(t "Who is this board for?" key="for_user_aria") placeholder=(t "Select who this board is for" key="select_who_for")}}
                  </div>
                </div>
              {{/if}}
            </div>
          </div>
        </section>

        <section class="nb-section">
          <div class="nb-section__head">
            <h4 class="nb-section__title">{{t "Size & Labels" key="new_board_section_size"}}</h4>
            <ul class="nb-checklist nb-checklist--inset nb-section__head-checklist">
              <li class="nb-checklist__item">{{t "Auto-sizes as you add labels" key="new_board_size_hint_grid"}}</li>
              <li class="nb-checklist__item">{{t "Press Enter to add label" key="new_board_size_hint_label"}}</li>
              <li class="nb-checklist__item">{{t "Type, paste, or upload CSV" key="new_board_size_hint_input"}}</li>
            </ul>
            <div class="new-board-dimensions" role="group" aria-label={{t "Grid size" key="grid_size"}}>
              <div class="nb-stepper-mini">
                <span class="nb-stepper-mini__label" id="nb-rows-label">{{t "Rows" key="rows"}}</span>
                <button type="button" class="nb-stepper-mini__btn" {{action "plus_minus" "minus" "model.grid.rows"}} aria-label={{t "Decrease rows" key="decrease_rows"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <Input @type="number" @value={{this.model.grid.rows}} class="nb-stepper-mini__input" id="new_board_rows" aria-labelledby="nb-rows-label" />
                <button type="button" class="nb-stepper-mini__btn" {{action "plus_minus" "plus" "model.grid.rows"}} aria-label={{t "Increase rows" key="increase_rows"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 2.5 L6 9.5 M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="nb-stepper-mini">
                <span class="nb-stepper-mini__label" id="nb-cols-label">{{t "Cols" key="cols_short"}}</span>
                <button type="button" class="nb-stepper-mini__btn" {{action "plus_minus" "minus" "model.grid.columns"}} aria-label={{t "Decrease columns" key="decrease_columns"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <Input @type="number" @value={{this.model.grid.columns}} class="nb-stepper-mini__input" id="new_board_columns" aria-labelledby="nb-cols-label" />
                <button type="button" class="nb-stepper-mini__btn" {{action "plus_minus" "plus" "model.grid.columns"}} aria-label={{t "Increase columns" key="increase_columns"}}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 2.5 L6 9.5 M2.5 6 L9.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>
          </div>
          <div class="nb-section__body">
            <div class="nb-words-grid">
              <div class="nb-basics-grid__col nb-words-grid__col--labels">
                <div class="nb-field new-board-field--labels">
                  <div class="nb-field__label-row nb-field__label-row--page-center">
                    <label for="new_board_labels" class="nb-field__label">{{t "Labels" key="labels"}}</label>
                    <div class="nb-field__meta nb-field__meta--center">
                      <span class={{this.labels_class}}>
                        {{this.label_count}} {{t "labels" key="label_count"}}
                      </span>
                      <span class="nb-field__sep" aria-hidden="true">·</span>
                      <button type="button" class="nb-link" data-count={{this.label_count}} {{action "pick_core"}}>{{t "pick from core lists" key="pick_from_core_lists"}}</button>
                      {{#if this.speech}}
                        <span class="nb-field__sep nb-field__sep--before-speech" aria-hidden="true">·</span>
                        <button type="button" class="nb-link nb-link--speech" data-count={{this.label_count}} {{action "record_words"}}>{{t "speech recognition" key="record_words"}}</button>
                      {{/if}}
                      {{#if this.label_count}}
                        <span class="nb-field__sep" aria-hidden="true">·</span>
                        <button type="button"
                                class="nb-link nb-link--danger"
                                {{action "clearGrid"}}
                                aria-label={{t "Clear all labels" key="clear_all_labels"}}>
                          <svg class="nb-link__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                            <path d="M3 4 L3 12 Q3 13 4 13 L10 13 Q11 13 11 12 L11 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2 4 L12 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            <path d="M5.5 4 L5.5 2.5 Q5.5 2 6 2 L8 2 Q8.5 2 8.5 2.5 L8.5 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M5.5 6.5 L5.5 10.5 M8.5 6.5 L8.5 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                          </svg>
                          <span>{{t "clear grid" key="clear_grid"}}</span>
                        </button>
                      {{/if}}
                      <button type="button" class="nb-link" style="display: none;" {{action "import_from_pdf"}}>{{t "import from pdf" key="import_from_pdf"}}</button>
                    </div>
                    <div class="nb-field__label-row__actions">
                      <button type="button"
                              class="nb-link nb-field__import-btn"
                              data-tooltip={{t "Upload a CSV file (max 1MB) — one label per cell or row" key="import_csv_tooltip"}}
                              aria-label={{t "Upload labels from CSV" key="import_csv_aria"}}
                              {{action "importCsv"}}>
                        <svg class="nb-link__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                          <path d="M7 1.5 L7 9.5 M3.5 5 L7 1.5 L10.5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M2 11 L2 12 Q2 12.5 2.5 12.5 L11.5 12.5 Q12 12.5 12 12 L12 11" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>{{t "import csv" key="import_csv"}}</span>
                      </button>
                      <input type="file"
                             id="new_board_csv_input"
                             class="nb-field__file-input"
                             accept=".csv,text/csv"
                             onchange={{action "csvFileChosen"}}
                             tabindex="-1"
                             aria-hidden="true" />
                    </div>
                  </div>
                  {{#if this.has_duplicate_labels}}
                    <span class="nb-pill nb-pill--warn" role="status">
                      <svg class="nb-pill__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                        <circle cx="7" cy="7" r="5.6" fill="none" stroke="currentColor" stroke-width="1.4"/>
                        <path d="M7 4 L7 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                        <circle cx="7" cy="9.7" r="0.7" fill="currentColor"/>
                      </svg>
                      <span class="nb-pill__text">{{t "Duplicate labels detected" key="duplicate_labels_pill"}}</span>
                    </span>
                  {{/if}}
                  {{#if this.speech_error_message}}
                    <div class="nb-alert nb-alert--warning nb-speech__error" role="alert">
                      <span class="nb-alert__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                          <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                          <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                          <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                        </svg>
                      </span>
                      <div class="nb-alert__body">
                        <p class="nb-alert__text">{{this.speech_error_message}}</p>
                      </div>
                      <button type="button" class="nb-speech__error-dismiss" {{action "dismiss_speech_error"}} aria-label={{t "Dismiss" key="dismiss"}}>
                        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                          <path d="M2 2 L10 10 M10 2 L2 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>
                  {{/if}}
                  {{#if this.too_many_total_labels}}
                    <div class="nb-alert nb-alert--warning" role="alert">
                      <span class="nb-alert__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                          <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                          <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                          <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                        </svg>
                      </span>
                      <div class="nb-alert__body">
                        <p class="nb-alert__title">{{t "Too many labels" key="too_many_labels_title"}}</p>
                        <p class="nb-alert__text">{{t "You've entered %{count} labels — %{unused} of them won't be used because the grid maximum is %{max} buttons (20 × 20). Remove the extras or split them into a second board." key="too_many_labels_message" count=this.label_count unused=this.unused_label_count max=this.max_grid_labels}}</p>
                      </div>
                    </div>
                  {{/if}}
                  {{label-chips value=this.model.grid.labels onChange=(action "setLabels") inputId="new_board_labels" showChips=false colors=this.chip_label_colors placeholder=(t "Type a word or group of words and press Enter, paste a list, or import a csv file" key="labels_chip_placeholder_import")}}
                  {{#if this.label_count}}
                    <div class="nb-labels-disclosure">
                      <button type="button" class="nb-link nb-labels-disclosure__toggle" aria-expanded={{if this.labels_list_open "true" "false"}} {{action "toggleLabelsList"}}>
                        <svg class="nb-link__icon nb-labels-disclosure__chevron {{if this.labels_list_open 'nb-labels-disclosure__chevron--open'}}" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                        {{#if this.labels_list_open}}
                          <span>{{t "hide labels list" key="hide_labels_list"}}</span>
                        {{else}}
                          <span>{{t "view all labels" key="view_all_labels"}} ({{this.label_count}})</span>
                        {{/if}}
                      </button>
                      {{#if this.labels_list_open}}
                        <div class="nb-labels-disclosure__list">
                          {{label-chips value=this.model.grid.labels onChange=(action "setLabels") showInput=false colors=this.chip_label_colors}}
                        </div>
                      {{/if}}
                    </div>
                  {{/if}}
                </div>
              </div>
            </div>
            {{#if this.core_lists}}
              <div class="nb-field">
                <ul class="nav nav-pills">
                  {{#each this.core_words as |core_word|}}
                    <li class={{if core_word.active "active"}}>
                      <button type="button" class="md-link-btn-pill" {{action "enable_word" core_word.id}} aria-pressed={{if core_word.active "true" "false"}}>{{ core_word.label }}</button>
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{else}}
              {{#if this.speech.ready}}
                <div class="nb-field nb-speech">
                  <div class="nb-speech__head">
                    <div class="nb-speech__indicator {{if this.speech.recording 'nb-speech__indicator--active'}}" aria-hidden="true">
                      <svg class="nb-speech__mic" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <rect x="7.5" y="2.5" width="5" height="9" rx="2.5"/>
                        <path d="M4.5 9 Q4.5 14 10 14 Q15.5 14 15.5 9"/>
                        <path d="M10 14 L10 17 M7 17 L13 17"/>
                      </svg>
                    </div>
                    <div class="nb-speech__status" role="status" aria-live="polite">
                      {{#if this.speech.recording}}
                        {{t "Listening..." key="listening"}}
                      {{else}}
                        {{t "Starting microphone..." key="speech_starting_mic"}}
                      {{/if}}
                    </div>
                    <div class="nb-speech__meter" aria-hidden="true">
                      <div class="nb-speech__meter-fill" style={{safe-style this.speech_level_style}}></div>
                    </div>
                  </div>

                  <div class="nb-speech__controls">
                    <button type="button" class="btn btn-default nb-speech__btn" title={{t "Click between dictated words to add each as its own label. Otherwise everything you say merges into one label." key="next_word_help"}} {{action "next_word"}}>{{t "Next Word" key="next_word"}}</button>
                    <button type="button" class="btn btn-default nb-speech__btn nb-speech__btn--stop" {{action "stop_recording"}}>{{t "Stop" key="stop_speech"}}</button>
                  </div>

                  <p class="nb-speech__hint">{{t "Click \"Next Word\" between labels to keep them separate." key="speech_hint"}}</p>

                  {{speech-listener content=(action "speech_content") error=(action "speech_error") stop=(action "speech_stop") speech=this.speech}}

                  <ul class="nav nav-pills nb-speech__words">
                    {{#each this.speech.words as |word|}}
                      <li class="active" style="margin-right: 3px; margin-bottom: 3px;">
                        <button type="button" class="md-link-btn-pill" {{action "remove_word" word.id}} aria-label={{t "Remove %{word}" key="remove_word_named" word=word.label}}>
                          {{word.label}}
                          <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                        </button>
                      </li>
                    {{/each}}
                  </ul>
                </div>
              {{else}}
                {{#if this.speech.almost_recording}}
                  <div class="nb-field">
                    <p>{{t "Waiting for Approval..." key="waiting_for_approval"}}</p>
                  </div>
                {{/if}}
              {{/if}}
            {{/if}}
            {{!-- ── Preferences (collapsible, above preview) ── --}}
            {{#if this.label_count}}
            <div class="new-board-prefs-collapsible {{if this.prefs_open "new-board-prefs-collapsible--open"}}">
              <button type="button" class="new-board-prefs-toggle" aria-expanded={{if this.prefs_open "true" "false"}} {{action "togglePrefs"}}>
                <span class="new-board-prefs-toggle__label">{{t "Preferences" key="preferences_section"}}</span>
                <svg class="new-board-prefs-toggle__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              {{#if this.prefs_open}}
            {{!-- ── Preferences inset (ported from board-detail) ── --}}
            <div class="new-board-prefs-inset md-board-detail-edit-toolbar md-board-detail-edit-toolbar--expanded" role="toolbar" aria-label={{t "Preferences" key="preferences_section"}}>
              <div class="md-board-detail-edit-toolbar__display-prefs">

                {{!-- ── Text Size + Font + Position ── --}}
                <div class="md-board-detail-edit-toolbar__section md-board-detail-edit-toolbar__section--text-typography">
                  <div class="md-board-detail-edit-toolbar__section-buttons">

                    {{!-- Group: Text Size + Font Type. display:contents on desktop keeps
                         the existing flex layout; on mobile (≤640px) this wrapper
                         becomes a standalone pill containing both controls. --}}
                    <div class="md-settings-group md-settings-group--text-font">
                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Text Size" key="board_detail_settings_text_size_label"}}</span>
                      <div class="md-board-detail-edit-toolbar__stepper md-settings-stepper md-settings-stepper--compact">
                        <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_text_size_at_min}} data-tooltip={{t "Smaller" key="board_detail_settings_smaller"}} aria-label={{t "Smaller" key="board_detail_settings_smaller"}} {{action "step_display_pref" "button_text" -1}}>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                        </button>
                        <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_text_size_at_max}} data-tooltip={{t "Larger" key="board_detail_settings_larger"}} aria-label={{t "Larger" key="board_detail_settings_larger"}} {{action "step_display_pref" "button_text" 1}}>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                        </button>
                      </div>
                    </div>

                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Font Type" key="board_detail_settings_type"}}</span>
                      <div class="md-settings-dropdown-wrap">
                        <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_font_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_font_dropdown_open "true" "false"}} data-tooltip={{t "Font style" key="board_detail_prefs_font_style"}} aria-label={{t "Font style" key="board_detail_prefs_font_style"}} {{action "toggle_display_font_dropdown"}}>
                          <span class="md-settings-select__value">{{this.display_prefs_current_font_label}}</span>
                        </button>
                        {{#if this.display_prefs_font_dropdown_open}}
                          <div class="md-settings-dropdown-backdrop" {{action "close_display_font_dropdown"}} aria-hidden="true"></div>
                          <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Font style" key="board_detail_prefs_font_style"}}>
                            <li class="md-settings-dropdown-search-row" role="presentation">
                              <input type="text"
                                     id="nb-font-dropdown-search"
                                     class="md-settings-dropdown-search__input"
                                     placeholder={{t "Search fonts..." key="search_fonts_placeholder"}}
                                     value={{this.display_prefs_font_filter}}
                                     oninput={{action "filter_display_fonts" value="target.value"}}
                                     onkeydown={{action "font_dropdown_keydown"}}
                                     autocomplete="off"
                                     aria-label={{t "Search fonts" key="search_fonts_label"}} />
                            </li>
                            {{#each this.filtered_button_style_options as |opt|}}
                              {{#if opt.divider}}
                                <li class="md-settings-dropdown-divider" role="separator" aria-hidden="true"></li>
                              {{else}}
                                <li>
                                  <button type="button" role="option" aria-selected={{if (is-equal this.appState.sessionUser.preferences.device.button_style opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.appState.sessionUser.preferences.device.button_style opt.id) 'md-settings-dropdown-item--active'}}" {{action "pick_display_font" opt.id}}>
                                    {{#if (is-equal this.appState.sessionUser.preferences.device.button_style opt.id)}}
                                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                    {{else}}
                                      <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                    {{/if}}
                                    <span>{{opt.label}}</span>
                                  </button>
                                </li>
                              {{/if}}
                            {{/each}}
                          </ul>
                        {{/if}}
                      </div>
                    </div>

                    </div>{{!-- /md-settings-group--text-font --}}

                    {{!-- Group: Text Position. Same display:contents pattern — desktop unchanged,
                         on mobile this becomes its own pill below the Text Size + Font Type pill. --}}
                    <div class="md-settings-group md-settings-group--text-position">
                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Text Position" key="board_detail_settings_position"}}</span>
                      <div class="md-settings-icongroup" role="radiogroup" aria-label={{t "Text position" key="board_detail_prefs_text_position"}}>
                        <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.device.button_text_position "top") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.device.button_text_position 'top') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Text on top" key="board_detail_settings_text_top"}} aria-label={{t "Text on top" key="board_detail_settings_text_top"}} {{action "set_display_pref" "button_text_position" "top"}}>
                          <span class="md-settings-btnmock"><span class="md-settings-btnmock__text md-settings-btnmock__text--top">Aa</span><span class="md-settings-btnmock__img"></span></span>
                        </button>
                        <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.device.button_text_position "bottom") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.device.button_text_position 'bottom') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Text on bottom" key="board_detail_settings_text_bottom"}} aria-label={{t "Text on bottom" key="board_detail_settings_text_bottom"}} {{action "set_display_pref" "button_text_position" "bottom"}}>
                          <span class="md-settings-btnmock"><span class="md-settings-btnmock__img"></span><span class="md-settings-btnmock__text md-settings-btnmock__text--bottom">Aa</span></span>
                        </button>
                        <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.device.button_text_position "text_only") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.device.button_text_position 'text_only') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Text only" key="board_detail_settings_text_only"}} aria-label={{t "Text only" key="board_detail_settings_text_only"}} {{action "set_display_pref" "button_text_position" "text_only"}}>
                          <span class="md-settings-btnmock"><span class="md-settings-btnmock__text md-settings-btnmock__text--only">Aa</span></span>
                        </button>
                      </div>
                    </div>
                    </div>{{!-- /md-settings-group--text-position --}}

                  </div>
                </div>

                <div class="md-board-detail-edit-toolbar__divider"></div>

                {{!-- ── Paint ── --}}
                {{!-- Mirrors the board-detail edit toolbar's Paint section.
                     Picking a swatch (or applying a custom hex) arms
                     `paint_mode`; clicks on preview cells then call
                     `paint_button(label)` instead of opening the inline
                     editor. Painted colors are baked into `model.buttons[]`
                     at save time. --}}
                <div class="md-board-detail-edit-toolbar__section md-board-detail-edit-toolbar__section--paint">
                  <div class="md-board-detail-edit-toolbar__section-buttons">
                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Paint" key="board_detail_paint_label"}}</span>
                      <div class="md-board-detail-edit-toolbar__dropdown-wrap md-board-detail-edit-toolbar__dropdown-wrap--paint" style="position: relative;">
                        <button type="button"
                                class="md-board-detail-edit-toolbar__btn md-board-detail-edit-toolbar__btn--palette {{if this.paint_mode 'md-board-detail-edit-toolbar__btn--active'}}"
                                data-tooltip={{if this.paint_mode (t "Click to exit paint mode" key="board_detail_click_exit_paint") (t "Choose paint color" key="board_detail_choose_paint")}}
                                aria-label={{if this.paint_mode (t "Click to exit paint mode" key="board_detail_click_exit_paint") (t "Choose paint color" key="board_detail_choose_paint")}}
                                aria-expanded={{if this.show_paint_dropdown "true" "false"}}
                                aria-haspopup="menu"
                                {{action "toggle_paint_dropdown"}}>
                          <span class="md-board-detail-edit-toolbar__palette-preview" style={{safe-style (concat "background-color:" (if this.paint_mode.fill this.paint_mode.fill "#fff"))}}></span>
                          {{#if this.paint_mode}}
                            {{!-- Active paint mode: chevron swaps to an X
                                 so the user sees that clicking the same
                                 button again will exit (paired with the
                                 "Click to exit paint mode" tooltip). --}}
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#46505F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                          {{else}}
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" stroke="#46505F"/></svg>
                          {{/if}}
                        </button>
                        {{#if this.show_paint_dropdown}}
                          <div class="md-board-detail-edit-toolbar__paint-dropdown" role="menu">
                            <div class="md-board-detail-edit-toolbar__paint-dropdown-grid">
                              {{#each this.paint_swatches as |swatch|}}
                                <button type="button"
                                        role="menuitem"
                                        class="md-board-detail-edit-toolbar__paint-dropdown-item"
                                        {{action "set_paint_mode" swatch.bg swatch.border swatch.pos_class}}>
                                  <span class="md-board-detail-edit-toolbar__paint-dot" style={{safe-style (concat "background-color:" swatch.bg ";border-color:" swatch.border)}}></span>
                                  <span>{{swatch.label}}</span>
                                </button>
                              {{/each}}
                            </div>
                            <div class="md-board-detail-edit-toolbar__paint-dropdown-footer">
                              <div class="md-board-detail-paint-custom-wrap">
                                <button type="button"
                                        role="menuitem"
                                        class="md-board-detail-edit-toolbar__paint-dropdown-item md-board-detail-edit-toolbar__paint-dropdown-item--custom"
                                        {{action "toggle_paint_color_picker"}}>
                                  <span class="md-board-detail-edit-toolbar__paint-dot md-board-detail-edit-toolbar__paint-dot--custom"></span>
                                  <span>{{t "Custom Color" key="board_detail_custom_paint_color"}}</span>
                                </button>
                                {{#if this.show_paint_color_picker}}
                                  <div class="md-board-detail-paint-picker md-board-detail-paint-picker--in-dropdown">
                                    <div class="md-board-detail-paint-picker__row">
                                      <input type="color" id="nb-paint-color-picker" value={{this.custom_paint_color}} class="md-board-detail-paint-picker__input"
                                             aria-label={{t "Pick paint color" key="board_detail_pick_paint_color"}}
                                             autocomplete="off"
                                             oninput={{action "update_custom_paint_color" value="target.value"}}
                                             onchange={{action "update_custom_paint_color" value="target.value"}}>
                                      <Input id="nb-paint-hex-input" @value={{this.custom_paint_color}} placeholder="#hex" class="md-board-detail-paint-picker__hex" autocomplete="off" />
                                      <button type="button" class="md-board-detail-paint-picker__apply" {{action "apply_custom_paint_color"}}>
                                        {{t "Apply" key="board_detail_apply"}}
                                      </button>
                                    </div>
                                  </div>
                                {{/if}}
                              </div>
                            </div>
                          </div>
                        {{/if}}
                      </div>
                    </div>
                  </div>
                </div>

                <div class="md-board-detail-edit-toolbar__divider"></div>

                {{!-- ── Symbol library + Background ── --}}
                <div class="md-board-detail-edit-toolbar__section md-board-detail-edit-toolbar__section--symbols-bg">
                  <div class="md-board-detail-edit-toolbar__section-buttons">

                    {{!-- Group: Symbols. Becomes its own pill on ≤640px. --}}
                    <div class="md-settings-group md-settings-group--symbols">
                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Symbols" key="board_detail_settings_symbols"}}</span>
                      <div class="md-settings-dropdown-wrap">
                        <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_symbol_library_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_symbol_library_dropdown_open "true" "false"}} data-tooltip={{t "Symbol library" key="board_detail_prefs_symbol_library"}} aria-label={{t "Symbol library" key="board_detail_prefs_symbol_library"}} {{action "toggle_display_symbol_library_dropdown"}}>
                          <span class="md-settings-select__value">{{this.display_prefs_current_symbol_library_label}}</span>
                        </button>
                        {{#if this.display_prefs_symbol_library_dropdown_open}}
                          <div class="md-settings-dropdown-backdrop" {{action "close_display_symbol_library_dropdown"}} aria-hidden="true"></div>
                          <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Symbol library" key="board_detail_prefs_symbol_library"}}>
                            {{#each this.preferred_symbols_options as |opt|}}
                              <li>
                                <button type="button" role="option" aria-selected={{if (is-equal this.appState.sessionUser.preferences.preferred_symbols opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.appState.sessionUser.preferences.preferred_symbols opt.id) 'md-settings-dropdown-item--active'}}" {{action "pick_display_symbol_library" opt.id}}>
                                  {{#if (is-equal this.appState.sessionUser.preferences.preferred_symbols opt.id)}}
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                  {{else}}
                                    <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                  {{/if}}
                                  <span>{{opt.label}}</span>
                                </button>
                              </li>
                            {{/each}}
                          </ul>
                        {{/if}}
                      </div>
                    </div>

                    </div>{{!-- /md-settings-group--symbols --}}

                    {{!-- Group: Background. Becomes its own pill on ≤640px. --}}
                    <div class="md-settings-group md-settings-group--background">
                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Background" key="board_detail_settings_image_background"}}</span>
                      <div class="md-settings-dropdown-wrap">
                        <button type="button" class="md-settings-select md-settings-select--trigger md-settings-select--img-bg {{if this.display_prefs_symbol_background_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_symbol_background_dropdown_open "true" "false"}} data-tooltip={{t "Background color behind symbol images" key="board_detail_prefs_image_background_tooltip"}} aria-label={{t "Background color behind symbol images" key="board_detail_prefs_image_background_tooltip"}} {{action "toggle_display_symbol_background_dropdown"}}>
                          <span class="md-settings-select__value">{{this.display_prefs_current_symbol_background_label}}</span>
                        </button>
                        {{#if this.display_prefs_symbol_background_dropdown_open}}
                          <div class="md-settings-dropdown-backdrop" {{action "close_display_symbol_background_dropdown"}} aria-hidden="true"></div>
                          <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Image background color" key="board_detail_prefs_image_background"}}>
                            {{#each this.symbol_background_options as |opt|}}
                              <li>
                                <button type="button" role="option" aria-selected={{if (is-equal this.display_prefs_current_symbol_background_id opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.display_prefs_current_symbol_background_id opt.id) 'md-settings-dropdown-item--active'}}" {{action "pick_display_symbol_background" opt.id}}>
                                  {{#if (is-equal this.display_prefs_current_symbol_background_id opt.id)}}
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                  {{else}}
                                    <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                  {{/if}}
                                  <span>{{opt.label}}</span>
                                </button>
                              </li>
                            {{/each}}
                          </ul>
                        {{/if}}
                      </div>
                    </div>
                    </div>{{!-- /md-settings-group--background --}}

                  </div>
                </div>

                <div class="md-board-detail-edit-toolbar__divider"></div>

                {{!-- ── Shape ── --}}
                <div class="md-board-detail-edit-toolbar__section">
                  <div class="md-board-detail-edit-toolbar__section-buttons">
                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Shape" key="board_detail_settings_shape"}}</span>
                      <div class="md-settings-icongroup" role="radiogroup" aria-label={{t "Stretch buttons" key="board_detail_prefs_stretch"}}>
                        <button type="button" role="radio" aria-checked={{if (is-equal (or this.appState.sessionUser.preferences.stretch_buttons "none") "none") "true" "false"}} class="md-settings-icon-btn {{if (is-equal (or this.appState.sessionUser.preferences.stretch_buttons 'none') 'none') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Fit cell" key="board_detail_settings_fit_cell"}} aria-label={{t "Fit cell" key="board_detail_settings_fit_cell"}} {{action "set_display_pref" "stretch_buttons" "none"}}>
                          <span class="md-settings-stretch-icon md-settings-stretch-icon--square"></span>
                        </button>
                        <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.stretch_buttons "prefer_tall") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.stretch_buttons 'prefer_tall') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Thin" key="board_detail_settings_thin"}} aria-label={{t "Thin" key="board_detail_settings_thin"}} {{action "set_display_pref" "stretch_buttons" "prefer_tall"}}>
                          <span class="md-settings-stretch-icon md-settings-stretch-icon--tall"></span>
                        </button>
                        <button type="button" role="radio" aria-checked={{if (is-equal this.appState.sessionUser.preferences.stretch_buttons "prefer_wide") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.appState.sessionUser.preferences.stretch_buttons 'prefer_wide') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Wide" key="board_detail_settings_wide"}} aria-label={{t "Wide" key="board_detail_settings_wide"}} {{action "set_display_pref" "stretch_buttons" "prefer_wide"}}>
                          <span class="md-settings-stretch-icon md-settings-stretch-icon--wide"></span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="md-board-detail-edit-toolbar__divider"></div>

                {{!-- ── Spacing + Border steppers ── --}}
                <div class="md-board-detail-edit-toolbar__section">
                  <div class="md-board-detail-edit-toolbar__section-buttons">

                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Gap" key="board_detail_settings_gap"}}</span>
                      <div class="md-board-detail-edit-toolbar__stepper md-settings-stepper md-settings-stepper--compact">
                        <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_spacing_at_min}} data-tooltip={{t "Tighter" key="board_detail_settings_tighter"}} aria-label={{t "Tighter" key="board_detail_settings_tighter"}} {{action "step_display_pref" "button_spacing" -1}}>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                        </button>
                        <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_spacing_at_max}} data-tooltip={{t "Looser" key="board_detail_settings_looser"}} aria-label={{t "Looser" key="board_detail_settings_looser"}} {{action "step_display_pref" "button_spacing" 1}}>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                        </button>
                      </div>
                    </div>

                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Border" key="board_detail_settings_border_label"}}</span>
                      <div class="md-board-detail-edit-toolbar__stepper md-settings-stepper md-settings-stepper--compact">
                        <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_border_at_min}} data-tooltip={{t "Thinner" key="board_detail_settings_thinner"}} aria-label={{t "Thinner" key="board_detail_settings_thinner"}} {{action "step_display_pref" "button_border" -1}}>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                        </button>
                        <button type="button" class="md-board-detail-edit-toolbar__stepper-btn" disabled={{this.display_prefs_border_at_max}} data-tooltip={{t "Thicker" key="board_detail_settings_thicker"}} aria-label={{t "Thicker" key="board_detail_settings_thicker"}} {{action "step_display_pref" "button_border" 1}}>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor"/></svg>
                        </button>
                      </div>
                    </div>

                  </div>
                </div>

                <div class="md-board-detail-edit-toolbar__divider"></div>

                {{!-- ── Skin tones ── --}}
                <div class="md-board-detail-edit-toolbar__section">
                  <div class="md-board-detail-edit-toolbar__section-buttons">
                    <div class="md-settings-sublabel-wrap">
                      <span class="md-settings-sublabel">{{t "Skin-Tones" key="board_detail_settings_skin_tones"}}</span>
                      <div class="md-settings-dropdown-wrap">
                        <button type="button" class="md-settings-select md-settings-select--trigger md-settings-select--with-swatch {{if this.display_prefs_skin_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_skin_dropdown_open "true" "false"}} data-tooltip={{t "Skin tone" key="board_detail_prefs_skin"}} aria-label={{t "Skin tone" key="board_detail_prefs_skin"}} {{action "toggle_display_skin_dropdown"}}>
                          <span class="md-settings-select__swatch md-settings-skin md-settings-skin--{{this.display_prefs_current_skin_swatch}}" aria-hidden="true"></span>
                          <span class="md-settings-select__value">{{this.display_prefs_current_skin_label}}</span>
                        </button>
                        {{#if this.display_prefs_skin_dropdown_open}}
                          <div class="md-settings-dropdown-backdrop" {{action "close_display_skin_dropdown"}} aria-hidden="true"></div>
                          <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Skin tone" key="board_detail_prefs_skin"}}>
                            {{#each this.skin_tone_options as |opt|}}
                              <li>
                                <button type="button" role="option" aria-selected={{if (is-equal this.display_prefs_current_skin_id opt.id) "true" "false"}} class="md-settings-dropdown-item md-settings-dropdown-item--with-swatch {{if (is-equal this.display_prefs_current_skin_id opt.id) 'md-settings-dropdown-item--active'}}" {{action "pick_display_skin" opt.id}}>
                                  {{#if (is-equal this.display_prefs_current_skin_id opt.id)}}
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                  {{else}}
                                    <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                  {{/if}}
                                  <span class="md-settings-dropdown-item__swatch md-settings-skin md-settings-skin--{{opt.swatch}}" aria-hidden="true"></span>
                                  <span>{{opt.label}}</span>
                                </button>
                              </li>
                            {{/each}}
                          </ul>
                        {{/if}}
                      </div>
                      {{#if this.skin_suboptions}}
                        <div class="md-settings-skin-suboptions">
                          {{#each this.skin_suboptions as |option|}}
                            <label class="md-settings-skin-suboption md-settings-skin-suboption--{{option.id}} {{if option.checked 'md-settings-skin-suboption--checked'}}" data-tooltip={{option.label}} aria-label={{option.label}}>
                              <input id={{concat "nb-skin-sub-" option.id}} name={{concat "nb-skin-sub-" option.id}} type="checkbox" checked={{option.checked}} onchange={{action "toggle_skin_suboption" option}} class="md-settings-skin-suboption__input" />
                              <span class="md-settings-skin-suboption__swatch md-settings-skin--{{option.id}}" aria-hidden="true"></span>
                            </label>
                          {{/each}}
                        </div>
                      {{/if}}
                    </div>
                  </div>
                </div>

              </div>
            </div>
              {{/if}}
            </div>
            {{/if}}
            <div class="new-board-mockup-wrap {{if (is_equal this.preview_mode "dark") "md-board-detail--dark new-board-mockup-wrap--dark"}}"
                 role="region"
                 aria-label={{t "Board preview" key="board_preview"}}>
              <div class="new-board-mockup-toolbar">
                <button type="button"
                        class="new-board-mockup-toggle {{if (is_equal this.preview_mode "dark") "new-board-mockup-toggle--dark"}}"
                        role="switch"
                        aria-checked={{if (is_equal this.preview_mode "dark") "true" "false"}}
                        aria-label={{t "Toggle preview light or dark mode" key="toggle_preview_mode"}}
                        title={{t "Toggle preview light or dark mode" key="toggle_preview_mode"}}
                        {{action "togglePreviewMode"}}>
                  <span class="new-board-mockup-toggle__icon new-board-mockup-toggle__icon--sun" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                  </span>
                  <span class="new-board-mockup-toggle__thumb" aria-hidden="true"></span>
                  <span class="new-board-mockup-toggle__icon new-board-mockup-toggle__icon--moon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                  </span>
                </button>
              </div>
              <div class="md-board-detail-grid md-board-detail-grid--preview {{this.button_text_position_class}} {{this.button_text_size_class}} {{this.button_shape_class}} {{this.preview_background_class}} {{if this.paint_mode 'md-board-detail-grid--paint-mode'}}"
                   style={{this.preview_style}}
                   role="grid"
                   ondragover={{action "previewDragOver"}}
                   ondrop={{action "previewDrop"}}>
                {{#each this.preview_grid as |row rowIdx|}}
                  {{#each row as |cell colIdx|}}
                    <div class="md-board-detail-grid__cell {{if cell.empty "md-board-detail-grid__cell--empty"}} {{if cell.editing "md-board-detail-grid__cell--editing"}} {{if cell.painted "md-board-detail-grid__cell--painted"}} {{if cell.is_duplicate "md-board-detail-grid__cell--duplicate"}}"
                         role="gridcell"
                         draggable={{if cell.draggable "true" "false"}}
                         onclick={{action "cellClicked" cell.idx}}
                         ondragstart={{action "cellDragStart" rowIdx colIdx}}
                         ondragover={{action "cellDragOver"}}
                         ondrop={{action "cellDrop" rowIdx colIdx}}
                         ondragend={{action "cellDragEnd"}}>
                      <div class="button md-board-detail-symbol-card md-board-detail-symbol-card--default {{unless cell.has_color "md-board-detail-symbol-card--no-color"}} {{if cell.empty "md-board-detail-symbol-card--empty"}} {{if cell.is_duplicate "md-board-detail-symbol-card--duplicate"}}"
                           style={{cell.bg_style}}>
                        {{#unless cell.empty}}
                          {{#if cell.is_duplicate}}
                            {{!-- Duplicate-label warning icon. Pinned to the
                                 bottom-left of the symbol card with a small
                                 amber triangle. Pure presentational — the
                                 inline edit / drag / paint affordances on
                                 the rest of the card still work. --}}
                            <span class="md-board-detail-symbol-card__warning"
                                  aria-label={{t "Duplicate label" key="duplicate_label_warning"}}
                                  title={{t "Duplicate label" key="duplicate_label_warning"}}>
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9.5"/>
                                <line x1="12" y1="7.5" x2="12" y2="13"/>
                                <circle cx="12" cy="16.5" r="0.7" fill="currentColor" stroke="none"/>
                              </svg>
                            </span>
                          {{/if}}
                          {{#unless cell.editing}}
                            {{!-- Remove-label X. Pinned to the top-right corner
                                 of the card; mirrors the chip's `__chip-remove`
                                 button so deleting from either surface routes
                                 through the same `parsed_labels`. Hidden during
                                 inline edit so it doesn't crowd the input. --}}
                            <button type="button"
                                    class="md-board-detail-symbol-card__remove"
                                    aria-label={{t "Remove %{word}" key="remove_label_chip" word=cell.label}}
                                    draggable="false"
                                    {{action "removeCellAt" cell.idx bubbles=false}}>
                              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
                                <path d="M1 1 L9 9 M9 1 L1 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                              </svg>
                            </button>
                          {{/unless}}
                          {{#if cell.image_url}}
                            {{!-- Symbol image fetched async via _lookup_label_images
                                 from /api/v1/search/symbols. Same image gets baked
                                 into model.buttons[] at save time so the live board
                                 uses the symbol the user previewed. --}}
                            <div class="md-board-detail-symbol-card__image md-board-detail-symbol-card__image--symbol">
                              <img class="symbol" src={{cell.image_url}} alt="" draggable="false" style="max-width: 70%; max-height: 70%; object-fit: contain;">
                            </div>
                          {{else}}
                            <div class="md-board-detail-symbol-card__image md-board-detail-symbol-card__image--placeholder">
                              <img class="symbol" src="/images/square.svg" alt="" draggable="false" style="max-width: 70%; max-height: 70%;">
                            </div>
                          {{/if}}
                          {{#if cell.editing}}
                            {{!-- Inline edit. The input is focused + selected by `startCellEdit`
                                 via the `new-board-cell-edit-{{idx}}` id. Enter commits, Escape
                                 cancels, blur commits (matches label-chips' edit semantics).
                                 oninput keeps `_editValue` in sync as the user types. --}}
                            <input type="text"
                                   id={{concat "new-board-cell-edit-" cell.idx}}
                                   class="md-board-detail-symbol-card__label-input"
                                   value={{this._editValue}}
                                   aria-label={{t "Edit button label" key="edit_button_label"}}
                                   draggable="false"
                                   oninput={{action "cellEditChanged" value="target.value"}}
                                   onkeydown={{action "cellEditKeydown"}}
                                   onblur={{action "commitCellEdit"}} />
                          {{else}}
                            <button type="button"
                                    class="md-board-detail-symbol-card__label-btn"
                                    aria-label={{t "Edit %{word}" key="edit_label_chip_named" word=cell.label}}
                                    {{action "startCellEdit" cell.idx bubbles=false}}>
                              <span class="md-board-detail-symbol-card__label">{{cell.label}}</span>
                            </button>
                          {{/if}}
                        {{/unless}}
                      </div>
                    </div>
                  {{/each}}
                {{/each}}
              </div>
            </div>
          </div>
        </section>

        <section class="nb-section">
          <div class="nb-section__title-row">
            <h4 class="nb-section__title">{{t "Visibility" key="new_board_section_appearance"}}</h4>
            <span class="nb-section__optional-pill">{{t "optional" key="optional"}}</span>
          </div>
          <p class="nb-section__hint">{{t "Pick who can see this board." key="new_board_section_appearance_hint"}}</p>
          <div class="nb-section__body">
            <div class="nb-field new-board-field--visibility">
              {{modern-select class="new-board-visibility-select" selectId="new_board_visibility" content=this.public_options selection=this.model.visibility action=(action "setVisibility") ariaLabel=(t "Visibility" key="visibility")}}
            </div>
          </div>
        </section>

        <section class="nb-section nb-section--advanced">
          <button
            type="button"
            class="nb-advanced-toggle {{if this.more_options 'nb-advanced-toggle--open'}}"
            aria-expanded={{if this.more_options "true" "false"}}
            aria-controls="nb-advanced-panel"
            {{action "more_options"}}
          >
            <span class="nb-advanced-toggle__lockup">
              <div class="nb-section__title-row">
                <h4 class="nb-section__title nb-advanced-toggle__title">{{t "Advanced options" key="new_board_section_advanced"}}</h4>
                <span class="nb-section__optional-pill">{{t "optional" key="optional"}}</span>
              </div>
              <ul class="nb-section__hint nb-advanced-toggle__hint" role="list" aria-label={{t "Includes" key="advanced_options_includes_aria"}}>
                <li class="nb-advanced-toggle__hint-item">{{t "Fill order" key="advanced_hint_fill_order"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Board key" key="advanced_hint_board_key"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "License" key="advanced_hint_license"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Language" key="advanced_hint_language"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Home-board categories" key="advanced_hint_home_categories"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Word suggestions" key="advanced_hint_word_suggestions"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Icon" key="advanced_hint_icon"}}</li>
              </ul>
            </span>
            <svg class="nb-advanced-toggle__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          {{#if this.more_options}}
            <div id="nb-advanced-panel" class="nb-section__body">
              <div class="nb-field new-board-field--fill-order">
                <span class="nb-field__label">{{t "Fill order" key="fill_order"}}</span>
                <div class="nb-field__radio-group nb-field__radio-group--inline" role="radiogroup" aria-label={{t "Fill order" key="fill_order"}}>
                  <div class="nb-field__radio-row">
                    <label class="nb-radio">
                      <input type="radio"
                             name="labels_order"
                             value="rows"
                             checked={{is_equal this.model.grid.labels_order "rows"}}
                             onchange={{action "setLabelsOrder" "rows"}} />
                      <span class="nb-radio__label">{{t "Rows, left to right" key="rows_first_short"}}</span>
                    </label>
                    <label class="nb-radio">
                      <input type="radio"
                             name="labels_order"
                             value="columns"
                             checked={{is_equal this.model.grid.labels_order "columns"}}
                             onchange={{action "setLabelsOrder" "columns"}} />
                      <span class="nb-radio__label">{{t "Columns, top to bottom" key="columns_first_short"}}</span>
                    </label>
                  </div>
                </div>
              </div>
              <div class="nb-field new-board-field--key">
                <label for="new_board_key" class="nb-field__label">{{t "Key" key="key"}}</label>
                <Input @value={{this.model.key}} class="form-control nb-field__input nb-field__input--narrow" id="new_board_key" placeholder={{this.key_placeholder}} />
              </div>
              <div class="nb-field new-board-field--license">
                <label for="license" class="nb-field__label">{{t "License" key="license"}}</label>
                {{modern-select class="new-board-select--modern" selectId="license" content=this.license_options selection=this.model.license.type action=(action "setLicenseType") ariaLabel=(t "License" key="license")}}
              </div>
              <div class="nb-field new-board-field--locale">
                <label for="locale" class="nb-field__label">{{t "Language" key="locale"}}</label>
                {{modern-select class="new-board-select--modern" selectId="locale" content=this.locales selection=this.model.locale action=(action "setLocale") ariaLabel=(t "Language" key="locale")}}
              </div>
              {{#if this.attributable_license_type}}
                <div class="nb-field nb-field--row">
                  <div class="nb-field__col">
                    <label for="author" class="nb-field__label">{{t "Author" key="author"}}</label>
                    <Input @value={{this.model.license.author_name}} class="form-control nb-field__input" id="author" placeholder="Name" />
                  </div>
                  <div class="nb-field__col">
                    <label for="author_url" class="nb-field__label">{{t "Author URL" key="author_url"}}</label>
                    <Input @value={{this.model.license.author_url}} class="form-control nb-field__input" id="author_url" title="Author URL" placeholder="Author URL" />
                  </div>
                </div>
              {{/if}}
              <div class="nb-field nb-field--checkbox new-board-checkbox-row">
                <label for="home_board" class="nb-checkbox">
                  <Input @type="checkbox" @checked={{this.model.home_board}} id="home_board" />
                  <span>{{t "This board can be used as a home board" key="is_home_board"}}</span>
                </label>
              </div>
              {{#if this.model.home_board}}
                <div class="nb-field">
                  <p class="nb-field__hint">{{t "Select any categories that this home board may fit well into." key="select_categories"}}</p>
                  {{#each this.board_categories as |category|}}
                    <label class="nb-checkbox">
                      <Input @type="checkbox" @checked={{category.selected}} />
                      <span>{{category.name}}</span>
                    </label>
                  {{/each}}
                </div>
              {{/if}}
              <div class="nb-field nb-field--checkbox new-board-checkbox-row new-board-checkbox-row--suggestions">
                <label for="word_suggestions" class="nb-checkbox">
                  <Input @type="checkbox" @checked={{this.model.word_suggestions}} id="word_suggestions" />
                  <span>{{t "Show word completion suggestions" key="show_word_suggestions"}}</span>
                </label>
                <p class="nb-field__hint">{{t "(helpful for keyboard-style boards)" key="helpful_for_keyboard_boards"}}</p>
              </div>
              <div class="nb-field new-board-field--icon nb-icon-disclosure {{if this.icon_picker_open 'nb-icon-disclosure--open'}}">
                <button
                  type="button"
                  class="nb-icon-disclosure__toggle"
                  aria-expanded={{if this.icon_picker_open "true" "false"}}
                  aria-controls="nb-icon-picker-panel"
                  {{action "toggleIconPicker"}}
                >
                  <span class="nb-icon-disclosure__lockup">
                    <span class="nb-field__label nb-icon-disclosure__label">{{t "Icon for your Board" key="icon_for_your_board"}}</span>
                  </span>
                  <svg class="nb-icon-disclosure__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
                {{#if this.icon_picker_open}}
                  <div id="nb-icon-picker-panel" class="nb-icon-disclosure__panel">
                    {{icon-select selection=this.model.image_url action=(action (mut this.model.image_url)) }}
                  </div>
                {{/if}}
              </div>
            </div>
          {{/if}}
        </section>
      </form>
    </div>
    <div class="{{if this.standalone "modal-footer" "la-new-board-modal-footer"}}">
      {{!-- Visually hidden description tied to the Create button via
           aria-describedby. When fields are missing, the assistive
           technology announces what's needed; once everything's set
           the span clears. Replaces the previous inline floating hint —
           modern pattern (Stripe/Linear/Vercel) is to keep the disabled
           CTA self-explanatory and let the reason live in a tooltip /
           aria description, not as floating layout text. --}}
      <span id="new-board-create-hint" class="sr-only" aria-live="polite">{{this.missing_required_summary}}</span>
      {{#if this.standalone}}
      <div class="new-board__footer-actions">
        <button type="button" class="btn btn-default new-board__cancel" {{action "close"}}>{{t "Cancel" key="cancel"}}</button>
        <button {{action "attemptSave"}}
                class="btn btn-primary new-board__submit {{if this.createBoardDisabled 'new-board__submit--invalid'}}"
                aria-disabled={{if this.createBoardDisabled "true" "false"}}
                aria-describedby="new-board-create-hint">
          {{#if this.status.saving}}
            {{t "Creating Board..." key="creating_board"}}
          {{else if this.status.error}}
            {{t "Error Creating Board" key="error_creating_board"}}
          {{else}}
            {{t "Create Board" key="create_board"}}
          {{/if}}
        </button>
      </div>
      {{else}}
      <div class="la-new-board-modal-footer__actions">
        <button type="button" {{action "attemptSave"}}
                class="la-btn la-btn--primary new-board__submit {{if this.createBoardDisabled 'new-board__submit--invalid'}}"
                aria-disabled={{if this.createBoardDisabled "true" "false"}}
                aria-describedby="new-board-create-hint">
          {{#if this.status.saving}}
            {{t "Creating Board..." key="creating_board"}}
          {{else if this.status.error}}
            {{t "Error Creating Board" key="error_creating_board"}}
          {{else}}
            {{t "Create Board" key="create_board"}}
          {{/if}}
        </button>
        <button type="button" class="la-btn la-btn--ghost" {{action "close"}}>{{t "Cancel" key="cancel"}}</button>
      </div>
      {{/if}}
    </div>
  </div>
{{/grid-listener}}
