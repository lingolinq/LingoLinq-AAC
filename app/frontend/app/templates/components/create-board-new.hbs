                                        <button type="button" role="option" aria-selected={{if (is-equal this.display_prefs_current_symbol_background_id opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.display_prefs_current_symbol_background_id opt.id) 'md-settings-dropdown-item--active'}}" {{action "pick_display_symbol_background" opt.id}}>
                                          {{#if (is-equal this.display_prefs_current_symbol_background_id opt.id)}}
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                          {{else}}
                                            <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                          {{/if}}
                                          <span>{{opt.label}}</span>
                                        </button>
                                      </li>
                                    {{/each}}
                                  </ul>
                                {{/if}}
                              </div>
                            </div>
                          {{else if (is-equal sec.id "symbols")}}
                            {{!-- Board Symbols — moved (not copied) from
                                 the Preferences inset. Same actions and
                                 bindings the component already exposes;
                                 presented like the board-detail Board
                                 Symbols section (centered scope hint +
                                 full-width dropdown). --}}
                            <p class="md-board-edit-right-panel__hint" style="text-align: center;">{{t "Your preferred symbol library (applies to all your boards)" key="board_symbols_hint_user_scope"}}</p>
                            <div class="md-settings-dropdown-wrap">
                              <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_symbol_library_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_symbol_library_dropdown_open "true" "false"}} data-tooltip={{t "Symbol library" key="board_detail_prefs_symbol_library"}} aria-label={{t "Symbol library" key="board_detail_prefs_symbol_library"}} {{action "toggle_display_symbol_library_dropdown"}}>
                                <span class="md-settings-select__value">{{this.display_prefs_current_symbol_library_label}}</span>
                              </button>
                              {{#if this.display_prefs_symbol_library_dropdown_open}}
                                <div class="md-settings-dropdown-backdrop" {{action "close_display_symbol_library_dropdown"}} aria-hidden="true"></div>
                                <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Symbol library" key="board_detail_prefs_symbol_library"}}>
                                  {{#each this.preferred_symbols_options as |opt|}}
                                    <li>
                                      <button type="button" role="option" aria-selected={{if (is-equal this.appState.sessionUser.preferences.preferred_symbols opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.appState.sessionUser.preferences.preferred_symbols opt.id) 'md-settings-dropdown-item--active'}}" {{action "pick_display_symbol_library" opt.id}}>
                                        {{#if (is-equal this.appState.sessionUser.preferences.preferred_symbols opt.id)}}
                                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                        {{else}}
                                          <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                        {{/if}}
                                        <span>{{opt.label}}</span>
                                      </button>
                                    </li>
                                  {{/each}}
                                </ul>
                              {{/if}}
                            </div>
                          {{else if (is-equal sec.id "speakbar")}}
                            {{!-- Speak Bar — same controls/actions as the
                                 board-detail edit panel's Speak Bar.
                                 "Show on Speak Bar as…" sets
                                 utterance_text_only; "Sentence Bar"
                                 sets vocalization_height. Bindings read
                                 the live session user prefs (this
                                 component is stateless, no pending). --}}
                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Show on Speak Bar as..." key="speak_bar_hint"}}</span>
                              <div class="md-settings-icongroup" role="radiogroup" aria-label={{t "Speak bar appearance" key="board_detail_prefs_speak_bar"}}>
                                <button type="button" role="radio" aria-checked={{if (is-equal this.utterance_text_only_str "false") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.utterance_text_only_str 'false') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Show on Speak Bar as... symbol buttons (image with text below)" key="board_detail_settings_speak_bar_symbols"}} aria-label={{t "Show on Speak Bar as... symbol buttons (image with text below)" key="board_detail_settings_speak_bar_symbols"}} {{action "set_utterance_text_only" "false"}}>
                                  <span class="md-settings-btnmock"><span class="md-settings-btnmock__img"></span><span class="md-settings-btnmock__text md-settings-btnmock__text--bottom">Aa</span></span>
                                </button>
                                <button type="button" role="radio" aria-checked={{if (is-equal this.utterance_text_only_str "true") "true" "false"}} class="md-settings-icon-btn {{if (is-equal this.utterance_text_only_str 'true') 'md-settings-icon-btn--active'}}" data-tooltip={{t "Show on Speak Bar as... words only (text, no symbols)" key="board_detail_settings_speak_bar_words"}} aria-label={{t "Show on Speak Bar as... words only (text, no symbols)" key="board_detail_settings_speak_bar_words"}} {{action "set_utterance_text_only" "true"}}>
                                  <span class="md-settings-btnmock"><span class="md-settings-btnmock__text md-settings-btnmock__text--only">Aa</span></span>
                                </button>
                              </div>
                            </div>
                            <div class="md-board-edit-right-panel__row-pair">
                              <span class="md-board-edit-right-panel__row-pair-label">{{t "Sentence Bar" key="board_detail_settings_voice_height"}}</span>
                              <div class="md-settings-dropdown-wrap">
                                <button type="button" class="md-settings-select md-settings-select--trigger {{if this.display_prefs_voice_height_dropdown_open 'md-settings-select--open'}}" aria-haspopup="listbox" aria-expanded={{if this.display_prefs_voice_height_dropdown_open "true" "false"}} data-tooltip={{t "Height of the speak-mode sentence bar" key="board_detail_prefs_voice_height_tooltip"}} aria-label={{t "Sentence bar size" key="board_detail_prefs_voice_height_aria"}} {{action "toggle_display_voice_height_dropdown"}}>
                                  <span class="md-settings-select__value">{{this.display_prefs_current_voice_height_label}}</span>
                                </button>
                                {{#if this.display_prefs_voice_height_dropdown_open}}
                                  <div class="md-settings-dropdown-backdrop" {{action "close_display_voice_height_dropdown"}} aria-hidden="true"></div>
                                  <ul class="md-settings-dropdown-menu" role="listbox" aria-label={{t "Sentence bar size" key="board_detail_prefs_voice_height_aria"}}>
                                    {{#each this.voice_height_options as |opt|}}
                                      <li>
                                        <button type="button" role="option" aria-selected={{if (is-equal this.appState.sessionUser.preferences.device.vocalization_height opt.id) "true" "false"}} class="md-settings-dropdown-item {{if (is-equal this.appState.sessionUser.preferences.device.vocalization_height opt.id) 'md-settings-dropdown-item--active'}}" {{action "pick_display_voice_height" opt.id}}>
                                          {{#if (is-equal this.appState.sessionUser.preferences.device.vocalization_height opt.id)}}
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                          {{else}}
                                            <span class="md-settings-dropdown-item__spacer" aria-hidden="true"></span>
                                          {{/if}}
                                          <span>{{opt.label}}</span>
                                        </button>
                                      </li>
                                    {{/each}}
                                  </ul>
                                {{/if}}
                              </div>
                            </div>
                          {{else}}
                            <p class="md-board-edit-right-panel__hint" style="font-style: italic; opacity: 0.6; margin: 0;">{{t "Controls coming soon." key="rail_section_coming_soon"}}</p>
                          {{/if}}
                        </div>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              </div>
            </aside>
            </div>
            {{else}}
              {{!-- AI mode, pre-generation: the whole Size & Labels UI
                   is gated behind this button. It calls the AI with the
                   required description, fills the labels, then flips
                   show_full_size_section so the full section renders. --}}
              <div class="nb-ai-generate">
                <p class="nb-ai-generate__lead">{{t "Generate this board's buttons from your description using AI. You'll be able to review and edit everything before creating the board." key="ai_generate_labels_lead"}}</p>
                {{!-- Over-limit warning: shows when the user dials the
                     rows/cols steppers past the recommended 112-button
                     ceiling. Also blocks the Generate button (via
                     ai_generate_disabled) until the user dials back
                     below 112. Larger boards become hard to scan, AI
                     label quality drops, and the per-button symbol
                     lookup rate-limits aggressively. --}}
                {{#if this.ai_button_count_over_limit}}
                  <div class="nb-alert nb-alert--warning" role="alert">
                    <span class="nb-alert__icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                        <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                      </svg>
                    </span>
                    <div class="nb-alert__body">
                      <p class="nb-alert__text">{{t "Your board size (%{n} buttons) is larger than the recommended 112. Reduce rows or columns to enable AI generation." n=this.ai_button_count key="ai_board_size_over_limit"}}</p>
                    </div>
                  </div>
                {{/if}}
                {{#if this.ai_generate_error}}
                  <div class="nb-alert nb-alert--warning" role="alert">
                    <span class="nb-alert__icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" focusable="false">
                        <path d="M10 1.6 L19 17.5 L1 17.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M10 7.5 L10 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <circle cx="10" cy="14.5" r="1" fill="currentColor"/>
                      </svg>
                    </span>
                    <div class="nb-alert__body">
                      <p class="nb-alert__text">{{this.ai_generate_error}}</p>
                    </div>
                  </div>
                {{/if}}
                <button type="button"
                        class="btn btn-primary nb-ai-generate__btn"
                        disabled={{this.ai_generate_disabled}}
                        aria-disabled={{if this.ai_generate_disabled "true" "false"}}
                        {{action "generate_labels_with_ai"}}>
                  {{#if this.ai_generating}}
                    {{t "Generating Labels…" key="ai_generating_labels"}}
                  {{else}}
                    {{t "Generate Labels with AI" key="ai_generate_labels_btn"}}
                  {{/if}}
                </button>
              </div>
            {{/if}}
          </div>
        </section>

        {{!-- AI mode: Visibility + Advanced options stay hidden until
             the user has run "Generate Labels with AI". In regular
             mode show_full_size_section is always true, so this is a
             no-op there. --}}
        {{#if this.show_full_size_section}}
        <section class="nb-section">
          <div class="nb-section__title-row">
            <h4 class="nb-section__title">{{t "Visibility" key="new_board_section_appearance"}}</h4>
            <span class="nb-section__optional-pill">{{t "optional" key="optional"}}</span>
          </div>
          <p class="nb-section__hint">{{t "Pick who can see this board." key="new_board_section_appearance_hint"}}</p>
          <div class="nb-section__body">
            <div class="nb-field new-board-field--visibility">
              {{modern-select class="new-board-visibility-select" selectId="new_board_visibility" content=this.public_options selection=this.model.visibility action=(action "setVisibility") ariaLabel=(t "Visibility" key="visibility")}}
            </div>
          </div>
        </section>

        <section class="nb-section nb-section--advanced">
          <button
            type="button"
            class="nb-advanced-toggle {{if this.more_options 'nb-advanced-toggle--open'}}"
            aria-expanded={{if this.more_options "true" "false"}}
            aria-controls="nb-advanced-panel"
            {{action "more_options"}}
          >
            <span class="nb-advanced-toggle__lockup">
              <div class="nb-section__title-row">
                <h4 class="nb-section__title nb-advanced-toggle__title">{{t "Advanced options" key="new_board_section_advanced"}}</h4>
                <span class="nb-section__optional-pill">{{t "optional" key="optional"}}</span>
              </div>
              <ul class="nb-section__hint nb-advanced-toggle__hint" role="list" aria-label={{t "Includes" key="advanced_options_includes_aria"}}>
                <li class="nb-advanced-toggle__hint-item">{{t "Fill order" key="advanced_hint_fill_order"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Board key" key="advanced_hint_board_key"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "License" key="advanced_hint_license"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Language" key="advanced_hint_language"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Home-board categories" key="advanced_hint_home_categories"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Word suggestions" key="advanced_hint_word_suggestions"}}</li>
                <li class="nb-advanced-toggle__hint-item">{{t "Icon" key="advanced_hint_icon"}}</li>
              </ul>
            </span>
            <svg class="nb-advanced-toggle__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          {{#if this.more_options}}
            <div id="nb-advanced-panel" class="nb-section__body">
              <div class="nb-field new-board-field--fill-order">
                <span class="nb-field__label">{{t "Fill order" key="fill_order"}}</span>
                <div class="nb-field__radio-group nb-field__radio-group--inline" role="radiogroup" aria-label={{t "Fill order" key="fill_order"}}>
                  <div class="nb-field__radio-row">
                    <label class="nb-radio">
                      <input type="radio"
                             name="labels_order"
                             value="rows"
                             checked={{is_equal this.model.grid.labels_order "rows"}}
                             onchange={{action "setLabelsOrder" "rows"}} />
                      <span class="nb-radio__label">{{t "Rows, left to right" key="rows_first_short"}}</span>
                    </label>
                    <label class="nb-radio">
                      <input type="radio"
                             name="labels_order"
                             value="columns"
                             checked={{is_equal this.model.grid.labels_order "columns"}}
                             onchange={{action "setLabelsOrder" "columns"}} />
                      <span class="nb-radio__label">{{t "Columns, top to bottom" key="columns_first_short"}}</span>
                    </label>
                  </div>
                </div>
              </div>
              <div class="nb-field new-board-field--key">
                <label for="new_board_key" class="nb-field__label">{{t "Key" key="key"}}</label>
                <Input @value={{this.model.key}} class="form-control nb-field__input nb-field__input--narrow" id="new_board_key" placeholder={{this.key_placeholder}} />
              </div>
              <div class="nb-field new-board-field--license">
                <label for="license" class="nb-field__label">{{t "License" key="license"}}</label>
                {{modern-select class="new-board-select--modern" selectId="license" content=this.license_options selection=this.model.license.type action=(action "setLicenseType") ariaLabel=(t "License" key="license")}}
              </div>
              <div class="nb-field new-board-field--locale">
                <label for="locale" class="nb-field__label">{{t "Language" key="locale"}}</label>
                {{modern-select class="new-board-select--modern" selectId="locale" content=this.locales selection=this.model.locale action=(action "setLocale") ariaLabel=(t "Language" key="locale")}}
              </div>
              {{#if this.attributable_license_type}}
                <div class="nb-field nb-field--row">
                  <div class="nb-field__col">
                    <label for="author" class="nb-field__label">{{t "Author" key="author"}}</label>
                    <Input @value={{this.model.license.author_name}} class="form-control nb-field__input" id="author" placeholder="Name" />
                  </div>
                  <div class="nb-field__col">
                    <label for="author_url" class="nb-field__label">{{t "Author URL" key="author_url"}}</label>
                    <Input @value={{this.model.license.author_url}} class="form-control nb-field__input" id="author_url" title="Author URL" placeholder="Author URL" />
                  </div>
                </div>
              {{/if}}
              <div class="nb-field nb-field--checkbox new-board-checkbox-row">
                <label for="home_board" class="nb-checkbox">
                  <Input @type="checkbox" @checked={{this.model.home_board}} id="home_board" />
                  <span>{{t "This board can be used as a home board" key="is_home_board"}}</span>
                </label>
              </div>
              {{#if this.model.home_board}}
                <div class="nb-field">
                  <p class="nb-field__hint">{{t "Select any categories that this home board may fit well into." key="select_categories"}}</p>
                  {{#each this.board_categories as |category|}}
                    <label class="nb-checkbox">
                      <Input @type="checkbox" @checked={{category.selected}} />
                      <span>{{category.name}}</span>
                    </label>
                  {{/each}}
                </div>
              {{/if}}
              <div class="nb-field nb-field--checkbox new-board-checkbox-row new-board-checkbox-row--suggestions">
                <label for="word_suggestions" class="nb-checkbox">
                  <Input @type="checkbox" @checked={{this.model.word_suggestions}} id="word_suggestions" />
                  <span>{{t "Show word completion suggestions" key="show_word_suggestions"}}</span>
                </label>
                <p class="nb-field__hint">{{t "(helpful for keyboard-style boards)" key="helpful_for_keyboard_boards"}}</p>
              </div>
              <div class="nb-field new-board-field--icon nb-icon-disclosure {{if this.icon_picker_open 'nb-icon-disclosure--open'}}">
                <button
                  type="button"
                  class="nb-icon-disclosure__toggle"
                  aria-expanded={{if this.icon_picker_open "true" "false"}}
                  aria-controls="nb-icon-picker-panel"
                  {{action "toggleIconPicker"}}
                >
                  <span class="nb-icon-disclosure__lockup">
                    <span class="nb-field__label nb-icon-disclosure__label">{{t "Icon for your Board" key="icon_for_your_board"}}</span>
                  </span>
                  <svg class="nb-icon-disclosure__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
                {{#if this.icon_picker_open}}
                  <div id="nb-icon-picker-panel" class="nb-icon-disclosure__panel">
                    {{icon-select selection=this.model.image_url action=(action (mut this.model.image_url)) }}
                  </div>
                {{/if}}
              </div>
            </div>
          {{/if}}
        </section>
        {{/if}}
      </form>
    </div>
    <div class="{{if this.standalone "modal-footer" "la-new-board-modal-footer"}}">
      {{!-- Visually hidden description tied to the Create button via
           aria-describedby. When fields are missing, the assistive
           technology announces what's needed; once everything's set
           the span clears. Replaces the previous inline floating hint —
           modern pattern (Stripe/Linear/Vercel) is to keep the disabled
           CTA self-explanatory and let the reason live in a tooltip /
           aria description, not as floating layout text. --}}
      <span id="new-board-create-hint" class="sr-only" aria-live="polite">{{this.missing_required_summary}}</span>
      {{#if this.standalone}}
      <div class="new-board__footer-actions">
        <button type="button" class="btn btn-default new-board__cancel" {{action "close"}}>{{t "Cancel" key="cancel"}}</button>
        <button {{action "attemptSave"}}
                class="btn btn-primary new-board__submit {{if this.createBoardDisabled 'new-board__submit--invalid'}}"
                aria-disabled={{if this.createBoardDisabled "true" "false"}}
                aria-describedby="new-board-create-hint">
          {{#if this.status.saving}}
            {{t "Creating Board..." key="creating_board"}}
          {{else if this.status.error}}
            {{t "Error Creating Board" key="error_creating_board"}}
          {{else}}
            {{t "Create Board" key="create_board"}}
          {{/if}}
        </button>
      </div>
      {{else}}
      <div class="la-new-board-modal-footer__actions">
        <button type="button" {{action "attemptSave"}}
                class="la-btn la-btn--primary new-board__submit {{if this.createBoardDisabled 'new-board__submit--invalid'}}"
                aria-disabled={{if this.createBoardDisabled "true" "false"}}
                aria-describedby="new-board-create-hint">
          {{#if this.status.saving}}
            {{t "Creating Board..." key="creating_board"}}
          {{else if this.status.error}}
            {{t "Error Creating Board" key="error_creating_board"}}
          {{else}}
            {{t "Create Board" key="create_board"}}
          {{/if}}
        </button>
        <button type="button" class="la-btn la-btn--ghost" {{action "close"}}>{{t "Cancel" key="cancel"}}</button>
      </div>
      {{/if}}
    </div>
  </div>
{{/grid-listener}}
