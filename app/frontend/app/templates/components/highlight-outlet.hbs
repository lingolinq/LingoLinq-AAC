{{#if this.settings}}
  {{#opening-observer opening=this.boundOpening closing=this.boundClosing}}
  {{#touch-listener release=(action "select_release" target=this.highlightController)}}
    <div class="highlight" style={{this.highlightController.model.top_style}} {{action "close" target=this.highlightController}}>
    </div>
    <div class="highlight" style={{this.highlightController.model.left_style}} {{action "close" target=this.highlightController}}>
    </div>
    <div class="highlight" style={{this.highlightController.model.right_style}} {{action "close" target=this.highlightController}}>
    </div>
    <div class="highlight" style={{this.highlightController.model.bottom_style}} {{action "close" target=this.highlightController}}>
    </div>
    <div class={{this.highlightController.highlight_class}} style={{this.highlightController.model.highlight_style}} {{action "select" target=this.highlightController}}>
    </div>
    <div class={{this.highlightController.highlight_inner_class}} id='highlight_box' style={{this.highlightController.model.inner_highlight_style}} {{action "select" target=this.highlightController}}>
      {{#if this.highlightController.model.icon_class}}
        <span class={{this.highlightController.model.icon_class}} style={{this.highlightController.model.icon_style}}></span>
      {{/if}}
    </div>
  {{/touch-listener}}
  {{/opening-observer}}
{{/if}}
