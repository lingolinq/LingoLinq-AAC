{{#if this.bareUserOutletLayout}}
  {{!-- BARE ROUTES bring their own shell, so they skip the `.md-shell--user` wrapper below --
       Reports (user.stats) renders `.md-shell--reports-view` instead. Reports is still an
       account-section page and still wants the nav, so the rail renders here too, and the
       gutter it needs is carried by a wrapper of its own rather than by `.md-shell--user-rail`
       (which this branch never gets).
       Gated on the SAME `accountRailContext` as the other branch, so the two can never
       disagree about which pages have a rail. Boards and the board routes are also bare but
       are not in that list, so they fall through to the plain outlet unchanged. --}}
  {{#if this.accountRailContext}}
    <AccountRail @user={{this.model}} />
    <div class="md-bare-rail-gutter">{{outlet}}</div>
  {{else}}
    {{outlet}}
  {{/if}}
{{else}}
<div class="md-user-layout hide_print">
  <div class="md-shell md-shell--user {{if this.accountRailContext "md-shell--user-rail"}}">
    {{!-- THE ACCOUNT SECTION NAV (2026-09-18). One instance here serves every page in the
         section: it used to live inside templates/user/index.hbs, so only the account page
         had it. `accountRailContext` (controllers/user.js) decides WHICH routes get it, and
         `md-shell--user-rail` above reserves the 208px the fixed panel occupies -- the two
         are driven by the same flag, so a page can never get the panel without the gutter or
         the gutter without the panel. --}}
    {{#if this.accountRailContext}}
      <AccountRail @user={{this.model}} />
    {{/if}}
    {{!-- `md-workspace--homenav` marks the ONE case the extra headroom applies to: the logs
         page reached from the home pill-nav's Updates. Same `homeNavContext` flag the nav
         choice below uses, so the padding and the nav can never disagree about which arrival
         this is. See the rule in app.scss. --}}
    <div class="md-workspace {{if this.homeNavContext "md-workspace--homenav"}}">
      {{!-- WHICH NAV, DECIDED BY WHERE THE USER CAME FROM (requested 2026-09-14).
           `homeNavContext` (controllers/user.js) is true only on the logs page and only when
           it was reached from the home page's Updates pill, which says so with `nav=home` in
           the URL. In that one case the HOME menu stays on screen with Updates active, so the
           user keeps the menu they were navigating with.
           EVERY OTHER user.* PAGE IS UNCHANGED — account, profile, settings, goals,
           recordings, and the logs page reached from the account nav's own Logs pill all keep
           the account nav below, which is the right menu for working through that section.
           Only ONE of the two renders, so there is never a second bar on the page. --}}
      {{#if this.accountRailContext}}
        {{!-- NOTHING HERE. These pages carry the left rail (<AccountRail />, rendered above)
             with the same destinations in it, so a pill row as well would put two menus on
             one page — and the top one read as the home dashboard's nav, which is what
             disoriented people. See `accountRailContext`. --}}
      {{else if this.homeNavContext}}
        {{!-- ARRIVED FROM THE HOME PILL-NAV'S "Updates" (`?nav=home`). The rail is suppressed
             for this case in `accountRailContext`, so exactly one nav renders: the home
             pill-nav, with Updates still marked current. Clicking Logs in the account rail
             instead carries no `nav` param, takes the branch above, and gets the rail with
             its Logs row current. One page, two origins, one nav each.
             Reports is no longer in this nav (2026-09-20) — it moved to the account rail,
             which the branch above renders. --}}
        <UserPillNav @active="updates" @userName={{this.model.user_name}} />
      {{else}}
        <nav class="md-pillnav md-pillnav--user" aria-label={{t "User menu" key="user_menu"}}>
          <LinkTo @route="index" class="md-pillnav__pill md-pillnav__pill--home">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 4px;"><polyline points="15 18 9 12 15 6"/></svg>
            {{t "Home" key="home"}}
          </LinkTo>
          <LinkTo @route="user.account" @model={{this.model.user_name}} class="md-pillnav__pill {{if (or (is-equal this.app_state.current_route 'user.index') (is-equal this.app_state.current_route 'user.account')) 'is-active'}}">{{t "Account" key="account_lower"}}</LinkTo>
          {{#if this.model.permissions.edit}}
            <LinkTo @route="user.edit" @model={{this.model.user_name}} class="md-pillnav__pill {{if (is-equal this.app_state.current_route 'user.edit') 'is-active'}}">{{t "Profile" key="profile_lower"}}</LinkTo>
            <LinkTo @route="user.preferences" @model={{this.model.user_name}} class="md-pillnav__pill {{if (is-equal this.app_state.current_route 'user.preferences') 'is-active'}}">{{t "Settings" key="preferences_lower"}}</LinkTo>
          {{/if}}
          <LinkTo @route="user.logs" @model={{this.model.user_name}} @query={{hash type="all"}} class="md-pillnav__pill {{if (is-equal this.app_state.current_route 'user.logs') 'is-active'}}">{{t "Logs" key="logs"}}</LinkTo>
        </nav>
        {{!-- ≤460px primary nav: the .md-pillnav--user pill row above is hidden at
             this breakpoint and this dropdown drawer takes its place, mirroring the
             home page's md-pillnav-dropdown. Native <details>/<summary> so the
             open/close state needs no controller wiring (same pattern as the
             caseload page). The trigger label reflects the current section. --}}
        <details class="md-pillnav-dropdown md-pillnav-dropdown--user" aria-label={{t "User menu" key="user_menu"}}>
          <summary class="md-pillnav-dropdown__trigger" aria-haspopup="menu">
            <span class="md-pillnav-dropdown__label">
              <svg class="md-pillnav-dropdown__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              {{#if (is-equal this.app_state.current_route 'user.edit')}}{{t "Profile" key="profile_lower"}}{{else if (is-equal this.app_state.current_route 'user.preferences')}}{{t "Settings" key="preferences_lower"}}{{else if (is-equal this.app_state.current_route 'user.logs')}}{{t "Logs" key="logs"}}{{else}}{{t "Account" key="account_lower"}}{{/if}}
            </span>
            <span class="md-pillnav-dropdown__chevron" aria-hidden="true"></span>
          </summary>
          <ul class="md-pillnav-dropdown__list">
            <li>
              <LinkTo @route="index" class="md-pillnav-dropdown__option">
                <svg class="md-pillnav-dropdown__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg>
                {{t "Home" key="home"}}
              </LinkTo>
            </li>
            <li>
              <LinkTo @route="user.account" @model={{this.model.user_name}} class="md-pillnav-dropdown__option {{if (or (is-equal this.app_state.current_route 'user.index') (is-equal this.app_state.current_route 'user.account')) 'is-active'}}">
                <svg class="md-pillnav-dropdown__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {{t "Account" key="account_lower"}}
              </LinkTo>
            </li>
            {{#if this.model.permissions.edit}}
              <li>
                <LinkTo @route="user.edit" @model={{this.model.user_name}} class="md-pillnav-dropdown__option {{if (is-equal this.app_state.current_route 'user.edit') 'is-active'}}">
                  <svg class="md-pillnav-dropdown__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                  {{t "Profile" key="profile_lower"}}
                </LinkTo>
              </li>
              <li>
                <LinkTo @route="user.preferences" @model={{this.model.user_name}} class="md-pillnav-dropdown__option {{if (is-equal this.app_state.current_route 'user.preferences') 'is-active'}}">
                  <svg class="md-pillnav-dropdown__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 8 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H1a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 8a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V1a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H23a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                  {{t "Settings" key="preferences_lower"}}
                </LinkTo>
              </li>
            {{/if}}
            <li>
              <LinkTo @route="user.logs" @model={{this.model.user_name}} @query={{hash type="all"}} class="md-pillnav-dropdown__option {{if (is-equal this.app_state.current_route 'user.logs') 'is-active'}}">
                <svg class="md-pillnav-dropdown__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                {{t "Logs" key="logs"}}
              </LinkTo>
            </li>
          </ul>
        </details>
      {{/if}}
      <main class="md-main md-main--user">
        {{outlet}}
      </main>
    </div>
  </div>
</div>
{{/if}}
