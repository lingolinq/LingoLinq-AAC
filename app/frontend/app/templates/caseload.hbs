<div id="index_view" class="row main_columns" style="touch-action: manipulation;">
<div class="md-shell md-shell--caseload">
  <div class="md-workspace">
    {{!-- Same primary pill-nav as the other supervisor pages (Home · Caseload ·
         Organizations · Boards · Reports · Extras · Account), with Caseload marked
         active. Responsive via .md-pillnav--dashboard (wraps on narrow screens). --}}
    <UserPillNav @active="caseload" @userName={{this.appState.currentUser.user_name}} />

    <article class="md-card md-card--sup" aria-label={{t "My Caseload" key="my_caseload"}}>
      {{!-- Header mirrors the Gentle-home SLP hero (centered title + slate-blue
           subheader) INCLUDING its from-left / from-right entrance motion — same
           classes, so style + movement stay in lockstep with the home page. The
           caseload page is #index_view (not .md-workspace), so md-hero--dashboard's
           :has()/tour-trigger positioning rules don't apply here. --}}
      <header class="md-hero md-hero--dashboard md-caseload__hero">
        <div class="md-slp-hero">
          <div class="md-slp-hero__text">
            <h1 class="md-hero__title md-slp-hero__title"><span class="md-hero__title--from-left">{{t "My Caseload" key="my_caseload"}}</span></h1>
            <p class="md-hero__sub md-slp-hero__sub"><span class="md-hero__sub--from-right">{{t "People you" key="people_you_pre"}} <span class="md-hero__gradient-text">{{t "support" key="support_word"}}</span></span></p>
          </div>
        </div>
      </header>

      <div class="md-caseload">
        {{#if this.supervisees.length}}
          {{!-- Filter input: case-insensitive substring match against
               user_name and goal summary. Mirrors the
               .board-picker__filter pattern used elsewhere in the app
               so the UX reads as familiar. --}}
          {{#if this.showSuperviseeFilter}}
            <div class="md-caseload__filter" role="search">
              <span class="md-caseload__filter-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </span>
              {{!-- Scope is stated in BOTH the placeholder and the accessible name:
                   the global "Search Boards" field in the app header looks similar,
                   and a placeholder alone is neither a label nor visible once the
                   user has typed. --}}
              <input type="search" value={{this.superviseeFilter}} class="md-caseload__filter-input" placeholder={{t "Filter caseload by name or goal" key="filter_caseload_placeholder"}} aria-label={{t "Filter caseload" key="filter_caseload"}} autocomplete="off" {{on "input" (set-field this "superviseeFilter")}} />
              {{#if this.superviseeFilter}}
                <button type="button" class="md-caseload__filter-clear" {{on "click" (this.ctrlActionNoBubble "clearSuperviseeFilter")}} aria-label={{t "Clear filter" key="clear_filter"}} title={{t "Clear filter" key="clear_filter"}}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              {{/if}}
            </div>
          {{/if}}
          {{#if this.filteredSupervisees.length}}
          {{!-- Compact student list (Google Classroom-style). When
               nothing is selected, every supervisee shows as a row.
               Clicking a row collapses the list to just that one
               supervisee and expands their full caseload card below.
               The "Full List" button restores the full roster. --}}
          {{!-- Accordion roster: every supervisee stays visible as a row;
               clicking a row's header expands that communicator's detail
               panel inline below it (pushing the rows below down) and
               clicking again collapses it. The panel is a SIBLING of the
               clickable header, so clicks inside it never toggle the row. --}}
          <ul class="md-caseload__list">
            {{#each this.filteredSupervisees as |supervisee|}}
              {{!-- --highlighted marks a row deep-linked from the dashboard's
                   "Communicators Need Attention" card when this supporter's link to
                   that communicator is modeling-only: we point at the person without
                   opening a panel whose actions are gated. Mutually exclusive with
                   --active by construction (see controllers/caseload.js). --}}
              <li class="md-caseload__list-row {{if (is-equal supervisee.user_name this.selectedSupervisee) "md-caseload__list-row--active"}} {{if (is-equal supervisee.user_name this.highlightedSupervisee) "md-caseload__list-row--highlighted"}}">
                <div class="md-caseload__list-header" {{on "click" (this.ctrlAction "selectSupervisee" supervisee)}}>
                {{!-- The trigger is a real <button> so keyboard users can focus it
                     and toggle with Enter/Space (the native click bubbles to the
                     header's selectSupervisee handler). It holds only non-interactive
                     content (avatar + name), so the quick-action buttons beside it
                     are never nested inside it. aria-expanded/-controls expose the
                     accordion state to assistive tech. --}}
                <button type="button" class="md-caseload__list-trigger" aria-expanded={{if (is-equal supervisee.user_name this.selectedSupervisee) "true" "false"}} aria-controls={{concat "caseload-panel-" supervisee.user_name}}>
                  {{#if supervisee.avatar_url}}
                    <img src={{supervisee.avatar_url}} alt="" class="md-caseload__list-avatar">
                  {{else}}
                    <span class="md-caseload__list-avatar md-caseload__list-avatar--placeholder" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" stroke="#46505F"/><path d="M4 21a8 8 0 0 1 16 0" stroke="#2A9D8F"/></svg>
                    </span>
                  {{/if}}
                  <span class="md-caseload__list-identity">
                    <span class="md-caseload__list-name-row">
                      {{!-- Wraps at the username's separators rather than mid-word
                           (see helpers/break-on-separators.js). --}}
                      <span class="md-caseload__list-name">{{break-on-separators supervisee.user_name}}</span>
                      {{!-- ROLE badge only. The STATUS badges ("Board needed" /
                           "<thing> needed") deliberately do NOT live here — they moved
                           to .md-caseload__list-status below, which is a full-width
                           second grid row. Keeping them here made the trigger's
                           max-content width the sum of every badge, and the flex
                           algorithm sizes wrap decisions off exactly that — so a third
                           badge shoved the whole quick-action toolbar onto its own
                           line. --}}
                      <span class="md-caseload__list-badges">
                        {{#if (is-equal supervisee.edit_permission true)}}
                          <span class="md-caseload__list-access md-caseload__list-access--edit" title={{t "You can view and edit this communicator's boards and settings." key="caseload_access_view_edit_hint"}}>{{t "Editor" key="caseload_access_editor"}}</span>
                        {{else if (is-equal supervisee.modeling_only true)}}
                          <span class="md-caseload__list-access md-caseload__list-access--modeling" title={{t "You are linked for modeling only; some supporter tools are limited." key="caseload_access_modeling_only_hint"}}>{{t "Model" key="caseload_access_modeling"}}</span>
                        {{else if (is-equal supervisee.edit_permission false)}}
                          <span class="md-caseload__list-access md-caseload__list-access--view" title={{t "You can view this communicator's profile and boards; editing is limited by their supervision settings." key="caseload_access_view_only_hint"}}>{{t "Viewer" key="caseload_access_viewer"}}</span>
                        {{/if}}
                        </span>
                    </span>
                    {{!-- No goal caption here: the collapsed row shows identity
                         only. Goals live in the expanded panel's GOALS block
                         below (md-caseload__bottom-row__goal), which carries the
                         count, status, primary tag and the add/edit affordances.
                         Filtering by goal text still works — the filter reads
                         displayed_goal_summary from the model, not the DOM. --}}
                  </span>
                  {{!-- STATUS BADGES — a full-width SECOND ROW of the trigger's grid
                       (grid-column: 1 / -1), so they start under the AVATAR rather than
                       indented under the name, and the avatar / name / role line above
                       keeps its natural width. That is what lets the quick-action
                       toolbar stay on the first row beside the name no matter how many
                       status badges apply.
                       Still INSIDE the trigger button, exactly as before, so the row's
                       accessible name and its whole-row click target are unchanged.
                       The wrapper is hidden by CSS when it holds no badges
                       (:not(:has(...))) rather than by a compound template guard, so
                       adding a third status badge later needs no condition rewrite. --}}
                  <span class="md-caseload__list-status">
                    {{!-- Setup-state badge. The condition is deliberately the SAME
                         pair of checks that decides whether the Choose Board button
                         renders below (no resolved home board, and not a
                         modeling-only link) — so the badge and the button can never
                         disagree, and a row showing Model never shows this.
                         Label is "Board needed", not "Setup needed": the expanded
                         panel already has a distinct Setup action (Setup User →
                         intro), so the generic word would name two different tasks
                         in one card. --}}
                    {{#unless supervisee.resolved_home_board_key}}
                      {{#unless supervisee.modeling_only}}
                        <span class="md-caseload__list-access md-caseload__list-access--setup" title={{t "This communicator has no home board yet — choose one to finish setting them up." key="caseload_board_needed_hint"}}>{{t "Board needed" key="caseload_board_needed"}}</span>
                      {{/unless}}
                    {{/unless}}
                    {{!-- ACTION REQUIRED — the row-level counterpart of the home
                         dashboard's "Communicators Need Attention" card. Both read
                         the same ATTENTION_STATUS_IDS list via
                         utils/dashboard_sections, so a communicator listed on that
                         card is always flagged here too. The helper returns null
                         for 'no-home-board' because the "Board needed" badge
                         directly above already says exactly that — the two never
                         double up on one row. Label is a terse "<thing> needed" to
                         match that badge; the full sentence lives in `title`. --}}
                    {{#let (attention-badge supervisee) as |att|}}
                      {{#if att}}
                        <span class="md-caseload__list-access md-caseload__list-access--attention" title={{att.hint}}>
                          <svg class="md-caseload__list-access-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                          {{att.label}}
                        </span>
                      {{/if}}
                    {{/let}}
                  </span>
                </button>
                <div class="md-caseload__list-quick" role="group" aria-label={{t "Quick actions" key="quick_actions"}}>
                  {{#if supervisee.resolved_home_board_key}}
                    <button type="button" class="md-caseload__quick-action md-caseload__quick-action--model" {{on "click" (this.ctrlActionNoBubble "caseload_model_for" supervisee)}} aria-label={{concat (t "Model for" key="model_for") " " supervisee.user_name}} title={{concat (t "Model for" key="model_for") " " supervisee.user_name}}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9.15" y="9.15" width="5.7" height="5.2" rx="0.8" fill="#2A9D8F" stroke="none"/><rect x="3" y="4" width="18" height="16" rx="2" stroke="#46505F"/><line x1="3" y1="9" x2="21" y2="9" stroke="#46505F"/><line x1="9" y1="9" x2="9" y2="20" stroke="#46505F"/><line x1="15" y1="9" x2="15" y2="20" stroke="#46505F"/><line x1="3" y1="14.5" x2="21" y2="14.5" stroke="#46505F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Model" key="caseload_qa_model"}}</span>
                    </button>
                  {{else if (is-equal supervisee.modeling_only true)}}
                    {{!-- Modeling-only links cannot set a home board for the
                         communicator — show a muted note instead of a dead-end CTA. --}}
                    <span class="md-caseload__quick-action md-caseload__quick-action--empty" role="note" aria-label={{t "No home board set for this communicator yet" key="model_unavailable_aria"}} data-tip={{t "Modeling needs a home board: an editor must set one for this communicator first." key="model_unavailable_tip"}}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor"/><line x1="3" y1="9" x2="21" y2="9" stroke="currentColor"/><line x1="5" y1="19" x2="19" y2="5" stroke="currentColor"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "No board" key="model_unavailable_short"}}</span>
                    </span>
                  {{else}}
                    {{!-- No home board yet — supervisors (view or edit) can open
                         /board-picker?user_id=… for this communicator. --}}
                    {{!-- Board-plus glyph, restored: this is a setup action, and it
                         must be identifiable without relying on its teal fill. The
                         label wraps to two lines under the icon inside the shared
                         tile width — see the --choose-board rules. Strokes are
                         recoloured to white in CSS for the solid teal fill. --}}
                    <button type="button" class="md-caseload__quick-action md-caseload__quick-action--choose-board" {{on "click" (this.ctrlActionNoBubble "caseload_set_home_board" supervisee)}} aria-label={{concat (t "Choose a home board for" key="choose_home_board_for") " " supervisee.user_name}} title={{t "No home board yet — choose one so you can model on this communicator's board." key="choose_home_board_hint"}}>
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="12.5" height="15" rx="2" stroke="#46505F"/><line x1="2" y1="8.5" x2="14.5" y2="8.5" stroke="#46505F"/><line x1="20" y1="14.5" x2="20" y2="21.5" stroke="#1A7B7A"/><line x1="16.5" y1="18" x2="23.5" y2="18" stroke="#1A7B7A"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Choose Board" key="caseload_qa_choose_board"}}</span>
                    </button>
                  {{/if}}
                  {{!-- Order: Speak, Reports, Note. Speak was promoted out of the
                       expanded panel into this slot (Assess went the other way,
                       taking Speak's place in ADDITIONAL ACTIONS) — same action,
                       same handler, same modeling-only gate, only the location
                       and therefore the styling family changed. DOM order IS the
                       visual order (nothing in the row reorders with CSS), so tab
                       order follows. --}}
                  {{!-- Speak has ONE precondition now: the communicator must have a
                       home board. Without one, set_speak_mode_user falls back to the
                       SUPPORTER's own home board (app-state.js ~2281), which would
                       drop the supporter onto their own board while attributed to
                       the communicator.
                       A modeling-only link USED to be blocked here too. That was UI
                       policy, not a backend rule: api/logs_controller#create needs
                       only `allowed?(user, 'model')` (:187), which every supervisor
                       including modeling-only holds (user.rb:63), and it records the
                       supporter as `:author` either way. Modelers may now Speak.
                       The placeholder is a <span role="note"> with no handler, so it
                       cannot fire, and it states the condition with colour, ink, the
                       lock badge and a title — not opacity. --}}
                  {{#if supervisee.resolved_home_board_key}}
                    <button type="button" class="md-caseload__quick-action md-caseload__quick-action--speak" {{on "click" (this.ctrlActionNoBubble "caseload_speak_as" supervisee)}} aria-label={{concat (t "Speak as" key="speak_as") " " supervisee.user_name}} title={{concat (t "Speak as" key="speak_as") " " supervisee.user_name}}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="10.5 5 6 9 2.5 9 2.5 15 6 15 10.5 19 10.5 5" stroke="#46505F"/><path d="M14.2 9.4a3.6 3.6 0 0 1 0 5.2" stroke="#2A9D8F"/><path d="M17.2 6.8a7.4 7.4 0 0 1 0 10.4" stroke="#2A9D8F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Speak" key="speak_short"}}</span>
                    </button>
                  {{else}}
                    <span class="md-caseload__quick-action md-caseload__quick-action--empty md-caseload__quick-action--speak" role="note" aria-label={{t "Speak — available once this communicator has a home board" key="speak_needs_board_aria"}} data-tip={{t "Speak needs a home board: choose one for this communicator and Speak turns on." key="speak_needs_board_tip"}}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="10.5 5 6 9 2.5 9 2.5 15 6 15 10.5 19 10.5 5" stroke="currentColor"/><path d="M14.2 9.4a3.6 3.6 0 0 1 0 5.2" stroke="currentColor"/><path d="M17.2 6.8a7.4 7.4 0 0 1 0 10.4" stroke="currentColor"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Speak" key="speak_short"}}</span>
                      <span class="md-caseload__action-lock" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8.75 10.5V7.75a3.25 3.25 0 0 1 6.5 0v2.75" stroke="#2A9D8F" stroke-width="1.8" stroke-linecap="round" fill="none"/><rect x="4.75" y="10.5" width="14.5" height="9.25" rx="2.4" fill="none" stroke="#8A93A3" stroke-width="1.8"/></svg></span>
                    </span>
                  {{/if}}
                  {{#if supervisee.modeling_only}}
                    <span class="md-caseload__quick-action md-caseload__quick-action--empty md-caseload__quick-action--reports" role="note" aria-label={{t "Reports — feature unavailable. Upgrade your account for usage reports, progress tracking, goals, assessments and full profile access." key="reports_locked_aria"}} data-tip={{t "Feature unavailable: Upgrade your account for usage reports, progress tracking, goals, assessments and full profile access." key="caseload_upgrade_tip"}}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="20" x2="6" y2="14" stroke="#46505F"/><line x1="12" y1="20" x2="12" y2="4" stroke="#2A9D8F"/><line x1="18" y1="20" x2="18" y2="10" stroke="#46505F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Reports" key="caseload_qa_reports"}}</span>
                      <span class="md-caseload__action-lock" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8.75 10.5V7.75a3.25 3.25 0 0 1 6.5 0v2.75" stroke="#2A9D8F" stroke-width="1.8" stroke-linecap="round" fill="none"/><rect x="4.75" y="10.5" width="14.5" height="9.25" rx="2.4" fill="none" stroke="#8A93A3" stroke-width="1.8"/></svg></span>
                    </span>
                  {{else}}
                  <LinkTo @route="user.stats" @model={{supervisee.user_name}} class="md-caseload__quick-action md-caseload__quick-action--reports" aria-label={{concat (t "Usage reports for" key="usage_reports_for") " " supervisee.user_name}} title={{t "Usage Reports" key="usage_reports"}}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="20" x2="6" y2="14" stroke="#46505F"/><line x1="12" y1="20" x2="12" y2="4" stroke="#2A9D8F"/><line x1="18" y1="20" x2="18" y2="10" stroke="#46505F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Reports" key="caseload_qa_reports"}}</span>
                  </LinkTo>
                  {{/if}}
                  {{!-- NOTE: no Setup button here. It used to occupy this slot,
                       gated on the communicator having no home board — exactly
                       when Choose Board is also shown — so it was a second
                       button for the same moment in the same row. Choose Board
                       is the one that actually completes the step (it opens the
                       board picker); Setup opened the `intro` walkthrough, which
                       is still reachable from the dashboard and the app shell. --}}
                  {{!-- Modeling Ideas was promoted out of ADDITIONAL ACTIONS into
                       this slot (Full Eval went the other way). Same handler,
                       same label, same icon — only the location, and therefore
                       the styling family, changed. --}}
                  {{#if supervisee.modeling_only}}
                    <span class="md-caseload__quick-action md-caseload__quick-action--empty md-caseload__quick-action--ideas" role="note" aria-label={{t "Modeling Ideas — feature unavailable. Upgrade your account for usage reports, progress tracking, goals, assessments and full profile access." key="ideas_locked_aria"}} data-tip={{t "Feature unavailable: Upgrade your account for usage reports, progress tracking, goals, assessments and full profile access." key="caseload_upgrade_tip"}}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z" stroke="#2A9D8F"/><path d="M9 18h6" stroke="#46505F"/><path d="M10 22h4" stroke="#46505F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Modeling Ideas" key="modeling_ideas"}}</span>
                      <span class="md-caseload__action-lock" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8.75 10.5V7.75a3.25 3.25 0 0 1 6.5 0v2.75" stroke="#2A9D8F" stroke-width="1.8" stroke-linecap="round" fill="none"/><rect x="4.75" y="10.5" width="14.5" height="9.25" rx="2.4" fill="none" stroke="#8A93A3" stroke-width="1.8"/></svg></span>
                    </span>
                  {{else}}
                  <button type="button" class="md-caseload__quick-action md-caseload__quick-action--ideas" {{on "click" (this.ctrlActionNoBubble "modeling_ideas" supervisee.user_name)}} aria-label={{concat (t "Modeling Ideas" key="modeling_ideas") " " supervisee.user_name}} title={{t "Modeling Ideas" key="modeling_ideas"}}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z" stroke="#2A9D8F"/><path d="M9 18h6" stroke="#46505F"/><path d="M10 22h4" stroke="#46505F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Modeling Ideas" key="modeling_ideas"}}</span>
                  </button>
                  {{/if}}
                  {{!-- Was a decorative chevron; now a labelled action in the same
                       family as its neighbours, so the way into the panel is as
                       obvious as the shortcuts beside it. NO click handler on
                       purpose: the header owns `selectSupervisee`, and this
                       button's click bubbles to it — which is also why it must
                       NOT use ctrlActionNoBubble like the other quick actions.
                       The icon keeps the chevron (and its flip on expand) because
                       that is what says "this opens in place"; the label supplies
                       the meaning. aria-expanded mirrors the header trigger. --}}
                  {{!-- NOT gated on modeling_only. This toggle only opens the
                        panel, and the panel is legitimately available on a
                        modeling-only link: it carries Speak, Home Board and
                        Modeling Ideas, which `model` permission grants. The
                        genuinely restricted items inside it — badges (:382) and
                        goals (:526) — carry their own "not available when you
                        are linked as modeling-only" copy.
                        It used to render a locked <span role="note"> here saying
                        the feature was unavailable, while clicking anywhere on
                        the row opened the panel regardless (the row header
                        carries selectSupervisee), so the lock claimed something
                        the UI immediately contradicted. --}}
                  <button type="button" class="md-caseload__quick-action md-caseload__quick-action--more" aria-expanded={{if (is-equal supervisee.user_name this.selectedSupervisee) "true" "false"}} aria-controls={{concat "caseload-panel-" supervisee.user_name}} aria-label={{concat (t "More actions for" key="caseload_more_actions_for") " " supervisee.user_name}}>
                    <span class="md-caseload__list-chevron" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </span>
                    <span class="md-caseload__quick-label" aria-hidden="true">{{t "More Actions" key="caseload_qa_more"}}</span>
                  </button>
                </div>
                </div>{{!-- /.md-caseload__list-header --}}
                {{#if (is-equal supervisee.user_name this.selectedSupervisee)}}
              <div class="md-caseload__card" id={{concat "caseload-panel-" supervisee.user_name}}>

                {{!-- Expanded-panel actions — the non-duplicate actions live
                     inside the panel (not the row header): Speak, Home Board,
                     Run Evaluation, Modeling Ideas, Account. Original tile
                     styling (.md-caseload__actions--tiles / --action--tile). --}}
                {{!-- Order: actions BEFORE goals. A supporter opening a card is
                     usually going somewhere (speak, home board, reports); goals
                     are what they read once they are here. --}}
                <div class="md-caseload__panel-actions">
                <div class="md-caseload__actions-eyebrow" aria-hidden="true">{{t "ADDITIONAL ACTIONS" key="quick_actions_eyebrow"}}</div>
                <div class="md-caseload__actions md-caseload__actions--tiles">
                  {{!-- Assess took Speak's place here when Speak was promoted to
                       the row's top actions. Unconditional, exactly as it was in
                       the row — it has no access-level gate of its own. --}}
                  {{!-- ALPHABETICAL by visible label — Account, Assess, Eval
                       History, Full Eval, Home Board, Quick Screen Eval. This
                       panel is a flat grid of unrelated tools with no natural
                       priority order, so A-Z is the ordering a supporter can
                       predict without learning it. DOM order is the visual order
                       (the grid does not reorder with CSS), so tab order follows.
                       Two notes for whoever edits this next:
                       - The Home Board slot renders "Setup" instead when the
                         communicator has no home board yet. It stays in the
                         Home Board position rather than jumping to S — the slot
                         holds one place in the grid, and a tile that moves when
                         a communicator's state changes is worse than one letter
                         out of order.
                       - Eval History, Full Eval and Quick Screen Eval share the
                         quick_screen_eval flag, so the flag now appears in two
                         blocks rather than one. Sorting has to win over grouping
                         here, otherwise the alphabet breaks whenever the flag is
                         on. --}}
                  <LinkTo @route="user" @model={{supervisee.user_name}} class="md-caseload__action md-caseload__action--tile md-caseload__action--account" aria-label={{concat (t "Account" key="account") " " supervisee.user_name}} title={{t "Account" key="account"}}>
                    <span class="md-caseload__action-tile__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#46505F"/><circle cx="12" cy="7" r="4" stroke="#2A9D8F"/></svg></span>
                    <span class="md-caseload__action-tile__label">{{t "Account" key="account"}}</span>
                  </LinkTo>
                  <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--assess" {{on "click" (this.ctrlActionNoBubble "quick_assessment" supervisee)}} aria-label={{concat (t "Quick assessment for" key="quick_assessment_for_lower") " " supervisee.user_name}} title={{t "Quick Assessment" key="quick_assessment"}}>
                    <span class="md-caseload__action-tile__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4.5h6a1 1 0 0 1 1 1V6h2.5a1.5 1.5 0 0 1 1.5 1.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5v-12A1.5 1.5 0 0 1 5.5 6H8v-.5a1 1 0 0 1 1-1z" stroke="#46505F"/><path d="M9 12.5l2.4 2.4L15.5 10" stroke="#2A9D8F" stroke-width="1.8"/></svg></span>
                    <span class="md-caseload__action-tile__label">{{t "Assess" key="caseload_qa_assess"}}</span>
                  </button>
                  {{#if this.appState.feature_flags.quick_screen_eval}}
                    <LinkTo @route="user.logs" @model={{supervisee.user_name}} @query={{hash type="eval"}} class="md-caseload__action md-caseload__action--tile md-caseload__action--history" aria-label={{concat (t "Eval history for" key="eval_history_for") " " supervisee.user_name}} title={{t "Eval History" key="eval_history_link"}}>
                      <span class="md-caseload__action-tile__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7" stroke="#46505F"/><polyline points="3 3.5 3 9 8.5 9" stroke="#46505F"/><path d="M12 8v4l3 2" stroke="#2A9D8F"/></svg></span>
                      <span class="md-caseload__action-tile__label">{{t "Eval History" key="eval_history_link"}}</span>
                    </LinkTo>
                    <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--run-eval" {{on "click" (this.ctrlActionNoBubble "run_eval" supervisee)}} aria-label={{concat (t "Run Evaluation" key="run_evaluation") " " supervisee.user_name}} title={{t "Run Evaluation" key="run_evaluation"}}>
                      <span class="md-caseload__action-tile__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6" stroke="#2A9D8F"/><path d="M15.5 13l1.5 8-5-3-5 3 1.5-8" stroke="#46505F"/></svg></span>
                      <span class="md-caseload__action-tile__label">{{t "Full Eval" key="caseload_qa_run_eval"}}</span>
                    </button>
                  {{/if}}
                  {{!-- NOTE: no Home Board tile here. Both of the row's leading
                       actions already open this communicator's home board —
                       Model opens it as the supporter, Speak opens it as the
                       communicator — so a third tile that opens the same board
                       with no mode attached was the odd one out, not a shortcut.
                       Nothing else linked to `@route="board"` from this panel. --}}
                  {{!-- Note came down from the row into Setup's old place. It has
                       no gate of its own, so it renders unconditionally — and it
                       lands between Home Board and Quick Screen Eval, which is
                       where the alphabet wants it anyway. --}}
                  <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--note" {{on "click" (this.ctrlActionNoBubble "record_note" supervisee)}} aria-label={{concat (t "New note for" key="new_note_for_lower") " " supervisee.user_name}} title={{t "New Note" key="new_note"}}>
                    <span class="md-caseload__action-tile__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" stroke="#46505F"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4z" stroke="#46505F"/><path d="M15 5l3 3" stroke="#2A9D8F"/></svg></span>
                    <span class="md-caseload__action-tile__label">{{t "Note" key="caseload_qa_note"}}</span>
                  </button>
                  {{#if this.appState.feature_flags.quick_screen_eval}}
                    <LinkTo @route="eval.quick" @model={{supervisee.user_name}} class="md-caseload__action md-caseload__action--tile md-caseload__action--eval" aria-label={{concat (t "Quick Screen Eval for" key="quick_screen_eval_for") " " supervisee.user_name}} title={{t "Quick Screen Eval (5 min)" key="quick_screen_eval_link"}}>
                      <span class="md-caseload__action-tile__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="14" r="8" stroke="#46505F"/><path d="M12 10v4l2 2" stroke="#2A9D8F"/><path d="M9 2h6" stroke="#46505F"/><path d="M19 5l1-1" stroke="#46505F"/></svg></span>
                      <span class="md-caseload__action-tile__label">{{t "Quick Screen Eval" key="quick_screen_eval"}}</span>
                    </LinkTo>
                  {{/if}}
                </div>
                </div>{{!-- /.md-caseload__panel-actions --}}

                {{!-- BADGE IN PROGRESS. Same content as the badge-awarded modal's
                     in-progress branch — image, name, level, time left, progress
                     bar, and the "to earn this badge…" explanation — laid out on
                     the goals section's surface so the two read as one family.
                     Rendered only when the selected communicator actually has a
                     badge under way (see _loadBadgeForSupervisee); no badge means
                     no section, rather than an empty placeholder competing with
                     goals for the supporter's attention.
                     The whole tile opens the real modal, so this is a preview of
                     it and never a second, divergent presentation. --}}
                {{#unless this.badgeLoading}}
                <div class="md-caseload__bottom-row md-caseload__bottom-row--badge">
                  <div class="md-caseload__bottom-row__goal">
                    <div class="md-caseload__goal-header">
                      <span class="md-caseload__goal-eyebrow-row" aria-hidden="true">
                        <span class="md-caseload__goal-eyebrow">{{t "BADGE IN PROGRESS" key="caseload_badge_eyebrow"}}</span>
                      </span>
                    </div>
                    {{#if this.selectedBadge}}
                    <button type="button" class="md-caseload__badge" {{on "click" (this.ctrlActionNoBubble "show_badge" this.selectedBadge)}} aria-label={{concat (t "Badge details for" key="caseload_badge_details_for") " " this.selectedBadge.name}}>
                      <span class="md-caseload__badge-medal">
                        {{#if this.selectedBadge.image_url}}
                          <img src={{this.selectedBadge.image_url}} alt="" onerror='button_broken_image(this)' data-fallback={{path "images/badge-fallback.png"}}>
                        {{else}}
                          <img src={{path "images/badge-fallback.png"}} alt="" onerror='button_broken_image(this)' data-fallback={{path "images/badge-fallback.png"}}>
                        {{/if}}
                      </span>
                      {{!-- Two columns: identity (name + level) on the left, and
                           everything about PROGRESS — time left, bar, percent,
                           and what it takes to earn — to its right. They wrap to
                           a single stack on narrow cards. --}}
                      <span class="md-caseload__badge-body">
                        <span class="md-caseload__badge-headings">
                          <span class="md-caseload__badge-name">{{this.selectedBadge.name}}</span>
                          {{#if this.selectedBadge.level}}
                            <span class="md-caseload__badge-level">{{t "Level %{level}" level=this.selectedBadge.level key="level_n2"}}</span>
                          {{/if}}
                        </span>
                        <span class="md-caseload__badge-status">
                          {{#if this.selectedBadge.time_left}}
                            <span class="md-caseload__badge-time">{{this.selectedBadge.time_left}}</span>
                          {{/if}}
                          {{!-- The bar is aria-hidden and the percentage is stated in
                               the adjacent status text instead — a progressbar role
                               here would announce a number with no context, and the
                               tile's own label already names the badge. --}}
                          <span class="md-caseload__badge-bar" aria-hidden="true">
                            <span class="md-caseload__badge-bar__fill" style={{this.selectedBadge.progress_style}}></span>
                          </span>
                          <span class="md-caseload__badge-pct" role="status">{{t "%{pct}% complete" key="caseload_badge_pct_complete" pct=this.selectedBadge.progress_out_of_100}}</span>
                          {{#if this.selectedBadge.completion_explanation}}
                            <span class="md-caseload__badge-explain">
                              <span class="md-caseload__badge-explain-lead">{{t "To earn this badge, %{user} needs to:" user=supervisee.user_name key="to_earn_user_needs_to"}}</span>
                              {{this.selectedBadge.completion_explanation}}
                            </span>
                          {{/if}}
                        </span>
                      </span>
                    </button>
                    {{else}}
                      {{!-- EMPTY STATE. Reuses the goals empty-state classes
                           verbatim — same icon slot, title, description and CTA
                           treatment — so the two sections of this panel stay one
                           design instead of two that drift apart.
                           The CTA opens the NEW GOAL flow, and the copy says so:
                           badges in this product are attached to goals (badge
                           authoring lives in BadgeSettings on the goals pages,
                           and the new-goal modal's templates carry badges), so a
                           button promising a standalone "new badge" would lead
                           somewhere that does not exist. Same online /
                           can_set_goals / modeling-only guards as the goals
                           empty state, for the same reasons. --}}
                      <div class="md-caseload__goal-empty">
                        <span class="md-caseload__goal-empty-icon" aria-hidden="true">
                          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6" stroke="#2A9D8F"/><path d="M15.5 13l1.5 8-5-3-5 3 1.5-8" stroke="#46505F"/></svg>
                        </span>
                        {{!-- On a modeling-only link this block is NOT "there is no
                             badge" — the badge query is refused (badges_controller
                             requires `view_detailed`, which ca629dda9 withholds from
                             modeling-only links), so a badge may well exist and simply
                             cannot be read. Saying "No badge in progress" there states
                             something the app does not know, and inviting the supporter
                             to "set one up" points at an action the same link forbids.
                             The explanatory hint below stays as the detail. --}}
                        {{#if supervisee.modeling_only}}
                          <p class="md-caseload__goal-empty-title">{{t "Badge progress not available" key="badge_progress_not_available"}}</p>
                        {{else}}
                          <p class="md-caseload__goal-empty-title">{{t "No badge in progress" key="no_badge_in_progress"}}</p>
                          <p class="md-caseload__goal-empty-desc">{{t "Badges are earned through goals — set one up to start tracking progress." key="badges_empty_desc"}}</p>
                        {{/if}}
                        {{#if this.persistence.online}}
                          {{#unless (is-equal supervisee.can_set_goals false)}}
                            <button type="button" class="md-caseload__goal-empty-add" {{on "click" (this.ctrlActionNoBubble "set_goal" supervisee)}}>
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                              <span>{{t "Add Goal with Badge" key="add_goal_with_badge"}}</span>
                            </button>
                          {{else}}
                            {{#if supervisee.modeling_only}}
                              <span class="md-caseload__goal-hint">{{t "Badges are not available when you are linked as modeling-only for this communicator." key="badges_unavailable_modeling_only_link"}}</span>
                            {{/if}}
                          {{/unless}}
                        {{/if}}
                      </div>
                    {{/if}}
                  </div>
                </div>
                {{/unless}}

                {{!-- GOALS. Was the last line INSIDE .md-caseload__card-top
                     (a flex-wrapped full-width child); it is now a direct child
                     of the card, below the actions section. Its own surface and
                     width:100% carry the layout — the flex-basis it used to rely
                     on is inert here. --}}
                <div class="md-caseload__bottom-row">
                  <div class="md-caseload__bottom-row__goal">
                    {{!-- GOAL eyebrow + chip — mirrors the ACCESS
                         eyebrow + badge pattern in the top-right
                         corner so the two corners share one
                         hierarchy language. The chip wrapper
                         (md-caseload__goal-row) is reused for both
                         the "goal set" and "no goal" states so the
                         visual treatment (sunken inset chip) is
                         identical regardless of whether a goal
                         exists. --}}
                    <div class="md-caseload__goal-header">
                      <span class="md-caseload__goal-eyebrow-row" aria-hidden="true">
                        <span class="md-caseload__goal-eyebrow">{{t "GOALS" key="goals_eyebrow"}}</span>
                        {{!-- Count prefers an explicit active_goals
                             array length if the supervisee payload
                             provides one; falls back to 0/1 based on
                             the legacy `goal` (primary_goal) field
                             which is all known_supervisees currently
                             exposes. --}}
                        <span class="md-caseload__goal-count">{{supervisee.goals_count}}</span>
                      </span>
                      {{!-- Add goal CTA promoted out of the chip and
                           pinned to the top-right of the goals
                           section, sharing a row with the GOALS
                           label + count. Only renders when the
                           supporter has permission to add goals. --}}
                      {{!-- Top-right Add goal shows only when goals already exist;
                           the empty state below carries its own centered CTA. --}}
                      {{#if supervisee.goals_count}}
                      {{#if this.persistence.online}}
                        {{#unless (is-equal supervisee.can_set_goals false)}}
                          <button type="button" class="md-caseload__goal-add" {{on "click" (this.ctrlActionNoBubble "set_goal" supervisee)}}>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            <span>{{t "Add goal" key="add_goal"}}</span>
                          </button>
                        {{/unless}}
                      {{/if}}
                      {{/if}}
                    </div>
                    {{#if supervisee.has_multiple_goals}}
                      {{!-- Multi-goal case: <details>/<summary> chip
                           showing the PRIMARY goal (with a "Primary"
                           pill marker) and an expand button on the
                           right. Clicking the chevron reveals the
                           full list of all active goals below the
                           summary row. --}}
                      <details class="md-caseload__goal-row md-caseload__goal-row--list">
                        <summary class="md-caseload__goal-summary">
                          <span class="md-caseload__goal md-caseload__goal--status-{{supervisee.displayed_goal_status}}" title={{supervisee.displayed_goal_summary}}>{{supervisee.displayed_goal_summary}}</span>
                          {{!-- Status + Primary tags are grouped on
                               the right so they read as a metadata
                               cluster, not floating siblings. The
                               status bullet (color-coded ::before
                               on .md-caseload__goal) carries the
                               color signal at the start; the small
                               status pill reinforces with text.  --}}
                          <span class="md-caseload__goal-tags">
                            {{#if supervisee.displayed_goal_is_primary}}
                              <span class="md-caseload__goal-primary-tag" aria-label={{t "Primary goal" key="primary_goal"}}>{{t "Primary" key="primary"}}</span>
                            {{/if}}
                            {{#if supervisee.displayed_goal_status}}
                              <span class="md-caseload__goal-status-tag md-caseload__goal-status-tag--{{supervisee.displayed_goal_status}}" aria-label={{t "Goal status" key="goal_status"}}>
                                {{#if (is-equal supervisee.displayed_goal_status "in_progress")}}{{t "In Progress" key="goal_status_in_progress"}}
                                {{else if (is-equal supervisee.displayed_goal_status "achieved")}}{{t "Achieved" key="goal_status_achieved"}}
                                {{else if (is-equal supervisee.displayed_goal_status "paused")}}{{t "Paused" key="goal_status_paused"}}
                                {{else}}{{t "Active" key="goal_status_active"}}
                                {{/if}}
                              </span>
                            {{/if}}
                          </span>
                          <span class="md-caseload__goal-row__chevron" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                          </span>
                        </summary>
                        <ul class="md-caseload__goal-list">
                          {{#each supervisee.active_goals as |g|}}
                            <li class="md-caseload__goal-list__item">
                              <span class="md-caseload__goal-list__dot md-caseload__goal-list__dot--{{g.status}}" aria-hidden="true"></span>
                              {{#if supervisee.edit_permission}}
                                <LinkTo @route="user.goal" @models={{array supervisee.user_name g.id}} class="md-caseload__goal-list__text md-caseload__goal-list__link" title={{g.summary}}>{{g.summary}}</LinkTo>
                              {{else}}
                                <span class="md-caseload__goal-list__text" title={{g.summary}}>{{g.summary}}</span>
                              {{/if}}
                              <span class="md-caseload__goal-tags">
                                {{#if g.primary}}
                                  <span class="md-caseload__goal-primary-tag" aria-label={{t "Primary goal" key="primary_goal"}}>{{t "Primary" key="primary"}}</span>
                                {{/if}}
                                {{#if g.status}}
                                  <span class="md-caseload__goal-status-tag md-caseload__goal-status-tag--{{g.status}}" aria-label={{t "Goal status" key="goal_status"}}>
                                    {{#if (is-equal g.status "in_progress")}}{{t "In Progress" key="goal_status_in_progress"}}
                                    {{else if (is-equal g.status "achieved")}}{{t "Achieved" key="goal_status_achieved"}}
                                    {{else if (is-equal g.status "paused")}}{{t "Paused" key="goal_status_paused"}}
                                    {{else}}{{t "Active" key="goal_status_active"}}
                                    {{/if}}
                                  </span>
                                {{/if}}
                              </span>
                            </li>
                          {{/each}}
                        </ul>
                      </details>
                    {{else if supervisee.goal}}
                      <div class="md-caseload__goal-row">
                        <span class="md-caseload__goal md-caseload__goal--status-active" title={{supervisee.goal.summary}}>{{supervisee.goal.summary}}</span>
                        <span class="md-caseload__goal-tags">
                          <span class="md-caseload__goal-status-tag md-caseload__goal-status-tag--active" aria-label={{t "Goal status" key="goal_status"}}>{{t "Active" key="goal_status_active"}}</span>
                          <span class="md-caseload__goal-primary-tag" aria-label={{t "Primary goal" key="primary_goal"}}>{{t "Primary" key="primary"}}</span>
                        </span>
                      </div>
                    {{else}}
                      {{!-- Rich empty state — reads as a feature, not a missing
                           one: target icon, headline, a one-line why, and the
                           Add Goal CTA (permission-gated; modeling-only shows the
                           explanatory hint instead). --}}
                      <div class="md-caseload__goal-empty">
                        <span class="md-caseload__goal-empty-icon" aria-hidden="true">
                          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" stroke="#2A9D8F"/><circle cx="12" cy="12" r="5" stroke="#46505F"/><circle cx="12" cy="12" r="1.4" fill="#2A9D8F" stroke="none"/></svg>
                        </span>
                        <p class="md-caseload__goal-empty-title">{{t "No goals assigned yet" key="no_goals_assigned_yet"}}</p>
                        <p class="md-caseload__goal-empty-desc">{{t "Goals help you track communication progress." key="goals_empty_desc"}}</p>
                        {{#if this.persistence.online}}
                          {{#unless (is-equal supervisee.can_set_goals false)}}
                            <button type="button" class="md-caseload__goal-empty-add" {{on "click" (this.ctrlActionNoBubble "set_goal" supervisee)}}>
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                              <span>{{t "Add Goal" key="add_goal"}}</span>
                            </button>
                          {{else}}
                            {{#if supervisee.modeling_only}}
                              <span class="md-caseload__goal-hint">{{t "Goals are not available when you are linked as modeling-only for this communicator." key="goals_unavailable_modeling_only_link"}}</span>
                            {{/if}}
                          {{/unless}}
                        {{/if}}
                      </div>
                    {{/if}}
                  </div>
                </div>

                {{#if supervisee.current_badge}}
                  {{#if supervisee.premium}}
                    <div class="md-caseload__badge-progress">
                      <BadgeProgress @badge={{supervisee.current_badge}} />
                    </div>
                  {{/if}}
                {{/if}}
              </div>{{!-- /.md-caseload__card --}}
                {{/if}}{{!-- /row expanded --}}
              </li>
            {{/each}}
          </ul>
          {{else}}
            {{!-- No matches for the active filter — empty state mirrors
                 the "no communicators yet" layout but with copy and an
                 action that point to clearing the filter. --}}
            <div class="md-caseload__empty md-caseload__empty--no-matches">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" stroke="#7693B9"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="#7693B9"/><line x1="8" y1="11" x2="14" y2="11" stroke="#2A9D8F"/>
              </svg>
              <p class="md-caseload__empty-title">{{t "No matches" key="no_matches"}}</p>
              <p class="md-caseload__empty-desc">{{t "No communicators match \"%{q}\"." key="no_supervisees_match_query" q=this.superviseeFilter}}</p>
              <button type="button" class="md-modal-btn md-modal-btn--cancel" {{on "click" (this.ctrlActionNoBubble "clearSuperviseeFilter")}}>{{t "Clear filter" key="clear_filter"}}</button>
            </div>
          {{/if}}
        {{else}}
          <div class="md-caseload__empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="#7693B9"/><circle cx="9" cy="7" r="4" stroke="#2A9D8F"/><path d="M23 21v-2a4 4 0 0 0-3-3.87" stroke="#7693B9"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="#2A9D8F"/>
            </svg>
            <p class="md-caseload__empty-title">{{t "No communicators yet" key="no_communicators_yet"}}</p>
            <p class="md-caseload__empty-desc">{{t "You have not been added as a supervisor for any communicators. For privacy reasons, supervisors must be added from the communicator's account." key="no_supervisors_explainer"}}</p>
          </div>
        {{/if}}
      </div>
    </article>
  </div>
</div>
</div>
