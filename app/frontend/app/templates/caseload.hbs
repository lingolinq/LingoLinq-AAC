<div id="index_view" class="row main_columns" style="touch-action: manipulation;">
<div class="md-shell md-shell--extras-view md-shell--caseload">
  <div class="md-workspace">
    <nav class="md-pillnav" aria-label={{t "Navigation" key="navigation"}}>
      <LinkTo @route="index" class="md-pillnav__pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 4px;"><polyline points="15 18 9 12 15 6"/></svg>
        {{t "Home" key="home"}}
      </LinkTo>
      <span class="md-pillnav__pill is-active">{{t "My Caseload" key="my_caseload"}}</span>
    </nav>

    <article class="md-card md-card--sup" aria-label={{t "My Caseload" key="my_caseload"}}>
      <div class="md-card__head md-card__head--between">
        <div>
          <h1 class="md-card__title">{{t "My Caseload" key="my_caseload"}}</h1>
          <div class="md-card__sub">{{t "People you support" key="people_you_support"}}</div>
        </div>
      </div>

      <div class="md-caseload">
        {{#if this.supervisees.length}}
          <div class="md-caseload__grid">
            {{#each this.supervisees as |supervisee|}}
              <div class="md-caseload__card">
                <div class="md-caseload__card-top">
                  <div class="md-caseload__card-main">
                    <LinkTo @route="user" @model={{supervisee.user_name}} class="md-caseload__avatar-link" aria-label={{t "Avatar for %{name}" key="avatar_for_name" name=supervisee.user_name}}>
                      {{!-- Apple "person.crop.circle.fill" style fallback
                           (matches the identity dropdown). Both the SVG
                           and the <img> render; CSS :has() in
                           .md-caseload__avatar-link hides whichever
                           doesn't apply: SVG shows when src is a legacy
                           /avatars/avatar-N.png placeholder; the real
                           uploaded photo shows otherwise. --}}
                      <svg class="md-caseload__avatar md-caseload__avatar--svg" viewBox="0 0 96 96" role="img" aria-label={{t "LingoLinq communicator avatar" key="lingolinq_communicator_avatar"}}>
                        <defs>
                          <linearGradient id="ll-avatar-bg-{{supervisee.user_name}}" x1="16" y1="10" x2="80" y2="88" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#F8FCFF"/>
                            <stop offset="0.55" stop-color="#EAF5F4"/>
                            <stop offset="1" stop-color="#EEF1FF"/>
                          </linearGradient>
                          <linearGradient id="ll-avatar-inner-{{supervisee.user_name}}" x1="28" y1="24" x2="70" y2="74" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#F7FBFF"/>
                            <stop offset="1" stop-color="#E5ECF4"/>
                          </linearGradient>
                          <linearGradient id="ll-avatar-mark-{{supervisee.user_name}}" x1="35" y1="30" x2="64" y2="69" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#5BAEA4"/>
                            <stop offset="1" stop-color="#222A4F"/>
                          </linearGradient>
                          <filter id="ll-avatar-shadow-{{supervisee.user_name}}" x="-20%" y="-20%" width="140%" height="140%">
                            <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#1F2A4D" flood-opacity="0.14"/>
                          </filter>
                        </defs>
                        <circle cx="48" cy="48" r="42" fill="url(#ll-avatar-bg-{{supervisee.user_name}})" filter="url(#ll-avatar-shadow-{{supervisee.user_name}})"/>
                        <circle cx="48" cy="48" r="40.75" fill="none" stroke="#FFFFFF" stroke-opacity="0.85" stroke-width="2"/>
                        <circle cx="48" cy="48" r="25" fill="url(#ll-avatar-inner-{{supervisee.user_name}})" stroke="#E8EEF4" stroke-width="1" stroke-opacity="0.7"/>
                        <circle cx="48" cy="38.5" r="8.5" fill="#5BAEA4"/>
                        <path d="M31.8 62.5C34.6 53.8 40.7 49.7 48 49.7C55.3 49.7 61.4 53.8 64.2 62.5C60.5 65.8 55 67.7 48 67.7C41 67.7 35.5 65.8 31.8 62.5Z" fill="url(#ll-avatar-mark-{{supervisee.user_name}})"/>
                      </svg>
                      <img src={{supervisee.avatar_url}} alt="" class="md-caseload__avatar">
                      {{#if supervisee.online}}
                        <span class="md-caseload__online" title={{t "currently online" key="currently_online"}}></span>
                      {{/if}}
                    </LinkTo>
                    <div class="md-caseload__info">
                      <span class="md-caseload__eyebrow" aria-hidden="true">{{t "COMMUNICATOR" key="communicator_eyebrow"}}</span>
                      <div class="md-caseload__name-line">
                        <LinkTo @route="user" @model={{supervisee.user_name}} class="md-caseload__name">{{supervisee.user_name}}</LinkTo>
                      </div>
                    </div>
                  </div>
                  <div class="md-caseload__card-corner">
                    <div class="md-caseload__access" aria-label={{t "Access" key="access"}}>
                      <span class="md-caseload__access-eyebrow" aria-hidden="true">{{t "ACCESS" key="access_eyebrow"}}</span>
                      {{#if (is-equal supervisee.edit_permission true)}}
                        <span class="md-caseload__access-badge md-caseload__access-badge--edit" title={{t "You can view and edit this communicator's boards and settings." key="caseload_access_view_edit_hint"}}>{{t "View & Edit" key="caseload_access_view_edit_caps"}}</span>
                      {{else if (is-equal supervisee.modeling_only true)}}
                        <span class="md-caseload__access-badge md-caseload__access-badge--modeling" title={{t "You are linked for modeling only; some supporter tools are limited." key="caseload_access_modeling_only_hint"}}>{{t "Modeling Only" key="caseload_access_modeling_only_caps"}}</span>
                      {{else if (is-equal supervisee.edit_permission false)}}
                        <span class="md-caseload__access-badge md-caseload__access-badge--view" title={{t "You can view this communicator's profile and boards; editing is limited by their supervision settings." key="caseload_access_view_only_hint"}}>{{t "View Only" key="caseload_access_view_only_caps"}}</span>
                      {{/if}}
                    </div>
                  </div>
                {{!-- Bottom row of the header — wraps to a new line
                     within .md-caseload__card-top via flex-wrap so the
                     goal chip can sit at the LEFT edge of the card and
                     the extras chevron stays at the RIGHT edge. Sits
                     ABOVE the card-top border-bottom divider. --}}
                <div class="md-caseload__bottom-row">
                  <div class="md-caseload__bottom-row__goal">
                    {{#if supervisee.goal}}
                      <span class="md-caseload__goal" title={{supervisee.goal.summary}}>{{supervisee.goal.summary}}</span>
                    {{else}}
                      <div class="md-caseload__goal-row">
                        <span class="md-caseload__goal md-caseload__goal--empty">{{t "No goal set" key="no_goal_set_cap"}}</span>
                        {{#if this.persistence.online}}
                          {{#if (is-equal supervisee.can_set_goals false)}}
                            {{#if supervisee.modeling_only}}
                              <span class="md-caseload__goal-hint">{{t "Goals are not available when you are linked as modeling-only for this communicator." key="goals_unavailable_modeling_only_link"}}</span>
                            {{/if}}
                          {{else}}
                            <button type="button" class="md-caseload__goal-add" {{action "set_goal" supervisee}}>
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                              <span>{{t "Add goal" key="add_goal"}}</span>
                            </button>
                          {{/if}}
                        {{/if}}
                      </div>
                    {{/if}}
                  </div>
                  <div class="md-caseload__extras-dropdown" {{action "extras_dropdown_keydown" on="keyDown"}}>
                      <button type="button" class="md-caseload__action md-caseload__action--corner-extras" data-toggle="dropdown" aria-haspopup="menu" aria-expanded="false" aria-label={{t "More options for %{name}" key="more_options_for_name" name=supervisee.user_name}} title={{t "Extras" key="extras"}}>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-right md-caseload__dropdown-menu">
                        {{#if supervisee.resolved_home_board_key}}
                          <li>
                            <LinkTo @route="board" @model={{supervisee.resolved_home_board_key}}>
                              <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 10.5L12 3l9 7.5" stroke="#2A9D8F"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" stroke="#46505F"/>
                              </svg>
                              <span>{{t "Home Board" key="home_board"}}</span>
                            </LinkTo>
                          </li>
                        {{/if}}
                        {{#unless supervisee.modeling_only}}
                          <li>
                            <button type="button" {{action "caseload_set_home_board" supervisee}}>
                              <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 10.5L12 3l9 7.5" stroke="#2A9D8F"/><path d="M5 12v7a2 2 0 0 0 2 2h4" stroke="#46505F"/><path d="M19 22v-6" stroke="#46505F"/><path d="M16 19l3 3 3-3" stroke="#2A9D8F"/>
                              </svg>
                              <span>{{t "Set home board" key="caseload_set_home_board"}}</span>
                            </button>
                          </li>
                        {{/unless}}
                        <li>
                          <LinkTo @route="user" @model={{supervisee.user_name}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#46505F"/><circle cx="12" cy="7" r="4" stroke="#2A9D8F"/>
                            </svg>
                            <span>{{t "Account" key="account"}}</span>
                          </LinkTo>
                        </li>
                        <li>
                          <button type="button" {{action "record_note" supervisee}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="#46505F"/><polyline points="14 2 14 8 20 8" stroke="#46505F"/><path d="M9 14l2 2 4-4" stroke="#2A9D8F"/>
                            </svg>
                            <span>{{t "New Note" key="new_note"}}</span>
                          </button>
                        </li>
                        <li>
                          <button type="button" {{action "quick_assessment" supervisee}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <rect x="5" y="3" width="14" height="18" rx="2" stroke="#46505F"/><path d="M9 3v2h6V3" stroke="#46505F"/><path d="M9 12l2 2 4-4" stroke="#2A9D8F"/>
                            </svg>
                            <span>{{t "Quick Assessment" key="quick_assessment"}}</span>
                          </button>
                        </li>
                        <li>
                          <button type="button" {{action "run_eval" supervisee}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <circle cx="12" cy="8" r="6" stroke="#2A9D8F"/><path d="M15.5 13l1.5 8-5-3-5 3 1.5-8" stroke="#46505F"/>
                            </svg>
                            <span>{{t "Run Evaluation" key="run_evaluation"}}</span>
                          </button>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>

                <div class="md-caseload__actions md-caseload__actions--tiles">
                  <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--primary"
                    aria-label={{concat (t "Model for" key="model_for") " " supervisee.user_name}}
                    title={{concat (t "Model for" key="model_for") " " supervisee.user_name}}
                    {{action "caseload_model_for" supervisee}}>
                    <span class="md-caseload__action-tile__icon" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="#46505F"/><path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="#2A9D8F"/>
                      </svg>
                    </span>
                    <span class="md-caseload__action-tile__label">{{t "Model" key="model_short"}}</span>
                  </button>
                  {{#unless supervisee.modeling_only}}
                    <button type="button" class="md-caseload__action md-caseload__action--tile"
                      aria-label={{concat (t "Speak as" key="speak_as") " " supervisee.user_name}}
                      title={{concat (t "Speak as" key="speak_as") " " supervisee.user_name}}
                      {{action "caseload_speak_as" supervisee}}>
                      <span class="md-caseload__action-tile__icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" stroke="#46505F"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07" stroke="#2A9D8F"/>
                        </svg>
                      </span>
                      <span class="md-caseload__action-tile__label">{{t "Speak" key="speak_short"}}</span>
                    </button>
                  {{/unless}}
                  {{#if supervisee.resolved_home_board_key}}
                    <LinkTo @route="board" @model={{supervisee.resolved_home_board_key}} class="md-caseload__action md-caseload__action--tile">
                      <span class="md-caseload__action-tile__icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 10.5L12 3l9 7.5" stroke="#2A9D8F"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" stroke="#46505F"/>
                        </svg>
                      </span>
                      <span class="md-caseload__action-tile__label">{{t "Home Board" key="home_board"}}</span>
                    </LinkTo>
                  {{else}}
                    <button type="button" class="md-caseload__action md-caseload__action--tile"
                      aria-label={{t "Setup User" key="setup_user"}}
                      title={{t "Setup User" key="setup_user"}}
                      {{action "intro" supervisee}}>
                      <span class="md-caseload__action-tile__icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#46505F"/><circle cx="12" cy="7" r="4" stroke="#2A9D8F"/>
                        </svg>
                      </span>
                      <span class="md-caseload__action-tile__label">{{t "Setup" key="setup_short"}}</span>
                    </button>
                  {{/if}}
                  <button type="button" class="md-caseload__action md-caseload__action--tile" {{action "stats" supervisee.user_name}}>
                    <span class="md-caseload__action-tile__icon" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="6" y1="20" x2="6" y2="14" stroke="#46505F"/><line x1="12" y1="20" x2="12" y2="4" stroke="#2A9D8F"/><line x1="18" y1="20" x2="18" y2="10" stroke="#46505F"/>
                      </svg>
                    </span>
                    <span class="md-caseload__action-tile__label">{{t "Usage Reports" key="usage_reports"}}</span>
                  </button>
                  <button type="button" class="md-caseload__action md-caseload__action--tile" {{action "modeling_ideas" supervisee.user_name}}>
                    <span class="md-caseload__action-tile__icon" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z" stroke="#2A9D8F"/><path d="M9 18h6" stroke="#46505F"/><path d="M10 22h4" stroke="#46505F"/>
                      </svg>
                    </span>
                    <span class="md-caseload__action-tile__label">{{t "Modeling Ideas" key="modeling_ideas"}}</span>
                  </button>
                </div>

                {{#if supervisee.current_badge}}
                  {{#if supervisee.premium}}
                    <div class="md-caseload__badge-progress">
                      {{badge-progress badge=supervisee.current_badge}}
                    </div>
                  {{/if}}
                {{/if}}
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="md-caseload__empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="#7693B9"/><circle cx="9" cy="7" r="4" stroke="#2A9D8F"/><path d="M23 21v-2a4 4 0 0 0-3-3.87" stroke="#7693B9"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="#2A9D8F"/>
            </svg>
            <p class="md-caseload__empty-title">{{t "No communicators yet" key="no_communicators_yet"}}</p>
            <p class="md-caseload__empty-desc">{{t "You have not been added as a supervisor for any communicators. For privacy reasons, supervisors must be added from the communicator's account." key="no_supervisors_explainer"}}</p>
          </div>
        {{/if}}
      </div>
    </article>
  </div>
</div>
</div>
