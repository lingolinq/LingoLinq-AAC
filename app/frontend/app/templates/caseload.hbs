<div id="index_view" class="row main_columns" style="touch-action: manipulation;">
<div class="md-shell md-shell--caseload">
  <div class="md-workspace">
    {{!-- Same primary pill-nav as the other supervisor pages (Home · Caseload ·
         Organizations · Boards · Reports · Extras · Account), with Caseload marked
         active. Responsive via .md-pillnav--dashboard (wraps on narrow screens). --}}
    <UserPillNav @active="caseload" @userName={{this.appState.currentUser.user_name}} />

    <article class="md-card md-card--sup" aria-label={{t "My Caseload" key="my_caseload"}}>
      {{!-- Header mirrors the Gentle-home SLP hero (centered title + slate-blue
           subheader) INCLUDING its from-left / from-right entrance motion — same
           classes, so style + movement stay in lockstep with the home page. The
           caseload page is #index_view (not .md-workspace), so md-hero--dashboard's
           :has()/tour-trigger positioning rules don't apply here. --}}
      <header class="md-hero md-hero--dashboard md-caseload__hero">
        <div class="md-slp-hero">
          <div class="md-slp-hero__text">
            <h1 class="md-hero__title md-slp-hero__title"><span class="md-hero__title--from-left">{{t "My Caseload" key="my_caseload"}}</span></h1>
            <p class="md-hero__sub md-slp-hero__sub"><span class="md-hero__sub--from-right">{{t "People you" key="people_you_pre"}} <span class="md-hero__gradient-text">{{t "support" key="support_word"}}</span><button type="button" class="md-caseload__guide-btn" {{action "showCaseloadGuide"}} aria-label={{t "What can I do on this page?" key="caseload_guide_aria"}} title={{t "What can I do on this page?" key="caseload_guide_aria"}}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button></span></p>
          </div>
        </div>
      </header>

      <div class="md-caseload">
        {{#if this.supervisees.length}}
          {{!-- Filter input: case-insensitive substring match against
               user_name and goal summary. Mirrors the
               .board-picker__filter pattern used elsewhere in the app
               so the UX reads as familiar. --}}
          {{#if this.showSuperviseeFilter}}
            <div class="md-caseload__filter" role="search">
              <span class="md-caseload__filter-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </span>
              <Input
                @type="search"
                @value={{this.superviseeFilter}}
                class="md-caseload__filter-input"
                placeholder={{t "Filter by name or goal..." key="filter_supervisees_placeholder"}}
                aria-label={{t "Filter supervisees" key="filter_supervisees"}}
                autocomplete="off"
              />
              {{#if this.superviseeFilter}}
                <button type="button" class="md-caseload__filter-clear" {{action "clearSuperviseeFilter"}} aria-label={{t "Clear filter" key="clear_filter"}} title={{t "Clear filter" key="clear_filter"}}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              {{/if}}
            </div>
          {{/if}}
          {{#if this.filteredSupervisees.length}}
          {{!-- Compact student list (Google Classroom-style). When
               nothing is selected, every supervisee shows as a row.
               Clicking a row collapses the list to just that one
               supervisee and expands their full caseload card below.
               The "Full List" button restores the full roster. --}}
          {{#if this.selectedSupervisee}}
            <div class="md-caseload__list-controls">
              <button type="button" class="md-caseload__back-to-list" {{action "clearSelectedSupervisee"}}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                <span>{{t "Full List" key="full_list"}}</span>
              </button>
            </div>
          {{/if}}
          <ul class="md-caseload__list">
            {{#each this.visibleSupervisees as |supervisee|}}
              <li class="md-caseload__list-row {{if (is-equal supervisee.user_name this.selectedSupervisee) "md-caseload__list-row--active"}}" {{action "selectSupervisee" supervisee}}>
                <div class="md-caseload__list-trigger">
                  {{#if supervisee.avatar_url}}
                    <img src={{supervisee.avatar_url}} alt="" class="md-caseload__list-avatar">
                  {{else}}
                    <span class="md-caseload__list-avatar md-caseload__list-avatar--placeholder" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" stroke="#46505F"/><path d="M4 21a8 8 0 0 1 16 0" stroke="#2A9D8F"/></svg>
                    </span>
                  {{/if}}
                  <span class="md-caseload__list-identity">
                    <span class="md-caseload__list-name">{{supervisee.user_name}}</span>
                    {{#if supervisee.displayed_goal_summary}}
                      <span class="md-caseload__list-goal" title={{supervisee.displayed_goal_summary}}>{{supervisee.displayed_goal_summary}}</span>
                    {{/if}}
                  </span>
                </div>
                <div class="md-caseload__list-quick" role="group" aria-label={{t "Quick actions" key="quick_actions"}}>
                  {{#if supervisee.resolved_home_board_key}}
                    <button type="button" class="md-caseload__quick-action md-caseload__quick-action--model" {{action "caseload_model_for" supervisee}} aria-label={{concat (t "Model for" key="model_for") " " supervisee.user_name}} title={{concat (t "Model for" key="model_for") " " supervisee.user_name}}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke="#46505F"/><line x1="3" y1="9" x2="21" y2="9" stroke="#46505F"/><line x1="9" y1="9" x2="9" y2="20" stroke="#46505F"/><line x1="15" y1="9" x2="15" y2="20" stroke="#46505F"/><line x1="3" y1="14.5" x2="21" y2="14.5" stroke="#46505F"/><rect x="10" y="10.5" width="4" height="2.5" rx="0.5" fill="#2A9D8F" stroke="none"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Model" key="caseload_qa_model"}}</span>
                    </button>
                  {{/if}}
                  <button type="button" class="md-caseload__quick-action md-caseload__quick-action--note" {{action "record_note" supervisee}} aria-label={{concat (t "New note for" key="new_note_for_lower") " " supervisee.user_name}} title={{t "New Note" key="new_note"}}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" stroke="#46505F"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4z" stroke="#46505F"/><path d="M15 5l3 3" stroke="#2A9D8F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Note" key="caseload_qa_note"}}</span>
                  </button>
                  <button type="button" class="md-caseload__quick-action md-caseload__quick-action--assess" {{action "quick_assessment" supervisee}} aria-label={{concat (t "Quick assessment for" key="quick_assessment_for_lower") " " supervisee.user_name}} title={{t "Quick Assessment" key="quick_assessment"}}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4.5h6a1 1 0 0 1 1 1V6h2.5a1.5 1.5 0 0 1 1.5 1.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5v-12A1.5 1.5 0 0 1 5.5 6H8v-.5a1 1 0 0 1 1-1z" stroke="#46505F"/><path d="M9 12.5l2.4 2.4L15.5 10" stroke="#2A9D8F" stroke-width="1.8"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Assess" key="caseload_qa_assess"}}</span>
                  </button>
                  <LinkTo @route="user.stats" @model={{supervisee.user_name}} class="md-caseload__quick-action md-caseload__quick-action--reports" aria-label={{concat (t "Usage reports for" key="usage_reports_for") " " supervisee.user_name}} title={{t "Usage Reports" key="usage_reports"}}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="20" x2="6" y2="14" stroke="#46505F"/><line x1="12" y1="20" x2="12" y2="4" stroke="#E87A6F"/><line x1="18" y1="20" x2="18" y2="10" stroke="#46505F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Reports" key="caseload_qa_reports"}}</span>
                  </LinkTo>
                  {{#if this.appState.feature_flags.quick_screen_eval}}
                    <LinkTo @route="eval.quick" @model={{supervisee.user_name}} class="md-caseload__quick-action md-caseload__quick-action--eval-quick" aria-label={{concat (t "Quick Screen Eval for" key="quick_screen_eval_for") " " supervisee.user_name}} title={{t "Quick Screen Eval (5 min)" key="quick_screen_eval_link"}}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="14" r="8" stroke="#46505F"/><path d="M12 10v4l2 2" stroke="#2A9D8F"/><path d="M9 2h6" stroke="#46505F"/><path d="M19 5l1-1" stroke="#46505F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "Eval" key="caseload_qa_eval"}}</span>
                    </LinkTo>
                    <LinkTo @route="user.logs" @model={{supervisee.user_name}} @query={{hash type="eval"}} class="md-caseload__quick-action md-caseload__quick-action--eval-history" aria-label={{concat (t "Eval history for" key="eval_history_for") " " supervisee.user_name}} title={{t "Eval History" key="eval_history_link"}}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" stroke="#46505F"/><polyline points="3 3.5 3 9 8.5 9" stroke="#46505F"/><path d="M12 8v4l3 2" stroke="#2A9D8F"/></svg><span class="md-caseload__quick-label" aria-hidden="true">{{t "History" key="caseload_qa_history"}}</span>
                    </LinkTo>
                  {{/if}}
                  <span class="md-caseload__list-chevron" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </div>
              </li>
            {{/each}}
          </ul>
          {{#if this.selectedSuperviseeRecord}}
          <div class="md-caseload__grid">
            {{#let this.selectedSuperviseeRecord as |supervisee|}}
              <div class="md-caseload__card">
                <div class="md-caseload__card-top">
                  {{!-- Identity-row pill — wraps the avatar, COMMUNICATOR
                       eyebrow, username, AND the ACCESS column in a
                       single premium surface so the entire header
                       reads as one chromatic identity node. The
                       chromatic ring + glass rim live on
                       .md-caseload__identity-row (NOT on individual
                       children) so all three columns share one halo. --}}
                  <div class="md-caseload__identity-row">
                  <div class="md-caseload__card-main">
                    <LinkTo @route="user" @model={{supervisee.user_name}} class="md-caseload__avatar-link" aria-label={{t "Avatar for %{name}" key="avatar_for_name" name=supervisee.user_name}}>
                      {{!-- Default-avatar fallback for caseload cards.
                           Previously rendered as an inline `<svg>` with
                           `<defs>` linearGradients + an feDropShadow
                           filter, referenced via `url(#gradient-id)`
                           and `url(#filter-id)`. Production asset
                           fingerprinting mangled those fragment refs,
                           so every gradient-filled shape painted
                           transparent and only the one solid-color
                           head circle stayed visible — leaving a
                           bare lavender dot on a faint ring. The
                           refs are now solid colors only: per-user
                           tint comes through via direct
                           `fill="{{supervisee.avatar_head_color}}"`
                           interpolation, no `<defs>` block, no
                           `url(#...)` to break. The drop-shadow
                           previously painted by the SVG filter is
                           replaced by the parent
                           `.md-caseload__avatar-link` box-shadow
                           (already present in the stack for hover
                           halo, see app.scss). --}}
                      <svg class="md-caseload__avatar md-caseload__avatar--svg" viewBox="0 0 96 96" role="img" aria-label={{t "LingoLinq communicator avatar" key="lingolinq_communicator_avatar"}}>
                        <circle cx="48" cy="48" r="42" fill="#EAF1F8"/>
                        <circle cx="48" cy="48" r="40.75" fill="none" stroke="#FFFFFF" stroke-opacity="0.85" stroke-width="2"/>
                        <circle cx="48" cy="48" r="25" fill="#F0F4FA" stroke="#E8EEF4" stroke-width="1" stroke-opacity="0.7"/>
                        <circle cx="48" cy="38.5" r="8.5" fill="{{supervisee.avatar_head_color}}"/>
                        <path d="M31.8 62.5C34.6 53.8 40.7 49.7 48 49.7C55.3 49.7 61.4 53.8 64.2 62.5C60.5 65.8 55 67.7 48 67.7C41 67.7 35.5 65.8 31.8 62.5Z" fill="{{supervisee.avatar_shadow_color}}"/>
                      </svg>
                      <img src={{supervisee.avatar_url}} alt="" class="md-caseload__avatar">
                      {{#if supervisee.online}}
                        <span class="md-caseload__online" title={{t "currently online" key="currently_online"}}></span>
                      {{/if}}
                    </LinkTo>
                    <div class="md-caseload__info">
                      {{!-- Hierarchy flipped: name as the visual
                           anchor (large, bold), role caption below
                           as a quiet sub-label. Reads as a profile
                           identity (Apple Account / Linear member
                           row) rather than a labeled form field. --}}
                      <div class="md-caseload__name-line">
                        <LinkTo @route="user" @model={{supervisee.user_name}} class="md-caseload__name">{{supervisee.user_name}}</LinkTo>
                      </div>
                      <span class="md-caseload__role" aria-hidden="true">{{t "Communicator" key="communicator_role"}}</span>
                    </div>
                  </div>
                  <div class="md-caseload__card-corner">
                    <div class="md-caseload__access" aria-label={{t "Access" key="access"}}>
                      <span class="md-caseload__access-eyebrow" aria-hidden="true">{{t "ACCESS" key="access_eyebrow"}}</span>
                      {{!-- Read-only status badge. Labels collapsed to
                           single-word roles (Editor / Viewer / Modeling)
                           so they read as status, not as clickable
                           actions. Title still carries the explanatory
                           text for hover/keyboard users. --}}
                      {{#if (is-equal supervisee.edit_permission true)}}
                        <span class="md-caseload__access-badge md-caseload__access-badge--edit" title={{t "You can view and edit this communicator's boards and settings." key="caseload_access_view_edit_hint"}}>{{t "Editor" key="caseload_access_editor"}}</span>
                      {{else if (is-equal supervisee.modeling_only true)}}
                        <span class="md-caseload__access-badge md-caseload__access-badge--modeling" title={{t "You are linked for modeling only; some supporter tools are limited." key="caseload_access_modeling_only_hint"}}>{{t "Modeling" key="caseload_access_modeling"}}</span>
                      {{else if (is-equal supervisee.edit_permission false)}}
                        <span class="md-caseload__access-badge md-caseload__access-badge--view" title={{t "You can view this communicator's profile and boards; editing is limited by their supervision settings." key="caseload_access_view_only_hint"}}>{{t "Viewer" key="caseload_access_viewer"}}</span>
                      {{/if}}
                    </div>
                  </div>
                  </div>{{!-- /.md-caseload__identity-row --}}
                {{!-- OPTIONS dropdown — promoted out of the access
                     column so it can sit horizontally centered on the
                     full card width, between the identity header
                     above and the goals/actions sections below. --}}
                <div class="md-caseload__options-row">
                  <div class="md-caseload__extras-dropdown" {{action "extras_dropdown_keydown" on="keyDown"}}>
                    <button type="button" class="md-caseload__action md-caseload__action--corner-extras" data-toggle="dropdown" aria-haspopup="menu" aria-expanded="false" aria-label={{t "More options for %{name}" key="more_options_for_name" name=supervisee.user_name}} title={{t "Extras" key="extras"}}>
                      <span class="md-caseload__action--corner-extras__label">{{t "OPTIONS" key="options_eyebrow"}}</span>
                      <svg class="md-caseload__action--corner-extras__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <ul class="dropdown-menu md-caseload__dropdown-menu">
                      {{#if supervisee.resolved_home_board_key}}
                        <li>
                          <LinkTo @route="board" @model={{supervisee.resolved_home_board_key}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M3 10.5L12 3l9 7.5" stroke="#2A9D8F"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" stroke="#46505F"/>
                            </svg>
                            <span>{{t "Home Board" key="home_board"}}</span>
                          </LinkTo>
                        </li>
                      {{/if}}
                      {{#unless supervisee.modeling_only}}
                        <li>
                          <button type="button" {{action "caseload_set_home_board" supervisee}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M3 10.5L12 3l9 7.5" stroke="#2A9D8F"/><path d="M5 12v7a2 2 0 0 0 2 2h4" stroke="#46505F"/><path d="M19 22v-6" stroke="#46505F"/><path d="M16 19l3 3 3-3" stroke="#2A9D8F"/>
                            </svg>
                            <span>{{t "Set home board" key="caseload_set_home_board"}}</span>
                          </button>
                        </li>
                      {{/unless}}
                      <li>
                        <LinkTo @route="user" @model={{supervisee.user_name}}>
                          <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#46505F"/><circle cx="12" cy="7" r="4" stroke="#2A9D8F"/>
                          </svg>
                          <span>{{t "Account" key="account"}}</span>
                        </LinkTo>
                      </li>
                      <li>
                        <button type="button" {{action "record_note" supervisee}}>
                          <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="#46505F"/><polyline points="14 2 14 8 20 8" stroke="#46505F"/><path d="M9 14l2 2 4-4" stroke="#2A9D8F"/>
                          </svg>
                          <span>{{t "New Note" key="new_note"}}</span>
                        </button>
                      </li>
                      <li>
                        <button type="button" {{action "quick_assessment" supervisee}}>
                          <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="5" y="3" width="14" height="18" rx="2" stroke="#46505F"/><path d="M9 3v2h6V3" stroke="#46505F"/><path d="M9 12l2 2 4-4" stroke="#2A9D8F"/>
                          </svg>
                          <span>{{t "Quick Assessment" key="quick_assessment"}}</span>
                        </button>
                      </li>
                      <li>
                        <button type="button" {{action "run_eval" supervisee}}>
                          <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="8" r="6" stroke="#2A9D8F"/><path d="M15.5 13l1.5 8-5-3-5 3 1.5-8" stroke="#46505F"/>
                          </svg>
                          <span>{{t "Run Evaluation" key="run_evaluation"}}</span>
                        </button>
                      </li>
                      {{#if this.appState.feature_flags.quick_screen_eval}}
                        <li>
                          <LinkTo @route="eval.quick" @model={{supervisee.user_name}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <circle cx="12" cy="14" r="8" stroke="#46505F"/>
                              <path d="M12 10v4l2 2" stroke="#2A9D8F"/>
                              <path d="M9 2h6" stroke="#46505F"/>
                              <path d="M19 5l1-1" stroke="#46505F"/>
                            </svg>
                            <span>{{t "Quick Screen Eval (5 min)" key="quick_screen_eval_link"}}</span>
                          </LinkTo>
                        </li>
                        <li>
                          <LinkTo @route="user.logs" @model={{supervisee.user_name}} @query={{hash type="eval"}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M3 12a9 9 0 1 0 3-6.7" stroke="#46505F"/>
                              <polyline points="3 3.5 3 9 8.5 9" stroke="#46505F"/>
                              <path d="M12 8v4l3 2" stroke="#2A9D8F"/>
                            </svg>
                            <span>{{t "Eval History" key="eval_history_link"}}</span>
                          </LinkTo>
                        </li>
                      {{/if}}
                    </ul>
                  </div>
                </div>
                {{!-- Bottom row of the header — wraps to a new line
                     within .md-caseload__card-top via flex-wrap so the
                     goal chip can sit at the LEFT edge of the card and
                     the extras chevron stays at the RIGHT edge. Sits
                     ABOVE the card-top border-bottom divider. --}}
                <div class="md-caseload__bottom-row">
                  <div class="md-caseload__bottom-row__goal">
                    {{!-- GOAL eyebrow + chip — mirrors the ACCESS
                         eyebrow + badge pattern in the top-right
                         corner so the two corners share one
                         hierarchy language. The chip wrapper
                         (md-caseload__goal-row) is reused for both
                         the "goal set" and "no goal" states so the
                         visual treatment (sunken inset chip) is
                         identical regardless of whether a goal
                         exists. --}}
                    <div class="md-caseload__goal-header">
                      <span class="md-caseload__goal-eyebrow-row" aria-hidden="true">
                        <span class="md-caseload__goal-eyebrow">{{t "GOALS" key="goals_eyebrow"}}</span>
                        {{!-- Count prefers an explicit active_goals
                             array length if the supervisee payload
                             provides one; falls back to 0/1 based on
                             the legacy `goal` (primary_goal) field
                             which is all known_supervisees currently
                             exposes. --}}
                        <span class="md-caseload__goal-count">{{supervisee.goals_count}}</span>
                      </span>
                      {{!-- Add goal CTA promoted out of the chip and
                           pinned to the top-right of the goals
                           section, sharing a row with the GOALS
                           label + count. Only renders when the
                           supporter has permission to add goals. --}}
                      {{#if this.persistence.online}}
                        {{#unless (is-equal supervisee.can_set_goals false)}}
                          <button type="button" class="md-caseload__goal-add" {{action "set_goal" supervisee}}>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            <span>{{t "Add goal" key="add_goal"}}</span>
                          </button>
                        {{/unless}}
                      {{/if}}
                    </div>
                    {{#if supervisee.has_multiple_goals}}
                      {{!-- Multi-goal case: <details>/<summary> chip
                           showing the PRIMARY goal (with a "Primary"
                           pill marker) and an expand button on the
                           right. Clicking the chevron reveals the
                           full list of all active goals below the
                           summary row. --}}
                      <details class="md-caseload__goal-row md-caseload__goal-row--list">
                        <summary class="md-caseload__goal-summary">
                          <span class="md-caseload__goal md-caseload__goal--status-{{supervisee.displayed_goal_status}}" title={{supervisee.displayed_goal_summary}}>{{supervisee.displayed_goal_summary}}</span>
                          {{!-- Status + Primary tags are grouped on
                               the right so they read as a metadata
                               cluster, not floating siblings. The
                               status bullet (color-coded ::before
                               on .md-caseload__goal) carries the
                               color signal at the start; the small
                               status pill reinforces with text.  --}}
                          <span class="md-caseload__goal-tags">
                            {{#if supervisee.displayed_goal_is_primary}}
                              <span class="md-caseload__goal-primary-tag" aria-label={{t "Primary goal" key="primary_goal"}}>{{t "Primary" key="primary"}}</span>
                            {{/if}}
                            {{#if supervisee.displayed_goal_status}}
                              <span class="md-caseload__goal-status-tag md-caseload__goal-status-tag--{{supervisee.displayed_goal_status}}" aria-label={{t "Goal status" key="goal_status"}}>
                                {{#if (is-equal supervisee.displayed_goal_status "in_progress")}}{{t "In Progress" key="goal_status_in_progress"}}
                                {{else if (is-equal supervisee.displayed_goal_status "achieved")}}{{t "Achieved" key="goal_status_achieved"}}
                                {{else if (is-equal supervisee.displayed_goal_status "paused")}}{{t "Paused" key="goal_status_paused"}}
                                {{else}}{{t "Active" key="goal_status_active"}}
                                {{/if}}
                              </span>
                            {{/if}}
                          </span>
                          <span class="md-caseload__goal-row__chevron" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                          </span>
                        </summary>
                        <ul class="md-caseload__goal-list">
                          {{#each supervisee.active_goals as |g|}}
                            <li class="md-caseload__goal-list__item">
                              <span class="md-caseload__goal-list__dot md-caseload__goal-list__dot--{{g.status}}" aria-hidden="true"></span>
                              {{#if supervisee.edit_permission}}
                                <LinkTo @route="user.goal" @models={{array supervisee.user_name g.id}} class="md-caseload__goal-list__text md-caseload__goal-list__link" title={{g.summary}}>{{g.summary}}</LinkTo>
                              {{else}}
                                <span class="md-caseload__goal-list__text" title={{g.summary}}>{{g.summary}}</span>
                              {{/if}}
                              <span class="md-caseload__goal-tags">
                                {{#if g.primary}}
                                  <span class="md-caseload__goal-primary-tag" aria-label={{t "Primary goal" key="primary_goal"}}>{{t "Primary" key="primary"}}</span>
                                {{/if}}
                                {{#if g.status}}
                                  <span class="md-caseload__goal-status-tag md-caseload__goal-status-tag--{{g.status}}" aria-label={{t "Goal status" key="goal_status"}}>
                                    {{#if (is-equal g.status "in_progress")}}{{t "In Progress" key="goal_status_in_progress"}}
                                    {{else if (is-equal g.status "achieved")}}{{t "Achieved" key="goal_status_achieved"}}
                                    {{else if (is-equal g.status "paused")}}{{t "Paused" key="goal_status_paused"}}
                                    {{else}}{{t "Active" key="goal_status_active"}}
                                    {{/if}}
                                  </span>
                                {{/if}}
                              </span>
                            </li>
                          {{/each}}
                        </ul>
                      </details>
                    {{else if supervisee.goal}}
                      <div class="md-caseload__goal-row">
                        <span class="md-caseload__goal md-caseload__goal--status-active" title={{supervisee.goal.summary}}>{{supervisee.goal.summary}}</span>
                        <span class="md-caseload__goal-tags">
                          <span class="md-caseload__goal-status-tag md-caseload__goal-status-tag--active" aria-label={{t "Goal status" key="goal_status"}}>{{t "Active" key="goal_status_active"}}</span>
                          <span class="md-caseload__goal-primary-tag" aria-label={{t "Primary goal" key="primary_goal"}}>{{t "Primary" key="primary"}}</span>
                        </span>
                      </div>
                    {{else}}
                      <div class="md-caseload__goal-row">
                        <span class="md-caseload__goal md-caseload__goal--empty">{{t "No goal set" key="no_goal_set_cap"}}</span>
                        {{#if this.persistence.online}}
                          {{#if (is-equal supervisee.can_set_goals false)}}
                            {{#if supervisee.modeling_only}}
                              <span class="md-caseload__goal-hint">{{t "Goals are not available when you are linked as modeling-only for this communicator." key="goals_unavailable_modeling_only_link"}}</span>
                            {{/if}}
                          {{/if}}
                        {{/if}}
                      </div>
                    {{/if}}
                  </div>
                </div>
                </div>{{!-- /.md-caseload__card-top --}}

                <div class="md-caseload__actions md-caseload__actions--tiles">
                  <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--primary md-caseload__action--model"
                    aria-label={{concat (t "Model for" key="model_for") " " supervisee.user_name}}
                    title={{concat (t "Model for" key="model_for") " " supervisee.user_name}}
                    {{action "caseload_model_for" supervisee}}>
                    <span class="md-caseload__action-tile__icon" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="#46505F"/><path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="#2A9D8F"/>
                      </svg>
                    </span>
                    <span class="md-caseload__action-tile__label">{{t "Model" key="model_short"}}</span>
                  </button>
                  {{#unless supervisee.modeling_only}}
                    <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--speak"
                      aria-label={{concat (t "Speak as" key="speak_as") " " supervisee.user_name}}
                      title={{concat (t "Speak as" key="speak_as") " " supervisee.user_name}}
                      {{action "caseload_speak_as" supervisee}}>
                      <span class="md-caseload__action-tile__icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" stroke="#46505F"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07" stroke="#4C86D8"/>
                        </svg>
                      </span>
                      <span class="md-caseload__action-tile__label">{{t "Speak" key="speak_short"}}</span>
                    </button>
                  {{/unless}}
                  {{#if supervisee.resolved_home_board_key}}
                    <LinkTo @route="board" @model={{supervisee.resolved_home_board_key}} class="md-caseload__action md-caseload__action--tile md-caseload__action--setup">
                      <span class="md-caseload__action-tile__icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 10.5L12 3l9 7.5" stroke="#8B5CF6"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" stroke="#46505F"/>
                        </svg>
                      </span>
                      <span class="md-caseload__action-tile__label">{{t "Home Board" key="home_board"}}</span>
                    </LinkTo>
                  {{else}}
                    <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--setup"
                      aria-label={{t "Setup User" key="setup_user"}}
                      title={{t "Setup User" key="setup_user"}}
                      {{action "intro" supervisee}}>
                      <span class="md-caseload__action-tile__icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#46505F"/><circle cx="12" cy="7" r="4" stroke="#8B5CF6"/>
                        </svg>
                      </span>
                      <span class="md-caseload__action-tile__label">{{t "Setup" key="setup_short"}}</span>
                    </button>
                  {{/if}}
                  <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--reports" {{action "stats" supervisee.user_name}}>
                    <span class="md-caseload__action-tile__icon" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="6" y1="20" x2="6" y2="14" stroke="#46505F"/><line x1="12" y1="20" x2="12" y2="4" stroke="#E87A6F"/><line x1="18" y1="20" x2="18" y2="10" stroke="#46505F"/>
                      </svg>
                    </span>
                    <span class="md-caseload__action-tile__label">{{t "Usage Reports" key="usage_reports"}}</span>
                  </button>
                  <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--ideas" {{action "modeling_ideas" supervisee.user_name}}>
                    <span class="md-caseload__action-tile__icon" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z" stroke="#F2B95A"/><path d="M9 18h6" stroke="#46505F"/><path d="M10 22h4" stroke="#46505F"/>
                      </svg>
                    </span>
                    <span class="md-caseload__action-tile__label">{{t "Modeling Ideas" key="modeling_ideas"}}</span>
                  </button>
                  {{!-- More Actions — visible only at <=950px (CSS-gated).
                       Mirrors the dropdown trigger from the chevron in the
                       goal-row area, but rendered as a tile so the
                       narrower layout doesn't have to display the corner
                       chevron. The chevron itself is hidden at the same
                       breakpoint. Menu items duplicated below; both
                       triggers route to the same actions. --}}
                  <div class="md-caseload__extras-dropdown md-caseload__extras-dropdown--mobile">
                    <button type="button" class="md-caseload__action md-caseload__action--tile md-caseload__action--more" data-toggle="dropdown" aria-haspopup="menu" aria-expanded="false" aria-label={{t "More options for %{name}" key="more_options_for_name" name=supervisee.user_name}}>
                      <span class="md-caseload__action-tile__icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="5" cy="12" r="1.5" stroke="#46505F" fill="#46505F"/>
                          <circle cx="12" cy="12" r="1.5" stroke="#2A9D8F" fill="#2A9D8F"/>
                          <circle cx="19" cy="12" r="1.5" stroke="#46505F" fill="#46505F"/>
                        </svg>
                      </span>
                      <span class="md-caseload__action-tile__label">{{t "More Actions" key="more_actions"}}</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right md-caseload__dropdown-menu">
                      {{#if supervisee.resolved_home_board_key}}
                        <li>
                          <LinkTo @route="board" @model={{supervisee.resolved_home_board_key}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M3 10.5L12 3l9 7.5" stroke="#2A9D8F"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" stroke="#46505F"/>
                            </svg>
                            <span>{{t "Home Board" key="home_board"}}</span>
                          </LinkTo>
                        </li>
                      {{/if}}
                      {{#unless supervisee.modeling_only}}
                        <li>
                          <button type="button" {{action "caseload_set_home_board" supervisee}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M3 10.5L12 3l9 7.5" stroke="#2A9D8F"/><path d="M5 12v7a2 2 0 0 0 2 2h4" stroke="#46505F"/><path d="M19 22v-6" stroke="#46505F"/><path d="M16 19l3 3 3-3" stroke="#2A9D8F"/>
                            </svg>
                            <span>{{t "Set home board" key="caseload_set_home_board"}}</span>
                          </button>
                        </li>
                      {{/unless}}
                      <li>
                        <LinkTo @route="user" @model={{supervisee.user_name}}>
                          <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#46505F"/><circle cx="12" cy="7" r="4" stroke="#2A9D8F"/>
                          </svg>
                          <span>{{t "Account" key="account"}}</span>
                        </LinkTo>
                      </li>
                      <li>
                        <button type="button" {{action "record_note" supervisee}}>
                          <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="#46505F"/><polyline points="14 2 14 8 20 8" stroke="#46505F"/><path d="M9 14l2 2 4-4" stroke="#2A9D8F"/>
                          </svg>
                          <span>{{t "New Note" key="new_note"}}</span>
                        </button>
                      </li>
                      <li>
                        <button type="button" {{action "quick_assessment" supervisee}}>
                          <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="5" y="3" width="14" height="18" rx="2" stroke="#46505F"/><path d="M9 3v2h6V3" stroke="#46505F"/><path d="M9 12l2 2 4-4" stroke="#2A9D8F"/>
                          </svg>
                          <span>{{t "Quick Assessment" key="quick_assessment"}}</span>
                        </button>
                      </li>
                      <li>
                        <button type="button" {{action "run_eval" supervisee}}>
                          <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="8" r="6" stroke="#2A9D8F"/><path d="M15.5 13l1.5 8-5-3-5 3 1.5-8" stroke="#46505F"/>
                          </svg>
                          <span>{{t "Run Evaluation" key="run_evaluation"}}</span>
                        </button>
                      </li>
                      {{#if this.appState.feature_flags.quick_screen_eval}}
                        <li>
                          <LinkTo @route="eval.quick" @model={{supervisee.user_name}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <circle cx="12" cy="14" r="8" stroke="#46505F"/>
                              <path d="M12 10v4l2 2" stroke="#2A9D8F"/>
                              <path d="M9 2h6" stroke="#46505F"/>
                              <path d="M19 5l1-1" stroke="#46505F"/>
                            </svg>
                            <span>{{t "Quick Screen Eval (5 min)" key="quick_screen_eval_link"}}</span>
                          </LinkTo>
                        </li>
                        <li>
                          <LinkTo @route="user.logs" @model={{supervisee.user_name}} @query={{hash type="eval"}}>
                            <svg class="md-caseload__dropdown-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M3 12a9 9 0 1 0 3-6.7" stroke="#46505F"/>
                              <polyline points="3 3.5 3 9 8.5 9" stroke="#46505F"/>
                              <path d="M12 8v4l3 2" stroke="#2A9D8F"/>
                            </svg>
                            <span>{{t "Eval History" key="eval_history_link"}}</span>
                          </LinkTo>
                        </li>
                      {{/if}}
                    </ul>
                  </div>
                </div>

                {{#if supervisee.current_badge}}
                  {{#if supervisee.premium}}
                    <div class="md-caseload__badge-progress">
                      {{badge-progress badge=supervisee.current_badge}}
                    </div>
                  {{/if}}
                {{/if}}
              </div>
            {{/let}}
          </div>
          {{/if}}
          {{else}}
            {{!-- No matches for the active filter — empty state mirrors
                 the "no communicators yet" layout but with copy and an
                 action that point to clearing the filter. --}}
            <div class="md-caseload__empty md-caseload__empty--no-matches">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" stroke="#7693B9"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="#7693B9"/><line x1="8" y1="11" x2="14" y2="11" stroke="#2A9D8F"/>
              </svg>
              <p class="md-caseload__empty-title">{{t "No matches" key="no_matches"}}</p>
              <p class="md-caseload__empty-desc">{{t "No communicators match \"%{q}\"." key="no_supervisees_match_query" q=this.superviseeFilter}}</p>
              <button type="button" class="md-modal-btn md-modal-btn--cancel" {{action "clearSuperviseeFilter"}}>{{t "Clear filter" key="clear_filter"}}</button>
            </div>
          {{/if}}
        {{else}}
          <div class="md-caseload__empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="#7693B9"/><circle cx="9" cy="7" r="4" stroke="#2A9D8F"/><path d="M23 21v-2a4 4 0 0 0-3-3.87" stroke="#7693B9"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="#2A9D8F"/>
            </svg>
            <p class="md-caseload__empty-title">{{t "No communicators yet" key="no_communicators_yet"}}</p>
            <p class="md-caseload__empty-desc">{{t "You have not been added as a supervisor for any communicators. For privacy reasons, supervisors must be added from the communicator's account." key="no_supervisors_explainer"}}</p>
          </div>
        {{/if}}
      </div>
    </article>
  </div>
</div>
</div>
