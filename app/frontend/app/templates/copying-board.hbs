{{#modal-dialog action=(action "close") opening=(action "opening") closing=(action "closing")}}
  {{!-- Header carries a centered "Copy All Boards" shortcut whenever
       the user is looking at the hierarchy (or the load-failed
       recovery state) so large boards don't require scrolling past a
       long checklist to find the body button. Same `copy_all` action,
       same gating as the body — hidden while loading / errored
       without recovery / copy in progress. Absolute positioning keeps
       the button exactly centered regardless of title or close
       widths. --}}
  <div class="modal-header md-copying-board-header">
    <h3 class="md-copying-board-header__title">
      {{t "Copy Board" key="copy_board"}}
    </h3>
    {{#if (or this.hierarchy this.hierarchyLoadFailed)}}
      <button type="button" class="btn btn-primary md-copying-board-header__copy-all" {{action "copy_all"}}>
        {{t "Copy All Boards" key="copy_all_boards"}}
      </button>
    {{/if}}
    <button type="button" class="close md-copying-board-header__close" {{action "close"}}>&times;</button>
  </div>
  <div class="modal-body">
    {{#if this.error}}
      <p class="text-danger">{{this.error}}</p>
      {{#if this.hierarchyLoadFailed}}
        <p>{{t "The linked board list could not be loaded. You can close and try again, or copy all linked boards now to preserve the full board set." key="copy_hierarchy_load_failed_help"}}</p>
        <button class='btn btn-primary' {{action "copy_all"}}>{{t "Copy All Boards" key="copy_all_boards"}}</button>
      {{/if}}
    {{else if this.loading}}
      {{!-- Spinner matches the in-progress copy state below for visual
           consistency, so the user sees a clear "working" indicator
           while the linked-board hierarchy loads, not just bare text. --}}
      <p><img src={{path "images/spinner.gif"}} style="float: left; padding-right: 15px;"> {{t "Loading linked boards..." key="loading_linked_boards"}}</p>
    {{else if this.hierarchy}}
      <p>{{t "Please choose the boards you would like copied. By default all are copied." key="choose_boards_to_copy"}}</p>
      {{#if this.hierarchyRootOnlyWarning}}
        <p class="text-warning">{{t "The saved linked board list could not be loaded, so this list was rebuilt from the board's folder links. All discovered linked boards are selected for copying." key="copy_hierarchy_live_links_warning"}}</p>
      {{/if}}
      {{board-hierarchy selectable=true hierarchy=this.hierarchy}}
      {{#if this.hierarchyRootOnlyWarning}}
        <button class='btn btn-primary' {{action "start_copying"}} disabled={{this.hierarchy.root_deselected}}>{{t "Copy Selected Boards" key="copy_selected_boards"}}</button>
        <button class='btn btn-default' {{action "copy_all"}}>{{t "Copy All Boards" key="copy_all_boards"}}</button>
      {{else}}
        <button class='btn btn-primary' {{action "start_copying"}} disabled={{this.hierarchy.root_deselected}}>{{t "Copy Selected Boards" key="copy_selected_boards"}}</button>
      {{/if}}
    {{else}}
      <p><img src={{path "images/spinner.gif"}} style="float: left; padding-right: 15px;"> {{t "Copying the board <strong>%{board_key}</strong>,<br> this could take a few minutes..." key="copying_the_board" board_key=this.model.board.key}} </p>
      <p>{{t "You can close this window and the copy will continue in the background." key="copy_continues_if_closed"}}</p>
    {{/if}}
  </div>
  <div class="modal-footer">
    <a href="#" class="btn" {{action "close"}}>{{t "Close" key="close"}}</a>
  </div>
{{/modal-dialog}}
