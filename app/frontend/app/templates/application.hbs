        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span>{{t "Beta feedback" key="beta_feedback_nav"}}</span>
        <svg class="beta-feedback-drawer-tab__caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    {{/if}}
    <div id="beta-feedback-top-drawer" class="beta-feedback-drawer {{if (or this.app_state.speak_mode this.app_state.edit_mode this.on_board_detail) "beta-feedback-drawer--speak"}} {{if this.betaFeedbackDrawerOpen "beta-feedback-drawer--open" "beta-feedback-drawer--hidden"}}" role="region" aria-label={{t "Beta feedback" key="beta_feedback_nav"}} aria-hidden={{if this.betaFeedbackDrawerOpen "false" "true"}} inert={{unless this.betaFeedbackDrawerOpen true}}>
      <aside class="beta-feedback-drawer__panel">
        <BetaFeedbackPanel @isDrawer={{true}} @onSubmitSuccess={{this.onCloseBetaFeedbackDrawer}} @onCancel={{this.onCloseBetaFeedbackDrawer}} @onClose={{this.onCloseBetaFeedbackDrawer}} />
      </aside>
    </div>
  {{/if}}
  {{/unless}}{{!-- TEMPORARY (2026-07-27) — remove with the {{#unless}} above --}}
{{/if}}
<div id="content" class="{{this.content_class}} {{if this.hide_header "content--no-top-padding"}}">
  {{!-- Supervising context pill. It lives INSIDE #content on purpose: #content is
       the app's scroll container (#within_ember is fixed/overflow:hidden on the
       page-footer layout), so a pill rendered outside it would hover over the
       page as you scroll. Its own wrapper is zero-height and the pill is
       absolutely positioned, so it adds nothing to this flex column. Self-
       suppressing — renders nothing on your own pages or with the flag off. --}}
  <SupervisingContextPill />
  {{ outlet }}
</div>
{{#if this.app_state.eval_paused}}
  {{!-- In-place eval pause overlay: covers the board below the header and eats
       all pointer input (no button activations while paused). Resume here or via
       the header Pause button. --}}
  <div id="eval_pause_overlay" class="eval-pause-overlay" role="dialog" aria-live="assertive" aria-label={{t "Evaluation paused" key="eval_paused"}}>
    <div class="eval-pause-overlay__card">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="46" height="46" aria-hidden="true" class="eval-pause-overlay__icon">
        <rect x="6" y="5" width="4" height="14" rx="1"/>
        <rect x="14" y="5" width="4" height="14" rx="1"/>
      </svg>
      <h2 class="eval-pause-overlay__title">{{t "Evaluation paused" key="eval_paused"}}</h2>
      <p class="eval-pause-overlay__desc">{{t "The evaluation is paused. Tap Resume to continue." key="eval_paused_desc"}}</p>
      {{#if this.app_state.eval_paused_elapsed}}
        <p class="eval-pause-overlay__elapsed">{{t "Time elapsed" key="eval_time_elapsed"}}: <strong>{{this.app_state.eval_paused_elapsed}}</strong></p>
      {{/if}}
      <button class="btn btn-primary eval-pause-overlay__resume" {{on "click" (this.ctrlAction "toggleEvalPause")}}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true" style="pointer-events: none; vertical-align: middle; margin-right: 6px;">
          <path d="M8 5v14l11-7z"/>
        </svg>
        {{t "Resume" key="resume"}}
      </button>
    </div>
  </div>
{{/if}}
