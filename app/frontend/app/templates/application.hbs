              <div class="ll-bento-theme-picker__options">
                <button type="button" class="ll-bento-theme-picker__option {{if (is-equal this.app_state.themeMode "light") "ll-bento-theme-picker__option--active"}}" {{on "click" (this.ctrlAction "selectThemeMode" "light")}} title={{t "Light" key="light"}} aria-pressed={{is-equal this.app_state.themeMode "light"}}>
                  <span class="ll-bento-theme-picker__icon" aria-hidden="true"><svg class="ll-bento-theme-picker__light-teal-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36"><defs><linearGradient id="ll-light-teal-grad-picker" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#64b9bc"/><stop offset="100%" stop-color="#82afdc"/></linearGradient></defs><path fill="url(#ll-light-teal-grad-picker)" fill-rule="evenodd" d="M12 4.5L19.5 12 12 19.5 4.5 12 12 4.5z" clip-rule="evenodd"/></svg></span>
                </button>
                <button type="button" class="ll-bento-theme-picker__option {{if (is-equal this.app_state.themeMode "midDay") "ll-bento-theme-picker__option--active"}}" {{on "click" (this.ctrlAction "selectThemeMode" "midDay")}} title={{t "Midday" key="midday"}} aria-pressed={{is-equal this.app_state.themeMode "midDay"}}>
                  <span class="ll-bento-theme-picker__icon" aria-hidden="true"><svg class="ll-bento-theme-picker__midday-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36"><defs><radialGradient id="ll-eclipse-sun-picker" cx="35%" cy="35%" r="65%"><stop offset="0%" stop-color="#ffe082"/><stop offset="25%" stop-color="#ffc107"/><stop offset="50%" stop-color="#ff8f00"/><stop offset="75%" stop-color="#e65100"/><stop offset="100%" stop-color="#bf360c"/></radialGradient><radialGradient id="ll-eclipse-moon-picker" cx="35%" cy="35%" r="65%"><stop offset="0%" stop-color="#d4dce8"/><stop offset="50%" stop-color="#a8b4c8"/><stop offset="100%" stop-color="#64748b"/></radialGradient></defs><path fill="url(#ll-eclipse-sun-picker)" fill-rule="evenodd" d="M20 12L15.7 10.5 17.66 6.34 13.5 8.3 12 4 10.5 8.3 6.34 6.34 8.3 10.5 4 12 8.3 13.5 6.34 17.66 10.5 15.7 12 20 13.5 15.7 17.66 17.66 15.7 13.5 20 12z" clip-rule="evenodd"/><circle cx="15" cy="12" r="5.5" fill="url(#ll-eclipse-moon-picker)"/></svg></span>
                </button>
                <button type="button" class="ll-bento-theme-picker__option {{if (is-equal this.app_state.themeMode "dark") "ll-bento-theme-picker__option--active"}}" {{on "click" (this.ctrlAction "selectThemeMode" "dark")}} title={{t "Dark" key="dark"}} aria-pressed={{is-equal this.app_state.themeMode "dark"}}>
                  <span class="ll-bento-theme-picker__icon" aria-hidden="true"><svg class="ll-bento-dark-toggle__moon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24"><defs><radialGradient id="ll-moon-grad-picker" cx="35%" cy="35%" r="65%"><stop offset="0%" stop-color="#d4dce8"/><stop offset="50%" stop-color="#a8b4c8"/><stop offset="100%" stop-color="#64748b"/></radialGradient></defs><path fill="url(#ll-moon-grad-picker)" fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" clip-rule="evenodd"/></svg></span>
                </button>
                <button type="button" class="ll-bento-theme-picker__option {{if (is-equal this.app_state.themeMode "default") "ll-bento-theme-picker__option--active"}}" {{on "click" (this.ctrlAction "selectThemeMode" "default")}} title={{t "Default" key="default_theme"}} aria-pressed={{is-equal this.app_state.themeMode "default"}}>
                  <span class="ll-bento-theme-picker__icon" aria-hidden="true"><svg class="ll-bento-theme-picker__gold-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36"><defs><linearGradient id="ll-gold-grad-picker" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#4ECDC4"/><stop offset="50%" stop-color="#F0F0F0"/><stop offset="100%" stop-color="#FF6B47"/></linearGradient></defs><path fill="url(#ll-gold-grad-picker)" fill-rule="evenodd" d="M12 4.5L19.5 12 12 19.5 4.5 12 12 4.5z" clip-rule="evenodd"/></svg></span>
                </button>
              </div>
              </div>
            </div>
          {{/if}}
          <button type="button" class="ll-bento-dark-toggle ll-bento-dark-toggle--header" {{on "click" (this.ctrlAction "toggleThemePicker")}} aria-label={{t "Toggle theme" key="toggle_theme"}} title={{t "Toggle theme" key="toggle_theme"}} aria-expanded={{this.showThemePicker}} aria-haspopup="dialog">
            <span class="ll-bento-dark-toggle__icon" aria-hidden="true">{{#if this.app_state.darkMode}}<svg class="ll-bento-dark-toggle__moon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36"><defs><radialGradient id="ll-moon-grad" cx="35%" cy="35%" r="65%"><stop offset="0%" stop-color="#d4dce8"/><stop offset="50%" stop-color="#a8b4c8"/><stop offset="100%" stop-color="#64748b"/></radialGradient></defs><path fill="url(#ll-moon-grad)" fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" clip-rule="evenodd"/></svg>{{else if this.app_state.midDayMode}}<svg class="ll-bento-dark-toggle__midday-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36"><defs><radialGradient id="ll-eclipse-sun" cx="35%" cy="35%" r="65%"><stop offset="0%" stop-color="#ffe082"/><stop offset="25%" stop-color="#ffc107"/><stop offset="50%" stop-color="#ff8f00"/><stop offset="75%" stop-color="#e65100"/><stop offset="100%" stop-color="#bf360c"/></radialGradient><radialGradient id="ll-eclipse-moon" cx="35%" cy="35%" r="65%"><stop offset="0%" stop-color="#d4dce8"/><stop offset="50%" stop-color="#a8b4c8"/><stop offset="100%" stop-color="#64748b"/></radialGradient></defs><path fill="url(#ll-eclipse-sun)" fill-rule="evenodd" d="M20 12L15.7 10.5 17.66 6.34 13.5 8.3 12 4 10.5 8.3 6.34 6.34 8.3 10.5 4 12 8.3 13.5 6.34 17.66 10.5 15.7 12 20 13.5 15.7 17.66 17.66 15.7 13.5 20 12z" clip-rule="evenodd"/><circle cx="15" cy="12" r="5.5" fill="url(#ll-eclipse-moon)"/></svg>{{else if this.app_state.defaultMode}}<svg class="ll-bento-theme-picker__default-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36"><defs><linearGradient id="ll-default-grad-header" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#4ECDC4"/><stop offset="50%" stop-color="#F0F0F0"/><stop offset="100%" stop-color="#FF6B47"/></linearGradient></defs><path fill="url(#ll-default-grad-header)" fill-rule="evenodd" d="M12 4.5L19.5 12 12 19.5 4.5 12 12 4.5z" clip-rule="evenodd"/></svg>{{else if this.app_state.coolBlueMode}}<svg class="ll-bento-dark-toggle__cool-blue-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36"><defs><linearGradient id="ll-cool-blue-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#2C3E63"/><stop offset="50%" stop-color="#4A5D73"/><stop offset="100%" stop-color="#7E93A8"/></linearGradient></defs><path fill="url(#ll-cool-blue-grad)" fill-rule="evenodd" d="M12 4.5L19.5 12 12 19.5 4.5 12 12 4.5z" clip-rule="evenodd"/></svg>{{else if this.app_state.defaultMode}}<svg class="ll-bento-theme-picker__gold-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36"><defs><linearGradient id="ll-gold-grad-header" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#4ECDC4"/><stop offset="50%" stop-color="#F0F0F0"/><stop offset="100%" stop-color="#FF6B47"/></linearGradient></defs><path fill="url(#ll-gold-grad-header)" fill-rule="evenodd" d="M12 4.5L19.5 12 12 19.5 4.5 12 12 4.5z" clip-rule="evenodd"/></svg>{{else}}<svg class="ll-bento-dark-toggle__light-teal-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36"><defs><linearGradient id="ll-light-teal-grad" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#64b9bc"/><stop offset="100%" stop-color="#82afdc"/></linearGradient></defs><path fill="url(#ll-light-teal-grad)" fill-rule="evenodd" d="M12 4.5L19.5 12 12 19.5 4.5 12 12 4.5z" clip-rule="evenodd"/></svg>{{/if}}</span>
          </button>
        </span>
      {{/if}}
      {{#unless (is-equal this.app_state.current_route "landing")}}
      {{!-- Settings shortcut — hidden on board-alt and board-detail pages (those have their own settings access) --}}
      {{#if this.app_state.currentUser.user_name}}
        {{#unless (or this.on_board_alt this.on_board_detail)}}
          <LinkTo @route="user.preferences" @model={{this.app_state.currentUser.user_name}} class="ll-header-settings-btn" aria-label={{t "Settings" key="settings"}} title={{t "Settings" key="settings"}}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
          </LinkTo>
        {{/unless}}
      {{/if}}
      <span style="display: inline-block;" class={{if this.app_state.super_no_linky "dropdown hidden" "dropdown"}}>
        <a class={{if (persistence-online) "btn btn-default online" "btn btn-default offline"}} id='identity_button' href="#" data-toggle="dropdown">
          {{#if this.app_state.speak_mode}}
            {{#if this.stashes.logging_enabled}}
              {{#unless this.stashes.logging_paused_at}}
                <span class='logging_enabled glyphicon glyphicon-briefcase'></span>
              {{/unless}}
            {{else if this.app_state.eval_mode}}
              <span class='logging_enabled glyphicon glyphicon-briefcase'></span>
            {{/if}}
          {{/if}}
          {{#if this.app_state.currentUser}}
            {{!-- Default-avatar swap is now driven entirely by the
                 `.user_holder--default` class (set when
                 currentUser.avatar_url_is_default is true). The
                 silhouette is painted as a `background-image` data
                 URI on `.user_holder--default` (see app.scss), and
                 the `<img>` is hidden via the
                 `.user_holder--default img.user` rule. The inline
                 `<svg>` previously rendered here was stripped: in
                 production builds the asset fingerprinter mangled
                 its `url(#gradient-id)` fragment references, so
                 every shape that used a gradient fill painted
                 transparent and only the one solid-color circle
                 survived (the small lavender dot inside an empty
                 ring). The data-URI background-image encodes `#`
                 as `%23` and is never seen by the rewriter. --}}
            <span class='user_holder {{if this.app_state.currentUser.avatar_url_is_default 'user_holder--default'}}'>
              <img src={{this.app_state.currentUser.avatar_url_with_fallback}} class='user' onerror='button_broken_image(this);' >
            </span>
            {{#if this.app_state.modeling_for_user}}
              {{#unless this.app_state.modeling_for_self}}
                <img src={{this.app_state.referenced_speak_mode_user.avatar_url_with_fallback}} class='modeling_user' onerror='button_broken_image(this);' >
              {{/unless}}
            {{/if}}
            {{#if this.session.invalid_token}}
              <span class="label label-danger unread">{{t "!" key="exclaim"}}</span>
            {{else if this.stashes.logging_paused_at }}
              <span class="label label-primary unread" style='padding: 3px;'><span class='glyphicon glyphicon-pause'></span></span>
            {{else if (persistence-value 'syncing')}}
              <span class='spinning unread'>
                <span class="glyphicon glyphicon-refresh" style='z-index: 2;'></span>
                <span class="glyphicon glyphicon-refresh" style='color: #fff; position: absolute; left: 2px; top: 2px;'></span>
              </span>
            {{else if (persistence-value 'app_needs_update')}}
              <span class="label label-danger unread">{{t "!" key="exclaim"}}</span>
            {{else if this.app_state.currentUser.unread_messages}}
              {{#unless this.app_state.speak_mode}}
                <span class="label label-danger unread">{{this.app_state.currentUser.unread_messages}}</span>
              {{/unless}}
            {{else}}
              <span class='status unread'></span>
            {{/if}}
          {{/if}}
          {{#unless this.app_state.currentUser}}
            {{t "Sign In" key="login"}}
          {{/unless}}
          <span class="caret"></span>
        </a>
        <ul class="dropdown-menu" role="menu" aria-labelledby="dLabel" style="right: 0; left: auto; text-align: left;">
          {{#if this.app_state.speak_mode}}
            {{#if this.app_state.currentBoardState.id}}
              {{#if this.simple_board_header}}
                {{#if this.app_state.currentUser}}
                  {{#if this.app_state.currentUser.permissions.delete}}
                    <li role="presentation" class='big' id='exit_speak_mode'>
                      <a href="#" {{on "click" (this.ctrlAction "setAsHome" "starting")}}>
                        {{#if this.app_state.root_board_is_home}}
                          {{t "Set as Home Board" key="set_as_home_board"}}
                        {{else}}
                          {{t "Make This my Home Board" key="make_home_board"}}
                        {{/if}}
                      </a>
                    </li>
                    <li class="divider"></li>
                  {{/if}}
                {{/if}}
              {{/if}}
            {{/if}}
            {{#if this.app_state.eval_mode}}
              <li role="presentation" class='big' id='exit_speak_mode'>
                <a href="#" {{on "click" (this.ctrlAction "end_evaluation")}}>
                  <span class='glyphicon glyphicon-ok'></span> {{t "End Evaluation" key="end_evaluation"}}
                </a>
              </li>
              <li class="divider"></li>
            {{else}}
              <li role="presentation" class='big' id='exit_speak_mode'>
                {{#if this.can_edit_from_speak_mode}}
                  <a href="#" {{on "click" (this.ctrlAction "toggleSpeakMode")}} style='display: inline-block; width: calc(100% - 40px); overflow: hidden; padding-bottom: 10px; margin-bottom: -10px;'>
                    {{t "Exit Speak Mode" key="exit_speak_mode"}}
                    <div style='color: #888; font-size: 14px; margin: -5px 0;'>{{t "Settings, Menu, etc." key="settings_etc"}}</div>
                  </a><a href='#' {{on "click" (this.ctrlAction "toggleEditMode")}} style='display: inline-block; width: 40px; overflow: hidden; height: 55px; margin-bottom: -10px; padding-left: 0; padding-right: 0; text-align: center;'>
                    <span class='glyphicon glyphicon-pencil'></span>
                  </a>
                {{else}}
                  <a href="#" {{on "click" (this.ctrlAction "toggleSpeakMode")}} style='display: inline-block; width: 100%; overflow: hidden; padding-bottom: 10px; margin-bottom: -10px;'>
                    {{t "Exit Speak Mode" key="exit_speak_mode"}}
                    <div style='color: #888; font-size: 14px; margin: -5px 0;'>{{t "Settings, Menu, etc." key="settings_etc"}}</div>
                  </a>
                {{/if}}
              </li>
              {{#unless this.stashes.temporary_root_board_state}}
                {{#if this.stashes.root_board_state.meta_home}}
                  <li><a href="#" {{on "click" (this.ctrlAction "meta_home")}}>{{t "Return to Home List" key="return_to_home_list"}}</a></li>
                {{/if}}
              {{/unless}}

              {{#if this.app_state.embedded}}
                <li class="divider"></li>
                <li role="presentation">
                  <a href="#" {{on "click" (this.ctrlAction "printBoard")}}>{{t "Print this Board" key="print_this_board_cap"}}</a>
                </li>
                <li role="presentation">
                  <a href="#" {{on "click" (this.ctrlAction "launch_board")}}>{{t "Open in %app_name%" key="open_in_app"}}</a>
                </li>
                {{#if this.app_state.full_screen_capable}}
                  <li role="presentation">
                    <a href="#" {{on "click" (this.ctrlAction "full_screen")}}>{{t "Full Screen" key="full_screen"}}</a>
                  </li>
                {{/if}}
                <li role="presentation">
                  <a href="#" {{on "click" (this.ctrlAction "about_modal")}}>{{t "About %app_name%" key="about_app"}}</a>
                </li>
                <li><a href="#" {{on "click" (this.ctrlAction "find_button")}}>{{t "Find a Button" key="find_a_button"}}</a></li>
              {{/if}}
              {{#unless this.app_state.superProtectedSpeakMode}}
                {{#if this.isSessionAuthenticated}}
                  <li class="divider"></li>
                {{/if}}
              {{/unless}}
            {{/if}}
          {{/if}}
          {{#if this.session.invalid_token}}
            {{#if this.isSessionAuthenticated}}
              <li role="presentation">
                <a href="#" {{on "click" (this.ctrlAction "invalidateSession")}}>
                  <span class='label label-danger'>{{t "!" key="exclaim"}}</span>
                  {{t "Please Re-Login" key="please_relogin"}}
                </a>
              </li>
            {{/if}}
          {{else if (persistence-value 'app_needs_update')}}
            <li role="presentation">
              <a href="#" {{on "click" (this.ctrlAction "confirm_update")}}>
                <span class='label label-danger'>{{t "!" key="exclaim"}}</span>
                {{t "Update Available" key="update_available"}}
              </a>
            </li>
          {{/if}}
          {{#if this.app_state.speak_mode}}
            {{#if this.app_state.sidebar_relegated}}
              <li><a href="#" {{on "click" (this.ctrlAction "toggleSidebar")}}>{{t "Show Sidebar" key="show_sidebar"}}</a></li>
            {{/if}}
          {{/if}}
          {{#unless this.app_state.limited_speak_mode_options}}
            {{#if this.isSessionAuthenticated}}
              <li class="dropdown-header">{{this.app_state.currentUser.display_name}}</li>
              {{#unless this.app_state.index_or_landing_view}}
                <li role="presentation">
                  <LinkTo @route="index">{{t "Home" key="home_nav"}}</LinkTo>
                </li>
              {{/unless}}
              {{#if this.app_state.currentUser.permissions.delete}}
                <li role="presentation">
                  <LinkTo @route="user" @model={{this.app_state.currentUser.user_name}}>{{t "My Account" key="my_account"}}</LinkTo>
                </li>
              {{/if}}
              {{#if (persistence-value 'syncing')}}
                <li role="presentation" style='display: none;'>
                  <a href="#" {{on "click" (this.ctrlAction "cancel_sync")}}>{{t "Cancel Sync" key="cancel_sync"}}</a>
                </li>
              {{/if}}
            {{else}}
              {{#unless this.app_state.index_or_landing_view}}
                <li role="presentation">
                  <LinkTo @route="index">{{t "Home" key="home_nav"}}</LinkTo>
                </li>
              {{/unless}}
            {{/if}}
          {{/unless}}
          {{#unless this.app_state.superProtectedSpeakMode}}
            {{#if this.app_state.speak_mode}}
              {{#if this.app_state.feature_flags.enable_all_buttons}}
                {{#unless this.app_state.currentUser.preferences.prevent_hide_buttons}}
                  {{#unless this.app_state.eval_mode}}
                    {{#if this.no_hidden_buttons}}
                      <li><a href="#" {{on "click" (this.ctrlAction "toggle_all_buttons")}} style={{this.no_hidden_buttons_link_style}}>
                        <span class="glyphicon glyphicon-apple"></span>
                        {{t "No Hidden Buttons" key="no_hidden_buttons"}}
                      </a></li>
                    {{else}}
                      <li><a href="#" {{on "click" (this.ctrlAction "toggle_all_buttons")}}>
                        <span class="glyphicon glyphicon-apple"></span>
                        {{#if this.stashes.all_buttons_enabled}}
                          {{t "Hide Hidden Buttons" key="hide_disabled_buttons"}}
                        {{else}}
                          {{t "Show Hidden Buttons" key="show_all_buttons"}}
                        {{/if}}
                      </a></li>
                    {{/if}}
                  {{/unless}}
                {{/unless}}
                {{#if this.app_state.feature_flags.focus_word_highlighting}}
                  {{#unless this.app_state.eval_mode}}
                    <li><a href="#" {{on "click" (this.ctrlAction "toggle_focus")}}>
                      {{#if this.app_state.focus_words}}
                        {{t "Clear Focus Words" key="clear_focus_words"}}
                      {{else}}
                        {{t "Focus Words" key="focus_words"}}
                      {{/if}}
                    </a></li>
                  {{/unless}}
                {{/if}}
              {{/if}}
            {{/if}}
            {{#unless this.app_state.eval_mode}}
              {{#if this.app_state.sessionUser.supervisees}}
                {{#if this.app_state.speak_mode}}
                  {{#if this.app_state.currentUser.permissions.delete}}
                    <li><a href="#" {{on "click" (this.ctrlAction "switch_communicators")}}>{{t "Switch Communicators" key="switch_communicators"}}</a></li>
                  {{/if}}
                {{/if}}
              {{/if}}
              {{#if this.app_state.currentBoardState}}
                <li><a href="#" {{on "click" (this.ctrlAction "find_button")}}>{{t "Find a Button" key="find_a_button"}}</a></li>
              {{/if}}
            {{/unless}}
            {{#if this.isSessionAuthenticated}}
              {{#if this.app_state.currentBoardState}}
                {{#if this.app_state.speak_mode}}
                  {{#if this.app_state.eval_mode}}
                    <li><a href="#" {{on "click" (this.ctrlAction "repeat_prompt")}}><span class='glyphicon glyphicon-volume-up'></span> {{t "Repeat Prompt" key="repeat_prompt"}}</a></li>
                    <li><a href="#" {{on "click" (this.ctrlAction "change_section" "forward")}}><span class='glyphicon glyphicon-chevron-right'></span> {{t "Next Section" key="next_section"}}</a></li>
                    <li><a href="#" {{on "click" (this.ctrlAction "change_section" "back")}}><span class='glyphicon glyphicon-chevron-left'></span> {{t "Previous Section" key="previous_section"}}</a></li>
                    <li><a href="#" {{on "click" (this.ctrlAction "jump_section")}}><span class='glyphicon glyphicon-th-list'></span> {{t "Jump To..." key="jump_to"}}</a></li>
                    <li><a href="#" {{on "click" (this.ctrlAction "assessment_settings")}}><span class='glyphicon glyphicon-cog'></span> {{t "Eval Settings" key="eval_settings"}}</a></li>
                  {{else}}
                    {{#if this.app_state.currentBoardState.translatable}}
                      <li><a href="#" {{on "click" (this.ctrlAction "switch_languages")}}>{{t "Switch Languages" key="switch_languages"}}</a></li>
                    {{/if}}
                    {{#if this.stashes.sticky_board}}
                      <li><a href="#" {{on "click" (this.ctrlAction "toggle_sticky_board")}}>{{t "Release Board Lock" key="release_board_lock"}}</a></li>
                    {{else}}
                      <li><a href="#" {{on "click" (this.ctrlAction "toggle_sticky_board")}}>{{t "Stay on this Board" key="stay_on_board"}}</a></li>
                    {{/if}}
                    {{#if this.stashes.temporary_root_board_state}}
                      <li><a href="#" {{on "click" (this.ctrlAction "toggle_home_lock")}}>{{t "Release Home Lock" key="release_home_lock"}}</a></li>
                    {{else}}
                      {{#unless this.app_state.current_board_is_speak_mode_home}}
                        <li><a href="#" {{on "click" (this.ctrlAction "toggle_home_lock")}}>{{t "Set As Temporary Home" key="temporary_home"}}</a></li>
                      {{/unless}}
                    {{/if}}
                    {{#if this.app_state.feature_flags.find_multiple_buttons}}
                      {{#if this.has_board_intro}}
                        <li><a href="#" {{on "click" (this.ctrlAction "board_intro")}}>{{t "Board Intro" key="board_intro"}}</a></li>
                      {{/if}}
                    {{/if}}
                    {{#if this.app_state.currentUser.preferences.logging}}
                      {{#if this.app_state.logging_paused}}
                        <li><a href="#" {{on "click" (this.ctrlAction "toggle_pause_logging")}}>
                          <span class="label label-primary" style='padding: 3px;'><span class='glyphicon glyphicon-play'></span></span>
                          {{t "Resume Logging" key="resume_logging"}}
                        </a></li>
                      {{else}}
                        <li><a href="#" {{on "click" (this.ctrlAction "toggle_pause_logging")}}>
                          <span class="" style='padding: 3px;'><span class='glyphicon glyphicon-briefcase'></span></span>
                          {{t "Pause Logging" key="pause_logging"}}
                        </a></li>
                      {{/if}}
                    {{else}}
                      <!-- TODO: option to log temporarily/conclude temp log -->
                    {{/if}}
                  {{/if}}
                {{/if}}
              {{/if}}
            {{/if}}
          {{/unless}}
          {{#unless this.app_state.limited_speak_mode_options}}
            {{#if this.isSessionAuthenticated}}
              {{#unless this.app_state.speak_mode}}
                <li><LinkTo @route="search" @models={{array "any" "_"}}>{{t "Find Board" key="find_board"}}</LinkTo></li>
                {{#if this.app_state.currentUser.permissions.delete}}
                  <li><a href="#" {{on "click" (this.ctrlAction "newBoard")}}>{{t "Create a New Board" key="create_a_new_board"}}</a></li>
                {{/if}}
              {{/unless}}
              {{#if this.app_state.currentUser.permissions.delete}}
                <li><LinkTo @route="user.preferences" @model={{this.app_state.currentUser.user_name}}>{{t "Settings" key="preferences"}}</LinkTo></li>
                <li><LinkTo @route="user.logs" @model={{this.app_state.currentUser.user_name}} @query={{hash type="note"}}>
                  {{#if this.app_state.currentUser.unread_messages}}
                    <span class="label label-danger" style="border-radius: 5px;">{{this.app_state.currentUser.unread_messages}}</span>
                  {{/if}}
                  {{t "Messages" key="messages"}}
                </LinkTo></li>
              {{/if}}
              {{#if this.isMasquerading}}
                <li><a href="#" {{on "click" (this.ctrlAction "stopMasquerading")}}>{{this.masqueradeStopLabel}}</a></li>
              {{/if}}
              {{#unless this.app_state.speak_mode}}
                <li><a href="#" {{on "click" (this.ctrlAction "invalidateSession")}}>{{t "Sign Out" key="logout"}}</a></li>
              {{/unless}}
            {{else}}
              <li role="presentation">
                <LinkTo @route="login">{{t "Sign In" key="login"}}</LinkTo>
              </li>
              {{#unless this.app_state.no_linky}}
                {{#if this.app_state.domain_settings.full_domain}}
                  <li role="presentation">
                    <LinkTo @route="register">{{t "Register" key="register"}}</LinkTo>
                  </li>
                {{/if}}
              {{/unless}}
              {{#if this.app_state.feature_flags.emergency_boards}}              
                <li role="presentation">
                  <LinkTo @route="offline_boards" class="critical_access">{{t "Basic Access" key="critical_access"}}</LinkTo>
                </li>
              {{/if}}
            {{/if}}
          {{/unless}}
        </ul>
      </span>
      {{/unless}}
