              <LinkTo @route="register" class="la-mobile-drawer__cta" {{on "click" this.closeLandingNav}}>{{t "Try Free" key='fsa_try_free'}} →</LinkTo>
            </LaMobileDrawer>
          {{/unless}}
        {{/unless}}
      {{/unless}}
    {{/unless}}
    {{#if this.app_state.edit_mode}}
      {{#if this.dragMode}}
        <button class="btn btn-default drag_button" id="edit_clear_button" style="position: relative; width: 300px;">
          {{t "Clear Button" key="clear_button"}}
        </button>
        <button class="btn btn-default drag_button" id="edit_stash_button" style="position: relative; width: 300px;">
          {{t "Copy Button to Stash" key="copy_button_to_stash"}}
        </button>
      {{else if this.board.preview_levels}}
        <button class="btn btn-default drag_button" {{on "click" (this.ctrlAction "shift_level" "down")}} style="position: relative; width: 50px;">
          <span class='glyphicon glyphicon-chevron-left'></span>
        </button>
        <span style='font-size: 20px; margin: 0 10px; width: 90px; display: inline-block; text-align: center;'>
          {{t "Level" key="level"}} {{this.board.current_level}}
        </span>
        <button class="btn btn-default drag_button" {{on "click" (this.ctrlAction "shift_level" "up")}} style="position: relative; width: 50px;">
          <span class='glyphicon glyphicon-chevron-right'></span>
        </button>
        <button class="btn btn-info" {{on "click" (this.ctrlAction "shift_level" "done")}} style="position: relative; width: 100px;">
          {{t "Done" key="done"}}
        </button>
      {{else}}
        <button class={{this.no_paint_mode_class}} {{on "click" (this.ctrlAction "noPaint")}}><span class='wide'>{{t "&nbsp;&nbsp;Edit&nbsp;&nbsp;" key="edit_padded"}}</span><span class='skinny glyphicon glyphicon-hand-up'></span></button>
        <span class="dropdown" style="display: inline-block;">
          <button class={{this.paint_mode_class}} data-toggle="dropdown">
            <span class="wide">{{t "Paint" key="paint"}}</span><span class="skinny glyphicon glyphicon-tint"></span>
            {{#if this.board.paint_mode}}
              {{this.board.paintColor}}
            {{/if}}
          </button>
          <ul class="dropdown-menu" role="menu" aria-labelledby="dLabel" style={{this.swatch_style}}>
            {{#each this.swatches as |swatch|}}
              <li role="presentation">
                <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "paint" swatch.fill swatch.border swatch.types)}} style="float: left; width: 140px; clear: right; padding-top: 3px; padding-bottom: 3px;">
                  <span class="swatch" style={{swatch.style}}></span>
                  <span style="width: 70px; overflow: hidden; text-overflow: ellipsis; display: inline-block; vertical-align: top;">{{swatch.color}}</span>
                  <span class="text-muted" style="margin-left: 22px; display: block; margin-top: -5px; font-size: 14px; vertical-align: top;">
                    {{swatch.hint}}&nbsp;
                  </span>
                </a>
              </li>
              {{#if swatch.right_edge}}
                <!-- defined in app_state.extra_colored_keys -->
                {{#each swatch.extras as |extra|}}
                  <li role="presentation">
                    <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "paint" extra.fill extra.border extra.types)}} style="float: left; width: 60px; clear: right; padding-left: 10px; padding-right: 10px; padding-top: 3px; padding-bottom: 3px;">
                      <span class="swatch" style={{extra.style}}></span>
                      <span class="text-muted" style="display: block; margin-top: -5px; font-size: 14px; vertical-align: top; white-space: nowrap; overflow: hidden; width: 40px;">
                        {{extra.label}}&nbsp;
                      </span>
                    </a>
                  </li>
                {{/each}}
                <div style='clear: left;'></div>
              {{/if}}
            {{/each}}
            <li role="presentation">
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "paint" "hide")}} style="float: left; width: 140px; clear: both;"><span class="glyphicon glyphicon-minus-sign"></span> {{t "Hide" key="hide_upper"}}</a>
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "paint" "show")}} style="float: left; width: 140px; clear: right;"><span class="glyphicon glyphicon-ok-sign"></span> {{t "Un-Hide" key="unhide"}}</a>
              <span style="clear: left;"></span>
            </li>
            <!-- TODO: painting text-only or w/ image -->
            <li role="presentation" class="text-muted">
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "paint" "close")}} style="float: left; width: 140px; clear: both;"><span class="glyphicon glyphicon-remove-sign"></span> {{t "De-Link" key="de_link"}}</a>
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "paint" "open")}} style="float: left; width: 140px; clear: right;"><span class="glyphicon glyphicon-plus-sign"></span> {{t "Re-Link" key="re_link"}}</a>
              <span style="clear: left;"></span>
            </li>
            {{#if this.app_state.feature_flags.board_levels}}
              <li role="presentation">
                <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "paint" "level")}}>
                  <span class="glyphicon glyphicon-signal"></span>
                  {{t "Level Modifications" key="level_modifications"}}
                </a>
              </li>
            {{/if}}
          </ul>
        </span>
        <span class="wide_placeholder" style="padding-right: 10px;"></span>
        <button class="btn btn-default wide" {{on "click" (this.ctrlAction "undoEdit")}} disabled={{this.board.noUndo}}><span class="wide">{{t "Undo" key="undo"}}</span><span class="skinny glyphicon glyphicon-backward"></span></button>
        <button class="btn btn-default wide" {{on "click" (this.ctrlAction "redoEdit")}} disabled={{this.board.noRedo}}><span class="wide">{{t "Redo" key="redo"}}</span><span class="skinny glyphicon glyphicon-forward"></span></button>
        <span class="dropdown" style="display: inline-block;">
          <button class="btn btn-default" data-toggle="dropdown"><span class="wide">{{t "Grid +/-" key="grid_plus_minus"}}</span><span class="skinny glyphicon glyphicon-th"></span></button>
          <ul class="dropdown-menu skinny_grid" role="menu" aria-labelledby="dLabel">
            <li role="presentation" id="grid_menuitem">
              <span role="presentation" style="display: block; width: 300px; height: 200px; position: relative;">
                <span role="presentation" style="position: absolute; top: 0px; left: 0; width: 100%; text-align: center;">
                  <span role="menuitem"><span class="glyphicon glyphicon-chevron-up"></span><span class="sr-only">{{t "Top Row "key="top_row"}}</span></span>
                  <a role="menuitem" tabindex="-1" href="#" {{on "click" (this.ctrlAction "modifyGrid" "add" "row" "top")}} class="btn btn-default"><span class="glyphicon glyphicon-plus"></span><span class="sr-only">{{t "Add Top Row" key="add_top_row"}}</span></a>
                  <a role="menuitem" tabindex="-1" href="#" {{on "click" (this.ctrlAction "modifyGrid" "remove" "row" "top")}} class="btn btn-default"><span class="glyphicon glyphicon-minus"></span><span class="sr-only">{{t "Remove Top Row" key="remove_top_row"}}</span></a>
                  <span role="menuitem"><span class="glyphicon glyphicon-chevron-up"></span></span>
                </span>
                <span role="presentation" style="position: absolute; top: 53px; width: 50%; right: 0; text-align: right; line-height: 45px;">
                  <a role="menuitem" tabindex="-1" href="#" {{on "click" (this.ctrlAction "modifyGrid" "add" "column" "right")}} class="btn btn-default"><span class="glyphicon glyphicon-plus"></span><span class="sr-only">{{t "Add Right Column" key="add_right_column"}}</span></a>
                  <span class="glyphicon glyphicon-chevron-right"></span><br>
                  <a role="menuitem" tabindex="-1" href="#" {{on "click" (this.ctrlAction "modifyGrid" "remove" "column" "right")}} class="btn btn-default"><span class="glyphicon glyphicon-minus"></span><span class="sr-only">{{t "Remove Right Column" key="remove_right_column"}}</span></a>
                  <span class="glyphicon glyphicon-chevron-right"></span>
                </span>
                <span role="presentation" style="position: absolute; top: 53px; width: 50%; left: 0; text-align: left; line-height: 45px;">
                  <span class="glyphicon glyphicon-chevron-left"></span>
                  <a role="menuitem" tabindex="-1" href="#" {{on "click" (this.ctrlAction "modifyGrid" "add" "column" "left")}} class="btn btn-default"><span class="glyphicon glyphicon-plus"></span><span class="sr-only">{{t "Add Left Column" key="add_left_column"}}</span></a><br>
                  <span class="glyphicon glyphicon-chevron-left"></span>
                  <a role="menuitem" tabindex="-1" href="#" {{on "click" (this.ctrlAction "modifyGrid" "remove" "column" "left")}} class="btn btn-default"><span class="glyphicon glyphicon-minus"></span><span class="sr-only">{{t "Remove Left Column" key="remove_left_column"}}</span></a>
                </span>
                <span role="presentation" style="position: absolute; top: 160px; left: 0; width: 100%; text-align: center;">
                  <span role="menuitem"><span class="glyphicon glyphicon-chevron-down"></span><span class="sr-only">{{t "Bottom Rowx" key="bottom_row"}}</span></span>
                  <a role="menuitem" tabindex="-1" href="#" {{on "click" (this.ctrlAction "modifyGrid" "add" "row" "bottom")}} class="btn btn-default"><span class="glyphicon glyphicon-plus"></span><span class="sr-only">{{t "Add Bottom Row" key="add_bottom_row"}}</span></a>
                  <a role="menuitem" tabindex="-1" href="#" {{on "click" (this.ctrlAction "modifyGrid" "remove" "row" "bottom")}} class="btn btn-default"><span class="glyphicon glyphicon-minus"></span><span class="sr-only">{{t "Remove Bottom Row" key="remove_bottom_row"}}</span></a>
                  <span role="menuitem"><span class="glyphicon glyphicon-chevron-down"></span></span>
                </span>
              </span>
            </li>
          </ul>
        </span>
        <button class="btn btn-default wide" {{on "click" (this.ctrlAction "suggestions")}}><span class="wide">{{t "Ideas" key="ideas"}}</span><span class="skinny glyphicon glyphicon-tasks"></span></button>
        <span class="dropdown" style="display: inline-block;">
          <button class="btn btn-default" data-toggle="dropdown"><span class="wide">{{t "More" key="more"}}</span><span class="skinny glyphicon glyphicon-wrench"></span> <span class='caret'></span></button>
          <ul class="dropdown-menu skinny_right" role="menu" aria-labelledby="dLabel">
            <li role="presentation" class={{this.undo_class}}>
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "undoEdit")}}>{{t "Undo" key="undo"}}</a>
            </li>
            <li role="presentation" class={{this.redo_class}}>
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "redoEdit")}} disabled="true">{{t "Redo" key="redo"}}</a>
            </li>
            <li role="presentation">
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "editBoardDetails")}}>{{t "Edit Name & Details" key="edit_details"}}</a>
            </li>
            <li role="presentation">
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "openButtonStash")}}>{{t "Button Stash" key="button_stash"}}</a>
            </li>
            {{#if this.board.button_levels}}
              <li role="presentation">
                <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "preview_levels")}}>{{t "Preview Levels" key="preview_levels"}}</a>
              </li>
            {{/if}}
            <li role="presentation" class="really_skinny">
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "saveBoard")}}>{{t "Save Board" key="save_board"}}</a>
            </li>
            <li role="presentation" class="really_skinny">
              <a role="menuitem" href="#" tabindex="-1" {{on "click" (this.ctrlAction "resetBoard")}}>{{t "Cancel Changes" key="cancel_changes"}}</a>
            </li>
          </ul>
        </span>
        <span class="not_really_skinny">
          <button class="btn btn-primary" {{on "click" (this.ctrlAction "saveBoard")}}><span class="wide">{{t "Save" key="save"}}{{#if this.board.model.multiple_locales}}{{#if this.board.model.button_locale}}<div style='height: 5px; margin-top: -5px; font-style: italic;'>( {{this.board.model.button_locale}} )</div>{{/if}}{{/if}}</span><span class="skinny glyphicon glyphicon-floppy-disk"></span></button>
          <button class="btn btn-default" {{on "click" (this.ctrlAction "resetBoard")}}><span class="wide">{{t "Cancel" key="cancel"}}</span><span class="skinny glyphicon glyphicon-remove"></span></button>
        </span>
      {{/if}}
    {{else}}
    {{/if}}
    </span>
  {{/if}}
    {{!-- App-wide Classic/Modern switch, legacy-header copy. `useAppNavbarInHeader`
         is false on user.board-alt.index (controllers/application.js:2326), so the
         modern navbar's <ViewSwitcher /> does not render there — the classic board
         needs its own mount to stay switchable. The component self-hides with no
         user and in speak mode. --}}
    <ViewSwitcher />
    <span id="identity" class="{{if this.app_state.speak_mode "advanced_selection undwellable" "advanced_selection"}} {{if this.showBentoStyleHeader "identity-with-dark-toggle"}} {{unless this.app_state.speak_mode "app-navbar-auth-nav--desktop identity-with-dark-toggle"}}">
      {{#if this.app_state.speak_mode}}
      {{#if this.showBentoStyleHeader}}
        {{#unless this.app_state.eval_mode}}
            {{#if this.app_state.currentUser.user_name}}
            <LinkTo @route="user.home" @model={{this.app_state.currentUser.user_name}} class="ll-bento-help-btn ll-bento-help-btn--nav" aria-label={{t "Home" key="home_nav"}} title={{t "Home" key="home_nav"}}>
              <span class="ll-bento-help-btn__label">{{t "Home" key="home_nav"}}</span>
            </LinkTo>
            {{/if}}
            {{#if this.isMasquerading}}
            <button type="button" class="md-pillnav__stop-masquerade" aria-label={{this.masqueradeStopLabel}} title={{this.masqueradeStopLabel}} {{on "click" (this.ctrlAction "stopMasquerading")}}>
              {{this.masqueradeStopLabel}}
            </button>
            {{/if}}
            {{#unless this.app_state.currentBoardState.id}}
            <button type="button" class="md-pillnav__upgrade-nav" aria-label={{t "Upgrade" key="upgrade"}} title={{t "Upgrade" key="upgrade"}} {{on "click" (this.ctrlAction "goUpgrade")}}>
              {{t "Upgrade" key="upgrade"}}
            </button>
            {{/unless}}
            <button class="md-iconbtn md-iconbtn--identity" type="button" aria-label={{t "Help" key="help"}} title={{t "Help" key="help"}} {{on "click" (this.ctrlAction "support")}}>
              ?
              <span class="md-iconbtn__label">{{t "Help" key="help"}}</span>
            </button>
          {{/unless}}
          <span class="bento-dark-toggle-wrap ll-bento-theme-picker-wrap" style="display: inline-block; position: relative;">
          {{#if this.showThemePicker}}
