{{#if (or this.app_state.currentUser this.app_state.sessionUser)}}
  {{!-- TEMPORARY (2026-07-27): the beta-feedback drawer + its bottom-center tab are
       suppressed on board-detail SPEAK mode only (route user.board-detail.index).
       Every other surface — board-detail EDIT mode, classic board speak/edit, the
       home dashboard, all other authenticated pages — still renders it.
       TO RESTORE: remove this {{#unless}} wrapper (and its {{/unless}} below), and
       delete `hide_beta_feedback_temporarily` from controllers/application.js. --}}
  {{#unless this.hide_beta_feedback_temporarily}}
  {{#if this.showBetaFeedbackDrawer}}
