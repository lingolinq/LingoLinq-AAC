<div id="within_ember" class="{{this.background_class}} {{if this.app_state.index_or_landing_view "index-or-landing-view"}} {{if (is-equal this.app_state.current_route "speech") "speech-route"}} {{if (is-equal this.app_state.current_route "landing-alt") "landing-alt-route"}} {{if (is-equal this.app_state.current_route "pricing") "pricing-route"}} {{if (is-equal this.app_state.current_route "features") "features-route"}} {{if this.showBentoPageWithFooter "bento-page-with-footer"}} {{if (and this.app_state.index_or_landing_view this.app_state.darkMode) "bento-dark-mode-active"}} {{if (and this.app_state.index_or_landing_view this.app_state.midDayMode) "bento-midday-mode-active"}} {{if (and this.app_state.index_or_landing_view this.app_state.defaultMode) "bento-default-mode-active"}} {{if this.on_board_alt "board-alt-view"}} {{if this.on_board "board-view"}} {{if this.on_board_detail "board-detail-view"}} {{if this.app_state.focus_words "focus-words-active"}} {{if this.app_state.edit_mode "edit-mode-active"}} {{if this.app_state.beta_program_access "beta-program-access"}}" style={{if this.speak_mode_needing_hammer_js "touch-action: auto;" }}>
<div id="audio"></div>
<AppLoadingOverlay />
<AppToast />
<CopyProgressDrawer />
<header class="{{this.header_class}} {{if this.useAppNavbarInHeader "header-index-with-dark-toggle"}} {{unless this.isSessionAuthenticated "header--unauthenticated"}} {{if this.hide_header "header--hidden"}}">
  <div id="inner_header">
  {{#if this.useAppNavbarInHeader}}
    <AppNavbar @onSupport={{this.support}} />
  {{else}}
  {{#if (and this.app_state.speak_mode this.app_state.currentBoardState.id)}}
    <span id="speak" class="{{if this.app_state.eval_mode "md-eval-header"}}">
      <span class="speak-header__home-col">
      <span class="speak-header__home-marker">
        <TripleClickListener @triple_click="meta_home_click">
          {{#if this.app_state.eval_mode}}
            {{!-- Eval-mode home button — uses the same modern outline-house
                 icon as the board-detail sentence bar (mirrors that visual
                 language). Action goes home rather than opening the board
                 picker since the picker would exit eval anyway. --}}
            <button class="btn btn-default access" id="home_button" type="button" {{on "click" (this.ctrlAction "home")}} style="position: relative;" aria-label={{t "Home" key="home"}}>
              <span class="sr-only">{{t "Home" key="home"}}</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true" style="pointer-events: none; display: block;">
                <path d="M3 12 12 3l9 9"/>
                <path d="M5 10v10a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1V10"/>
              </svg>
            </button>
          {{else if this.on_board_or_alt}}
            {{!-- My Boards button — used to open the modal-based
                 picker (replaced 2026-05-23). Now invokes
                 `openMyBoards` which stashes the current board so the
                 boards page can offer a "Back to <board>" chip, then
                 transitions to /u/:user_name/boards. Single source of
                 truth: the boards-page route handles the entire UX
                 (folders, tabs, filter, grid) — no parallel modal
                 markup or state machine. --}}
            <button class='btn btn-default access' id="home_button" type="button" {{on "click" (this.ctrlAction "openMyBoards")}} style='position: relative;' aria-label={{t "My Boards" key="my_boards"}}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true" style="pointer-events: none; display: block;">
                <path fill-rule="evenodd" d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z" clip-rule="evenodd"/>
              </svg>
            </button>
          {{else}}
            <button class={{if this.on_home "btn btn-default access dim" "btn btn-default access"}} id="home_button" type="button" {{on "click" (this.ctrlAction "home")}} style='position: relative;'>
              <span class="sr-only">{{t "Home" key="home"}}</span>
              <span class="glyphicon glyphicon-home button_icon"></span>
              {{#unless this.app_state.eval_mode}}
                {{#if this.stashes.temporary_root_board_state}}
                  <span class="glyphicon glyphicon-lock" style="float: left; width: 0; height: 0; color: #aaa; margin-top: 15px; margin-left: -5px;" title={{t "Home or Board Lock Set" key="home_or_board_lock_set"}}></span>
                {{else if this.stashes.sticky_board}}
                  <span class="glyphicon glyphicon-lock" style="float: left; width: 0; height: 0; color: #aaa; margin-top: 15px; margin-left: -5px;" title={{t "Board Lock Set" key="board_lock_set"}}></span>
                {{/if}}
              {{/unless}}
            </button>
          {{/if}}
        </TripleClickListener>
      </span>
        {{#if this.show_eval_pause}}
          {{!-- In-place Pause/Resume for a running eval. Its own control stacked
               under the home pill (see .speak-header__home-col) — kept OUT of
               .speak-header__home-marker so it isn't grouped with the home icon.
               Hidden on board-alt and the welcome intro via show_eval_pause. --}}
          <button class="btn access speak-header__eval-pause" id="eval_pause_button" {{on "click" (this.ctrlAction "toggleEvalPause")}} aria-label={{if this.app_state.eval_paused (t "Resume evaluation" key="resume_eval") (t "Pause evaluation" key="pause_eval")}} title={{if this.app_state.eval_paused (t "Resume evaluation" key="resume_eval") (t "Pause evaluation" key="pause_eval")}}>
            <span class="sr-only">{{if this.app_state.eval_paused (t "Resume" key="resume") (t "Pause" key="pause")}}</span>
            {{#if this.app_state.eval_paused}}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true" style="pointer-events: none; display: block;">
                <path d="M8 5v14l11-7z"/>
              </svg>
            {{else}}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true" style="pointer-events: none; display: block;">
                <rect x="6" y="5" width="4" height="14" rx="1"/>
                <rect x="14" y="5" width="4" height="14" rx="1"/>
              </svg>
            {{/if}}
          </button>
        {{/if}}
      </span>
      {{#if this.show_back}}
        <button class="btn btn-default access skinnier" id="back_button" type="button" {{on "click" (this.ctrlAction "back")}}>
          <span class="sr-only">{{t "Back" key="back"}}</span>
          <span class="glyphicon glyphicon-arrow-left button_icon"></span>
        </button>
      {{/if}}
      {{#if this.app_state.eval_mode}}
        <div class="speak-bar__eval-actions" role="toolbar" aria-label={{t "Evaluation controls" key="eval_speak_toolbar"}}>
          {{#if this.eval_intro_header_show_start}}
            <button type="button" class="btn btn-default access speak-bar__eval-btn speak-bar__eval-btn--compact" id="eval_intro_start" {{on "click" (this.ctrlAction "eval_intro_header_start")}} title={{t "Start" key="start"}} aria-label={{t "Start" key="start"}}>
              {{t "Start" key="start"}}
            </button>
          {{/if}}
          {{#if this.eval_intro_header_show_skip}}
            <button type="button" class="btn btn-default access speak-bar__eval-btn speak-bar__eval-btn--compact" id="eval_intro_skip" {{on "click" (this.ctrlAction "eval_intro_header_skip")}} title={{t "Skip" key="skip"}} aria-label={{t "Skip" key="skip"}}>
              {{t "Skip" key="skip"}}
            </button>
          {{/if}}
          <button type="button" class="btn btn-default access skinnier speak-bar__eval-btn" id="eval_open_settings" {{on "click" (this.ctrlAction "assessment_settings")}} title={{t "Eval Settings" key="eval_settings"}} aria-label={{t "Eval Settings" key="eval_settings"}}>
            <span class="glyphicon glyphicon-cog" aria-hidden="true"></span>
          </button>
          {{#if this.show_eval_prev}}
            <button type="button" class="btn btn-default access skinnier speak-bar__eval-btn" id="eval_prev_section" {{on "click" (this.ctrlAction "change_section" "back")}} title={{t "Previous Section" key="previous_section"}} aria-label={{t "Previous Section" key="previous_section"}}>
              <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span>
            </button>
          {{/if}}
          <button type="button" class="btn btn-default access speak-bar__eval-btn speak-bar__eval-btn--next" id="eval_next_section" {{on "click" (this.ctrlAction "change_section" "forward")}} title={{t "Next Section" key="next_section"}} aria-label={{t "Next Section" key="next_section"}}>
            <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
            <span class="speak-bar__eval-actions__label">{{t "Next" key="next"}}</span>
          </button>
        </div>
      {{/if}}
      <div class="speak-bar__button-list-wrap">
        <a href='#' tabindex="0" id="button_list" class={{this.button_list_class}} {{on "select" (this.ctrlAction "vocalize")}} data-placement="bottom" data-trigger="manual">
          {{#unless this.app_state.button_list}}
            {{#if this.app_state.embedded}}
              <div style='float: left; margin: 5px; opacity: 0.7;'>
                <AppLogo @size="xs" @imgAlt="LingoLinq" />
                {{t "Powered by %app_name%" key="powered_by_app"}}
              </div>
            {{else if this.app_state.currentUser.preferences.blank_status}}
              <div id="blank_status" class='text-muted'>
                {{time this.app_state.current_time}}
                {{#if this.app_state.battery.level}}
                  <div class="progress">
                    <div class={{this.app_state.battery.progress_class}} role="progressbar" aria-valuenow={{this.app_state.battery.level}} aria-valuemin="0" aria-valuemax="100" style={{this.app_state.battery.progress_style}}>
                      {{#if this.app_state.battery.charging}}
                        <span class="glyphicon glyphicon-flash"></span>
                      {{/if}}
                      <span class="sr-only">{{t "%{pct}% battery" key="percent_battery" pct=this.app_state.battery.level}} {{#if this.app_state.battery.charging}}{{t "charging" key="charging"}}{{/if}}</span>
                    </div>
                    {{#if this.app_state.battery.low}}
                      {{#unless this.app_state.battery.charging}}
                        <span class="glyphicon glyphicon-exclamation-sign" style="margin-top: 2px;"></span>
                      {{/unless}}
                    {{/if}}
                  </div>
                {{/if}}
                {{#if this.show_board_intro}}
                  <div role="button" tabindex="0" data-bd-action="board_intro" data-bd-controller="app" {{on "click" (this.ctrlAction "board_intro")}} class='extra-btn' style='position: absolute; top: 3px; bottom: 3px; border: 1px solid #ccc; background: #eee; margin-top: 0; margin-bottom: 0; border-radius: 5px; padding: 5px 10px; max-height: 75px; cursor: pointer;'>
                    <img src={{path "images/learn.png"}} alt="" style='height: 100%; max-height: 50px;'>
                    {{t "Intro" key="intro"}}
                  </div>
                {{else if this.app_state.eye_gaze_state}}
                  <div class="eye_status" title={{this.app_state.eye_gaze_state.status}}>
                    {{#if this.app_state.eye_gaze_state.active}}
                      <span class="glyphicon glyphicon-eye-open"></span>
                    {{else if this.app_state.eye_gaze_state.dormant}}
                      <span class="glyphicon glyphicon-eye-open" style='opacity: 0.4;'></span>
                    {{else}}
                      <span class="glyphicon glyphicon-eye-close text-muted"></span>
                    {{/if}}
                  </div>
                {{/if}}
              </div>
            {{/if}}
          {{/unless}}
          {{#let this.app_state.button_list as |button_list|}}
            <ButtonList @buttonList={{button_list}} />
          {{/let}}
        </a>
        {{#unless this.app_state.eval_mode}}
          {{#unless this.app_state.currentUser.preferences.device.disable_speak_options}}
            <button class="btn btn-default pass_to_btn_list" type="button" {{on "click" (this.ctrlAction "speakOptions")}} id="speak_options">
              {{#if this.app_state.referenced_user.unread_alerts}}
                <span class='label label-danger' style='position: absolute; top: -5px; right: -5px; border-radius: 10px;'>{{this.app_state.referenced_user.unread_alerts}}</span>
              {{else if this.app_state.referenced_user.request_alert}}
                <span class='label label-danger' style='position: absolute; top: -5px; right: -5px; border-radius: 10px;'>*</span>
              {{/if}}
              <span class="sr-only">{{t "speak options" key="speak_options"}}</span><span class="glyphicon glyphicon-chevron-down"></span>
            </button>
          {{/unless}}
        {{/unless}}
        {{#unless this.app_state.eval_mode}}
          {{#if this.app_state.pairing}}
            <button class={{if this.app_state.pairing.user.online "btn over pair access online" "btn over pair access"}} type="button" {{on "click" (this.ctrlAction "remote_modeling")}} id='reply_icon'>
              {{#if this.app_state.pairing.model}}
                <span class='glyphicon glyphicon-road'></span>
              {{else}}
                <span class='glyphicon glyphicon-search'></span>
              {{/if}}
              {{#if this.app_state.pairing.user}}
                <img src={{this.app_state.pairing.user.avatar_url_with_fallback}} >
              {{/if}}
            </button>
          {{else if this.app_state.reply_note}}
            <div class='label label-info over' id='reply_icon'><span class='glyphicon glyphicon-envelope'></span></div>
          {{else if this.app_state.inflection_shift}}
            <div class='label label-info over' id='reply_icon'><span class='glyphicon glyphicon-adjust'></span></div>
          {{else if this.app_state.insertion}}
            <div class='label label-info over' id='reply_icon'><span class='glyphicon glyphicon-console'></span></div>
          {{else if this.app_state.flipped}}
            <div class='label label-info over' id='reply_icon'><span class='glyphicon glyphicon-repeat'></span></div>
          {{else if this.app_state.followers.active}}
            <div class='label label-info over clear' id='reply_icon'>
              {{#each this.app_state.followers.active as |user|}}
                <img src={{user.avatar_url}} class='follower' >
              {{/each}}
            </div>
          {{else if this.app_state.clearable_history}}
            <div class='label label-warning over' id='reply_icon' style='width: 60px; margin-right: -65px; border-radius: 10px;'><span class='glyphicon glyphicon-remove'></span> {{this.app_state.clearable_history}}</div>
          {{else if this.app_state.shift}}
            <div class='label label-info over' id='reply_icon'><span class='glyphicon glyphicon-font'></span></div>
          {{/if}}
        {{/unless}}
      </div>
      {{#unless this.app_state.button_list}}
        {{#if this.app_state.currentUser.preferences.blank_status}}
          {{#unless this.app_state.eval_mode}}
            <!-- TODO: these popups should be dwellable, but if opened via dwell they should auto-close after like ten seconds -->
            <button id='speak_mode_notification' type="button" class='btn btn-default' {{on "click" (this.ctrlAction "speak_mode_notification")}}>
              {{#if this.stashes.board_level}}
                <span style='color: #ddd; font-size: 14px; position: absolute; top: 3px; text-align: right;'>L{{this.stashes.board_level}}</span>
              {{/if}}
              {{#if this.app_state.speak_mode_modeling_ideas.enabled}}
                <span class='notification' style='height: 100%; position: absolute; top: 5px; left: 0; right: 0; bottom: 5px; height: auto;'>
                  <img src={{path "images/modeling_ideas.svg"}} style='height: 100%; width: 100%; opacity: 0.7;' class='fit_image'>
                  {{#if this.app_state.speak_mode_modeling_ideas.word}}
                    <div style='position: absolute; left: 0; top: 3px; width: 100%; text-align: center;'>
                      <span style='border: 3px solid rgba(255, 255, 255, 0.7); border-radius: 3px;'>
                        <span style='background: rgba(255, 255, 255, 0.9);'>"{{this.app_state.speak_mode_modeling_ideas.word}}"</span>
                      </span>
                    </div>
                  {{/if}}
                </span>
              {{else if this.app_state.user_badge}}
                <span class='notification'>
                  {{#if this.app_state.user_badge.earned}}
                    <BadgeEarned @badge={{this.app_state.user_badge}} @inline={{true}} />
                  {{else}}
                    <BadgeProgress @badge={{this.app_state.user_badge}} @inline={{true}} />
                  {{/if}}
                </span>
              {{else if this.app_state.speak_mode_modeling_ideas.timeout}}
                <span class='notification' style='height: 100%; position: absolute; top: 5px; left: 0; right: 0; bottom: 5px; height: auto;'>
                  <img src={{path "images/modeling_ideas.svg"}} style='height: 100%; width: 100%; opacity: 0.3;' class='fit_image'>
                </span>
              {{/if}}
            </button>
          {{/unless}}
        {{/if}}
      {{/unless}}
      <button class="btn btn-default access skinnier" id="backspace_button" type="button" {{on "click" (this.ctrlAction "backspace")}}>
        <span class="sr-only">{{t "backspace" key="backspace_lower"}}</span>
        <img src={{path "images/delete.svg"}}>
      </button>
      <TripleClickListener @triple_click="toggle_modeling">
        <button class="btn btn-default access" id="clear_button" type="button" {{on "click" (this.ctrlAction "clear")}} style='position: relative;'>
          <span class="sr-only">{{t "clear" key="clear_lower"}}</span>
          {{#if this.app_state.eval_mode}}
            {{!-- Modern trash-can icon for the eval clear button —
                 mirrors the trash-can icon on board-detail's sentence
                 bar so the two surfaces share the same Clear glyph. --}}
            <svg class="md-eval-clear-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="3 6 5 6 21 6"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
              <line x1="10" y1="11" x2="10" y2="17"/>
              <line x1="14" y1="11" x2="14" y2="17"/>
            </svg>
          {{else}}
            <span class="glyphicon glyphicon-remove button_icon" style="margin: 5px -5px 0;"></span>
          {{/if}}
          {{#if this.app_state.modeling}}
            <div style="position: absolute; bottom: 2px; left: 2px;">
              <span class="glyphicon glyphicon-hand-up"></span>
            </div>
          {{/if}}
        </button>
      </TripleClickListener>
    </span>
  {{else}}
    <span id="nav_header" class={{this.app_state.nav_header_class}}>
    {{#if this.app_state.currentUser}}
      {{#unless this.app_state.speak_mode}}
        {{#unless this.app_state.edit_mode}}
          {{#unless this.app_state.embedded}}
            {{#unless this.showBentoStyleHeader}}
              {{! Hide Help when on a board in normal mode so Done with Boards is flush left }}
              {{#if this.app_state.currentBoardState.id}}
                {{! On board, not edit: no Help (normal mode bar) }}
              {{/if}}
            {{/unless}}
          {{/unless}}
        {{/unless}}
      {{/unless}}
    {{/if}}
    {{#if this.app_state.currentUser.single_org.image_url}}
      {{#if this.showBentoStyleHeader}}
        {{#unless (is-equal this.app_state.current_route "landing")}}
          <img style="position: absolute; top: 50px; left: 19px; width: 50px; height: 50px; border-radius: 50px; object-fit: contain; object-position: center;" src={{this.app_state.currentUser.single_org.image_url}} {{hide-on-error "display"}}>
        {{/unless}}
      {{/if}}
    {{/if}}
    {{!-- template-lint-disable no-empty-headings --}}
    {{!-- Not empty: the h1's accessible name is the brand logo's img alt ("LingoLinq"). The
         rule only checks for a direct text node and doesn't traverse into the nested
         <a><img alt>, so it false-positives on this valid logo heading. --}}
    <h1 class={{this.app_state.h1_class}} style='position: relative; z-index: 1;'>

      <span class="nav-header__brand">
        <a href="#" {{on "click" (this.ctrlAction "index")}} class="nav-header__logo-link">
          <img src={{if this.app_state.domain_settings.logo_url this.app_state.domain_settings.logo_url (path "images/LL_Logo_Line_Bright.png")}} alt="LingoLinq" class="nav-header__logo-svg">
        </a>
      </span>
    </h1>
    {{!-- template-lint-enable no-empty-headings --}}
    {{#if this.app_state.currentBoardState.id}}
      {{#unless this.app_state.edit_mode}}
        {{! Done with Boards + normal_mode + board_id in flex layout: col1 = Done (2 rows), col2 = normal_mode then board_id }}
        <div class="nav-header__board-bar">
        <button id='board_done' class='btn btn-default' {{on "click" (this.ctrlAction "back_to_from_route")}}>
          {{#if this.on_board_alt}}
            <span class='board-done__exit-icon'></span>
            <span class='board-done__exit-label'>{{t "Exit Boards" key="exit_boards"}}</span>
          {{else}}
            <span style='font-size: 30px; line-height: 14px; vertical-align: bottom; padding-right: 5px;'>&times;</span>
            <span style='font-size: 16px;'>{{t "Done" key="done"}}</span>
            <span style='font-size: 14px; display: block; padding-left: 27px; margin-top: -4px;'>{{t "with boards" key="with_boards"}}</span>
          {{/if}}
        </button>
        <div class="nav-header__board-bar-right">
        <span id="normal_mode">
          {{#unless this.app_state.empty_board_history}}
            <a class="btn btn-default" href="#" {{on "click" (this.ctrlAction "back")}}>
              <span class="glyphicon glyphicon-arrow-left"></span>
              <span class="hidden">{{t "back" key="back_lower"}}</span>
            </a>
          {{/unless}}
          {{#if this.app_state.currentBoardState.id}}
            {{#if this.simple_board_header}}
              <a class="btn btn-default" href="#" {{on "click" (this.ctrlAction "toggleSpeakMode" "goBrowsedHome")}} id="speak_mode" data-placement="bottom" data-trigger="manual">
                <span class="wide">{{t "Try in Speak Mode" key="try_in_speak_mode"}}</span><span class="skinny real_skinny glyphicon glyphicon-volume-up"></span>
              </a>
              {{#if this.app_state.currentUser}}
                {{#if this.app_state.root_board_is_home}}
                  <a class="btn btn-default" href="#" {{on "click" (this.ctrlAction "setAsHome" "starting")}}>
                    <span class="wide"><span class='glyphicon glyphicon-ok'></span> {{t "Set as Home Board" key="set_as_home_board"}}</span><span class="skinny real_skinny glyphicon glyphicon-home"></span>
                  </a>
                {{else}}
                  <a class="btn btn-primary" href="#" {{on "click" (this.ctrlAction "setAsHome" "starting")}}>
                    <span class="wide">{{t "Make This my Home Board" key="make_home_board"}}</span><span class="skinny real_skinny glyphicon glyphicon-home"></span>
                  </a>
                {{/if}}
              {{/if}}
            {{else}}
              {{#if this.app_state.speak_mode_possible}}
                {{#if this.app_state.currentUser.supporter_view}}
                  <div class="btn-group">
                    <a class="btn btn-primary dropdown-toggle" data-toggle="dropdown" href="#" id="speak_mode" data-placement="bottom" data-trigger="manual">
                      <span class="wide">{{t "Speak Mode" key="speak_mode"}}</span><span class="skinny real_skinny glyphicon glyphicon-volume-up"></span>
                      <span class="caret"></span>
                    </a>
                    <ul class="dropdown-menu" role="menu">
                      {{#if this.app_state.currentUser.communicator_in_supporter_view}}
                        <li><a href="#" {{on "click" (this.ctrlAction "setSpeakModeUser" "self" "modeling")}}>{{t "model for me" key="model_for_me"}}</a></li>
                      {{/if}}
                      <li><a href="#" {{on "click" (this.ctrlAction "setSpeakModeUser" "self")}}>{{t "speak as me" key="speak_as_me"}}</a></li>
