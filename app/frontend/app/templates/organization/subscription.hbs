{{!-- BILLING DETAILS: where a site admin credits an organisation with licenses (reached from the
     Billing row of the Basic org side menu). Restyled 2026-10-02 (requested: "style the licensing
     crediting page with our modern styles") from a Bootstrap horizontal form, table and
     list-group onto the org Settings page's primitives, as the Admin Actions page was
     (templates/organization/extras.hbs): `md-org-settings-card` per section, labelled
     `md-org-settings-input` fields, `md-org-btn--primary` to save, `md-org-admin-list` for the
     lists. Every binding, action and condition is unchanged; only markup and classes moved. --}}
{{#if this.model.permissions.manage}}
  <h3 class="md-org-section-title" style="text-align: center; margin-bottom: 24px;">{{t "Billing Details" key="subscription_details"}}</h3>
  <div class="md-org-settings-form">
    {{#if this.model.permissions.manage_subscription}}
      <form {{on "submit" (this.ctrlAction "update_org")}}>
        <section class="md-org-settings-card">
          <h4 class="md-org-settings-card__title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/></svg>
            {{t "Purchased Licenses" key="purchased_licenses"}}
          </h4>
          <div class="md-org-admin-actions__grid md-org-billing-grid">
            <div class="md-org-settings-field">
              <label for="allotted_licenses" class="md-org-settings-field__label">{{t "Purchased Licenses" key="purchased_licenses"}}</label>
              <input value={{this.model.allotted_licenses}} class="md-org-settings-input" id="allotted_licenses" placeholder="0" {{on "input" (set-field this "model.allotted_licenses")}} />
            </div>
            <div class="md-org-settings-field">
              <label for="allotted_supervisor_licenses" class="md-org-settings-field__label">{{t "Premium Supervisors" key="premium_supervisors"}}</label>
              <input value={{this.model.allotted_supervisor_licenses}} class="md-org-settings-input" id="allotted_supervisor_licenses" placeholder="0" {{on "input" (set-field this "model.allotted_supervisor_licenses")}} />
            </div>
            <div class="md-org-settings-field">
              <label for="allotted_eval_licenses" class="md-org-settings-field__label">{{t "Eval Accounts" key="eval_accounts"}}</label>
              <input value={{this.model.allotted_eval_licenses}} class="md-org-settings-input" id="allotted_eval_licenses" placeholder="0" {{on "input" (set-field this "model.allotted_eval_licenses")}} />
            </div>
            <div class="md-org-settings-field">
              <label for="allotted_extras" class="md-org-settings-field__label">{{t "Premium Symbols" key="premium_symbols"}}</label>
              <input value={{this.model.allotted_extras}} class="md-org-settings-input" id="allotted_extras" placeholder="0" {{on "input" (set-field this "model.allotted_extras")}} />
            </div>
          </div>
          <div class="md-org-settings-field">
            <label for="licenses_expire" class="md-org-settings-field__label">{{t "Expires" key="expires"}}</label>
            <input value={{this.model.licenses_expire}} type="date" class="md-org-settings-input md-org-settings-input--sm" id="licenses_expire" placeholder="YYYY-MM-DD" {{on "input" (set-field this "model.licenses_expire")}} />
          </div>
          <div class="md-org-settings-actions">
            <button type="submit" class="md-org-btn md-org-btn--primary">{{t "Update" key="update"}}</button>
          </div>
        </section>
      </form>
    {{else}}
      <section class="md-org-settings-card">
        <h4 class="md-org-settings-card__title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/></svg>
          {{t "Purchased Licenses" key="purchased_licenses"}}
        </h4>
        <p class="md-org-settings-field__static">
          {{#if this.model.allotted_licenses}}
            {{t "license" key="licenses" count=this.model.allotted_licenses}}
            {{t ", expires" key="comma_expires"}} {{date this.model.licenses_expire}}
          {{else}}
            {{t "No licenses allotted, unless attached to subscribers" key="no_licenses_allotted"}}
          {{/if}}
        </p>
        <span class="md-org-settings-field__hint">{{t "Thank you for supporting %app_name%, and the many communicators who use it!" key="thanks_for_supporting_app"}}</span>
      </section>
    {{/if}}

    {{#if this.model.org_subscriptions}}
      <section class="md-org-settings-card">
        <h4 class="md-org-settings-card__title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          {{t "Associated Purchases" key="associated_subscriptions"}}
        </h4>
        <div class="md-org-billing-subs" role="table" aria-label={{t "Associated Purchases" key="associated_subscriptions"}}>
          <div class="md-org-billing-subs__row md-org-billing-subs__row--head" role="row">
            <span role="columnheader">{{t "User" key="user"}}</span>
            <span role="columnheader">{{t "Purchase" key="subscription"}}</span>
            <span role="columnheader">{{t "Expires" key="expires"}}</span>
          </div>
          {{#each this.model.processed_org_subscriptions as |sub|}}
            <div class="md-org-billing-subs__row" role="row">
              <span role="cell">
                <LinkTo @route="user" @model={{sub.user_name}} class="md-org-billing-subs__user">
                  <img src={{sub.avatar_url}} alt="" class="md-org-billing-subs__avatar">
                  {{sub.user_name}}
                </LinkTo>
              </span>
              <span role="cell">{{sub.subscription_object.subscription_plan_description}}</span>
              <span role="cell">
                {{#if sub.subscription.expires}}
                  {{date sub.subscription.expires "day"}}
                {{else}}
                  {{t "No expiration" key="no_expiration"}}
                {{/if}}
              </span>
            </div>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if this.model.purchase_history}}
      <section class="md-org-settings-card">
        <h4 class="md-org-settings-card__title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {{t "Purchase History" key="purchase_history"}}
        </h4>
        <ul class="md-org-admin-list md-org-admin-list--gifts">
          {{#each this.model.processed_purchase_history as |event|}}
            {{#if event.update_license_count}}
              <li class="md-org-admin-list__item">
                {{t "License count was updated to %{num} - " key="license_count_updated" num=event.count}}
                <span class="md-org-admin-gift__meta">{{date_ago event.logged_at}}</span>
              </li>
            {{else if event.update_eval_license_count}}
              <li class="md-org-admin-list__item">
                {{t "Eval account total was updated to %{num} - " key="eval_count_updated" num=event.count}}
                <span class="md-org-admin-gift__meta">{{date_ago event.logged_at}}</span>
              </li>
            {{else if event.add_subscription}}
              <li class="md-org-admin-list__item">
                {{t "Purchase user \"%{user_name}\" was added - " key="subscription_user_added" user_name=event.user_name}}
                <span class="md-org-admin-gift__meta">{{date_ago event.logged_at}}</span>
              </li>
            {{else if event.remove_subscription}}
              <li class="md-org-admin-list__item">
                {{t "Purchase user \"%{user_name}\" was removed - " key="subscription_user_removed" user_name=event.user_name}}
                <span class="md-org-admin-gift__meta">{{date_ago event.logged_at}}</span>
              </li>
            {{else if event.update_extras_count}}
              <li class="md-org-admin-list__item">
                {{t "Premium symbols total was updated to %{num} - " key="extras_count_updated" num=event.count}}
                <span class="md-org-admin-gift__meta">{{date_ago event.logged_at}}</span>
              </li>
            {{else}}
              <li class="md-org-admin-list__item">
                {{t "Unrecognized event - " key="unrecognized_event"}} {{event.type}} -
                <span class="md-org-admin-gift__meta">{{date_ago event.logged_at}}</span>
              </li>
            {{/if}}
          {{/each}}
        </ul>
      </section>
    {{/if}}
  </div>
{{else}}
  <p class="md-org-error">{{t "Not authorized" key="not_authorized"}}</p>
{{/if}}
