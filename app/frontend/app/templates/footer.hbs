<footer>
  <div class="wide_links">
    <div class="row">
      <div class='col-sm-6'>
        <span class="page-footer__app-name">{{t "%app_name%" key="app_name"}}</span>
        {{#unless this.app_state.no_linky}}
          {{#if this.app_state.installed_app}}
            <a href="https://www.mylingolinq.com" target="_blank" rel="noopener">{{t "Web Site" key="web_site"}}</a> <span class='text-muted'>|</span>
          {{/if}}
          <LinkTo @route="about">{{t "About" key="about"}}</LinkTo> <span class='text-muted'>|</span>
          {{#unless this.app_state.installed_app}}
            {{#if this.app_state.feature_flags.subscriptions}}
              {{#if this.app_state.domain_settings.full_domain}}
                {{!-- <LinkTo @route="pricing">{{t "Pricing" key="pricing"}}</LinkTo> <span class='text-muted'>|</span> --}}
              {{/if}}
            {{/if}}
          {{/unless}}
        {{/unless}}
        <a href="#" {{on "click" (this.ctrlAction "support")}}>{{t "Support" key="support"}}</a>
        {{#unless this.app_state.installed_app}}
          <span class='text-muted'>|</span>
          <LinkTo @route="contact">{{t "Contact Us" key="contact"}}</LinkTo>
        {{/unless}}
        <a href='#' {{on "click" (this.ctrlAction "language")}} style='margin-left: 10px;'>
          <img src={{path "images/icon-language-new2.png"}} class="page-footer__language-icon" alt="Language">
          {{this.app_state.current_locale_string}}
        </a>
      </div>
      <div class='col-sm-4' style="text-align: right;">
        {{#if this.app_state.showFooterGithubLinks}}
          {{#unless this.app_state.installed_app}}
            <a href="https://github.com/lingolinq/LingoLinq-AAC" target="_blank" rel="noopener" class="page-footer__developers-link">{{t "Developers" key="developers"}}</a> <span class='text-muted'>|</span>
          {{/unless}}
        {{/if}}
        <LinkTo @route="privacy">{{t "Privacy" key="privacy"}}</LinkTo> <span class='text-muted'>|</span>
        <LinkTo @route="terms">{{t "Terms" key="terms"}}</LinkTo>
      </div>
      {{#if (persistence-online)}}
        {{#unless this.app_state.no_linky}}
          <div class='col-sm-2'>
            <!-- icons found here: https://www.iconfinder.com/icons/104443/feed_rss_subscribe_icon#size=24 -->
            <span class="icons">
              {{#if this.app_state.domain_settings.blog_url}}
                <a href={{this.app_state.domain_settings.blog_url}} target="_blank" rel="noopener"><img src="data:image/png;base64," alt={{t "Blog" key="blog"}}></a>
              {{/if}}
              {{#if this.app_state.domain_settings.twitter_url}}
                <a href={{this.app_state.domain_settings.twitter_url}} target="_blank" rel="noopener"><img src={{path "images/logos/x.svg"}} alt={{t "X" key="x"}}></a>
              {{/if}}
              {{#if this.app_state.domain_settings.facebook_url}}
                <a href={{this.app_state.domain_settings.facebook_url}} target="_blank" rel="noopener"><img src={{path "images/logos/facebook.png"}} alt={{t "Facebook" key="facebook"}}></a>
              {{/if}}
            </span>
          </div>
        {{/unless}}
      {{/if}}
    </div>
  </div>
  {{#if this.app_state.index_view}}
  <div class="skinny_links">
    <span class="dropdown">
      <span class="dropup">
      <a data-toggle="dropdown" href="#">{{t "More Resources" key="more_resources"}} <span class='caret'></span></a>
      <ul class="dropdown-menu dropdown-menu-top top" role="menu" aria-labelledby="dLabel">
        {{#unless this.app_state.no_linky}}
          <li>
            <a href="https://www.mylingolinq.com" target="_blank" rel="noopener">{{t "Web Site" key="web_site"}}</a>
          </li>
          <li>
            <LinkTo @route="about">{{t "About" key="about"}}</LinkTo>
          </li>
        {{/unless}}
        <li>
          <a href="#" {{on "click" (this.ctrlAction "support")}}>{{t "Support" key="support"}}</a>
        </li>
        <li>
          <a href='#' {{on "click" (this.ctrlAction "language")}}>
            <img src={{path "images/icon-language-new2.png"}} class="page-footer__language-icon page-footer__language-icon--dropdown" alt="Language">
            {{this.app_state.current_locale_string}}
          </a>
        </li>
        <li>
          <LinkTo @route="privacy">{{t "Privacy" key="privacy"}}</LinkTo>
        </li>
        <li>
          <LinkTo @route="terms">{{t "Terms" key="terms"}}</LinkTo>
        </li>
        {{#unless this.app_state.no_linky}}
          {{#if (persistence-online)}}
            <li>
              <!-- icons found here: https://www.iconfinder.com/icons/104443/feed_rss_subscribe_icon#size=24 -->
              <span class="icons" style="padding-left: 17px;">
                {{#if this.app_state.domain_settings.blog_url}}
                  <a href={{this.app_state.domain_settings.blog_url}} target="_blank" rel="noopener"><img src="data:image/png;base64," alt={{t "Blog" key="blog"}}></a>
                {{/if}}
                {{#if this.app_state.domain_settings.twitter_url}}
                  <a href={{this.app_state.domain_settings.twitter_url}} target="_blank" rel="noopener"><img src={{path "images/logos/x.svg"}} alt={{t "X" key="x"}}></a>
                {{/if}}
                {{#if this.app_state.domain_settings.facebook_url}}
                  <a href={{this.app_state.domain_settings.facebook_url}} target="_blank" rel="noopener"><img src={{path "images/logos/facebook.png"}} alt={{t "Facebook" key="facebook"}}></a>
                {{/if}}
              </span>
            </li>
          {{/if}}
        {{/unless}}
      </ul>
      </span>
    </span>
  </div>
  {{/if}}
</footer>
