{{#if this.loadError}}
  <p role="alert">{{t "Could not load features. Try again or sign in as an admin." key="system_settings_features_load_error"}}</p>
{{else}}
  <p class="la-system-settings__hint">{{this.scopeHint}}</p>
  {{#if this.inheritedLabel}}
    <p class="la-system-settings__scope-badge"><span class="md-status-tag md-status-tag--info">{{this.inheritedLabel}}</span></p>
  {{/if}}

  <div class="la-system-settings__toolbar">
    <label class="la-system-settings__search-label">
      <span class="la-system-settings__label-text">{{t "Search" key="system_settings_search_label"}}</span>
      <input type="search" value={{this.searchQuery}} class="form-control la-system-settings__search-input" autocomplete="off" placeholder={{t "Feature name…" key="system_settings_features_search_placeholder"}} {{on "input" (set-field this "searchQuery")}} />
    </label>
    {{!-- <ModernSelect>, not a native <select>, so the open list takes the app's styles too
         (requested 2026-11-09). "All categories" is the '' option, which it shows as the placeholder. --}}
    <div class="la-system-settings__filter">
      <span class="la-system-settings__label-text">{{t "Category" key="system_settings_category_label"}}</span>
      <ModernSelect @class="la-system-settings__filter-select" @selectId="system_settings_feature_category" @ariaLabel={{t "Category" key="system_settings_category_label"}} @content={{this.categoryOptions}} @selection={{this.categoryFilter}} @action={{mut this.categoryFilter}} @placeholder={{t "All categories" key="system_settings_filter_all_categories"}} />
    </div>
  </div>

  {{#if this.loading}}
    <p class="la-system-settings__loading" aria-live="polite">{{t "Loading..." key="loading"}}</p>
  {{else if this.filteredFeatures.length}}
    {{!-- ONE SECTION PER GROUP, in the page's order (requested 2026-11-09: features sorted into
         "professional groupings", not one long list). The groups and their order are
         utils/system_feature_groups.js; each section's features are sorted by name. Each section is
         labelled by its heading, so a screen reader can move between them. --}}
    {{#each this.featureGroups as |group|}}
    <section class="la-system-settings__feature-group" aria-labelledby="system_feature_group_{{group.id}}">
    <h2 class="la-system-settings__feature-group-title" id="system_feature_group_{{group.id}}">{{group.label}}</h2>
    <ul class="la-system-settings__feature-list">
      {{#each group.features as |feature|}}
        <li class="la-system-settings__feature-item">
          <label class="la-system-settings__feature-label">
            <input type="checkbox" checked={{get this.pendingToggles feature.key}} disabled={{feature.env_locked}} {{on "change" (this.ctrlAction "toggleFeature" feature.key)}} />
            <span class="la-system-settings__feature-name">{{feature.name}}</span>
            <span class="la-system-settings__feature-key">{{feature.key}}</span>
          </label>
          <p class="la-system-settings__feature-desc">{{feature.description}}</p>
          {{#if feature.env_locked}}
            <span class="md-status-tag md-status-tag--warning">{{t "Controlled by environment variable" key="system_settings_env_locked"}}</span>
          {{/if}}
          {{#if feature.ai_feature}}
            <span class="md-status-tag">{{t "AI feature" key="system_settings_ai_feature"}}</span>
          {{/if}}
        </li>
      {{/each}}
    </ul>
    </section>
    {{/each}}
  {{else}}
    <p>{{t "No features match your filters." key="system_settings_features_empty"}}</p>
  {{/if}}

  <div class="la-system-settings__actions">
    <button type="button" class="md-btn md-btn--primary" disabled={{or this.saving this.loading}} {{on "click" (this.ctrlAction "saveFeatures")}}>{{t "Save" key="save"}}</button>
    <button type="button" class="md-btn md-btn--ghost" disabled={{or this.saving this.loading}} {{on "click" (this.ctrlAction "resetFeatures")}}>{{this.resetButtonLabel}}</button>
  </div>
{{/if}}
