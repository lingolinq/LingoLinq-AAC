<div class="md-shell">
  <div class="md-workspace">
    <header class="md-hero md-hero--dashboard md-hero--dashboard-user">
      <h1 class="md-hero__title"><span class="md-hero__title--from-left">{{t "Always-Available Boards" key="always_available_boards"}}</span></h1>
      <p class="md-hero__sub"><span class="md-hero__sub--from-right">{{t "Free emergency and" key="offline_boards_sub_pre"}} <em class="md-hero__gradient-text">{{t "critical-use boards" key="offline_boards_sub_em"}}</em></span></p>
    </header>
    {{!-- FOCUSED HIDES THE HERO ABOVE (`.md-hero--dashboard-user`, _focused-view.scss), which left
         this page with no title there; this is its title in Focused (requested 2026-10-01: "a page
         title ... that has our two-toned icon and header (like that on the rooms page)"). "Basic
         Access" is what the menu row and Modern's Extras card that lead here call the page; the life
         ring is that row's icon (components/dashboard/classic-rail-basic-access.hbs). --}}
    <FocusedPageLabel @title={{t "Basic Access" key="critical_access"}}>
      <svg class="md-extras-card__svg-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#46505F"/><circle cx="12" cy="12" r="4" stroke="#46505F"/><path d="M5.6 5.6l3.6 3.6M14.8 14.8l3.6 3.6M18.4 5.6l-3.6 3.6M9.2 14.8l-3.6 3.6" stroke="#2A9D8F"/></svg>
    </FocusedPageLabel>

    <main class="md-main">
      <div class="md-offline-boards">
        <div class="md-offline-boards__card">
          <p class="md-offline-boards__intro">{{t "Below is a collection of free and always-available emergency and critical-use boards that we provide along with our partners. Anyone who downloads the %app_name% app will have access to these boards, with or without an Internet connection." key="offline_boards_explainer"}}</p>
          <form class="form-horizontal md-preferences__form">
            {{#each this.locales as |loc|}}
              <div style='margin-bottom: 12px;'>
                <PreferenceBox @title={{loc.locale_text}} @glyph={{loc.icon_class}} @title_key={{loc.locale}} @closed_text={{loc.tally}} @open={{loc.open}}>
                  {{#if loc.credit}}
                    <p class='md-offline-boards__credit'>{{t "translations provided by" key="translations_by"}} {{loc.credit}}</p>
                  {{/if}}
                  <ul class="md-offline-boards__list">
                    {{#each loc.boards as |board|}}
                      {{#if board.starter}}
                        <li>
                          <LinkTo @route="demo.speak" @query={{hash board=board.path source="offline_boards"}} class="md-offline-boards__item {{if board.chosen 'md-offline-boards__item--chosen'}}">
                            {{board.name}}
                            {{#if board.chosen}}
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2A9D8F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            {{/if}}
                          </LinkTo>
                        </li>
                      {{/if}}
                    {{/each}}
                  </ul>
                </PreferenceBox>
              </div>
            {{/each}}
          </form>
        </div>
      </div>
    </main>
  </div>
</div>
