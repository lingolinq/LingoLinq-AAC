<ModalDialog @action={{this.ctrlAction "close"}} @opening={{this.ctrlAction "opening"}} @closing={{this.ctrlAction "closing"}}>
  <div class="board_drop">
    <div class="modal-header">
      <button type="button" class="close" {{on "click" (this.ctrlAction "close")}}>&times;</button>
      <h3>
        {{t "Purchase Board" key="purchase_board"}}
      </h3>
    </div>
    <div class="modal-body">
      <p>{{t "To purchase a copy of this board, go to lingolinq.com and purchase via the website." key="purchase_instructions"}}</p>
    </div>
    <div class="modal-footer">
      <button {{on "click" (this.ctrlAction "close")}} class="btn btn-default">{{t "Close" key="close"}}</button>
    </div>
  </div>
</ModalDialog>
