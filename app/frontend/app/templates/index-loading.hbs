{{!--
  Renders automatically while the index route's model() hook resolves.
  Uses the canonical premium progress card chrome that matches:
    - The pre-reload overlay (login-form.js) — covers the brief blank
      moment between submit and the reload firing.
    - The bootstrap skeleton's progress card (boards/index.html.erb +
      app/frontend/app/index.html) — covers the post-reload boot
      window.
  All three layers share the same look so the user perceives one
  continuous loading state across the entire login flow.
--}}
<div class="ll-premium-progress" role="status" aria-live="polite" aria-busy="true">
  <div class="ll-premium-progress__card">
    <h2 class="ll-premium-progress__title">{{t "Preparing your workspace" key="preparing_your_workspace"}}</h2>
    <p class="ll-premium-progress__sub">{{t "Loading boards and communication resources" key="loading_boards_and_resources"}}</p>
    <div class="ll-premium-progress__bar" aria-hidden="true"></div>
  </div>
</div>
