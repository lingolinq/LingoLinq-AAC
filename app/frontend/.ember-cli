{
  /**
    Ember CLI sends analytics information by default. The data is completely
    anonymous, but there are times when you might want to disable this behavior.

    Setting `disableAnalytics` to true will prevent any data from being sent.
  */
  "disableAnalytics": false,

  /**
    Proxy API, globals.js, images, and weblinger to Rails (same as bin/ember-server / foreman).
    Without this, `ember serve` alone 404s on /assets/globals.js and /api/v1/*.
    Override locally via `.ember-cli.local` (gitignored) — do not commit machine-specific hosts.
  */
  "proxy": "http://127.0.0.1:5000",

  /**
    Setting `isTypeScriptProject` to true will force the blueprint generators to generate TypeScript
    rather than JavaScript by default, when a TypeScript version of a given blueprint is available.
  */
  "isTypeScriptProject": false
}
