  "private": true,
  "scripts": {
    "build": "ember build",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:todo": "ember-template-lint . --update-todo",
    "lint:js": "eslint . --ext .js,.mjs",
    "lint:js:todo": "node scripts/eslint-todo-gate.js --update-todo",
    "lint:js:ci": "node scripts/eslint-todo-gate.js",
    "test:template-lint-rules": "node --input-type=module -e \"let beforeEachFn; global.describe=(n,f)=>f(); global.beforeEach=(f)=>{beforeEachFn=f}; global.before=(f)=>{beforeEachFn=f}; global.it=(n,f)=>{beforeEachFn&&beforeEachFn(); return Promise.resolve(f()).then(()=>console.log('ok',n)).catch(e=>{console.error('FAIL',n,e);process.exitCode=1})}; await import('./node-tests/no-fn-handler-factory-test.mjs')\"",
    "start": "ember serve",
    "test": "ember test",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
