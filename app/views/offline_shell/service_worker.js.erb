// Offline app shell (lib/offline_shell.rb): lets the app open with no network once it has been
// added to a Home Screen and has synced. Board data is already on the device; this worker keeps a copy
// of the page itself and the files it loads.
//
// Rules, in order:
// - Only GET requests to this origin are ever looked at. Everything else goes to the network untouched.
// - A file in PRECACHE (matched on its path) is answered from the cache. So is the interface language
//   file (RUNTIME_CACHED_SOURCE), kept the first time it loads online. Nothing else ever is: every
//   /api/ request and every other file goes to the network as if there were no worker.
// - A page navigation to an app page tries the network first. The answer is the cached generic page
//   (SHELL_PATH), which boots the app from the device, when the request fails (no connection), when
//   the server answers with an error (a 5xx, or 429 from the request limiter), or when nothing has
//   answered within NAVIGATION_TIMEOUT_MS (a hung network; the request carries on and its answer is
//   dropped). Any other answer stands, a sign-in redirect and a 404 included; with nothing cached, the
//   network's answer stands in every case. A working server slower than the limit therefore gets the
//   cached page: the app it boots is the version the device holds, online, until the next launch
//   (decided 2026-11-10; the limit is the original 2026-11-03 design). Pages Rails answers itself
//   (EXCLUDED_FIRST_SEGMENTS, files, board icons) never get it.
// - A new version waits until every page the old one controls has closed, then deletes the old
//   caches. It carries the interface language file over from them at install (fresh from the network
//   when it can be fetched, otherwise the old copy), so an update does not lose a device's language.
'use strict';
var CACHE_NAME = <%= raw @cache_name.to_json %>;
var CACHE_PREFIX = <%= raw OfflineShell::CACHE_PREFIX.to_json %>;
var SHELL_PATH = <%= raw OfflineShell::SHELL_PATH.to_json %>;
var PRECACHE = <%= raw @precache_urls.to_json %>;
var EXCLUDED_FIRST_SEGMENTS = <%= raw OfflineShell::EXCLUDED_FIRST_SEGMENTS.to_json %>;
var RUNTIME_CACHED_SOURCE = <%= raw OfflineShell::RUNTIME_CACHED_SOURCE.to_json %>;
var RUNTIME_CACHED = new RegExp('^(?:' + RUNTIME_CACHED_SOURCE + ')$');
var NAVIGATION_TIMEOUT_MS = <%= OfflineShell::NAVIGATION_TIMEOUT_MS.to_i %>;
var GLOBAL_ID = /^\d+_\d+(-\d+_\d+)?$/;

var PRECACHED = {};
PRECACHE.forEach(function(path) { PRECACHED[path] = true; });

// Mirrors OfflineShell.navigation_excluded? (lib/offline_shell.rb).
function navigationExcluded(pathname) {
  var segments = pathname.split('/').filter(function(segment) { return segment.length > 0; });
  if(segments.length === 0) { return false; }
  if(EXCLUDED_FIRST_SEGMENTS.indexOf(segments[0]) !== -1) { return true; }
  var last = segments[segments.length - 1];
  if(last.indexOf('.') !== -1) { return true; }
  if(last === 'icon' && (segments.length >= 3 || GLOBAL_ID.test(segments[0]))) { return true; }
  return false;
}

function plainResponse(response) {
  // Only a plain same-origin 200 is kept. A redirected page cannot answer a navigation.
  if(!response.ok || response.redirected || response.type !== 'basic') { return false; }
  return true;
}

function freshRequest(path) {
  return new Request(path, {cache: 'reload', credentials: 'same-origin', redirect: 'error'});
}

self.addEventListener('install', function(event) {
  var existed = false;
  event.waitUntil(
    caches.has(CACHE_NAME).then(function(has) {
      existed = has;
      return caches.open(CACHE_NAME);
    }).then(function(cache) {
      return Promise.all(PRECACHE.map(function(path) {
        return fetch(freshRequest(path)).then(function(response) {
          if(!plainResponse(response)) {
            throw new Error('offline shell: could not precache ' + path + ' (' + response.status + ')');
          }
          return cache.put(path, response);
        });
      })).then(function() {
        return carryRuntimeFiles(cache, true);
      });
    }).catch(function(error) {
      // Never leave a half-filled cache behind; the install fails and the browser tries again later. A
      // cache that was there before this install belongs to the installed worker (a version with the
      // same name), so it is left alone.
      return (existed ? Promise.resolve() : caches.delete(CACHE_NAME)).then(function() { throw error; });
    })
  );
});

// The language file a device uses is cached on first use, in the version's own cache, which the next
// version deletes when it activates. Copy each one the new cache lacks into it: at install fresh from
// the network when it can be fetched (`fresh`), otherwise, and at activation for a file first cached
// while this version waited, the old copy. Never fails the install or the activation.
function carryRuntimeFiles(cache, fresh) {
  return caches.keys().then(function(keys) {
    return Promise.all(keys.filter(function(key) {
      return key.indexOf(CACHE_PREFIX) === 0 && key !== CACHE_NAME;
    }).map(function(key) {
      return caches.open(key).then(function(oldCache) {
        return oldCache.keys().then(function(requests) {
          return Promise.all(requests.map(function(oldRequest) {
            var path = new URL(oldRequest.url).pathname;
            if(!RUNTIME_CACHED.test(path)) { return null; }
            var copyOld = function() {
              return oldCache.match(oldRequest).then(function(old) { return old && cache.put(path, old); });
            };
            return cache.match(path).then(function(already) {
              if(already) { return null; }
              if(!fresh) { return copyOld(); }
              return fetch(freshRequest(path)).then(function(response) {
                if(!plainResponse(response)) { throw new Error('not a plain 200'); }
                return cache.put(path, response);
              }).catch(copyOld);
            });
          }));
        });
      });
    }));
  }).catch(function() {});
}

self.addEventListener('activate', function(event) {
  event.waitUntil(
    caches.open(CACHE_NAME).then(function(cache) {
      return carryRuntimeFiles(cache, false);
    }).then(function() {
      return caches.keys();
    }).then(function(keys) {
      return Promise.all(keys.filter(function(key) {
        return key.indexOf(CACHE_PREFIX) === 0 && key !== CACHE_NAME;
      }).map(function(key) {
        return caches.delete(key);
      }));
    })
  );
});

function cachedShell() {
  return caches.open(CACHE_NAME).then(function(cache) { return cache.match(SHELL_PATH); });
}

// An answer the person cannot use: a server error, or the request limiter. A sign-in redirect (an
// opaque redirect here, status 0) and a 404 are real answers and stand.
function serverFailed(response) {
  return response.status >= 500 || response.status === 429;
}

// The network's answer, unless it failed, answered with an error, or has not answered within
// NAVIGATION_TIMEOUT_MS: then the cached shell. With nothing cached, the network's answer stands,
// however long it takes. Settles exactly once; the dropped request's later outcome is ignored.
function navigationResponse(request) {
  var network = fetch(request);
  return new Promise(function(resolve, reject) {
    var done = false;
    var finish = function(response) {
      if(!done) { done = true; resolve(response); }
    };
    var shellOr = function(fallback) {
      cachedShell().then(function(shell) {
        if(shell) { finish(shell); } else { fallback(); }
      }, fallback);
    };
    var timer = setTimeout(function() {
      // No answer yet: the shell now. With nothing cached, keep waiting for the network.
      shellOr(function() {});
    }, NAVIGATION_TIMEOUT_MS);
    network.then(function(response) {
      clearTimeout(timer);
      if(serverFailed(response)) { shellOr(function() { finish(response); }); } else { finish(response); }
    }, function(error) {
      clearTimeout(timer);
      shellOr(function() { if(!done) { done = true; reject(error); } });
    });
  });
}

self.addEventListener('fetch', function(event) {
  var request = event.request;
  if(request.method !== 'GET') { return; }
  var url = new URL(request.url);
  if(url.origin !== self.location.origin) { return; }
  if(request.mode === 'navigate') {
    // Top-level pages only; an embedded board in a frame goes to the network.
    if(request.destination && request.destination !== 'document') { return; }
    if(navigationExcluded(url.pathname)) { return; }
    event.respondWith(navigationResponse(request));
    return;
  }
  if(PRECACHED[url.pathname]) {
    event.respondWith(
      caches.open(CACHE_NAME).then(function(cache) { return cache.match(url.pathname); }).then(function(cached) {
        return cached || fetch(request);
      })
    );
    return;
  }
  if(RUNTIME_CACHED.test(url.pathname)) {
    var result = cacheOnFirstUse(url.pathname, request);
    event.respondWith(result.response);
    // Keeps the worker alive until the copy is written, so a browser that stops it right after the
    // answer does not lose the copy.
    event.waitUntil(result.stored);
  }
});

// The cached copy if there is one; otherwise the network, keeping a plain same-origin 200 (a regional
// name the app tries first is often a 404, which is never kept). Returns the answer, and a promise
// that settles once any copy is written (it never rejects).
function cacheOnFirstUse(path, request) {
  var stored = null;
  var response = caches.open(CACHE_NAME).then(function(cache) {
    return cache.match(path).then(function(cached) {
      if(cached) { return cached; }
      return fetch(request).then(function(response) {
        if(plainResponse(response)) {
          stored = cache.put(path, response.clone());
        }
        return response;
      });
    });
  });
  return {
    response: response,
    stored: response.then(function() { return stored; }, function() {}).catch(function() {})
  };
}
