<%# Status badge for the standalone parental-consent pages (complete + revoke,
    both the standard and EU-AI variants). A confirmation page (@state :confirm)
    is waiting for the parent, so it is neutral. A recorded result is a teal
    check. An invalid or expired link is a red x. Decorative: the h1 and body
    carry the meaning for assistive tech. Styled by .box__badge in the
    parental_consent layout. %>
<% badge_kind = @state == :confirm ? 'neutral' : (@success ? 'ok' : 'err') %>
<div class="box__badge box__badge--<%= badge_kind %>" aria-hidden="true">
  <% if badge_kind == 'neutral' %>
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/></svg>
  <% elsif @success %>
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
  <% else %>
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  <% end %>
</div>
