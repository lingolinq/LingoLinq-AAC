<div class="box">
  <% app_name = (JsonApi::Json.current_domain['settings'] || {})['app_name'] || 'LingoLinq' %>
  <%= render 'shared/consent_status_badge' %>
  <% if @state == :confirm %>
    <h1><%= t('parental_consent.approve_confirm_title') %></h1>
    <p><%= t(@records_ai_consent ? 'parental_consent.approve_confirm_body' : 'parental_consent.approve_confirm_body_account_only') %></p>
    <%= form_tag parental_consent_complete_path, method: :post do %>
      <%= hidden_field_tag :user_id, params[:user_id] %>
      <%= hidden_field_tag :token, params[:token] %>
      <button type="submit" class="btn btn-primary"><%= t('parental_consent.approve_confirm_button') %></button>
    <% end %>
  <% elsif @success && @already_granted %>
    <h1><%= t('parental_consent.already_title') %></h1>
    <p><%= t('parental_consent.already_body') %></p>
  <% elsif @success %>
    <h1><%= t('parental_consent.thanks_title') %></h1>
    <p><%= t('parental_consent.thanks_body') %></p>
  <% else %>
    <h1><%= t('parental_consent.invalid_title') %></h1>
    <p><%= t('parental_consent.invalid_body') %></p>
  <% end %>
  <p><a href="/"><%= t('parental_consent.home_link', app_name: app_name) %></a></p>
</div>
