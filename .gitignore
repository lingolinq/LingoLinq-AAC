# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log
/tmp
/test
/vendor

/.env
/.env.*
!.env.example
!.env.op.template

/app/frontend/dist/
/app/frontend/tmp/
/app/assets/javascripts/frontend/bower_components/

# Ember build output — copied (not symlinked) into Rails asset paths during build
/app/assets/javascripts/frontend.js
/app/assets/javascripts/vendor.js
/app/assets/javascripts/auto-import-app.js
/app/assets/stylesheets/frontend.css
/app/assets/stylesheets/vendor.css

/coverage

.DS_Store
*.code-workspace
*.docx
~$*.docx
~$*.doc
/lib/domains.json
# Ignore master key for decrypting credentials and more.
/config/master.key

# Cursor IDE debug session logs (NDJSON)
.cursor/debug*.log

# Ignore local Claude Code settings + worktrees, but TRACK the shared audit system.
# Pattern note: exclude the CONTENTS of /.claude (not the dir itself) so the
# audit subtree below can be re-included. Re-including a child of a fully-excluded
# directory is impossible in git, hence /.claude/* rather than /.claude.
/.claude/*
# Shared, version-controlled audit/compliance system (Phase 2 agent migration).
# Re-include ONLY the specific tracked file types, not whole directories, so future local junk
# dropped under these dirs (scratch logs, finder temp JSON, editor swap files) stays ignored.
# Idiom: re-include dir, re-exclude its contents, re-include the wanted files.
!/.claude/agents/
/.claude/agents/*
!/.claude/agents/*.md
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/*/
/.claude/skills/*/*
!/.claude/skills/*/SKILL.md
!/.claude/hooks/
/.claude/hooks/*
!/.claude/hooks/*.sh
!/.claude/settings.json
# Everything else under /.claude stays local and ignored: settings.local.json, worktrees/,
# and agent-memory/ (finder `memory: project` accrues per-machine; not shared to avoid pulling
# unrelated local agents' memory into git).

# Python bytecode
__pycache__/
*.pyc

# Ignore GSD (get-shit-done) runtime artifacts — plans, task todos, execution state
/.planning

# antigravity-mcp is a separate git repository
/antigravity-mcp

# Antigravity CLI per-project config (machine-specific symlink into ~/.gemini)
/.antigravitycli

# Ignore node modules
/node_modules

# Ignore compiled assets
/public/assets

# Ignore temporary logo/backup files
/backup
/temp_logos

public/.well-known/appspecific/com.chrome.devtools.json

# Ignore scratch/debug/status docs (moved to docs/)
docs/ASSET_LICENSING.md
docs/BOARD_CREATION_FLOW.md
docs/CHECK_LOGS.md
docs/COMPLETED_TASKS_SUMMARY.md
docs/DEBUGGING_GUIDE.md
docs/FRONTEND_DEPRECATIONS_PLAN.md
docs/FRONTEND_ORG_CHECK.md
docs/MIGRATION_STATUS.md
docs/MODAL_REFACTOR_NEXT_CHAT_PROMPT.md
docs/MODAL_REFACTOR_STATUS.md
docs/ORGANIZATION_UI_DEBUG.md
docs/PHASE3_STATUS_REVIEW.md
docs/QUICK_ORG_CHECK.md
docs/RAILS_CONSOLE_REFERENCE.md
docs/S3_DOWNLOAD_ACCESS.md
docs/SERVICE_INJECTION_ERROR_ANALYSIS.md
docs/SYNC_CODE_REVIEW.md
docs/TIMEOUT_DEBUG.md
docs/USER_ID_CACHE_INVESTIGATION.md

app/frontend/tests/README-modal-test.md
docs/CI_TEST_FAILURES_ANALYSIS.md

# Codex CLI per-repo context, generated by ~/ai-company-brain/scripts/sync-configs.js
/AGENTS.md

# Date-prefixed working-log markdown files (per-task scratch notes under
# docs/task-management/, e.g. 2026-05-25-board-detail-edit-…md). Kept on
# disk for the author's reference, NOT committed. Pattern matches any
# YYYY-MM-DD-*.md file anywhere in the tree.
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.md
.cursor/rules/melissa-branch-workflow.mdc
